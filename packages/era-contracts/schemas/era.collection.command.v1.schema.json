{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "schedule"
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "dueAt": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "token",
        "dueAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "cancel"
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "token"
      ],
      "additionalProperties": false
    }
  ]
}

