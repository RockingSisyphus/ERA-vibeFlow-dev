{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messages"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "messageId", "role", "activeText", "swipeIndex"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "messageId": { "type": "integer", "minimum": 0 },
          "role": { "type": "string", "minLength": 1 },
          "activeText": { "type": "string" },
          "swipeIndex": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
