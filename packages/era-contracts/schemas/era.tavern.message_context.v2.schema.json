{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "messageId",
          "role",
          "activeText",
          "swipeIndex",
          "candidate"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "messageId": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "activeText": {
            "type": "string"
          },
          "swipeIndex": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exists",
              "generation",
              "phase",
              "predecessor"
            ],
            "properties": {
              "exists": {
                "type": "boolean"
              },
              "generation": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phase": {
                "type": "string",
                "enum": [
                  "idle",
                  "preparing",
                  "generating",
                  "completed",
                  "cancelled"
                ]
              },
              "predecessor": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
