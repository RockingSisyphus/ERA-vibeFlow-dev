{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "consecutiveMk": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "consecutiveProcessingCount": {
      "type": "integer",
      "minimum": 0
    },
    "scopeWindow": {
      "type": "object",
      "properties": {
        "token": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "messageAdmission": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "branchAdmission": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "token",
        "messageAdmission",
        "branchAdmission"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "consecutiveMk",
    "consecutiveProcessingCount"
  ],
  "additionalProperties": false
}
