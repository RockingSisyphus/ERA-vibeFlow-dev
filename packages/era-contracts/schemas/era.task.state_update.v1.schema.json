{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "consecutiveMk": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "consecutiveProcessingCount": {
      "type": "integer",
      "minimum": 0
    },
    "syncCursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "messageId": {
              "type": "integer",
              "minimum": 0
            },
            "mk": {
              "type": "string",
              "minLength": 1
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "stat": {
              "type": "object"
            },
            "statFunc": {
              "type": "object"
            },
            "resolvedCallIds": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "messageId",
            "mk",
            "blockIndex"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scopeWindow": {
      "type": "object",
      "properties": {
        "token": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "messageId": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "messageAdmission": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "branchAdmission": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "token",
        "messageId",
        "messageAdmission",
        "branchAdmission"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "consecutiveMk",
    "consecutiveProcessingCount"
  ],
  "additionalProperties": false
}
