{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "present"
        },
        "statWithMeta": {},
        "statWithoutMeta": {},
        "mode": {
          "enum": [
            "raw",
            "lazy"
          ]
        }
      },
      "required": [
        "kind",
        "statWithMeta",
        "statWithoutMeta"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "missing"
        },
        "mode": {
          "enum": [
            "raw",
            "lazy"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
