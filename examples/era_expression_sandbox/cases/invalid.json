  {
    "id": "factorial-domain",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "factorial(-1)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FACTORIAL_DOMAIN"], "compressed": {} }
