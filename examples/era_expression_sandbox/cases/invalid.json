    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "1/0" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_RESULT_NON_FINITE"], "compressed": {} }
  },
  {
    "id": "non-numeric-reference",
    "request": { "functionLibrary": {}, "initialState": { "a": "text" }, "operations": [{ "path": "a", "expr": "a+1" }] },
    "expect": { "status": "partial", "finalState": { "a": "text" }, "diagnostics": ["ERA_EXPR_REFERENCE_NON_NUMERIC"], "compressed": {} }
  },
  {
    "id": "derivative-order",
    "request": { "functionLibrary": { "f": { "params": ["x"], "expr": "x^2" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "derivative(f,2,0)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_DERIVATIVE_ORDER"], "compressed": {} }
