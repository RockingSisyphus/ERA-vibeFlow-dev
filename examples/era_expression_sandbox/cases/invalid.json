    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "sqrt(-1)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_BUILTIN_NON_FINITE"], "compressed": {} }
