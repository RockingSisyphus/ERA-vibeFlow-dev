[
  {
    "id": "raw-snapshot-is-forbidden",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "@a+1" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_SNAPSHOT_FORBIDDEN"], "compressed": {} }
  },
  {
    "id": "invalid-character",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "a$1" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_LEX_INVALID_CHARACTER"], "compressed": {} }
  },
  {
    "id": "missing-parenthesis",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "(a+1" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_PARSE_EXPECTED"], "compressed": {} }
  },
  {
    "id": "trailing-expression",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "a 1" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_PARSE_TRAILING"], "compressed": {} }
  },
  {
    "id": "invalid-target-path",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a..b", "expr": "1" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_PATH_INVALID"], "compressed": {} }
  },
  {
    "id": "unknown-custom-function",
    "request": { "functionLibrary": {}, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "missing(a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_UNKNOWN_CALL"], "compressed": {} }
  },
  {
    "id": "custom-function-arity",
    "request": { "functionLibrary": { "f": { "params": ["x"], "expr": "x+1" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "f(1,2)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_ARITY"], "compressed": {} }
  },
  {
    "id": "impure-function-body",
    "request": { "functionLibrary": { "f": { "params": ["x"], "expr": "x+outside" } }, "initialState": { "a": 1, "outside": 4 }, "operations": [{ "path": "a", "expr": "f(a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1, "outside": 4 }, "diagnostics": ["ERA_EXPR_FUNCTION_IMPURE"], "compressed": {} }
  },
  {
    "id": "direct-recursion",
    "request": { "functionLibrary": { "f": { "params": ["x"], "expr": "f(x)" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "f(a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_RECURSION"], "compressed": {} }
  },
  {
    "id": "indirect-recursion",
    "request": { "functionLibrary": { "f": { "params": ["x"], "expr": "g(x)" }, "g": { "params": ["x"], "expr": "f(x)" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "f(a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_RECURSION"], "compressed": {} }
  },
  {
    "id": "builtin-name-conflict",
    "request": { "functionLibrary": { "sin": { "params": ["x"], "expr": "x" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "sin(a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_NAME_CONFLICT"], "compressed": {} }
  },
  {
    "id": "duplicate-function-parameters",
    "request": { "functionLibrary": { "f": { "params": ["x", "x"], "expr": "x" } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "f(a,a)" }] },
    "expect": { "status": "partial", "finalState": { "a": 1 }, "diagnostics": ["ERA_EXPR_FUNCTION_PARAMS"], "compressed": {} }
  },
  {
    "id": "bad-function-shape",
    "request": { "functionLibrary": { "f": { "params": "x", "expr": 1 } }, "initialState": { "a": 1 }, "operations": [{ "path": "a", "expr": "a+1" }] },
