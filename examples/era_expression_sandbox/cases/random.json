  {
    "id": "random-dice-and-skill-library",
    "request": {
      "functionLibrary": {
        "dice": { "params": ["min", "max"], "expr": "floor(random()*(max-min+1))+min" },
        "d20Check": { "params": ["modifier", "difficulty"], "expr": "clamp(dice(1,20)+modifier-difficulty+1,0,1)" },
        "percentCheck": { "params": ["skill"], "expr": "clamp(skill-dice(1,100)+1,0,1)" }
      },
      "randomContext": { "sourceKey": "sandbox-dice", "drawOffset": 0 },
      "initialState": { "roll": 0, "d20": 0, "percent": 0 },
      "operations": [
        { "path": "roll", "expr": "dice(1,100)" },
        { "path": "d20", "expr": "d20Check(5,15)" },
        { "path": "percent", "expr": "percentCheck(65)" }
      ]
    },
    "expect": {
      "status": "ok",
      "finalState": { "roll": 8, "d20": 1, "percent": 0 },
      "diagnostics": [],
      "randomDrawsConsumed": 3,
      "nextDrawOffset": 3,
      "containsAutomaticRandom": true
    }
  },
