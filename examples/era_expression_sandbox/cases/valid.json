  {
    "id": "parameters-calls-and-parentheses-mix",
    "request": {
      "functionLibrary": {
        "scale": { "params": ["x"], "expr": "x*2" },
        "square": { "params": ["value"], "expr": "value^2" },
        "join": { "params": ["p", "q"], "expr": "scale(p+q)+square(q)" },
        "outer": { "params": ["left", "right"], "expr": "scale(left*right)+square(right-left)" }
      },
      "initialState": { "x": 99, "p": 3, "q": 4, "answer": 0 },
      "operations": [{ "path": "answer", "expr": "outer(join(p,q),scale(q-1))" }]
    },
    "expect": { "status": "ok", "finalState": { "x": 99, "p": 3, "q": 4, "answer": 936 }, "diagnostics": [] }
  },
