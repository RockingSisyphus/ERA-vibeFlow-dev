{
  "kind": "node",
  "type_key": "era.command_compaction.execute_original_semantics",
  "display_name": "重放当前段原语义",
  "description": "复用六类命令解释，记录该段原结果和随机游标；携带作用域与是否允许重写的信息。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.parsed",
        "cardinality": "exactly_one",
        "display_name": "当前段"
      }
    ],
    "provides": [
      {
        "key": "trace",
        "type": "era.command_compaction.semantic_trace",
        "display_name": "原语义轨迹"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.parsed": [
        "当前段"
      ]
    },
    "output_semantics": {
      "trace": [
        "原语义轨迹"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/execute_original_semantics.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages",
    "era.command_compaction.engine"
  ],
  "capabilities": []
}
