{
  "kind": "node",
  "type_key": "era.command_compaction.rewrite_safe_regions",
  "display_name": "生成段候选",
  "description": "依据变量、函数和随机依赖分析，为能证明安全的区域生成较短的替换文本，保留原命令与位置作为验证依据。这里只提出候选，没有候选或不安全部分继续保留原文；单事务及不同作用域不能被随意合并，分段合并时还会再次核对允许重写的条件。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.symbols",
        "cardinality": "exactly_one",
        "display_name": "依赖及屏障"
      }
    ],
    "provides": [
      {
        "key": "candidate",
        "type": "era.command_compaction.candidate",
        "display_name": "段候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.symbols": [
        "依赖及屏障"
      ]
    },
    "output_semantics": {
      "candidate": [
        "段候选"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/rewrite_safe_regions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages",
    "era.command_compaction.engine"
  ],
  "capabilities": []
}
