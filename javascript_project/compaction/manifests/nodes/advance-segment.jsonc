{
  "kind": "node",
  "type_key": "era.command_compaction.advance_segment",
  "display_name": "继承状态并推进分段",
  "description": "把当前段结果接回整层：只有该段含命令、允许重写、内容确实发生变化且没有诊断时才采用候选，否则保留原段。继承原语义得到的变量、函数和随机偏移，累计文本、理由和统计，再推进游标及结束标志；后段因此从真实前段结果开始计算。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.segment.state.before",
        "cardinality": "exactly_one",
        "display_name": "原顺序状态"
      },
      {
        "type": "era.command_compaction.verified",
        "cardinality": "exactly_one",
        "display_name": "段确认结果"
      }
    ],
    "provides": [
      {
        "key": "segment_state_next",
        "type": "era.command_compaction.segment.state",
        "display_name": "下一段状态"
      },
      {
        "key": "segment_done",
        "type": "era.command_compaction.segment.done",
        "display_name": "全部段结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.verified": [
        "段确认结果"
      ],
      "era.command_compaction.segment.state.before": [
        "原顺序状态"
      ]
    },
    "output_semantics": {
      "segment_state_next": [
        "下一段状态"
      ],
      "segment_done": [
        "全部段结束"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/advance_segment.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages",
    "era.command_compaction.engine"
  ],
  "capabilities": []
}
