{
  "kind": "node",
  "type_key": "era.command_compaction.analyze_dependencies",
  "display_name": "分析依赖与局部屏障",
  "description": "读取原段执行轨迹，分析哪些变量或函数依赖其他值，哪些路径受到直接或间接随机调用影响，以及哪里是不能跨越的重写边界。输出依赖事实供候选生成使用，不改正文、不再执行一遍操作；目的是让文本简化有具体语义依据。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.semantic_trace",
        "cardinality": "exactly_one",
        "display_name": "原语义轨迹"
      }
    ],
    "provides": [
      {
        "key": "symbols",
        "type": "era.command_compaction.symbols",
        "display_name": "分析结果与原轨迹"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.semantic_trace": [
        "原语义轨迹"
      ]
    },
    "output_semantics": {
      "symbols": [
        "分析结果与原轨迹"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/analyze_dependencies.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages",
    "era.command_compaction.engine"
  ],
  "capabilities": []
}
