  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.request",
        "cardinality": "exactly_one",
        "display_name": "压缩请求"
      }
    ],
    "provides": [
      {
        "key": "parsed",
        "type": "era.command_compaction.parsed",
        "display_name": "整层解析与有序分段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.request": [
        "压缩请求"
      ]
    },
    "output_semantics": {
      "parsed": [
        "整层解析与有序分段"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/parse_command_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages"
  ],
  "capabilities": []
}
