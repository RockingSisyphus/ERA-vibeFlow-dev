{
  "kind": "node",
  "type_key": "era.command_compaction.parse_command_blocks",
  "display_name": "解析整层与作用域段",
  "description": "读取待压缩消息中的 ERA 变量及函数操作标签，解析其 JSON 和原文位置，再按正文与事务边界分段。只有相邻、同作用域且中间无非空正文的事务可以组成一组；未知作用域保持原样。这里决定处理顺序及可重写范围，不应用操作或删掉正文。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.request",
        "cardinality": "exactly_one",
        "display_name": "压缩请求"
      }
    ],
    "provides": [
      {
        "key": "parsed",
        "type": "era.command_compaction.parsed",
        "display_name": "整层解析与有序分段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.request": [
        "压缩请求"
      ]
    },
    "output_semantics": {
      "parsed": [
        "整层解析与有序分段"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/parse_command_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages"
  ],
  "capabilities": []
}
