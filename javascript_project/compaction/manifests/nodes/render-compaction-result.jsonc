{
  "kind": "node",
  "type_key": "era.command_compaction.render_compaction_result",
  "display_name": "输出已确认结果",
  "description": "将整层验证已经形成的结果直接交给公开输出，包括压缩状态、内容、最终变量和函数、诊断、保留理由、解析命令及随机偏移。当前节点只是接口转接，不另做一次压缩或“美化”失败状态，也不将候选保存到聊天。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.verified",
        "cardinality": "exactly_one",
        "display_name": "整层确认结果"
      }
    ],
    "provides": [
      {
        "key": "compaction_response",
        "type": "era.command_compaction.response",
        "display_name": "原公共返回格式"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.verified": [
        "整层确认结果"
      ]
    },
    "output_semantics": {
      "compaction_response": [
        "原公共返回格式"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/render_compaction_result.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.engine"
  ],
  "capabilities": []
}
