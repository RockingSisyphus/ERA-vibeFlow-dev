{
  "kind": "node",
  "type_key": "era.command_compaction.classify_random_barriers",
  "display_name": "划定自动随机局部屏障",
  "category": "ERA 命令压缩",
  "description": "把直接或间接自动 random 命令作为局部屏障；显式 random(seed,draw) 保持确定性资格。",
  "version": "1.0.0",
  "flow_kind": "process",
