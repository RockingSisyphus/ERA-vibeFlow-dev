    "params_schema": {}, "params_defaults": {},
    "input_semantics": { "era.command_compaction.invariants": ["输入：原命令重放不变量。"] },
    "output_semantics": { "random_invariants": ["输出：由纯引擎执行局部随机屏障规则的不变量。"] }
  },
  "implementations": [{ "language": "typescript", "targets": ["browser", "node"], "completion": "immediate", "source": { "kind": "file", "ref": "nodes/classify_random_barriers.ts", "export": "run" } }],
