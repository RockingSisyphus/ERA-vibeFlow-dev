{
  "kind": "node",
  "type_key": "era.command_compaction.verify_replay_equivalence",
  "display_name": "确认段候选",
  "description": "从与原段相同的起点重放候选，确认最终变量、函数及相关诊断和随机语义仍等价。标签 JSON 无效返回无效，没有安全替换或候选验证失败返回原文及原因；通过后才输出已确认候选。计算结果不会在这里保存，稍后还要按分段作用域回填。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.candidate",
        "cardinality": "exactly_one",
        "display_name": "段候选"
      }
    ],
    "provides": [
      {
        "key": "verified",
        "type": "era.command_compaction.verified",
        "display_name": "段确认结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.candidate": [
        "段候选"
      ]
    },
    "output_semantics": {
      "verified": [
        "段确认结果"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/verify_replay_equivalence.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages"
  ],
  "capabilities": []
}
