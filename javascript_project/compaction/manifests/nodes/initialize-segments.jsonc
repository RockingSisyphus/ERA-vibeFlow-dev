{
  "kind": "node",
  "type_key": "era.command_compaction.initialize_segments",
  "display_name": "建立顺序压缩状态",
  "description": "以请求给出的初始变量、函数库和随机偏移建立分段状态，游标从第一段开始，输出文本、诊断和统计暂为空。每段执行后会把结束状态传给下一段；这个节点只是准备起点，不提前重放指令或生成压缩候选。",
  "category": "ERA 命令压缩",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.parsed",
        "cardinality": "exactly_one",
        "display_name": "整层解析与分段"
      }
    ],
    "provides": [
      {
        "key": "segment_state",
        "type": "era.command_compaction.segment.state",
        "display_name": "顺序压缩状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.parsed": [
        "整层解析与分段"
      ]
    },
    "output_semantics": {
      "segment_state": [
        "顺序压缩状态"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize_segments.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.command_compaction.stages"
  ],
  "capabilities": []
}
