{
  "type_key": "era.migration.compaction.verify_layer.workflow",
  "display_name": "调用公式流程核对整条消息效果",
  "description": "无事务分段时直接采用已完成的段结果；有分段时从同一起点分别重放整条原消息和拼好候选，依序提出实际需要的公式请求。 展开后可查看准备、原生同步调用、结果接回和继续判断。",
  "expand": true,
  "requires": [
    {
      "type": "era.command_compaction.segment.state",
      "cardinality": "exactly_one",
      "display_name": "分段压缩的进度、累计文字和状态"
    }
  ],
  "provides": [
    {
      "key": "verified",
      "type": "era.command_compaction.verified",
      "display_name": "当前段或整条消息的压缩确认结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "input0",
        "type": "era.command_compaction.segment.state",
        "required": true,
        "display_name": "分段压缩的进度、累计文字和状态"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.command_compaction.terminal",
        "display_name": "开始本段处理",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      },
      {
        "id": "prepare",
        "display_name": "准备本段工作并判断是否需要调用",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：无事务分段时直接采用已完成的段结果；有分段时从同一起点分别重放整条原消息和拼好候选，依序提出实际需要的公式请求。",
        "definition_id": "era.migration.compaction.verify_layer.workflow.prepare"
      },
      {
        "id": "invoke_loop",
        "display_name": "按原顺序完成本段所需的同步调用",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：每次只调用当前确有需要的目标，接回结果后才判断下一次；次数由实际输入决定，不并发，不预先计算后续请求。",
        "definition_id": "vibeflow.loop.while",
        "requires": [
          {
            "type": "era.migration.compaction.verify_layer.state",
            "cardinality": "exactly_one",
            "display_name": "仅保留在当前工作流的业务进度"
          }
        ],
        "provides": [
          {
            "key": "final_state",
            "type": "era.migration.compaction.verify_layer.final",
            "display_name": "本段全部原生调用完成后的业务进度"
          }
        ],
        "loop": {
          "body": "era.migration.compaction.verify_layer.workflow.request_step",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.migration.compaction.verify_layer.state",
              "as": "state",
              "update": "next_state"
            }
          ],
          "outputs": [
            {
              "from": "next_state",
              "as": "final_state"
            }
          ]
        }
      },
      {
        "id": "skip_call",
        "display_name": "无需跨流程调用，直接保留本段结果",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：普通赋值、无候选或已发现输入问题时不调用目标，按原语义继续处理或返回诊断。",
        "definition_id": "era.migration.compaction.verify_layer.workflow.skip_call"
      },
      {
        "id": "finish",
        "display_name": "交出本段最终业务结果",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：读取本地完成进度，按原合同形成变量、诊断、函数候选或压缩结果；提交、保存和是否采用仍由原调用方决定。",
        "definition_id": "era.migration.compaction.verify_layer.workflow.finish"
      },
      {
        "id": "end",
        "definition_id": "era.command_compaction.terminal",
        "display_name": "完成本段处理",
        "description": "本步骤用于“调用公式流程核对整条消息效果”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      }
    ],
    "edges": [
      [
        "start",
        "prepare"
      ],
      {
        "from": "prepare",
        "to": "invoke_loop",
        "when": "needs_call == true"
      },
      {
        "from": "prepare",
        "to": "skip_call",
        "when": "needs_call == false"
      },
      [
        "invoke_loop",
        "finish"
      ],
      [
        "skip_call",
        "finish"
      ],
      [
        "finish",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.verified",
        "cardinality": "exactly_one",
        "display_name": "当前段或整条消息的压缩确认结果",
        "as": "verified"
      }
    ]
  }
}
