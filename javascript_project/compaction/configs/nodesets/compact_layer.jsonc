{
  "type_key": "era.command_compaction.compact_layer",
  "status": "implemented",
  "flow_kind": "process",
  "display_name": "缩短整条消息的指令并确认效果",
  "description": "接收原消息及变量起点，找出可以分别处理的指令段，逐段尝试缩短并重算比较，最后核对整条消息。只有变量、函数和随机效果一致才采用，其他部分保留原文并说明原因。",
  "requires": [
    {
      "type": "era.command_compaction.request",
      "cardinality": "exactly_one",
      "display_name": "原消息、变量起点和指令压缩要求"
    }
  ],
  "provides": [
    {
      "key": "compaction_response",
      "type": "era.command_compaction.response",
      "display_name": "确认后的消息文字及指令压缩结论"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "compaction_request",
        "type": "era.command_compaction.request",
        "display_name": "原消息、变量起点和指令压缩要求",
        "required": true
      }
    ],
    "max_steps": 7,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始缩短整条消息的指令并确认效果",
        "description": "标明“缩短整条消息的指令并确认效果”的开始位置。接收原消息及变量起点，找出可以分别处理的指令段，逐段尝试缩短并重算比较，最后核对整条消息。只有变量、函数和随机效果一致才采用，其他部分保留原文并说明原因。",
        "definition_id": "era.command_compaction.terminal"
      },
      {
        "id": "parse",
        "display_name": "找出消息中可以分别压缩的指令段",
        "description": "在“缩短整条消息的指令并确认效果”流程中，读取消息中的变量和函数指令，按原有顺序识别正文、指令范围和可合并的相邻段落。遇到无法确认作用范围的内容时保留原文，为后续逐段尝试缩短指令划定边界。 使用与正文执行共用的语法，识别容错 JSON 与显式数组路径；验证实算及重放一致后方可采用压缩结果。",
        "definition_id": "era.command_compaction.parse_command_blocks"
      },
      {
        "id": "initialize_segments",
        "display_name": "准备逐段压缩的起点",
        "description": "在“缩短整条消息的指令并确认效果”流程中，装入原消息的变量、函数和随机使用位置，从第一段开始记录进度。每段完成后的实际状态会传给下一段，确保逐段压缩仍遵守原消息的执行顺序。",
        "definition_id": "era.command_compaction.initialize_segments"
      },
      {
        "id": "segment_loop",
        "display_name": "按原文顺序完成各段指令压缩",
        "description": "依序处理正文段和同范围指令组，每段都从前段实际结束状态开始，累计已确认缩短文字或原文。全部段完成后，仍需比较整条消息效果才返回可采用结果。",
        "requires": [
          {
            "type": "era.command_compaction.segment.state",
            "cardinality": "exactly_one",
            "display_name": "分段压缩的进度、累计文字和状态"
          }
        ],
        "provides": [
          {
            "key": "segment_state_final",
            "type": "era.command_compaction.segment.state",
            "display_name": "分段压缩的进度、累计文字和状态"
          }
        ],
        "loop": {
          "body": "era.command_compaction.segment_step",
          "max_iterations": null,
          "stop_when": {
            "from": "segmentDone",
            "equals": true
          },
          "carry": [
            {
              "from": "era.command_compaction.segment.state",
              "as": "segment_state",
              "update": "segmentStateNext"
            }
          ],
          "outputs": [
            {
              "from": "segmentStateNext",
              "as": "segment_state_final"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "verify_layer",
        "display_name": "调用公式流程核对整条消息效果",
        "description": "无事务分段时直接采用已完成的段结果；有分段时从同一起点分别重放整条原消息和拼好候选，依序提出实际需要的公式请求。 展开后可查看准备、原生同步调用、结果接回和继续判断。",
        "definition_id": "era.migration.compaction.verify_layer.workflow"
      },
      {
        "id": "render",
        "display_name": "返回已确认的消息与压缩结论",
        "description": "在“缩短整条消息的指令并确认效果”流程中，接收已经确认的完整消息结果，将可采用的文字、最终变量和函数、随机进度及保留原文的原因返回调用方。由调用方决定是否保存到聊天，此处完成计算结果交付。",
        "definition_id": "era.command_compaction.render_compaction_result"
      },
      {
        "id": "end",
        "display_name": "结束缩短整条消息的指令并确认效果",
        "description": "标明“缩短整条消息的指令并确认效果”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.command_compaction.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "parse"
      ],
      [
        "parse",
        "initialize_segments"
      ],
      [
        "initialize_segments",
        "segment_loop"
      ],
      [
        "segment_loop",
        "verify_layer"
      ],
      [
        "verify_layer",
        "render"
      ],
      [
        "render",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.response",
        "cardinality": "exactly_one",
        "display_name": "确认后的消息文字及指令压缩结论",
        "as": "compactionResponse"
      }
    ]
  }
}
