{
  "type_key": "era.command_compaction.compact_layer",
  "status": "implemented",
  "flow_kind": "process",
  "display_name": "ERA 命令层安全压缩",
  "description": "按真实顺序分段压缩，统一作用域所有权；最终输出已确认结果，公共同步入口将调用本工作流。",
  "requires": [
    {
      "type": "era.command_compaction.request",
      "cardinality": "exactly_one",
      "display_name": "ERA 命令层压缩请求"
    }
  ],
  "provides": [
    {
      "key": "compaction_response",
      "type": "era.command_compaction.response",
      "display_name": "ERA 命令层压缩结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "compaction_request",
        "type": "era.command_compaction.request",
        "display_name": "ERA 命令层压缩请求",
        "required": true
      }
    ],
    "max_steps": 7,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.command_compaction.terminal",
        "display_name": "压缩开始",
        "description": "压缩开始，不执行算法或宿主操作。"
      },
      {
        "id": "parse",
        "type_used": "era.command_compaction.parse_command_blocks",
        "display_name": "解析整层与作用域段",
        "description": "保留原六类命令解析，按原文区分正文、未知 scope 和相邻同 scope 事务；只在此处划分组。"
      },
      {
        "id": "initialize_segments",
        "type_used": "era.command_compaction.initialize_segments",
        "display_name": "建立顺序压缩状态",
        "description": "以请求起始 statData/statFunc/drawOffset 初始化分段游标、累计文本和计数，不执行候选重写。"
      },
      {
        "id": "segment_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "按原文顺序处理分段",
        "description": "显式运行分段体，前段结果供后段使用，直至 cursor 到达分段末尾。",
        "requires": [
          {
            "type": "era.command_compaction.segment.state",
            "cardinality": "exactly_one",
            "display_name": "顺序状态"
          }
        ],
        "provides": [
          {
            "key": "segment_state_final",
            "type": "era.command_compaction.segment.state",
            "display_name": "全部分段结果"
          }
        ],
        "loop": {
          "body": "era.command_compaction.segment_step",
          "max_iterations": null,
          "stop_when": {
            "from": "segmentDone",
            "equals": true
          },
          "carry": [
            {
              "from": "era.command_compaction.segment.state",
              "as": "segment_state",
              "update": "segmentStateNext"
            }
          ],
          "outputs": [
            {
              "from": "segmentStateNext",
              "as": "segment_state_final"
            }
          ]
        }
      },
      {
        "id": "verify_layer",
        "type_used": "era.command_compaction.verify_layer",
        "display_name": "确认整层候选",
        "description": "保留原整层复放确认：最终状态、函数库、随机游标及诊断一致；失败保留原文；不重新调用 compactCommandLayer。"
      },
      {
        "id": "render",
        "type_used": "era.command_compaction.render_compaction_result",
        "display_name": "输出已确认结果",
        "description": "仅整理最终 status/content/stat/diagnostics/reasons/parsedCommands/drawOffset；无第二套压缩编排。"
      },
      {
        "id": "end",
        "type_used": "era.command_compaction.terminal",
        "display_name": "压缩结束",
        "description": "压缩结束，不执行算法或宿主操作。"
      }
    ],
    "edges": [
      [
        "start",
        "parse"
      ],
      [
        "parse",
        "initialize_segments"
      ],
      [
        "initialize_segments",
        "segment_loop"
      ],
      [
        "segment_loop",
        "verify_layer"
      ],
      [
        "verify_layer",
        "render"
      ],
      [
        "render",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.response",
        "cardinality": "exactly_one",
        "display_name": "ERA 命令层压缩结果",
        "as": "compactionResponse"
      }
    ]
  }
}
