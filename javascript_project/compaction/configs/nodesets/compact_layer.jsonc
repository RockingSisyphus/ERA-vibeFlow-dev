{
  "type_key": "era.command_compaction.compact_layer",
  "status": "implemented",
  "flow_kind": "process",
  "display_name": "ERA 命令层安全压缩",
  "description": "把消息中的 ERA 操作文本在保持行为的前提下缩短：解析标签及作用域，按原顺序分段，逐段重放原操作、分析依赖、生成并确认候选，最后对完整消息再次重放比较。不能确认的部分或整层保留原文并说明原因。返回计算状态和候选文本，不访问酒馆或保存文件，调用方仍可用实际 Service 规则再确认。",
  "requires": [
    {
      "type": "era.command_compaction.request",
      "cardinality": "exactly_one",
      "display_name": "ERA 命令层压缩请求"
    }
  ],
  "provides": [
    {
      "key": "compaction_response",
      "type": "era.command_compaction.response",
      "display_name": "ERA 命令层压缩结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "compaction_request",
        "type": "era.command_compaction.request",
        "display_name": "ERA 命令层压缩请求",
        "required": true
      }
    ],
    "max_steps": 7,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.command_compaction.terminal",
        "display_name": "压缩开始",
        "description": "这是“ERA 命令层安全压缩”的入口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      },
      {
        "id": "parse",
        "type_used": "era.command_compaction.parse_command_blocks",
        "display_name": "解析整层与作用域段",
        "description": "读取待压缩消息中的 ERA 变量及函数操作标签，解析其 JSON 和原文位置，再按正文与事务边界分段。只有相邻、同作用域且中间无非空正文的事务可以组成一组；未知作用域保持原样。这里决定处理顺序及可重写范围，不应用操作或删掉正文。"
      },
      {
        "id": "initialize_segments",
        "type_used": "era.command_compaction.initialize_segments",
        "display_name": "建立顺序压缩状态",
        "description": "以请求给出的初始变量、函数库和随机偏移建立分段状态，游标从第一段开始，输出文本、诊断和统计暂为空。每段执行后会把结束状态传给下一段；这个节点只是准备起点，不提前重放指令或生成压缩候选。"
      },
      {
        "id": "segment_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "按原文顺序处理分段",
        "description": "按原文顺序循环处理正文段及同作用域事务组，每段的真实结束变量、函数和随机偏移成为下一段起点，累计已经确认的候选或原文。处理完全部段才退出，随后仍需整层重放确认；不会把每段分别当成独立初始状态进行压缩。",
        "requires": [
          {
            "type": "era.command_compaction.segment.state",
            "cardinality": "exactly_one",
            "display_name": "顺序状态"
          }
        ],
        "provides": [
          {
            "key": "segment_state_final",
            "type": "era.command_compaction.segment.state",
            "display_name": "全部分段结果"
          }
        ],
        "loop": {
          "body": "era.command_compaction.segment_step",
          "max_iterations": null,
          "stop_when": {
            "from": "segmentDone",
            "equals": true
          },
          "carry": [
            {
              "from": "era.command_compaction.segment.state",
              "as": "segment_state",
              "update": "segmentStateNext"
            }
          ],
          "outputs": [
            {
              "from": "segmentStateNext",
              "as": "segment_state_final"
            }
          ]
        }
      },
      {
        "id": "verify_layer",
        "type_used": "era.command_compaction.verify_layer",
        "display_name": "确认整层候选",
        "description": "分段结束后再确认完整消息层：从同一起点重放原文与拼接候选，比较最终变量、函数、随机偏移及诊断代码和路径；不一致则整层保留原文。无作用域分组时沿用单段验证结果，不重复启动压缩算法。输出已确认文本和真实计算结果，防止单段安全但组合后改变行为。"
      },
      {
        "id": "render",
        "type_used": "era.command_compaction.render_compaction_result",
        "display_name": "输出已确认结果",
        "description": "将整层验证已经形成的结果直接交给公开输出，包括压缩状态、内容、最终变量和函数、诊断、保留理由、解析命令及随机偏移。当前节点只是接口转接，不另做一次压缩或“美化”失败状态，也不将候选保存到聊天。"
      },
      {
        "id": "end",
        "type_used": "era.command_compaction.terminal",
        "display_name": "压缩结束",
        "description": "这是“ERA 命令层安全压缩”的出口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      }
    ],
    "edges": [
      [
        "start",
        "parse"
      ],
      [
        "parse",
        "initialize_segments"
      ],
      [
        "initialize_segments",
        "segment_loop"
      ],
      [
        "segment_loop",
        "verify_layer"
      ],
      [
        "verify_layer",
        "render"
      ],
      [
        "render",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.response",
        "cardinality": "exactly_one",
        "display_name": "ERA 命令层压缩结果",
        "as": "compactionResponse"
      }
    ]
  }
}
