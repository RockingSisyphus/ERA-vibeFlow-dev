{
  "type_key": "era.command_compaction.segment_step",
  "status": "implemented",
  "display_name": "为一段指令尝试缩短并比较结果",
  "description": "取出当前正文段和执行起点，先计算原文应产生的效果，再分析依赖、生成较短方案并比较。收下可采用文字或保留原文后，带着实际状态继续下一段。",
  "requires": [
    {
      "type": "era.command_compaction.segment.state",
      "cardinality": "exactly_one",
      "display_name": "分段压缩的进度、累计文字和状态"
    }
  ],
  "provides": [
    {
      "key": "segment_state_next",
      "type": "era.command_compaction.segment.state",
      "display_name": "分段压缩的进度、累计文字和状态"
    },
    {
      "key": "segment_done",
      "type": "era.command_compaction.segment.done",
      "display_name": "原消息各段是否已经处理完"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "segment_state",
        "type": "era.command_compaction.segment.state",
        "display_name": "分段压缩的进度、累计文字和状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始为一段指令尝试缩短并比较结果",
        "description": "标明“为一段指令尝试缩短并比较结果”的开始位置。取出当前正文段和执行起点，先计算原文应产生的效果，再分析依赖、生成较短方案并比较。收下可采用文字或保留原文后，带着实际状态继续下一段。",
        "definition_id": "era.command_compaction.terminal"
      },
      {
        "id": "select_segment",
        "display_name": "取出当前段及执行前的变量",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，根据进度取出一段正文或同一作用范围内的指令组，带入前一段结束后的变量、函数和随机位置。这份资料作为当前段原文和缩短方案的共同起点。",
        "definition_id": "era.command_compaction.select_segment"
      },
      {
        "id": "execute",
        "display_name": "先算出原指令本来会产生什么",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，按正式变量及函数规则执行当前原文，取得应有的变量、函数、随机使用次数和问题记录。结果只存在于本次计算中，作为后续判断缩短方案是否保持效果的比较依据。",
        "definition_id": "era.command_compaction.execute_original_semantics"
      },
      {
        "id": "analyze_dependencies",
        "display_name": "找出不能随意合并的指令关系",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，查看原指令的计算记录，找出变量、函数和随机结果之间的依赖，标明不能跨越的改写范围。后续只在这些约束允许的地方生成较短指令，避免改变执行效果。",
        "definition_id": "era.command_compaction.analyze_dependencies"
      },
      {
        "id": "rewrite",
        "display_name": "尝试生成更短的指令文字",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，根据已确认的依赖和作用范围，为可安全合并的部分提出较短指令，并保留原文及位置供比较。无法安全缩短的部分继续保留原文，提议还需经过实际重算验证。",
        "definition_id": "era.command_compaction.rewrite_safe_regions"
      },
      {
        "id": "verify",
        "display_name": "比较当前段缩短前后的实际效果",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，从同一变量、函数和随机起点执行缩短方案，与原段结果比较。只有结果和相关问题保持一致才采用；指令格式无效、效果不同或没有合适方案时保留原文及原因。",
        "definition_id": "era.command_compaction.verify_replay_equivalence"
      },
      {
        "id": "advance_segment",
        "display_name": "收下当前段并继续下一段",
        "description": "在“为一段指令尝试缩短并比较结果”流程中，当前段确实缩短且已通过比较时采用新文字，否则保留原文。将原指令实际产生的变量、函数和随机进度传给下一段，并累计完整消息的文字和处理记录。",
        "definition_id": "era.command_compaction.advance_segment"
      },
      {
        "id": "end",
        "display_name": "结束为一段指令尝试缩短并比较结果",
        "description": "标明“为一段指令尝试缩短并比较结果”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.command_compaction.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "select_segment"
      ],
      [
        "select_segment",
        "execute"
      ],
      [
        "execute",
        "analyze_dependencies"
      ],
      [
        "analyze_dependencies",
        "rewrite"
      ],
      [
        "rewrite",
        "verify"
      ],
      [
        "verify",
        "advance_segment"
      ],
      [
        "advance_segment",
        "end"
      ],
      {
        "from": "select_segment",
        "to": "advance_segment",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.command_compaction.segment.state",
        "cardinality": "exactly_one",
        "display_name": "分段压缩的进度、累计文字和状态",
        "as": "segmentStateNext"
      },
      {
        "type": "era.command_compaction.segment.done",
        "cardinality": "exactly_one",
        "display_name": "原消息各段是否已经处理完",
        "as": "segmentDone"
      }
    ]
  }
}
