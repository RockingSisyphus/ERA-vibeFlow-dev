{
  "nodeset_imports": [
    {
      "path": "nodesets/compact_layer.jsonc"
    },
    {
      "path": "nodesets/segment_step.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "compaction_request",
        "type": "era.command_compaction.request",
        "display_name": "ERA 命令层压缩请求",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "era.command_compaction.terminal",
        "display_name": "命令层压缩启动",
        "description": "这是“era.command_compaction”的入口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      },
      {
        "id": "compact_layer",
        "type_used": "era.command_compaction.compact_layer",
        "display_name": "执行命令层安全压缩",
        "description": "把消息中的 ERA 操作文本在保持行为的前提下缩短：解析标签及作用域，按原顺序分段，逐段重放原操作、分析依赖、生成并确认候选，最后对完整消息再次重放比较。不能确认的部分或整层保留原文并说明原因。返回计算状态和候选文本，不访问酒馆或保存文件，调用方仍可用实际 Service 规则再确认。"
      },
      {
        "id": "end",
        "type_used": "era.command_compaction.terminal",
        "display_name": "命令层压缩结束",
        "description": "这是“era.command_compaction”的出口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      }
    ],
    "edges": [
      [
        "start",
        "compact_layer"
      ],
      [
        "compact_layer",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.response",
        "cardinality": "exactly_one",
        "display_name": "ERA 命令层压缩结果",
        "as": "compactionResponse"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/schemas.ts",
        "export": "plugin"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/era.ts",
        "export": "plugin"
      }
    }
  ]
}
