{
  "name": "@era/vibeflow-command-compaction",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "exports": {
    "./engine": {
      "types": "./generated/release/engine.d.ts",
      "default": "./generated/release/engine.js"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && esbuild api/engine.ts --bundle --platform=node --format=esm --outfile=generated/test/command_compaction_engine.mjs && node --test tests/command_compaction_engine.test.mjs",
    "test:sandbox": "node ../../examples/era_command_compaction_sandbox/run.mjs",
    "test:workflow": "node scripts/workflow_execution_probe.mjs",
    "build": "node scripts/build-package.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@stdlib/math-base-special-gamma": "^0.3.1",
    "mathjs": "^15.2.0"
  },
  "peerDependencies": {
    "@era/vibeflow-expression": ">=0.3.0 <1"
  },
  "devDependencies": {
    "@era/vibeflow-expression": "file:vendor/era-vibeflow-expression-0.3.2.tgz",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "api",
    "base_lib",
    "generated/release"
  ]
