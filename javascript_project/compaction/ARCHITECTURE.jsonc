  "workflow_operations": {
    "[\"compact_layer\",\"segment_loop\",\"execute\",\"invoke_loop\",\"invoke_sync\"]": {
      "actions": [
        {
          "operation": "invoke_sync",
          "workflow": {
            "root": "era-expression",
            "path": "configs/era.expression.jsonc",
            "entry": "protocol"
          }
        }
      ]
    },
    "[\"compact_layer\",\"segment_loop\",\"rewrite\",\"invoke_loop\",\"invoke_sync\"]": {
      "actions": [
        {
          "operation": "invoke_sync",
          "workflow": {
            "root": "era-expression",
            "path": "configs/era.expression.jsonc",
            "entry": "protocol"
          }
        }
      ]
    },
    "[\"compact_layer\",\"segment_loop\",\"verify\",\"invoke_loop\",\"invoke_sync\"]": {
      "actions": [
        {
          "operation": "invoke_sync",
          "workflow": {
            "root": "era-expression",
            "path": "configs/era.expression.jsonc",
            "entry": "protocol"
          }
        }
      ]
    },
    "[\"compact_layer\",\"verify_layer\",\"invoke_loop\",\"invoke_sync\"]": {
