            "era.command_compaction.stages",
            "era.command_compaction.engine"
          ],
          "capabilities": [],
          "rulesets": [
            "vibeflow.process"
          ],
          "presentation": {},
          "metadata": {}
        },
        "era.command_compaction.analyze_dependencies": {
          "kind": "node",
          "node_type": "vibeflow.node",
          "id": "era.command_compaction.analyze_dependencies",
          "display_name": "找出不能随意合并的指令关系",
          "description": "查看原指令的计算记录，找出变量、函数和随机结果之间的依赖，标明不能跨越的改写范围。后续只在这些约束允许的地方生成较短指令，避免改变执行效果。",
          "version": "1.1.0",
          "flow_kind": "process",
          "tags": [
            "ERA 命令压缩"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.command_compaction.semantic_trace",
                "cardinality": "exactly_one",
                "display_name": "原指令的计算结果和依赖记录"
              }
            ],
            "provides": [
              {
                "key": "symbols",
                "type": "era.command_compaction.symbols",
                "display_name": "变量、函数、随机结果的依赖与改写限制"
              }
            ],
            "input_semantics": {
              "era.command_compaction.semantic_trace": [
                "作为压缩前应有行为的依据，尚未保存到聊天。"
              ]
            },
            "output_semantics": {
              "symbols": [
                "供只在安全范围内提出较短指令，不跨越会改变效果的边界。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
                "browser",
                "node"
              ],
              "source": {
                "kind": "file",
                "ref": "nodes/analyze_dependencies.ts",
                "export": "run"
              },
              "completion": "immediate"
            }
          ],
