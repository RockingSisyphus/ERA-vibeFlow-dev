        ]
      },
      "era.command_compaction.stages": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.command_compaction.stages",
        "display_name": "顺序分段压缩阶段",
        "description": "拥有作用域分段、段状态继承与确认结果构造；流程顺序由 Config 控制。",
        "category": "",
        "version": "1.0.0",
        "implementations": [
