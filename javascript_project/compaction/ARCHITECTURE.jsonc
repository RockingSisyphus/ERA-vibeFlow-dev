    "era.command_compaction.render_compaction_result": {
      "kind": "node",
      "node_type": "vibeflow.node",
      "id": "era.command_compaction.render_compaction_result",
      "display_name": "返回已确认的消息与压缩结论",
      "description": "接收已经确认的完整消息结果，将可采用的文字、最终变量和函数、随机进度及保留原文的原因返回调用方。由调用方决定是否保存到聊天，此处完成计算结果交付。",
      "version": "1.1.0",
      "flow_kind": "process",
      "tags": [
        "ERA 命令压缩"
      ],
      "external": false,
      "contract": {
        "requires": [
          {
            "type": "era.command_compaction.verified",
            "cardinality": "exactly_one",
            "display_name": "当前段或整条消息的压缩确认结果"
          }
        ],
        "provides": [
          {
