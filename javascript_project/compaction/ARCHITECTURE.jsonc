            }
          ],
          "provides": [
            {
              "key": "parsed",
              "type": "era.command_compaction.parsed",
              "display_name": "按原顺序识别的正文和指令段"
            },
            {
              "key": "segment_state_before",
              "type": "era.command_compaction.segment.state.before",
              "display_name": "当前段开始前的变量、函数和随机位置"
            }
          ],
          "input_semantics": {
            "era.command_compaction.segment.state": [
              "当前段完成后保留实际变量，作为下一段起点继续处理。"
            ]
          },
          "output_semantics": {
            "parsed": [
              "保留各段作用范围及位置，供逐段尝试缩短。"
            ],
            "segment_state_before": [
              "供原段执行和缩短方案比较使用相同起点。"
