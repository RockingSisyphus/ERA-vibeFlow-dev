          "id": "era.command_compaction.analyze_dependencies",
          "descriptor": {
            "kind": "node",
            "node_type": "vibeflow.node",
            "id": "era.command_compaction.analyze_dependencies",
            "display_name": "找出不能随意合并的指令关系",
            "description": "查看原指令的计算记录，找出变量、函数和随机结果之间的依赖，标明不能跨越的改写范围。后续只在这些约束允许的地方生成较短指令，避免改变执行效果。",
            "version": "1.1.0",
            "flow_kind": "process",
            "tags": [
              "ERA 命令压缩"
            ],
            "external": false,
            "contract": {
              "requires": [
                {
                  "type": "era.command_compaction.semantic_trace",
                  "cardinality": "exactly_one",
                  "display_name": "原指令的计算结果和依赖记录"
                }
              ],
              "provides": [
