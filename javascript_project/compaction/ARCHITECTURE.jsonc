      "era.variable.write": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.variable.write",
        "display_name": "校验并写入变量字段",
        "description": "沿显式路径读取父规则，检查新增、修改或删除以及整表替换的子项变化，生成通过校验的单次写入。",
        "category": "",
        "version": "1.0.0",
