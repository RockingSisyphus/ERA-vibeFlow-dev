            "type": "era.workflow.outputs",
            "cardinality": "exactly_one",
            "display_name": "本次原生同步调用的完整结果"
          }
        ],
        "provides": [
          {
            "key": "next_state",
            "type": "era.migration.compaction.execute.state",
            "display_name": "接回本次结果后的本地业务进度"
          },
          {
            "key": "done",
            "type": "era.migration.compaction.execute.done",
            "display_name": "本段是否已无后续调用"
          }
        ],
        "input_semantics": {
          "era.migration.compaction.execute.state.pending": [
            "仅保留在当前工作流的业务进度"
          ],
          "era.workflow.outputs": [
