    "base_lib": {
      "era.command.payload": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.command.payload",
        "display_name": "解析变量与函数指令正文",
        "description": "提取指令标签并解析其 JSON，保留字符串字面量。仅修正可识别的结构符号，失败由各调用场景处理。",
        "category": "",
        "version": "1.0.0",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "node",
              "browser"
            ],
            "source": {
              "kind": "file",
              "ref": "@project/base_lib/command_payload/command_payload.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": []
      },
      "era.command_compaction.engine": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.command_compaction.engine",
        "display_name": "ERA 命令层安全压缩引擎",
        "description": "提供六类指令解析、语义重放、依赖分析和候选重写算法，由命令压缩 Config 编排；算法不访问宿主。",
        "category": "",
        "version": "1.0.0",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
