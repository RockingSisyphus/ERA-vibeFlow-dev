            }
          ],
          "provides": [
            {
              "key": "compaction_response",
              "type": "era.command_compaction.response",
              "display_name": "确认后的消息文字及指令压缩结论"
            }
          ],
          "input_semantics": {
            "era.command_compaction.verified": [
              "包含可采用文字或保留原文的原因，以及真实变量和随机结果。"
            ]
          },
          "output_semantics": {
            "compaction_response": [
              "含最终变量、函数、问题和保留原文原因，是否保存由调用方决定。"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
