        "provides": [
          {
            "key": "symbols",
            "type": "era.command_compaction.symbols",
            "display_name": "变量、函数、随机结果的依赖与改写限制"
          }
        ],
        "input_semantics": {
          "era.command_compaction.semantic_trace": [
            "作为压缩前应有行为的依据，尚未保存到聊天。"
          ]
        },
        "output_semantics": {
          "symbols": [
            "供只在安全范围内提出较短指令，不跨越会改变效果的边界。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
