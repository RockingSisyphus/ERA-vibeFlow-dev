            "ref": "nodes/terminal.ts",
            "export": "run"
          },
          "completion": "immediate"
        }
      ]
    },
    "era.command_compaction.verify_layer": {
      "display_name": "确认整层候选",
      "description": "分段结束后再确认完整消息层：从同一起点重放原文与拼接候选，比较最终变量、函数、随机偏移及诊断代码和路径；不一致则整层保留原文。无作用域分组时沿用单段验证结果，不重复启动压缩算法。输出已确认文本和真实计算结果，防止单段安全但组合后改变行为。",
      "category": "ERA 命令压缩",
      "version": "1.1.0",
      "flow_kind": "process",
      "contract": {
        "requires": [
          {
            "type": "era.command_compaction.segment.state",
            "cardinality": "exactly_one",
            "display_name": "全部分段结果"
          }
        ],
        "provides": [
          {
            "key": "verified",
            "type": "era.command_compaction.verified",
            "display_name": "整层确认结果"
          }
        ],
        "input_semantics": {
          "era.command_compaction.segment.state": [
            "全部分段结果"
          ]
        },
        "output_semantics": {
          "verified": [
            "整层确认结果"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser",
            "node"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/verify_layer.ts",
            "export": "run"
          },
          "completion": "immediate"
        }
      ]
    },
    "era.command_compaction.verify_replay_equivalence": {
      "display_name": "确认段候选",
      "description": "从与原段相同的起点重放候选，确认最终变量、函数及相关诊断和随机语义仍等价。标签 JSON 无效返回无效，没有安全替换或候选验证失败返回原文及原因；通过后才输出已确认候选。计算结果不会在这里保存，稍后还要按分段作用域回填。",
      "category": "ERA 命令压缩",
      "version": "1.1.0",
      "flow_kind": "process",
      "contract": {
        "requires": [
          {
            "type": "era.command_compaction.candidate",
            "cardinality": "exactly_one",
            "display_name": "段候选"
          }
        ],
        "provides": [
          {
            "key": "verified",
            "type": "era.command_compaction.verified",
            "display_name": "段确认结果"
          }
        ],
        "input_semantics": {
          "era.command_compaction.candidate": [
            "段候选"
          ]
        },
        "output_semantics": {
          "verified": [
            "段确认结果"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser",
            "node"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/verify_replay_equivalence.ts",
            "export": "run"
          },
          "completion": "immediate"
        }
      ]
    }
