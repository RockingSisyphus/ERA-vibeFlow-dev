      "era.command_compaction.interpreter": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.command_compaction.interpreter",
        "display_name": "命令层解析与原语执行",
        "description": "六类命令的解析、状态操作与函数库更新原语。",
        "category": "",
        "version": "1.0.0",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
