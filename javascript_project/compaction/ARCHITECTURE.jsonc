      "era.workflow.values": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.workflow.values",
        "display_name": "工作流通信中的业务值转换",
        "description": "把变量和计算结果转换为官方通信可承载的纯数据消息，再恢复原值；保留大数、负零、缺失值和数组空位，不持有页面资源、不调度流程。",
        "category": "",
        "version": "0.1.0",
        "implementations": [
          {
            "language": "javascript",
            "targets": [
              "node",
              "browser"
            ],
