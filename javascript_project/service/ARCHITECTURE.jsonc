                    "messageId",
                    "messageAdmission",
                    "branchAdmission"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "schemaVersion",
                "collection",
                "collectionBytes",
                "iteration",
                "consecutiveProcessingCount",
                "consecutiveMk",
                "timerToken",
                "scopeWindow"
              ],
              "additionalProperties": false
            },
            "batchEvents": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "allOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "enum": [
                              "tavern",
                              "ui",
                              "era-api"
                            ]
                          }
                        },
                        "required": [
                          "source"
