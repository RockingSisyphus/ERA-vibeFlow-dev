            "variableWriteRequired",
            "failure"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object"
            },
            "disposition": {
              "type": "string",
              "enum": [
                "ready",
                "failed"
              ]
            },
            "mk": {
              "type": [
                "string",
                "null"
              ]
            },
            "messageUpdate": {
              "type": [
                "object",
                "null"
              ]
            },
            "metaUpdate": {
              "type": [
                "object",
                "null"
              ]
            },
            "messageWriteRequired": {
              "type": "boolean"
            },
            "variableWriteRequired": {
              "type": "boolean"
            },
            "failure": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "era.mk.commit.request": {
        "kind": "data_schema",
        "type_key": "era.mk.commit.request",
        "representation": "json",
