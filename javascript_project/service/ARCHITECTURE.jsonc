          ]
        }
      },
      "era.batch.execution.state": {
        "kind": "data_schema",
        "type_key": "era.batch.execution.state",
        "representation": "json",
        "display_name": "ERA 批次执行状态",
        "description": "步骤循环当前携带的计划索引、结算、通知、诊断与致命状态。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "throughSequence": {
              "type": "integer",
              "minimum": 1
            },
            "nextState": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "collection": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "allOf": [
                      {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "source": {
                                "enum": [
                                  "tavern",
                                  "ui",
                                  "era-api"
                                ]
                              }
                            },
                            "required": [
                              "source"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "source": {
                                "const": "timer"
                              },
                              "type": {
                                "const": "era.service.collection_timer"
                              }
                            },
                            "required": [
                              "source",
                              "type"
                            ]
                          }
                        ]
                      }
                    ],
                    "properties": {
                      "schemaVersion": {
                        "const": 1
                      },
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "occurredAt": {
                        "type": "number"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "tavern",
                          "ui",
                          "era-api",
                          "timer"
                        ]
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "const": "json"
                                },
                                "value": {}
                              },
                              "required": [
                                "kind",
                                "value"
