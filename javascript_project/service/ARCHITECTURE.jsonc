      "era.sidecar.binding.facts": {
        "kind": "data_schema",
        "type_key": "era.sidecar.binding.facts",
        "representation": "json",
        "display_name": "Sidecar 绑定事实",
        "description": "当前身份、聊天 SidecarId、V2 文件记录与仅用于一次迁移的旧状态事实。运行资格由安装作用域 workflow 决定，缺失指针为 create 或 migrate-legacy。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "status",
            "reason",
            "current",
            "sidecarId",
            "record",
            "legacyRecord",
            "legacyState"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "create",
                "migrate-legacy",
                "matched",
                "conflict",
                "invalid",
                "blocked"
              ]
            },
            "reason": {
              "type": "string"
            },
            "current": {
              "type": [
                "object",
                "null"
              ]
            },
            "sidecarId": {
              "type": [
                "string",
                "null"
              ]
            },
            "record": {
              "type": [
                "object",
                "null"
              ]
            },
            "legacyRecord": {
              "type": [
                "object",
                "null"
              ]
            },
            "legacyState": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "era.sidecar.binding.input": {
        "kind": "data_schema",
        "type_key": "era.sidecar.binding.input",
        "representation": "json",
        "display_name": "Sidecar 绑定输入",
        "description": "仅在 Sidecar Nodeset 内部传递的同步上下文封装。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "sync"
          ],
          "additionalProperties": false,
          "properties": {
            "sync": {
              "type": "object"
            }
          }
        }
      },
      "era.sidecar.binding.resolution": {
        "kind": "data_schema",
        "type_key": "era.sidecar.binding.resolution",
        "representation": "json",
        "display_name": "Sidecar 绑定决议",
        "description": "纯规则解析出的事实、路由与可选用户选择。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "facts",
            "route",
            "choice"
