    "era.agent.candidate_finish": {
      "display_name": "判断候选是否重试",
      "description": "读取候选执行结果是否附有重试请求：有则将该请求放入候选循环状态，标记尚未结束；没有则输出终态结果并结束候选循环。这里只决定是否继续尝试，不再次调用模型，也不发送阶段完成通知；通知必须等候选已达到终态后形成。",
      "category": "Agent候选",
      "version": "1.0.0",
      "flow_kind": "process",
      "contract": {
        "requires": [
          {
            "type": "era.agent.candidate.state",
            "cardinality": "exactly_one",
            "display_name": "当前候选状态"
          },
          {
            "type": "era.agent.generation.outcome",
            "cardinality": "exactly_one",
            "display_name": "生成阶段结果"
          }
        ],
        "provides": [
          {
            "key": "candidate_state_after",
            "type": "era.agent.candidate.state.next",
            "display_name": "更新后的候选状态"
          },
          {
            "key": "candidate_done",
            "type": "era.agent.candidate.done",
            "display_name": "候选结束标记"
          },
          {
            "key": "candidate_outcome",
            "type": "era.agent.candidate.outcome",
            "display_name": "候选执行结果"
          }
        ],
        "input_semantics": {
          "era.agent.candidate.state": [
            "当前候选的请求、步骤和批次状态。"
          ],
          "era.agent.generation.outcome": [
            "本次生成及逐块应用的结果，包含是否需要重新生成。"
          ]
        },
        "output_semantics": {
          "candidate_state_after": [
            "需要重试时换入新请求，否则保留当前候选状态。"
          ],
          "candidate_done": [
            "标明候选循环是否结束。"
          ],
          "candidate_outcome": [
            "移除内部重试请求后交给生成会话的结果。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser",
            "node"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/initialize/shared_pure_adapters.ts",
            "export": "CandidateFinishNode"
          },
          "completion": "immediate"
        }
      ]
    },
    "era.agent.candidate_seed": {
      "display_name": "建立候选状态",
      "description": "为候选重试循环建立初始请求、任务和批次状态。若本次是在替换一个已有阶段，还要先把按历史计算的保留前缀、变量、函数和会话基线安装到当前内存工作状态，撤销旧阶段效果后才能请求新模型候选。基线安装失败转为失败终态，不继续生成；这些更新仅在内存，尚未保存消息或状态文件。",
      "category": "Agent候选",
      "version": "1.0.0",
      "flow_kind": "process",
