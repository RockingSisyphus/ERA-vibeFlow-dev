        }
      },
      "era.task.result": {
        "kind": "data_schema",
        "type_key": "era.task.result",
        "representation": "json",
        "display_name": "ERA 任务结果",
        "description": "单个领域步骤的固定状态、来源结算、锁外通知与诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "committed",
                "no-op",
                "failed",
                "fatal"
              ]
            },
            "settlements": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "completed"
                      },
                      "taskId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
