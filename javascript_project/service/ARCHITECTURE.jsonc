          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "schemaVersion",
            "step",
            "status",
            "message",
            "meta",
            "placeholderSettings",
            "failure"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object"
            },
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "failed"
              ]
            },
