        "description": "读取 ERA 角色正则资源，并以幂等方式创建或更新资源；写入状态栏正则时由 Host 为当前角色启用局部正则。",
        "operations": {
          "read": {
            "input_type": "era.tavern.regex.read.request",
            "output_type": "era.tavern.regex.read.result",
            "completion": "suspend"
          },
          "upsert": {
            "input_type": "era.tavern.regex.upsert.request",
            "output_type": "era.tavern.regex.upsert.result",
            "completion": "suspend"
          }
        }
      },
      "era.tavern.sidecar": {
        "kind": "capability",
        "id": "era.tavern.sidecar",
        "targets": [
          "browser"
        ],
        "display_name": "ERA Sidecar 宿主接线",
        "description": "仅搬运当前身份、聊天变量、当前用户 files 和 UI 弹窗；不包含绑定、迁移或复制决策。",
        "operations": {
          "read_current": {
            "input_type": "era.tavern.sidecar.read_current.request",
            "output_type": "era.tavern.sidecar.read_current.result",
            "completion": "suspend"
          },
          "read_record": {
            "input_type": "era.tavern.sidecar.read_record.request",
            "output_type": "era.tavern.sidecar.read_record.result",
            "completion": "suspend"
          },
          "write_record": {
            "input_type": "era.tavern.sidecar.write_record.request",
            "output_type": "era.tavern.sidecar.write_record.result",
            "completion": "suspend"
          },
          "commit_metadata": {
            "input_type": "era.tavern.sidecar.commit_metadata.request",
            "output_type": "era.tavern.sidecar.commit_metadata.result",
            "completion": "suspend"
          },
          "publish_snapshot": {
            "input_type": "era.tavern.sidecar.commit_metadata.request",
            "output_type": "era.tavern.sidecar.commit_metadata.result",
            "completion": "immediate"
          },
          "create_id": {
            "input_type": "era.tavern.sidecar.create_id.request",
            "output_type": "era.tavern.sidecar.create_id.result",
            "completion": "immediate"
          },
          "present_prompt": {
            "input_type": "era.tavern.sidecar.present_prompt.request",
            "output_type": "era.tavern.sidecar.present_prompt.result",
            "completion": "immediate"
          },
          "clear_prompt": {
            "input_type": "era.tavern.sidecar.clear_prompt.request",
            "output_type": "era.tavern.sidecar.clear_prompt.result",
            "completion": "immediate"
          }
        }
      },
      "era.tavern.startup_gate": {
        "kind": "capability",
        "id": "era.tavern.startup_gate",
        "targets": [
          "browser"
        ],
        "display_name": "ERA 启动闸门",
        "description": "机械地结算 workflow 的启动决定；allow 才登记 Tavern ingress，dormant 不登记。",
        "operations": {
          "activate": {
            "input_type": "era.installation.scope.decision",
            "output_type": "era.tavern.startup_gate.result",
            "completion": "immediate"
          },
          "dormant": {
            "input_type": "era.installation.scope.decision",
            "output_type": "era.tavern.startup_gate.result",
            "completion": "immediate"
          }
        }
      },
      "era.tavern.variables": {
        "kind": "capability",
        "id": "era.tavern.variables",
        "targets": [
          "browser"
        ],
        "display_name": "酒馆变量",
        "description": "读取并按逻辑提交边界写入现有 ERA 状态、元数据、已选 MK 与编辑日志。",
        "operations": {
          "read": {
            "input_type": "era.tavern.variables.read.request",
            "output_type": "era.tavern.variables.read.result",
            "completion": "suspend"
          },
          "commit": {
            "input_type": "era.tavern.variables.commit.request",
            "output_type": "era.tavern.variables.commit.result",
            "completion": "suspend"
          }
        }
      },
      "era.tavern.worldbook": {
        "kind": "capability",
        "id": "era.tavern.worldbook",
        "targets": [
          "browser"
        ],
        "display_name": "酒馆世界书",
        "description": "通过明确的宿主操作读取、创建、绑定和替换 ERA 世界书条目。",
        "operations": {
          "read": {
            "input_type": "era.tavern.worldbook.read.request",
            "output_type": "era.tavern.worldbook.read.result",
            "completion": "suspend"
          },
          "create": {
            "input_type": "era.tavern.worldbook.create.request",
            "output_type": "era.tavern.worldbook.create.result",
            "completion": "suspend"
          },
          "bind": {
            "input_type": "era.tavern.worldbook.bind.request",
            "output_type": "era.tavern.worldbook.bind.result",
            "completion": "suspend"
          },
          "replace_entries": {
            "input_type": "era.tavern.worldbook.replace_entries.request",
            "output_type": "era.tavern.worldbook.replace_entries.result",
            "completion": "suspend"
          }
        }
      }
    },
    "host_extensions": [
      {
        "id": "era.tavern.service_host",
        "status": "implemented",
        "display_name": "ERA 酒馆服务宿主",
        "category": "宿主接线",
        "description": "保留单一FIFO、receipt、生成barrier、009源依据、010公开保存与读回及011首次呈现。共享消息保存边界分开确认原Swipe候选已保存与当前来源仍有效；复用sourceBasis处理保存期间的Swipe/编辑/聊天变化，不能因当前已选C而误报原B落盘失败。Service决定sourceChanged、部分写入及Sidecar结算，Host不新增队列、锁、重试或私有保存器。获批范围与验证见reports/era-swipe-persistence-separation-change-list.md。 本轮已实现：Host启动在初始化回执等待前登记pagehide；等待返回若已stopping则结算既有stop并返回，禁止晚挂载宏/UI。复用RuntimeController，不改领域workflow。用户已明确要求按分析方案修复四项并定向复测，见reports/era-four-ui-regression-change-list.md。",
        "version": "0.1.0",
        "targets": [
          "browser"
        ],
        "provides": [
          "vibeflow.port",
          "era.tavern.agent",
          "era.tavern.variables",
          "era.tavern.messages",
          "era.tavern.worldbook",
          "era.tavern.regex",
          "era.tavern.character",
          "era.tavern.identity",
          "era.tavern.sidecar",
          "era.tavern.installation_scope",
          "era.tavern.startup_gate"
        ],
        "dependencies": [],
        "config_keys": [
          "barrier_watchdog_ms",
          "limits",
          "ports",
          "staged_startup"
        ],
        "effect_scope": "trusted"
      }
    ],
    "plugins": []
  }
}
