          }
        ],
        "input_semantics": {
          "era.agent.generation.request": [
            "本阶段要发给模型的生成请求。"
          ],
          "era.step.request.routed": [
            "当前生成事件对应的已准备步骤。"
          ],
          "era.batch.execution.state": [
            "当前事件所属批次的执行状态。"
          ]
        },
        "output_semantics": {
          "candidate_state": [
            "合并请求、步骤和批次状态，供候选循环反复尝试。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
