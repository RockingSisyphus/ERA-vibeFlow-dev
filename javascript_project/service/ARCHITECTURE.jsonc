            "type_used": "vibeflow.loop.while",
            "source": {
              "root_id": "era-service",
              "path": "configs/nodesets/task_sync.jsonc"
            },
            "role": {
              "display_name": "逐块执行并提交全部目标楼层",
              "description": "每次应用一个块并保存状态、累计日志及进度；空楼、纯回退、删除清空与最后的进度清理由同一提交路径处理。done 调用跳过，无 done 调用以 ERA_FCALL_NOT_IMPLEMENTED 结束本消息且不调用工具；错误不停止永久服务。"
            },
            "contract_source": "system_config",
            "flow_kind": "predefined",
            "effect_scope": "none",
