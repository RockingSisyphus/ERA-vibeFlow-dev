          "additionalProperties": false,
          "properties": {
            "facts": {
              "type": "object"
            },
            "route": {
              "type": "string",
              "enum": [
                "continue",
                "blocked",
                "apply"
              ]
            },
            "choice": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "migrate",
                "independent",
                "copy",
                "repair",
                null
              ]
            }
          }
        }
      },
      "era.sidecar.binding.route": {
        "kind": "data_schema",
        "type_key": "era.sidecar.binding.route",
