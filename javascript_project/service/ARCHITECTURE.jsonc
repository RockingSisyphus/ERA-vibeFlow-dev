      "era.api.task.result": {
        "kind": "data_schema",
        "type_key": "era.api.task.result",
        "representation": "json",
        "display_name": "ERA 公共对象任务结果",
        "description": "保存公共接口任务的执行状态、返回值、回执和诊断，供原请求结算。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "committed",
                "no-op",
                "failed",
                "fatal"
              ]
            },
            "settlements": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "completed"
                      },
                      "taskId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "combined",
                          "coalesced"
                        ]
                      },
                      "value": {}
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "taskId",
                      "relation"
                    ],
                    "additionalProperties": false
