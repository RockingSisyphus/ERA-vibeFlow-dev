  "resources": {
    "data_schemas": {
      "era.agent.auxiliary.execution_request": {
        "kind": "data_schema",
        "type_key": "era.agent.auxiliary.execution_request",
        "representation": "json",
        "display_name": "ERA Agent 辅助阶段执行请求",
        "description": "归一化规划与变量结算的角色卡配置、预设脱敏快照和模型来源引用；只允许本机连接方案 ID 与名称提示进入领域 DTO，禁止 URL 与密钥正文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "routedStep",
            "executionState",
            "hostContext",
            "configurationVersion",
            "migrationMode",
            "configuration",
            "stages",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "routedStep": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            },
            "hostContext": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "configurationVersion": {
              "oneOf": [
                {
                  "enum": [
                    "1",
                    "2"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "migrationMode": {
              "enum": [
                "not-applicable",
                "v1-preserved",
                "v2"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "stages": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "enabled",
                  "retryCount",
                  "attempts"
                ],
                "properties": {
                  "stage": {
                    "enum": [
                      "planning",
                      "settlement"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "retryCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "attempts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 17,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "preset",
                        "modelSource"
                      ],
                      "properties": {
                        "preset": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source"
                          ],
                          "properties": {
                            "source": {
                              "enum": [
                                "builtin",
                                "snapshot"
                              ]
                            },
                            "sourceName": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "orderedPrompts": {
                              "type": "array",
                              "maxItems": 256,
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": true
                                  }
                                ]
                              }
                            },
                            "settings": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "modelSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "tavern-current",
                                "custom-profile"
                              ]
                            },
                            "profileId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "profileNameHint": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "model": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            },
                            "legacyModelOverride": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.connection.state": {
        "kind": "data_schema",
        "type_key": "era.agent.connection.state",
        "representation": "json",
        "display_name": "本机连接公开事实",
        "description": "当前记录数、查找键存在性与有效记录摘要，不包含秘密值。",
