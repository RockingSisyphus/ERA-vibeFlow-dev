      "era.agent.session.transition": {
        "kind": "data_schema",
        "type_key": "era.agent.session.transition",
        "representation": "json",
        "display_name": "ERA 故事生成会话转换结果",
        "description": "统一承载默认委托、阶段推进、设置保存、取消和失败后的会话状态更新与任务结算候选。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "step",
            "mode",
            "status",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "mode": {
              "enum": [
                "legacy",
                "legacy-ignore",
                "execute-legacy",
                "execute-only"
              ]
            },
            "status": {
              "enum": [
                "committed",
                "no-op",
                "failed"
              ]
            },
            "value": {},
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            },
            "handoff": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executionId",
                "completionId",
                "trigger",
                "chatKey",
                "stage",
                "result"
              ],
              "properties": {
                "executionId": {
                  "type": "string"
                },
                "completionId": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "chatKey": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "planning",
                    "story",
                    "settlement"
                  ]
                },
                "result": {
                  "type": "object",
                  "additionalProperties": true
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "mk": {
                  "type": "string"
                },
                "swipeId": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
