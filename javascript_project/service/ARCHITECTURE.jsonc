  "resources": {
    "data_schemas": {
      "era.agent.auxiliary.execution_request": {
        "kind": "data_schema",
        "type_key": "era.agent.auxiliary.execution_request",
        "representation": "json",
        "display_name": "ERA Agent 辅助阶段执行请求",
        "description": "归一化规划与变量结算的角色卡配置、预设脱敏快照和模型来源引用；只允许本机连接方案 ID 与名称提示进入领域 DTO，禁止 URL 与密钥正文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "routedStep",
            "executionState",
            "hostContext",
            "configurationVersion",
            "migrationMode",
            "configuration",
            "stages",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "routedStep": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            },
            "hostContext": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "configurationVersion": {
              "oneOf": [
                {
                  "enum": [
                    "1",
                    "2"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "migrationMode": {
              "enum": [
                "not-applicable",
                "v1-preserved",
                "v2"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "stages": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "enabled",
                  "retryCount",
                  "attempts"
                ],
                "properties": {
                  "stage": {
                    "enum": [
                      "planning",
                      "settlement"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "retryCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "attempts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 17,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "preset",
                        "modelSource"
                      ],
                      "properties": {
                        "preset": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source"
                          ],
                          "properties": {
                            "source": {
                              "enum": [
                                "builtin",
                                "snapshot"
                              ]
                            },
                            "sourceName": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "orderedPrompts": {
                              "type": "array",
                              "maxItems": 256,
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": true
                                  }
                                ]
                              }
                            },
                            "settings": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "modelSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "tavern-current",
                                "custom-profile"
                              ]
                            },
                            "profileId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "profileNameHint": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "model": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            },
                            "legacyModelOverride": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.candidate.done": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.done",
        "representation": "json",
        "display_name": "候选结束标记",
        "description": "为真时结束候选重试循环；为假时使用更新后的请求再试一次。",
        "schema": {
          "type": "boolean",
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.outcome": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.outcome",
        "representation": "json",
        "display_name": "候选循环最终结果",
        "description": "候选完成后交给生成会话的结果；内部重试请求不向外传播。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.state": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.state",
        "representation": "json",
        "display_name": "当前候选状态",
        "description": "保存本次候选的生成请求、已准备步骤和所属批次状态。",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "step",
            "executionState"
          ],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": true
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.state.next": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.state.next",
        "representation": "json",
        "display_name": "更新后的候选状态",
        "description": "保留步骤与批次状态，并在需要重试时替换生成请求。",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "step",
            "executionState"
          ],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": true
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.connection.state": {
        "kind": "data_schema",
        "type_key": "era.agent.connection.state",
        "representation": "json",
        "display_name": "本机连接公开事实",
        "description": "当前记录数、查找键存在性与有效记录摘要，不包含秘密值。",
        "schema": {
          "type": "object",
          "required": [
            "entryCount",
            "entryExists",
            "profile"
          ],
          "additionalProperties": false,
          "properties": {
            "entryCount": {
              "type": "integer",
              "minimum": 0
            },
            "entryExists": {
              "type": "boolean"
            },
            "profile": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "apiUrl": {
                  "type": "string"
                },
                "hasKey": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "apiUrl",
                "hasKey"
              ],
              "additionalProperties": false
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.function_call.result": {
        "kind": "data_schema",
        "type_key": "era.agent.function_call.result",
        "representation": "json",
        "display_name": "ERA Agent 纯函数调用结果",
        "description": "按原调用顺序保存已验证函数、有限数值结果、候选消息 MK 与可重放随机抽取区间。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "messageMk",
            "drawStart",
            "drawEnd",
            "calls",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "planning-exhausted",
                "failed",
                "cancelled"
              ]
            },
            "messageMk": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "drawStart": {
              "type": "integer",
              "minimum": 0
            },
            "drawEnd": {
              "type": "integer",
              "minimum": 0
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "function",
                  "args",
                  "result"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  },
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "result": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      },
      "era.agent.generation.decision": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.decision",
        "representation": "json",
        "display_name": "生成阶段决策",
        "description": "记录当前生成事件应继续执行、恢复还是直接结算。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.facts": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.facts",
        "representation": "json",
        "display_name": "生成事件与会话事实",
        "description": "汇集生成事件、来源及当前会话状态供阶段判断。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.outcome": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.outcome",
        "representation": "json",
        "display_name": "生成阶段执行结果",
        "description": "记录一次生成阶段的执行结果与后续阶段所需事实。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.raw": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.raw",
        "representation": "json",
        "display_name": "尚未应用的生成输出",
        "description": "保留模型原文，待共用块执行流程按位置应用。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.request": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.request",
        "representation": "json",
        "display_name": "生成阶段所需输入",
        "description": "保存本阶段发给模型的请求及继续执行所需上下文。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.host.request": {
        "kind": "data_schema",
        "type_key": "era.agent.host.request",
        "representation": "json",
        "display_name": "ERA Agent 宿主请求",
        "description": "Service 已决定的有界 Agent 酒馆或模型 I/O 请求；Host 不解释阶段业务。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requestPolicy": {
              "type": "object",
              "required": [
                "binding",
                "sampling"
              ],
              "additionalProperties": false,
              "properties": {
                "binding": {
                  "type": "object",
                  "required": [
                    "kind",
                    "profileId",
                    "model"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "custom-profile",
                        "tavern-current"
                      ]
                    },
                    "profileId": {},
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "sampling": {
                  "type": "object",
                  "required": [
                    "maxTokens",
                    "temperature",
                    "frequencyPenalty",
                    "presencePenalty",
                    "topP",
                    "topK"
                  ],
                  "properties": {
                    "maxTokens": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "temperature": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "frequencyPenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "presencePenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topP": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topK": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyMode": {
              "enum": [
                "clear",
                "replace-if-nonempty-otherwise-preserve"
              ]
            },
            "status": {
              "enum": [
                "created",
                "updated"
              ]
            }
          }
        }
      },
      "era.agent.host.result": {
        "kind": "data_schema",
        "type_key": "era.agent.host.result",
        "representation": "json",
        "display_name": "ERA Agent 宿主结果",
        "description": "Agent Host capability 返回的脱敏、可序列化、有界事实或模型原文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requestedName": {
              "type": "string"
            },
            "loadedName": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "enabled",
                  "role",
                  "content"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "content": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "era.agent.planning.attempt_result": {
        "kind": "data_schema",
        "type_key": "era.agent.planning.attempt_result",
        "representation": "json",
        "display_name": "ERA 规划尝试结果",
        "description": "保存有界规划尝试、严格故事计划、最多 32 项函数调用表及可定位诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "attempts",
            "storyPlan",
            "calls"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "exhausted",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 17,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "output",
                  "diagnostics"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "output": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "storyPlan": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "function",
                  "args"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.session.binding.facts": {
        "kind": "data_schema",
        "type_key": "era.agent.session.binding.facts",
        "representation": "json",
        "display_name": "会话关联即时事实",
        "description": "原生生成是否活动及旧会话关联字段，不含宿主控制器。",
        "schema": {
          "type": "object",
          "required": [
            "active",
            "previous"
          ],
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "boolean"
            },
            "previous": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "execution": {},
                "storyRequestId": {},
                "nativeGeneration": {}
              },
              "additionalProperties": false
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.session.context": {
        "kind": "data_schema",
        "type_key": "era.agent.session.context",
        "representation": "json",
        "display_name": "ERA 故事生成会话上下文",
        "description": "Service 从已路由事件与 Host 脱敏投影组合出的有界角色卡、聊天、分支、消息、配置和活动会话上下文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventType",
            "chatKey",
            "branchKey",
            "speakerKey",
            "messageId",
            "swipeIndex",
            "revision",
            "configuration",
            "session"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "chatKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "branchKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "speakerKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "messageId": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "swipeIndex": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "session": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "era.agent.session.route": {
        "kind": "data_schema",
        "type_key": "era.agent.session.route",
        "representation": "json",
        "display_name": "ERA 故事生成会话路由",
        "description": "把四种阶段模式折叠为委托原任务或直接结算两条互斥工作流分支；完整模式仍保留在 transition 中。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "enum": [
            "legacy",
            "direct"
          ]
        }
      },
      "era.agent.session.transition": {
        "kind": "data_schema",
        "type_key": "era.agent.session.transition",
        "representation": "json",
        "display_name": "ERA 故事生成会话转换结果",
        "description": "统一承载默认委托、阶段推进、设置保存、取消和失败后的会话状态更新与任务结算候选。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "step",
            "mode",
            "status",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "mode": {
              "enum": [
                "legacy",
                "legacy-ignore",
                "execute-legacy",
                "execute-only"
              ]
            },
            "status": {
              "enum": [
                "committed",
                "no-op",
                "failed"
              ]
            },
            "value": {},
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            },
            "handoff": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executionId",
                "completionId",
                "trigger",
                "chatKey",
                "stage",
                "result"
              ],
              "properties": {
                "executionId": {
                  "type": "string"
                },
                "completionId": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "chatKey": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "planning",
                    "story",
                    "settlement"
                  ]
                },
                "result": {
                  "type": "object",
                  "additionalProperties": true
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "mk": {
                  "type": "string"
                },
                "swipeId": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "era.agent.settings.outcome": {
        "kind": "data_schema",
        "type_key": "era.agent.settings.outcome",
        "representation": "json",
