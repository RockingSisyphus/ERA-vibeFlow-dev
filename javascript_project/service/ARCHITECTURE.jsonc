    "era.service.prepare_batch_phase": {
      "type_key": "era.service.prepare_batch_phase",
      "source": {
        "root_id": "era-service",
        "path": "configs/nodesets/service_prepare_batch_phase.jsonc"
      },
      "display_name": "ERA 就绪批次规划阶段",
      "description": "把就绪事件集合规划成有顺序的任务，核对来源无漏项、无重复、无批次外事件且步骤不超过 128。通过后进入执行阶段，留待下一轮执行第一个任务；失败则不执行领域任务，直接结算并发布失败帧。这样任务规划问题不会造成来源调用失去结果。",
      "status": "implemented",
      "flow_kind": "predefined",
      "effect_scope": "none",
      "reachable_from_workflow": true,
      "requires": [
        {
          "type": "era.collection.reduction",
          "cardinality": "exactly_one",
          "display_name": "就绪事件集"
        }
      ],
      "provides": [
        {
          "key": "prepared_cycle_state",
          "type": "era.service.cycle.state",
          "display_name": "下一阶段状态"
        }
      ],
      "global_config": {},
      "body": {
        "source": {
          "root_id": "era-service",
