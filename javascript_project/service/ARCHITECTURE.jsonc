                                  "type": "null"
                                }
                              ]
                            },
                            "messageChanged": {
                              "type": "boolean"
                            },
                            "variablesChanged": {
                              "type": "boolean"
                            },
                            "failure": {
                              "oneOf": [
                                {
                                  "type": "null"
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "code",
                                    "message",
                                    "category",
                                    "retryable"
                                  ],
                                  "properties": {
                                    "code": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "message": {
                                      "type": "string"
                                    },
                                    "category": {
                                      "enum": [
                                        "input",
                                        "domain",
                                        "tavern",
                                        "cancelled"
                                      ]
                                    },
                                    "retryable": {
                                      "const": false
                                    },
                                    "details": {
                                      "type": "object"
                                    }
                                  }
                                }
                              ]
                            },
                            "generationCycleIdentity": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "chatId",
                                    "eventId",
                                    "sourceKey"
                                  ],
                                  "properties": {
                                    "chatId": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "eventId": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "sourceKey": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "floorIdentity": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "chatId",
                                    "messageId",
                                    "swipeId",
                                    "mk"
                                  ],
                                  "properties": {
                                    "chatId": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "messageId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "swipeId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "mk": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "stagedMessageUpdates": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "messageId",
                                  "content"
                                ],
                                "properties": {
                                  "messageId": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "content": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "sourceBasis": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "identity",
                                "messages"
                              ],
                              "properties": {
                                "identity": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "characterId",
                                    "chatId",
                                    "groupId"
                                  ],
                                  "properties": {
                                    "characterId": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "chatId": {
                                      "type": "string"
                                    },
                                    "groupId": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    }
                                  }
                                },
                                "messages": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "schemaVersion",
                                      "messageId",
                                      "role",
                                      "activeText",
                                      "swipeIndex"
                                    ],
                                    "properties": {
                                      "schemaVersion": {
                                        "const": 1
                                      },
                                      "messageId": {
                                        "type": "integer",
                                        "minimum": 0
                                      },
                                      "role": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "activeText": {
                                        "type": "string"
                                      },
                                      "swipeIndex": {
                                        "oneOf": [
                                          {
                                            "type": "integer",
                                            "minimum": 0
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "agentFloorCandidate": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "messageId",
                                    "swipeId",
                                    "mk",
                                    "content",
                                    "extra",
                                    "terminalStatus",
                                    "requiresInitialPresentation"
                                  ],
                                  "properties": {
                                    "messageId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "swipeId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "mk": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "content": {
                                      "type": "string"
                                    },
                                    "extra": {
                                      "type": "object"
                                    },
                                    "terminalStatus": {
                                      "enum": [
                                        "settled",
                                        "story-complete",
                                        "unsettled"
                                      ]
                                    },
                                    "requiresInitialPresentation": {
                                      "type": "boolean"
                                    }
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "stepId",
                    "index",
                    "taskRoute",
                    "sourceSequences",
                    "events",
                    "reason",
                    "dispatchContext"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "failure": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "input",
                    "domain",
                    "tavern",
                    "cancelled"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "details": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "code",
                "message",
                "category",
                "retryable"
              ],
              "additionalProperties": false
            }
          }
        }
      },
