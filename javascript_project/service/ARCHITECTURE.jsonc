    "era.service.iteration": {
      "type_key": "era.service.iteration",
      "source": {
        "root_id": "era-service",
        "path": "configs/nodesets/service_iteration.jsonc"
      },
      "display_name": "ERA 服务阶段迭代：准备后直属执行",
      "description": "一轮先收集事件，或完整执行在途批次的一个步骤。执行步骤时先准备资源/API/会话，再在本轮同级调用共享同步、commit 或候选循环，返回后适配原任务结果并统一结算。准备与接续不重新入 FIFO、不跨 Service 迭代保存恢复点；索引只在最终结果合并后推进，完整批次结果先发送再报告致命失败。",
      "status": "implemented",
      "flow_kind": "predefined",
      "effect_scope": "none",
      "reachable_from_workflow": true,
      "requires": [
        {
          "type": "era.service.cycle.state",
          "cardinality": "exactly_one",
          "display_name": "当前阶段状态"
        }
      ],
      "provides": [
        {
          "key": "cycle_state_next",
          "type": "era.service.cycle.state",
          "display_name": "下一阶段状态"
        }
      ],
      "global_config": {},
      "body": {
        "source": {
          "root_id": "era-service",
          "path": "configs/nodesets/service_iteration.jsonc"
        },
        "inputs": [
          {
            "key": "cycle_state",
