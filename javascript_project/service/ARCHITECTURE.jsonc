    "host_extensions": [
      {
        "id": "era.tavern.service_host",
        "status": "implemented",
        "display_name": "ERA 酒馆服务宿主",
        "category": "宿主接线",
        "description": "连接 SillyTavern 与 Tavern Helper，管理单一先进先出队列、回执、高水位屏障、绝对截止时间定时器、宿主引用和出站帧幂等，并提供服务端口、五类酒馆能力与 Sidecar 身份/files/UI 机械接线；消息读取按 era-active-message-v1 投影，Host 不承载 CRUD、同步、合并、回滚或身份判定规则。",
        "version": "0.1.0",
        "targets": [
          "browser"
        ],
        "provides": [
          "vibeflow.port",
          "era.tavern.variables",
          "era.tavern.messages",
          "era.tavern.worldbook",
          "era.tavern.regex",
          "era.tavern.identity",
          "era.tavern.sidecar"
        ],
        "dependencies": [],
        "config_keys": [
          "barrier_watchdog_ms",
          "limits",
          "ports"
        ],
        "effect_scope": "trusted"
      }
    ],
    "plugins": []
  }
