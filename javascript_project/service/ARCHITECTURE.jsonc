                                    "messageId",
                                    "swipeId",
                                    "mk",
                                    "content",
                                    "extra",
                                    "terminalStatus",
                                    "requiresInitialPresentation"
                                  ],
                                  "properties": {
                                    "messageId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "swipeId": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "mk": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "content": {
                                      "type": "string"
                                    },
                                    "extra": {
                                      "type": "object"
                                    },
                                    "terminalStatus": {
                                      "enum": [
                                        "settled",
                                        "story-complete",
                                        "unsettled"
                                      ]
                                    },
                                    "requiresInitialPresentation": {
                                      "type": "boolean"
                                    }
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "stepId",
                    "index",
                    "taskRoute",
                    "sourceSequences",
                    "events",
                    "reason",
                    "dispatchContext"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "failure": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "input",
                    "domain",
                    "tavern",
                    "cancelled"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "details": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "code",
                "message",
                "category",
                "retryable"
              ],
              "additionalProperties": false
            }
          }
        }
      },
