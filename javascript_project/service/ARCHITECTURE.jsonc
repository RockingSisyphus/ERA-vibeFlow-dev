            "type": "era.batch.execution.state",
            "display_name": "当前批次和消息进度"
          },
          {
            "key": "followup_step",
            "type": "era.step.request.routed",
            "display_name": "本次执行的任务及聊天资料"
          },
          {
            "key": "followup_direct",
            "type": "era.task.execution.result.selected",
            "display_name": "准备阶段已确定的任务结果"
          }
        ],
        "input_semantics": {
          "era.task.prepared": [
            "输入：任务准备结果。"
          ]
        },
        "output_semantics": {
          "followup_route": [
            "输出：这项任务接下来要执行的动作。"
          ],
          "followup_continuation": [
            "输出：原任务、事件来源与回执资料。"
          ],
          "followup_batch": [
            "输出：当前批次和消息进度。"
          ],
          "followup_step": [
            "输出：本次执行的任务及聊天资料。"
          ],
          "followup_direct": [
            "输出：准备阶段已确定的任务结果。"
          ]
