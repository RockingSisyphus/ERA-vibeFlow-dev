                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "json"
                            },
                            "value": {}
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "undefined"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "host-ref"
                            },
                            "token": {
                              "type": "string",
                              "minLength": 1
                            },
                            "refKind": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "token",
                            "refKind"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "encodedBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                },
                "required": [
                  "schemaVersion",
                  "eventId",
                  "sequence",
                  "type",
                  "occurredAt",
                  "source",
                  "args",
                  "encodedBytes"
                ],
                "additionalProperties": false
              }
            },
            "collectionBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2097152
            },
            "iteration": {
              "type": "integer",
              "minimum": 0
            },
            "consecutiveProcessingCount": {
              "type": "integer",
              "minimum": 0
            },
            "consecutiveMk": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "timerToken": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "syncCursor": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mk": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blockIndex": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "messageId",
                    "mk",
                    "blockIndex"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "scopeWindow": {
              "type": "object",
              "properties": {
                "token": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageId": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageAdmission": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "branchAdmission": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "token",
                "messageId",
                "messageAdmission",
                "branchAdmission"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "collection",
            "collectionBytes",
            "iteration",
            "consecutiveProcessingCount",
            "consecutiveMk",
            "timerToken",
            "scopeWindow"
          ],
          "additionalProperties": false
        }
      },
