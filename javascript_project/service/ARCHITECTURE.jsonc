                "role",
                "activeText"
              ]
            },
            "meta": {
              "type": [
                "object",
                "null"
              ]
            },
            "placeholderSettings": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "enabled",
                "value"
              ],
              "additionalProperties": false
            },
            "failure": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "input",
                    "domain",
                    "tavern",
                    "cancelled"
                  ]
                },
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "code",
                "message",
                "category",
                "retryable"
              ]
            }
          },
          "additionalProperties": false
        }
      },
