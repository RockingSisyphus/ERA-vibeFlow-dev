      "era.tavern.messages.read_context.outcome": {
        "kind": "data_schema",
        "type_key": "era.tavern.messages.read_context.outcome",
        "representation": "json",
        "display_name": "ERA 消息读取结果封装",
        "description": "在严格 Capability 投影外层记录成功值或带类型读取失败，供领域任务普通失败结算。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "messages"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 2
                    },
                    "messages": {
                      "type": "array"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "era.tavern.messages.read_context.request": {
        "kind": "data_schema",
        "type_key": "era.tavern.messages.read_context.request",
        "representation": "json",
        "display_name": "ERA·酒馆·消息·读取·上下文·请求",
        "description": "定义“ERA·酒馆·消息·读取·上下文·请求”的数据结构与校验约束。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection",
            "range"
          ],
          "properties": {
            "projection": {
              "const": "era-active-message-v1"
            },
            "range": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
                }
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "era.tavern.messages.read_context.result": {
        "kind": "data_schema",
        "type_key": "era.tavern.messages.read_context.result",
        "representation": "json",
        "display_name": "ERA·酒馆·消息·读取·上下文·结果",
        "description": "定义“ERA·酒馆·消息·读取·上下文·结果”的数据结构与校验约束。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "messages"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schemaVersion",
                  "messageId",
                  "role",
                  "activeText",
                  "swipeIndex"
                ],
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "messageId": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "activeText": {
                    "type": "string"
                  },
                  "swipeIndex": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
