      "era.task.prepared": {
        "kind": "data_schema",
        "type_key": "era.task.prepared",
        "representation": "json",
        "display_name": "任务准备结果",
        "description": "仅在当前在途任务内使用，包含待执行请求和原来源接续依据；不表示业务已应用。",
        "schema": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object"
            },
            "continuation": {
              "type": "object"
            }
          },
          "required": [
