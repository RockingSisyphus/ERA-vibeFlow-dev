      "era.agent.host.request": {
        "kind": "data_schema",
        "type_key": "era.agent.host.request",
        "representation": "json",
        "display_name": "ERA Agent 宿主请求",
        "description": "Service 已决定的有界 Agent 酒馆或模型 I/O 请求；Host 不解释阶段业务。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requestPolicy": {
              "type": "object",
              "required": [
                "binding",
                "sampling"
              ],
              "additionalProperties": false,
              "properties": {
                "binding": {
                  "type": "object",
                  "required": [
                    "kind",
                    "profileId",
                    "model"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "custom-profile",
                        "tavern-current"
                      ]
                    },
                    "profileId": {},
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "sampling": {
                  "type": "object",
                  "required": [
                    "maxTokens",
                    "temperature",
                    "frequencyPenalty",
                    "presencePenalty",
                    "topP",
                    "topK"
                  ],
                  "properties": {
                    "maxTokens": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "temperature": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "frequencyPenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "presencePenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topP": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topK": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyMode": {
              "enum": [
                "clear",
                "replace-if-nonempty-otherwise-preserve"
              ]
            },
            "status": {
              "enum": [
                "created",
                "updated"
              ]
            }
          }
        }
      },
