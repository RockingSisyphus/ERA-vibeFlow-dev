      "era.transport.event": {
        "kind": "data_schema",
        "type_key": "era.transport.event",
        "representation": "json",
        "display_name": "ERA 已校验传输事件",
        "description": "通过结构、序号、字节与参数标签校验后的完整事件。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "allOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "enum": [
                        "tavern",
                        "ui",
                        "era-api"
                      ]
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "const": "timer"
                    },
                    "type": {
                      "const": "era.service.collection_timer"
                    }
                  },
                  "required": [
                    "source",
                    "type"
                  ]
                }
              ]
            }
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "eventId": {
              "type": "string",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "occurredAt": {
              "type": "number"
            },
            "source": {
              "type": "string",
              "enum": [
                "tavern",
                "ui",
                "era-api",
                "timer"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
