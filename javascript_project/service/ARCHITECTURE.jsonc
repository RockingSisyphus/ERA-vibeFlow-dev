                        "type": "string",
                        "enum": [
                          "tavern",
                          "ui",
                          "era-api",
                          "timer"
                        ]
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "const": "json"
                                },
                                "value": {}
                              },
                              "required": [
                                "kind",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "const": "undefined"
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "const": "host-ref"
                                },
                                "token": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "refKind": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "kind",
                                "token",
                                "refKind"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "encodedBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 262144
                      }
                    },
                    "required": [
                      "schemaVersion",
                      "eventId",
                      "sequence",
                      "type",
                      "occurredAt",
                      "source",
                      "args",
                      "encodedBytes"
                    ],
                    "additionalProperties": false
                  }
                },
                "collectionBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2097152
                },
                "iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "consecutiveProcessingCount": {
                  "type": "integer",
                  "minimum": 0
                },
