                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "activeText": {
                    "type": "string"
                  },
                  "swipeIndex": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
