      "era.api.task.result": {
        "kind": "data_schema",
        "type_key": "era.api.task.result",
        "representation": "json",
        "display_name": "ERA 公共对象任务结果",
        "description": "公共对象任务在原位同步前后保持标准任务结果形状的独立数据类型。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "committed",
                "no-op",
                "failed",
                "fatal"
              ]
            },
            "settlements": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "completed"
                      },
                      "taskId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "combined",
                          "coalesced"
                        ]
                      },
                      "value": {}
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "taskId",
                      "relation"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "ignored"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "failed"
                      },
                      "error": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "message": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "input",
                              "domain",
                              "tavern",
                              "cancelled"
                            ]
                          },
                          "retryable": {
                            "type": "boolean"
                          },
                          "details": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "required": [
                          "code",
                          "message",
                          "category",
                          "retryable"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "error"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "cancelled"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "notifications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "json"
                            },
                            "value": {}
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "undefined"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "host-ref"
                            },
                            "token": {
                              "type": "string",
                              "minLength": 1
                            },
                            "refKind": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "token",
                            "refKind"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "args"
                ],
                "additionalProperties": false
              }
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  },
                  "sequence": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "sequence"
                ],
                "additionalProperties": false
              }
            },
            "stateUpdate": {
              "type": "object",
              "properties": {
                "consecutiveMk": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "consecutiveProcessingCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "syncCursor": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "messageId": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "mk": {
                          "type": "string",
                          "minLength": 1
                        },
                        "blockIndex": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "messageId",
                        "mk",
                        "blockIndex"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "scopeWindow": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "branchAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "messageId",
                    "messageAdmission",
                    "branchAdmission"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "consecutiveMk",
                "consecutiveProcessingCount"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "settlements",
            "notifications",
            "diagnostics"
          ],
          "additionalProperties": false
        }
      },
      "era.api.window.recheck.route": {
        "kind": "data_schema",
        "type_key": "era.api.window.recheck.route",
        "representation": "json",
        "display_name": "窗口复核路由",
