        "description": "保存已经准备好、接下来需要执行的请求，以及原任务、事件来源和批次资料。",
        "schema": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object"
            },
            "continuation": {
              "type": "object"
            }
          },
