      "era.agent.session.context": {
        "kind": "data_schema",
        "type_key": "era.agent.session.context",
        "representation": "json",
        "display_name": "ERA 故事生成会话上下文",
        "description": "Service 从已路由事件与 Host 脱敏投影组合出的有界角色卡、聊天、分支、消息、配置和活动会话上下文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventType",
            "chatKey",
            "branchKey",
            "speakerKey",
            "messageId",
            "swipeIndex",
            "revision",
            "configuration",
            "session"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "chatKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "branchKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "speakerKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "messageId": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "swipeIndex": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "session": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "era.agent.session.route": {
        "kind": "data_schema",
        "type_key": "era.agent.session.route",
        "representation": "json",
        "display_name": "ERA 故事生成会话路由",
        "description": "把四种阶段模式折叠为委托原任务或直接结算两条互斥工作流分支；完整模式仍保留在 transition 中。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "enum": [
            "legacy",
            "direct"
          ]
        }
      },
      "era.agent.session.transition": {
        "kind": "data_schema",
        "type_key": "era.agent.session.transition",
        "representation": "json",
        "display_name": "ERA 故事生成会话转换结果",
        "description": "统一承载默认委托、阶段推进、设置保存、取消和失败后的会话状态更新与任务结算候选。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "step",
            "mode",
            "status",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "mode": {
              "enum": [
                "legacy",
                "legacy-ignore",
                "execute-legacy",
                "execute-only"
              ]
            },
            "status": {
              "enum": [
                "committed",
                "no-op",
                "failed"
              ]
            },
            "value": {},
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            },
            "handoff": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executionId",
                "completionId",
                "trigger",
                "chatKey",
                "stage",
                "result"
              ],
              "properties": {
                "executionId": {
                  "type": "string"
                },
                "completionId": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "chatKey": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "planning",
                    "story",
                    "settlement"
                  ]
                },
                "result": {
                  "type": "object",
                  "additionalProperties": true
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "mk": {
                  "type": "string"
                },
                "swipeId": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
