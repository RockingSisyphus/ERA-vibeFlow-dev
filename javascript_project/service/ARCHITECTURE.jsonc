                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "consecutiveProcessingCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "syncCursor": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "messageId": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "mk": {
                          "type": "string",
                          "minLength": 1
                        },
                        "blockIndex": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "messageId",
                        "mk",
                        "blockIndex"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "scopeWindow": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "branchAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "messageId",
                    "messageAdmission",
                    "branchAdmission"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "consecutiveMk",
                "consecutiveProcessingCount"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "settlements",
            "notifications",
            "diagnostics"
          ],
          "additionalProperties": false
        }
      },
