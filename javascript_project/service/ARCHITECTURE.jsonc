              "type": "object"
            },
            "apiContext": {
              "type": [
                "object",
                "null"
              ]
            },
            "initializationContext": {
              "type": [
                "object",
                "null"
              ]
            },
            "agentContext": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "origin",
            "step",
            "executionState"
          ],
          "additionalProperties": false,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
