    "era.workbench.read_baseline": {
      "display_name": "读取当前独立状态文件基准",
      "description": "读取当前聊天的状态文件绑定及可用的内存变量、函数，作为用户草稿比较和变更规划的依据。",
      "category": "工作台提交",
      "version": "1.0.0",
      "flow_kind": "process",
      "contract": {
        "requires": [
          {
            "type": "era.api.commit.inspected",
            "cardinality": "exactly_one",
            "display_name": "已读取的提交请求"
          }
        ],
        "provides": [
          {
            "key": "baseline",
            "type": "era.workbench.baseline",
            "display_name": "工作台当前基准"
          }
        ],
        "input_semantics": {
          "era.api.commit.inspected": [
            "输入：已读取的提交请求。"
          ]
        },
        "output_semantics": {
          "baseline": [
            "输出：工作台当前基准。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/api/workbench_read_baseline.ts",
            "export": "run"
          },
          "completion": "suspend"
        }
      ]
    },
    "era.workbench.reject_draft": {
      "display_name": "返回基准或输入失败",
      "description": "把草稿检查问题转换为公共 调用接口（API） 失败结果，说明需要重新读取或修改的原因。",
      "category": "工作台提交",
      "version": "1.0.0",
      "flow_kind": "process",
      "contract": {
        "requires": [
          {
            "type": "era.workbench.draft",
            "cardinality": "exactly_one",
            "display_name": "工作台编辑草稿"
          }
        ],
        "provides": [
          {
            "key": "rejected_preparation_result",
            "type": "era.workbench.preparation_result",
            "display_name": "工作台准备结果"
          }
        ],
        "input_semantics": {
          "era.workbench.draft": [
            "输入：工作台编辑草稿。"
          ]
        },
        "output_semantics": {
          "rejected_preparation_result": [
            "输出：工作台准备结果。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/api/shared_workbench_adapters.ts",
            "export": "WorkbenchRejectDraftNode"
          },
          "completion": "immediate"
        }
      ]
    },
    "era.workbench.validate_draft_basis": {
      "display_name": "校验编辑基准并区分变量和函数",
      "description": "核对草稿的聊天、文件绑定和原始值是否仍与当前资料一致。单项编辑检查目标项，整库编辑检查全部值；新增项确认目标尚不存在。资料已变化或请求格式无效时返回重新读取或修改提示。",
      "category": "工作台提交",
      "version": "1.0.0",
      "flow_kind": "decision",
      "contract": {
        "requires": [
          {
            "type": "era.workbench.baseline",
            "cardinality": "exactly_one",
            "display_name": "工作台当前基准"
          }
        ],
        "provides": [
          {
            "key": "draft",
            "type": "era.workbench.draft",
            "display_name": "工作台编辑草稿"
          },
          {
            "key": "draft_kind",
            "type": "era.workbench.kind",
            "display_name": "工作台编辑类型"
          }
        ],
        "input_semantics": {
          "era.workbench.baseline": [
            "输入：工作台当前基准。"
          ]
        },
        "output_semantics": {
          "draft": [
            "输出：工作台编辑草稿。"
          ],
          "draft_kind": [
            "输出：工作台编辑类型。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
          "targets": [
            "browser"
          ],
          "source": {
            "kind": "file",
            "ref": "nodes/api/shared_workbench_operation_adapters.ts",
            "export": "WorkbenchValidateDraftNode"
          },
          "completion": "immediate"
        }
      ]
    }
  },
  "resources": {
    "data_schemas": {
      "era.agent.auxiliary.execution_request": {
        "kind": "data_schema",
        "type_key": "era.agent.auxiliary.execution_request",
        "representation": "json",
        "display_name": "ERA 多阶段生成 辅助阶段执行请求",
        "description": "保存规划或结算阶段所需的角色配置、预设摘要和本机模型连接引用。连接使用方案标识及名称，供宿主找到实际连接配置。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "routedStep",
            "executionState",
            "hostContext",
            "configurationVersion",
            "migrationMode",
            "configuration",
            "stages",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "routedStep": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            },
            "hostContext": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "configurationVersion": {
              "oneOf": [
                {
                  "enum": [
                    "1",
                    "2"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "migrationMode": {
              "enum": [
                "not-applicable",
                "v1-preserved",
                "v2"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "stages": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "enabled",
                  "retryCount",
                  "attempts"
                ],
                "properties": {
                  "stage": {
                    "enum": [
                      "planning",
                      "settlement"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "retryCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "attempts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 17,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "preset",
                        "modelSource"
                      ],
                      "properties": {
                        "preset": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source"
                          ],
                          "properties": {
                            "source": {
                              "enum": [
                                "builtin",
                                "snapshot"
                              ]
                            },
                            "sourceName": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "orderedPrompts": {
                              "type": "array",
                              "maxItems": 256,
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": true
                                  }
                                ]
                              }
                            },
                            "settings": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "modelSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "tavern-current",
                                "custom-profile"
                              ]
                            },
                            "profileId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "profileNameHint": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "model": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            },
                            "legacyModelOverride": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.candidate.done": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.done",
        "representation": "json",
        "display_name": "本阶段是否已成功或无法继续",
        "description": "为真时结束候选重试循环；为假时使用更新后的请求再试一次。",
        "schema": {
          "type": "boolean",
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.outcome": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.outcome",
        "representation": "json",
        "display_name": "候选循环最终结果",
        "description": "候选完成后交给生成会话的结果；内部重试请求不向外传播。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.state": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.state",
        "representation": "json",
        "display_name": "本次模型尝试的请求、起点和进度",
        "description": "保存本次候选的生成请求、已准备步骤和所属批次状态。",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "step",
            "executionState"
          ],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": true
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.state.next": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.state.next",
        "representation": "json",
        "display_name": "本次尝试后的进度及重试请求",
        "description": "保留步骤与批次状态，并在需要重试时替换生成请求。",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "step",
            "executionState"
          ],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": true
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.candidate.state.selected": {
        "kind": "data_schema",
        "type_key": "era.agent.candidate.state.selected",
        "representation": "json",
        "display_name": "选定入口的本次模型尝试的请求、起点和进度",
        "description": "执行入口选中时携带真实请求或结果，其他入口为 null；实际入口沿用原请求合同。",
        "schema": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request",
                "step",
                "executionState"
              ],
              "properties": {
                "request": {
                  "type": "object",
                  "additionalProperties": true
                },
                "step": {
                  "type": "object",
                  "additionalProperties": true
                },
                "executionState": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.connection.state": {
        "kind": "data_schema",
        "type_key": "era.agent.connection.state",
        "representation": "json",
        "display_name": "本机连接公开事实",
        "description": "当前记录数、查找键存在性与有效记录摘要，不包含秘密值。",
        "schema": {
          "type": "object",
          "required": [
            "entryCount",
            "entryExists",
            "profile"
          ],
          "additionalProperties": false,
          "properties": {
            "entryCount": {
              "type": "integer",
              "minimum": 0
            },
            "entryExists": {
              "type": "boolean"
            },
            "profile": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "apiUrl": {
                  "type": "string"
                },
                "hasKey": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "apiUrl",
                "hasKey"
              ],
              "additionalProperties": false
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.function_call.result": {
        "kind": "data_schema",
        "type_key": "era.agent.function_call.result",
        "representation": "json",
        "display_name": "ERA 多阶段生成 纯函数调用结果",
        "description": "按调用顺序保存已计算函数的名称、数值、消息历史标识和随机使用范围，供生成阶段整理结果。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "messageMk",
            "drawStart",
            "drawEnd",
            "calls",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "planning-exhausted",
                "failed",
                "cancelled"
              ]
            },
            "messageMk": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "drawStart": {
              "type": "integer",
              "minimum": 0
            },
            "drawEnd": {
              "type": "integer",
              "minimum": 0
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "function",
                  "args",
                  "result"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  },
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "result": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      },
      "era.agent.generation.decision": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.decision",
        "representation": "json",
        "display_name": "生成阶段决策",
        "description": "记录当前生成事件应继续执行、恢复还是直接结算。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.facts": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.facts",
        "representation": "json",
        "display_name": "生成事件与会话事实",
        "description": "汇集生成事件、来源及当前会话状态供阶段判断。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.outcome": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.outcome",
        "representation": "json",
        "display_name": "生成阶段执行结果",
        "description": "记录一次生成阶段的执行结果与后续阶段所需事实。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.raw": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.raw",
        "representation": "json",
        "display_name": "尚未应用的生成输出",
        "description": "保留模型原文，待共用块执行流程按位置应用。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.generation.request": {
        "kind": "data_schema",
        "type_key": "era.agent.generation.request",
        "representation": "json",
        "display_name": "生成阶段所需输入",
        "description": "保存本阶段发给模型的请求及继续执行所需上下文。",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.agent.host.request": {
        "kind": "data_schema",
        "type_key": "era.agent.host.request",
        "representation": "json",
        "display_name": "ERA 多阶段生成 宿主请求",
        "description": "保存 Service 要求酒馆或模型接口执行的具体生成、设置或页面操作，供宿主调用。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requestPolicy": {
              "type": "object",
              "required": [
                "binding",
                "sampling"
              ],
              "additionalProperties": false,
              "properties": {
                "binding": {
                  "type": "object",
                  "required": [
                    "kind",
                    "profileId",
                    "model"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "custom-profile",
                        "tavern-current"
                      ]
                    },
                    "profileId": {},
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "sampling": {
                  "type": "object",
                  "required": [
                    "maxTokens",
                    "temperature",
                    "frequencyPenalty",
                    "presencePenalty",
                    "topP",
                    "topK"
                  ],
                  "properties": {
                    "maxTokens": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "temperature": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "frequencyPenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "presencePenalty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topP": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    },
                    "topK": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "const": "same_as_preset"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyMode": {
              "enum": [
                "clear",
                "replace-if-nonempty-otherwise-preserve"
              ]
            },
            "status": {
              "enum": [
                "created",
                "updated"
              ]
            }
          }
        }
      },
      "era.agent.host.result": {
        "kind": "data_schema",
        "type_key": "era.agent.host.result",
        "representation": "json",
        "display_name": "ERA 多阶段生成 宿主结果",
        "description": "Agent Host capability 返回的脱敏、可序列化、有界事实或模型原文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requestedName": {
              "type": "string"
            },
            "loadedName": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "enabled",
                  "role",
                  "content"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "content": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "era.agent.planning.attempt_result": {
        "kind": "data_schema",
        "type_key": "era.agent.planning.attempt_result",
        "representation": "json",
        "display_name": "ERA 规划尝试结果",
        "description": "保存有界规划尝试、严格故事计划、最多 32 项函数调用表及可定位诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "attempts",
            "storyPlan",
            "calls"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "exhausted",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 17,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "output",
                  "diagnostics"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "output": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "storyPlan": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "function",
                  "args"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.session.binding.facts": {
        "kind": "data_schema",
