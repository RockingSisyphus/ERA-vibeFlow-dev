{
  "nodeset_imports": [
    {
      "path": "nodesets/service_iteration.jsonc"
    }
  ],
  "host_extensions": [
    {
      "id": "era.tavern.service_host",
      "enabled": true,
      "display_name": "ERA 酒馆服务宿主",
      "description": "酒馆宿主接收事件并按顺序交给 Service，提供受限的读写能力、回执和保存定时器。变量与生成规则仍由 Service 决定；宿主负责核对写入目标和保存结果。页面离开或服务停止时清理定时器与未完成请求，重新启动后按实际聊天恢复。",
      "config": {
        "ports": {
          "inbound": "era.service.in",
          "outbound": "era.service.out"
        },
        "limits": {
          "max_event_bytes": 262144,
          "max_fifo_events": 256,
          "max_fifo_bytes": 8388608,
          "max_host_refs_per_event": 32
        },
        "barrier_watchdog_ms": 5000,
        "staged_startup": true
      }
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_collection_events": 128,
      "max_collection_bytes": 2097152,
      "max_batch_steps": 128,
      "barrier_watchdog_ms": 5000,
      "max_host_refs_per_event": 32
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "async",
    "inputs": [],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "ERA 服务启动",
        "description": "这是“era.service”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "inspect_current_script_scope",
        "type_used": "era.installation.scope.inspect",
        "display_name": "读取当前脚本与脚本树",
        "description": "读取酒馆助手提供的当前脚本 ID，以及角色卡、全局和预设三个位置中已启用的脚本目录，得到当前脚本出现在哪些位置的事实。这里仅收集信息，不注册聊天监听器，也不自行决定是否启动；若宿主接口不可用，后续节点会据此选择兼容策略。"
      },
      {
        "id": "classify_installation_scope",
        "type_used": "era.installation.scope.classify",
        "display_name": "分类安装作用域",
        "description": "把当前脚本 ID 与已启用的脚本目录对应起来：只在角色卡中找到就归为角色卡脚本，只在全局或预设中找到就归到相应位置；同一 ID 出现在多个位置则记为位置不明确。读取失败、没有 ID 或没有匹配项记为未知，供启动策略区分“明确不应启动”和“无法判断”。这不是对所有 ERA 实例进行选主。"
      },
      {
        "id": "decide_startup_policy",
        "type_used": "era.installation.scope.decide",
        "display_name": "决定启动策略",
        "description": "根据脚本的安装位置决定本次 ERA 是否进入完整服务：角色卡内部的脚本继续启动；明确位于全局、预设，或同一脚本 ID 同时属于多个位置的实例只显示提示后结束，避免这些位置重复接管聊天。若宿主无法提供位置，则允许兼容启动并要求警告。这里输出策略，不负责停止其他实例，也不修改聊天。"
      },
      {
        "id": "activate_tavern_ingress",
        "type_used": "era.installation.scope.activate_ingress",
        "display_name": "登记单层显示窗口与角色卡设置",
        "description": "把已允许启动的决定交给浏览器宿主，启用 ERA 接收聊天事件的入口及相关显示控制。宿主负责登记角色卡单层显示开关，在开启时只保留目标 AI 消息的显示窗口，切换聊天时重新建立显示关系。这个节点只是启用宿主设施；变量计算、回滚和保存仍由后续 Service 任务处理。"
      },
      {
        "id": "publish_dormant_startup",
        "type_used": "era.installation.scope.publish_dormant",
        "display_name": "发布休眠安装提示",
        "description": "当当前 ERA 被判定为全局、预设或位置不明确的实例时，要求宿主显示未启动的原因，然后沿结束分支退出。这条分支不会接收聊天事件，也不会加载聊天状态文件、处理宏或启动业务 UI，因而不会以这个实例接管聊天变量。"
      },
      {
        "id": "initialize_state",
        "type_used": "era.service.initialize_state",
        "display_name": "初始化服务与 Scope 窗口状态",
        "description": "为刚启动的 ERA 创建本页面实例的运行状态，包括待收集事件、定时器信息、事件序号、批次计数和消息处理进度。消息作用域的窗口和准入字段初始为空，后续处理再建立有效窗口；重载或停止时随实例销毁；它们用于识别过期请求，不作为聊天变量写入消息或状态文件。"
      },
      {
        "id": "begin_cycle",
        "type_used": "era.service.cycle.begin",
        "display_name": "进入收集阶段",
        "description": "把初始服务状态标记为“收集事件”阶段，交给长期运行的服务循环。此时尚无批次需要执行，因此第一轮应等待聊天或 API 事件；本节点只增加阶段标签，保留原状态，不读取酒馆或修改变量。"
      },
      {
        "id": "service_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "永久服务循环",
        "description": "长期运行 ERA 服务，循环携带“收集事件”或“执行批次”状态。收集阶段每轮接收一个事件；执行阶段每轮完成一个任务步骤，全部结算并发布后才恢复收集。该循环没有固定业务轮数上限，由宿主生命周期控制停止；不是同时并行执行多批聊天操作。",
        "requires": [
          {
            "type": "era.service.cycle.state",
            "cardinality": "exactly_one",
            "display_name": "阶段循环状态"
          }
        ],
        "loop": {
          "body": "era.service.iteration",
          "max_iterations": null,
          "carry": [
            {
              "from": "era.service.cycle.state",
              "as": "cycle_state",
              "update": "cycleStateNext"
            }
          ]
        },
        "provides": []
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "ERA 服务结束",
        "description": "这是“era.service”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_current_script_scope"
      ],
      [
        "inspect_current_script_scope",
        "classify_installation_scope"
      ],
      [
        "classify_installation_scope",
        "decide_startup_policy"
      ],
      {
        "from": "decide_startup_policy",
        "to": "activate_tavern_ingress",
        "when": "installation_scope_route == 'allow'"
      },
      {
        "from": "decide_startup_policy",
        "to": "publish_dormant_startup",
        "when": "installation_scope_route == 'dormant'"
      },
      [
        "activate_tavern_ingress",
        "initialize_state"
      ],
      [
        "initialize_state",
        "begin_cycle"
      ],
      [
        "begin_cycle",
        "service_loop"
      ],
      [
        "service_loop",
        "end"
      ],
      [
        "publish_dormant_startup",
        "end"
      ]
    ],
    "outputs": []
  }
}
