{
  "nodeset_imports": [
    {
      "path": "nodesets/service_iteration.jsonc"
    },
    {
      "path": "nodesets/command_operations.jsonc"
    },
    {
      "path": "nodesets/command_compaction_replay_step.jsonc"
    },
    {
      "path": "nodesets/sealed_command_compaction.jsonc"
    },
    {
      "path": "nodesets/readonly_preview_step.jsonc"
    },
    {
      "path": "nodesets/prepare_generation_facts.jsonc"
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_collection_events": 128,
      "max_collection_bytes": 2097152,
      "max_batch_steps": 128,
      "barrier_watchdog_ms": 5000,
      "max_host_refs_per_event": 32
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "async",
    "inputs": [],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始ERA 主服务",
        "description": "标明“ERA 主服务”的开始位置。统一接收聊天变化和脚本请求，并按顺序计算、保存变量。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "inspect_current_script_scope",
        "display_name": "读取当前脚本及各处启用情况",
        "description": "在“ERA 主服务”流程中，读取当前脚本身份，以及角色卡、全局和预设中启用的脚本资料。启动判断据此确定本实例是否应处理聊天、呈现界面或保持休眠。",
        "definition_id": "era.installation.scope.inspect"
      },
      {
        "id": "choose_startup",
        "display_name": "按脚本安装位置决定启用或休眠",
        "description": "在“ERA 主服务”流程中，比较当前脚本在角色卡、全局或预设中的启用位置，决定该实例运行服务还是显示休眠提示。位置无法识别时按现有兼容规则启动并给出诊断，让后续使用明确的启用范围。",
        "definition_id": "era.installation.scope.choose_startup"
      },
      {
        "id": "activate_tavern_ingress",
        "display_name": "启用本实例的聊天监听和界面呈现",
        "description": "在“ERA 主服务”流程中，接收已经确定的脚本启用范围，在酒馆页面安装聊天事件监听及显示规则。按安装位置选择呈现目标，聊天界面重建后重新连接，让后续事件能够进入 ERA 服务。",
        "definition_id": "era.installation.scope.activate_ingress"
      },
      {
        "id": "publish_dormant_startup",
        "display_name": "向页面说明脚本为何处于休眠",
        "description": "在“ERA 主服务”流程中，接收脚本安装位置的休眠决定，向酒馆页面发布对应提示。当前实例随后结束启动分支，使用户能知道为什么它没有开始处理聊天。",
        "definition_id": "era.installation.scope.publish_dormant"
      },
      {
        "id": "begin_service",
        "display_name": "建立服务进度并开始收集事件",
        "description": "在“ERA 主服务”流程中，建立事件等待集合、定时安排、批次计数和消息处理进度，从收集事件阶段启动服务。后续聊天变化和脚本请求会按批次进入统一处理。",
        "definition_id": "era.service.begin"
      },
      {
        "id": "service_loop",
        "display_name": "持续接收事件并逐项处理任务",
        "description": "持续运行 ERA 主服务：等待聊天变化和脚本请求，收齐相关事件后规划一批任务，再逐项执行并回告结果。每批结束回到事件收集，页面离开或实例停止时结束，变量变化因此由同一服务按顺序处理。",
        "requires": [
          {
            "type": "era.service.cycle.state",
            "cardinality": "exactly_one",
            "display_name": "服务当前处于收集还是执行及相应进度"
          }
        ],
        "loop": {
          "body": "era.service.iteration",
          "max_iterations": null,
          "carry": [
            {
              "from": "era.service.cycle.state",
              "as": "cycle_state",
              "update": "cycleStateNext"
            }
          ]
        },
        "provides": [],
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "end",
        "display_name": "结束ERA 主服务",
        "description": "标明“ERA 主服务”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_current_script_scope"
      ],
      [
        "inspect_current_script_scope",
        "choose_startup"
      ],
      {
        "from": "choose_startup",
        "to": "activate_tavern_ingress",
        "when": "installation_scope_route == 'allow'"
      },
      {
        "from": "choose_startup",
        "to": "publish_dormant_startup",
        "when": "installation_scope_route == 'dormant'"
      },
      [
        "activate_tavern_ingress",
        "begin_service"
      ],
      [
        "begin_service",
        "service_loop"
      ],
      [
        "service_loop",
        "end"
      ],
      [
        "publish_dormant_startup",
        "end"
      ]
    ],
    "outputs": []
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/contracts/plugin.ts"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/structure_rules/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "rulesets": [
    "era.service.workflow_structure"
  ],
  "base_lib": {
    "modules": [
      "era.data_view",
      "era.command.operation_expressions",
      "era.command.operation_functions",
      "era.command.operation_state",
      "era.command.operation_traversal",
      "era.crud.mutations",
      "era.crud.parser",
      "era.service.agent_configuration",
      "era.service.agent_flow_policy",
      "era.service.agent_flow_types",
      "era.service.agent_generation_context",
      "era.service.agent_generation_continue",
      "era.service.agent_generation_planning",
      "era.service.agent_generation_session",
      "era.service.agent_generation_settlement",
      "era.service.agent_report_text",
      "era.service.agent_session_binding",
      "era.service.agent_settings_policy",
      "era.service.agent_stage_handoff",
      "era.service.agent_stage_program",
      "era.service.agent_stage_text",
      "era.service.agent_task_result",
      "era.service.command_compaction",
      "era.service.command_compaction_marker",
      "era.service.dispatch_preparation",
      "era.service.event_catalog",
      "era.service.event_planner",
      "era.service.facade_api_context",
      "era.service.facade_api_engine",
      "era.service.function_block_execution",
      "era.service.greeting_refresh_policy",
      "era.service.initialization_transaction",
      "era.service.message_function_calls",
      "era.service.mk_engine",
      "era.service.resource_contracts",
      "era.service.resource_planner",
      "era.service.resource_setup",
      "era.service.service_protocol_collection",
      "era.service.service_protocol_execution",
      "era.service.sidecar_binding",
      "era.service.sidecar_resolution_projection",
      "era.service.sync_commit_policy",
      "era.service.sync_contracts",
      "era.service.sync_divergence",
      "era.service.sync_divergence_detection",
      "era.service.sync_prepare",
      "era.service.sync_result_policy",
      "era.service.sync_types",
      "era.service.sync_work_preparation",
      "era.service.task_continuation",
      "era.service.types",
      "era.service.working_state",
      "era.snapshot.history",
      "era.sync.position_author",
      "era.sync.position_source",
      "era.workbench.context",
      "era.workbench.draft",
      "era.workbench.operations",
      "era.workbench.protection",
      "era.service.readonly_preview"
    ]
  }
}
