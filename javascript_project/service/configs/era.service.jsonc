{
  "nodeset_imports": [
    {
      "path": "nodesets/service_iteration.jsonc"
    }
  ],
  "host_extensions": [
    {
      "id": "era.tavern.service_host",
      "enabled": true,
      "display_name": "ERA 酒馆服务宿主",
      "description": "酒馆宿主接收事件并按顺序交给 Service，提供受限的读写能力、回执和保存定时器。变量与生成规则仍由 Service 决定；宿主负责核对写入目标和保存结果。页面离开或服务停止时清理定时器与未完成请求，重新启动后按实际聊天恢复。",
      "config": {
        "ports": {
          "inbound": "era.service.in",
          "outbound": "era.service.out"
        },
        "limits": {
          "max_event_bytes": 262144,
          "max_fifo_events": 256,
          "max_fifo_bytes": 8388608,
          "max_host_refs_per_event": 32
        },
        "barrier_watchdog_ms": 5000,
        "staged_startup": true
      }
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_collection_events": 128,
      "max_collection_bytes": 2097152,
      "max_batch_steps": 128,
      "barrier_watchdog_ms": 5000,
      "max_host_refs_per_event": 32
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "async",
    "inputs": [],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "ERA 服务启动",
        "description": "开始ERA 服务。"
      },
      {
        "id": "inspect_current_script_scope",
        "type_used": "era.installation.scope.inspect",
        "display_name": "读取当前脚本与脚本树",
        "description": "读取当前脚本身份及角色卡、全局、预设中的启用脚本资料，供启动位置判断。"
      },
      {
        "id": "choose_startup",
        "type_used": "era.installation.scope.choose_startup",
        "display_name": "根据安装位置选择启动方式",
        "description": "比对当前脚本在角色卡、全局和预设中的安装位置，决定启动服务还是显示休眠提示；位置未知时使用原有兼容启动方式，并给出诊断。"
      },
      {
        "id": "activate_tavern_ingress",
        "type_used": "era.installation.scope.activate_ingress",
        "display_name": "登记单层显示窗口与角色卡设置",
        "description": "在酒馆页面启用聊天事件监听和界面显示规则。根据脚本安装位置选择显示目标，并在聊天界面重建后重新连接。"
      },
      {
        "id": "publish_dormant_startup",
        "type_used": "era.installation.scope.publish_dormant",
        "display_name": "发布休眠安装提示",
        "description": "向酒馆页面显示脚本休眠原因，并结束本次启动分支。"
      },
      {
        "id": "begin_service",
        "type_used": "era.service.begin",
        "display_name": "建立服务状态，从事件收集开始",
        "description": "建立事件队列、计时器、批次计数和消息处理进度，随后进入收集聊天事件与脚本请求的阶段。"
      },
      {
        "id": "service_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "持续收集并执行酒馆事件",
        "description": "长期接收和处理酒馆事件。收集阶段每轮整理一个事件；执行阶段每轮完成当前批次的一个任务，再汇总结果。批次结束后回到事件收集，页面离开或服务停止时结束循环。",
        "requires": [
          {
            "type": "era.service.cycle.state",
            "cardinality": "exactly_one",
            "display_name": "服务当前阶段及待处理事件或任务"
          }
        ],
        "loop": {
          "body": "era.service.iteration",
          "max_iterations": null,
          "carry": [
            {
              "from": "era.service.cycle.state",
              "as": "cycle_state",
              "update": "cycleStateNext"
            }
          ]
        },
        "provides": []
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "ERA 服务结束",
        "description": "结束ERA 服务，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_current_script_scope"
      ],
      [
        "inspect_current_script_scope",
        "choose_startup"
      ],
      {
        "from": "choose_startup",
        "to": "activate_tavern_ingress",
        "when": "installation_scope_route == 'allow'"
      },
      {
        "from": "choose_startup",
        "to": "publish_dormant_startup",
        "when": "installation_scope_route == 'dormant'"
      },
      [
        "activate_tavern_ingress",
        "begin_service"
      ],
      [
        "begin_service",
        "service_loop"
      ],
      [
        "service_loop",
        "end"
      ],
      [
        "publish_dormant_startup",
        "end"
      ]
    ],
    "outputs": []
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/schemas.ts",
        "export": "plugin"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/era.ts",
        "export": "plugin"
      }
    }
  ]
}
