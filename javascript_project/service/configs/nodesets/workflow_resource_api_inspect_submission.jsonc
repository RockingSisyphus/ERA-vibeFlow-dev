{
  "type_key": "era.communication.api_inspect_submission",
  "display_name": "识别提交的是操作清单还是编辑草稿",
  "description": "读取本次允许处理的聊天消息范围，查看提交内容是明确的有序操作，还是变量、函数工作台的编辑草稿。草稿先转成可执行操作，之后再统一检查能否提交。 展开后查看该段实际需要的原生酒馆调用、等待和结果接回；具体操作仍按原业务分支选择。",
  "expand": true,
  "requires": [
    {
      "type": "era.api.request.selected",
      "cardinality": "exactly_one",
      "display_name": "已经选中的接口请求"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}, {"type":"era.workflow.resources_transferred","cardinality":"exactly_one","display_name":"本段实例资源已转交"}
  ],
  "provides": [
    {
      "key": "commit_inspected",
      "type": "era.api.commit.inspected",
      "display_name": "已识别内容和消息范围的提交请求"
    },
    {
      "key": "workbench_request_kind",
      "type": "era.workbench.request_kind",
      "display_name": "提交内容属于操作清单还是编辑草稿"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input0",
        "type": "era.api.request.selected",
        "required": true,
        "display_name": "已经选中的接口请求"
      },
      {
        "key": "input1",
        "type": "era.batch.execution.state",
        "required": true,
        "display_name": "当前批次的任务进度与累计结果"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.service.terminal",
        "display_name": "开始本段酒馆操作",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：标明该段业务操作的范围；跨工作流调用在中间明确显示。"
      },
      {
        "id": "prepare",
        "display_name": "准备本段业务并寻找第一个酒馆操作",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：读取本次允许处理的聊天消息范围，查看提交内容是明确的有序操作，还是变量、函数工作台的编辑草稿。草稿先转成可执行操作，之后再统一检查能否提交。 先做本地计算；无需酒馆操作时直接形成结果，避免虚构调用。",
        "definition_id": "era.communication.api_inspect_submission.prepare"
      },
      {
        "id": "operation_loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "按业务顺序完成实际需要的酒馆操作",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：每次接回当前操作的实际结果后才准备下一项，保持原错误和取消处理；不预先并发所有可能操作。",
        "requires": [
          {
            "type": "era.communication.api_inspect_submission.state",
            "cardinality": "exactly_one",
            "display_name": "本业务段的本地计算和酒馆操作进度"
          },
          {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
        ],
        "provides": [
          {
            "key": "ready",
            "type": "era.communication.api_inspect_submission.ready",
            "display_name": "已完成全部酒馆操作的业务进度"
          }
        ],
        "loop": {
          "body": "era.communication.api_inspect_submission.step",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.communication.api_inspect_submission.state",
              "as": "state",
              "update": "next_state"
            },
            {"from":"era.workflow.host_resources","as":"host_resources","update":"retained_host_resources"}
          ],
          "outputs": [
            {
              "from": "next_state",
              "as": "ready"
            }
          ]
        }
      },
      {
        "id": "skip",
        "display_name": "本段无需调用酒馆，直接继续",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：当前业务分支没有实际酒馆操作，保留本地处理结果，不发出空调用。",
        "definition_id": "era.communication.api_inspect_submission.skip"
      },
      {
        "id": "finish",
        "display_name": "交出本段原合同的结果",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：业务所需操作均已完成，按原合同交出数据、诊断及结果；资源令牌和通信信封不成为公共业务输出。",
        "definition_id": "era.communication.api_inspect_submission.finish"
      },
      {
        "id": "end",
        "definition_id": "era.service.terminal",
        "display_name": "完成本段酒馆操作",
        "description": "本步骤用于“识别提交的是操作清单还是编辑草稿”：标明该段业务操作的范围；跨工作流调用在中间明确显示。"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"prepare","schedule":true},
      {
        "from": "prepare",
        "to": "operation_loop",
        "when": "needs_operation == 'call'"
      },
      {
        "from": "prepare",
        "to": "skip",
        "when": "needs_operation == 'done'"
      },
      [
        "operation_loop",
        "finish"
      ],
      [
        "skip",
        "finish"
      ],
      [
        "finish",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"prepare","schedule":true},
      {"from":"retain_host_resources","to":"operation_loop","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已识别内容和消息范围的提交请求",
        "as": "commit_inspected"
      },
      {
        "type": "era.workbench.request_kind",
        "cardinality": "exactly_one",
        "display_name": "提交内容属于操作清单还是编辑草稿",
        "as": "workbench_request_kind"
      }
    ]
  }
}
