{
  "type_key": "era.api.commit",
  "display_name": "应用脚本或界面的变量提交",
  "description": "处理公共接口提交的变量和函数操作。先检查聊天目标与允许执行的范围，工作台草稿先转成有序操作；有效请求转成消息事务，由共享消息流程在内存应用。已经处理过的范围返回跳过，输入无效返回失败；应用回执之后由相应任务安排保存。",
  "requires": [
    {
      "type": "era.api.request.selected",
      "cardinality": "exactly_one",
      "display_name": "公共对象请求"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次状态"
    }
  ],
  "provides": [
    {
      "key": "commit_result",
      "type": "era.api.facade.result",
      "display_name": "提交结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "facade_request",
        "type": "era.api.request.selected",
        "required": true,
        "display_name": "公共对象请求"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "required": true,
        "display_name": "当前批次状态"
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "即时 变量提交 开始",
        "description": "开始应用脚本或界面的变量提交。"
      },
      {
        "id": "inspect_submission",
        "type_used": "era.api.inspect_submission",
        "display_name": "读取提交范围，识别操作或工作台草稿",
        "description": "读取当前聊天允许处理的消息范围，识别提交的是有序变量操作还是工作台编辑草稿。草稿先转成有序操作，再进行提交检查。"
      },
      {
        "id": "prepare_workbench_commit",
        "type_used": "era.api.prepare_workbench_commit",
        "display_name": "把编辑草稿转换为提交操作",
        "description": "本次处理脚本或界面发起的变量提交。把变量或函数工作台的编辑草稿转成公共接口可执行的操作。读取当前数据，检查草稿是否仍对应原聊天和原值，计算差异，再按用户的选择处理保护规则。输出有序提交请求或要求重新加载、补充选择的失败原因。"
      },
      {
        "id": "validate_scope_and_operations",
        "type_used": "era.api.validate_commit",
        "display_name": "校验 允许执行范围 与有序操作",
        "description": "本次处理脚本或界面发起的变量提交。检查有序操作和请求来源，再判断本次提交是否允许执行。消息范围内的重复调用可执行，后续范围已处理的调用可跳过；回复分支按该分支的执行记录判断，强制执行请求每次执行，过期范围返回失败。"
      },
      {
        "id": "prepare_application",
        "type_used": "era.api.prepare_application",
        "display_name": "定位目标消息，准备本次提交",
        "description": "把已确认的有序操作组成消息事务，读取真实目标消息，并建立共享消息处理的初始状态，随后按顺序应用操作。"
      },
      {
        "id": "apply_api_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "依次应用本次接口提交的命令",
        "description": "按目标消息位置执行本次接口提交及相关历史处理，逐段更新内存中的变量、函数、正文和日志。处理结束后返回实际应用结果；作者函数提交随所属批次保存，外部提交按合并保存窗口安排写入。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "开始处理的消息范围、变量、函数和日志"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "处理后的消息位置、变量、函数和日志"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "return_immediate_result",
        "type_used": "era.api.return_immediate_result",
        "display_name": "返回跳过或输入失败的提交结果",
        "description": "对已处理过的提交范围形成跳过回执，对无效操作或工作台草稿形成失败回执，保留具体原因并返回原接口格式。"
      },
      {
        "id": "return_applied_result",
        "type_used": "era.api.return_application_result",
        "display_name": "返回消息操作的内存应用回执",
        "description": "整理共享消息处理完成后的变量、函数、日志和诊断，形成接口提交回执。调用方根据该回执继续安排保存和显示更新。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "即时 变量提交 结束",
        "description": "结束应用脚本或界面的变量提交，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_submission"
      ],
      {
        "from": "inspect_submission",
        "to": "validate_scope_and_operations",
        "when": "workbench_request_kind == 'operations'"
      },
      {
        "from": "inspect_submission",
        "to": "prepare_workbench_commit",
        "when": "workbench_request_kind == 'draft'"
      },
      {
        "from": "prepare_workbench_commit",
        "to": "validate_scope_and_operations",
        "when": "preparation_route == 'ready'"
      },
      {
        "from": "prepare_workbench_commit",
        "to": "return_immediate_result",
        "when": "preparation_route == 'failed'"
      },
      {
        "from": "validate_scope_and_operations",
        "to": "prepare_application",
        "when": "commit_admission_route == 'commit'"
      },
      {
        "from": "validate_scope_and_operations",
        "to": "return_immediate_result",
        "when": "commit_admission_route != 'commit'"
      },
      [
        "prepare_application",
        "apply_api_blocks"
      ],
      [
        "apply_api_blocks",
        "return_applied_result"
      ],
      [
        "return_applied_result",
        "end"
      ],
      [
        "return_immediate_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.api.facade.result",
        "cardinality": "exactly_one",
        "as": "commitResult",
        "display_name": "变量提交结果"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "prepare_workbench_commit.jsonc"
    }
  ]
}
