{
  "type_key": "era.api.commit",
  "display_name": "应用脚本或界面提交的变量操作",
  "description": "接收变量或函数提交，检查目标聊天和允许范围，工作台草稿先比较成有序操作。有效请求在统一消息流程中按序计算；重复范围按规则跳过，无效内容返回原因，之后由任务流程安排保存。",
  "requires": [
    {
      "type": "era.api.request.selected",
      "cardinality": "exactly_one",
      "display_name": "已经选中的接口请求"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "commit_result",
      "type": "era.api.facade.result",
      "display_name": "变量接口的实际处理确认"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "facade_request",
        "type": "era.api.request.selected",
        "required": true,
        "display_name": "已经选中的接口请求"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "required": true,
        "display_name": "当前批次的任务进度与累计结果"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 37,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始应用脚本或界面提交的变量操作",
        "description": "标明“应用脚本或界面提交的变量操作”的开始位置。接收变量或函数提交，检查目标聊天和允许范围，工作台草稿先比较成有序操作。有效请求在统一消息流程中按序计算；重复范围按规则跳过，无效内容返回原因，之后由任务流程安排保存。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "inspect_submission",
        "display_name": "识别提交的是操作清单还是编辑草稿",
        "description": "在“应用脚本或界面提交的变量操作”流程中，读取本次允许处理的聊天消息范围，查看提交内容是明确的有序操作，还是变量、函数工作台的编辑草稿。草稿先转成可执行操作，之后再统一检查能否提交。",
        "definition_id": "era.communication.api_inspect_submission"
      },
      {
        "id": "prepare_workbench_commit",
        "display_name": "把工作台草稿转换成安全的提交清单",
        "description": "本环节用于“应用脚本或界面提交的变量操作”：接收变量或函数编辑草稿，读取当前数据，确认它仍对应原聊天和编辑前的值，比较差异并处理用户的保护选择。输出有序操作，或说明需要重载、修改输入或重新选择的原因。",
        "definition_id": "era.api.prepare_workbench_commit"
      },
      {
        "id": "validate_scope_and_operations",
        "display_name": "判断这次变量提交是否允许执行",
        "description": "在“应用脚本或界面提交的变量操作”流程中，检查脚本或界面提交的操作顺序、来源和有效消息范围。按提交模式决定执行、跳过已处理内容或拒绝过期请求，并保留原因；回复分支的执行记录单独判断，供后续安全应用变量变更。",
        "definition_id": "era.api.validate_commit"
      },
      {
        "id": "prepare_application",
        "display_name": "绑定候选并准备内存变量提交",
        "description": "给提交绑定当前聊天、消息、候选索引和原生生成周期；按原顺序在现有WorkingState应用操作，保留待保存记录，尚未创建的候选不调用消息写入。源：nodes/api/facade_nodes.ts。",
        "definition_id": "era.communication.api_prepare_application"
      },
      {
        "id": "apply_api_blocks",
        "display_name": "按消息位置应用本次接口提交",
        "description": "接收已通过检查的脚本或界面提交，在目标消息位置逐段执行变量和函数操作，整理内存状态及历史。结束后返回实际应用结论，作者提交随所属批次保存，外部提交按现有合并时机安排写入。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "当前消息位置及待处理变量指令"
          },
          {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "本段正文处理后的变量和消息进度"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            },
            {"from":"era.workflow.host_resources","as":"host_resources","update":"retained_host_resources"}
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "return_immediate_result",
        "display_name": "返回跳过提交或输入无效的原因",
        "description": "在“应用脚本或界面提交的变量操作”流程中，对按规则无需再次处理的提交返回跳过说明，对无效操作或不再适用的工作台草稿返回失败原因。结果保持原接口需要的形式，让脚本或界面知道为何没有继续执行。",
        "definition_id": "era.api.return_immediate_result"
      },
      {
        "id": "return_applied_result",
        "display_name": "确认稳定楼层正文并返回应用回执",
        "description": "向已有稳定楼层外部提交时，确认酒馆当前正文已包含事务，再发布完整变量结果并交回执。正文落盘和独立状态文件仍由合并保存处理。未完成原生候选随所属生成周期结算。源：nodes/api/facade_nodes.ts。",
        "definition_id": "era.communication.api_return_application_result"
      },
      {
        "id": "end",
        "display_name": "结束应用脚本或界面提交的变量操作",
        "description": "标明“应用脚本或界面提交的变量操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}, {"id":"retain_host_resources_signal","definition_id":"era.service.forward_resource_signal","display_name":"转交本段的资源就绪确认","description":"把资源已转交的确认交给下一步。下一步继续使用入口收到的同一资源，不重复接收资源句柄。"}
    ],
    "edges": [
      {"from":"start","to":"inspect_submission","schedule":true},
      {
        "from": "inspect_submission",
        "to": "validate_scope_and_operations",
        "when": "workbench_request_kind == 'operations'"
      },
      {
        "from": "inspect_submission",
        "to": "prepare_workbench_commit",
        "when": "workbench_request_kind == 'draft'"
      },
      {
        "from": "prepare_workbench_commit",
        "to": "validate_scope_and_operations",
        "when": "preparation_route == 'ready'"
      },
      {
        "from": "prepare_workbench_commit",
        "to": "return_immediate_result",
        "when": "preparation_route == 'failed'"
      },
      {
        "from": "validate_scope_and_operations",
        "to": "prepare_application",
        "when": "commit_admission_route == 'commit'"
      },
      {
        "from": "validate_scope_and_operations",
        "to": "return_immediate_result",
        "when": "commit_admission_route != 'commit'"
      },
      [
        "prepare_application",
        "apply_api_blocks"
      ],
      [
        "apply_api_blocks",
        "return_applied_result"
      ],
      [
        "return_applied_result",
        "end"
      ],
      [
        "return_immediate_result",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources_signal","to":"inspect_submission","schedule":true},
      {"from":"retain_host_resources","to":"prepare_workbench_commit","schedule":false},
      {"from":"retain_host_resources","to":"prepare_application","schedule":false},
      {"from":"retain_host_resources","to":"apply_api_blocks","schedule":false},
      {"from":"retain_host_resources","to":"return_applied_result","schedule":false}, {"from":"retain_host_resources","to":"retain_host_resources_signal","schedule":true}
    ],
    "outputs": [
      {
        "type": "era.api.facade.result",
        "cardinality": "exactly_one",
        "as": "commitResult",
        "display_name": "变量接口的实际处理确认"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "prepare_workbench_commit.jsonc"
    }
  ]
}
