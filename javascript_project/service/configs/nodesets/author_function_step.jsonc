{
  "type_key": "era.sync.author_function_step",
  "display_name": "在消息当前位置启动或接续作者函数",
  "description": "接收正文中的作者自定义 JavaScript 函数，检查后启动，等待它提出变量操作或结束。提交的操作在原正文位置应用后回告函数；完成、失败或范围结束时整理调用记录并释放资料。",
  "requires": [
    {
      "type": "era.sync.position.state",
      "cardinality": "exactly_one",
      "display_name": "正文当前位置、变量和待保存内容"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "position_state",
      "type": "era.sync.position.state",
      "display_name": "正文当前位置、变量和待保存内容"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.sync.position.state",
        "display_name": "正文当前位置、变量和待保存内容",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 36,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始在消息当前位置启动或接续作者函数",
        "description": "标明“在消息当前位置启动或接续作者函数”的开始位置。接收正文中的作者自定义 JavaScript 函数，检查后启动，等待它提出变量操作或结束。提交的操作在原正文位置应用后回告函数；完成、失败或范围结束时整理调用记录并释放资料。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "route_author_lifecycle",
        "display_name": "决定启动、接续还是结束作者函数",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，检查消息内作者自定义 JavaScript 函数的运行进度。首次遇到时启动，运行中时确认已应用提交并等待下一请求，消息结束或失败时收尾；输出本轮应完成的动作。",
        "definition_id": "era.sync.route_author_lifecycle"
      },
      {
        "id": "begin_call",
        "display_name": "检查并启动消息中的作者函数",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，读取正文中声明的作者自定义 JavaScript 函数及参数，检查后启动这次调用。无效调用或启动失败会记下原因并交回消息处理；有效函数可以继续提出变量提交或结束请求。",
        "definition_id": "era.communication.sync_begin_author_call"
      },
      {
        "id": "receive_event",
        "display_name": "确认上次提交并等待作者函数下一步",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，把上次已经应用的变量操作结果回告正在运行的作者函数，然后等待它继续提交、要求同步或结束。收到后选择对应动作；等待或回告失败时带回具体原因。",
        "definition_id": "era.communication.sync_receive_author_event"
      },
      {
        "id": "prepare_commit",
        "display_name": "把作者函数提交的操作接到当前位置",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，检查运行中的作者函数要求提交的变量操作，有效内容插入它所在的消息位置，交给统一指令流程按顺序计算。可立即答复的请求直接回告，其他结果在应用完成后确认。",
        "definition_id": "era.communication.sync_prepare_author_commit"
      },
      {
        "id": "answer_sync",
        "display_name": "回告运行中作者函数的历史同步请求",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，作者函数正在一条消息内部执行时，按现有接口规则拒绝它提出的历史同步要求，并返回具体说明，让函数继续完成当前调用。回告本身失败时记录错误，供消息流程处理。",
        "definition_id": "era.communication.sync_answer_author_sync"
      },
      {
        "id": "finish_call",
        "display_name": "结束作者函数并整理正文记录",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，作者函数完成、失败或当前消息范围结束时，整理调用结果并更新正文中的调用标记，释放本次运行资料。将最终进度交回消息流程，供继续处理后面的正文。",
        "definition_id": "era.communication.sync_finish_author_call"
      },
      {
        "id": "complete_author_step",
        "display_name": "把作者函数当前进度交回消息处理",
        "description": "在“在消息当前位置启动或接续作者函数”流程中，接收一次函数启动、请求确认、等待或清理的结果，交出函数在正文中的位置、当前进度和待处理提交。消息流程据此应用函数要求的操作，或继续等待它结束。",
        "definition_id": "era.sync.complete_author_step"
      },
      {
        "id": "end",
        "display_name": "结束在消息当前位置启动或接续作者函数",
        "description": "标明“在消息当前位置启动或接续作者函数”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"route_author_lifecycle","schedule":true},
      {
        "from": "route_author_lifecycle",
        "to": "finish_call",
        "when": "route_author_lifecycle_author_lifecycle_route == 'terminal'"
      },
      {
        "from": "route_author_lifecycle",
        "to": "begin_call",
        "when": "route_author_lifecycle_author_lifecycle_route == 'start'"
      },
      {
        "from": "route_author_lifecycle",
        "to": "receive_event",
        "when": "route_author_lifecycle_author_lifecycle_route == 'wait'"
      },
      [
        "begin_call",
        "complete_author_step"
      ],
      {
        "from": "receive_event",
        "to": "prepare_commit",
        "when": "author_event == 'commit'"
      },
      {
        "from": "receive_event",
        "to": "answer_sync",
        "when": "author_event == 'unsupported'"
      },
      {
        "from": "receive_event",
        "to": "finish_call",
        "when": "author_event == 'done'"
      },
      {
        "from": "receive_event",
        "to": "finish_call",
        "when": "author_event == 'failed'"
      },
      {
        "from": "receive_event",
        "to": "complete_author_step",
        "when": "author_event == 'complete'"
      },
      [
        "prepare_commit",
        "complete_author_step"
      ],
      [
        "answer_sync",
        "complete_author_step"
      ],
      [
        "finish_call",
        "complete_author_step"
      ],
      [
        "complete_author_step",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"route_author_lifecycle","schedule":true},
      {"from":"retain_host_resources","to":"finish_call","schedule":false},
      {"from":"retain_host_resources","to":"begin_call","schedule":false},
      {"from":"retain_host_resources","to":"receive_event","schedule":false},
      {"from":"retain_host_resources","to":"prepare_commit","schedule":false},
      {"from":"retain_host_resources","to":"answer_sync","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "正文当前位置、变量和待保存内容",
        "as": "position_state"
      }
    ]
  }
}
