{
  "type_key": "era.sync.author_function_step",
  "display_name": "启动或接续正文中的作者函数",
  "description": "推进正文中的作者函数调用：先检查并启动函数，随后等待它提出变量提交或结束请求；提交的指令回到当前正文位置执行，执行完成后再回告函数。函数结束或处理范围结束时整理结果并释放调用资料。",
  "requires": [
    {
      "type": "era.sync.position.state",
      "cardinality": "exactly_one",
      "display_name": "作者调用的正文位置、运行进度和所属任务结果"
    }
  ],
  "provides": [
    {
      "key": "position_state",
      "type": "era.sync.position.state",
      "display_name": "作者调用本次处理后的消息位置"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.sync.position.state",
        "display_name": "作者调用的正文位置、运行进度和所属任务结果",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "作者函数步进开始",
        "description": "开始启动或接续正文中的作者函数。"
      },
      {
        "id": "route_author_lifecycle",
        "type_used": "era.sync.route_author_lifecycle",
        "display_name": "选择作者函数的启动、等待或收尾",
        "description": "本次接续正文中的作者 JavaScript 函数调用。检查正文中的作者 JavaScript 函数运行进度。消息任务已结束或失败时释放函数；调用刚建立时启动它；运行中则确认已应用的提交并等待下一条请求或结束消息。输出本次应执行的函数动作。"
      },
      {
        "id": "begin_call",
        "type_used": "era.sync.begin_author_call",
        "display_name": "检查并启动作者定义的函数",
        "description": "检查正文指定的作者函数和参数，登记本次调用并启动函数。调用无效时整理结束结果；启动遇到宿主错误时记录具体原因，交回消息处理。"
      },
      {
        "id": "receive_event",
        "type_used": "era.sync.receive_author_event",
        "display_name": "确认上次提交，等待函数下一步请求",
        "description": "把上次已经应用的变量提交结果回告作者函数，然后等待函数的下一步事件。收到提交、结束或同步请求时选择对应处理；等待或回告失败时记录宿主错误。"
      },
      {
        "id": "prepare_commit",
        "type_used": "era.sync.prepare_author_commit",
        "display_name": "把作者函数提交的指令接入当前消息",
        "description": "检查作者函数提出的提交请求，将有效指令插入当前正文位置，交给消息循环按顺序应用；可立即返回的请求就地回告函数，并保留具体处理结果。"
      },
      {
        "id": "answer_sync",
        "type_used": "era.sync.answer_author_sync",
        "display_name": "回告作者函数提出的同步请求",
        "description": "收到运行中的作者函数提出的历史同步请求时，按现有接口规则返回具体拒绝结果，让函数继续完成当前调用；回告失败时记录宿主错误。"
      },
      {
        "id": "finish_call",
        "type_used": "era.sync.finish_author_call",
        "display_name": "结束作者调用并释放运行资料",
        "description": "在作者函数正常结束、调用失败或消息处理范围结束时，整理调用结果，更新正文调用标记，释放函数运行资料，再把最终进度交回消息循环。"
      },
      {
        "id": "complete_author_step",
        "type_used": "era.sync.complete_author_step",
        "display_name": "返回作者函数处理后的消息进度",
        "description": "本次接续正文中的作者 JavaScript 函数调用。一次函数启动、请求确认、等待或错误清理完成后，将调用位置、函数运行进度和待应用请求交回消息循环。消息循环据此继续应用函数提交的操作，或等待后续事件。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "作者函数步进结束",
        "description": "结束启动或接续正文中的作者函数，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "route_author_lifecycle"
      ],
      {
        "from": "route_author_lifecycle",
        "to": "finish_call",
        "when": "route_author_lifecycle_author_lifecycle_route == 'terminal'"
      },
      {
        "from": "route_author_lifecycle",
        "to": "begin_call",
        "when": "route_author_lifecycle_author_lifecycle_route == 'start'"
      },
      {
        "from": "route_author_lifecycle",
        "to": "receive_event",
        "when": "route_author_lifecycle_author_lifecycle_route == 'wait'"
      },
      [
        "begin_call",
        "complete_author_step"
      ],
      {
        "from": "receive_event",
        "to": "prepare_commit",
        "when": "author_event == 'commit'"
      },
      {
        "from": "receive_event",
        "to": "answer_sync",
        "when": "author_event == 'unsupported'"
      },
      {
        "from": "receive_event",
        "to": "finish_call",
        "when": "author_finish == true"
      },
      {
        "from": "receive_event",
        "to": "complete_author_step",
        "when": "author_event == 'complete'"
      },
      [
        "prepare_commit",
        "complete_author_step"
      ],
      [
        "answer_sync",
        "complete_author_step"
      ],
      [
        "finish_call",
        "complete_author_step"
      ],
      [
        "complete_author_step",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "作者调用本次处理后的消息位置",
        "as": "position_state"
      }
    ]
  }
}
