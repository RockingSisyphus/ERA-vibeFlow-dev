{
  "nodeset_imports": [
    {
      "path": "task_update_mk.jsonc"
    },
    {
      "path": "agent_settings.jsonc"
    }
  ],
  "type_key": "era.service.step",
  "display_name": "处理标识、设置或忽略任务",
  "description": "执行已经准备好的三类简单任务：确认消息历史标识、处理多阶段生成设置，或为无需处理的事件返回忽略原因。选定分支返回一个任务结果，供批次统一合并。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已准备路由步骤"
    },
    {
      "type": "era.task.route.selected",
      "cardinality": "exactly_one",
      "display_name": "已准备任务路由"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "simple_task_result",
      "type": "era.task.result",
      "display_name": "简单任务结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已准备路由步骤",
        "required": true
      },
      {
        "key": "task_route",
        "type": "era.task.route.selected",
        "display_name": "已准备任务路由",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "步骤启动",
        "description": "开始处理标识、设置或忽略任务。"
      },
      {
        "id": "route_simple_task",
        "type_used": "era.tasks.dispatch",
        "display_name": "选择标识、设置或忽略任务",
        "description": "本次处理标识、设置或忽略事件的简单任务。按简单任务类型选择消息历史标识结算、生成设置操作或忽略事件处理。"
      },
      {
        "id": "task_update_mk",
        "type_used": "era.task.update_mk",
        "display_name": "结算消息历史标识更新",
        "description": "本次处理标识、设置或忽略事件的简单任务。结算消息历史标识准备的结果。历史标识用于把每条聊天消息与变量变更日志对应起来；读取、生成和必要写入已在任务资料准备时完成。本流程检查该结果，再向任务的原始事件返回无变化、成功或失败回执。"
      },
      {
        "id": "task_agent_settings",
        "type_used": "era.agent.settings",
        "display_name": "管理生成配置、预设和连接",
        "description": "本次处理标识、设置或忽略事件的简单任务。处理多阶段生成的配置、预设、连接和模型列表操作。按命令读取必要的当前设置，通过浏览器接口执行相应操作，再将实际结果对应到原始请求。此流程负责设置管理，生成阶段在其他任务中执行。"
      },
      {
        "id": "task_ignore",
        "type_used": "era.task.ignore",
        "display_name": "结算忽略步骤",
        "description": "本次处理标识、设置或忽略事件的简单任务。为计划中决定忽略的每个原事件返回忽略回执，说明原因。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "步骤结束",
        "description": "结束处理标识、设置或忽略任务，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "route_simple_task"
      ],
      {
        "from": "route_simple_task",
        "to": "task_update_mk",
        "when": "simple_task_route == 'update-mk'"
      },
      [
        "task_update_mk",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_agent_settings",
        "when": "simple_task_route == 'agent-settings'"
      },
      [
        "task_agent_settings",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_ignore",
        "when": "simple_task_route == 'ignore'"
      },
      [
        "task_ignore",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "简单任务结果",
        "as": "simpleTaskResult"
      }
    ]
  }
}
