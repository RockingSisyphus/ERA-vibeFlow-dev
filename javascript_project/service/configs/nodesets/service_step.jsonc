{
  "nodeset_imports": [
    {
      "path": "task_update_mk.jsonc"
    },
    {
      "path": "agent_settings.jsonc"
    }
  ],
  "type_key": "era.service.step",
  "display_name": "完成消息标识、生成设置或忽略任务",
  "description": "接收已准备的简单任务，按种类确认消息历史标识、管理生成设置，或回告无需处理的原因。选中分支返回一个真实任务结果，交给批次统一汇总。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "type": "era.task.route.selected",
      "cardinality": "exactly_one",
      "display_name": "已选中的简单任务处理种类"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    }
  ],
  "provides": [
    {
      "key": "simple_task_result",
      "type": "era.task.result",
      "display_name": "本项任务对应原事件的处理结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "当前任务及已读取的聊天资料",
        "required": true
      },
      {
        "key": "task_route",
        "type": "era.task.route.selected",
        "display_name": "已选中的简单任务处理种类",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成消息标识、生成设置或忽略任务",
        "description": "标明“完成消息标识、生成设置或忽略任务”的开始位置。接收已准备的简单任务，按种类确认消息历史标识、管理生成设置，或回告无需处理的原因。选中分支返回一个真实任务结果，交给批次统一汇总。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "route_simple_task",
        "display_name": "选择标识、设置或忽略任务的处理方式",
        "description": "在“完成消息标识、生成设置或忽略任务”流程中，接收已准备的简单任务，按种类交给消息标识确认、生成设置管理或忽略事件处理。选定分支产生一个任务结果，供批次汇总。",
        "definition_id": "era.tasks.dispatch"
      },
      {
        "id": "task_update_mk",
        "display_name": "确认消息历史身份准备的结果",
        "description": "本环节用于“完成消息标识、生成设置或忽略任务”：消息身份标识把聊天消息与变量变更记录对应起来，本流程接收任务准备阶段已有的标识、占位及写入结论。检查后向原事件返回成功、无变化或失败确认，供批次汇总。",
        "definition_id": "era.task.update_mk"
      },
      {
        "id": "task_agent_settings",
        "display_name": "读取和管理多阶段生成设置",
        "description": "本环节用于“完成消息标识、生成设置或忽略任务”：接收用户对生成配置、预设、连接或模型列表的操作，准备必要资料，通过酒馆执行，再向原发起者返回真实结果。模型生成本身由生成流程处理。",
        "definition_id": "era.agent.settings"
      },
      {
        "id": "task_ignore",
        "display_name": "向被忽略事件返回原因",
        "description": "在“完成消息标识、生成设置或忽略任务”流程中，接收计划中无需实际处理的事件，为每个原事件返回忽略确认及原因。调用方因此仍能知道请求已被看见，而不会一直等待结果。",
        "definition_id": "era.task.ignore"
      },
      {
        "id": "end",
        "display_name": "结束完成消息标识、生成设置或忽略任务",
        "description": "标明“完成消息标识、生成设置或忽略任务”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "route_simple_task"
      ],
      {
        "from": "route_simple_task",
        "to": "task_update_mk",
        "when": "simple_task_route == 'update-mk'"
      },
      [
        "task_update_mk",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_agent_settings",
        "when": "simple_task_route == 'agent-settings'"
      },
      [
        "task_agent_settings",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_ignore",
        "when": "simple_task_route == 'ignore'"
      },
      [
        "task_ignore",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "本项任务对应原事件的处理结果",
        "as": "simpleTaskResult"
      }
    ]
  }
}
