{
  "nodeset_imports": [
    {
      "path": "task_sync.jsonc"
    },
    {
      "path": "task_update_mk.jsonc"
    },
    {
      "path": "agent_settings.jsonc"
    }
  ],
  "type_key": "era.service.step",
  "display_name": "ERA 简单任务步骤",
  "description": "仅执行已完成统一准备的普通同步、MK 更新、Agent 设置或 ignore；复杂任务由服务迭代直接调用。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已准备路由步骤"
    },
    {
      "type": "era.task.route",
      "cardinality": "exactly_one",
      "display_name": "已准备任务路由"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "simple_task_result",
      "type": "era.task.result",
      "display_name": "简单任务结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已准备路由步骤",
        "required": true
      },
      {
        "key": "task_route",
        "type": "era.task.route",
        "display_name": "已准备任务路由",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "步骤启动",
        "description": "接收一个已经完成上下文准备的简单任务。"
      },
      {
        "id": "route_simple_task",
        "type_used": "era.tasks.dispatch",
        "display_name": "选择已准备的简单任务",
        "description": "只接收已准备好的普通同步、消息密钥、Agent 设置或忽略步骤，并将步骤与批次状态交给对应分支。"
      },
      {
        "id": "task_sync",
        "type_used": "era.task.sync",
        "display_name": "执行同步任务",
        "description": "执行共享同步事务，覆盖普通协调、完整重算、最新修复、自动修复、定向回滚和 API 因果写入。"
      },
      {
        "id": "task_update_mk",
        "type_used": "era.task.update_mk",
        "display_name": "更新消息密钥任务",
        "description": "接收派发准备阶段已确认的消息密钥和占位符写入结果，只构造任务回执，不重复写消息。"
      },
      {
        "id": "task_agent_settings",
        "type_used": "era.agent.settings",
        "display_name": "执行 Agent 设置命令",
        "description": "配置、预设、连接与模型列表在同一 Service FIFO 内独立处理，不进入生成阶段。"
      },
      {
        "id": "task_ignore",
        "type_used": "era.task.ignore",
        "display_name": "结算忽略步骤",
        "description": "使用规划器保留的原始 ignore 原因逐一结算来源，不伪装成同步或其他领域任务。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "步骤结束",
        "description": "交还唯一任务结果，由外层统一合并并推进批次索引。"
      }
    ],
    "edges": [
      [
        "start",
        "route_simple_task"
      ],
      {
        "from": "route_simple_task",
        "to": "task_sync",
        "when": "simple_task_route == 'sync'"
      },
      [
        "task_sync",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_update_mk",
        "when": "simple_task_route == 'update-mk'"
      },
      [
        "task_update_mk",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_agent_settings",
        "when": "simple_task_route == 'agent-settings'"
      },
      [
        "task_agent_settings",
        "end"
      ],
      {
        "from": "route_simple_task",
        "to": "task_ignore",
        "when": "simple_task_route == 'ignore'"
      },
      [
        "task_ignore",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "简单任务结果",
        "as": "simpleTaskResult"
      }
    ]
  }
}
