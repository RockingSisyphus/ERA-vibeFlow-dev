{
  "nodeset_imports": [
    {
      "path": "service_collect_cycle_phase.jsonc"
    },
    {
      "path": "dispatch_prepare_context.jsonc"
    },
    {
      "path": "task_initialize.jsonc"
    },
    {
      "path": "task_api.jsonc"
    },
    {
      "path": "agent_generation_session.jsonc"
    },
    {
      "path": "service_step.jsonc"
    },
    {
      "path": "service_settle_step_phase.jsonc"
    }
  ],
  "type_key": "era.service.iteration",
  "display_name": "ERA 服务阶段迭代",
  "description": "长期 Service 循环的一轮，只处理一种阶段：收集时接收一个事件并等待或形成批次；执行时取出一个计划步骤，统一准备其聊天上下文，调用初始化、API、生成会话或简单任务，再合并结果。最后一步完成时当轮发布整批结果，其他情况携带进度继续，不在执行批次中途插入新事件。",
  "requires": [
    {
      "type": "era.service.cycle.state",
      "cardinality": "exactly_one",
      "display_name": "当前阶段状态"
    }
  ],
  "provides": [
    {
      "key": "cycle_state_next",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "当前阶段状态",
        "required": true
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代开始",
        "description": "这是“ERA 服务阶段迭代”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "route_phase",
        "type_used": "era.service.cycle.route",
        "display_name": "选择当前阶段",
        "description": "读取当前循环状态的阶段标签，决定本轮是继续接收事件，还是执行已规划批次中的一个步骤。阶段载体格式无效时直接报错；正常情况下原状态原样传递。这样在执行批次期间不会误走收集分支，使任务顺序保持可预测。"
      },
      {
        "id": "collect_cycle_phase",
        "type_used": "era.service.collect_cycle_phase",
        "display_name": "收集、等待或规划批次",
        "description": "完成收集阶段的一轮：接收并验证一个事件，更新待处理集合，发送定时器控制；条件未满足则继续收集，批次就绪则规划任务并核对来源覆盖。计划不合法时立即为全部来源发布失败，否则切换执行阶段。这里不提前跑有效批次中的具体任务。"
      },
      {
        "id": "unpack_execution",
        "type_used": "era.service.cycle.unpack_execution",
        "display_name": "验证在途批次状态",
        "description": "确认循环处于执行阶段，再取出任务列表、当前步骤索引、累计结果和服务进度，交给单步执行流程。它不移动索引，也不修改计划；阶段标签或载体损坏时会报错，避免使用错误批次。"
      },
      {
        "id": "prepare_dispatch_context",
        "type_used": "era.dispatch.prepare_context",
        "display_name": "选择步骤并准备派发上下文",
        "description": "为批次中的一个任务统一准备执行依据：先按索引取出步骤，判断是否需要聊天事实，再读取真实消息、候选回复和身份，规划消息标识及占位符，最后确定任务分支。普通同步只暂存消息变更，纯标识任务才可能提前提交。输出已准备任务供后续直接执行；失败保留到任务回执，避免各任务各自读出不一致的目标。"
      },
      {
        "id": "task_initialize",
        "type_used": "era.task.initialize",
        "display_name": "执行初始化任务",
        "description": "读取现有角色和聊天资源，按传统或外置模式规划并应用必要的 ERA 设置、世界书、正则及主开场白，遵守作者资源不覆盖条件。普通资源操作直接返回结果；启动初始化成功或无需变更时，再进入共享历史同步，使变量状态与当前消息一致。整个任务保留原来源，不另建初始化变量引擎。"
      },
      {
        "id": "task_api",
        "type_used": "era.task.api",
        "display_name": "执行 ERA 公共对象任务",
        "description": "处理公共 ERA 对象的两种写入类请求：commit 将有序操作应用到当前内存工作状态并返回回执，sync 则把校验后的请求交给共享历史同步和保存。输入不合法时返回明确失败，各分支保持原调用来源。读取和订阅不作为此任务执行；结果统一交还批次结算。"
      },
      {
        "id": "adapt_api_task_result",
        "type_used": "era.service.adapt_api_task_result",
        "display_name": "接回公共对象任务结果",
        "description": "把公共 API 任务专用的结果转交到 Service 的统一任务结果通道。结果中的成功、跳过、失败、来源和通知均保留原值，不重新计算。专用通道用于避免 API 内部同步结果与外层结果混用；真正推进批次索引由后续合并节点完成。"
      },
      {
        "id": "task_agent_generation_session",
        "type_used": "era.agent.generation_session",
        "display_name": "执行三阶段故事生成会话",
        "description": "在有序 Service 任务中处理 Agent 的规划、正文及结算阶段：识别事件和来源，恢复必要基线，请求并应用模型候选，遇到可纠错失败按整次候选恢复后重试。阶段成功后通过完成标识与页面回调交接，再由新的恢复事件继续；需最终消息同步的结果走共用链，取消或失效来源如实结算，不重复应用候选内 API。"
      },
      {
        "id": "execute_simple_task",
        "type_used": "era.service.step",
        "display_name": "执行已准备的简单任务",
        "description": "执行已经准备好上下文的简单任务：历史同步走共用同步链，消息标识任务只结算已准备结果，Agent 设置处理配置与连接，忽略任务解释不执行的原因。初始化、公共 API 和生成会话由外层单独调用。各分支交还唯一任务结果，索引推进和批次发布仍由统一结算负责。"
      },
      {
        "id": "settle_step",
        "type_used": "era.service.settle_step_phase",
        "display_name": "合并任务结果并继续或完成批次",
        "description": "在一个任务结束后合并其回执、诊断和进度，推进批次索引。还有任务则继续执行原批次，全部结束则立即进入批次结算和发布，再恢复事件收集。该节点集只接续已产生的结果，不重做任务，也不因一条普通业务失败自动抛弃剩余计划。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代结束",
        "description": "这是“ERA 服务阶段迭代”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "route_phase"
      ],
      {
        "from": "route_phase",
        "to": "collect_cycle_phase",
        "when": "cycle_route == 'collect'"
      },
      {
        "from": "route_phase",
        "to": "unpack_execution",
        "when": "cycle_route == 'execute'"
      },
      [
        "collect_cycle_phase",
        "end"
      ],
      [
        "unpack_execution",
        "prepare_dispatch_context"
      ],
      {
        "from": "prepare_dispatch_context",
        "to": "task_initialize",
        "when": "task_family_route == 'initialize'"
      },
      {
        "from": "prepare_dispatch_context",
        "to": "task_api",
        "when": "task_family_route == 'api'"
      },
      {
        "from": "prepare_dispatch_context",
        "to": "task_agent_generation_session",
        "when": "task_family_route == 'agent-generation-session'"
      },
      {
        "from": "prepare_dispatch_context",
        "to": "execute_simple_task",
        "when": "task_family_route == 'simple'"
      },
      [
        "task_initialize",
        "settle_step"
      ],
      [
        "task_api",
        "adapt_api_task_result"
      ],
      [
        "adapt_api_task_result",
        "settle_step"
      ],
      [
        "task_agent_generation_session",
        "settle_step"
      ],
      [
        "execute_simple_task",
        "settle_step"
      ],
      {
        "from": "prepare_dispatch_context",
        "to": "settle_step",
        "schedule": false
      },
      [
        "settle_step",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
