{
  "type_key": "era.service.iteration",
  "display_name": "完成一轮事件收集或任务执行",
  "description": "服务处于收集阶段时，等待并整理事件；处于执行阶段时，准备并执行当前任务，按需完成生成后续处理。结果合入批次后继续下一项，批次结束则回到事件收集。",
  "requires": [
    {
      "type": "era.service.cycle.state",
      "cardinality": "exactly_one",
      "display_name": "服务当前处于收集还是执行及相应进度"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "cycle_state_next",
      "type": "era.service.cycle.state",
      "display_name": "服务当前处于收集还是执行及相应进度"
    },
    {"key":"retained_host_resources","type":"era.workflow.host_resources","display_name":"所属 ERA 实例的本地资源"}
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "服务当前处于收集还是执行及相应进度",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 36,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成一轮事件收集或任务执行",
        "description": "标明“完成一轮事件收集或任务执行”的开始位置。服务处于收集阶段时，等待并整理事件；处于执行阶段时，准备并执行当前任务，按需完成生成后续处理。结果合入批次后继续下一项，批次结束则回到事件收集。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "route_phase",
        "display_name": "选择收集事件或执行任务",
        "description": "在“完成一轮事件收集或任务执行”流程中，读取服务当前阶段，选择收集新事件或处理已规划任务。阶段资料无效时报告流程问题，防止把收集状态误当成可执行批次。",
        "definition_id": "era.service.cycle.route"
      },
      {
        "id": "collect_cycle_phase",
        "display_name": "收一轮事件并决定等待还是开始批次",
        "description": "本环节用于“完成一轮事件收集或任务执行”：接收并整理一个新事件，把计时安排送回页面，再检查本批是否就绪。就绪时规划有序任务并核对每个事件都有安排，通过则进入执行，计划有问题则统一回告失败。",
        "definition_id": "era.service.collect_cycle_phase"
      },
      {
        "id": "unpack_execution",
        "display_name": "取出本轮任务执行的进度",
        "description": "在“完成一轮事件收集或任务执行”流程中，从服务状态取出当前任务列表、执行位置、累计结果和消息处理进度。任务执行流程据此处理正确的一项，并延续已有成果。",
        "definition_id": "era.service.cycle.unpack_execution"
      },
      {
        "id": "prepare_task",
        "display_name": "为当前任务选路并备齐执行资料",
        "description": "本环节用于“完成一轮事件收集或任务执行”：接收批次当前任务，读取必要聊天资料，再按种类准备初始化、脚本提交、生成、历史同步或简单任务。交出明确执行请求，并保留原事件和处理确认所需资料。",
        "definition_id": "era.task.prepare"
      },
      {
        "id": "choose_action",
        "display_name": "按准备结果选择实际执行流程",
        "description": "在“完成一轮事件收集或任务执行”流程中，接收当前任务已准备的资料，选择变量提交、历史同步、模型生成、简单任务或直接返回。把对应请求和原任务一起交给选定分支，供完成后统一结算。",
        "definition_id": "era.task.select_action"
      },
      {
        "id": "execute_commit",
        "display_name": "应用脚本或界面提交的变量操作",
        "description": "本环节用于“完成一轮事件收集或任务执行”：接收变量或函数提交，检查目标聊天和允许范围，工作台草稿先比较成有序操作。有效请求在统一消息流程中按序计算；重复范围按规则跳过，无效内容返回原因，之后由任务流程安排保存。",
        "definition_id": "era.api.commit"
      },
      {
        "id": "candidate_loop",
        "display_name": "生成并检查，允许时恢复起点重试",
        "description": "对当前生成阶段请求文字并应用其中指令，再检查整体结论。可重试错误先恢复本次起点再尝试，较早阶段成果保留；成功、取消或无法再重试时结束，交给阶段交接。",
        "requires": [
          {
            "type": "era.agent.candidate.state.selected",
            "cardinality": "exactly_one",
            "display_name": "本次选中的模型请求和恢复起点"
          },
          {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
        ],
        "provides": [
          {
            "key": "candidate_outcome",
            "type": "era.agent.candidate.outcome",
            "display_name": "生成尝试结束后的完整结果"
          }
        ],
        "loop": {
          "body": "era.agent.candidate_attempt",
          "max_iterations": null,
          "stop_when": {
            "from": "candidate_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.agent.candidate.state.selected",
              "as": "candidate_state",
              "update": "candidate_state_after"
            },
            {"from":"era.workflow.host_resources","as":"host_resources","update":"retained_host_resources"}
          ],
          "outputs": [
            {
              "from": "candidate_outcome",
              "as": "candidate_outcome"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "finish_agent_phase",
        "display_name": "结束当前生成阶段并准备下一步",
        "description": "本环节用于“完成一轮事件收集或任务执行”：接收已经结束的生成尝试，整理阶段完成资料及后续恢复依据。需要保存或历史同步时交给相应流程，其他结果直接回告；页面执行订阅回调后可按这些资料继续下一阶段。",
        "definition_id": "era.agent.finish_phase"
      },
      {
        "id": "choose_followup",
        "display_name": "决定生成结束后还要处理什么",
        "description": "在“完成一轮事件收集或任务执行”流程中，接收模型阶段的结论，选择继续历史同步、确认消息标识或直接返回结果。保留原任务、批次及发起来源，让生成后续处理仍能正确回告。",
        "definition_id": "era.task.select_followup"
      },
      {
        "id": "execute_sync",
        "display_name": "按当前聊天历史恢复变量并保存",
        "description": "本环节用于“完成一轮事件收集或任务执行”：读取聊天消息及独立状态文件，找出历史变化处，撤回旧效果后按正文顺序执行变量指令和作者函数。整理可压缩历史，保存消息及状态文件，确认后刷新显示并返回真实结果。",
        "definition_id": "era.task.sync"
      },
      {
        "id": "execute_simple_task",
        "display_name": "完成消息标识、生成设置或忽略任务",
        "description": "本环节用于“完成一轮事件收集或任务执行”：接收已准备的简单任务，按种类确认消息历史标识、管理生成设置，或回告无需处理的原因。选中分支返回一个真实任务结果，交给批次统一汇总。",
        "definition_id": "era.service.step"
      },
      {
        "id": "execute_agent_mk",
        "display_name": "确认消息历史身份准备的结果",
        "description": "本环节用于“完成一轮事件收集或任务执行”：消息身份标识把聊天消息与变量变更记录对应起来，本流程接收任务准备阶段已有的标识、占位及写入结论。检查后向原事件返回成功、无变化或失败确认，供批次汇总。",
        "definition_id": "era.task.update_mk"
      },
      {
        "id": "complete_task",
        "display_name": "按原发起方式返回本项任务结果",
        "description": "在“完成一轮事件收集或任务执行”流程中，接收变量提交、历史同步、生成或简单任务的实际结论，按脚本接口或普通事件需要的形式整理处理确认。保留成功值与失败原因，再交给批次汇总。",
        "definition_id": "era.task.finish_result"
      },
      {
        "id": "settle_step",
        "display_name": "收下本项结果并判断批次是否结束",
        "description": "本环节用于“完成一轮事件收集或任务执行”：将刚完成任务的确认、通知和消息进度合入批次并推进位置。有剩余任务时继续执行，全部完成时汇总发回页面，再恢复事件收集。",
        "definition_id": "era.service.settle_step_phase"
      },
      {
        "id": "end",
        "display_name": "结束完成一轮事件收集或任务执行",
        "description": "标明“完成一轮事件收集或任务执行”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"route_phase","schedule":true},
      {
        "from": "route_phase",
        "to": "collect_cycle_phase",
        "when": "cycle_route == 'collect'"
      },
      {
        "from": "route_phase",
        "to": "unpack_execution",
        "when": "cycle_route == 'execute'"
      },
      [
        "collect_cycle_phase",
        "end"
      ],
      [
        "unpack_execution",
        "prepare_task"
      ],
      [
        "prepare_task",
        "choose_action"
      ],
      {
        "from": "choose_action",
        "to": "execute_commit",
        "when": "action_route == 'commit'"
      },
      {
        "from": "choose_action",
        "to": "candidate_loop",
        "when": "action_route == 'candidate'"
      },
      {
        "from": "choose_action",
        "to": "execute_sync",
        "when": "action_route == 'sync'"
      },
      {
        "from": "choose_action",
        "to": "execute_simple_task",
        "when": "action_route == 'simple'"
      },
      {
        "from": "choose_action",
        "to": "complete_task",
        "when": "action_route != 'candidate'",
        "schedule": false
      },
      [
        "candidate_loop",
        "finish_agent_phase"
      ],
      {
        "from": "choose_action",
        "to": "finish_agent_phase",
        "when": "action_route == 'candidate'",
        "schedule": false
      },
      [
        "finish_agent_phase",
        "choose_followup"
      ],
      {
        "from": "choose_followup",
        "to": "execute_sync",
        "when": "followup_route == 'sync'"
      },
      {
        "from": "choose_followup",
        "to": "execute_agent_mk",
        "when": "followup_route == 'update-mk'"
      },
      {
        "from": "choose_followup",
        "to": "complete_task",
        "when": "followup_route != ''",
        "schedule": false
      },
      [
        "execute_commit",
        "complete_task"
      ],
      [
        "execute_sync",
        "complete_task"
      ],
      [
        "execute_agent_mk",
        "complete_task"
      ],
      [
        "execute_simple_task",
        "complete_task"
      ],
      {
        "from": "choose_action",
        "to": "settle_step",
        "when": "action_route != ''",
        "schedule": false
      },
      [
        "complete_task",
        "settle_step"
      ],
      [
        "settle_step",
        "end"
      ],
      {
        "from": "choose_action",
        "to": "complete_task",
        "when": "action_route == 'direct'",
        "transfer": false
      },
      {
        "from": "choose_followup",
        "to": "complete_task",
        "when": "followup_route == 'direct'",
        "transfer": false
      },
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"route_phase","schedule":true},
      {"from":"retain_host_resources","to":"collect_cycle_phase","schedule":false},
      {"from":"retain_host_resources","to":"prepare_task","schedule":false},
      {"from":"retain_host_resources","to":"execute_commit","schedule":false},
      {"from":"retain_host_resources","to":"candidate_loop","schedule":false},
      {"from":"retain_host_resources","to":"execute_sync","schedule":false},
      {"from":"retain_host_resources","to":"execute_simple_task","schedule":false},
      {"from":"retain_host_resources","to":"settle_step","schedule":false},
      {"from":"retain_host_resources","to":"execute_agent_mk","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "服务当前处于收集还是执行及相应进度",
        "as": "cycleStateNext"
      },
      {"type":"era.workflow.host_resources","as":"retained_host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
    ]
  },
  "nodeset_imports": [
    {
      "path": "service_collect_cycle_phase.jsonc"
    },
    {
      "path": "agent_finish_phase.jsonc"
    },
    {
      "path": "agent_candidate_attempt.jsonc"
    },
    {
      "path": "api_commit.jsonc"
    },
    {
      "path": "task_sync.jsonc"
    },
    {
      "path": "service_step.jsonc"
    },
    {
      "path": "service_settle_step_phase.jsonc"
    },
    {
      "path": "task_prepare.jsonc"
    }
  ]
}
