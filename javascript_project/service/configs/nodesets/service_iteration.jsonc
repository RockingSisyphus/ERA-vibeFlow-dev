{
  "nodeset_imports": [
    {
      "path": "service_collect_phase.jsonc"
    },
    {
      "path": "service_prepare_batch_phase.jsonc"
    },
    {
      "path": "service_step.jsonc"
    },
    {
      "path": "service_settle_step_phase.jsonc"
    }
  ],
  "type_key": "era.service.iteration",
  "display_name": "ERA 服务阶段迭代",
  "description": "外层永久 Loop 的单轮 body。collect 阶段只收集/规划，execute 阶段只执行一个严格 PlannedStep；结算后才再次接收入站事件。",
  "requires": [
    {
      "type": "era.service.cycle.state",
      "cardinality": "exactly_one",
      "display_name": "当前阶段状态"
    }
  ],
  "provides": [
    {
      "key": "cycle_state_next",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "当前阶段状态",
        "required": true
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代开始",
        "description": "开始一个收集或单步执行阶段。"
      },
      {
        "id": "route_phase",
        "type_used": "era.service.cycle.route",
        "display_name": "选择当前阶段",
        "description": "只读取内部 collect/execute 标签，不读取事件，不改变领域状态。"
      },
      {
        "id": "collect_phase",
        "type_used": "era.service.collect_phase",
        "display_name": "接收并归约一个事件",
        "description": "只有 collect 阶段接收入站事件，校验、归约并发送事件集控制。"
      },
      {
        "id": "route_collection",
        "type_used": "era.service.route_iteration",
        "display_name": "选择等待或规划",
        "description": "读取归约结果的 wait/execute 路由，不改变事件集。"
      },
      {
        "id": "carry_wait",
        "type_used": "era.service.cycle.carry_wait",
        "display_name": "携带等待状态",
        "description": "把归约后的服务状态原样包装为下一轮 collect 阶段。"
      },
      {
        "id": "prepare_batch",
        "type_used": "era.service.prepare_batch_phase",
        "display_name": "规划并校验就绪批次",
        "description": "规划严格步骤与来源覆盖；无效覆盖立即结算发布，有效批次进入 execute 阶段。"
      },
      {
        "id": "unpack_execution",
        "type_used": "era.service.cycle.unpack_execution",
        "display_name": "验证在途批次状态",
        "description": "仅 execute 阶段解包；输出通过既有严格批次状态 Schema 校验。"
      },
      {
        "id": "execute_step",
        "type_used": "era.service.step",
        "display_name": "执行一个规划步骤",
        "description": "沿既有任务路由执行恰好一个步骤，并保留索引、结算与失败语义。"
      },
      {
        "id": "settle_step",
        "type_used": "era.service.settle_step_phase",
        "display_name": "继续或完成批次",
        "description": "未到最后一步时携带在途状态；最后一步当轮结算并发布后返回 collect。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代结束",
        "description": "输出唯一下一阶段状态供外层 Loop carry。"
      }
    ],
    "edges": [
      [
        "start",
        "route_phase"
      ],
      {
        "from": "route_phase",
        "to": "collect_phase",
        "when": "cycle_route == 'collect'"
      },
      {
        "from": "route_phase",
        "to": "unpack_execution",
        "when": "cycle_route == 'execute'"
      },
      [
        "collect_phase",
        "route_collection"
      ],
      {
        "from": "collect_phase",
        "to": "carry_wait",
        "schedule": false
      },
      {
        "from": "collect_phase",
        "to": "prepare_batch",
        "schedule": false
      },
      {
        "from": "route_collection",
        "to": "carry_wait",
        "when": "iteration_route == 'wait'",
        "transfer": false
      },
      {
        "from": "route_collection",
        "to": "prepare_batch",
        "when": "iteration_route == 'execute'",
        "transfer": false
      },
      [
        "carry_wait",
        "end"
      ],
      [
        "prepare_batch",
        "end"
      ],
      [
        "unpack_execution",
        "execute_step"
      ],
      [
        "execute_step",
        "settle_step"
      ],
      [
        "settle_step",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
