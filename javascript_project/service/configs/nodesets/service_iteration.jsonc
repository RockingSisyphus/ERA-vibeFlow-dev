{
  "type_key": "era.service.iteration",
  "display_name": "收集事件或完成当前批次任务",
  "description": "完成 ERA 服务的一轮工作：空闲时收集聊天事件和脚本请求；执行时准备当前任务，选择提交、历史同步、生成或简单任务入口。模型生成完成后再处理其后续请求，最终把回执合入批次，继续下一项任务或返回事件收集。",
  "requires": [
    {
      "type": "era.service.cycle.state",
      "cardinality": "exactly_one",
      "display_name": "当前阶段状态"
    }
  ],
  "provides": [
    {
      "key": "cycle_state_next",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "当前阶段状态",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代开始",
        "description": "开始收集事件或完成当前批次任务。"
      },
      {
        "id": "route_phase",
        "type_used": "era.service.cycle.route",
        "display_name": "选择当前阶段",
        "description": "根据服务当前处于收集还是执行阶段选择对应入口；阶段状态无效时报告流程错误。"
      },
      {
        "id": "collect_cycle_phase",
        "type_used": "era.service.collect_cycle_phase",
        "display_name": "收集事件并判断是否开始执行",
        "description": "完成一轮事件收集：接收和整理事件，发出定时器控制，再检查是否已经可以执行。就绪时把事件编成任务列表并检查每个来源都有安排；有效计划进入执行阶段，计划有误则向全部来源返回失败。"
      },
      {
        "id": "unpack_execution",
        "type_used": "era.service.cycle.unpack_execution",
        "display_name": "验证在途批次状态",
        "description": "从执行阶段状态取出任务列表、当前位置、累计结果和消息处理进度，供本次任务执行。"
      },
      {
        "id": "prepare_task",
        "type_used": "era.task.prepare",
        "display_name": "准备当前任务及执行所需资料",
        "description": "从批次取出当前任务，读取所需聊天资料，再按任务类型准备初始化、脚本接口、模型生成、历史同步或简单任务请求。输出下一步执行请求，并保留原事件和回执资料。"
      },
      {
        "id": "choose_action",
        "type_used": "era.task.select_action",
        "display_name": "选择执行动作并交付对应请求",
        "description": "读取当前任务的准备结果，选择变量提交、历史同步、模型生成、简单任务或直接返回；把对应请求和原任务资料交给选定入口。"
      },
      {
        "id": "execute_commit",
        "type_used": "era.api.commit",
        "display_name": "应用脚本或界面的变量提交",
        "description": "处理公共接口提交的变量和函数操作。先检查聊天目标与允许执行的范围，工作台草稿先转成有序操作；有效请求转成消息事务，由共享消息流程在内存应用。已经处理过的范围返回跳过，输入无效返回失败；应用回执之后由相应任务安排保存。"
      },
      {
        "id": "candidate_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "生成并检查，必要时重试",
        "description": "反复尝试当前生成阶段：请求模型文本，应用其中的命令，再检查整体结果。可重试的失败先恢复本次尝试起点，再请求新文本；成功或无法继续重试时退出，进入阶段交接。",
        "requires": [
          {
            "type": "era.agent.candidate.state.selected",
            "cardinality": "exactly_one",
            "display_name": "本次模型尝试的请求、起点和进度"
          }
        ],
        "provides": [
          {
            "key": "candidate_outcome",
            "type": "era.agent.candidate.outcome",
            "display_name": "候选执行结果"
          }
        ],
        "loop": {
          "body": "era.agent.candidate_attempt",
          "max_iterations": null,
          "stop_when": {
            "from": "candidate_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.agent.candidate.state.selected",
              "as": "candidate_state",
              "update": "candidate_state_after"
            }
          ],
          "outputs": [
            {
              "from": "candidate_outcome",
              "as": "candidate_outcome"
            }
          ]
        }
      },
      {
        "id": "finish_agent_phase",
        "type_used": "era.agent.finish_phase",
        "display_name": "整理生成阶段结果和下一阶段交接",
        "description": "在生成候选达到最终结论后整理阶段交接。生成完成标识及下一阶段恢复资料，页面执行订阅回调后可以请求继续；需要保存或消息历史结算的结果交回相应流程，取消或失败返回原任务结果。"
      },
      {
        "id": "choose_followup",
        "type_used": "era.task.select_followup",
        "display_name": "选择生成完成后的处理动作",
        "description": "根据模型生成阶段的结论，选择历史同步、消息标识结算或直接返回阶段结果，并保留原任务、批次和回执资料。"
      },
      {
        "id": "execute_sync",
        "type_used": "era.task.sync",
        "display_name": "按聊天历史更新变量并保存",
        "description": "使聊天中的变量和函数与当前消息历史一致。读取并核对状态文件及当前内存结果，找出历史变更处，撤销旧效果后按正文顺序重算；处理指令和作者函数，准备历史压缩，最后保存消息和独立状态文件，再刷新显示并返回结果。"
      },
      {
        "id": "execute_simple_task",
        "type_used": "era.service.step",
        "display_name": "处理标识、设置或忽略任务",
        "description": "执行已经准备好的三类简单任务：确认消息历史标识、处理多阶段生成设置，或为无需处理的事件返回忽略原因。选定分支返回一个任务结果，供批次统一合并。"
      },
      {
        "id": "execute_agent_mk",
        "type_used": "era.task.update_mk",
        "display_name": "结算消息历史标识更新",
        "description": "结算消息历史标识准备的结果。历史标识用于把每条聊天消息与变量变更日志对应起来；读取、生成和必要写入已在任务资料准备时完成。本流程检查该结果，再向任务的原始事件返回无变化、成功或失败回执。"
      },
      {
        "id": "complete_task",
        "type_used": "era.task.finish_result",
        "display_name": "形成原调用方需要的任务回执",
        "description": "接收变量提交、历史同步、简单任务或生成阶段的实际结果，按原调用方形成回执。脚本接口使用原有接口格式，其余任务使用批次任务格式；随后交给批次汇总。"
      },
      {
        "id": "settle_step",
        "type_used": "era.service.settle_step_phase",
        "display_name": "整理当前任务结果并继续批次",
        "description": "接收刚完成任务的回执、诊断和消息进度，合入当前批次并推进任务索引。仍有任务时继续执行；全部完成时汇总并发布整批结果，再返回事件收集阶段。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "阶段迭代结束",
        "description": "结束收集事件或完成当前批次任务，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "route_phase"
      ],
      {
        "from": "route_phase",
        "to": "collect_cycle_phase",
        "when": "cycle_route == 'collect'"
      },
      {
        "from": "route_phase",
        "to": "unpack_execution",
        "when": "cycle_route == 'execute'"
      },
      [
        "collect_cycle_phase",
        "end"
      ],
      [
        "unpack_execution",
        "prepare_task"
      ],
      [
        "prepare_task",
        "choose_action"
      ],
      {
        "from": "choose_action",
        "to": "execute_commit",
        "when": "action_route == 'commit'"
      },
      {
        "from": "choose_action",
        "to": "candidate_loop",
        "when": "action_route == 'candidate'"
      },
      {
        "from": "choose_action",
        "to": "execute_sync",
        "when": "action_route == 'sync'"
      },
      {
        "from": "choose_action",
        "to": "execute_simple_task",
        "when": "action_route == 'simple'"
      },
      {
        "from": "choose_action",
        "to": "complete_task",
        "when": "action_route != 'candidate'"
      },
      [
        "candidate_loop",
        "finish_agent_phase"
      ],
      {
        "from": "choose_action",
        "to": "finish_agent_phase",
        "when": "action_route == 'candidate'",
        "schedule": false
      },
      [
        "finish_agent_phase",
        "choose_followup"
      ],
      {
        "from": "choose_followup",
        "to": "execute_sync",
        "when": "followup_route == 'sync'"
      },
      {
        "from": "choose_followup",
        "to": "execute_agent_mk",
        "when": "followup_route == 'update-mk'"
      },
      {
        "from": "choose_followup",
        "to": "complete_task",
        "when": "followup_route != ''"
      },
      [
        "execute_commit",
        "complete_task"
      ],
      [
        "execute_sync",
        "complete_task"
      ],
      [
        "execute_agent_mk",
        "complete_task"
      ],
      [
        "execute_simple_task",
        "complete_task"
      ],
      {
        "from": "choose_action",
        "to": "settle_step",
        "when": "action_route != ''",
        "schedule": false
      },
      [
        "complete_task",
        "settle_step"
      ],
      [
        "settle_step",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "service_collect_cycle_phase.jsonc"
    },
    {
      "path": "agent_finish_phase.jsonc"
    },
    {
      "path": "agent_candidate_attempt.jsonc"
    },
    {
      "path": "api_commit.jsonc"
    },
    {
      "path": "task_sync.jsonc"
    },
    {
      "path": "service_step.jsonc"
    },
    {
      "path": "service_settle_step_phase.jsonc"
    },
    {
      "path": "task_prepare.jsonc"
    }
  ]
}
