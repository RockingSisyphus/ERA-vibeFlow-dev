{
  "type_key": "era.dispatch.prepare_context",
  "display_name": "ERA 选择并准备任务上下文",
  "description": "从当前严格批次状态选择唯一 PlannedStep，再沿原统一准备链形成已路由任务上下文和外层任务族路由。",
  "requires": [
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "prepared_routed_step",
      "type": "era.step.request.routed",
      "display_name": "已准备路由步骤"
    },
    {
      "key": "prepared_task_route",
      "type": "era.task.route",
      "display_name": "已准备任务路由"
    },
    {
      "key": "prepared_execution_state",
      "type": "era.batch.execution.state",
      "display_name": "已准备批次状态"
    },
    {
      "key": "task_family_route",
      "type": "era.task.family.route",
      "display_name": "外层任务族路由"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 18,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "统一准备启动",
        "description": "启动一次任务执行前的共享上下文准备。"
      },
      {
        "id": "select_step",
        "type_used": "era.service.select_step",
        "display_name": "选择当前步骤",
        "description": "按索引选择当前 PlannedStep，不执行或移除后续步骤。"
      },
      {
        "id": "classify_context",
        "type_used": "era.dispatch.classify_context",
        "display_name": "分类生命周期与公共对象上下文",
        "description": "验证 PlannedStep，保留 initialize、sync、update-mk 与 ignore；将直接公共对象 commit/sync 归为 api。Commit 的 Scope 准入和消息目标仍留在专用 workflow。"
      },
      {
        "id": "build_no_host_context",
        "type_used": "era.dispatch.build_no_host_context",
        "display_name": "构造无宿主上下文",
        "description": "为 context:none 和 ignore 任务构造无消息写入的派发结果，不调用任何 Tavern Capability。"
      },
      {
        "id": "read_canonical_context",
        "type_used": "era.dispatch.read_canonical_context",
        "display_name": "读取严格酒馆上下文",
        "description": "读取包含待生成Swipe的真实全量消息位置，不以lastMessageId宏裁掉末楼；来源依据与实际写入核对使用一致的范围，业务回退仍由Service决定。"
      },
      {
        "id": "stage_message_preparation",
        "type_used": "era.dispatch.plan_message_preparation",
        "display_name": "暂存楼层 MK、占位符与消息更新",
        "description": "保留待生成末端Swipe的真实楼号和索引，明确空正文不等于旧候选正文；生成前回退不提前补写待生成楼，普通状态任务继续仅暂存，空聊天与API写入边界保持。"
      },
      {
        "id": "preserve_prepared_context",
        "type_used": "era.dispatch.preserve_prepared_context",
        "display_name": "保留已准备上下文",
        "description": "在消息文本和 ERAMetaData 已匹配时形成无写入准备结果，保持所有未知元数据和 SelectedMks 的 null 位置。"
      },
      {
        "id": "commit_preparation",
        "type_used": "era.dispatch.commit_preparation",
        "display_name": "提交 MK 与占位符准备",
        "description": "先以 affected 刷新确认当前文本写入；仅 update-mk 任务在此提交完整 ERAMetaData，状态任务的 SelectedMks 由后续同步事务随变量结果一次性提交；部分写入或结果未知立即标为 fatal。"
      },
      {
        "id": "finalize_dispatch_context",
        "type_used": "era.dispatch.finalize_context",
        "display_name": "生成稳定楼层派发上下文 V3",
        "description": "保留原上下文准备；仅将 era.ui.agent_configuration 分派到 agent-settings，生成事件仍进入 agent-generation-session。PlannedStep 的公开 taskRoute 不变。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "统一准备结束",
        "description": "结束任务执行前的共享上下文准备。"
      }
    ],
    "edges": [
      [
        "start",
        "select_step"
      ],
      [
        "select_step",
        "classify_context"
      ],
      {
        "from": "classify_context",
        "to": "build_no_host_context",
        "when": "context_route == 'none'"
      },
      {
        "from": "classify_context",
        "to": "read_canonical_context",
        "when": "context_route == 'read'"
      },
      [
        "read_canonical_context",
        "stage_message_preparation"
      ],
      {
        "from": "stage_message_preparation",
        "to": "preserve_prepared_context",
        "when": "precommit_route == 'no-op'"
      },
      {
        "from": "stage_message_preparation",
        "to": "commit_preparation",
        "when": "precommit_route == 'commit'"
      },
      [
        "build_no_host_context",
        "finalize_dispatch_context"
      ],
      [
        "preserve_prepared_context",
        "finalize_dispatch_context"
      ],
      [
        "commit_preparation",
        "finalize_dispatch_context"
      ],
      [
        "finalize_dispatch_context",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备路由步骤",
        "as": "preparedRoutedStep"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由",
        "as": "preparedTaskRoute"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "已准备批次状态",
        "as": "preparedExecutionState"
      },
      {
        "type": "era.task.family.route",
        "cardinality": "exactly_one",
        "display_name": "外层任务族路由",
        "as": "taskFamilyRoute"
      }
    ]
  }
}
