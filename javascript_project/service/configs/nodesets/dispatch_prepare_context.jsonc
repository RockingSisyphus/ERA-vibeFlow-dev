{
  "type_key": "era.dispatch.prepare_context",
  "display_name": "为当前任务读取聊天并准备消息身份",
  "description": "读取真实聊天与候选状态，在内存准备消息身份和记录，交给统一候选保存流程；派发准备阶段不再单独写回正文。",
  "requires": [
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "prepared_routed_step",
      "type": "era.step.request.routed",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "key": "prepared_task_route",
      "type": "era.task.route",
      "display_name": "本次任务应进入的业务流程"
    },
    {
      "key": "prepared_execution_state",
      "type": "era.batch.execution.state",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {
      "key": "task_family_route",
      "type": "era.task.family.route",
      "display_name": "当前任务所属的业务种类"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 19,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始为当前任务读取聊天并准备消息身份",
        "description": "标明“为当前任务读取聊天并准备消息身份”的开始位置。先判断任务需要哪些资料，再读取当前消息、回复和状态绑定，准备关联变量历史的消息标识及显示占位。普通同步暂存正文变化，单独标识任务按需保存；最后交出可执行任务或读取失败原因。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "select_step",
        "display_name": "取出当前批次接下来的一项任务",
        "description": "在“为当前任务读取聊天并准备消息身份”流程中，根据批次进度取出下一项任务，连同原事件及所属批次交给准备流程。保持规划好的先后顺序，前一项的处理结果可供后续任务使用。",
        "definition_id": "era.service.select_step",
        "join_policy": "all"
      },
      {
        "id": "classify_context",
        "display_name": "判断当前任务要读取哪类资料",
        "description": "在“为当前任务读取聊天并准备消息身份”流程中，根据任务种类，选择读取初始化资源、消息历史、消息标识或脚本接口需要的聊天资料。无需聊天资料时走直接准备分支，确保后续读取服务于本次实际任务。",
        "definition_id": "era.dispatch.classify_context"
      },
      {
        "id": "build_no_host_context",
        "display_name": "为无需读取聊天的任务保留请求资料",
        "description": "在“为当前任务读取聊天并准备消息身份”流程中，对已决定忽略或本来不需要聊天资料的任务，直接准备执行所需的原请求和事件来源。后续可以返回对应处理确认，避免为了空任务读取整份聊天。",
        "definition_id": "era.dispatch.build_no_host_context"
      },
      {
        "id": "read_canonical_context",
        "display_name": "读取当前任务真正需要的聊天资料",
        "description": "在“为当前任务读取聊天并准备消息身份”流程中，按任务需要，从酒馆读取当前聊天、消息正文和所选回复，连同状态文件绑定、历史记录及显示占位设置。整理成同一份任务资料，供后续确定处理范围和执行起点。",
        "definition_id": "era.communication.dispatch_read_canonical_context"
      },
      {
        "id": "stage_message_preparation",
        "display_name": "识别候选状态并暂存消息身份",
        "description": "保留宿主提供的候选存在性与生成周期事实，准备消息身份但不在派发阶段写回正文。已有候选和原生预留位置均交给统一保存流程，避免标记预提交提前扩长swipes。源：base_lib/dispatch_preparation.ts。",
        "definition_id": "era.dispatch.plan_message_preparation"
      },
      {
        "id": "preserve_prepared_context",
        "display_name": "交出候选身份及待写记录",
        "description": "将准备的身份、源聊天依据和待写记录交给后续任务；预留候选的身份准备不会把已经保存的变量基线标成未保存。源：base_lib/dispatch_preparation.ts。",
        "definition_id": "era.dispatch.preserve_prepared_context"
      },
      {
        "id": "finalize_dispatch_context",
        "display_name": "交出当前任务已确认的执行资料",
        "description": "在“为当前任务读取聊天并准备消息身份”流程中，汇总读取到的聊天、准备中的正文修改和实际写入结果，形成初始化、变量提交、生成或普通同步所需的完整资料。执行流程据此使用一致的消息身份和历史范围。",
        "definition_id": "era.dispatch.finalize_context"
      },
      {
        "id": "end",
        "display_name": "结束为当前任务读取聊天并准备消息身份",
        "description": "标明“为当前任务读取聊天并准备消息身份”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"select_step","schedule":true},
      [
        "select_step",
        "classify_context"
      ],
      {
        "from": "classify_context",
        "to": "build_no_host_context",
        "when": "context_route == 'none'"
      },
      {
        "from": "classify_context",
        "to": "read_canonical_context",
        "when": "context_route == 'read'"
      },
      [
        "read_canonical_context",
        "stage_message_preparation"
      ],
      [
        "build_no_host_context",
        "finalize_dispatch_context"
      ],
      [
        "preserve_prepared_context",
        "finalize_dispatch_context"
      ],
      [
        "finalize_dispatch_context",
        "end"
      ],
      [
        "stage_message_preparation",
        "preserve_prepared_context"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"select_step","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"read_canonical_context","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "当前任务及已读取的聊天资料",
        "as": "preparedRoutedStep"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "本次任务应进入的业务流程",
        "as": "preparedTaskRoute"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次的任务进度与累计结果",
        "as": "preparedExecutionState"
      },
      {
        "type": "era.task.family.route",
        "cardinality": "exactly_one",
        "display_name": "当前任务所属的业务种类",
        "as": "taskFamilyRoute"
      }
    ]
  }
}
