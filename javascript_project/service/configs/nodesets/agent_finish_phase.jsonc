{
  "type_key": "era.agent.finish_phase",
  "display_name": "整理生成阶段结果和下一阶段交接",
  "description": "在生成候选达到最终结论后整理阶段交接。生成完成标识及下一阶段恢复资料，页面执行订阅回调后可以请求继续；需要保存或消息历史结算的结果交回相应流程，取消或失败返回原任务结果。",
  "requires": [
    {
      "type": "era.agent.candidate.outcome",
      "cardinality": "exactly_one",
      "display_name": "生成循环的最终结果"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "原任务、事件来源、批次和回执资料"
    }
  ],
  "provides": [
    {
      "key": "era_agent_finish_phase_prepared_task",
      "type": "era.task.prepared",
      "display_name": "待执行请求及原任务资料"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.agent.candidate.outcome",
        "display_name": "生成循环的最终结果",
        "required": true
      },
      {
        "key": "input_1",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源、批次和回执资料",
        "required": true
      }
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "候选收尾开始",
        "description": "开始整理生成阶段结果和下一阶段交接。"
      },
      {
        "id": "carry_preparation_context",
        "type_used": "era.task.carry_preparation_context",
        "display_name": "保留原生成任务的接续依据",
        "description": "本次整理生成阶段完成后的交接。携带原任务、批次和事件来源穿过执行资料准备阶段，供执行与回执使用。"
      },
      {
        "id": "unpack_finish_context",
        "type_used": "era.agent.unpack_finish_context",
        "display_name": "取出候选最终结果及原步骤",
        "description": "本次整理生成阶段完成后的交接。从生成最终结果取出原任务、批次和候选应用结果，供阶段交接与结果结算使用。"
      },
      {
        "id": "prepare_stage_handoff",
        "type_used": "era.agent.prepare_stage_handoff",
        "display_name": "形成阶段交接与恢复凭据",
        "description": "本次整理生成阶段完成后的交接。在生成阶段成功后建立完成标记、阶段结果和下一阶段恢复资料。页面接到通知后依次执行订阅回调，再按恢复资料请求继续。"
      },
      {
        "id": "form_session_transition",
        "type_used": "era.agent.form_session_transition",
        "display_name": "携带已应用阶段状态进入下一阶段",
        "description": "本次整理生成阶段完成后的交接。把候选应用结果转换为后续任务：需要消息保存或历史同步的结果进入共享消息流程，其余结果直接返回生成片段回执。保留原任务和本次允许执行的消息范围。"
      },
      {
        "id": "route_agent_transition",
        "type_used": "era.agent.route_transition",
        "display_name": "路由阶段结果",
        "description": "本次整理生成阶段完成后的交接。根据生成结果需要的结算方式选择出口：历史同步或消息历史标识进入共享任务流程，片段完成、取消或失败进入直接返回流程。"
      },
      {
        "id": "adapt_legacy_step",
        "type_used": "era.agent.adapt_legacy_step",
        "display_name": "把最终楼层候选交给同步事务",
        "description": "本次整理生成阶段完成后的交接。把生成后的消息结算要求转换为普通历史同步或消息历史标识任务，保留原消息位置、事件来源和批次，供共享消息流程继续处理。"
      },
      {
        "id": "build_direct_result",
        "type_used": "era.agent.build_result",
        "display_name": "构造直接结果",
        "description": "本次整理生成阶段完成后的交接。把本次生成片段的实际结果整理为任务回执，附上阶段完成标记、诊断和页面通知。页面可在订阅回调结束后请求执行下一阶段。"
      },
      {
        "id": "return_legacy_continuation",
        "type_used": "era.agent.prepare_legacy_continuation",
        "display_name": "返回后续共享同步或标识请求",
        "description": "本次整理生成阶段完成后的交接。把候选已经应用的消息及允许执行范围转换为历史同步或消息历史标识任务，保留原事件来源，供共享消息流程完成结算。"
      },
      {
        "id": "return_direct_continuation",
        "type_used": "era.agent.prepare_direct_continuation",
        "display_name": "返回当前阶段片段的结果",
        "description": "本次整理生成阶段完成后的交接。将阶段交接、取消或失败结果与原请求一起整理为直接返回资料，供任务结算使用。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "候选收尾结束",
        "description": "结束整理生成阶段结果和下一阶段交接，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "carry_preparation_context"
      ],
      [
        "start",
        "unpack_finish_context"
      ],
      [
        "unpack_finish_context",
        "prepare_stage_handoff"
      ],
      [
        "prepare_stage_handoff",
        "form_session_transition"
      ],
      {
        "from": "unpack_finish_context",
        "to": "form_session_transition",
        "schedule": false
      },
      [
        "form_session_transition",
        "route_agent_transition"
      ],
      {
        "from": "route_agent_transition",
        "to": "adapt_legacy_step",
        "when": "agent_route == 'legacy'"
      },
      {
        "from": "route_agent_transition",
        "to": "build_direct_result",
        "when": "agent_route == 'direct'"
      },
      [
        "adapt_legacy_step",
        "return_legacy_continuation"
      ],
      {
        "from": "carry_preparation_context",
        "to": "return_legacy_continuation",
        "schedule": false
      },
      [
        "build_direct_result",
        "return_direct_continuation"
      ],
      {
        "from": "carry_preparation_context",
        "to": "return_direct_continuation",
        "schedule": false
      },
      [
        "return_legacy_continuation",
        "end"
      ],
      [
        "return_direct_continuation",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "待执行请求及原任务资料",
        "as": "era_agent_finish_phase_prepared_task"
      }
    ]
  }
}
