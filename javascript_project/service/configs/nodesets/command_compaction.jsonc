{
  "type_key": "era.command_compaction.apply_sealed_layers",
  "display_name": "应用同 Scope 封存命令压缩",
  "description": "选择封存楼层，调用发布的同步 Compaction AOT 工作流；作用域划分由 Compaction 唯一负责，Service 保留真实 CRUD 复放与计划回填。",
  "requires": [
    {
      "type": "era.expression.command.result",
      "cardinality": "exactly_one",
      "display_name": "表达式命令同步结果"
    }
  ],
  "provides": [
    {
      "key": "command_compaction_result",
      "type": "era.command_compaction.result",
      "display_name": "已处理封存压缩的同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "expression_command_result",
        "type": "era.expression.command.result",
        "display_name": "表达式命令同步结果",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "封存压缩开始",
        "description": "进入不含 Tavern I/O 的封存压缩编排边界。"
      },
      {
        "id": "identify_sealed_layers",
        "type_used": "era.command_compaction.identify_sealed",
        "display_name": "识别已封存楼层",
        "description": "只选择当前活动分支中已有后续 AI 消息的楼层；最新 AI 楼层保持原文，并按 marker 版本、MK 与文本指纹判断是否需要重新检查。"
      },
      {
        "id": "attach_random_context",
        "type_used": "era.command_compaction.attach_random_context",
        "display_name": "附加封存楼层随机上下文",
        "description": "从已识别楼层直接生成压缩请求，保留 MK/sourceKey 与零起始 drawOffset；不要求 Service 解析作用域。"
      },
      {
        "id": "compact_each_segment",
        "type_used": "era.command_compaction.compact_segments",
        "display_name": "调用 Compaction 同步工作流",
        "description": "原 compactCommandLayer API 委托已生成的同步 runWorkflow；每个封存楼层调用一次，由 Compaction 内部顺序处理各段。保留原返回格式与 Service 后续复放。"
      },
      {
        "id": "replay_with_service_engine",
        "type_used": "era.command_compaction.replay_service",
        "display_name": "用 Service 真实语义重放",
        "description": "逐段重放原始与候选，要求变量、函数库、变量/函数日志和诊断一致；无法证明时仅保留该段原始事务，不让压缩失败升级为同步失败。"
      },
      {
        "id": "write_single_scope_segments",
        "type_used": "era.command_compaction.write_segments",
        "display_name": "回填单一 Scope 事务",
        "description": "每个成功段最多写回一个保持原 s 的 era_tx；partial/unchanged 段保持局部顺序，不跨越正文或其他 scope，并更新对应 EditLog、FunctionEditLog 与 messageUpdates。"
      },
      {
        "id": "update_compaction_markers",
        "type_used": "era.command_compaction.update_markers",
        "display_name": "更新压缩调度 Marker",
        "description": "记录版本、MK、当前文本指纹与结果状态；编辑、插入、删除、分支切换或指纹不匹配时自动失效，不保存 API 窗口或修订游标。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "封存压缩结束",
        "description": "返回仍由既有 Sidecar 事务提交的同步工作项。"
      }
    ],
    "edges": [
      [
        "start",
        "identify_sealed_layers"
      ],
      [
        "identify_sealed_layers",
        "attach_random_context"
      ],
      [
        "attach_random_context",
        "compact_each_segment"
      ],
      [
        "compact_each_segment",
        "replay_with_service_engine"
      ],
      [
        "replay_with_service_engine",
        "write_single_scope_segments"
      ],
      [
        "write_single_scope_segments",
        "update_compaction_markers"
      ],
      [
        "update_compaction_markers",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command_compaction.result",
        "cardinality": "exactly_one",
        "display_name": "已处理封存压缩的同步结果",
        "as": "commandCompactionResult"
      }
    ]
  }
}
