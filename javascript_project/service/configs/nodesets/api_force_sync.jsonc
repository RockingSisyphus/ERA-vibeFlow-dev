{
  "type_key": "era.api.force_sync",
  "display_name": "ERA 强制同步 API",
  "description": "解析四种公开强制同步模式，复用共享同步事务并保留普通输入失败与 fatal 提交边界。",
  "requires": [
    {
      "type": "era.api.request",
      "cardinality": "exactly_one",
      "display_name": "规范化 API 请求"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "force_sync_result",
      "type": "era.task.result.merged",
      "display_name": "强制同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "api_request",
        "type": "era.api.request",
        "display_name": "规范化 API 请求",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "强制同步开始",
        "description": "开始一次 forceSync 请求。"
      },
      {
        "id": "prepare_sync_context",
        "type_used": "era.api.prepare_execution_context",
        "display_name": "准备强制同步上下文",
        "description": "显式保留 API 请求和原批次状态，保证共享同步节点取得同一批次状态。"
      },
      {
        "id": "read_messages",
        "type_used": "era.api.read_force_sync_messages",
        "display_name": "读取严格同步消息",
        "description": "使用 projection=era-active-message-v1 读取严格消息投影以解析 latest 目标，不复制 Date、swipes_info、附件或宿主对象。"
      },
      {
        "id": "plan_force_sync",
        "type_used": "era.api.plan_force_sync",
        "display_name": "规划强制同步",
        "description": "解析模式并形成携带 dispatchClass=api 的共享同步步骤或普通输入失败；API 公开计数固定为 1。"
      },
      {
        "id": "execute_sync",
        "type_used": "era.task.sync",
        "display_name": "执行共享同步",
        "description": "以 API 来源执行 normal/full/latest/rollbackTo 共享事务，事务前后保持连续状态 carry 不变。"
      },
      {
        "id": "adapt_success",
        "type_used": "era.api.adapt_force_sync_result",
        "display_name": "适配同步结果",
        "description": "保留共享同步结果并转换 API 分支类型。"
      },
      {
        "id": "build_failure",
        "type_used": "era.api.build_force_sync_failure",
        "display_name": "构造输入失败",
        "description": "逐一失败结算无效强制同步请求。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "强制同步结束",
        "description": "结束 forceSync 请求。"
      }
    ],
    "edges": [
      [
        "start",
        "prepare_sync_context"
      ],
      [
        "prepare_sync_context",
        "read_messages"
      ],
      {
        "from": "prepare_sync_context",
        "to": "plan_force_sync",
        "schedule": false
      },
      {
        "from": "prepare_sync_context",
        "to": "execute_sync",
        "schedule": false
      },
      [
        "read_messages",
        "plan_force_sync"
      ],
      {
        "from": "plan_force_sync",
        "to": "execute_sync",
        "when": "force_sync_route == 'sync'"
      },
      {
        "from": "plan_force_sync",
        "to": "build_failure",
        "when": "force_sync_route == 'failed'"
      },
      [
        "execute_sync",
        "adapt_success"
      ],
      [
        "adapt_success",
        "end"
      ],
      [
        "build_failure",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result.merged",
        "cardinality": "exactly_one",
        "display_name": "强制同步结果",
        "as": "forceSyncResult"
      }
    ]
  }
}
