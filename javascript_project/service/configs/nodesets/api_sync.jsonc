{
  "type_key": "era.api.sync",
  "display_name": "ERA 公共对象同步",
  "description": "将 ERA.sync 直接适配到共享同步事务。",
  "requires": [
    {
      "type": "era.api.request",
      "cardinality": "exactly_one",
      "display_name": "era.api.request"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "era.batch.execution.state"
    }
  ],
  "provides": [
    {
      "key": "sync_result",
      "type": "era.api.facade.result",
      "display_name": "sync_result"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "facade_request",
        "type": "era.api.request",
        "required": true,
        "display_name": "facade_request"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "required": true,
        "display_name": "execution_state"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "公共对象同步开始",
        "description": "执行公共对象同步开始。"
      },
      {
        "id": "validate_and_build_sync_step",
        "type_used": "era.api.plan_facade_sync",
        "display_name": "校验并构造同步步骤",
        "description": "执行校验并构造同步步骤。"
      },
      {
        "id": "run_shared_sync",
        "type_used": "era.task.sync",
        "display_name": "运行共享同步事务",
        "description": "执行运行共享同步事务。"
      },
      {
        "id": "adapt_sync_receipt",
        "type_used": "era.api.adapt_facade_sync",
        "display_name": "适配 ERA.sync receipt",
        "description": "执行适配 ERA.sync receipt。"
      },
      {
        "id": "build_sync_failure",
        "type_used": "era.api.build_facade_sync_failure",
        "display_name": "构造同步输入失败",
        "description": "执行构造同步输入失败。"
      },
      {
        "id": "merge_sync_result",
        "type_used": "era.api.merge_sync_result",
        "display_name": "合并公共对象同步结果",
        "description": "执行合并公共对象同步结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "公共对象同步结束",
        "description": "执行公共对象同步结束。"
      }
    ],
    "edges": [
      [
        "start",
        "validate_and_build_sync_step"
      ],
      {
        "from": "validate_and_build_sync_step",
        "to": "run_shared_sync",
        "when": "facade_sync_route == 'sync'"
      },
      {
        "from": "validate_and_build_sync_step",
        "to": "adapt_sync_receipt",
        "when": "facade_sync_route == 'sync'"
      },
      {
        "from": "validate_and_build_sync_step",
        "to": "build_sync_failure",
        "when": "facade_sync_route == 'failed'"
      },
      [
        "run_shared_sync",
        "adapt_sync_receipt"
      ],
      [
        "adapt_sync_receipt",
        "merge_sync_result"
      ],
      [
        "build_sync_failure",
        "merge_sync_result"
      ],
      [
        "merge_sync_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.api.facade.result",
        "cardinality": "exactly_one",
        "as": "syncResult",
        "display_name": "syncResult"
      }
    ]
  }
}
