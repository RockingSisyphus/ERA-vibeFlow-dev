{
  "type_key": "era.agent.settings",
  "display_name": "读取和管理多阶段生成设置",
  "description": "接收用户对生成配置、预设、连接或模型列表的操作，准备必要资料，通过酒馆执行，再向原发起者返回真实结果。模型生成本身由生成流程处理。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "settings_task_result",
      "type": "era.task.result",
      "display_name": "本项任务对应原事件的处理结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "required": true,
        "display_name": "当前任务及已读取的聊天资料"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始读取和管理多阶段生成设置",
        "description": "标明“读取和管理多阶段生成设置”的开始位置。接收用户对生成配置、预设、连接或模型列表的操作，准备必要资料，通过酒馆执行，再向原发起者返回真实结果。模型生成本身由生成流程处理。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "prepare_settings_request",
        "display_name": "整理本次生成设置操作所需资料",
        "description": "在“读取和管理多阶段生成设置”流程中，接收用户的生成设置请求，读取这项操作需要的当前配置、预设或连接资料。将明确的操作及原请求一起交给执行步骤，使结果能够对应回发起者。",
        "definition_id": "era.communication.agent_prepare_settings_request",
        "join_policy": "all"
      },
      {
        "id": "execute_settings_command",
        "display_name": "读取或修改多阶段生成设置",
        "description": "在“读取和管理多阶段生成设置”流程中，接收生成设置命令，按要求读取或修改角色的生成配置、预设、连接方案或模型列表。通过酒馆完成实际操作，再将真正取得的结果或失败原因交回设置任务。",
        "definition_id": "era.communication.agent_execute_settings_command"
      },
      {
        "id": "build_settings_result",
        "display_name": "向发起者返回生成设置结果",
        "description": "在“读取和管理多阶段生成设置”流程中，接收配置、预设、连接或模型列表操作的实际结果，匹配原始请求，形成处理确认。成功值和失败原因都保留，供界面或脚本显示与使用。",
        "definition_id": "era.agent.build_settings_result"
      },
      {
        "id": "end",
        "display_name": "结束读取和管理多阶段生成设置",
        "description": "标明“读取和管理多阶段生成设置”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"prepare_settings_request","schedule":true},
      [
        "prepare_settings_request",
        "execute_settings_command"
      ],
      [
        "execute_settings_command",
        "build_settings_result"
      ],
      {
        "from": "start",
        "to": "build_settings_result",
        "transfer": false,
        "schedule": true
      },
      [
        "build_settings_result",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"prepare_settings_request","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"execute_settings_command","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "本项任务对应原事件的处理结果",
        "as": "settingsTaskResult"
      }
    ]
  }
}
