{
  "type_key": "era.agent.settings",
  "display_name": "管理 Agent 设置与连接",
  "description": "在聊天和 API 共用的有序 Service 队列中处理 Agent 配置、预设、连接和模型列表，读取必要事实后执行相应设置命令并返回来源回执。它不进入规划、正文或结算的模型生成状态机，也不改聊天变量，避免设置任务误占用生成阶段的上下文。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已准备步骤"
    }
  ],
  "provides": [
    {
      "key": "settings_task_result",
      "type": "era.task.result",
      "display_name": "设置任务结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "required": true,
        "display_name": "已准备步骤"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "设置命令开始",
        "description": "这是“管理 Agent 设置与连接”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "prepare_settings_request",
        "type_used": "era.agent.prepare_settings_request",
        "display_name": "准备设置命令",
        "description": "为 Agent 设置命令读取必要配置、预设或连接事实，整理出具体设置请求。设置任务只需要这些资料，不带入模型生成阶段的大量历史和候选上下文；读取或请求问题作为诊断交给执行节点，不在此发起正文生成。"
      },
      {
        "id": "execute_settings_command",
        "type_used": "era.agent.execute_settings_command",
        "display_name": "执行设置命令",
        "description": "在与聊天操作相同的有序 Service 队列中处理 Agent 配置、预设、连接或模型列表命令，通过既有宿主接口读取或写入相应设置。连接相关的即时事实读取和发起操作连续完成，减少使用过期事实。返回真实操作结果，不启动生成会话、不应用消息中的变量指令。"
      },
      {
        "id": "build_settings_result",
        "type_used": "era.agent.build_settings_result",
        "display_name": "结算设置命令",
        "description": "把设置命令的实际返回值和诊断对应到原任务来源，形成一份可由 Service 合并的任务结果。这里只返回设置处理结论，不修改批次索引或进入生成阶段，也不将连接测试成功等同于后续模型生成成功。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "设置命令结束",
        "description": "这是“管理 Agent 设置与连接”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "prepare_settings_request"
      ],
      [
        "prepare_settings_request",
        "execute_settings_command"
      ],
      [
        "execute_settings_command",
        "build_settings_result"
      ],
      {
        "from": "start",
        "to": "build_settings_result",
        "transfer": false,
        "schedule": true
      },
      [
        "build_settings_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "设置任务结果",
        "as": "settingsTaskResult"
      }
    ]
  }
}
