{
  "type_key": "era.agent.settings",
  "display_name": "管理生成配置、预设和连接",
  "description": "处理多阶段生成的配置、预设、连接和模型列表操作。按命令读取必要的当前设置，通过浏览器接口执行相应操作，再将实际结果对应到原始请求。此流程负责设置管理，生成阶段在其他任务中执行。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已准备步骤"
    }
  ],
  "provides": [
    {
      "key": "settings_task_result",
      "type": "era.task.result",
      "display_name": "设置任务结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "required": true,
        "display_name": "已准备步骤"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "设置命令开始",
        "description": "开始管理生成配置、预设和连接。"
      },
      {
        "id": "prepare_settings_request",
        "type_used": "era.agent.prepare_settings_request",
        "display_name": "准备设置命令",
        "description": "本次处理多阶段生成的设置操作。读取设置操作所需的当前配置、预设和连接资料，组装待执行命令并保留原请求。"
      },
      {
        "id": "execute_settings_command",
        "type_used": "era.agent.execute_settings_command",
        "display_name": "执行设置命令",
        "description": "本次处理多阶段生成的设置操作。通过酒馆浏览器接口读取或修改生成配置、预设、连接和模型列表，返回接口实际完成的结果及错误信息。"
      },
      {
        "id": "build_settings_result",
        "type_used": "era.agent.build_settings_result",
        "display_name": "结算设置命令",
        "description": "本次处理多阶段生成的设置操作。把配置、预设、连接或模型列表操作的实际结果对应到原请求，输出任务回执及诊断信息。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "设置命令结束",
        "description": "结束管理生成配置、预设和连接，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "prepare_settings_request"
      ],
      [
        "prepare_settings_request",
        "execute_settings_command"
      ],
      [
        "execute_settings_command",
        "build_settings_result"
      ],
      {
        "from": "start",
        "to": "build_settings_result",
        "transfer": false,
        "schedule": true
      },
      [
        "build_settings_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "设置任务结果",
        "as": "settingsTaskResult"
      }
    ]
  }
}
