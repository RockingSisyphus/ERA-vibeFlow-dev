{
  "type_key": "era.migration.service.apply_stage_call.workflow.request_step",
  "display_name": "完成一次原生同步调用并继续业务计算",
  "description": "把当前阶段的一项函数调用、参数、已提交快照和随机起点整理为公式请求；函数位置及失败表留在当前流程。 本次返回后继续原计算，直到下一次确有调用需求或本段结束。",
  "expand": true,
  "requires": [
    {
      "type": "era.migration.service.apply_stage_call.state",
      "cardinality": "exactly_one",
      "display_name": "仅保留在当前工作流的业务进度"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "next_state",
      "type": "era.migration.service.apply_stage_call.state",
      "display_name": "接回本次结果后的本地业务进度"
    },
    {
      "key": "done",
      "type": "era.migration.service.apply_stage_call.done",
      "display_name": "本段是否已无后续调用"
    },
    {"key":"retained_host_resources","type":"era.workflow.host_resources","display_name":"所属 ERA 实例的本地资源"}
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "state",
        "type": "era.migration.service.apply_stage_call.state",
        "required": true,
        "display_name": "仅保留在当前工作流的业务进度"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.service.terminal",
        "display_name": "开始本段处理",
        "description": "本步骤用于“完成一次原生同步调用并继续业务计算”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      },
      {
        "id": "prepare_request",
        "display_name": "整理当前这一项纯数据请求",
        "description": "本步骤用于“完成一次原生同步调用并继续业务计算”：把当前阶段的一项函数调用、参数、已提交快照和随机起点整理为公式请求；函数位置及失败表留在当前流程。 仅输出目标入口需要的纯数据字段，不传完整控制状态。",
        "definition_id": "era.migration.service.apply_stage_call.workflow.prepare_request",
        "join_policy": "all"
      },
      {
        "id": "encode_request",
        "definition_id": "era.workflow.encode_request",
        "display_name": "把业务输入转换为保留原值的消息",
        "description": "在此处保留大数、负零、数组空位和缺失值，使独立流程收到与原调用相同的业务值。此转换只处理消息，当前业务进度仍通过图内数据连接保留。"
      },
      {
        "id": "invoke_sync_host_turn",
        "definition_id": "era.workflow.yield_host_turn",
        "display_name": "让宿主处理一轮事件再继续",
        "description": "在异步Service发出下一项同步子流程请求前，等待所属酒馆实例完成一轮可取消的宿主事件调度，让界面、生成事件和取消通知获得执行机会；随后原样交出当前请求，由下游原InvokeSync执行。保持请求顺序、目标、参数和结果，不处理消息或变量，也不延长业务等待上限。实现源：nodes/workflow/protocol.mjs，宿主原语位于Tavern protocol_resources。"
      },
      {
        "id": "invoke_sync",
        "definition_id": "era.workflow.invoke_sync",
        "display_name": "InvokeSync：调用独立表达式流程",
        "description": "本步骤用于“完成一次原生同步调用并继续业务计算”：发送当前这一项完整纯数据请求并当场接回结果；只传目标业务输入，本地进度和宿主资源不进入通信。",
        "config": {
          "workflow": {
            "root": "era-expression",
            "path": "configs/era.expression.jsonc",
            "entry": "protocol"
          }
        }
      },
      {
        "id": "decode_outputs",
        "definition_id": "era.workflow.decode_outputs",
        "display_name": "恢复目标流程返回的原始业务值",
        "description": "在此处保留大数、负零、数组空位和缺失值，使独立流程收到与原调用相同的业务值。此转换只处理消息，当前业务进度仍通过图内数据连接保留。"
      },
      {
        "id": "accept_response",
        "display_name": "接回结果并寻找下一次调用",
        "description": "本步骤用于“完成一次原生同步调用并继续业务计算”：把目标结果放回原计算位置，保留诊断、随机进度和原顺序；推进纯计算直到下一次需要调用，或标记整段完成。",
        "definition_id": "era.migration.service.apply_stage_call.workflow.accept_response"
      },
      {
        "id": "end",
        "definition_id": "era.service.terminal",
        "display_name": "完成本段处理",
        "description": "本步骤用于“完成一次原生同步调用并继续业务计算”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"prepare_request","schedule":true},
      [
        "prepare_request",
        "encode_request"
      ],
      [
        "decode_outputs",
        "accept_response"
      ],
      [
        "accept_response",
        "end"
      ],
      {
        "from": "prepare_request",
        "to": "accept_response",
        "schedule": false
      },
      [
        "encode_request",
        "invoke_sync_host_turn"
      ],
      [
        "invoke_sync",
        "decode_outputs"
      ],
      [
        "invoke_sync_host_turn",
        "invoke_sync"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"prepare_request","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"invoke_sync_host_turn","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.migration.service.apply_stage_call.state",
        "cardinality": "exactly_one",
        "display_name": "接回本次结果后的本地业务进度",
        "as": "next_state"
      },
      {
        "type": "era.migration.service.apply_stage_call.done",
        "cardinality": "exactly_one",
        "display_name": "本段是否已无后续调用",
        "as": "done"
      },
      {"type":"era.workflow.host_resources","as":"retained_host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
    ]
  }
}
