{
  "type_key": "era.service.settle_step_phase",
  "display_name": "整理当前任务结果并继续批次",
  "description": "接收刚完成任务的回执、诊断和消息进度，合入当前批次并推进任务索引。仍有任务时继续执行；全部完成时汇总并发布整批结果，再返回事件收集阶段。",
  "requires": [
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "已准备批次状态"
    },
    {
      "type": "era.task.result",
      "cardinality": "exactly_one",
      "display_name": "当前任务结果"
    }
  ],
  "provides": [
    {
      "key": "settled_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "已准备批次状态",
        "required": true
      },
      {
        "key": "task_result",
        "type": "era.task.result",
        "display_name": "当前任务结果",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "单步后处理开始",
        "description": "开始整理当前任务结果并继续批次。"
      },
      {
        "id": "merge_task_result",
        "type_used": "era.service.merge_task_result",
        "display_name": "合并步骤结果",
        "description": "本次整理一个已执行任务的结果。把当前任务的回执、诊断、通知和消息处理进度合入批次累计结果，移到下一任务位置，并标记批次是否完成。"
      },
      {
        "id": "route_completion",
        "type_used": "era.service.cycle.route_completion",
        "display_name": "路由继续或收尾",
        "description": "本次整理一个已执行任务的结果。检查当前批次是否还有待执行任务。未结束时继续下一任务，已结束时进入批次结算。"
      },
      {
        "id": "carry_execution",
        "type_used": "era.service.cycle.carry_execution",
        "display_name": "继续同一批次",
        "description": "本次整理一个已执行任务的结果。把下一任务位置、累计结果和消息处理进度放回执行循环，供后续任务继续使用。"
      },
      {
        "id": "promote_done_state",
        "type_used": "era.service.cycle.promote_done",
        "display_name": "确认待结算状态",
        "description": "本次整理一个已执行任务的结果。把已经完成的批次交给最终结算阶段，供汇总所有原事件的回执。"
      },
      {
        "id": "finish_batch",
        "type_used": "era.service.finish_batch",
        "display_name": "汇总批次结果并发送给酒馆页面",
        "description": "本次整理一个已执行任务的结果。汇总当前批次所有任务的结论，检查每个原始事件恰有一次回执，再发送结果和通知。普通失败后可以继续接收事件；写入结果未知等致命问题先告知调用方，再停止服务。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "单步后处理结束",
        "description": "结束整理当前任务结果并继续批次，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "merge_task_result"
      ],
      [
        "merge_task_result",
        "route_completion"
      ],
      {
        "from": "route_completion",
        "to": "carry_execution",
        "when": "completion_route == 'continue'"
      },
      {
        "from": "route_completion",
        "to": "promote_done_state",
        "when": "completion_route == 'finish'"
      },
      [
        "promote_done_state",
        "finish_batch"
      ],
      [
        "carry_execution",
        "end"
      ],
      [
        "finish_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
