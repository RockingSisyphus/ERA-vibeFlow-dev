{
  "type_key": "era.service.settle_step_phase",
  "display_name": "ERA 单步结果阶段",
  "description": "在一个任务结束后合并其回执、诊断和进度，推进批次索引。还有任务则继续执行原批次，全部结束则立即进入批次结算和发布，再恢复事件收集。该节点集只接续已产生的结果，不重做任务，也不因一条普通业务失败自动抛弃剩余计划。",
  "requires": [
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "已准备批次状态"
    },
    {
      "type": "era.task.result",
      "cardinality": "exactly_one",
      "display_name": "当前任务结果"
    }
  ],
  "provides": [
    {
      "key": "settled_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "已准备批次状态",
        "required": true
      },
      {
        "key": "task_result",
        "type": "era.task.result",
        "display_name": "当前任务结果",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "单步后处理开始",
        "description": "这是“ERA 单步结果阶段”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "merge_task_result",
        "type_used": "era.service.merge_task_result",
        "display_name": "合并步骤结果",
        "description": "把当前任务的结果合入批次：累计各事件的结算、诊断和通知，接续消息处理进度，再把步骤索引推进一位。输出更新后的状态及是否已完成全部步骤；它不会重新执行任务或立即读入新事件。此处统一汇合，确保不同任务分支采用同一种批次推进规则。"
      },
      {
        "id": "route_completion",
        "type_used": "era.service.cycle.route_completion",
        "display_name": "路由继续或收尾",
        "description": "读取任务合并给出的完成标志，决定带着更新后的状态执行下一个步骤，还是当轮结束批次。这里不重新计算步骤数或更改结果，只将同一次合并的结论用于分支选择，避免最后一步执行后多等一轮。"
      },
      {
        "id": "carry_execution",
        "type_used": "era.service.cycle.carry_execution",
        "display_name": "继续同一批次",
        "description": "当批次还有剩余步骤时，把更新后的索引、累计结算、诊断和消息处理进度重新包装为执行阶段，供下一轮继续。不会在批次中途接收入站事件，也不会清空已完成任务的结果。"
      },
      {
        "id": "promote_done_state",
        "type_used": "era.service.cycle.promote_done",
        "display_name": "确认待结算状态",
        "description": "把已完成全部步骤的批次状态送到批次结算通道，保留所有值。这个节点只是转换数据出口，不再推进索引、不额外执行任务；完成条件由之前的任务合并和分支判断提供。"
      },
      {
        "id": "finish_batch",
        "type_used": "era.service.finish_batch",
        "display_name": "结算并发布批次",
        "description": "结束本批次并为全部原始事件准确结算一次，构造统一结果帧，先发送给宿主，再判断能否继续服务。普通失败可带着诊断进入下一轮收集；无法确认写入等致命结果则在发送后抛错。这个顺序确保服务停止前，等待本批结果的调用方已能收到结论。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "单步后处理结束",
        "description": "这是“ERA 单步结果阶段”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "merge_task_result"
      ],
      [
        "merge_task_result",
        "route_completion"
      ],
      {
        "from": "route_completion",
        "to": "carry_execution",
        "when": "completion_route == 'continue'"
      },
      {
        "from": "route_completion",
        "to": "promote_done_state",
        "when": "completion_route == 'finish'"
      },
      [
        "promote_done_state",
        "finish_batch"
      ],
      [
        "carry_execution",
        "end"
      ],
      [
        "finish_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
