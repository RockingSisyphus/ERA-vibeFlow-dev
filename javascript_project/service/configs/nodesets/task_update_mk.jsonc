{
  "type_key": "era.task.update_mk",
  "display_name": "结算消息历史标识更新",
  "description": "结算消息历史标识准备的结果。历史标识用于把每条聊天消息与变量变更日志对应起来；读取、生成和必要写入已在任务资料准备时完成。本流程检查该结果，再向任务的原始事件返回无变化、成功或失败回执。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已准备路由步骤"
    }
  ],
  "provides": [
    {
      "key": "update_mk_task_result",
      "type": "era.task.result",
      "display_name": "消息历史标识 更新结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已准备路由步骤",
        "required": true
      }
    ],
    "max_steps": 6,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "消息历史标识 结算启动",
        "description": "开始结算消息历史标识更新。"
      },
      {
        "id": "consume_prepared_mk_context",
        "type_used": "era.mk.consume_prepared",
        "display_name": "确认统一 消息历史标识 准备结果",
        "description": "本次结算消息历史标识任务。取出任务准备阶段已经生成的消息历史标识、占位内容和实际写入结果，供标识任务结算。"
      },
      {
        "id": "build_mk_result",
        "type_used": "era.mk.build_result",
        "display_name": "构造 消息历史标识 任务结果",
        "description": "本次结算消息历史标识任务。根据消息历史标识的准备和写入结果，为每个原事件返回一次成功、无变化或失败回执，并附上诊断。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "消息历史标识 结算结束",
        "description": "结束结算消息历史标识更新，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "consume_prepared_mk_context"
      ],
      [
        "consume_prepared_mk_context",
        "build_mk_result"
      ],
      [
        "build_mk_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "消息历史标识 更新结果",
        "as": "updateMkTaskResult"
      }
    ]
  }
}
