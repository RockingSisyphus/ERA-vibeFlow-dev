{
  "type_key": "era.agent.candidate_attempt",
  "display_name": "生成文本并检查其中的命令应用",
  "description": "执行模型输出的一次候选尝试：请求模型文本，将其中的变量、函数和作者调用交给共享消息流程应用，再检查候选结果。可纠正的失败恢复本次尝试起点并准备重试，较早成功的阶段继续保留；成功或无法重试时返回最终结论。",
  "requires": [
    {
      "type": "era.agent.candidate.state",
      "cardinality": "exactly_one",
      "display_name": "本次模型尝试的请求、起点和进度"
    }
  ],
  "provides": [
    {
      "key": "candidate_state_after",
      "type": "era.agent.candidate.state.next",
      "display_name": "本次尝试后的进度及重试请求"
    },
    {
      "key": "candidate_done",
      "type": "era.agent.candidate.done",
      "display_name": "本阶段是否已成功或无法继续"
    },
    {
      "key": "candidate_outcome",
      "type": "era.agent.candidate.outcome",
      "display_name": "候选执行结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "required": true,
        "display_name": "候选请求"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试开始",
        "description": "开始生成文本并检查其中的命令应用。"
      },
      {
        "id": "unpack_candidate",
        "type_used": "era.agent.candidate_unpack",
        "display_name": "取出候选执行输入",
        "description": "本次检查一次模型生成结果及其命令应用。从当前候选运行状态取出模型请求、原任务和批次，交给下一次模型调用。"
      },
      {
        "id": "execute_agent_phase_v2",
        "type_used": "era.agent.execute_session_v2",
        "display_name": "生成标签格式结算候选",
        "description": "本次检查一次模型生成结果及其命令应用。按当前阶段请求模型生成文本，收集其中的变量命令、函数定义和作者调用，输出待应用的候选内容及模型执行结果。"
      },
      {
        "id": "prepare_stage_blocks",
        "type_used": "era.lifecycle.prepare_stage_blocks",
        "display_name": "标签候选接入共用逐块执行",
        "description": "本次检查一次模型生成结果及其命令应用。为模型生成的候选正文建立消息命令执行计划，并保存失败恢复所需的起点。规划阶段可使用即将生成的 AI 消息位置，其余阶段使用捕获的实际目标。"
      },
      {
        "id": "apply_stage_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "依次应用本次模型生成的命令",
        "description": "按本次模型生成结果的正文顺序处理变量指令、函数和作者调用，携带累计的变量、正文、日志及随机进度。候选范围完成或发生结束结果时退出，交给候选检查决定成功、重试或失败。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "开始处理的消息范围、变量、函数和日志"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "处理后的消息位置、变量、函数和日志"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finish_stage_blocks",
        "type_used": "era.lifecycle.finish_stage_blocks",
        "display_name": "回送已应用阶段状态及草稿",
        "description": "本次检查一次模型生成结果及其命令应用。把模型候选中已完成的命令应用结果合入生成会话正文及进度。可重试的失败恢复本次候选起点，再准备重试；重试耗尽时保留候选起点及较早阶段成果并返回失败。"
      },
      {
        "id": "finish_candidate",
        "type_used": "era.agent.candidate_finish",
        "display_name": "判断是否重试候选",
        "description": "本次检查一次模型生成结果及其命令应用。检查一次生成候选是否需要重试。存在重试请求时保留运行进度继续尝试；否则输出本次生成的最终结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试结束",
        "description": "结束生成文本并检查其中的命令应用，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_candidate"
      ],
      [
        "unpack_candidate",
        "execute_agent_phase_v2"
      ],
      [
        "execute_agent_phase_v2",
        "prepare_stage_blocks"
      ],
      [
        "prepare_stage_blocks",
        "apply_stage_blocks"
      ],
      [
        "apply_stage_blocks",
        "finish_stage_blocks"
      ],
      [
        "finish_stage_blocks",
        "finish_candidate"
      ],
      {
        "from": "start",
        "to": "finish_candidate",
        "transfer": false,
        "schedule": true
      },
      [
        "finish_candidate",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.agent.candidate.state.next",
        "cardinality": "exactly_one",
        "as": "candidate_state_after",
        "display_name": "候选状态"
      },
      {
        "type": "era.agent.candidate.done",
        "cardinality": "exactly_one",
        "as": "candidate_done",
        "display_name": "本次生成的最终结论"
      },
      {
        "type": "era.agent.candidate.outcome",
        "cardinality": "exactly_one",
        "as": "candidate_outcome",
        "display_name": "阶段结果"
      }
    ]
  }
}
