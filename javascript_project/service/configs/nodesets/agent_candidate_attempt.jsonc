{
  "type_key": "era.agent.candidate_attempt",
  "display_name": "完成一次模型生成与指令检查",
  "description": "接收本次生成要求及恢复起点，请求模型文字，再由统一消息流程处理其中的变量、函数和作者调用。可重试失败先恢复本次起点，成功或重试结束时交出最终结果，较早阶段成果继续保留。",
  "requires": [
    {
      "type": "era.agent.candidate.state",
      "cardinality": "exactly_one",
      "display_name": "本次生成尝试的请求和恢复起点"
    }
  ],
  "provides": [
    {
      "key": "candidate_state_after",
      "type": "era.agent.candidate.state.next",
      "display_name": "本次尝试后的进度与重试要求"
    },
    {
      "key": "candidate_done",
      "type": "era.agent.candidate.done",
      "display_name": "本次生成尝试循环是否结束"
    },
    {
      "key": "candidate_outcome",
      "type": "era.agent.candidate.outcome",
      "display_name": "生成尝试结束后的完整结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "required": true,
        "display_name": "本次生成尝试的请求和恢复起点"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成一次模型生成与指令检查",
        "description": "标明“完成一次模型生成与指令检查”的开始位置。接收本次生成要求及恢复起点，请求模型文字，再由统一消息流程处理其中的变量、函数和作者调用。可重试失败先恢复本次起点，成功或重试结束时交出最终结果，较早阶段成果继续保留。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "unpack_candidate",
        "display_name": "取出下一次模型生成需要的请求",
        "description": "在“完成一次模型生成与指令检查”流程中，从当前生成尝试的状态中，取出模型请求、原任务和所属批次。下一次模型调用据此继续，确保重试仍属于同一次生成任务。",
        "definition_id": "era.agent.candidate_unpack"
      },
      {
        "id": "execute_agent_phase_v2",
        "display_name": "执行本次规划、正文或结算生成",
        "description": "在“完成一次模型生成与指令检查”流程中，根据当前生成阶段和聊天进度，向模型请求规划或结算内容，或接续酒馆已经生成的正文。把得到的文字、变量指令和函数调用交给消息处理流程；取消、过期请求或失败会带着具体原因返回。",
        "definition_id": "era.agent.execute_session_v2"
      },
      {
        "id": "prepare_stage_blocks",
        "display_name": "准备执行模型文字里的变量和函数指令",
        "description": "在“完成一次模型生成与指令检查”流程中，将模型本次生成的文字整理成按顺序执行的消息内容，并保存尝试失败时要恢复的起点。规划阶段使用预定的 AI 消息位置，其他阶段使用已确认的目标消息，供共享指令流程逐项处理。",
        "definition_id": "era.lifecycle.prepare_stage_blocks"
      },
      {
        "id": "apply_stage_blocks",
        "display_name": "按正文顺序处理本次生成中的指令",
        "description": "接收模型本次返回的文字，从本次尝试起点按顺序处理变量指令、函数和作者调用，逐段累计变量、正文和历史。处理范围结束或失败时交回生成检查，供判断成功、恢复重试或结束。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "当前消息位置及待处理变量指令"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "本段正文处理后的变量和消息进度"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "finish_stage_blocks",
        "display_name": "整理生成文字中指令的执行结果",
        "description": "在“完成一次模型生成与指令检查”流程中，接收本次模型文字里变量及函数指令的执行结果，更新生成阶段的正文和进度。可重试错误会恢复本次尝试前的状态；重试结束仍失败时保留更早阶段的成果，并返回本次失败原因。",
        "definition_id": "era.lifecycle.finish_stage_blocks"
      },
      {
        "id": "finish_candidate",
        "display_name": "判断生成尝试结束还是需要重试",
        "description": "在“完成一次模型生成与指令检查”流程中，检查本次模型输出及指令应用后的结论。有可执行的重试要求时带着现有进度进入下一尝试，否则交出最终成功、取消或失败结果，供生成阶段结算。",
        "definition_id": "era.agent.candidate_finish"
      },
      {
        "id": "end",
        "display_name": "结束完成一次模型生成与指令检查",
        "description": "标明“完成一次模型生成与指令检查”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_candidate"
      ],
      [
        "unpack_candidate",
        "execute_agent_phase_v2"
      ],
      [
        "execute_agent_phase_v2",
        "prepare_stage_blocks"
      ],
      [
        "prepare_stage_blocks",
        "apply_stage_blocks"
      ],
      [
        "apply_stage_blocks",
        "finish_stage_blocks"
      ],
      [
        "finish_stage_blocks",
        "finish_candidate"
      ],
      {
        "from": "start",
        "to": "finish_candidate",
        "transfer": false,
        "schedule": true
      },
      [
        "finish_candidate",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.agent.candidate.state.next",
        "cardinality": "exactly_one",
        "as": "candidate_state_after",
        "display_name": "本次尝试后的进度与重试要求"
      },
      {
        "type": "era.agent.candidate.done",
        "cardinality": "exactly_one",
        "as": "candidate_done",
        "display_name": "本次生成尝试循环是否结束"
      },
      {
        "type": "era.agent.candidate.outcome",
        "cardinality": "exactly_one",
        "as": "candidate_outcome",
        "display_name": "生成尝试结束后的完整结果"
      }
    ]
  }
}
