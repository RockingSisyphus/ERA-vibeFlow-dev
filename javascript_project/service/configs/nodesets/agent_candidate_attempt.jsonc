{
  "type_key": "era.agent.candidate_attempt",
  "display_name": "生成并执行一整次候选",
  "description": "单次模型候选经过有序块执行和恢复判定；不发送阶段完成通知。",
  "requires": [
    {
      "type": "era.agent.candidate.state",
      "cardinality": "exactly_one",
      "display_name": "当前候选状态"
    }
  ],
  "provides": [
    {
      "key": "candidate_state_after",
      "type": "era.agent.candidate.state.next",
      "display_name": "更新后的候选状态"
    },
    {
      "key": "candidate_done",
      "type": "era.agent.candidate.done",
      "display_name": "候选结束标记"
    },
    {
      "key": "candidate_outcome",
      "type": "era.agent.candidate.outcome",
      "display_name": "候选执行结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "required": true,
        "display_name": "候选请求"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试开始",
        "description": "接收本次候选的请求、步骤和批次状态。"
      },
      {
        "id": "unpack_candidate",
        "type_used": "era.agent.candidate_unpack",
        "display_name": "取出候选执行输入",
        "description": "从候选状态取出生成请求、已准备步骤和批次状态，交给本次候选执行。"
      },
      {
        "id": "execute_agent_phase_v2",
        "type_used": "era.agent.execute_session_v2",
        "display_name": "生成标签格式结算候选",
        "description": "读取模型输出中的变量、函数和函数调用标签，形成候选操作；格式错误时按整次候选恢复规则处理。"
      },
      {
        "id": "prepare_stage_blocks",
        "type_used": "era.lifecycle.prepare_stage_blocks",
        "display_name": "标签候选接入共用逐块执行",
        "description": "把模型输出按原位置送入共用块执行流程，依次处理变量操作、函数调用和后续内容，并保留候选恢复点。"
      },
      {
        "id": "apply_stage_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "三阶段复用同一个内存块循环",
        "description": "逐块更新内存工作状态，结束后交还累计消息和变量；保存由后续批次统一处理。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "初始块步进状态"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "块步进后状态"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finish_stage_blocks",
        "type_used": "era.lifecycle.finish_stage_blocks",
        "display_name": "回送已应用阶段状态及草稿",
        "description": "候选结束判定：可纠错失败恢复整个候选及已发布内存、记录、scope、随机和done，旧上下文失效后通过阶段恢复发起下一次尝试；耗尽保留起点，更早阶段保留；成功才进入后续阶段。"
      },
      {
        "id": "finish_candidate",
        "type_used": "era.agent.candidate_finish",
        "display_name": "判断是否重试候选",
        "description": "有重试请求时更新候选状态并继续循环；否则输出本次候选的最终结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试结束",
        "description": "把更新后的候选状态、结束标记和结果交还候选循环。"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_candidate"
      ],
      [
        "unpack_candidate",
        "execute_agent_phase_v2"
      ],
      [
        "execute_agent_phase_v2",
        "prepare_stage_blocks"
      ],
      [
        "prepare_stage_blocks",
        "apply_stage_blocks"
      ],
      [
        "apply_stage_blocks",
        "finish_stage_blocks"
      ],
      [
        "finish_stage_blocks",
        "finish_candidate"
      ],
      {
        "from": "start",
        "to": "finish_candidate",
        "transfer": false,
        "schedule": true
      },
      [
        "finish_candidate",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.agent.candidate.state.next",
        "cardinality": "exactly_one",
        "as": "candidate_state_after",
        "display_name": "候选状态"
      },
      {
        "type": "era.agent.candidate.done",
        "cardinality": "exactly_one",
        "as": "candidate_done",
        "display_name": "候选终态"
      },
      {
        "type": "era.agent.candidate.outcome",
        "cardinality": "exactly_one",
        "as": "candidate_outcome",
        "display_name": "阶段结果"
      }
    ]
  }
}
