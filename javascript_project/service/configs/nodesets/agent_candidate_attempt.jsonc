{
  "type_key": "era.agent.candidate_attempt",
  "display_name": "生成并执行一整次候选",
  "description": "执行一次模型候选，从当前请求获得候选正文，把变量、函数和作者调用按原位置交给共用块循环应用，再检查是否成功。可纠错失败恢复本候选的整体起点并产生重试请求，更早成功阶段保留；无重试时返回终态。这一层不发送阶段完成通知，防止失败候选误触发下一阶段。",
  "requires": [
    {
      "type": "era.agent.candidate.state",
      "cardinality": "exactly_one",
      "display_name": "当前候选状态"
    }
  ],
  "provides": [
    {
      "key": "candidate_state_after",
      "type": "era.agent.candidate.state.next",
      "display_name": "更新后的候选状态"
    },
    {
      "key": "candidate_done",
      "type": "era.agent.candidate.done",
      "display_name": "候选结束标记"
    },
    {
      "key": "candidate_outcome",
      "type": "era.agent.candidate.outcome",
      "display_name": "候选执行结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "required": true,
        "display_name": "候选请求"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试开始",
        "description": "这是“生成并执行一整次候选”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "unpack_candidate",
        "type_used": "era.agent.candidate_unpack",
        "display_name": "取出候选执行输入",
        "description": "从一次候选尝试的状态中取出当前生成请求、所属任务及批次上下文，交给模型执行和共用块处理流程。发生重试时取的是更新后的请求，原事件来源仍保留；这里仅解包，不改变候选恢复点，也不把上一轮结果当作本轮成功。"
      },
      {
        "id": "execute_agent_phase_v2",
        "type_used": "era.agent.execute_session_v2",
        "display_name": "生成标签格式结算候选",
        "description": "根据已确定的生成阶段和请求执行 Agent 会话，包括必要的模型调用，整理其正文及变量、函数和函数调用标签为候选结果。输出尚待应用和验证的候选、阶段状态及诊断；模型给出文本不代表变量已经提交，格式错误或取消会留给阶段执行和候选恢复环节处理。"
      },
      {
        "id": "prepare_stage_blocks",
        "type_used": "era.lifecycle.prepare_stage_blocks",
        "display_name": "标签候选接入共用逐块执行",
        "description": "把模型候选放到本次应处理的消息楼层，建立与普通历史同步相同的逐块执行计划：规划阶段可以使用尚未创建的未来 AI 楼层，其他阶段沿用已捕获身份。记录变量、函数、日志及会话恢复点，供候选失败时撤销本次尝试；这里暂存正文并准备范围，不把候选立即保存。"
      },
      {
        "id": "apply_stage_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "三阶段复用同一个内存块循环",
        "description": "按模型候选的正文顺序循环推进指令块及作者函数调用，携带累计变量、函数、日志、正文、作用域和随机进度，直到候选范围处理完或产生结束结果。每轮只更新内存工作状态，不逐块保存；退出后还需候选整体成功判定或恢复。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "初始块步进状态"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "块步进后状态"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finish_stage_blocks",
        "type_used": "era.lifecycle.finish_stage_blocks",
        "display_name": "回送已应用阶段状态及草稿",
        "description": "检查模型候选的全部块应用结果，并把成功阶段正文和变量进度记入当前会话。可纠错错误需要恢复整次候选的内存变量、正文、日志、作用域和随机进度，再准备下一次尝试；不是只撤销最后一个块。重试耗尽保留本候选起点，更早已完成阶段仍保留。取消也不会无故抹掉早前成功内容。"
      },
      {
        "id": "finish_candidate",
        "type_used": "era.agent.candidate_finish",
        "display_name": "判断是否重试候选",
        "description": "读取候选执行结果是否附有重试请求：有则将该请求放入候选循环状态，标记尚未结束；没有则输出终态结果并结束候选循环。这里只决定是否继续尝试，不再次调用模型，也不发送阶段完成通知；通知必须等候选已达到终态后形成。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "候选尝试结束",
        "description": "这是“生成并执行一整次候选”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_candidate"
      ],
      [
        "unpack_candidate",
        "execute_agent_phase_v2"
      ],
      [
        "execute_agent_phase_v2",
        "prepare_stage_blocks"
      ],
      [
        "prepare_stage_blocks",
        "apply_stage_blocks"
      ],
      [
        "apply_stage_blocks",
        "finish_stage_blocks"
      ],
      [
        "finish_stage_blocks",
        "finish_candidate"
      ],
      {
        "from": "start",
        "to": "finish_candidate",
        "transfer": false,
        "schedule": true
      },
      [
        "finish_candidate",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.agent.candidate.state.next",
        "cardinality": "exactly_one",
        "as": "candidate_state_after",
        "display_name": "候选状态"
      },
      {
        "type": "era.agent.candidate.done",
        "cardinality": "exactly_one",
        "as": "candidate_done",
        "display_name": "候选终态"
      },
      {
        "type": "era.agent.candidate.outcome",
        "cardinality": "exactly_one",
        "as": "candidate_outcome",
        "display_name": "阶段结果"
      }
    ]
  }
}
