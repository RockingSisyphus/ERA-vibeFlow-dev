{
  "type_key": "era.service.collect_phase",
  "display_name": "接收并整理一个酒馆事件",
  "description": "接收一个聊天或 调用接口（API） 事件，检查它的传输格式，并加入待处理事件集合。根据收集期限和容量决定继续等待还是形成批次，同时输出应启动或取消的定时器。结果供服务循环安排后续任务。",
  "requires": [
    {
      "type": "era.service.cycle.routed",
      "cardinality": "exactly_one",
      "display_name": "收集阶段状态"
    }
  ],
  "provides": [
    {
      "key": "collection_reduction",
      "type": "era.collection.reduction",
      "display_name": "事件集归约结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.routed",
        "display_name": "收集阶段状态",
        "required": true
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "收集阶段开始",
        "description": "开始接收并整理一个酒馆事件。"
      },
      {
        "id": "unpack_service_state",
        "type_used": "era.service.cycle.unpack_collect",
        "display_name": "验证服务状态",
        "description": "本次接收和整理一个酒馆事件。从收集阶段状态取出待处理事件、事件序号和定时器资料，供新事件合并判断。"
      },
      {
        "id": "receive_event",
        "type_used": "vibeflow.io",
        "display_name": "接收服务事件",
        "description": "等待并接收酒馆页面队列中的一个事件，例如聊天变化、接口请求或定时器到期。收到后交给输入检查和任务规划；没有事件时保持等待。",
        "requires": [],
        "provides": [
          {
            "key": "transport_event_raw",
            "type": "era.transport.event.raw",
            "display_name": "原始传输事件"
          }
        ],
        "io": {
          "operation": "receive",
          "port": "era.service.in"
        }
      },
      {
        "id": "validate_transport",
        "type_used": "era.service.validate_transport",
        "display_name": "校验传输事件",
        "description": "本次接收和整理一个酒馆事件。检查收到的页面消息结构、大小和宿主引用，输出可处理的事件资料或输入诊断。"
      },
      {
        "id": "reduce_collection",
        "type_used": "era.service.reduce_collection",
        "display_name": "归约有界事件集",
        "description": "本次接收和整理一个酒馆事件。把新事件合入待处理事件，结合事件序号、等待期限和批次容量判断继续等待还是开始执行，输出相应定时器安排。"
      },
      {
        "id": "send_collection_control",
        "type_used": "vibeflow.io",
        "display_name": "发送事件集控制",
        "description": "把本轮决定的定时器安排发送给酒馆页面，要求启动、取消或保留事件收集定时器，供服务按期限形成批次。",
        "requires": [
          {
            "type": "era.collection.control",
            "cardinality": "exactly_one",
            "display_name": "事件集控制"
          }
        ],
        "provides": [],
        "io": {
          "operation": "send",
          "port": "era.service.out"
        }
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "收集阶段结束",
        "description": "结束接收并整理一个酒馆事件，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_service_state"
      ],
      {
        "from": "unpack_service_state",
        "to": "receive_event",
        "transfer": false
      },
      {
        "from": "unpack_service_state",
        "to": "reduce_collection",
        "schedule": false
      },
      [
        "receive_event",
        "validate_transport"
      ],
      [
        "validate_transport",
        "reduce_collection"
      ],
      [
        "reduce_collection",
        "send_collection_control"
      ],
      {
        "from": "send_collection_control",
        "to": "end",
        "transfer": false
      },
      {
        "from": "reduce_collection",
        "to": "end",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.collection.reduction",
        "cardinality": "exactly_one",
        "display_name": "事件集归约结果",
        "as": "collectionReduction"
      }
    ]
  }
}
