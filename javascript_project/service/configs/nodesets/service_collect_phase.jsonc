{
  "type_key": "era.service.collect_phase",
  "display_name": "接收并合并一个聊天或脚本事件",
  "description": "等待聊天变化、脚本请求或到期事件，检查后合入当前收集范围。根据期限和容量决定继续等相关事件还是组批，并交出需要启动或取消的计时要求。",
  "requires": [
    {
      "type": "era.service.cycle.routed",
      "cardinality": "exactly_one",
      "display_name": "已选择阶段的服务状态"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "collection_reduction",
      "type": "era.collection.reduction",
      "display_name": "新事件合并后的等待与组批决定"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.routed",
        "display_name": "已选择阶段的服务状态",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始接收并合并一个聊天或脚本事件",
        "description": "标明“接收并合并一个聊天或脚本事件”的开始位置。等待聊天变化、脚本请求或到期事件，检查后合入当前收集范围。根据期限和容量决定继续等相关事件还是组批，并交出需要启动或取消的计时要求。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "unpack_service_state",
        "display_name": "取出本轮事件收集的进度",
        "description": "在“接收并合并一个聊天或脚本事件”流程中，从服务状态中取出已等待的事件、当前事件序号及定时安排，供下一次事件合并使用。保持同一批收集过程的连续性。",
        "definition_id": "era.service.cycle.unpack_collect",
        "join_policy": "all"
      },
      {
        "id": "receive_event",
        "display_name": "等待并取入下一个聊天事件",
        "description": "在“接收并合并一个聊天或脚本事件”流程中，从页面的先进先出队列接收一条聊天变化、脚本请求或到期事件。没有事件时等待，收到后交给检查和收集流程，为统一任务规划提供输入。",
        "definition_id": "era.service.workflow.receive_event"
      },
      {
        "id": "validate_transport",
        "display_name": "识别合法的原生结束及已有输入事件",
        "description": "按统一输入目录接收原生generation_ended及已有事件，保留真实来源和参数；外部输入的边界校验不改变。源：base_lib/domain/event_catalog.ts及现有传输校验实现。",
        "definition_id": "era.service.validate_transport"
      },
      {
        "id": "reduce_collection",
        "display_name": "合并输入并安排候选完成后的保存任务",
        "description": "原生结束以非阻塞事件进入既有批次，生成开始仍保留原组合窗口与高水位屏障；无待写记录不重复执行作者副作用。源：base_lib/domain/event_planner.ts及现有事件收集归并实现。",
        "definition_id": "era.service.reduce_collection"
      },
      {
        "id": "send_collection_control",
        "display_name": "把事件收集的计时安排交给页面",
        "description": "在“接收并合并一个聊天或脚本事件”流程中，接收本轮收集阶段决定的定时要求，通知页面启动、取消或保留相应计时。到期事件会重新进入服务，帮助等待中的事件按期限组成批次。",
        "definition_id": "era.service.workflow.send_collection_control"
      },
      {
        "id": "end",
        "display_name": "结束接收并合并一个聊天或脚本事件",
        "description": "标明“接收并合并一个聊天或脚本事件”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"unpack_service_state","schedule":true},
      {
        "from": "unpack_service_state",
        "to": "receive_event",
        "transfer": false
      },
      {
        "from": "unpack_service_state",
        "to": "reduce_collection",
        "schedule": false
      },
      [
        "receive_event",
        "validate_transport"
      ],
      [
        "validate_transport",
        "reduce_collection"
      ],
      [
        "reduce_collection",
        "send_collection_control"
      ],
      {
        "from": "send_collection_control",
        "to": "end",
        "transfer": false
      },
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"unpack_service_state","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"receive_event","schedule":false},
      {"from":"retain_host_resources","to":"send_collection_control","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.collection.reduction",
        "cardinality": "exactly_one",
        "display_name": "新事件合并后的等待与组批决定",
        "as": "collectionReduction"
      }
    ]
  }
}
