{
  "type_key": "era.service.collect_phase",
  "display_name": "ERA 事件收集阶段",
  "description": "服务只在没有执行在途批次时从宿主有序事件入口接收一个事件，验证传输格式，再更新收集窗口和定时器。输出整理结果及定时器控制，不执行事件代表的变量或生成任务；等待与执行分支将在外层决定，确保事件接收和批次处理的边界明确。",
  "requires": [
    {
      "type": "era.service.cycle.routed",
      "cardinality": "exactly_one",
      "display_name": "收集阶段状态"
    }
  ],
  "provides": [
    {
      "key": "collection_reduction",
      "type": "era.collection.reduction",
      "display_name": "事件集归约结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.routed",
        "display_name": "收集阶段状态",
        "required": true
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "收集阶段开始",
        "description": "这是“ERA 事件收集阶段”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "unpack_service_state",
        "type_used": "era.service.cycle.unpack_collect",
        "display_name": "验证服务状态",
        "description": "确认当前确实处于收集阶段，然后从循环载体中取出事件集合、序号和定时器等服务状态，供接收和整理新事件使用。它不接收事件、不清空集合；若把执行阶段的状态交到这里，会报错，避免混淆两种阶段的数据。"
      },
      {
        "id": "receive_event",
        "type_used": "vibeflow.io",
        "display_name": "接收服务事件",
        "description": "从宿主连接的 ERA 入站事件队列等待并接收一个事件，可能是聊天变化、API 请求或定时器到期。收到的数据还只是传输输入，下一节点必须验证后才能进入业务规划。此节点不自行执行事件，不并行启动另一批任务；没有事件时等待，而不是轮询聊天变量。",
        "requires": [],
        "provides": [
          {
            "key": "transport_event_raw",
            "type": "era.transport.event.raw",
            "display_name": "原始传输事件"
          }
        ],
        "io": {
          "operation": "receive",
          "port": "era.service.in"
        }
      },
      {
        "id": "validate_transport",
        "type_used": "era.service.validate_transport",
        "display_name": "校验传输事件",
        "description": "检查刚从宿主收到的事件是否符合 ERA 的传输格式，包括必需字段、参数封装、体积限制及允许的宿主引用。合格后输出内部可用的事件；不合格时保留相应错误，不把损坏数据当成正常聊天操作继续规划。这一步只验证事件本身，不执行它代表的业务。"
      },
      {
        "id": "reduce_collection",
        "type_used": "era.service.reduce_collection",
        "display_name": "归约有界事件集",
        "description": "把一个新事件放入当前收集窗口，依据事件序号、窗口期限和容量限制更新待处理集合，决定继续等待还是立即执行一批事件。同步输出应启动或取消的定时器控制。它负责事件何时形成批次，而不是计算变量；事件的业务操作将在批次规划和任务执行中完成。"
      },
      {
        "id": "send_collection_control",
        "type_used": "vibeflow.io",
        "display_name": "发送事件集控制",
        "description": "把事件整理阶段产生的定时器控制送给宿主，要求按本轮决定启动、取消或保持收集窗口相关定时器。它发送的是收集控制，不是任务成功通知，也不会保存变量；先提交控制再选择等待或规划分支，使宿主计时与服务状态一致。",
        "requires": [
          {
            "type": "era.collection.control",
            "cardinality": "exactly_one",
            "display_name": "事件集控制"
          }
        ],
        "provides": [],
        "io": {
          "operation": "send",
          "port": "era.service.out"
        }
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "收集阶段结束",
        "description": "这是“ERA 事件收集阶段”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "unpack_service_state"
      ],
      {
        "from": "unpack_service_state",
        "to": "receive_event",
        "transfer": false
      },
      {
        "from": "unpack_service_state",
        "to": "reduce_collection",
        "schedule": false
      },
      [
        "receive_event",
        "validate_transport"
      ],
      [
        "validate_transport",
        "reduce_collection"
      ],
      [
        "reduce_collection",
        "send_collection_control"
      ],
      {
        "from": "send_collection_control",
        "to": "end",
        "transfer": false
      },
      {
        "from": "reduce_collection",
        "to": "end",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.collection.reduction",
        "cardinality": "exactly_one",
        "display_name": "事件集归约结果",
        "as": "collectionReduction"
      }
    ]
  }
}
