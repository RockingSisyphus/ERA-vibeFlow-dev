{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "message_block_step.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "按当前聊天历史恢复变量并保存",
  "description": "读取聊天消息及独立状态文件，找出历史变化处，撤回旧效果后按正文顺序执行变量指令和作者函数。整理可压缩历史，保存消息及状态文件，确认后刷新显示并返回真实结果。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "本项任务对应原事件的处理结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "当前任务及已读取的聊天资料",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      }
    ],
    "max_steps": 27,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按当前聊天历史恢复变量并保存",
        "description": "标明“按当前聊天历史恢复变量并保存”的开始位置。读取聊天消息及独立状态文件，找出历史变化处，撤回旧效果后按正文顺序执行变量指令和作者函数。整理可压缩历史，保存消息及状态文件，确认后刷新显示并返回真实结果。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "read_sync_context",
        "display_name": "读取历史同步需要的消息与状态资料",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，读取当前聊天历史、处理进度、要求重算的位置及独立状态文件绑定和迁移资料。整理为历史同步的输入，读取失败时返回原因，供后续决定恢复范围。",
        "definition_id": "era.tavern.sync_read"
      },
      {
        "id": "sidecar_store_prepare",
        "display_name": "加载聊天状态或引导用户解决文件问题",
        "description": "本环节用于“按当前聊天历史恢复变量并保存”：检查当前聊天绑定的独立状态文件，其中保存变量、函数和历史；有效内存资料可直接沿用。新聊天按需建文件，旧资料按需迁移，归属冲突或损坏时请用户选择，执行方案后交出可用状态或等待、失败原因。",
        "definition_id": "era.sidecar.store"
      },
      {
        "id": "prepare_block_step",
        "display_name": "恢复需要重算的消息历史起点",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，根据本次聊天变化确定重算范围，撤回相应旧变更记录，带入当前变量、函数、消息身份及随机使用记录。形成按正文顺序重新执行的起点；无需处理或无法准备时交出对应结论。",
        "definition_id": "era.sync.prepare_block_step"
      },
      {
        "id": "process_message_blocks",
        "display_name": "按消息顺序恢复本范围变量和函数",
        "description": "按本次历史范围逐段处理消息指令及作者函数，后段使用前段更新的变量、函数和历史。范围结束或任务失败时返回，后续统一保存消息及独立状态文件。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "当前消息位置及待处理变量指令"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "本段正文处理后的变量和消息进度"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "finalize_block_step",
        "display_name": "整理本批消息和变量的待保存内容",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，将本轮消息指令执行的最终状态整理成保存准备，包含改动的正文和独立状态文件内容。无变化时进入无需保存分支，失败时保留已确认部分及原因，供统一提交判断。",
        "definition_id": "era.lifecycle.finalize_block_step"
      },
      {
        "id": "persist_batch_state",
        "display_name": "保存消息和变量状态并确认结果",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，先保存并确认当前批次的消息正文，再写入独立状态文件并检查版本和聊天绑定。消息来源变化时要求重新计算；部分保存或结果无法确认时保留真实进度及恢复、停止原因。",
        "definition_id": "era.tavern.variables_commit"
      },
      {
        "id": "settle_saved_batch",
        "display_name": "汇总保存结果并决定是否需要恢复",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，合并消息保存与指令执行的真实结论，保留失败原因。消息来源变化时安排重算，没有待保存内容时清除多余定时安排，使后续知道继续、恢复还是停止。",
        "definition_id": "era.lifecycle.settle_saved_batch"
      },
      {
        "id": "present_finalized_floor",
        "display_name": "保存确认后刷新消息显示",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，消息和变量保存已经确认、且目标消息仍匹配时，请页面刷新相关显示；无需提交时沿用已有刷新要求。显示问题单独记录，让调用方区分保存结果与呈现结果。",
        "definition_id": "era.sync.present_finalized_floor"
      },
      {
        "id": "build_sync_notification",
        "display_name": "返回同步保存的实际结果",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，根据消息和独立状态文件的实际保存结论，为原事件生成确认、页面通知及问题说明。明确区分成功、无变化、失败和需要停止服务的情况，并带回最新消息进度。",
        "definition_id": "era.sync.build_notification"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "display_name": "说明状态文件为何需要用户选择",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，状态文件归属冲突或损坏仍未解决时，为原请求形成包含原因的失败确认。页面据此提示用户选择，任务在选择明确前不会继续使用不确定文件。",
        "definition_id": "era.sidecar_binding.build_blocked_result"
      },
      {
        "id": "sidecar_binding_applied_result",
        "display_name": "返回状态文件绑定或修复的结果",
        "description": "在“按当前聊天历史恢复变量并保存”流程中，接收状态文件新建、迁移或修复后的真实结论，匹配原事件，保留本次已经在内存应用的变量提交。将结果交给任务结算，使调用方知道当前可用状态。",
        "definition_id": "era.sidecar_binding.build_applied_result"
      },
      {
        "id": "end",
        "display_name": "结束按当前聊天历史恢复变量并保存",
        "description": "标明“按当前聊天历史恢复变量并保存”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "read_sync_context"
      ],
      [
        "read_sync_context",
        "sidecar_store_prepare"
      ],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_block_step",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      [
        "prepare_block_step",
        "process_message_blocks"
      ],
      [
        "process_message_blocks",
        "finalize_block_step"
      ],
      [
        "present_finalized_floor",
        "build_sync_notification"
      ],
      [
        "build_sync_notification",
        "end"
      ],
      [
        "sidecar_binding_blocked_result",
        "end"
      ],
      [
        "sidecar_binding_applied_result",
        "end"
      ],
      [
        "finalize_block_step",
        "persist_batch_state"
      ],
      [
        "persist_batch_state",
        "settle_saved_batch"
      ],
      [
        "settle_saved_batch",
        "present_finalized_floor"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "本项任务对应原事件的处理结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
