{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "message_block_step.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "ERA 同步任务",
  "description": "接续有效工作状态，逐块处理确定范围，最后批量保存消息及Sidecar；API防抖到期同样进入该提交边界。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 27,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "同步启动",
        "description": "启动一次共享同步任务。"
      },
      {
        "id": "read_sync_context",
        "type_used": "era.tavern.sync_read",
        "display_name": "取得当前聊天工作状态",
        "description": "按聊天身份接续未保存工作；切聊天不覆盖旧dirty批次，返回后核对正文Swipe和Sidecar来源再恢复，失效状态撤销重算；旧候选和迟到请求不能发布到新目标。"
      },
      {
        "id": "sidecar_store_prepare",
        "type_used": "era.sidecar.store",
        "display_name": "接续工作状态或首次绑定Sidecar",
        "description": "有效工作状态存在时直接继续；仅首次加载或恢复时复用Sidecar存储节点集的读取、绑定及迁移分支，不在每个任务重新读取旧文件覆盖dirty状态。"
      },
      {
        "id": "prepare_block_step",
        "type_used": "era.sync.prepare_block_step",
        "display_name": "准备内存回退与本次消息范围",
        "description": "沿用历史定位和回退；保存变量/函数起点、scope和随机偏移。防抖flush只提交指定待保存批次；聊天变更先使旧工作失效，不强写旧文本。"
      },
      {
        "id": "process_message_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "共用循环：内存逐块处理目标范围",
        "description": "max_iterations=null；处理块不落盘，结束时得到累计消息及状态。函数API应用后返回，不强制刷盘。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "初始块步进状态"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "块步进后状态"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finalize_block_step",
        "type_used": "era.lifecycle.finalize_block_step",
        "display_name": "冻结本批消息与Sidecar保存候选",
        "description": "清理已完成消息临时进度；固定本次保存边界，done及对应操作记录在同一消息更新中保存。错误只保存仍有效的成功前缀；后到请求属于后续批次。"
      },
      {
        "id": "persist_batch_state",
        "type_used": "era.tavern.variables_commit",
        "display_name": "批量保存消息 → Sidecar并确认",
        "description": "保持消息与Sidecar保存校验；普通宿主同步在消息已确认落盘但来源变化时，以no-op正常结束且不提交旧Sidecar。保存或回读未确认仍失败；作者API与Agent候选保持原失败边界。"
      },
      {
        "id": "settle_saved_batch",
        "type_used": "era.lifecycle.settle_saved_batch",
        "display_name": "结算已保存批次与恢复事实",
        "description": "来源变化继续交由原重算入口处理，保证最新回复完成同步；保留后到操作，不能把无失败的旧任务结束误报到生成栅栏，也不能覆盖已有块执行错误。"
      },
      {
        "id": "present_finalized_floor",
        "type_used": "era.sync.present_finalized_floor",
        "display_name": "呈现已提交的最终楼层",
        "description": "消息及 Sidecar 提交成功且来源一致时，消费首次呈现意图刷新指定楼层；返回现有呈现诊断，不改变提交结果。"
      },
      {
        "id": "build_sync_notification",
        "type_used": "era.sync.build_notification",
        "display_name": "结算提交结果与批次更新",
        "description": "由 sync_result_policy 根据实际提交与来源结果生成来源回执、诊断和连续处理更新；批次合并仍在原 merge_task_result。"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "type_used": "era.sidecar_binding.build_blocked_result",
        "display_name": "结算等待 Sidecar 选择的任务",
        "description": "读取已判定的 Sidecar 等待结果，复用登记契约及结果策略生成无写入回执。"
      },
      {
        "id": "sidecar_binding_applied_result",
        "type_used": "era.sidecar_binding.build_applied_result",
        "display_name": "结算已完成的 Sidecar 绑定",
        "description": "根据 Sidecar 分支结果生成任务回执；保持原路由条件与行为。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "同步结束",
        "description": "结束一次共享同步任务。"
      }
    ],
    "edges": [
      [
        "start",
        "read_sync_context"
      ],
      [
        "read_sync_context",
        "sidecar_store_prepare"
      ],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_block_step",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      [
        "prepare_block_step",
        "process_message_blocks"
      ],
      [
        "process_message_blocks",
        "finalize_block_step"
      ],
      [
        "present_finalized_floor",
        "build_sync_notification"
      ],
      [
        "build_sync_notification",
        "end"
      ],
      [
        "sidecar_binding_blocked_result",
        "end"
      ],
      [
        "sidecar_binding_applied_result",
        "end"
      ],
      [
        "finalize_block_step",
        "persist_batch_state"
      ],
      [
        "persist_batch_state",
        "settle_saved_batch"
      ],
      [
        "settle_saved_batch",
        "present_finalized_floor"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
