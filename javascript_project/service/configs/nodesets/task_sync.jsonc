{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "expression_engine_bridge.jsonc"
    },
    {
      "path": "command_compaction.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "ERA 同步任务",
  "description": "运行共享同步路径，处理普通协调、full/latest/auto 修复、rollbackTo 定向同步、即时 Commit 重放与同 Scope 封存压缩。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 27,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "同步启动",
        "description": "启动一次共享同步任务。"
      },
      {
        "id": "read_sync_context",
        "type_used": "era.tavern.sync_read",
        "display_name": "读取同步输入与连续处理事实",
        "description": "读取 Sidecar 指针与当前派发输入；在 Node 边界从批次状态投影连续 MK 和计数，后续规划不携带批次来源、通知或队列状态。"
      },
      {
        "id": "sidecar_store_prepare",
        "type_used": "era.sidecar.store",
        "display_name": "运行 Sidecar 状态存储前置事务",
        "description": "调用专用 Sidecar 状态节点集：检查身份与唯一聊天指针，读取或迁移 V2 用户文件状态，并规划冲突选择或继续同步。"
      },
      {
        "id": "prepare_expression_command_request",
        "type_used": "era.sync.prepare_expression_command_request",
        "display_name": "准备同步规划请求",
        "description": "将已加载 Sidecar 的同步输入投影为规划所需消息、状态、派发事实和连续计数；不再透传整个上下文。调用登记 sync_planning 模块。"
      },
      {
        "id": "execute_expression_commands",
        "type_used": "era.expression.execute_era_commands",
        "display_name": "计算含表达式的同步计划",
        "description": "经现有同步规划库重放消息和指令；完整表达式求值实际调用版本化 Expression AOT，输出纯同步工作项。"
      },
      {
        "id": "apply_command_compaction",
        "type_used": "era.command_compaction.apply_sealed_layers",
        "display_name": "按同 Scope 压缩封存事务",
        "description": "Service 选择封存楼层，调用 Compaction 同步 AOT；作用域分段由 Compaction 负责，Service 执行 CRUD 重放确认并回填计划。"
      },
      {
        "id": "assemble_expression_sync_plan",
        "type_used": "era.sync.assemble_expression_plan",
        "display_name": "选择同步提交分支",
        "description": "消费已完成表达式计算和压缩的工作项，选择无提交、CRUD 结果适配或协调结果适配；不再次运行同步算法。"
      },
      {
        "id": "no_sync_change",
        "type_used": "era.sync.no_change",
        "display_name": "结算无需提交的同步结果",
        "description": "由 sync_result_policy 把无变化或失败工作项映射为来源回执与批次更新。空聊天清空状态按规划结果进入原提交分支。"
      },
      {
        "id": "crud_write",
        "type_used": "era.task.crud_write",
        "display_name": "适配已计算的 CRUD 结果",
        "description": "保留纯规划阶段已经应用的 CRUD 工作项，适配到共享提交契约；此处不重新执行指令或写入宿主。"
      },
      {
        "id": "compute_reconciliation",
        "type_used": "era.sync.compute",
        "display_name": "适配已计算的协调结果",
        "description": "把已有普通/full/latest/auto/rollbackTo 规划结果交给共享提交候选构造；不重复计算。"
      },
      {
        "id": "build_commit_request",
        "type_used": "era.sync.build_commit",
        "display_name": "构造消息与 Sidecar 提交候选",
        "description": "由 sync_commit_policy 从同步工作项构造消息写入、状态、来源依据和首次呈现意图；不执行宿主写入。"
      },
      {
        "id": "validate_commit_candidate",
        "type_used": "era.sync.validate_commit_candidate",
        "display_name": "检查提交候选契约",
        "description": "调用 sync_commit_policy 的原提交检查，输出有效提交请求或可结算的契约失败；保持现有判断及错误代码。"
      },
      {
        "id": "build_sync_contract_failure",
        "type_used": "era.sync.build_contract_failure",
        "display_name": "结算未提交的契约失败",
        "description": "由 sync_result_policy 根据原步骤来源生成失败回执；不执行写入。"
      },
      {
        "id": "commit_variables",
        "type_used": "era.tavern.variables_commit",
        "display_name": "提交消息与 Sidecar 并确认读回",
        "description": "保持原唯一提交顺序和 Capability 调用；sync_commit_policy 负责候选、来源依据和读回判定。记录消息写入数、Sidecar 状态与来源变化，交给结果模块结算。"
      },
      {
        "id": "present_finalized_floor",
        "type_used": "era.sync.present_finalized_floor",
        "display_name": "呈现已提交的最终楼层",
        "description": "消息及 Sidecar 提交成功且来源一致时，消费首次呈现意图刷新指定楼层；返回现有呈现诊断，不改变提交结果。"
      },
      {
        "id": "build_sync_notification",
        "type_used": "era.sync.build_notification",
        "display_name": "结算提交结果与批次更新",
        "description": "由 sync_result_policy 根据实际提交与来源结果生成来源回执、诊断和连续处理更新；批次合并仍在原 merge_task_result。"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "type_used": "era.sidecar_binding.build_blocked_result",
        "display_name": "结算等待 Sidecar 选择的任务",
        "description": "读取已判定的 Sidecar 等待结果，复用登记契约及结果策略生成无写入回执。"
      },
      {
        "id": "sidecar_binding_applied_result",
        "type_used": "era.sidecar_binding.build_applied_result",
        "display_name": "结算已完成的 Sidecar 绑定",
        "description": "根据 Sidecar 分支结果生成任务回执；保持原路由条件与行为。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "同步结束",
        "description": "结束一次共享同步任务。"
      }
    ],
    "edges": [
      [
        "start",
        "read_sync_context"
      ],
      [
        "read_sync_context",
        "sidecar_store_prepare"
      ],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_expression_command_request",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "no_sync_change",
        "when": "sync_route == 'no-op'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "crud_write",
        "when": "sync_route == 'crud'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "compute_reconciliation",
        "when": "sync_route == 'reconcile'"
      },
      [
        "prepare_expression_command_request",
        "execute_expression_commands"
      ],
      [
        "execute_expression_commands",
        "apply_command_compaction"
      ],
      [
        "apply_command_compaction",
        "assemble_expression_sync_plan"
      ],
      [
        "no_sync_change",
        "build_commit_request"
      ],
      [
        "crud_write",
        "build_commit_request"
      ],
      [
        "compute_reconciliation",
        "build_commit_request"
      ],
      [
        "build_commit_request",
        "validate_commit_candidate"
      ],
      {
        "from": "validate_commit_candidate",
        "to": "commit_variables",
        "when": "commit_validation_route == 'valid'"
      },
      {
        "from": "validate_commit_candidate",
        "to": "build_sync_contract_failure",
        "when": "commit_validation_route == 'failed'"
      },
      [
        "commit_variables",
        "present_finalized_floor"
      ],
      [
        "present_finalized_floor",
        "build_sync_notification"
      ],
      [
        "build_sync_notification",
        "end"
      ],
      [
        "build_sync_contract_failure",
        "end"
      ],
      [
        "sidecar_binding_blocked_result",
        "end"
      ],
      [
        "sidecar_binding_applied_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
