{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "message_block_step.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "ERA 同步任务",
  "description": "把当前聊天的真实消息历史与 ERA 变量、函数和日志保持一致：读取并校验状态文件绑定，优先沿用有效未保存的内存状态，规划回退及处理范围，逐块应用指令和函数，必要时压缩封存文本，最后批量保存消息及状态文件。保存后再刷新显示和返回结果；切换聊天或候选回复不会使旧任务覆盖新目标。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 27,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "同步启动",
        "description": "这是“ERA 同步任务”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "read_sync_context",
        "type_used": "era.tavern.sync_read",
        "display_name": "取得当前聊天工作状态",
        "description": "接收已准备消息上下文的同步任务，提取批次中的连续处理进度和块级续做位置，再读取当前聊天的状态文件指针及可供旧数据迁移的事实。这里不直接把旧文件覆盖到内存；后续状态加载节点会核对身份并优先使用有效工作状态。读取失败或取消会形成失败上下文。"
      },
      {
        "id": "sidecar_store_prepare",
        "type_used": "era.sidecar.store",
        "display_name": "接续工作状态或首次绑定Sidecar",
        "description": "加载当前聊天的 Sidecar，即独立保存 ERA 变量、函数和历史日志的状态文件。核对聊天指针及文件归属，优先沿用有效内存工作状态；需要时处理创建、旧数据迁移、绑定冲突或修复选择，再按来源校验执行。聊天中只保留文件指针，加载或写入确认后提供快照；来源变化和失败不会被当作成功绑定。"
      },
      {
        "id": "prepare_block_step",
        "type_used": "era.sync.prepare_block_step",
        "display_name": "准备内存回退与本次消息范围",
        "description": "以当前变量、函数和历史日志为起点，规划本次应回退哪些旧效果、从哪条消息继续，以及要处理哪些指令块。保存消息标识、作用域和随机位置作为后续依据。这个节点仅建立逐块处理状态，不提前执行块；无法处理或无需变更时把状态标为结束，让后续如实结算。"
      },
      {
        "id": "process_message_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "共用循环：内存逐块处理目标范围",
        "description": "按规划范围逐块处理消息中的变量、函数和作者调用，后一块读取前一块更新后的内存状态，并携带正文、日志、作用域及随机进度。结束标志控制退出，没有人为固定的块数上限；最终消息和状态文件统一在任务尾部保存，不每轮刷盘。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "初始块步进状态"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "块步进后状态"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finalize_block_step",
        "type_used": "era.lifecycle.finalize_block_step",
        "display_name": "冻结本批消息与Sidecar保存候选",
        "description": "逐块处理结束后，一次性固定本次待保存的消息修改和变量状态，使完成标记与操作记录在同一次消息更新中保存。若中途失败，只保留仍可确认的成功前缀，失败本身继续带到结算；无需提交则输出无写入结果。这里构造并校验保存请求，不执行磁盘写入。"
      },
      {
        "id": "persist_batch_state",
        "type_used": "era.tavern.variables_commit",
        "display_name": "批量保存消息 → Sidecar并确认",
        "description": "执行共享同步的保存边界：先批量更新并确认目标消息，随后写 Sidecar 状态文件、回读核对版本，再更新聊天绑定的快照。仅内存写入或未确认保存不能当作成功。若普通历史同步的原目标已改变，停止旧分支并交还重算；API 和模型候选保持明确失败。文件失败保留已确认的消息事实并提示修复，写入结果未知则报告致命状态。"
      },
      {
        "id": "settle_saved_batch",
        "type_used": "era.lifecycle.settle_saved_batch",
        "display_name": "结算已保存批次与恢复事实",
        "description": "核对保存结果与之前块执行的结论：即使成功保存了前缀，也不能抹掉后续块的失败。检测到用户改动了原消息来源时，通过现有入口安排重新计算当前历史；保存成功且没有后续未保存操作时取消多余保存定时器。输出最终结论，避免旧任务收尾漏掉最新回复或覆盖后到操作。"
      },
      {
        "id": "present_finalized_floor",
        "type_used": "era.sync.present_finalized_floor",
        "display_name": "呈现已提交的最终楼层",
        "description": "在本次工作项带有首次显示意图时，要求酒馆刷新指定消息，使已完成内容和状态栏显示出来。保存分支只在消息与状态文件确认成功、来源仍一致时刷新；无提交分支按其已有显示意图处理。刷新失败只附加显示诊断，不撤销已经保存的业务结果，也不再次执行变量指令。"
      },
      {
        "id": "build_sync_notification",
        "type_used": "era.sync.build_notification",
        "display_name": "结算提交结果与批次更新",
        "description": "把同步的实际保存结果整理成原事件回执、业务通知及诊断，并计算后续可接续的消息处理进度。它区分成功、无需变更、普通失败和致命失败，也保留显示环节的诊断；不再次保存或重算变量。统一步骤合并随后会把这些结果记入本批次。"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "type_used": "era.sidecar_binding.build_blocked_result",
        "display_name": "结算等待 Sidecar 选择的任务",
        "description": "当状态文件冲突或修复问题还在等待用户处理时，为原同步任务构造无写入的结果，保留等待原因及每个事件的回执。不会把“暂时不能继续”当成变量已同步，也不会擅自创建新绑定；这是状态选择分支与 Service 批次结算之间的出口。"
      },
      {
        "id": "sidecar_binding_applied_result",
        "type_used": "era.sidecar_binding.build_applied_result",
        "display_name": "结算已完成的 Sidecar 绑定",
        "description": "状态文件修复已通过独立文件事务完成时，向本任务每个来源返回已完成结算，并标记无需再做普通同步。这里不重算历史或再次保存，避免把修复后仅存在于当前变量状态的 API 修改按旧聊天正文重放掉。此出口只表示修复分支无需额外动作，不能代替所有历史同步的结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "同步结束",
        "description": "这是“ERA 同步任务”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "read_sync_context"
      ],
      [
        "read_sync_context",
        "sidecar_store_prepare"
      ],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_block_step",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      [
        "prepare_block_step",
        "process_message_blocks"
      ],
      [
        "process_message_blocks",
        "finalize_block_step"
      ],
      [
        "present_finalized_floor",
        "build_sync_notification"
      ],
      [
        "build_sync_notification",
        "end"
      ],
      [
        "sidecar_binding_blocked_result",
        "end"
      ],
      [
        "sidecar_binding_applied_result",
        "end"
      ],
      [
        "finalize_block_step",
        "persist_batch_state"
      ],
      [
        "persist_batch_state",
        "settle_saved_batch"
      ],
      [
        "settle_saved_batch",
        "present_finalized_floor"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
