{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "message_block_step.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "按聊天历史更新变量并保存",
  "description": "使聊天中的变量和函数与当前消息历史一致。读取并核对状态文件及当前内存结果，找出历史变更处，撤销旧效果后按正文顺序重算；处理指令和作者函数，准备历史压缩，最后保存消息和独立状态文件，再刷新显示并返回结果。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 27,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "同步启动",
        "description": "开始按聊天历史更新变量并保存。"
      },
      {
        "id": "read_sync_context",
        "type_used": "era.tavern.sync_read",
        "display_name": "取得当前聊天工作状态",
        "description": "本次处理聊天历史与变量结果的同步。读取历史同步需要的消息历史、处理进度、重新执行位置及独立状态文件绑定、迁移资料，输出任务上下文或读取失败原因。"
      },
      {
        "id": "sidecar_store_prepare",
        "type_used": "era.sidecar.store",
        "display_name": "加载或修复聊天的独立状态文件",
        "description": "本次处理聊天历史与变量结果的同步。加载当前聊天使用的独立状态文件，文件中保存 ERA 变量、函数和历史日志。优先沿用同一聊天有效的内存结果；首次使用时建立绑定，旧数据需要时迁移，归属冲突或损坏时提示用户选择。执行选定的绑定方案后输出可用于历史同步的状态或等待、失败结果。"
      },
      {
        "id": "prepare_block_step",
        "type_used": "era.sync.prepare_block_step",
        "display_name": "准备内存回退与本次消息范围",
        "description": "本次处理聊天历史与变量结果的同步。建立消息历史重新执行的起点：撤回需要重算的旧日志，确定消息范围，并带入当前变量、函数、消息历史标识、允许执行范围及随机使用记录。无需处理或准备失败时返回对应结论。"
      },
      {
        "id": "process_message_blocks",
        "type_used": "vibeflow.loop.while",
        "display_name": "依次处理目标范围的聊天正文",
        "description": "按规划的聊天历史范围反复处理正文指令和作者函数，后一段读取前一段更新后的变量、函数和日志。范围处理完成或任务失败时退出，再由同步任务统一提交消息及独立状态文件。",
        "requires": [
          {
            "type": "era.sync.block.step.state",
            "cardinality": "exactly_one",
            "display_name": "开始处理的消息范围、变量、函数和日志"
          }
        ],
        "provides": [
          {
            "key": "block_step_state_after",
            "type": "era.sync.block.step.state.next",
            "display_name": "处理后的消息位置、变量、函数和日志"
          }
        ],
        "loop": {
          "body": "era.sync.block_step",
          "max_iterations": null,
          "stop_when": {
            "from": "block_step_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.sync.block.step.state",
              "as": "block_step_state",
              "update": "block_step_state_after"
            }
          ],
          "outputs": [
            {
              "from": "block_step_state_after",
              "as": "block_step_state_after"
            }
          ]
        }
      },
      {
        "id": "finalize_block_step",
        "type_used": "era.lifecycle.finalize_block_step",
        "display_name": "冻结本批消息与独立状态文件保存候选",
        "description": "本次处理聊天历史与变量结果的同步。把消息命令执行的最终状态整理为待提交批次，包含正文变更和独立状态文件候选。失败时保留已确认的成功部分，无变化时选择无需提交分支。"
      },
      {
        "id": "persist_batch_state",
        "type_used": "era.tavern.variables_commit",
        "display_name": "批量保存消息 → 独立状态文件并确认",
        "description": "本次处理聊天历史与变量结果的同步。先提交并确认消息正文批次，再写入独立状态文件、核对文件版本并更新绑定结果。普通历史的消息来源变化时请求重算；部分写入、文件失败或无法确认的写入分别保留实际进度及恢复、停止原因。"
      },
      {
        "id": "settle_saved_batch",
        "type_used": "era.lifecycle.settle_saved_batch",
        "display_name": "结算已保存批次与恢复事实",
        "description": "本次处理聊天历史与变量结果的同步。汇总保存结果与命令执行结果，保留执行失败的原因。消息来源变化时安排重新计算，待保存内容为空时清除多余保存定时器。"
      },
      {
        "id": "present_finalized_floor",
        "type_used": "era.sync.present_finalized_floor",
        "display_name": "呈现已提交的最终楼层",
        "description": "本次处理聊天历史与变量结果的同步。在保存已确认且消息来源仍匹配时请求页面刷新显示；无需提交的分支沿用已有刷新要求。显示失败记录为附加诊断，保存结果保持其实际状态。"
      },
      {
        "id": "build_sync_notification",
        "type_used": "era.sync.build_notification",
        "display_name": "结算提交结果与批次更新",
        "description": "本次处理聊天历史与变量结果的同步。根据保存的实际结果生成原事件回执、页面通知、诊断和消息处理进度，区分成功、无变化、失败及需要停止服务的情况。"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "type_used": "era.sidecar_binding.build_blocked_result",
        "display_name": "结算等待 独立状态文件 选择的任务",
        "description": "本次处理聊天历史与变量结果的同步。状态文件归属或损坏问题仍需用户选择时，为原事件生成包含选择原因的失败回执，供页面提示和任务结算。"
      },
      {
        "id": "sidecar_binding_applied_result",
        "type_used": "era.sidecar_binding.build_applied_result",
        "display_name": "结算已完成的 独立状态文件 绑定",
        "description": "本次处理聊天历史与变量结果的同步。把状态文件绑定或修复的实际完成结果对应到原事件，保留已在内存中应用的 调用接口（API） 修改，形成本次任务结算结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "同步结束",
        "description": "结束按聊天历史更新变量并保存，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "read_sync_context"
      ],
      [
        "read_sync_context",
        "sidecar_store_prepare"
      ],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_block_step",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      [
        "prepare_block_step",
        "process_message_blocks"
      ],
      [
        "process_message_blocks",
        "finalize_block_step"
      ],
      [
        "present_finalized_floor",
        "build_sync_notification"
      ],
      [
        "build_sync_notification",
        "end"
      ],
      [
        "sidecar_binding_blocked_result",
        "end"
      ],
      [
        "sidecar_binding_applied_result",
        "end"
      ],
      [
        "finalize_block_step",
        "persist_batch_state"
      ],
      [
        "persist_batch_state",
        "settle_saved_batch"
      ],
      [
        "settle_saved_batch",
        "present_finalized_floor"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
