{
  "nodeset_imports": [
    {
      "path": "sidecar_store.jsonc"
    },
    {
      "path": "expression_engine_bridge.jsonc"
    },
    {
      "path": "command_compaction.jsonc"
    }
  ],
  "type_key": "era.task.sync",
  "display_name": "ERA 同步任务",
  "description": "运行共享同步路径，处理普通协调、full/latest/auto 修复、rollbackTo 定向同步、即时 Commit 重放与同 Scope 封存压缩。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "sync_task_result",
      "type": "era.task.result",
      "display_name": "同步结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 26,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "同步启动",
        "description": "启动一次共享同步任务。"
      },
      {
        "id": "read_sync_context",
        "type_used": "era.tavern.sync_read",
        "display_name": "读取 Tavern 同步上下文",
        "description": "消费已准备步骤内的 EraDispatchContextV2，并仅补读变量和编辑日志；消息快照与不可变 processing message/MK 必须来自严格派发上下文。"
      },
      {
        "id": "sidecar_store_prepare",
        "type_used": "era.sidecar.store",
        "display_name": "运行 Sidecar 状态存储前置事务",
        "description": "调用专用 Sidecar 状态节点集：检查身份与唯一聊天指针，读取或迁移 V2 用户文件状态，并规划冲突选择或继续同步。"
      },
      {
        "id": "prepare_expression_command_request",
        "type_used": "era.sync.prepare_expression_command_request",
        "display_name": "整理表达式命令与双快照",
        "description": "在既有 Sidecar V3 上下文中整理同步 DTO，并保留 full/latest/rollback/Swipe 的既有同步范围；它不重新实现解析、函数调用图或数学求值。"
      },
      {
        "id": "execute_expression_commands",
        "type_used": "era.expression.execute_era_commands",
        "display_name": "调用函数表达式 Nodeset",
        "description": "调用独立 expression root 的已实现 Nodeset 执行变量与函数命令，并在既有按消息顺序的函数 CRUD 事务内实施可解锁 $meta 保护。数学语义、函数嵌套、递归拒绝与 @path/@function 快照由该 root 提供；Service 只保留顺序同步、Sidecar 状态和封存楼层压缩编排。"
      },
      {
        "id": "apply_command_compaction",
        "type_used": "era.command_compaction.apply_sealed_layers",
        "display_name": "按同 Scope 压缩封存事务",
        "description": "把同步重放产生的封存候选按 era_tx scope 划分相邻段，再交给独立命令压缩 root；跨 scope、正文与无法证明语义都是硬边界。"
      },
      {
        "id": "assemble_expression_sync_plan",
        "type_used": "era.sync.assemble_expression_plan",
        "display_name": "组装表达式同步计划",
        "description": "把 expression root 的纯结果映射回既有 no-op、CRUD 或历史协调工作项，携带 statFunc 和函数编辑日志；外层原有路由、事务和通知边界保持不变。"
      },
      {
        "id": "no_sync_change",
        "type_used": "era.sync.no_change",
        "display_name": "保留已同步状态",
        "description": "保留精确的当前状态和通知身份，并构造无操作逻辑结果。"
      },
      {
        "id": "crud_write",
        "type_used": "era.task.crud_write",
        "display_name": "应用 CRUD 指令",
        "description": "确认纯引擎已经应用插入、更新或删除指令，并保留逻辑提交候选。"
      },
      {
        "id": "compute_reconciliation",
        "type_used": "era.sync.compute",
        "display_name": "计算协调结果",
        "description": "以纯计算方式生成普通、full、latest、auto 或 rollbackTo 的状态与编辑日志变更，不写入宿主。"
      },
      {
        "id": "build_commit_request",
        "type_used": "era.sync.build_commit",
        "display_name": "构造 Sidecar V3 逻辑提交",
        "description": "构造既有消息先行、状态后置的提交请求，纳入 statData、eraMeta、statFunc、变量/函数编辑日志；无操作与既有连续状态语义保持不变。"
      },
      {
        "id": "validate_commit_candidate",
        "type_used": "era.sync.validate_commit_candidate",
        "display_name": "校验同步提交候选",
        "description": "在任何消息或变量 Capability 写入前校验 processing MK、公开 payload、连续状态和 TaskResult 候选合同，阻止空 MK 或无效状态越过提交边界。"
      },
      {
        "id": "build_sync_contract_failure",
        "type_used": "era.sync.build_contract_failure",
        "display_name": "构造同步提交合同失败",
        "description": "在未执行 Capability 写入时把无效提交候选转换为普通 failed 结果；API 已先写消息的场景由外层 finalizer 统一升级 fatal。"
      },
      {
        "id": "commit_variables",
        "type_used": "era.tavern.variables_commit",
        "display_name": "提交 Sidecar V3 状态",
        "description": "沿用消息先确认、文件后提交与回读的事务顺序，提交 V3 用户文件并在成功后发布当前身份的易失宏快照；聊天变量仍只保留 ERAMetaData.SidecarId，文件失败不回退为聊天状态。"
      },
      {
        "id": "build_sync_notification",
        "type_used": "era.sync.build_notification",
        "display_name": "构造同步结算结果",
        "description": "仅在提交确认后构造来源结算、状态与诊断；运行时快照已由 Sidecar 成功提交原子发布，公共对象订阅据此更新。"
      },
      {
        "id": "sidecar_binding_blocked_result",
        "type_used": "era.sidecar_binding.build_blocked_result",
        "display_name": "构造 Sidecar 选择等待结果",
        "description": "仅在专用 Sidecar Nodeset 已确认冲突且等待用户选择时，构造无写入的正常结算结果。"
      },
      {
        "id": "sidecar_binding_applied_result",
        "type_used": "era.sidecar_binding.build_applied_result",
        "display_name": "构造已完成 Sidecar 修复结果",
        "description": "保留给未来纯绑定 no-op 修复；当前 Sidecar repair 会进入完整重放，确保已确认的聊天指令重新生成文件状态。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "同步结束",
        "description": "结束一次共享同步任务。"
      }
    ],
      "edges": [
      ["start", "read_sync_context"],
      ["read_sync_context", "sidecar_store_prepare"],
      {
        "from": "sidecar_store_prepare",
        "to": "prepare_expression_command_request",
        "when": "sidecar_binding_route == 'continue'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_blocked_result",
        "when": "sidecar_binding_route == 'blocked'"
      },
      {
        "from": "sidecar_store_prepare",
        "to": "sidecar_binding_applied_result",
        "when": "sidecar_binding_route == 'applied'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "no_sync_change",
        "when": "sync_route == 'no-op'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "crud_write",
        "when": "sync_route == 'crud'"
      },
      {
        "from": "assemble_expression_sync_plan",
        "to": "compute_reconciliation",
        "when": "sync_route == 'reconcile'"
      },
      ["prepare_expression_command_request", "execute_expression_commands"],
      ["execute_expression_commands", "apply_command_compaction"],
      ["apply_command_compaction", "assemble_expression_sync_plan"],
      ["no_sync_change", "build_commit_request"],
      ["crud_write", "build_commit_request"],
      ["compute_reconciliation", "build_commit_request"],
      ["build_commit_request", "validate_commit_candidate"],
      {
        "from": "validate_commit_candidate",
        "to": "commit_variables",
        "when": "commit_validation_route == 'valid'"
      },
      {
        "from": "validate_commit_candidate",
        "to": "build_sync_contract_failure",
        "when": "commit_validation_route == 'failed'"
      },
      ["commit_variables", "build_sync_notification"],
      ["build_sync_notification", "end"],
      ["build_sync_contract_failure", "end"],
      ["sidecar_binding_blocked_result", "end"],
      ["sidecar_binding_applied_result", "end"]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "syncTaskResult"
      }
    ]
  }
}
