{
  "type_key": "era.task.prepare",
  "display_name": "为当前任务选路并备齐执行资料",
  "description": "接收批次当前任务，读取必要聊天资料，再按种类准备初始化、脚本提交、生成、历史同步或简单任务。交出明确执行请求，并保留原事件和处理确认所需资料。",
  "requires": [
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    }
  ],
  "provides": [
    {
      "key": "prepared_task",
      "type": "era.task.prepared",
      "display_name": "已备齐的执行请求或直接返回结论"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "batch",
        "type": "era.batch.execution.state",
        "required": true,
        "display_name": "当前批次的任务进度与累计结果"
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始为当前任务选路并备齐执行资料",
        "description": "标明“为当前任务选路并备齐执行资料”的开始位置。接收批次当前任务，读取必要聊天资料，再按种类准备初始化、脚本提交、生成、历史同步或简单任务。交出明确执行请求，并保留原事件和处理确认所需资料。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "prepare_dispatch_context",
        "display_name": "为当前任务读取聊天并准备消息身份",
        "description": "本环节用于“为当前任务选路并备齐执行资料”：先判断任务需要哪些资料，再读取当前消息、回复和状态绑定，准备关联变量历史的消息标识及显示占位。普通同步暂存正文变化，单独标识任务按需保存；最后交出可执行任务或读取失败原因。",
        "definition_id": "era.dispatch.prepare_context"
      },
      {
        "id": "route_task_entry",
        "display_name": "按任务种类选择准备流程",
        "description": "在“为当前任务选路并备齐执行资料”流程中，接收批次当前任务，判断它属于初始化、脚本接口、多阶段生成、历史同步还是简单任务。选择对应准备入口，让每种任务只读取并整理它真正需要的资料。",
        "definition_id": "era.task.route_entry"
      },
      {
        "id": "task_initialize",
        "display_name": "准备角色 ERA 资源并接续历史同步",
        "description": "本环节用于“为当前任务选路并备齐执行资料”：读取现有设置、世界书、正则和开场白，比较后依次安装或更新所需资源。启动资源就绪时继续历史同步，其他资源操作或失败则直接形成任务结果，保留实际完成进度。",
        "definition_id": "era.task.initialize"
      },
      {
        "id": "task_api",
        "display_name": "准备脚本或界面的变量提交和历史同步",
        "description": "本环节用于“为当前任务选路并备齐执行资料”：读取本次接口请求，变量提交进入草稿比较和操作准备，历史同步先检查重算方式及目标范围。有效请求交给对应执行流程，无效请求带原因直接返回，并保留原请求用于回告。",
        "definition_id": "era.task.api"
      },
      {
        "id": "task_agent_generation_session",
        "display_name": "选择生成阶段并准备可靠起点",
        "description": "本环节用于“为当前任务选路并备齐执行资料”：读取当前生成配置、聊天和会话进度，区分规划、正文与结算。重试或替换阶段时先按保留历史恢复变量起点，再整理模型请求；输出可执行生成或明确的过期、取消、失败结论。",
        "definition_id": "era.agent.generation_session"
      },
      {
        "id": "prepare_plain_sync",
        "display_name": "准备统一的聊天历史同步请求",
        "description": "在“为当前任务选路并备齐执行资料”流程中，接收普通历史同步任务，带入所属批次和已经读取的聊天资料，交给共享同步流程。保留原事件，使重算、保存和结果返回属于同一次请求。",
        "definition_id": "era.task.prepare_plain_sync"
      },
      {
        "id": "prepare_simple_task",
        "display_name": "准备标识、生成设置或忽略任务",
        "description": "在“为当前任务选路并备齐执行资料”流程中，接收消息标识、生成设置或无需处理的事件任务，整理已读取的资料并交给简单任务入口。后续按任务种类执行操作并返回处理确认。",
        "definition_id": "era.task.prepare_simple"
      },
      {
        "id": "end",
        "display_name": "结束为当前任务选路并备齐执行资料",
        "description": "标明“为当前任务选路并备齐执行资料”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "prepare_dispatch_context"
      ],
      [
        "prepare_dispatch_context",
        "route_task_entry"
      ],
      {
        "from": "route_task_entry",
        "to": "task_initialize",
        "when": "route_entry_entry_route == 'initialize'"
      },
      {
        "from": "route_task_entry",
        "to": "task_api",
        "when": "route_entry_entry_route == 'api'"
      },
      {
        "from": "route_task_entry",
        "to": "task_agent_generation_session",
        "when": "route_entry_entry_route == 'agent'"
      },
      {
        "from": "route_task_entry",
        "to": "prepare_plain_sync",
        "when": "route_entry_entry_route == 'sync'"
      },
      {
        "from": "route_task_entry",
        "to": "prepare_simple_task",
        "when": "route_entry_entry_route == 'simple'"
      },
      [
        "task_initialize",
        "end"
      ],
      [
        "task_api",
        "end"
      ],
      [
        "task_agent_generation_session",
        "end"
      ],
      [
        "prepare_plain_sync",
        "end"
      ],
      [
        "prepare_simple_task",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "as": "prepared_task",
        "display_name": "已备齐的执行请求或直接返回结论"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "dispatch_prepare_context.jsonc"
    },
    {
      "path": "task_initialize.jsonc"
    },
    {
      "path": "task_api.jsonc"
    },
    {
      "path": "agent_generation_session.jsonc"
    }
  ]
}
