{
  "type_key": "era.agent.generation_session",
  "display_name": "选择生成阶段并准备可靠起点",
  "description": "读取当前生成配置、聊天和会话进度，区分规划、正文与结算。重试或替换阶段时先按保留历史恢复变量起点，再整理模型请求；输出可执行生成或明确的过期、取消、失败结论。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "执行后回告所需的原任务资料"
    }
  ],
  "provides": [
    {
      "key": "era_agent_generation_session_prepared_task",
      "type": "era.task.prepared",
      "display_name": "已备齐的执行请求或直接返回结论"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.step.request.routed",
        "display_name": "当前任务及已读取的聊天资料",
        "required": true
      },
      {
        "key": "input_1",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "执行后回告所需的原任务资料",
        "required": true
      }
    ],
    "max_steps": 15,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始选择生成阶段并准备可靠起点",
        "description": "标明“选择生成阶段并准备可靠起点”的开始位置。读取当前生成配置、聊天和会话进度，区分规划、正文与结算。重试或替换阶段时先按保留历史恢复变量起点，再整理模型请求；输出可执行生成或明确的过期、取消、失败结论。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "carry_candidate_inputs",
        "display_name": "保留生成尝试对应的原请求",
        "description": "在“选择生成阶段并准备可靠起点”流程中，取出原生成任务、所属批次和事件来源，交给生成起点准备。后续模型结果和失败重试都可以准确回到这次请求。",
        "definition_id": "era.task.carry_candidate_inputs"
      },
      {
        "id": "prepare_auxiliary_execution_request",
        "display_name": "准备生成资料并按需还原变量起点",
        "description": "本环节用于“选择生成阶段并准备可靠起点”：读取当前正文、配置和生成进度，判断重试仍否有效，以及哪些较早阶段应保留。需要重建时按只读历史流程重算变量，成功后交出下一阶段起点，失败时保留原因。",
        "definition_id": "era.agent.prepare_generation_facts"
      },
      {
        "id": "classify_generation_event",
        "display_name": "判断这次应执行哪个生成阶段",
        "description": "在“选择生成阶段并准备可靠起点”流程中，接收首次生成、继续、重试或页面恢复请求，结合当前聊天和消息版本，判断应进入规划、正文还是结算阶段。请求已过期时记录原因，供外层返回而不处理旧生成。",
        "definition_id": "era.agent.classify_generation_event"
      },
      {
        "id": "prepare_generation_phase",
        "display_name": "组装当前生成阶段需要的完整资料",
        "description": "在“选择生成阶段并准备可靠起点”流程中，根据已确定的规划、正文或结算阶段，整理模型设置、消息历史、变量起点和会话进度。资料无效时返回具体原因，有效时交给模型生成尝试。",
        "definition_id": "era.agent.prepare_generation_phase"
      },
      {
        "id": "seed_candidate",
        "display_name": "准备本次生成尝试及失败恢复起点",
        "description": "在“选择生成阶段并准备可靠起点”流程中，接收即将执行的模型生成请求，记住原任务、所属批次和本次允许保留的历史。替换旧阶段时先恢复较早阶段已经完成的变量与函数；恢复失败就返回原因，避免在错误起点上继续生成。",
        "definition_id": "era.agent.candidate_seed"
      },
      {
        "id": "prepare_candidate_continuation",
        "display_name": "把准备好的生成请求交给尝试循环",
        "description": "在“选择生成阶段并准备可靠起点”流程中，接收已确认起点的生成请求，连同原任务和所属批次交给生成循环。循环据此请求模型、执行文字中的指令，并在允许时重试，结果仍能对应原发起者。",
        "definition_id": "era.agent.prepare_candidate_continuation"
      },
      {
        "id": "end",
        "display_name": "结束选择生成阶段并准备可靠起点",
        "description": "标明“选择生成阶段并准备可靠起点”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "carry_candidate_inputs"
      ],
      [
        "start",
        "prepare_auxiliary_execution_request"
      ],
      [
        "prepare_auxiliary_execution_request",
        "classify_generation_event"
      ],
      [
        "classify_generation_event",
        "prepare_generation_phase"
      ],
      [
        "prepare_generation_phase",
        "seed_candidate"
      ],
      [
        "seed_candidate",
        "prepare_candidate_continuation"
      ],
      [
        "prepare_candidate_continuation",
        "end"
      ],
      {
        "from": "carry_candidate_inputs",
        "to": "seed_candidate",
        "schedule": false
      },
      {
        "from": "carry_candidate_inputs",
        "to": "prepare_candidate_continuation",
        "schedule": true
      }
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "已备齐的执行请求或直接返回结论",
        "as": "era_agent_generation_session_prepared_task"
      }
    ]
  }
}
