{
  "type_key": "era.agent.generation_session",
  "display_name": "选择生成阶段并准备模型请求",
  "description": "为一次多阶段生成准备请求。读取配置、消息历史和当前会话，判断应执行规划、正文还是结算阶段；重试或替换旧阶段时先恢复应保留的历史起点，再建立候选初始状态。输出待生成请求及原任务资料，供候选循环执行。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "原任务、触发事件与已读取消息"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次、任务列表与执行位置"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "原任务、事件来源、批次和回执资料"
    }
  ],
  "provides": [
    {
      "key": "era_agent_generation_session_prepared_task",
      "type": "era.task.prepared",
      "display_name": "待执行请求及原任务资料"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.step.request.routed",
        "display_name": "原任务、触发事件与已读取消息",
        "required": true
      },
      {
        "key": "input_1",
        "type": "era.batch.execution.state",
        "display_name": "当前批次、任务列表与执行位置",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源、批次和回执资料",
        "required": true
      }
    ],
    "max_steps": 15,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "多阶段生成 准备开始",
        "description": "开始选择生成阶段并准备模型请求。"
      },
      {
        "id": "carry_candidate_inputs",
        "type_used": "era.task.carry_candidate_inputs",
        "display_name": "保留候选准备的原步骤与批次",
        "description": "本次准备规划、正文或结算阶段的生成请求。取出原生成任务、批次和事件来源，交给生成候选起点准备流程。"
      },
      {
        "id": "prepare_auxiliary_execution_request",
        "type_used": "era.agent.prepare_auxiliary_execution_request",
        "display_name": "读取阶段工作状态与当前来源",
        "description": "本次准备规划、正文或结算阶段的生成请求。读取生成配置、当前会话和变量，为下一阶段建立模型请求。优先使用尚未保存的当前正文；重新生成、切换回复或手动重试时恢复对应阶段的历史起点，保留较早阶段成果。"
      },
      {
        "id": "classify_generation_event",
        "type_used": "era.agent.classify_generation_event",
        "display_name": "判定事件与阶段",
        "description": "本次准备规划、正文或结算阶段的生成请求。根据首次生成、继续、手动重试或页面恢复事件，选择规划、正文或结算阶段。结合聊天和消息版本判断恢复请求是否仍适用，并记录选择结果或过期原因。"
      },
      {
        "id": "prepare_generation_phase",
        "type_used": "era.agent.prepare_generation_phase",
        "display_name": "准备阶段请求",
        "description": "本次准备规划、正文或结算阶段的生成请求。根据已选定的规划、正文或结算阶段，组装模型设置、消息历史、变量起点和会话资料。请求无效时返回具体原因。"
      },
      {
        "id": "seed_candidate",
        "type_used": "era.agent.candidate_seed",
        "display_name": "建立候选请求",
        "description": "本次准备规划、正文或结算阶段的生成请求。建立一次生成候选的起始状态，保存原请求和批次。替换旧阶段时，先把应保留的较早阶段变量、函数和会话结果恢复到内存；准备失败时返回失败结果。"
      },
      {
        "id": "prepare_candidate_continuation",
        "type_used": "era.agent.prepare_candidate_continuation",
        "display_name": "返回候选状态与原生成任务",
        "description": "本次准备规划、正文或结算阶段的生成请求。将已建立起点的候选请求、原任务和批次交给候选循环，供模型生成及命令应用。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "多阶段生成 准备结束",
        "description": "结束选择生成阶段并准备模型请求，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "carry_candidate_inputs"
      ],
      [
        "start",
        "prepare_auxiliary_execution_request"
      ],
      [
        "prepare_auxiliary_execution_request",
        "classify_generation_event"
      ],
      [
        "classify_generation_event",
        "prepare_generation_phase"
      ],
      [
        "prepare_generation_phase",
        "seed_candidate"
      ],
      [
        "seed_candidate",
        "prepare_candidate_continuation"
      ],
      [
        "prepare_candidate_continuation",
        "end"
      ],
      {
        "from": "carry_candidate_inputs",
        "to": "seed_candidate",
        "schedule": false
      },
      {
        "from": "carry_candidate_inputs",
        "to": "prepare_candidate_continuation",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "待执行请求及原任务资料",
        "as": "era_agent_generation_session_prepared_task"
      }
    ]
  }
}
