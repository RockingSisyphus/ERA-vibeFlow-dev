{
  "type_key": "era.agent.generation_session",
  "display_name": "ERA 三阶段故事生成会话",
  "description": "只处理生成生命周期、规划、正文衔接、结算与重试。先判定阶段，再准备必要请求、执行阶段、形成会话转换，复用原唯一同步边界。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "Agent 包装步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次状态"
    }
  ],
  "provides": [
    {
      "key": "agent_task_result",
      "type": "era.task.result",
      "display_name": "生成会话任务结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "Agent 包装步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次状态",
        "required": true
      }
    ],
    "max_steps": 20,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "生成会话开始",
        "description": "进入一个 FIFO 内的生成阶段。"
      },
      {
        "id": "prepare_auxiliary_execution_request",
        "type_used": "era.agent.prepare_auxiliary_execution_request",
        "display_name": "读取生成事实",
        "description": "读取生成事实及恢复时最新已提交状态；恢复事件沿原派发入口读取会话，不复用等待前的变量快照。"
      },
      {
        "id": "classify_generation_event",
        "type_used": "era.agent.classify_generation_event",
        "display_name": "判定事件与阶段",
        "description": "判定正常生成、手动重试及内部阶段恢复；核对 executionId、completionId 和当前聊天/Swipe 来源，过期恢复终止。"
      },
      {
        "id": "prepare_generation_phase",
        "type_used": "era.agent.prepare_generation_phase",
        "display_name": "准备阶段请求",
        "description": "准备单阶段请求；恢复后按阶段读取最新变量、消息和必要最终成果，不从过程报告重建业务请求。"
      },
      {
        "id": "execute_agent_phase_v2",
        "type_used": "era.agent.execute_session_v2",
        "display_name": "执行生成阶段",
        "description": "每次只执行至一个成功阶段边界：规划及函数完成、正文完成、变量操作有效但未执行；返回最终成果和待恢复会话。消息仅组合最终规划、正文及有效事务，不写历次报告。"
      },
      {
        "id": "prepare_stage_handoff",
        "type_used": "era.agent.prepare_stage_handoff",
        "display_name": "形成阶段交接与恢复凭据",
        "description": "纯业务策略为成功阶段构造唯一 completionId、最终结果及恢复意图；不在 FIFO 中等待回调。无交接时保留原阶段结果。页面等待结束后必须经原 Service 派发链核对并恢复。"
      },
      {
        "id": "form_session_transition",
        "type_used": "era.agent.form_session_transition",
        "display_name": "形成会话转换",
        "description": "将阶段交接结果转为原任务结果或最终候选；待回调阶段不提交 AI 变量候选，恢复提交仍交给 legacy_sync。"
      },
      {
        "id": "route_agent_transition",
        "type_used": "era.agent.route_transition",
        "display_name": "路由阶段结果",
        "description": "决定直接结算还是恢复原任务。"
      },
      {
        "id": "adapt_legacy_step",
        "type_used": "era.agent.adapt_legacy_step",
        "display_name": "把最终楼层候选交给唯一同步事务",
        "description": "把默认模式或 Agent 最终楼层候选恢复为原 sync/update-mk 路由；故事完成、结算成功、结算耗尽和 UI 手动重试都携带同一个楼层 MK 进入同步，不存在第二条消息提交路径。"
      },
      {
        "id": "legacy_sync",
        "type_used": "era.task.sync",
        "display_name": "复用原同步任务",
        "description": "故事组合后或默认模式下执行既有 Sidecar、表达式、压缩和历史同步。"
      },
      {
        "id": "legacy_update_mk",
        "type_used": "era.task.update_mk",
        "display_name": "复用原 MK 任务",
        "description": "规划注入后保持既有 message_sent MK 语义。"
      },
      {
        "id": "build_direct_result",
        "type_used": "era.agent.build_result",
        "display_name": "构造直接结果",
        "description": "输出阶段交接标识和后置通知，使当前 FIFO 片段完成；通知后页面按序等待订阅回调，再提交内部恢复事件。片段 receipt 不代表整次生成已完成。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "生成会话结束",
        "description": "返回单一任务结果。"
      }
    ],
    "edges": [
      [
        "start",
        "prepare_auxiliary_execution_request"
      ],
      [
        "prepare_auxiliary_execution_request",
        "classify_generation_event"
      ],
      [
        "classify_generation_event",
        "prepare_generation_phase"
      ],
      [
        "prepare_generation_phase",
        "execute_agent_phase_v2"
      ],
      [
        "execute_agent_phase_v2",
        "prepare_stage_handoff"
      ],
      [
        "prepare_stage_handoff",
        "form_session_transition"
      ],
      {
        "from": "start",
        "to": "form_session_transition",
        "transfer": false,
        "schedule": true
      },
      [
        "form_session_transition",
        "route_agent_transition"
      ],
      {
        "from": "route_agent_transition",
        "to": "adapt_legacy_step",
        "when": "agent_route == 'legacy'"
      },
      {
        "from": "route_agent_transition",
        "to": "build_direct_result",
        "when": "agent_route == 'direct'"
      },
      {
        "from": "adapt_legacy_step",
        "to": "legacy_sync",
        "when": "legacy_task_route == 'sync'"
      },
      {
        "from": "adapt_legacy_step",
        "to": "legacy_update_mk",
        "when": "legacy_task_route == 'update-mk'"
      },
      [
        "legacy_sync",
        "end"
      ],
      [
        "legacy_update_mk",
        "end"
      ],
      [
        "build_direct_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "生成会话任务结果",
        "as": "agentTaskResult"
      }
    ]
  }
}
