{
  "type_key": "era.api.prepare_workbench_commit",
  "display_name": "把工作台草稿转换成安全的提交清单",
  "description": "接收变量或函数编辑草稿，读取当前数据，确认它仍对应原聊天和编辑前的值，比较差异并处理用户的保护选择。输出有序操作，或说明需要重载、修改输入或重新选择的原因。",
  "requires": [
    {
      "type": "era.api.commit.inspected",
      "cardinality": "exactly_one",
      "display_name": "已识别内容和消息范围的提交请求"
    }
  ],
  "provides": [
    {
      "key": "prepared_commit_inspected",
      "type": "era.api.commit.inspected",
      "display_name": "已识别内容和消息范围的提交请求"
    },
    {
      "key": "preparation_route",
      "type": "era.workbench.preparation_route",
      "display_name": "草稿可继续提交还是需要返回问题"
    },
    {
      "key": "preparation_failure",
      "type": "era.api.commit.failure_context",
      "display_name": "本次提交不能执行的原因及原请求"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "inspected",
        "type": "era.api.commit.inspected",
        "required": true,
        "display_name": "已识别内容和消息范围的提交请求"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始把工作台草稿转换成安全的提交清单",
        "description": "标明“把工作台草稿转换成安全的提交清单”的开始位置。接收变量或函数编辑草稿，读取当前数据，确认它仍对应原聊天和编辑前的值，比较差异并处理用户的保护选择。输出有序操作，或说明需要重载、修改输入或重新选择的原因。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "read_baseline",
        "display_name": "读取编辑草稿要对照的当前数据",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，读取当前聊天所绑定的独立状态文件，以及可用的内存变量和函数。把这份当前数据交给草稿检查和差异比较，确保编辑建立在真实现状上。",
        "definition_id": "era.workbench.read_baseline"
      },
      {
        "id": "validate_draft_basis",
        "display_name": "确认编辑草稿仍对应当前聊天数据",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，核对草稿所属聊天、状态文件及编辑前的值。单项编辑比较目标项，整库编辑比较整份数据，新增项检查是否仍未存在；资料已经变化或输入无效时要求重新读取或修改，避免覆盖他人的新改动。",
        "definition_id": "era.workbench.validate_draft_basis"
      },
      {
        "id": "plan_variables",
        "display_name": "把变量编辑草稿转换为增删改操作",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，比较当前变量与用户期望值，列出有顺序的新增、删除和公式修改。对象类型或模板发生变化时安排先移除再建立，并标出差异位置，供保护处理和正式提交使用。",
        "definition_id": "era.workbench.plan_variables"
      },
      {
        "id": "plan_functions",
        "display_name": "把函数编辑草稿转换为增删改操作",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，比较现有自定义函数和用户编辑稿，按顺序列出新增、修改和删除。保留原定义及类型资料，供后续检查完整函数库并应用用户的编辑。",
        "definition_id": "era.workbench.plan_functions"
      },
      {
        "id": "normalize_ordered",
        "display_name": "检查已有操作清单并保留顺序",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，接收明确列出的变量或函数操作，检查种类及格式，保留原先先后顺序。有效列表交给后续提交检查，格式问题则带着具体原因返回。",
        "definition_id": "era.workbench.normalize_ordered"
      },
      {
        "id": "apply_protection_choice",
        "display_name": "按用户选择安排受保护变量的修改",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，根据实际变量差异，判断哪些内容受保护、是否已有有效的解锁选择。允许修改时依次安排解锁、变更及恢复保护；不可修改或选择过期时给出原因，供提交许可检查使用。",
        "definition_id": "era.workbench.apply_protection_choice"
      },
      {
        "id": "reject_draft",
        "display_name": "向用户说明草稿为何不能提交",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，接收编辑草稿的检查问题，将其整理为接口可返回的失败结果。说明当前资料需要重新读取，还是用户输入需要修改，使界面能够解释本次未提交的原因。",
        "definition_id": "era.workbench.reject_draft"
      },
      {
        "id": "publish_preparation",
        "display_name": "交出草稿转换后的提交操作",
        "description": "在“把工作台草稿转换成安全的提交清单”流程中，草稿比较成功时，将得到的有序操作、目标聊天资料和提交方式交给统一许可检查。准备失败时传出具体问题及原请求，供接口返回给用户。",
        "definition_id": "era.workbench.publish_preparation"
      },
      {
        "id": "end",
        "display_name": "结束把工作台草稿转换成安全的提交清单",
        "description": "标明“把工作台草稿转换成安全的提交清单”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "read_baseline"
      ],
      [
        "read_baseline",
        "validate_draft_basis"
      ],
      {
        "from": "validate_draft_basis",
        "to": "plan_variables",
        "when": "draft_kind == 'variable'"
      },
      {
        "from": "validate_draft_basis",
        "to": "plan_functions",
        "when": "draft_kind == 'function'"
      },
      {
        "from": "validate_draft_basis",
        "to": "normalize_ordered",
        "when": "draft_kind == 'ordered'"
      },
      {
        "from": "validate_draft_basis",
        "to": "reject_draft",
        "when": "draft_kind == 'failed'"
      },
      [
        "plan_variables",
        "apply_protection_choice"
      ],
      [
        "plan_functions",
        "apply_protection_choice"
      ],
      [
        "normalize_ordered",
        "apply_protection_choice"
      ],
      [
        "apply_protection_choice",
        "publish_preparation"
      ],
      [
        "reject_draft",
        "publish_preparation"
      ],
      [
        "publish_preparation",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已识别内容和消息范围的提交请求",
        "as": "prepared_commit_inspected"
      },
      {
        "type": "era.workbench.preparation_route",
        "cardinality": "exactly_one",
        "display_name": "草稿可继续提交还是需要返回问题",
        "as": "preparation_route"
      },
      {
        "type": "era.api.commit.failure_context",
        "cardinality": "exactly_one",
        "display_name": "本次提交不能执行的原因及原请求",
        "as": "preparation_failure"
      }
    ]
  }
}
