{
  "type_key": "era.api.prepare_workbench_commit",
  "display_name": "把编辑草稿转换为提交操作",
  "description": "把变量或函数工作台的编辑草稿转成公共接口可执行的操作。读取当前数据，检查草稿是否仍对应原聊天和原值，计算差异，再按用户的选择处理保护规则。输出有序提交请求或要求重新加载、补充选择的失败原因。",
  "requires": [
    {
      "type": "era.api.commit.inspected",
      "cardinality": "exactly_one",
      "display_name": "已读取的提交请求"
    }
  ],
  "provides": [
    {
      "key": "prepared_commit_inspected",
      "type": "era.api.commit.inspected",
      "display_name": "已读取的提交请求"
    },
    {
      "key": "preparation_route",
      "type": "era.workbench.preparation_route",
      "display_name": "工作台准备分支"
    },
    {
      "key": "preparation_failure",
      "type": "era.api.commit.failure_context",
      "display_name": "提交失败上下文"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "inspected",
        "type": "era.api.commit.inspected",
        "required": true,
        "display_name": "变量提交窗口事实"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "开始工作台准备",
        "description": "开始把编辑草稿转换为提交操作。"
      },
      {
        "id": "read_baseline",
        "type_used": "era.workbench.read_baseline",
        "display_name": "读取当前独立状态文件基准",
        "description": "本次把用户编辑草稿转换为变量或函数操作。读取当前聊天的状态文件绑定及可用的内存变量、函数，作为用户草稿比较和变更规划的依据。"
      },
      {
        "id": "validate_draft_basis",
        "type_used": "era.workbench.validate_draft_basis",
        "display_name": "校验编辑基准并区分变量和函数",
        "description": "本次把用户编辑草稿转换为变量或函数操作。核对草稿的聊天、文件绑定和原始值是否仍与当前资料一致。单项编辑检查目标项，整库编辑检查全部值；新增项确认目标尚不存在。资料已变化或请求格式无效时返回重新读取或修改提示。"
      },
      {
        "id": "plan_variables",
        "type_used": "era.workbench.plan_variables",
        "display_name": "计算变量草稿增删改",
        "description": "本次把用户编辑草稿转换为变量或函数操作。比较当前变量与用户期望值，生成有序的新增、删除和表达式操作。对象类型或模板改变时安排先删除再新增，并标出具体差异位置。"
      },
      {
        "id": "plan_functions",
        "type_used": "era.workbench.plan_functions",
        "display_name": "计算函数库增删改",
        "description": "本次把用户编辑草稿转换为变量或函数操作。比较当前函数与用户草稿，生成有序的新增、修改和删除操作，保留旧定义与类型，供后续表达式检查及提交。"
      },
      {
        "id": "normalize_ordered",
        "type_used": "era.workbench.normalize_ordered",
        "display_name": "校验显式有序操作",
        "description": "本次把用户编辑草稿转换为变量或函数操作。检查有序变量操作的类型和格式，保留原操作顺序，输出可提交的列表或输入错误。"
      },
      {
        "id": "apply_protection_choice",
        "type_used": "era.workbench.apply_protection_choice",
        "display_name": "按实际变更处理保护并生成提交参数",
        "description": "本次把用户编辑草稿转换为变量或函数操作。根据当前变量及草稿中的保护设置，判断修改是否需要用户解锁。有效选择按解锁、操作、恢复保护的顺序形成提交列表；不可修改或选择已过期时说明原因。"
      },
      {
        "id": "reject_draft",
        "type_used": "era.workbench.reject_draft",
        "display_name": "返回基准或输入失败",
        "description": "本次把用户编辑草稿转换为变量或函数操作。把草稿检查问题转换为公共 调用接口（API） 失败结果，说明需要重新读取或修改的原因。"
      },
      {
        "id": "publish_preparation",
        "type_used": "era.workbench.publish_preparation",
        "display_name": "接回现有变量提交准入或失败分支",
        "description": "本次把用户编辑草稿转换为变量或函数操作。把草稿准备成功后的操作、上下文和提交方式交给 调用接口（API） 许可判断；失败时交出具体问题及原请求资料。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "结束工作台提交准备",
        "description": "在已准备提交候选或拒绝结果发布后结束本段流程。只标记出口，不修改变量、消息或保存内容。"
      }
    ],
    "edges": [
      [
        "start",
        "read_baseline"
      ],
      [
        "read_baseline",
        "validate_draft_basis"
      ],
      {
        "from": "validate_draft_basis",
        "to": "plan_variables",
        "when": "draft_kind == 'variable'"
      },
      {
        "from": "validate_draft_basis",
        "to": "plan_functions",
        "when": "draft_kind == 'function'"
      },
      {
        "from": "validate_draft_basis",
        "to": "normalize_ordered",
        "when": "draft_kind == 'ordered'"
      },
      {
        "from": "validate_draft_basis",
        "to": "reject_draft",
        "when": "draft_kind == 'failed'"
      },
      [
        "plan_variables",
        "apply_protection_choice"
      ],
      [
        "plan_functions",
        "apply_protection_choice"
      ],
      [
        "normalize_ordered",
        "apply_protection_choice"
      ],
      [
        "apply_protection_choice",
        "publish_preparation"
      ],
      [
        "reject_draft",
        "publish_preparation"
      ],
      [
        "publish_preparation",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已读取的提交请求",
        "as": "prepared_commit_inspected"
      },
      {
        "type": "era.workbench.preparation_route",
        "cardinality": "exactly_one",
        "display_name": "工作台准备分支",
        "as": "preparation_route"
      },
      {
        "type": "era.api.commit.failure_context",
        "cardinality": "exactly_one",
        "display_name": "提交失败上下文",
        "as": "preparation_failure"
      }
    ]
  }
}
