{
  "type_key": "era.sync.block_step",
  "display_name": "处理聊天消息中的一段 ERA 内容",
  "description": "处理当前消息的一步工作：识别正文指令、作者函数调用、生成阶段调用或消息结束，完成对应动作，整理变更日志与消息进度，再压缩已完成历史并返回下一步状态。外层消息循环按正文顺序重复本流程。",
  "requires": [
    {
      "type": "era.sync.block.step.state",
      "cardinality": "exactly_one",
      "display_name": "当前消息位置、变量、函数和日志"
    }
  ],
  "provides": [
    {
      "key": "block_step_state_after",
      "type": "era.sync.block.step.state.next",
      "display_name": "处理后的消息位置、变量、函数和日志"
    },
    {
      "key": "block_step_done",
      "type": "era.step.done",
      "display_name": "消息范围是否已处理结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "当前消息位置、变量、函数和日志",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "消息块位置开始",
        "description": "开始处理聊天消息中的一段 ERA 内容。"
      },
      {
        "id": "choose_message_action",
        "type_used": "era.sync.choose_message_action",
        "display_name": "识别当前位置要处理的消息内容",
        "description": "读取当前消息和正文位置，准备这条消息的历史起点，识别变量指令、作者函数调用、生成阶段调用或消息结束。无法处理的消息推进到下一条；正在运行的作者函数交给作者调用流程。"
      },
      {
        "id": "author_function_step",
        "type_used": "era.sync.author_function_step",
        "display_name": "启动或接续正文中的作者函数",
        "description": "本次推进聊天正文中一段 ERA 内容的处理。处理消息正文中的作者 JavaScript 函数一次运行动作：启动、等待请求、确认已应用的操作，或结束调用。有效变量提交在原调用位置插入待执行事务，交回消息循环应用，再返回确认。函数异常和不支持的请求保留具体原因，正常结束后继续后面的正文。"
      },
      {
        "id": "prepare_operations",
        "type_used": "era.sync.prepare_message_operations",
        "display_name": "准备正文指令或生成阶段调用",
        "description": "把正文中的变量指令或生成阶段函数调用整理为有序操作列表，附上当前变量、函数、历史起点和随机进度，供操作循环逐项处理。"
      },
      {
        "id": "operation_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "依次执行当前指令中的全部操作",
        "description": "按正文指令的字段顺序反复处理变量和函数操作，嵌套对象先完成当前子对象。生成阶段函数清单也按原顺序逐项计算；每项使用前一项更新后的值，整段操作完成后输出变量、函数、日志、诊断和随机进度。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志"
          }
        ],
        "provides": [
          {
            "key": "operation_result",
            "type": "era.command.operation.result",
            "display_name": "当前操作范围完整结果"
          }
        ],
        "loop": {
          "body": "era.command.operation_step",
          "max_iterations": null,
          "stop_when": {
            "from": "operation_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.command.operation.state",
              "as": "operation_state",
              "update": "operation_state_after"
            }
          ],
          "outputs": [
            {
              "from": "operation_state_after",
              "as": "operation_result"
            }
          ]
        }
      },
      {
        "id": "accept_operations",
        "type_used": "era.sync.accept_message_operations",
        "display_name": "接收操作结果，继续处理消息",
        "description": "把操作循环产生的变量、函数、日志和诊断合入当前消息。正文指令标记为已完成并推进正文位置；生成阶段调用形成阶段结果，交回消息处理。"
      },
      {
        "id": "install_author_frame",
        "type_used": "era.sync.install_author_frame",
        "display_name": "记录作者函数的调用位置和进度",
        "description": "本次推进聊天正文中一段 ERA 内容的处理。遇到尚未执行的作者 JavaScript 函数调用时，记录它所在的消息、正文位置和插入操作数量，并在调用后放置临时定位标记。下一轮依据这些记录启动函数；函数提交的操作将接在这个位置处理。"
      },
      {
        "id": "skip_call",
        "type_used": "era.sync.skip_message_call",
        "display_name": "记录跳过的函数调用并继续正文",
        "description": "当正文中的函数调用按现有规则跳过时，保留跳过原因，标记该调用已处理，并移动到下一个正文片段。"
      },
      {
        "id": "finish_message",
        "type_used": "era.sync.finish_message",
        "display_name": "完成本条消息，准备历史压缩",
        "description": "整理本条消息的变量和函数变更日志，更新正文处理标记，准备可压缩的已完成历史，然后推进到下一条消息。"
      },
      {
        "id": "finish_message_step",
        "type_used": "era.sync.finish_message_step",
        "display_name": "整理这一步的消息进度和变更结果",
        "description": "根据刚完成的正文指令、作者调用或消息结束动作更新处理进度，整理变量、函数、正文、日志和诊断，供历史压缩和下一轮消息处理使用。"
      },
      {
        "id": "apply_command_compaction",
        "type_used": "era.command_compaction.apply_sealed_layers_flat",
        "display_name": "Service 封存压缩组合",
        "description": "本次推进聊天正文中一段 ERA 内容的处理。压缩已完成历史消息中的 ERA 命令文本。先生成压缩候选，再通过 Service 重放确认变量、函数和随机使用结果一致；确认成功后采用候选及标记，否则保留原文。"
      },
      {
        "id": "publish_block_application",
        "type_used": "era.lifecycle.publish_block_application",
        "display_name": "发布内存应用结果与推进位置",
        "description": "本次推进聊天正文中一段 ERA 内容的处理。发布消息命令执行后的内存变量、日志、执行范围及待保存正文。普通历史同步遇到旧回复已变化时重新计算当前分支；作者调用产生的 调用接口（API） 候选失败时保留失败结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "消息块位置结束",
        "description": "结束处理聊天消息中的一段 ERA 内容，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "choose_message_action"
      ],
      {
        "from": "choose_message_action",
        "to": "author_function_step",
        "when": "message_action == 'author'"
      },
      {
        "from": "choose_message_action",
        "to": "prepare_operations",
        "when": "message_action == 'operations'"
      },
      {
        "from": "choose_message_action",
        "to": "install_author_frame",
        "when": "message_action == 'author-call'"
      },
      {
        "from": "choose_message_action",
        "to": "skip_call",
        "when": "message_action == 'skip'"
      },
      {
        "from": "choose_message_action",
        "to": "finish_message",
        "when": "message_action == 'message-end'"
      },
      {
        "from": "choose_message_action",
        "to": "finish_message_step",
        "when": "message_action == 'complete'"
      },
      [
        "prepare_operations",
        "operation_loop"
      ],
      {
        "from": "prepare_operations",
        "to": "accept_operations",
        "schedule": false
      },
      [
        "operation_loop",
        "accept_operations"
      ],
      [
        "author_function_step",
        "finish_message_step"
      ],
      [
        "accept_operations",
        "finish_message_step"
      ],
      [
        "install_author_frame",
        "finish_message_step"
      ],
      [
        "skip_call",
        "finish_message_step"
      ],
      [
        "finish_message",
        "finish_message_step"
      ],
      [
        "finish_message_step",
        "apply_command_compaction"
      ],
      [
        "apply_command_compaction",
        "publish_block_application"
      ],
      [
        "publish_block_application",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "处理后的消息位置、变量、函数和日志",
        "as": "block_step_state_after"
      },
      {
        "type": "era.step.done",
        "cardinality": "exactly_one",
        "display_name": "消息范围是否已处理结束",
        "as": "block_step_done"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "command_operation_step.jsonc"
    },
    {
      "path": "author_function_step.jsonc"
    }
  ]
}
