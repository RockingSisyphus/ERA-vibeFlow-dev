{
  "type_key": "era.sync.block_step",
  "display_name": "ERA 块步进单次迭代",
  "description": "共用内存块执行；累计消息、变量、函数、scope和日志，不在每块中执行聊天/Sidecar保存。",
  "requires": [
    {
      "type": "era.sync.block.step.state",
      "cardinality": "exactly_one",
      "display_name": "块步进状态"
    }
  ],
  "provides": [
    {
      "key": "block_step_state_after",
      "type": "era.sync.block.step.state.next",
      "display_name": "块步进后状态"
    },
    {
      "key": "block_step_done",
      "type": "era.step.done",
      "display_name": "本次块驱动结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "块步进状态",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "块迭代开始",
        "description": "进入单块推进边界。"
      },
      {
        "id": "advance_message_block",
        "type_used": "era.sync.drive_message_blocks",
        "display_name": "共用块执行：指令、函数及位置API",
        "description": "共用块执行处理阶段有序项，在当前位置验证操作；函数scope和记录沿用普通路径。函数上下文所有sync均明确拒绝；候选内错误上报候选控制，普通作者异常保留前缀标done。"
      },
      {
        "id": "prepare_block_work",
        "type_used": "era.sync.prepare_block_work",
        "display_name": "累计操作记录及封存候选",
        "description": "收集本轮消息补丁和累计日志；楼层完成时清内存进度并提供封存压缩候选，不构造每块持久化事务。"
      },
      {
        "id": "apply_command_compaction",
        "type_used": "era.command_compaction.apply_sealed_layers_flat",
        "display_name": "Service 封存压缩组合",
        "description": "在原位置依次识别、调用 Compaction AOT、以 Service CRUD 复放、回填并更新 marker；不新增宿主写入。"
      },
      {
        "id": "publish_block_application",
        "type_used": "era.lifecycle.publish_block_application",
        "display_name": "发布内存应用结果与推进位置",
        "description": "发布内存应用结果与推进位置；普通酒馆历史同步若在提交前发现目标 Swipe 已变化且没有写入，将旧分支作为可恢复空操作结算并安排当前历史重算。函数/API、已写入及其他错误保持失败。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "块迭代结束",
        "description": "返回下一个块步进状态与是否结束本次块驱动。"
      }
    ],
    "edges": [
      [
        "start",
        "advance_message_block"
      ],
      [
        "advance_message_block",
        "prepare_block_work"
      ],
      [
        "prepare_block_work",
        "apply_command_compaction"
      ],
      [
        "apply_command_compaction",
        "publish_block_application"
      ],
      [
        "publish_block_application",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块步进后状态",
        "as": "block_step_state_after"
      },
      {
        "type": "era.step.done",
        "cardinality": "exactly_one",
        "display_name": "本次块驱动结束",
        "as": "block_step_done"
      }
    ]
  }
}
