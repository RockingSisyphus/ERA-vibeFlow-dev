{
  "nodeset_imports": [],
  "type_key": "era.sync.block_step",
  "display_name": "ERA 块步进单次迭代",
  "description": "块步进循环的 body：每次迭代只读取当前承载状态与同步上下文，推进一个块并返回下一个状态与本次是否结束（消息处理完或遇到无标记调用需交接）。",
  "requires": [
    {
      "type": "era.sync.block.step.state",
      "cardinality": "exactly_one",
      "display_name": "块步进状态"
    }
  ],
  "provides": [
    {
      "key": "block_step_state_after",
      "type": "era.sync.block.step.state.next",
      "display_name": "块步进后状态"
    },
    {
      "key": "block_step_done",
      "type": "era.step.done",
      "display_name": "本次块驱动结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "块步进状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "块迭代开始",
        "description": "进入单块推进边界。"
      },
      {
        "id": "advance_message_block",
        "type_used": "era.sync.drive_message_blocks",
        "display_name": "推进一个块",
        "description": "按原文位置推进一个块；遇到无标记 <EraFCall/> 时结束本次迭代并把交接事实写入状态，函数由 Host 在步骤之外执行。"
      },
      {
        "id": "build_block_commit",
        "type_used": "era.sync.build_block_commit",
        "display_name": "构造逐块提交请求",
        "description": "把这一块之后的累计状态构造成待提交请求（basis 按当前文本重建）；交接迭代产出不提交信封。"
      },
      {
        "id": "commit_block_state",
        "type_used": "era.tavern.variables_commit",
        "display_name": "提交该块的消息记录与状态",
        "description": "复用既有提交链写入该块的消息记录与 sidecar 状态（含续做游标）。"
      },
      {
        "id": "fold_block_commit",
        "type_used": "era.sync.fold_block_commit",
        "display_name": "折回提交结果",
        "description": "从提交结果读回状态并折回；提交未成功则抛类型化错误。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "块迭代结束",
        "description": "返回下一个块步进状态与是否结束本次块驱动。"
      }
    ],
    "edges": [
      [
        "start",
        "advance_message_block"
      ],
      [
        "advance_message_block",
        "build_block_commit"
      ],
      [
        "build_block_commit",
        "commit_block_state"
      ],
      [
        "commit_block_state",
        "fold_block_commit"
      ],
      [
        "fold_block_commit",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块步进后状态",
        "as": "block_step_state_after"
      },
      {
        "type": "era.step.done",
        "cardinality": "exactly_one",
        "display_name": "本次块驱动结束",
        "as": "block_step_done"
      }
    ]
  }
}
