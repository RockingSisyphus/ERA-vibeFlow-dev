{
  "type_key": "era.sync.block_step",
  "display_name": "处理消息中的一段指令或作者调用",
  "description": "根据当前消息位置识别变量指令、作者函数、生成阶段调用或消息结束，完成这一项处理并合入进度。随后整理已完成历史的压缩方案，交回下一位置，供外层按正文顺序继续。",
  "requires": [
    {
      "type": "era.sync.block.step.state",
      "cardinality": "exactly_one",
      "display_name": "当前消息位置及待处理变量指令"
    },
    {
      "type": "era.workflow.host_resources",
      "cardinality": "exactly_one",
      "display_name": "所属 ERA 实例的本地资源"
    }
  ],
  "provides": [
    {
      "key": "block_step_state_after",
      "type": "era.sync.block.step.state.next",
      "display_name": "本段正文处理后的变量和消息进度"
    },
    {
      "key": "block_step_done",
      "type": "era.step.done",
      "display_name": "当前处理范围是否已经结束"
    },
    {
      "key": "retained_host_resources",
      "type": "era.workflow.host_resources",
      "display_name": "所属 ERA 实例的本地资源"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "当前消息位置及待处理变量指令",
        "required": true
      },
      {
        "key": "host_resources",
        "type": "era.workflow.host_resources",
        "required": true,
        "display_name": "所属 ERA 实例的本地资源"
      }
    ],
    "max_steps": 36,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始处理消息中的一段指令或作者调用",
        "description": "标明“处理消息中的一段指令或作者调用”的开始位置。根据当前消息位置识别变量指令、作者函数、生成阶段调用或消息结束，完成这一项处理并合入进度。随后整理已完成历史的压缩方案，交回下一位置，供外层按正文顺序继续。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "choose_message_action",
        "display_name": "判断当前位置是指令、函数还是消息结束",
        "description": "在“处理消息中的一段指令或作者调用”流程中，读取当前消息及正文位置，准备该消息的历史起点，识别变量指令、作者函数、生成阶段调用或结束位置。正在运行的作者函数交给函数流程；无需处理的消息继续下一条。 识别正文时用与压缩共用的容错解析器保留指令边界、字面字符串与顺序；无效片段留下诊断，后续独立指令照常处理。",
        "definition_id": "era.sync.choose_message_action"
      },
      {
        "id": "author_function_step",
        "display_name": "在消息当前位置启动或接续作者函数",
        "description": "本环节用于“处理消息中的一段指令或作者调用”：接收正文中的作者自定义 JavaScript 函数，检查后启动，等待它提出变量操作或结束。提交的操作在原正文位置应用后回告函数；完成、失败或范围结束时整理调用记录并释放资料。",
        "definition_id": "era.sync.author_function_step"
      },
      {
        "id": "prepare_operations",
        "display_name": "把当前位置的指令整理为有序操作",
        "description": "在“处理消息中的一段指令或作者调用”流程中，接收正文中的变量指令或生成阶段函数调用，整理要执行的操作清单，附上当前变量、函数、历史起点和随机进度。交给统一操作循环逐项计算，保持消息中的执行顺序。 把三个变量区中的显式数组路径和现有整值指令交给同一操作循环，保留字符串键、数字下标及本楼起始状态。",
        "definition_id": "era.sync.prepare_message_operations"
      },
      {
        "id": "operation_loop",
        "definition_id": "era.command.apply_operations",
        "display_name": "完成指定范围内的有序变量和函数操作",
        "description": "本环节用于“处理消息中的一段指令或作者调用”：接收要处理的操作及起始变量、函数和随机位置，按顺序重复单项操作流程，直到本范围结束。正式消息、历史压缩比较和只读预演共用这一规则，返回各自结果供相应场景使用。"
      },
      {
        "id": "accept_operations",
        "display_name": "把指令计算结果合入当前消息",
        "description": "在“处理消息中的一段指令或作者调用”流程中，接收统一操作流程算出的变量、函数、历史和问题，将它们合入当前消息进度。正文指令标记完成并继续后续内容，生成阶段调用则形成相应阶段结果，供外层接着处理。",
        "definition_id": "era.sync.accept_message_operations"
      },
      {
        "id": "install_author_frame",
        "display_name": "记住作者函数在消息中的执行位置",
        "description": "在“处理消息中的一段指令或作者调用”流程中，遇到还未执行的作者自定义 JavaScript 函数时，记住它所在的消息和正文位置，并放置临时定位标记。下一轮据此启动函数，它提交的变量操作也会接在这个位置处理。",
        "definition_id": "era.sync.install_author_frame"
      },
      {
        "id": "skip_call",
        "display_name": "记录跳过的函数调用并继续正文",
        "description": "在“处理消息中的一段指令或作者调用”流程中，正文中的函数调用按规则不执行时，保留原因，标记该调用已经处理，并移到下一个正文片段。外层据此继续消息，不会反复尝试同一项。",
        "definition_id": "era.sync.skip_message_call"
      },
      {
        "id": "finish_message",
        "display_name": "完成本条消息并准备继续历史",
        "description": "在“处理消息中的一段指令或作者调用”流程中，整理当前消息引起的变量和函数变化，更新正文处理记录，为已完成的历史准备可用压缩方案。然后移到下一条消息，使整个聊天按原顺序恢复变量状态。",
        "definition_id": "era.sync.finish_message"
      },
      {
        "id": "finish_message_step",
        "display_name": "汇总这一段正文带来的变化",
        "description": "在“处理消息中的一段指令或作者调用”流程中，接收刚处理完的变量指令、作者函数或消息结束结果，整理本轮变量、函数、正文、历史与问题。更新当前消息进度，供历史压缩及下一轮正文处理使用。",
        "definition_id": "era.sync.finish_message_step"
      },
      {
        "id": "apply_command_compaction",
        "display_name": "压缩已完成历史并核对实际效果",
        "description": "本环节用于“处理消息中的一段指令或作者调用”：为已完成处理的历史正文准备较短指令方案，逐份交给正式操作流程重算比较。只有变量、函数和随机效果一致的方案才合回正文和历史记录，其他部分保持原文。",
        "definition_id": "era.command_compaction.apply_sealed_layers"
      },
      {
        "id": "publish_block_application",
        "display_name": "暂存块结果并在普通同步完成时发布",
        "description": "每个块将变量、历史和待保存正文交给同一工作状态，作者函数据此读取当前位置的结果。普通同步处理完全部块时向公开接口交接完整快照。外部提交和生成阶段各自在自己的完成节点交接结果。源：nodes/sync/shared_block_state_adapters.ts。",
        "definition_id": "era.communication.lifecycle_publish_block_application"
      },
      {
        "id": "end",
        "display_name": "结束处理消息中的一段指令或作者调用",
        "description": "标明“处理消息中的一段指令或作者调用”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "retain_host_resources",
        "definition_id": "era.service.retain_host_resources",
        "display_name": "保留所属实例的资源",
        "description": "先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "choose_message_action",
        "schedule": true
      },
      {
        "from": "choose_message_action",
        "to": "author_function_step",
        "when": "message_action == 'author'"
      },
      {
        "from": "choose_message_action",
        "to": "prepare_operations",
        "when": "message_action == 'operations'"
      },
      {
        "from": "choose_message_action",
        "to": "install_author_frame",
        "when": "message_action == 'author-call'"
      },
      {
        "from": "choose_message_action",
        "to": "skip_call",
        "when": "message_action == 'skip'"
      },
      {
        "from": "choose_message_action",
        "to": "finish_message",
        "when": "message_action == 'message-end'"
      },
      {
        "from": "choose_message_action",
        "to": "finish_message_step",
        "when": "message_action == 'complete'"
      },
      [
        "prepare_operations",
        "operation_loop"
      ],
      {
        "from": "prepare_operations",
        "to": "accept_operations",
        "schedule": false
      },
      [
        "operation_loop",
        "accept_operations"
      ],
      [
        "author_function_step",
        "finish_message_step"
      ],
      [
        "accept_operations",
        "finish_message_step"
      ],
      [
        "install_author_frame",
        "finish_message_step"
      ],
      [
        "skip_call",
        "finish_message_step"
      ],
      [
        "finish_message",
        "finish_message_step"
      ],
      [
        "finish_message_step",
        "apply_command_compaction"
      ],
      [
        "apply_command_compaction",
        "publish_block_application"
      ],
      [
        "publish_block_application",
        "end"
      ],
      [
        "start",
        "retain_host_resources"
      ],
      {
        "from": "retain_host_resources",
        "to": "choose_message_action",
        "schedule": true
      },
      {
        "from": "retain_host_resources",
        "to": "author_function_step",
        "schedule": false
      },
      {
        "from": "retain_host_resources",
        "to": "operation_loop",
        "schedule": false
      },
      {
        "from": "retain_host_resources",
        "to": "apply_command_compaction",
        "schedule": false
      },
      {
        "from": "retain_host_resources",
        "to": "publish_block_application",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "本段正文处理后的变量和消息进度",
        "as": "block_step_state_after"
      },
      {
        "type": "era.step.done",
        "cardinality": "exactly_one",
        "display_name": "当前处理范围是否已经结束",
        "as": "block_step_done"
      },
      {
        "type": "era.workflow.host_resources",
        "as": "retained_host_resources",
        "cardinality": "exactly_one",
        "display_name": "所属 ERA 实例的本地资源"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "command_operation_step.jsonc"
    },
    {
      "path": "author_function_step.jsonc"
    }
  ]
}
