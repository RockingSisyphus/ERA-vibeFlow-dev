{
  "nodeset_imports": [
    {
      "path": "command_compaction.jsonc"
    }
  ],
  "type_key": "era.sync.block_step",
  "display_name": "ERA 块步进单次迭代",
  "description": "单块或楼层维护提交：执行、构造候选、封存压缩、保存、折回。只有保存后的状态可以推进；错误成为任务结果，不抛成永久工作流停止。",
  "requires": [
    {
      "type": "era.sync.block.step.state",
      "cardinality": "exactly_one",
      "display_name": "块步进状态"
    }
  ],
  "provides": [
    {
      "key": "block_step_state_after",
      "type": "era.sync.block.step.state.next",
      "display_name": "块步进后状态"
    },
    {
      "key": "block_step_done",
      "type": "era.step.done",
      "display_name": "本次块驱动结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "块步进状态",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "块迭代开始",
        "description": "进入单块推进边界。"
      },
      {
        "id": "advance_message_block",
        "type_used": "era.sync.drive_message_blocks",
        "display_name": "应用下一块或准备楼层维护",
        "description": "复用纯块应用语义，独立携带消息起点变量/函数及连续随机偏移；done 仅按标签判断，旧 EraFCallTx 只作普通记录容器。无 done 调用返回 ERA_FCALL_NOT_IMPLEMENTED，不改 done，不处理后续块。准备楼层完成清进度、纯回退和空聊天所需的维护写入。"
      },
      {
        "id": "prepare_block_work",
        "type_used": "era.sync.prepare_block_work",
        "display_name": "构造单块与日志同步工作项",
        "description": "从真实累计状态构造当前块的消息/Sidecar候选和完整累计回退日志。仅楼层完成时给出该封存楼层压缩候选；最新楼层不压缩；普通块候选为空。携带状态经工作项传递，禁止另算整楼终值。"
      },
      {
        "id": "apply_command_compaction",
        "type_used": "era.command_compaction.apply_sealed_layers",
        "display_name": "保留同 Scope 封存压缩",
        "description": "沿既有展开节点运行纯压缩和重放校验，候选仅来自已完成封存楼层；允许普通操作相对 done 调用移位，不执行工具，不在此写宿主。"
      },
      {
        "id": "build_block_commit",
        "type_used": "era.sync.build_block_commit",
        "display_name": "构造唯一提交请求",
        "description": "将压缩后的单块或楼层维护工作项构造成既有保存请求；依据只吸收本任务已确认的自身写入，不能用新目标依据掩盖旧文本。错误/无需写入使用无提交信封；最后的进度删除和 cursor 清除在此提交路径处理。"
      },
      {
        "id": "commit_block_state",
        "type_used": "era.tavern.variables_commit",
        "display_name": "提交该块的消息记录与状态",
        "description": "复用既有提交链写入该块的消息记录与 sidecar 状态（含续做游标）。"
      },
      {
        "id": "fold_block_commit",
        "type_used": "era.sync.fold_block_commit",
        "display_name": "折回实际保存结果与循环终止状态",
        "description": "保存成功后推进状态、日志及进度；提交失败保留已成功块并返回任务级失败，来源变化作废原目标。最后完成清进度后才能标楼层完成；继续下一受影响楼层或结束。循环终止事实必须来自提交之后。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "块迭代结束",
        "description": "返回下一个块步进状态与是否结束本次块驱动。"
      }
    ],
    "edges": [
      [
        "start",
        "advance_message_block"
      ],
      [
        "advance_message_block",
        "prepare_block_work"
      ],
      [
        "prepare_block_work",
        "apply_command_compaction"
      ],
      [
        "apply_command_compaction",
        "build_block_commit"
      ],
      [
        "build_block_commit",
        "commit_block_state"
      ],
      [
        "commit_block_state",
        "fold_block_commit"
      ],
      [
        "fold_block_commit",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块步进后状态",
        "as": "block_step_state_after"
      },
      {
        "type": "era.step.done",
        "cardinality": "exactly_one",
        "display_name": "本次块驱动结束",
        "as": "block_step_done"
      }
    ]
  }
}
