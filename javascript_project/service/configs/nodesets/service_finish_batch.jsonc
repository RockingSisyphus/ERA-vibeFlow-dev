{
  "type_key": "era.service.finish_batch",
  "display_name": "ERA 批次结算与发布",
  "description": "结束本批次并为全部原始事件准确结算一次，构造统一结果帧，先发送给宿主，再判断能否继续服务。普通失败可带着诊断进入下一轮收集；无法确认写入等致命结果则在发送后抛错。这个顺序确保服务停止前，等待本批结果的调用方已能收到结论。",
  "requires": [
    {
      "type": "era.batch.execution.state.after",
      "cardinality": "exactly_one",
      "display_name": "待结算批次状态"
    }
  ],
  "provides": [
    {
      "key": "finished_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "收集阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state_after",
        "type": "era.batch.execution.state.after",
        "display_name": "待结算批次状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾开始",
        "description": "这是“ERA 批次结算与发布”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "finalize_batch",
        "type_used": "era.service.finalize_batch",
        "display_name": "结算全部来源",
        "description": "在全部步骤结束或计划被拒绝后，核对每个原始事件都恰好获得一次结算，汇总批次诊断，并更新服务批次计数。把任务层结果整理为可发布的批次结论；不会重新执行失败任务，也不负责酒馆文件写入。"
      },
      {
        "id": "build_outbound",
        "type_used": "era.service.build_outbound",
        "display_name": "构造批次结果帧",
        "description": "把已结算批次组织成一个出站结果帧，包括各事件回执、业务通知、诊断和是否必须终止服务的标记，同时得到后续服务状态。相同批次使用稳定标识，便于宿主识别重复结果。这里只构造帧；工作流必须先发送该帧，再处理致命错误。"
      },
      {
        "id": "send_batch_result",
        "type_used": "vibeflow.io",
        "display_name": "发送批次结果",
        "description": "把已经结算的整批结果帧通过 ERA 出站通道交给宿主，其中包含每个原事件的回执、通知、诊断和致命标记。发送发生在任何致命抛错之前，让等待结果的调用方能知道发生了什么；这个节点不重新计算业务，也不把帧发送成功当成消息或状态文件保存成功。",
        "requires": [
          {
            "type": "era.batch.result",
            "cardinality": "exactly_one",
            "display_name": "批次结果帧"
          }
        ],
        "io": {
          "operation": "send",
          "port": "era.service.out"
        },
        "provides": []
      },
      {
        "id": "route_fatal",
        "type_used": "era.service.route_fatal",
        "display_name": "路由致命结果",
        "description": "读取已经随批次结果确定的致命标记：可继续运行的结果进入下一次事件收集，无法确认写入等致命情况进入抛错分支。分支发生在结果帧已交给宿主之后，因此调用方先得知本批次失败；这里不把普通业务失败升级为致命错误。"
      },
      {
        "id": "continue_state",
        "type_used": "era.service.continue_state",
        "display_name": "继续服务",
        "description": "当批次没有致命错误时，导出已经结算后的服务状态，包括后续收集所需进度。原值不变，不重新读取聊天或重算变量；它连接“本批次已发布”与“下一批事件可开始收集”两个时点。"
      },
      {
        "id": "raise_fatal",
        "type_used": "era.service.raise_fatal",
        "display_name": "抛出致命服务错误",
        "description": "在宿主已经收到本批次结果帧后抛出服务致命错误，结束正常循环。用于写入结果未知或无法安全继续的情形，防止把不确定状态带入下一批任务。它不再发送第二份结算，也不自行回滚已确认的宿主写入。"
      },
      {
        "id": "resume_collection",
        "type_used": "era.service.cycle.resume_collect",
        "display_name": "恢复收集阶段",
        "description": "把批次结束后可继续运行的服务状态包装回收集阶段，交给长期循环的下一轮。先前任务已经结算和发布；本节点自身不接收事件、不执行保存，只明确下一轮可以恢复接收新请求。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾结束",
        "description": "这是“ERA 批次结算与发布”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "finalize_batch"
      ],
      [
        "finalize_batch",
        "build_outbound"
      ],
      [
        "build_outbound",
        "send_batch_result"
      ],
      {
        "from": "send_batch_result",
        "to": "route_fatal",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "route_fatal",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "continue_state",
        "when": "fatal_route == 'continue'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "continue_state",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "raise_fatal",
        "when": "fatal_route == 'fatal'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "raise_fatal",
        "schedule": false
      },
      [
        "continue_state",
        "resume_collection"
      ],
      [
        "resume_collection",
        "end"
      ],
      [
        "raise_fatal",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "收集阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
