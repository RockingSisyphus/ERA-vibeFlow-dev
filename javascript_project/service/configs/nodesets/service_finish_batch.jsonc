{
  "type_key": "era.service.finish_batch",
  "display_name": "ERA 批次结算与发布",
  "description": "结算全部来源，构造并发送唯一批次结果帧；发送完成后才允许继续或抛出致命错误。",
  "requires": [
    {
      "type": "era.batch.execution.state.after",
      "cardinality": "exactly_one",
      "display_name": "待结算批次状态"
    }
  ],
  "provides": [
    {
      "key": "finished_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "收集阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state_after",
        "type": "era.batch.execution.state.after",
        "display_name": "待结算批次状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾开始",
        "description": "开始唯一一次批次结算。"
      },
      {
        "id": "finalize_batch",
        "type_used": "era.service.finalize_batch",
        "display_name": "结算全部来源",
        "description": "复用现有逐来源准确一次结算、诊断与服务迭代计数。"
      },
      {
        "id": "build_outbound",
        "type_used": "era.service.build_outbound",
        "display_name": "构造批次结果帧",
        "description": "构造幂等帧，确保结算先于通知，并携带致命决策。"
      },
      {
        "id": "send_batch_result",
        "type_used": "vibeflow.io",
        "display_name": "发送批次结果",
        "description": "在抛出任何致命错误前，将最终帧提交到出站 Port。",
        "requires": [
          {
            "type": "era.batch.result",
            "cardinality": "exactly_one",
            "display_name": "批次结果帧"
          }
        ],
        "io": {
          "operation": "send",
          "port": "era.service.out"
        },
        "provides": []
      },
      {
        "id": "route_fatal",
        "type_used": "era.service.route_fatal",
        "display_name": "路由致命结果",
        "description": "可恢复批次结果后继续；提交结果未知或部分提交时抛出错误。"
      },
      {
        "id": "continue_state",
        "type_used": "era.service.continue_state",
        "display_name": "继续服务",
        "description": "导出已提交的批次后状态，供外层循环下一次迭代使用。"
      },
      {
        "id": "raise_fatal",
        "type_used": "era.service.raise_fatal",
        "display_name": "抛出致命服务错误",
        "description": "仅在宿主收到终止批次帧后抛出带类型的致命错误。"
      },
      {
        "id": "resume_collection",
        "type_used": "era.service.cycle.resume_collect",
        "display_name": "恢复收集阶段",
        "description": "仅包装已发布的原服务状态；下轮才再次接收入站事件。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾结束",
        "description": "返回 collect 阶段；fatal 路径不会正常返回。"
      }
    ],
    "edges": [
      [
        "start",
        "finalize_batch"
      ],
      [
        "finalize_batch",
        "build_outbound"
      ],
      [
        "build_outbound",
        "send_batch_result"
      ],
      {
        "from": "send_batch_result",
        "to": "route_fatal",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "route_fatal",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "continue_state",
        "when": "fatal_route == 'continue'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "continue_state",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "raise_fatal",
        "when": "fatal_route == 'fatal'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "raise_fatal",
        "schedule": false
      },
      [
        "continue_state",
        "resume_collection"
      ],
      [
        "resume_collection",
        "end"
      ],
      [
        "raise_fatal",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "收集阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
