{
  "type_key": "era.service.finish_batch",
  "display_name": "汇总整批结果并回告页面",
  "description": "所有任务结束后，为本批每个原事件整理一次最终确认，附上通知和问题记录，再集中送回页面。普通失败后继续接收事件，需停止的严重问题先回告原因再结束服务。",
  "requires": [
    {
      "type": "era.batch.execution.state.after",
      "cardinality": "exactly_one",
      "display_name": "本批任务结束或计划失败后的状态"
    }
  ],
  "provides": [
    {
      "key": "finished_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "服务当前处于收集还是执行及相应进度"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state_after",
        "type": "era.batch.execution.state.after",
        "display_name": "本批任务结束或计划失败后的状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始汇总整批结果并回告页面",
        "description": "标明“汇总整批结果并回告页面”的开始位置。所有任务结束后，为本批每个原事件整理一次最终确认，附上通知和问题记录，再集中送回页面。普通失败后继续接收事件，需停止的严重问题先回告原因再结束服务。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "finalize_batch",
        "display_name": "为整批原事件形成最终处理确认",
        "description": "在“汇总整批结果并回告页面”流程中，汇总当前批次所有任务的实际结果，为每个原事件形成一次最终确认，并更新完成批次数。后续统一把确认和页面通知送回酒馆。",
        "definition_id": "era.service.finalize_batch"
      },
      {
        "id": "build_outbound",
        "display_name": "汇总发回页面的批次消息",
        "description": "在“汇总整批结果并回告页面”流程中，把已处理事件的确认、页面通知、问题记录和停止原因组装成一份对应本批次的结果，同时准备下一轮服务状态。页面据此完成等待中的请求和后续通知。",
        "definition_id": "era.service.build_outbound"
      },
      {
        "id": "send_batch_result",
        "display_name": "把整批处理确认和通知发回页面",
        "description": "在“汇总整批结果并回告页面”流程中，将已结算批次的事件确认、通知、问题和停止原因送回酒馆。需要停止服务时也先发出结果，使等待中的脚本和界面能够收到具体原因。",
        "definition_id": "era.service.port.send_batch_result",
        "rulesets": [
          "vibeflow.data_store",
          {
            "rule_id": "vibeflow.capability.allow",
            "params": {
              "capability": "vibeflow.port",
              "operations": [
                "send"
              ],
              "actions": [
                {
                  "operation": "send",
                  "port": "era.service.out"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "route_fatal",
        "display_name": "判断返回结果后是否必须停止服务",
        "description": "在“汇总整批结果并回告页面”流程中，检查已发送给页面的批次结果是否含有严重停止原因。有则结束本实例服务，没有则继续收集事件，确保调用方先收到处理结果，再进入相应后续状态。",
        "definition_id": "era.service.route_fatal"
      },
      {
        "id": "continue_state",
        "display_name": "交出下一轮收集事件的状态",
        "description": "在“汇总整批结果并回告页面”流程中，本批结果已经发布后，将剩余事件、序号和定时安排交给下一轮服务循环。让后续聊天变化接着处理，并保留已经推进的服务进度。",
        "definition_id": "era.service.continue_state"
      },
      {
        "id": "raise_fatal",
        "display_name": "在已回告原因后结束严重故障的服务",
        "description": "在“汇总整批结果并回告页面”流程中，接收已向页面报告的严重故障原因，结束当前服务执行。这样写入状态无法确认等问题不会被当成正常批次继续，而原调用方已能收到发生了什么。",
        "definition_id": "era.service.raise_fatal"
      },
      {
        "id": "resume_collection",
        "display_name": "批次结束后恢复事件收集",
        "description": "在“汇总整批结果并回告页面”流程中，接收已发布结果后的下一轮服务状态，将服务切回事件收集。新的聊天变化和脚本请求从这里继续进入处理。",
        "definition_id": "era.service.cycle.resume_collect"
      },
      {
        "id": "end",
        "display_name": "结束汇总整批结果并回告页面",
        "description": "标明“汇总整批结果并回告页面”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "finalize_batch"
      ],
      [
        "finalize_batch",
        "build_outbound"
      ],
      [
        "build_outbound",
        "send_batch_result"
      ],
      {
        "from": "send_batch_result",
        "to": "route_fatal",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "route_fatal",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "continue_state",
        "when": "fatal_route == 'continue'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "continue_state",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "raise_fatal",
        "when": "fatal_route == 'fatal'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "raise_fatal",
        "schedule": false
      },
      [
        "continue_state",
        "resume_collection"
      ],
      [
        "resume_collection",
        "end"
      ],
      [
        "raise_fatal",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "服务当前处于收集还是执行及相应进度",
        "as": "cycleStateNext"
      }
    ]
  }
}
