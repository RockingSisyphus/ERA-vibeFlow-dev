{
  "type_key": "era.service.finish_batch",
  "display_name": "汇总批次结果并发送给酒馆页面",
  "description": "汇总当前批次所有任务的结论，检查每个原始事件恰有一次回执，再发送结果和通知。普通失败后可以继续接收事件；写入结果未知等致命问题先告知调用方，再停止服务。",
  "requires": [
    {
      "type": "era.batch.execution.state.after",
      "cardinality": "exactly_one",
      "display_name": "待结算批次状态"
    }
  ],
  "provides": [
    {
      "key": "finished_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "收集阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "execution_state_after",
        "type": "era.batch.execution.state.after",
        "display_name": "待结算批次状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾开始",
        "description": "开始汇总批次结果并发送给酒馆页面。"
      },
      {
        "id": "finalize_batch",
        "type_used": "era.service.finalize_batch",
        "display_name": "结算全部来源",
        "description": "本次结算已经执行完成的事件批次。汇总批次中各任务的实际结果，为每个原事件生成一次最终回执，并更新已完成批次数。"
      },
      {
        "id": "build_outbound",
        "type_used": "era.service.build_outbound",
        "display_name": "构造批次结果帧",
        "description": "本次结算已经执行完成的事件批次。把已结算批次的事件回执、页面通知、诊断和停止原因组装为带稳定身份的输出消息，同时生成下一轮服务状态。"
      },
      {
        "id": "send_batch_result",
        "type_used": "vibeflow.io",
        "display_name": "发送批次结果",
        "description": "把已结算批次的事件回执、通知、诊断和服务停止原因发送给酒馆页面。需要停止时先发布结果，再结束服务，使原调用方能收到原因。",
        "requires": [
          {
            "type": "era.batch.result",
            "cardinality": "exactly_one",
            "display_name": "批次结果帧"
          }
        ],
        "io": {
          "operation": "send",
          "port": "era.service.out"
        },
        "provides": []
      },
      {
        "id": "route_fatal",
        "type_used": "era.service.route_fatal",
        "display_name": "路由致命结果",
        "description": "本次结算已经执行完成的事件批次。检查已经发布的输出是否含服务停止原因，选择继续收集事件或结束当前服务运行。"
      },
      {
        "id": "continue_state",
        "type_used": "era.service.continue_state",
        "display_name": "继续服务",
        "description": "本次结算已经执行完成的事件批次。将输出发布后的服务状态交给下一轮事件收集，供服务继续运行。"
      },
      {
        "id": "raise_fatal",
        "type_used": "era.service.raise_fatal",
        "display_name": "抛出致命服务错误",
        "description": "本次结算已经执行完成的事件批次。在结果已发送给页面后，抛出需要停止服务的严重写入错误，使本轮服务结束，并保留已经报告的原因。"
      },
      {
        "id": "resume_collection",
        "type_used": "era.service.cycle.resume_collect",
        "display_name": "恢复收集阶段",
        "description": "本次结算已经执行完成的事件批次。把已发布批次的下一轮状态送回事件收集阶段，开始处理后续酒馆事件。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "批次收尾结束",
        "description": "结束汇总批次结果并发送给酒馆页面，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "finalize_batch"
      ],
      [
        "finalize_batch",
        "build_outbound"
      ],
      [
        "build_outbound",
        "send_batch_result"
      ],
      {
        "from": "send_batch_result",
        "to": "route_fatal",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "route_fatal",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "continue_state",
        "when": "fatal_route == 'continue'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "continue_state",
        "schedule": false
      },
      {
        "from": "route_fatal",
        "to": "raise_fatal",
        "when": "fatal_route == 'fatal'",
        "transfer": false
      },
      {
        "from": "build_outbound",
        "to": "raise_fatal",
        "schedule": false
      },
      [
        "continue_state",
        "resume_collection"
      ],
      [
        "resume_collection",
        "end"
      ],
      [
        "raise_fatal",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "收集阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
