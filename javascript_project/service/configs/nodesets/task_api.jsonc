{
  "type_key": "era.task.api",
  "display_name": "准备脚本或界面的提交、同步请求",
  "description": "为脚本或界面的变量提交和历史同步请求准备执行资料：提交请求交给共享命令处理；同步请求先检查模式和范围，输入有误则返回具体失败结果。执行结论由外层任务回执流程形成。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "原任务、触发事件与已读取消息"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次、任务列表与执行位置"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "原任务、事件来源、批次和回执资料"
    }
  ],
  "provides": [
    {
      "key": "era_task_api_prepared_task",
      "type": "era.task.prepared",
      "display_name": "待执行请求及原任务资料"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.step.request.routed",
        "display_name": "原任务、触发事件与已读取消息",
        "required": true
      },
      {
        "key": "input_1",
        "type": "era.batch.execution.state",
        "display_name": "当前批次、任务列表与执行位置",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源、批次和回执资料",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "API 准备开始",
        "description": "开始准备脚本或界面的提交、同步请求。"
      },
      {
        "id": "identify_request",
        "type_used": "era.api.identify_task_request",
        "display_name": "识别脚本或界面的接口请求",
        "description": "读取脚本或界面提交的接口请求，区分提交变量操作（commit）与按历史重算（sync），并把原任务和回执资料传给对应准备入口。"
      },
      {
        "id": "prepare_commit_request",
        "type_used": "era.api.prepare_commit_continuation",
        "display_name": "返回原位提交请求",
        "description": "本次准备脚本或界面发起的提交、同步请求。取出公共 调用接口（API） 提交请求和原批次，交给 Service 的提交执行流程，并保留回执所需的请求来源。"
      },
      {
        "id": "prepare_history_sync",
        "type_used": "era.api.prepare_history_sync",
        "display_name": "检查同步请求，确定重算方式和范围",
        "description": "检查按历史重算请求的模式和目标消息，生成历史同步任务；输入有误时形成具体失败结果。两种情况都保留原接口请求，供执行完成后返回回执。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "API 准备结束",
        "description": "结束准备脚本或界面的提交、同步请求，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "identify_request"
      ],
      {
        "from": "identify_request",
        "to": "prepare_commit_request",
        "when": "facade_route == 'commit'"
      },
      {
        "from": "identify_request",
        "to": "prepare_history_sync",
        "when": "facade_route == 'sync'"
      },
      [
        "prepare_commit_request",
        "end"
      ],
      [
        "prepare_history_sync",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "待执行请求及原任务资料",
        "as": "era_task_api_prepared_task"
      }
    ]
  }
}
