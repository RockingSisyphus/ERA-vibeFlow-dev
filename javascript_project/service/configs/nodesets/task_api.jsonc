{
  "type_key": "era.task.api",
  "display_name": "准备脚本或界面的变量提交和历史同步",
  "description": "读取本次接口请求，变量提交进入草稿比较和操作准备，历史同步先检查重算方式及目标范围。有效请求交给对应执行流程，无效请求带原因直接返回，并保留原请求用于回告。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "执行后回告所需的原任务资料"
    }
  ],
  "provides": [
    {
      "key": "era_task_api_prepared_task",
      "type": "era.task.prepared",
      "display_name": "已备齐的执行请求或直接返回结论"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.step.request.routed",
        "display_name": "当前任务及已读取的聊天资料",
        "required": true
      },
      {
        "key": "input_1",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "执行后回告所需的原任务资料",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始准备脚本或界面的变量提交和历史同步",
        "description": "标明“准备脚本或界面的变量提交和历史同步”的开始位置。读取本次接口请求，变量提交进入草稿比较和操作准备，历史同步先检查重算方式及目标范围。有效请求交给对应执行流程，无效请求带原因直接返回，并保留原请求用于回告。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "identify_request",
        "display_name": "区分变量提交和历史重算请求",
        "description": "在“准备脚本或界面的变量提交和历史同步”流程中，读取脚本或界面发来的请求，判断它要直接提交变量操作，还是根据聊天历史重新计算。将请求和原任务资料送到对应的准备流程，供完成后返回处理结果。",
        "definition_id": "era.api.identify_task_request"
      },
      {
        "id": "prepare_commit_request",
        "display_name": "把已准备的变量提交交给执行流程",
        "description": "在“准备脚本或界面的变量提交和历史同步”流程中，接收脚本或界面的变量提交请求，连同原任务和批次交给统一提交流程。保留发起来源，使实际应用完成后能够把成功、跳过或失败返回给对应调用方。",
        "definition_id": "era.api.prepare_commit_continuation"
      },
      {
        "id": "prepare_history_sync",
        "display_name": "检查并准备按历史重算的请求",
        "description": "在“准备脚本或界面的变量提交和历史同步”流程中，接收脚本或界面的历史同步请求，检查重算方式及目标消息，整理为统一的历史同步任务。方式或范围无效时形成具体失败结果，并保留原请求以便回告。",
        "definition_id": "era.api.prepare_history_sync"
      },
      {
        "id": "end",
        "display_name": "结束准备脚本或界面的变量提交和历史同步",
        "description": "标明“准备脚本或界面的变量提交和历史同步”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "identify_request"
      ],
      {
        "from": "identify_request",
        "to": "prepare_commit_request",
        "when": "facade_route == 'commit'"
      },
      {
        "from": "identify_request",
        "to": "prepare_history_sync",
        "when": "facade_route == 'sync'"
      },
      [
        "prepare_commit_request",
        "end"
      ],
      [
        "prepare_history_sync",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "已备齐的执行请求或直接返回结论",
        "as": "era_task_api_prepared_task"
      }
    ]
  }
}
