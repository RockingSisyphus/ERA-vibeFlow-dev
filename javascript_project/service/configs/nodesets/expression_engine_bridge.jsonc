{
  "type_key": "era.expression.execute_era_commands",
  "display_name": "含表达式的同步规划",
  "description": "把 Service 已规划的历史、变量起点和处理范围交给共用计算链，其中表达式由独立 Expression 同步工作流求值，形成可以继续执行的同步工作项。随机来源和执行偏移在真实计算链中传递；这个节点集没有酒馆读写，不以计算成功代替后续消息或状态保存。",
  "requires": [
    {
      "type": "era.expression.command.request",
      "cardinality": "exactly_one",
      "display_name": "表达式命令请求"
    }
  ],
  "provides": [
    {
      "key": "expression_command_result",
      "type": "era.expression.command.result",
      "display_name": "表达式命令结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "expression_command_request",
        "type": "era.expression.command.request",
        "display_name": "表达式命令请求",
        "required": true
      }
    ],
    "max_steps": 5,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "表达式命令开始",
        "description": "这是“含表达式的同步规划”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "execute",
        "type_used": "era.expression.execute_era_commands.bridge",
        "display_name": "计算历史同步计划",
        "description": "接收 Service 已限定好消息范围、变量起点和执行原因的计算输入，调用历史同步规划器；其中的表达式计算由独立 Expression 工作流完成，形成后续可执行的工作项。随机来源与偏移沿实际求值链传递。这个边界只做计算，不直接读取或保存酒馆内容。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "表达式命令结束",
        "description": "这是“含表达式的同步规划”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "execute"
      ],
      [
        "execute",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.command.result",
        "cardinality": "exactly_one",
        "display_name": "表达式命令结果",
        "as": "expressionCommandResult"
      }
    ]
  }
}
