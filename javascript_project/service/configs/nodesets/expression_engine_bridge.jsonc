{
  "type_key": "era.expression.execute_era_commands",
  "display_name": "未接入：历史同步规划声明",
  "description": "这份声明原本描述按消息历史和变量起点生成同步计划，但当前没有被正式工作流引用，内部计算节点也未登记。它不属于现行执行架构，不能把这份声明视为已经实现的公式或同步流程。",
  "requires": [
    {
      "type": "era.expression.command.request",
      "cardinality": "exactly_one",
      "display_name": "表达式命令请求"
    }
  ],
  "provides": [
    {
      "key": "expression_command_result",
      "type": "era.expression.command.result",
      "display_name": "消息处理后待核对的历史压缩资料"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "expression_command_request",
        "type": "era.expression.command.request",
        "display_name": "表达式命令请求",
        "required": true
      }
    ],
    "max_steps": 5,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始未接入：历史同步规划声明",
        "description": "标明“未接入：历史同步规划声明”的开始位置。这份声明原本描述按消息历史和变量起点生成同步计划，但当前没有被正式工作流引用，内部计算节点也未登记。它不属于现行执行架构，不能把这份声明视为已经实现的公式或同步流程。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "execute",
        "display_name": "未接入：历史同步计算占位",
        "description": "这是一份未被正式服务引用的历史同步规划声明，所指的计算节点当前也未登记。此处只说明原声明想根据消息和变量起点生成同步计划，不能作为现行可执行步骤阅读。",
        "definition_id": "era.expression.execute_era_commands.bridge"
      },
      {
        "id": "end",
        "display_name": "结束未接入：历史同步规划声明",
        "description": "标明“未接入：历史同步规划声明”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "execute"
      ],
      [
        "execute",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.command.result",
        "cardinality": "exactly_one",
        "display_name": "消息处理后待核对的历史压缩资料",
        "as": "expressionCommandResult"
      }
    ]
  }
}
