{
  "type_key": "era.sidecar.binding",
  "flow_kind": "process",
  "display_name": "ERA Sidecar 绑定事务",
  "description": "集中承载 Sidecar 身份检查、冲突选择、迁移/独立/复制事务和受控弹窗请求。Host 只提供身份、files 和 UI 机械能力；归属、冲突与恢复规则均在本 Nodeset。成功提交后的镜像由同域 Sidecar 节点在 task_sync 的提交后边界调用。",
  "requires": [
    {"type": "era.sync.context", "cardinality": "exactly_one", "display_name": "同步上下文"}
  ],
  "provides": [
    {"key": "sidecar_binding_context", "type": "era.sync.context", "display_name": "已解析的同步上下文"},
    {"key": "sidecar_binding_route", "type": "era.sidecar.binding.route", "display_name": "Sidecar 绑定路由"}
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {"key": "sync_context", "type": "era.sync.context", "display_name": "同步上下文", "required": true}
    ],
    "max_steps": 10,
    "nodes": [
      {"id": "start", "type_used": "era.service.terminal", "display_name": "Sidecar 事务启动", "description": "开始一次受控的 Sidecar 绑定前置事务。"},
      {"id": "inspect_current", "type_used": "era.sidecar_binding.inspect_current", "display_name": "检查当前 Sidecar 绑定", "description": "读取当前角色/群组、聊天 ID、聊天变量 ERAMetaData.SidecarId 与当前用户 files 记录，形成 matched、缺失、损坏或归属冲突事实；不写变量、不写文件。"},
      {"id": "resolve_choice", "type_used": "era.sidecar_binding.resolve_choice", "display_name": "规划 Sidecar 绑定选择", "description": "以检查事实、当前身份、文件 revision 和用户选择纯规则决定继续、阻塞、迁移、创建独立变量或复制变量；Host 不承载归属判断。"},
      {"id": "publish_choice_prompt", "type_used": "era.sidecar_binding.publish_choice_prompt", "display_name": "发布不可关闭的 Sidecar 选择弹窗", "description": "把 workflow 的阻塞冲突结论交给宿主 UI 能力展示迁移、创建独立变量或复制变量；无取消、关闭、背景点击或 Escape 路径。"},
      {"id": "apply_resolution", "type_used": "era.sidecar_binding.apply_resolution", "display_name": "执行 Sidecar 绑定事务", "description": "提交前重新读取当前身份、聊天 ID、SidecarId 与 record revision；受控执行迁移、独立或复制。迁移和复制只追加标准 ERA 恢复指令并完整同步；不能安全恢复时 fail-closed。"},
      {"id": "end", "type_used": "era.service.terminal", "display_name": "Sidecar 事务结束", "description": "输出已解析的同步上下文和绑定路由。"}
    ],
    "edges": [
      ["start", "inspect_current"],
      ["inspect_current", "resolve_choice"],
      {"from": "inspect_current", "to": "apply_resolution", "schedule": false},
      {"from": "resolve_choice", "to": "apply_resolution", "schedule": false},
      ["resolve_choice", "publish_choice_prompt"],
      ["publish_choice_prompt", "apply_resolution"],
      ["apply_resolution", "end"]
    ],
    "outputs": [
      {"type": "era.sync.context", "cardinality": "exactly_one", "display_name": "已解析的同步上下文", "as": "sidecarBindingContext"},
      {"type": "era.sidecar.binding.route", "cardinality": "exactly_one", "display_name": "Sidecar 绑定路由", "as": "sidecarBindingRoute"}
    ]
  }
}
