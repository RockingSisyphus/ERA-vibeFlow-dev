{
  "nodeset_imports": [],
  "type_key": "era.task.initialize",
  "display_name": "初始化角色资源并安排历史同步",
  "description": "为角色卡准备 ERA 所需的设置、世界书、状态栏正则和开场白：读取现有资源，规划差异，再按顺序提交。启动初始化资源就绪后，交回历史同步请求；其他资源操作或失败直接返回结果。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "原任务、事件来源、批次和回执资料"
    }
  ],
  "provides": [
    {
      "key": "era_task_initialize_prepared_task",
      "type": "era.task.prepared",
      "display_name": "待执行请求及原任务资料"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源、批次和回执资料",
        "required": true
      }
    ],
    "max_steps": 21,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "初始化启动",
        "description": "开始初始化角色资源并安排历史同步。"
      },
      {
        "id": "carry_preparation_context",
        "type_used": "era.task.carry_preparation_context",
        "display_name": "保留准备阶段的原任务来源",
        "description": "本次处理酒馆启动或初始化请求。携带原任务、批次和事件来源穿过执行资料准备阶段，供执行与回执使用。"
      },
      {
        "id": "read_host_resources",
        "type_used": "era.tavern.initialization_read",
        "display_name": "读取双模式初始化与现有外置配置",
        "description": "本次处理酒馆启动或初始化请求。从酒馆读取初始化需要的角色、聊天、设置、世界书、正则、开场白和外置配置。未指定模式时使用传统模式，输出当前资源事实。"
      },
      {
        "id": "carry_execution_state",
        "type_used": "era.initialize.carry_execution_state",
        "display_name": "携带批次执行状态",
        "description": "本次处理酒馆启动或初始化请求。把原始初始化批次传过资源准备流程，供初始化完成后继续同步及返回原事件回执。"
      },
      {
        "id": "plan_resources",
        "type_used": "era.initialize.plan",
        "display_name": "规划双模式资源与完整围栏边界",
        "description": "本次处理酒馆启动或初始化请求。比较当前设置、世界书、正则、示例变量、函数和开场白，规划首次使用 ERA 所需的资源变更。按传统或外置模式选择初始化内容，保留已经保存的作者资料。"
      },
      {
        "id": "preserve_resources",
        "type_used": "era.initialize.no_change",
        "display_name": "保留现有资源",
        "description": "本次处理酒馆启动或初始化请求。将无需修改的资源计划或准备失败结果传到提交阶段，保留其具体原因。"
      },
      {
        "id": "compute_resource_changes",
        "type_used": "era.initialize.compute",
        "display_name": "确认资源变更",
        "description": "本次处理酒馆启动或初始化请求。传递已经生成的初始化资源计划，供后续写入请求组装使用。"
      },
      {
        "id": "build_resource_commit",
        "type_used": "era.initialize.build_commit",
        "display_name": "构造资源提交",
        "description": "本次处理酒馆启动或初始化请求。将已经准备好的初始化资源变更计划包装为酒馆写入请求，交给浏览器执行。"
      },
      {
        "id": "commit_host_resources",
        "type_used": "era.tavern.initialization_commit",
        "display_name": "提交初始化资源并决议首楼刷新",
        "description": "本次处理酒馆启动或初始化请求。通过酒馆浏览器接口按顺序应用初始化资源计划，记录已确认的每项修改。保存角色开场白后读取当前首条消息，按规则更新、新建或保留，再保存并刷新显示；目标变化或部分失败时记录实际进度。"
      },
      {
        "id": "route_completion",
        "type_used": "era.initialize.build_result",
        "display_name": "选择初始化完成方式",
        "description": "本次处理酒馆启动或初始化请求。根据初始化资源的实际结果选择后续步骤：资源准备成功或无需修改时进入启动历史同步，其余情况返回当前任务结果。"
      },
      {
        "id": "prepare_startup_continuation",
        "type_used": "era.initialize.prepare_startup_continuation",
        "display_name": "返回启动同步请求与原任务",
        "description": "本次处理酒馆启动或初始化请求。资源准备完成后取出启动历史同步请求和原批次，交给共享消息同步流程。"
      },
      {
        "id": "prepare_resource_result",
        "type_used": "era.initialize.prepare_resource_result",
        "display_name": "返回不需同步的资源结果",
        "description": "本次处理酒馆启动或初始化请求。将资源操作结果或错误与原事件资料一起整理，供初始化任务返回结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "初始化结束",
        "description": "结束初始化角色资源并安排历史同步，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "carry_preparation_context"
      ],
      [
        "start",
        "read_host_resources"
      ],
      [
        "start",
        "carry_execution_state"
      ],
      [
        "read_host_resources",
        "plan_resources"
      ],
      {
        "from": "plan_resources",
        "to": "preserve_resources",
        "when": "initialization_route == 'no-op'"
      },
      {
        "from": "plan_resources",
        "to": "compute_resource_changes",
        "when": "initialization_route == 'reconcile'"
      },
      [
        "preserve_resources",
        "build_resource_commit"
      ],
      [
        "compute_resource_changes",
        "build_resource_commit"
      ],
      [
        "build_resource_commit",
        "commit_host_resources"
      ],
      [
        "commit_host_resources",
        "route_completion"
      ],
      {
        "from": "route_completion",
        "to": "prepare_startup_continuation",
        "when": "initialize_completion_route == 'sync'"
      },
      {
        "from": "carry_execution_state",
        "to": "prepare_startup_continuation",
        "schedule": false
      },
      {
        "from": "route_completion",
        "to": "prepare_resource_result",
        "when": "initialize_completion_route == 'finish'"
      },
      [
        "prepare_startup_continuation",
        "end"
      ],
      [
        "prepare_resource_result",
        "end"
      ],
      {
        "from": "carry_preparation_context",
        "to": "prepare_startup_continuation",
        "schedule": false
      },
      {
        "from": "carry_preparation_context",
        "to": "prepare_resource_result",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "待执行请求及原任务资料",
        "as": "era_task_initialize_prepared_task"
      }
    ]
  }
}
