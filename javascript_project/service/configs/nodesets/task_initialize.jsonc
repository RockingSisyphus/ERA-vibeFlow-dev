{
  "nodeset_imports": [],
  "type_key": "era.task.initialize",
  "display_name": "准备角色 ERA 资源并接续历史同步",
  "description": "读取现有设置、世界书、正则和开场白，比较后依次安装或更新所需资源。启动资源就绪时继续历史同步，其他资源操作或失败则直接形成任务结果，保留实际完成进度。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "当前任务及已读取的聊天资料"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次的任务进度与累计结果"
    },
    {
      "type": "era.task.continuation.context",
      "cardinality": "exactly_one",
      "display_name": "执行后回告所需的原任务资料"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "era_task_initialize_prepared_task",
      "type": "era.task.prepared",
      "display_name": "已备齐的执行请求或直接返回结论"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "当前任务及已读取的聊天资料",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次的任务进度与累计结果",
        "required": true
      },
      {
        "key": "continuation",
        "type": "era.task.continuation.context",
        "display_name": "执行后回告所需的原任务资料",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 22,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始准备角色 ERA 资源并接续历史同步",
        "description": "标明“准备角色 ERA 资源并接续历史同步”的开始位置。读取现有设置、世界书、正则和开场白，比较后依次安装或更新所需资源。启动资源就绪时继续历史同步，其他资源操作或失败则直接形成任务结果，保留实际完成进度。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "carry_preparation_context",
        "display_name": "保留任务准备前的原请求资料",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，让原任务、批次和事件来源穿过资料准备流程继续传递。执行和结算环节据此知道正在处理谁的请求，保留正确的回复依据。",
        "definition_id": "era.task.carry_preparation_context",
        "join_policy": "all"
      },
      {
        "id": "read_host_resources",
        "display_name": "读取角色当前的 ERA 初始化资源",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，从酒馆读取角色和聊天资料、相关设置、世界书、正则、开场白及外置配置。把当前资源交给初始化比较，未指定模式时采用传统模式。",
        "definition_id": "era.communication.tavern_initialization_read",
        "join_policy": "all"
      },
      {
        "id": "carry_execution_state",
        "display_name": "记住初始化请求所属的批次",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，让原初始化任务和批次资料随资源准备流程继续传递。资源完成后用这些资料继续历史同步，并把最终结果返回原发起者。",
        "definition_id": "era.initialize.carry_execution_state",
        "join_policy": "all"
      },
      {
        "id": "plan_resources",
        "display_name": "比较现有资源并规划 ERA 初始化",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，读取当前设置、世界书、状态栏正则、示例变量、函数和开场白，找出启用 ERA 需要的改动。按所选使用模式准备内容，并保留已有作者资料；这里只形成计划，实际写入交给执行环节。",
        "definition_id": "era.initialize.plan"
      },
      {
        "id": "preserve_resources",
        "display_name": "保留无需修改或无法准备的资源结果",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，当前资源已经满足要求，或准备阶段已经失败时，将相应计划和原因交给后续结算。让初始化能够准确返回无变化或失败结果。",
        "definition_id": "era.initialize.no_change"
      },
      {
        "id": "compute_resource_changes",
        "display_name": "传递已准备的初始化计划",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，接收已经生成的资源初始化计划，原样交给写入请求组装环节。保留其中需要修改或不能执行的结论，使下一步使用同一份计划。",
        "definition_id": "era.initialize.compute"
      },
      {
        "id": "build_resource_commit",
        "display_name": "把初始化变更计划交给酒馆执行",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，接收已规划的 ERA 资源变化，整理成明确的写入请求。浏览器执行环节据此逐项更新资源并报告结果，本环节仍处于提交前的准备阶段。",
        "definition_id": "era.initialize.build_commit"
      },
      {
        "id": "commit_host_resources",
        "display_name": "按计划安装或更新角色的 ERA 资源",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，接收初始化资源变更计划，按顺序写入设置、世界书、正则和开场白等资源，并记录每项实际进度。开场白保存后按实际聊天决定更新、新建或保留首条消息；目标变化或部分失败时带回已完成内容和原因。",
        "definition_id": "era.communication.tavern_initialization_commit"
      },
      {
        "id": "route_completion",
        "display_name": "决定初始化后继续同步还是返回结果",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，检查资源初始化的实际结论。资源就绪或本来无需修改时继续历史同步，其余情况交出当前操作结果，避免资源未准备好就继续处理聊天。",
        "definition_id": "era.initialize.build_result"
      },
      {
        "id": "prepare_startup_continuation",
        "display_name": "把资源就绪后的聊天交给历史同步",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，ERA 所需资源已经准备好时，取出启动后的历史同步请求和原任务批次。让统一同步流程接着计算现有聊天中的变量，并保留原启动请求以便返回结果。",
        "definition_id": "era.initialize.prepare_startup_continuation"
      },
      {
        "id": "prepare_resource_result",
        "display_name": "整理无需继续同步的初始化结果",
        "description": "在“准备角色 ERA 资源并接续历史同步”流程中，接收资源操作的成功值或错误，连同原事件交给初始化任务结算。用于本次只处理资源、或因问题不能继续启动历史同步的情况。",
        "definition_id": "era.initialize.prepare_resource_result"
      },
      {
        "id": "end",
        "display_name": "结束准备角色 ERA 资源并接续历史同步",
        "description": "标明“准备角色 ERA 资源并接续历史同步”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"carry_preparation_context","schedule":true},
      {"from":"start","to":"read_host_resources","schedule":true},
      {"from":"start","to":"carry_execution_state","schedule":true},
      [
        "read_host_resources",
        "plan_resources"
      ],
      {
        "from": "plan_resources",
        "to": "preserve_resources",
        "when": "initialization_route == 'no-op'"
      },
      {
        "from": "plan_resources",
        "to": "compute_resource_changes",
        "when": "initialization_route == 'reconcile'"
      },
      [
        "preserve_resources",
        "build_resource_commit"
      ],
      [
        "compute_resource_changes",
        "build_resource_commit"
      ],
      [
        "build_resource_commit",
        "commit_host_resources"
      ],
      [
        "commit_host_resources",
        "route_completion"
      ],
      {
        "from": "route_completion",
        "to": "prepare_startup_continuation",
        "when": "initialize_completion_route == 'sync'"
      },
      {
        "from": "carry_execution_state",
        "to": "prepare_startup_continuation",
        "schedule": true
      },
      {
        "from": "route_completion",
        "to": "prepare_resource_result",
        "when": "initialize_completion_route == 'finish'"
      },
      [
        "prepare_startup_continuation",
        "end"
      ],
      [
        "prepare_resource_result",
        "end"
      ],
      {
        "from": "carry_preparation_context",
        "to": "prepare_startup_continuation",
        "schedule": false
      },
      {
        "from": "carry_preparation_context",
        "to": "prepare_resource_result",
        "schedule": true
      },
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"carry_preparation_context","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"read_host_resources","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"carry_execution_state","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"commit_host_resources","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "已备齐的执行请求或直接返回结论",
        "as": "era_task_initialize_prepared_task"
      }
    ]
  }
}
