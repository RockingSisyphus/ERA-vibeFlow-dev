{
  "nodeset_imports": [
    {"path": "startup_sync.jsonc"}
  ],
  "type_key": "era.task.initialize",
  "display_name": "ERA 初始化任务",
  "description": "规划并提交幂等设置、世界书、状态栏正则和角色主开场白示例资源；启动操作随后复用共享同步事务。",
  "requires": [
    {
      "type": "era.step.request.routed",
      "cardinality": "exactly_one",
      "display_name": "已路由步骤"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "initialize_task_result",
      "type": "era.task.result",
      "display_name": "初始化结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已路由步骤",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 20,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "初始化启动",
        "description": "启动一次初始化任务。"
      },
      {
        "id": "read_host_resources",
        "type_used": "era.tavern.initialization_read",
        "display_name": "读取状态栏初始化资源与主开场白",
        "description": "消费已准备步骤内的严格消息投影，并读取身份、脚本设置、世界书、角色正则和当前角色主开场白；备用开场白、当前聊天和历史聊天不进入初始化写入范围。"
      },
      {
        "id": "carry_execution_state",
        "type_used": "era.initialize.carry_execution_state",
        "display_name": "携带批次执行状态",
        "description": "无损携带外层批次执行状态，供条件启动的共享同步事务使用。"
      },
      {
        "id": "plan_resources",
        "type_used": "era.initialize.plan",
        "display_name": "规划 Tavern 原生状态栏片段与初始化资源",
        "description": "幂等规划设置、世界书、状态栏正则与主开场白示例变量；新状态栏是由 Tavern Helper 直接渲染的普通可嵌入片段，包含自有样式、ERA bootstrap、隐藏的状态栏根节点与使用 await ERA.ready() 的作者脚本，不再生成完整 html/head/body 或惰性 template。已发布旧式非托管状态栏保持原样且不自动迁移。"
      },
      {
        "id": "preserve_resources",
        "type_used": "era.initialize.no_change",
        "display_name": "保留现有资源",
        "description": "无动作或读取失败时保留计划并进入统一提交边界。"
      },
      {
        "id": "compute_resource_changes",
        "type_used": "era.initialize.compute",
        "display_name": "确认资源变更",
        "description": "保留纯规划器生成的声明式设置与资源变更。"
      },
      {
        "id": "build_resource_commit",
        "type_used": "era.initialize.build_commit",
        "display_name": "构造资源提交",
        "description": "形成有序 Capability 动作列表，不执行宿主写入。"
      },
      {
        "id": "commit_host_resources",
        "type_used": "era.tavern.initialization_commit",
        "display_name": "提交状态栏资源与主开场白示例",
        "description": "顺序应用声明式设置、世界书、状态栏正则和角色主开场白变更；以真实 avatar 更新 first_messages[0]，随后仅在当前聊天仍为空或只有一条未污染主开场白时刷新首楼并走真实消息渲染/保存链，多楼、编辑/污染、备用开场白和群聊保持原样；回执分别报告开场白与首楼刷新结果。"
      },
      {
        "id": "route_completion",
        "type_used": "era.initialize.build_result",
        "display_name": "选择初始化完成方式",
        "description": "将启动同步与资源直接结算分成不同数据类型，防止直接结果提前结束应继续进入 Sidecar 的启动同步。"
      },
      {
        "id": "startup_sync",
        "type_used": "era.task.startup_sync",
        "display_name": "执行启动历史同步",
        "description": "启动设置确认后，复用共享同步事务提交历史状态。"
      },
      {
        "id": "finalize_direct_result",
        "type_used": "era.initialize.finalize_direct_result",
        "display_name": "结算非启动初始化",
        "description": "仅在 finish 分支将专用的直接初始化结果转为任务结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "初始化结束",
        "description": "结束一次初始化任务。"
      }
    ],
    "edges": [
      [
        "start",
        "read_host_resources"
      ],
      [
        "start",
        "carry_execution_state"
      ],
      [
        "read_host_resources",
        "plan_resources"
      ],
      {
        "from": "plan_resources",
        "to": "preserve_resources",
        "when": "initialization_route == 'no-op'"
      },
      {
        "from": "plan_resources",
        "to": "compute_resource_changes",
        "when": "initialization_route == 'reconcile'"
      },
      [
        "preserve_resources",
        "build_resource_commit"
      ],
      [
        "compute_resource_changes",
        "build_resource_commit"
      ],
      [
        "build_resource_commit",
        "commit_host_resources"
      ],
      [
        "commit_host_resources",
        "route_completion"
      ],
      {
        "from": "route_completion",
        "to": "startup_sync",
        "when": "initialize_completion_route == 'sync'"
      },
      {
        "from": "carry_execution_state",
        "to": "startup_sync",
        "schedule": false
      },
      {
        "from": "route_completion",
        "to": "finalize_direct_result",
        "when": "initialize_completion_route == 'finish'"
      },
      [
        "startup_sync",
        "end"
      ],
      [
        "finalize_direct_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "初始化结果",
        "as": "initializeTaskResult"
      }
    ]
  }
}
