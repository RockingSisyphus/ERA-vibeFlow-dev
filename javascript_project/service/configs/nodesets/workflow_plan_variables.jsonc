{
  "type_key": "era.migration.service.plan_variables.workflow",
  "display_name": "校验编辑稿公式并形成变量操作",
  "description": "检查工作台草稿及变量路径；仅公式编辑提出求值请求，普通新增、删除和直接改值直接形成操作清单。输入无效时保留具体问题。 展开后可查看准备、原生同步调用、结果接回和继续判断。",
  "expand": true,
  "requires": [
    {
      "type": "era.workbench.draft",
      "cardinality": "exactly_one",
      "display_name": "用户尚待提交的变量或函数编辑稿"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "variable_operation_plan",
      "type": "era.workbench.operation_plan",
      "display_name": "根据编辑差异安排的操作清单"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input0",
        "type": "era.workbench.draft",
        "required": true,
        "display_name": "用户尚待提交的变量或函数编辑稿"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.service.terminal",
        "display_name": "开始本段处理",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      },
      {
        "id": "prepare",
        "display_name": "准备本段工作并判断是否需要调用",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：检查工作台草稿及变量路径；仅公式编辑提出求值请求，普通新增、删除和直接改值直接形成操作清单。输入无效时保留具体问题。",
        "definition_id": "era.migration.service.plan_variables.workflow.prepare"
      },
      {
        "id": "invoke_loop",
        "display_name": "按原顺序完成本段所需的同步调用",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：每次只调用当前确有需要的目标，接回结果后才判断下一次；次数由实际输入决定，不并发，不预先计算后续请求。",
        "definition_id": "vibeflow.loop.while",
        "requires": [
          {
            "type": "era.migration.service.plan_variables.state",
            "cardinality": "exactly_one",
            "display_name": "仅保留在当前工作流的业务进度"
          },
          {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
        ],
        "provides": [
          {
            "key": "final_state",
            "type": "era.migration.service.plan_variables.final",
            "display_name": "本段全部原生调用完成后的业务进度"
          }
        ],
        "loop": {
          "body": "era.migration.service.plan_variables.workflow.request_step",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.migration.service.plan_variables.state",
              "as": "state",
              "update": "next_state"
            },
            {"from":"era.workflow.host_resources","as":"host_resources","update":"retained_host_resources"}
          ],
          "outputs": [
            {
              "from": "next_state",
              "as": "final_state"
            }
          ]
        }
      },
      {
        "id": "skip_call",
        "display_name": "无需跨流程调用，直接保留本段结果",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：普通赋值、无候选或已发现输入问题时不调用目标，按原语义继续处理或返回诊断。",
        "definition_id": "era.migration.service.plan_variables.workflow.skip_call"
      },
      {
        "id": "finish",
        "display_name": "交出本段最终业务结果",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：读取本地完成进度，按原合同形成变量、诊断、函数候选或压缩结果；提交、保存和是否采用仍由原调用方决定。",
        "definition_id": "era.migration.service.plan_variables.workflow.finish"
      },
      {
        "id": "end",
        "definition_id": "era.service.terminal",
        "display_name": "完成本段处理",
        "description": "本步骤用于“校验编辑稿公式并形成变量操作”：标明本段流程的范围；业务结果由实际处理步骤提供。"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"prepare","schedule":true},
      {
        "from": "prepare",
        "to": "invoke_loop",
        "when": "needs_call == true"
      },
      {
        "from": "prepare",
        "to": "skip_call",
        "when": "needs_call == false"
      },
      [
        "invoke_loop",
        "finish"
      ],
      [
        "skip_call",
        "finish"
      ],
      [
        "finish",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"prepare","schedule":true},
      {"from":"retain_host_resources","to":"invoke_loop","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.workbench.operation_plan",
        "cardinality": "exactly_one",
        "display_name": "根据编辑差异安排的操作清单",
        "as": "variable_operation_plan"
      }
    ]
  }
}
