{
  "type_key": "era.sidecar.store",
  "status": "implemented",
  "flow_kind": "process",
  "display_name": "ERA Sidecar 状态存储",
  "description": "ERA 聊天状态的唯一领域存储节点集。它检查聊天 SidecarId 指针与身份，读取或迁移用户文件状态，处理冲突选择，并在成功读取或写入后发布易失宏快照。聊天变量仅保留 ERAMetaData.SidecarId；stat_data、SelectedMks、EditLogs、函数日志及 statFunc 只在 Sidecar 文件中读写。",
  "requires": [
    {
      "type": "era.sync.context",
      "cardinality": "exactly_one",
      "display_name": "同步上下文"
    }
  ],
  "provides": [
    {
      "key": "sidecar_binding_context",
      "type": "era.sync.context",
      "display_name": "已加载 Sidecar 状态的同步上下文"
    },
    {
      "key": "sidecar_binding_route",
      "type": "era.sidecar.binding.route",
      "display_name": "Sidecar 状态路由"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "sync_context",
        "type": "era.sync.context",
        "display_name": "同步上下文",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "Sidecar 状态存储启动",
        "description": "开始一次当前聊天状态加载或绑定事务。"
      },
      {
        "id": "inspect_current",
        "type_used": "era.sidecar_binding.inspect_current",
        "display_name": "读取并核对本次 Sidecar 事务来源",
        "description": "从真实派发上下文保留原聊天、消息/Swipe/原文依据；读取 Sidecar 前后比对身份和指针，读取失败或来源改变形成 failed 同步上下文，不把新聊天事实与旧消息拼接。"
      },
      {
        "id": "resolve_choice",
        "type_used": "era.sidecar_binding.resolve_choice",
        "display_name": "保留失败来源或解析绑定选择",
        "description": "源上下文已失败时直接沿原 continue 下游进入同步失败结算，禁止新弹窗和写入；正常情况下复用 create/migrate-legacy/matched/conflict/repair 的既有选择规则。"
      },
      {
        "id": "publish_choice_prompt",
        "type_used": "era.sidecar_binding.publish_choice_prompt",
        "display_name": "发布 Sidecar 冲突选择",
        "description": "显示 workflow 已决定的不可关闭选择提示。"
      },
      {
        "id": "apply_resolution",
        "type_used": "era.sidecar_binding.apply_resolution",
        "display_name": "按原来源执行恢复、确认保存并提交 Sidecar",
        "description": "用生产 activeText 构造恢复消息；复核原聊天/绑定/记录 revision，向消息写入、文件写入和指针提交传递 sourceBasis。只在消息持久化 confirmed 后更新本任务依据并继续文件/指针提交；来源变化或保存失败保留实际已写事实并进入既有同步失败结算，不自动重试，不回写新聊天。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "Sidecar 状态存储结束",
        "description": "输出已加载的同步上下文及路由。"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_current"
      ],
      [
        "inspect_current",
        "resolve_choice"
      ],
      {
        "from": "inspect_current",
        "to": "apply_resolution",
        "schedule": false
      },
      {
        "from": "resolve_choice",
        "to": "apply_resolution",
        "schedule": false
      },
      [
        "resolve_choice",
        "publish_choice_prompt"
      ],
      [
        "publish_choice_prompt",
        "apply_resolution"
      ],
      [
        "apply_resolution",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "已加载 Sidecar 状态的同步上下文",
        "as": "sidecarBindingContext"
      },
      {
        "type": "era.sidecar.binding.route",
        "cardinality": "exactly_one",
        "display_name": "Sidecar 状态路由",
        "as": "sidecarBindingRoute"
      }
    ]
  }
}
