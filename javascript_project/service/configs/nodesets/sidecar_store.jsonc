{
  "type_key": "era.sidecar.store",
  "status": "implemented",
  "flow_kind": "process",
  "display_name": "加载或修复聊天的独立状态文件",
  "description": "加载当前聊天使用的独立状态文件，文件中保存 ERA 变量、函数和历史日志。优先沿用同一聊天有效的内存结果；首次使用时建立绑定，旧数据需要时迁移，归属冲突或损坏时提示用户选择。执行选定的绑定方案后输出可用于历史同步的状态或等待、失败结果。",
  "requires": [
    {
      "type": "era.sync.context",
      "cardinality": "exactly_one",
      "display_name": "同步上下文"
    }
  ],
  "provides": [
    {
      "key": "sidecar_binding_context",
      "type": "era.sync.context",
      "display_name": "已加载 独立状态文件 状态的同步上下文"
    },
    {
      "key": "sidecar_binding_route",
      "type": "era.sidecar.binding.route",
      "display_name": "独立状态文件 状态路由"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "sync_context",
        "type": "era.sync.context",
        "display_name": "同步上下文",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "独立状态文件 状态存储启动",
        "description": "开始加载或修复聊天的独立状态文件。"
      },
      {
        "id": "inspect_current",
        "type_used": "era.sidecar_binding.inspect_current",
        "display_name": "读取并核对本次 独立状态文件 事务来源",
        "description": "本次处理当前聊天独立状态文件的绑定和加载。检查当前聊天指向的独立状态文件及聊天身份，优先使用同一有效绑定的内存变量、函数和日志，并识别需要恢复的未完成候选起点。"
      },
      {
        "id": "resolve_choice",
        "type_used": "era.sidecar_binding.resolve_choice",
        "display_name": "保留失败来源或解析绑定选择",
        "description": "本次处理当前聊天独立状态文件的绑定和加载。根据当前状态文件资料及用户选择，决定新建、迁移、继续使用或等待归属、修复选择；读取失败时保留其原因。"
      },
      {
        "id": "publish_choice_prompt",
        "type_used": "era.sidecar_binding.publish_choice_prompt",
        "display_name": "发布 独立状态文件 冲突选择",
        "description": "本次处理当前聊天独立状态文件的绑定和加载。向页面显示状态文件归属冲突或损坏的处理选项，携带聊天身份、文件归属和版本资料；已有有效选择时沿用该选择。"
      },
      {
        "id": "apply_resolution",
        "type_used": "era.sidecar_binding.apply_resolution",
        "display_name": "按原来源执行恢复、确认保存并提交 独立状态文件",
        "description": "本次处理当前聊天独立状态文件的绑定和加载。执行用户选定的状态文件新建、迁移或修复方案。先提交必要的消息修改，再写入文件及聊天绑定；核对聊天身份和文件版本，记录已完成部分及失败原因。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "独立状态文件 状态存储结束",
        "description": "结束加载或修复聊天的独立状态文件，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "inspect_current"
      ],
      [
        "inspect_current",
        "resolve_choice"
      ],
      {
        "from": "inspect_current",
        "to": "apply_resolution",
        "schedule": false
      },
      {
        "from": "resolve_choice",
        "to": "apply_resolution",
        "schedule": false
      },
      [
        "resolve_choice",
        "publish_choice_prompt"
      ],
      [
        "publish_choice_prompt",
        "apply_resolution"
      ],
      [
        "apply_resolution",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "已加载 独立状态文件 状态的同步上下文",
        "as": "sidecarBindingContext"
      },
      {
        "type": "era.sidecar.binding.route",
        "cardinality": "exactly_one",
        "display_name": "独立状态文件 状态路由",
        "as": "sidecarBindingRoute"
      }
    ]
  }
}
