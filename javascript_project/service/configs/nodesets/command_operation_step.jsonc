{
  "type_key": "era.command.operation_step",
  "display_name": "按原顺序处理一项变量或函数操作",
  "description": "根据当前指令和字段进度，选择新增、修改、删除变量，整组函数修改或阶段函数调用，记录结果后继续下一项。没有剩余操作时交出本段完整状态及问题，供消息流程继续。",
  "requires": [
    {
      "type": "era.command.operation.state",
      "cardinality": "exactly_one",
      "display_name": "有序操作、当前变量和函数及随机进度"
    }
  ],
  "provides": [
    {
      "key": "operation_state_after",
      "type": "era.command.operation.state.next",
      "display_name": "本项操作后的变量和下一操作进度"
    },
    {
      "key": "operation_done",
      "type": "era.command.operation.done",
      "display_name": "本范围的有序操作是否全部结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "operation_state",
        "type": "era.command.operation.state",
        "display_name": "有序操作、当前变量和函数及随机进度",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按原顺序处理一项变量或函数操作",
        "description": "标明“按原顺序处理一项变量或函数操作”的开始位置。根据当前指令和字段进度，选择新增、修改、删除变量，整组函数修改或阶段函数调用，记录结果后继续下一项。没有剩余操作时交出本段完整状态及问题，供消息流程继续。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "select_operation",
        "display_name": "选择下一项要执行的变量或函数操作",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，按消息指令原有顺序和字段进度，选择新增、修改、删除变量，整组修改函数，或执行阶段函数调用。没有剩余内容时形成完整结果，使同一指令清单按顺序执行到结束。",
        "definition_id": "era.command.select_business_operation"
      },
      {
        "id": "apply_insert",
        "display_name": "新增变量并补齐需要的模板字段",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，按指令选择新增位置，补齐模板要求的字段，加入新值并记录可回退的历史。对象内字段按既定顺序继续处理，供后续指令使用新增结果。",
        "definition_id": "era.command.apply_insert_action"
      },
      {
        "id": "apply_edit",
        "display_name": "修改变量或计算它的新值",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，读取当前指令指定的变量，直接赋值或计算公式后更新本轮状态，并记录变更。公式使用执行到此处的变量、历史起点和随机进度；无效操作保留原因，供继续处理及历史回退。",
        "definition_id": "era.command.apply_edit_action"
      },
      {
        "id": "apply_delete",
        "display_name": "删除指定变量并留下可回退记录",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，按当前指令删除目标变量或指定子字段，记录删除前的内容，供以后切换回复或回退历史恢复。需要检查的子字段按原顺序继续处理，无效目标带回具体原因。",
        "definition_id": "era.command.apply_delete_action"
      },
      {
        "id": "apply_function_group",
        "display_name": "整组检查并应用函数库修改",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，在当前自定义函数库的临时副本上，依序处理本组新增、修改、删除和属性变化。完整检查通过才整组采用并记录历史；有错误则保留原函数库和具体问题，避免只改成一半。",
        "definition_id": "era.command.apply_function_group_action"
      },
      {
        "id": "apply_stage_call",
        "display_name": "计算生成阶段安排的函数调用",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，接收规划或结算阶段指定的一项函数调用，使用当前变量、函数、历史起点和随机进度计算并收集结果。失败时记录原因并将阶段调用标为失败，供生成阶段决定后续处理。",
        "definition_id": "era.command.apply_stage_call_action"
      },
      {
        "id": "skip_operation",
        "display_name": "保留状态并略过本项无效操作",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，目标不存在、受到保护或格式按规则需要跳过时，保留当前变量及进度，并留下相应原因。之后完成本项进度整理，让后面的指令仍按既定规则处理。",
        "definition_id": "era.command.skip_operation"
      },
      {
        "id": "settle_operation",
        "display_name": "保留当前计算结果并准备下一项",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，当前操作完成或按规则跳过后，清理这项临时记录，保留更新后的变量、函数、历史和待处理内容。下一轮据此继续下个字段或操作，而不会重复执行当前项。",
        "definition_id": "era.command.settle_operation"
      },
      {
        "id": "complete_operations",
        "display_name": "交出本段指令计算后的完整状态",
        "description": "在“按原顺序处理一项变量或函数操作”流程中，当前范围内的变量字段、整组函数修改或阶段调用都处理完后，交出变量、函数、历史记录、问题和随机使用进度。消息流程据此更新正文进度或生成阶段结果。",
        "definition_id": "era.command.complete_operations"
      },
      {
        "id": "end",
        "display_name": "结束按原顺序处理一项变量或函数操作",
        "description": "标明“按原顺序处理一项变量或函数操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "select_operation"
      ],
      {
        "from": "select_operation",
        "to": "apply_insert",
        "when": "take_next_operation_operation_route == 'insert'"
      },
      {
        "from": "select_operation",
        "to": "apply_edit",
        "when": "take_next_operation_operation_route == 'edit'"
      },
      {
        "from": "select_operation",
        "to": "apply_delete",
        "when": "take_next_operation_operation_route == 'delete'"
      },
      {
        "from": "select_operation",
        "to": "apply_function_group",
        "when": "take_next_operation_operation_route == 'function-group'"
      },
      {
        "from": "select_operation",
        "to": "apply_stage_call",
        "when": "take_next_operation_operation_route == 'stage-call'"
      },
      {
        "from": "select_operation",
        "to": "skip_operation",
        "when": "take_next_operation_operation_route == 'skip'"
      },
      {
        "from": "select_operation",
        "to": "complete_operations",
        "when": "take_next_operation_operation_route == 'done'"
      },
      [
        "apply_insert",
        "settle_operation"
      ],
      [
        "apply_edit",
        "settle_operation"
      ],
      [
        "apply_delete",
        "settle_operation"
      ],
      [
        "apply_function_group",
        "settle_operation"
      ],
      [
        "apply_stage_call",
        "settle_operation"
      ],
      [
        "skip_operation",
        "settle_operation"
      ],
      [
        "settle_operation",
        "end"
      ],
      [
        "complete_operations",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command.operation.state.next",
        "cardinality": "exactly_one",
        "display_name": "本项操作后的变量和下一操作进度",
        "as": "operation_state_after"
      },
      {
        "type": "era.command.operation.done",
        "cardinality": "exactly_one",
        "display_name": "本范围的有序操作是否全部结束",
        "as": "operation_done"
      }
    ]
  }
}
