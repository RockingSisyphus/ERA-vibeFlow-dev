{
  "type_key": "era.command.operation_step",
  "status": "planned",
  "display_name": "块内操作：有序遍历、保护、模板、公式与日志",
  "description": "对一个正文指令块或 Agent 阶段函数表反复执行有序微操作。显式栈保留父路径、字段索引及模板，字段轮到时读取前一项完成后的值；变量增删改分别判断保护并生成日志，函数定义先形成完整候选库再统一校验，公式调用已有 Expression root。当前值、楼层快照、函数库快照和随机位置分别携带；微操作不发布块完成、不封存楼层、不保存宿主，完整结果只交回消息块层。",
  "requires": [
    {
      "type": "era.command.operation.state",
      "cardinality": "exactly_one",
      "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
    }
  ],
  "provides": [
    {
      "key": "operation_state_after",
      "type": "era.command.operation.state.next",
      "display_name": "下一轮操作状态或完整块内结果"
    },
    {
      "key": "operation_done",
      "type": "era.command.operation.done",
      "display_name": "当前操作范围结束标志"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input_0",
        "type": "era.command.operation.state",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志",
        "required": true
      }
    ],
    "max_steps": 43,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "块内操作迭代开始",
        "description": "标记这段流程的入口或出口，业务数据由声明的通道传递；本节点不修改变量、不调用作者函数，也不保存酒馆。"
      },
      {
        "id": "take_next_operation",
        "type_used": "era.command.take_next_operation",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "取出下一项：先完成当前子树",
        "description": "从当前指令、数组根项和显式待处理栈取得下一项。对象字段按原 Object.keys 顺序深度优先访问，进入子对象后先处理完它再回父级；每次访问都读取前一项完成后的工作值，不预先把全对象展开后批量求值。函数根对象另保留整组候选和统一校验位置。 函数 meta 删除也使用此栈，子路径结束后返回同组函数候选，不写变量状态。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "operation_route",
            "type": "era.command.operation.route",
            "display_name": "新增/修改/删除、函数组/定义/整组校验、阶段调用、跳过或结束"
          }
        ]
      },
      {
        "id": "inspect_insert",
        "type_used": "era.command.inspect_insert",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "检查新增路径与插入保护",
        "description": "读取当前路径是否已存在、父对象和 unInsertAble（禁止新增）保护。已有对象按原顺序进入子字段，缺失路径准备整体插入；all 阻止普通子树插入，self 阻止新增直属键，合法 meta 维护仍按原规则处理。输出进入子树、应用新增或跳过的明确分支，尚未改变变量。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "insert_route",
            "type": "era.command.insert.route",
            "display_name": "进入子对象、应用新增或跳过"
          }
        ]
      },
      {
        "id": "inherit_insert_template",
        "type_used": "era.command.inherit_insert_template",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "合并继承模板与本地默认值",
        "description": "为即将插入的路径取得沿父级继承的模板，再合并父对象本地 $template 和当前明确内容，本地及显式值按原优先级覆盖。数组按原整体替换规则，模板不追溯改已有对象；将结果和值复制到新增动作，不提前写入其他字段。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "apply_insert",
        "type_used": "era.command.apply_insert",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "应用新增值到内存工作副本",
        "description": "将已通过路径和保护判断、已完成模板合并的值写到当前缺失路径，按原清理与 own-property 规则处理特殊键和数组。仅修改本块私有变量工作副本，并形成原子新增记录；不保存消息、不回执块完成。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "inspect_edit",
        "type_used": "era.command.inspect_edit",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "检查修改保护并区分赋值与公式",
        "description": "读取当前路径和 updatable（允许修改）保护；缺失目标按原规则跳过，显式修改 meta 解锁仍按原通路处理。已有对象补丁进入子字段，直接值走赋值，单键 $expr 走公式；旧控制键、空公式或非数值目标产生原诊断，不把错误转成默认值。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "edit_route",
            "type": "era.command.edit.route",
            "display_name": "进入子对象、直接赋值、公式或跳过"
          }
        ]
      },
      {
        "id": "apply_assignment",
        "type_used": "era.command.apply_assignment",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "记录正确历史旧值并赋新值",
        "description": "对已允许修改的现有路径，按历史日志取得最近应作为修改旧值的值；没有对应历史记录时才使用当前值。清理和复制新值后写入工作副本，形成旧值/新值记录。后一项因此读到更新值，日志仍能按原规则回退；这里尚未保存。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "prepare_value_expression",
        "type_used": "era.command.prepare_value_expression",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "为当前路径构造公式请求",
        "description": "把当前已更新的变量和函数库、消息楼层起点的变量/函数快照分开装入请求，带上消息 ERA 标识 MK 所确定的稳定随机来源和已使用的随机次数，使同一消息的重算继续原序列。只求这一个路径的 $expr，支持当前值与历史快照各自的含义；请求不包含宿主写入，也不提前改变目标。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "expression_request",
            "type": "era.command.expression.request",
            "display_name": "含当前/快照函数库、随机游标及用途的表达式请求"
          }
        ]
      },
      {
        "id": "inspect_delete",
        "type_used": "era.command.inspect_delete",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "检查删除形状与 necessary 保护",
        "description": "按当前路径的 necessary（防误删保留规则）判断删除：all 保留子树，children 阻止用空对象直接删除直属子项，self 保留自身但允许按规则继续子路径。非空对象补丁按原字段顺序深入，空对象才尝试原子删除；meta 解除保护通路和根对象不能整体删除的规则不变。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "delete_route",
            "type": "era.command.delete.route",
            "display_name": "进入子路径、原子删除或跳过"
          }
        ]
      },
      {
        "id": "apply_delete",
        "type_used": "era.command.apply_delete",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "删除一个允许删除的路径并记旧值",
        "description": "复制将被删除路径的实际旧值，从当前工作副本移除该路径，生成一条原子删除日志。已在保护判断中跳过的路径不会到这里；删除只影响内存工作值，不把子树遍历的小步骤当成整个消息块已完成。 函数 meta 删除时目标为候选定义副本，原函数库仍未提交。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "push_child_paths",
        "type_used": "era.command.push_child_paths",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "保存父位置并逐字段深入",
        "description": "在待处理栈中保存父对象的位置、字段顺序和下一个字段索引，再进入当前子项，继承本次操作种类及模板上下文。后续字段在轮到它时重新读取更新后的状态；不复制第二套 CRUD，不为每个对象再增加 Nodeset 层级。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "inspect_function_group",
        "type_used": "era.command.inspect_function_group",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "先核对整组函数名与操作形状",
        "description": "针对当前函数指令的一个非空根对象，先检查组内全部名字：新增不得覆盖既有函数，修改必须存在，删除补丁只能采用原有空对象或 meta 形式。任何名字/格式无效就拒绝这一组并保留诊断；有效才复制完整函数库作候选，确保后续前向引用不会被逐函数提交破坏。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "function_group_route",
            "type": "era.command.function.group.route",
            "display_name": "建立候选或拒绝整组"
          }
        ]
      },
      {
        "id": "begin_function_candidate",
        "type_used": "era.command.begin_function_candidate",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "建立整组函数候选及恢复起点",
        "description": "复制当前完整函数库，保存这一组开始前的函数库和日志起点，再按原名字顺序准备各定义。候选修改不会立即进入当前可调用函数库；整组都收集完成后才交 Expression 校验，数组里的下一根仍按原顺序处理。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "prepare_function_insert",
        "type_used": "era.command.prepare_function_insert",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "准备函数新增定义",
        "description": "复制当前待新增函数的定义和元数据，记录候选新增动作。此前整组名字检查已经确认名称不存在；这一轮只准备该定义，尚未提交函数库，其他同组函数稍后仍可引用它。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "prepare_function_edit",
        "type_used": "era.command.prepare_function_edit",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "准备函数修改与元数据继承",
        "description": "读取既有函数，按原规则替换定义或只更新 $meta；补丁未指定 meta 时保留原 meta，指定时采用原合并规则。updatable=false 的函数只在补丁明确解锁时允许修改；得到候选动作或保护跳过，不立即改当前函数库。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          }
        ]
      },
      {
        "id": "prepare_function_delete",
        "type_used": "era.command.prepare_function_delete",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "准备函数删除或 meta 删除",
        "description": "空对象补丁准备整个函数的删除，necessary=self/all 的函数保留；meta 补丁转入同一有序路径栈，按原删除规则逐字段处理定义副本的 $meta。不存在的函数按原规则跳过。这里只准备或修改候选定义，不提交当前函数库；整组仍须统一校验。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "function_delete_route",
            "type": "era.command.function.delete.route",
            "display_name": "整函数候选动作或进入元数据路径删除"
          }
        ]
      },
      {
        "id": "check_function_metadata",
        "type_used": "era.command.check_function_metadata",
        "status": "planned",
        "flow_kind": "decision",
        "display_name": "核对函数保护元数据及本项结论",
        "description": "检查准备后的定义是否使用函数实体支持的元数据。函数是平面实体，不支持 unInsertAble 或 necessary=children；此类错误拒绝整组候选，已有保护导致的合法跳过只跳过当前项。通过的动作才进入候选库，保持原错误类别与保护行为。",
        "requires": [
          {
            "type": "era.command.operation.state",
            "cardinality": "exactly_one",
            "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
          }
        ],
        "provides": [
          {
            "key": "operation_state",
            "type": "era.command.operation.state",
            "display_name": "本次微操作后的私有工作状态；块尚未完成"
          },
          {
            "key": "function_item_route",
            "type": "era.command.function.item.route",
            "display_name": "收集本项、合法跳过或拒绝整组"
          }
        ]
      },
      {
        "id": "stage_function_change",
        "type_used": "era.command.stage_function_change",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "将本项纳入候选，不发布函数库",
        "description": "把合法新增、修改或删除写入整组候选库，并保留每个名字的旧/新定义和原顺序。当前工作函数库仍保持组起点；下一次循环继续收集定义，直到出现独立的“整组校验”项。",
        "requires": [
          {
