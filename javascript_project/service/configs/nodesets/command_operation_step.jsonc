{
  "type_key": "era.command.operation_step",
  "display_name": "处理消息指令中的一项变量或函数操作",
  "description": "按指令和对象字段的原有顺序执行一次业务操作：新增、修改或删除变量，整体修改一组函数，或计算生成阶段函数调用。每项动作完成自身检查、计算和日志记录，返回下一项进度；处理结束后输出完整变量、函数、日志和诊断。",
  "requires": [
    {
      "type": "era.command.operation.state",
      "cardinality": "exactly_one",
      "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志"
    }
  ],
  "provides": [
    {
      "key": "operation_state_after",
      "type": "era.command.operation.state.next",
      "display_name": "下一项操作进度或本段完整结果"
    },
    {
      "key": "operation_done",
      "type": "era.command.operation.done",
      "display_name": "本段操作是否已完成"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "operation_state",
        "type": "era.command.operation.state",
        "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "块内操作迭代开始",
        "description": "开始处理消息指令中的一项变量或函数操作。"
      },
      {
        "id": "select_operation",
        "type_used": "era.command.select_business_operation",
        "display_name": "按原顺序选择下一项指令操作",
        "description": "从指令的有序操作和字段遍历进度中选择新增变量、修改变量、删除变量、整组函数修改或生成阶段函数调用。没有剩余操作时形成本段完整结果。"
      },
      {
        "id": "apply_insert",
        "type_used": "era.command.apply_insert_action",
        "display_name": "新增变量并记录变更",
        "description": "根据指令选择目标变量，补齐该变量需要的模板字段，应用新增值并记录可回退的变更；对象内部的字段加入原有遍历顺序。"
      },
      {
        "id": "apply_edit",
        "type_used": "era.command.apply_edit_action",
        "display_name": "修改变量，按需计算公式",
        "description": "读取指令指定的变量，直接赋值或计算公式，再写入结果并记录变更。公式按执行到此处的变量、历史起点和随机进度求值；无效操作记录原因并继续原遍历。"
      },
      {
        "id": "apply_delete",
        "type_used": "era.command.apply_delete_action",
        "display_name": "删除变量并记录变更",
        "description": "按指令删除目标变量或其指定字段，记录删除前的值供历史回退；需要遍历的子字段依次处理，无效目标保留具体原因。"
      },
      {
        "id": "apply_function_group",
        "type_used": "era.command.apply_function_group_action",
        "display_name": "修改整组函数，通过检查后整体应用",
        "description": "在当前函数库的候选副本上依次处理这一组新增、修改、删除及元数据操作，检查名称、元数据和完整函数库。整组有效时一次应用并记录日志，有误时保留原函数库和具体诊断。"
      },
      {
        "id": "apply_stage_call",
        "type_used": "era.command.apply_stage_call_action",
        "display_name": "执行生成阶段安排的函数调用",
        "description": "按生成阶段的调用顺序，使用当前变量、函数、历史起点和随机进度计算本次调用，收集结果供阶段使用；失败时记录具体原因并形成阶段调用失败结果。"
      },
      {
        "id": "skip_operation",
        "type_used": "era.command.skip_operation",
        "display_name": "保留跳过操作后的工作状态",
        "description": "本次处理消息指令中的一项变量、函数或公式操作。在目标不存在、保护规则拦截或操作格式应跳过时，保留当前变量和处理进度。随后交给进度整理节点结束本项，使循环能够继续检查后面的操作。"
      },
      {
        "id": "settle_operation",
        "type_used": "era.command.settle_operation",
        "display_name": "整理当前操作并准备继续",
        "description": "本次处理消息指令中的一项变量、函数或公式操作。清除刚完成或已跳过的操作记录，保留更新后的变量、函数、日志及待处理列表。下一轮据此选择后续字段、下一组函数或下一项阶段调用。"
      },
      {
        "id": "complete_operations",
        "type_used": "era.command.complete_operations",
        "display_name": "返回本段操作的完整结果",
        "description": "本次处理消息指令中的一项变量、函数或公式操作。当前消息指令的全部字段、整组函数检查或阶段函数清单处理结束后，输出当前变量、函数、历史记录、诊断和随机进度，并标记本段操作已完成。消息流程接着更新正文记录或生成阶段结果。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "块内操作迭代结束",
        "description": "结束处理消息指令中的一项变量或函数操作，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "select_operation"
      ],
      {
        "from": "select_operation",
        "to": "apply_insert",
        "when": "take_next_operation_operation_route == 'insert'"
      },
      {
        "from": "select_operation",
        "to": "apply_edit",
        "when": "take_next_operation_operation_route == 'edit'"
      },
      {
        "from": "select_operation",
        "to": "apply_delete",
        "when": "take_next_operation_operation_route == 'delete'"
      },
      {
        "from": "select_operation",
        "to": "apply_function_group",
        "when": "take_next_operation_operation_route == 'function-group'"
      },
      {
        "from": "select_operation",
        "to": "apply_stage_call",
        "when": "take_next_operation_operation_route == 'stage-call'"
      },
      {
        "from": "select_operation",
        "to": "skip_operation",
        "when": "take_next_operation_operation_route == 'skip'"
      },
      {
        "from": "select_operation",
        "to": "complete_operations",
        "when": "take_next_operation_operation_route == 'done'"
      },
      [
        "apply_insert",
        "settle_operation"
      ],
      [
        "apply_edit",
        "settle_operation"
      ],
      [
        "apply_delete",
        "settle_operation"
      ],
      [
        "apply_function_group",
        "settle_operation"
      ],
      [
        "apply_stage_call",
        "settle_operation"
      ],
      [
        "skip_operation",
        "settle_operation"
      ],
      [
        "settle_operation",
        "end"
      ],
      [
        "complete_operations",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.command.operation.state.next",
        "cardinality": "exactly_one",
        "display_name": "下一项操作进度或本段完整结果",
        "as": "operation_state_after"
      },
      {
        "type": "era.command.operation.done",
        "cardinality": "exactly_one",
        "display_name": "本段操作是否已完成",
        "as": "operation_done"
      }
    ]
  }
}
