        "from": "check_function_metadata",
        "to": "skip_operation",
        "when": "function_item_route == 'skip'"
      },
      {
        "from": "check_function_metadata",
        "to": "discard_function_candidate",
        "when": "function_item_route == 'invalid'"
      },
      [
        "inherit_insert_template",
        "apply_insert"
      ],
      [
        "apply_insert",
        "append_operation_log"
      ],
      [
        "apply_assignment",
        "append_operation_log"
      ],
      [
        "apply_delete",
        "append_operation_log"
      ],
      [
        "apply_expression_value",
        "append_operation_log"
      ],
      [
        "prepare_function_insert",
        "check_function_metadata"
      ],
      [
        "prepare_function_edit",
        "check_function_metadata"
      ],
      [
        "prepare_value_expression",
        "evaluate_expression"
      ],
      [
        "prepare_library_validation",
        "evaluate_expression"
      ],
      [
        "prepare_stage_call",
        "evaluate_expression"
      ],
      [
        "evaluate_expression",
        "route_expression_result"
      ],
      {
        "from": "route_expression_result",
        "to": "apply_expression_value",
        "when": "expression_route == 'value'"
      },
      {
        "from": "route_expression_result",
        "to": "record_operation_diagnostic",
        "when": "expression_route == 'value-failed'"
      },
      {
        "from": "route_expression_result",
        "to": "apply_function_candidate",
        "when": "expression_route == 'library'"
      },
      {
        "from": "route_expression_result",
        "to": "discard_function_candidate",
        "when": "expression_route == 'library-failed'"
      },
      {
        "from": "route_expression_result",
        "to": "accept_stage_call_result",
        "when": "expression_route == 'stage-call'"
      },
      {
        "from": "route_expression_result",
        "to": "fail_stage_call_table",
        "when": "expression_route == 'stage-call-failed'"
      },
      [
        "push_child_paths",
        "settle_operation"
      ],
      [
        "begin_function_candidate",
        "settle_operation"
      ],
      [
        "stage_function_change",
        "settle_operation"
      ],
      [
        "apply_function_candidate",
        "settle_operation"
      ],
      [
        "accept_stage_call_result",
        "settle_operation"
      ],
      [
        "record_operation_diagnostic",
        "settle_operation"
      ],
      [
        "discard_function_candidate",
        "settle_operation"
      ],
      [
        "fail_stage_call_table",
        "settle_operation"
      ],
      [
        "append_operation_log",
        "settle_operation"
      ],
      [
        "skip_operation",
        "settle_operation"
      ],
      [
        "settle_operation",
        "end"
      ],
      [
        "complete_operations",
        "end"
      ],
      {
        "from": "prepare_function_delete",
        "to": "check_function_metadata",
        "when": "function_delete_route == 'whole'"
      },
      {
        "from": "prepare_function_delete",
        "to": "begin_function_meta_delete",
        "when": "function_delete_route == 'meta'"
      },
      [
        "begin_function_meta_delete",
        "settle_operation"
      ],
      {
        "from": "take_next_operation",
        "to": "finish_function_meta_delete",
        "when": "operation_route == 'function-meta-complete'"
      },
      [
        "finish_function_meta_delete",
        "check_function_metadata"
      ]
    ],
    "outputs": [
      {
        "type": "era.command.operation.state.next",
        "cardinality": "exactly_one",
        "display_name": "下一轮操作状态或完整块内结果",
        "as": "operation_state_after"
      },
      {
        "type": "era.command.operation.done",
        "cardinality": "exactly_one",
        "display_name": "当前操作范围结束标志",
        "as": "operation_done"
      }
    ]
  }
}
