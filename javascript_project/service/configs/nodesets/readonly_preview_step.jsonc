{
  "type_key": "era.sync.preview_step",
  "display_name": "只读重算历史中的一个正文位置",
  "description": "按现有消息历史与正文顺序选择当前内容，变量和函数指令使用正式操作流程计算，其他内容仅推进位置。结束或失败时交出明确状态，不调用作者函数、不改写聊天，用于准备生成阶段起点。",
  "requires": [
    {
      "type": "era.sync.preview.state",
      "cardinality": "exactly_one",
      "display_name": "只读历史重算的当前位置和变量"
    }
  ],
  "provides": [
    {
      "key": "state_next",
      "type": "era.sync.preview.state.next",
      "display_name": "只读重算后的下一位置或结束结果"
    },
    {
      "key": "iteration_done",
      "type": "era.command.operation.done",
      "display_name": "本范围的有序操作是否全部结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "preview_state",
        "type": "era.sync.preview.state",
        "display_name": "只读历史重算的当前位置和变量",
        "required": true
      }
    ],
    "max_steps": 35,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.service.terminal",
        "display_name": "开始只读重算历史中的一个正文位置",
        "description": "标明“只读重算历史中的一个正文位置”的开始位置。按现有消息历史与正文顺序选择当前内容，变量和函数指令使用正式操作流程计算，其他内容仅推进位置。结束或失败时交出明确状态，不调用作者函数、不改写聊天，用于准备生成阶段起点。"
      },
      {
        "id": "select_position",
        "display_name": "选择只读历史重算的下一段内容",
        "description": "在“只读重算历史中的一个正文位置”流程中，根据历史和消息位置判断当前是否有变量指令可计算，还是应略过普通内容、结束或报告失败。供只读预演按真实消息顺序推进，生成下一阶段需要的变量起点。",
        "definition_id": "era.readonly_preview_step.select_position"
      },
      {
        "id": "prepare_operations",
        "display_name": "准备只读重算当前位置的指令",
        "description": "在“只读重算历史中的一个正文位置”流程中，从历史预演当前的变量、函数、历史记录和随机位置出发，整理本段变量及函数指令。交给与正式消息相同的操作流程，结果只用于还原起点。",
        "definition_id": "era.readonly_preview_step.prepare_operations"
      },
      {
        "id": "apply_operations",
        "definition_id": "era.command.apply_operations",
        "display_name": "完成指定范围内的有序变量和函数操作",
        "description": "本环节用于“只读重算历史中的一个正文位置”：接收要处理的操作及起始变量、函数和随机位置，按顺序重复单项操作流程，直到本范围结束。正式消息、历史压缩比较和只读预演共用这一规则，返回各自结果供相应场景使用。"
      },
      {
        "id": "accept_operations",
        "display_name": "采用只读指令结果并推进正文",
        "description": "在“只读重算历史中的一个正文位置”流程中，接收只读重算得到的变量、函数、历史、问题和随机进度，合入预演状态并移到下一正文位置。遇到失败明确结束，供下一生成阶段得到可信的起点或原因。",
        "definition_id": "era.readonly_preview_step.accept_operations"
      },
      {
        "id": "advance_position",
        "display_name": "略过无需计算的正文或结束预演",
        "description": "在“只读重算历史中的一个正文位置”流程中，按历史规则推进当前没有变量指令的内容，并在到达结尾或失败时交出终态。只读预演不执行作者函数，让生成起点重建保持为可控的历史计算。",
        "definition_id": "era.readonly_preview_step.advance_position"
      },
      {
        "id": "end",
        "definition_id": "era.service.terminal",
        "display_name": "结束只读重算历史中的一个正文位置",
        "description": "标明“只读重算历史中的一个正文位置”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。"
      }
    ],
    "edges": [
      [
        "start",
        "select_position"
      ],
      {
        "from": "select_position",
        "to": "prepare_operations",
        "when": "route == 'command'"
      },
      [
        "prepare_operations",
        "apply_operations"
      ],
      [
        "apply_operations",
        "accept_operations"
      ],
      {
        "from": "select_position",
        "to": "accept_operations",
        "schedule": false,
        "when": "route == 'command'"
      },
      {
        "from": "select_position",
        "to": "advance_position",
        "when": "route == 'advance'"
      },
      [
        "accept_operations",
        "end"
      ],
      [
        "advance_position",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.sync.preview.state.next",
        "cardinality": "exactly_one",
        "display_name": "只读重算后的下一位置或结束结果",
        "as": "state_next"
      },
      {
        "type": "era.command.operation.done",
        "cardinality": "exactly_one",
        "display_name": "本范围的有序操作是否全部结束",
        "as": "iteration_done"
      }
    ]
  }
}
