{
  "type_key": "era.api.write",
  "display_name": "ERA 写入 API 事务",
  "description": "显式路由六个公开写入 API，先确认消息指令追加，再复用同一同步任务提交状态；部分或未知提交必须 fatal。",
  "requires": [
    {
      "type": "era.api.request",
      "cardinality": "exactly_one",
      "display_name": "规范化 API 请求"
    },
    {
      "type": "era.batch.execution.state",
      "cardinality": "exactly_one",
      "display_name": "当前批次执行状态"
    }
  ],
  "provides": [
    {
      "key": "write_api_result",
      "type": "era.task.result.merged",
      "display_name": "写入 API 结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "api_request",
        "type": "era.api.request",
        "display_name": "规范化 API 请求",
        "required": true
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次执行状态",
        "required": true
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "写入 API 开始",
        "description": "开始一条由原 API receipt 覆盖的消息与状态逻辑事务。"
      },
      {
        "id": "prepare_write_context",
        "type_used": "era.api.prepare_execution_context",
        "display_name": "准备写事务上下文",
        "description": "把 API 请求与当前批次状态放入同一显式数据节点，保证后续共享同步取得原批次状态。"
      },
      {
        "id": "route_write",
        "type_used": "era.api.route_write",
        "display_name": "选择六个写入操作",
        "description": "按公开事件名选择对象插入、对象更新、路径插入、路径更新、对象删除或路径删除。"
      },
      {
        "id": "normalize_safe_object_payload",
        "type_used": "era.api.normalize_safe_object",
        "display_name": "安全规范化兼容对象",
        "description": "在公开对象 payload 入口应用统一可移植 JSON 规则：安全提升自有 __proto__ 子字段、保留 constructor/prototype，并与消息 CRUD、通知和查询共享同一无原型语义。"
      },
      {
        "id": "insert_by_object",
        "type_used": "era.api.prepare_insert_object",
        "display_name": "按对象插入（era:insertByObject）",
        "description": "构造候选格式的 VariableInsert 对象块，不执行宿主写入。"
      },
      {
        "id": "update_by_object",
        "type_used": "era.api.prepare_update_object",
        "display_name": "按对象更新（era:updateByObject）",
        "description": "构造候选格式的 VariableEdit 对象块，不执行宿主写入。"
      },
      {
        "id": "insert_by_path",
        "type_used": "era.api.prepare_insert_path",
        "display_name": "按路径插入（era:insertByPath）",
        "description": "按 lodash 兼容路径构造 VariableInsert 嵌套对象，不执行宿主写入。"
      },
      {
        "id": "update_by_path",
        "type_used": "era.api.prepare_update_path",
        "display_name": "按路径更新（era:updateByPath）",
        "description": "按 lodash 兼容路径构造 VariableEdit 嵌套对象，不执行宿主写入。"
      },
      {
        "id": "delete_by_object",
        "type_used": "era.api.prepare_delete_object",
        "display_name": "按对象删除（era:deleteByObject）",
        "description": "构造候选格式的 VariableDelete 对象块，不执行宿主写入。"
      },
      {
        "id": "delete_by_path",
        "type_used": "era.api.prepare_delete_path",
        "display_name": "按路径删除（era:deleteByPath）",
        "description": "按 lodash 兼容路径构造空对象删除结构，不执行宿主写入。"
      },
      {
        "id": "read_target_messages",
        "type_used": "era.api.read_write_messages",
        "display_name": "读取严格写入目标消息",
        "description": "以 projection=era-active-message-v1 挂起读取严格消息 DTO；仅提供 messageId、role、activeText 与 swipeIndex，不把附件或宿主对象送入工作流。"
      },
      {
        "id": "build_message_append",
        "type_used": "era.api.build_message_append",
        "display_name": "构造当前文本追加",
        "description": "从严格 DTO 选择最后一条 AI 消息，只声明 messageId、目标 swipe 与新 activeText；附件和未知宿主字段不跨边界。"
      },
      {
        "id": "commit_message_append",
        "type_used": "era.api.commit_message_append",
        "display_name": "保真提交当前文本",
        "description": "通过挂起式 Capability 只修改宿主当前激活文本并声明 affected 刷新，附件和未知字段由 Host 原位保留；无法证明已提交或未写入时标为未知。"
      },
      {
        "id": "route_message_append",
        "type_used": "era.api.route_message_append",
        "display_name": "判定消息追加结果",
        "description": "明确选择继续状态同步、确认未写普通失败或未知提交 fatal。"
      },
      {
        "id": "read_committed_messages",
        "type_used": "era.api.read_committed_messages",
        "display_name": "读取已提交消息快照",
        "description": "在消息追加已确认后，以 era-active-message-v1 严格投影重新读取完整聊天，取得同步实际应消费的提交后快照。"
      },
      {
        "id": "prepare_post_commit_context",
        "type_used": "era.api.prepare_post_commit_context",
        "display_name": "校验并准备提交后同步上下文",
        "description": "验证目标消息唯一存在且 activeText 与已提交文本一致；成功时更新同步消息快照并保留不可变 processing message/MK，失败时声明 fatal 上下文。"
      },
      {
        "id": "build_post_commit_context_failure",
        "type_used": "era.api.build_post_commit_context_failure",
        "display_name": "构造提交后上下文失败",
        "description": "把已写消息后的读回或一致性失败转换为逐来源 failed settlement 和诊断，交由 API finalizer 统一升级为 fatal。"
      },
      {
        "id": "mark_append_fatal",
        "type_used": "era.api.mark_append_fatal",
        "display_name": "标记未知消息提交",
        "description": "让 fatal 条件经过独立节点后汇入统一失败构造，避免同源同目标条件边被折叠。"
      },
      {
        "id": "build_append_failure",
        "type_used": "era.api.build_append_failure",
        "display_name": "构造追加失败结果",
        "description": "对确认未写返回 failed；对部分或未知提交返回 fatal 并要求一致性扫描。"
      },
      {
        "id": "build_sync_step",
        "type_used": "era.api.build_sync_step",
        "display_name": "构造因果同步步骤",
        "description": "从已校验的提交后严格消息快照构造标准同步步骤；复用原 API 来源和不可变 processing message/MK，dispatchClass=api 且不推进连续 carry。"
      },
      {
        "id": "sync_written_message",
        "type_used": "era.task.sync",
        "display_name": "提交 API 引发的 ERA 状态",
        "description": "调用与 Tavern 事件相同的共享同步链，消息和变量均确认后才完成原 API receipt。"
      },
      {
        "id": "finalize_api_write",
        "type_used": "era.api.finalize_write",
        "display_name": "完成 API 写入事务",
        "description": "成功时声明 apiWrite 后 writeDone；只有消息提交未知时升级 fatal，已确认消息后的 Sidecar 文件失败返回可修复 failed。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "写入 API 结束",
        "description": "结束一次六选一写入 API 事务。"
      }
    ],
    "edges": [
      ["start", "prepare_write_context"],
      ["prepare_write_context", "normalize_safe_object_payload"],
      ["normalize_safe_object_payload", "route_write"],
      {
        "from": "prepare_write_context",
        "to": "sync_written_message",
        "schedule": false
      },
      {
        "from": "route_write",
        "to": "insert_by_object",
        "when": "write_route == 'insert-by-object'"
      },
      {
        "from": "route_write",
        "to": "update_by_object",
        "when": "write_route == 'update-by-object'"
      },
      {
        "from": "route_write",
        "to": "insert_by_path",
        "when": "write_route == 'insert-by-path'"
      },
      {
        "from": "route_write",
        "to": "update_by_path",
        "when": "write_route == 'update-by-path'"
      },
      {
        "from": "route_write",
        "to": "delete_by_object",
        "when": "write_route == 'delete-by-object'"
      },
      {
        "from": "route_write",
        "to": "delete_by_path",
        "when": "write_route == 'delete-by-path'"
      },
      ["insert_by_object", "read_target_messages"],
      ["update_by_object", "read_target_messages"],
      ["insert_by_path", "read_target_messages"],
      ["update_by_path", "read_target_messages"],
      ["delete_by_object", "read_target_messages"],
      ["delete_by_path", "read_target_messages"],
      {
        "from": "insert_by_object",
        "to": "build_message_append",
        "schedule": false
      },
      {
        "from": "update_by_object",
        "to": "build_message_append",
        "schedule": false
      },
      {
        "from": "insert_by_path",
        "to": "build_message_append",
        "schedule": false
      },
      {
        "from": "update_by_path",
        "to": "build_message_append",
        "schedule": false
      },
      {
        "from": "delete_by_object",
        "to": "build_message_append",
        "schedule": false
      },
      {
        "from": "delete_by_path",
        "to": "build_message_append",
        "schedule": false
      },
      ["read_target_messages", "build_message_append"],
      ["build_message_append", "commit_message_append"],
      ["commit_message_append", "route_message_append"],
      {
        "from": "route_message_append",
        "to": "read_committed_messages",
        "when": "api_message_append_route == 'sync'"
      },
      {
        "from": "route_message_append",
        "to": "build_append_failure",
        "when": "api_message_append_route == 'failed'"
      },
      {
        "from": "route_message_append",
        "to": "mark_append_fatal",
        "when": "api_message_append_route == 'fatal'"
      },
      ["mark_append_fatal", "build_append_failure"],
      {
        "from": "route_message_append",
        "to": "prepare_post_commit_context",
        "schedule": false,
        "when": "api_message_append_route == 'sync'"
      },
      ["read_committed_messages", "prepare_post_commit_context"],
      {
        "from": "prepare_post_commit_context",
        "to": "build_sync_step",
        "when": "post_commit_context_route == 'ready'"
      },
      {
        "from": "prepare_post_commit_context",
        "to": "build_post_commit_context_failure",
        "when": "post_commit_context_route == 'fatal'"
      },
      ["build_sync_step", "sync_written_message"],
      ["sync_written_message", "finalize_api_write"],
      ["build_post_commit_context_failure", "finalize_api_write"],
      ["finalize_api_write", "end"],
      ["build_append_failure", "end"]
    ],
    "outputs": [
      {
        "type": "era.task.result.merged",
        "cardinality": "exactly_one",
        "display_name": "写入 API 结果",
        "as": "writeApiResult"
      }
    ]
  }
}
