{
  "type_key": "era.communication.sidecar_binding_inspect_current",
  "display_name": "确认当前聊天应使用哪份状态",
  "description": "读取聊天绑定的独立状态文件及其归属，检查可否沿用同一聊天的内存变量、函数和历史。也识别尚需恢复的生成起点，供后续选择继续、修复或请用户确认。 展开后查看该段实际需要的原生酒馆调用、等待和结果接回；具体操作仍按原业务分支选择。",
  "expand": true,
  "requires": [
    {
      "type": "era.sync.context",
      "cardinality": "exactly_one",
      "display_name": "本次历史同步需要的消息和文件资料"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "sidecar_binding_input",
      "type": "era.sidecar.binding.input",
      "display_name": "当前聊天状态文件绑定的检查资料"
    },
    {
      "key": "sidecar_binding_facts",
      "type": "era.sidecar.binding.facts",
      "display_name": "读到的文件归属、版本及内存状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "input0",
        "type": "era.sync.context",
        "required": true,
        "display_name": "本次历史同步需要的消息和文件资料"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.service.terminal",
        "display_name": "开始本段酒馆操作",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：标明该段业务操作的范围；跨工作流调用在中间明确显示。"
      },
      {
        "id": "prepare",
        "display_name": "准备本段业务并寻找第一个酒馆操作",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：读取聊天绑定的独立状态文件及其归属，检查可否沿用同一聊天的内存变量、函数和历史。也识别尚需恢复的生成起点，供后续选择继续、修复或请用户确认。 先做本地计算；无需酒馆操作时直接形成结果，避免虚构调用。",
        "definition_id": "era.communication.sidecar_binding_inspect_current.prepare"
      },
      {
        "id": "operation_loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "按业务顺序完成实际需要的酒馆操作",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：每次接回当前操作的实际结果后才准备下一项，保持原错误和取消处理；不预先并发所有可能操作。",
        "requires": [
          {
            "type": "era.communication.sidecar_binding_inspect_current.state",
            "cardinality": "exactly_one",
            "display_name": "本业务段的本地计算和酒馆操作进度"
          },
          {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
        ],
        "provides": [
          {
            "key": "ready",
            "type": "era.communication.sidecar_binding_inspect_current.ready",
            "display_name": "已完成全部酒馆操作的业务进度"
          }
        ],
        "loop": {
          "body": "era.communication.sidecar_binding_inspect_current.step",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.communication.sidecar_binding_inspect_current.state",
              "as": "state",
              "update": "next_state"
            },
            {"from":"era.workflow.host_resources","as":"host_resources","update":"retained_host_resources"}
          ],
          "outputs": [
            {
              "from": "next_state",
              "as": "ready"
            }
          ]
        }
      },
      {
        "id": "skip",
        "display_name": "本段无需调用酒馆，直接继续",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：当前业务分支没有实际酒馆操作，保留本地处理结果，不发出空调用。",
        "definition_id": "era.communication.sidecar_binding_inspect_current.skip"
      },
      {
        "id": "finish",
        "display_name": "交出本段原合同的结果",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：业务所需操作均已完成，按原合同交出数据、诊断及结果；资源令牌和通信信封不成为公共业务输出。",
        "definition_id": "era.communication.sidecar_binding_inspect_current.finish"
      },
      {
        "id": "end",
        "definition_id": "era.service.terminal",
        "display_name": "完成本段酒馆操作",
        "description": "本步骤用于“确认当前聊天应使用哪份状态”：标明该段业务操作的范围；跨工作流调用在中间明确显示。"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"prepare","schedule":true},
      {
        "from": "prepare",
        "to": "operation_loop",
        "when": "needs_operation == 'call'"
      },
      {
        "from": "prepare",
        "to": "skip",
        "when": "needs_operation == 'done'"
      },
      [
        "operation_loop",
        "finish"
      ],
      [
        "skip",
        "finish"
      ],
      [
        "finish",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"prepare","schedule":true},
      {"from":"retain_host_resources","to":"operation_loop","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.sidecar.binding.input",
        "cardinality": "exactly_one",
        "display_name": "当前聊天状态文件绑定的检查资料",
        "as": "sidecar_binding_input"
      },
      {
        "type": "era.sidecar.binding.facts",
        "cardinality": "exactly_one",
        "display_name": "读到的文件归属、版本及内存状态",
        "as": "sidecar_binding_facts"
      }
    ]
  }
}
