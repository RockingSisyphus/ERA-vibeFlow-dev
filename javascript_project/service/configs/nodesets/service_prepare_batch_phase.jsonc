{
  "nodeset_imports": [
    {
      "path": "service_finish_batch.jsonc"
    }
  ],
  "type_key": "era.service.prepare_batch_phase",
  "display_name": "ERA 就绪批次规划阶段",
  "description": "把就绪事件集合规划成有顺序的任务，核对来源无漏项、无重复、无批次外事件且步骤不超过 128。通过后进入执行阶段，留待下一轮执行第一个任务；失败则不执行领域任务，直接结算并发布失败帧。这样任务规划问题不会造成来源调用失去结果。",
  "requires": [
    {
      "type": "era.collection.reduction",
      "cardinality": "exactly_one",
      "display_name": "就绪事件集"
    }
  ],
  "provides": [
    {
      "key": "prepared_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "collection_reduction",
        "type": "era.collection.reduction",
        "display_name": "就绪事件集",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "规划阶段开始",
        "description": "这是“ERA 就绪批次规划阶段”的入口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      },
      {
        "id": "plan_batch",
        "type_used": "era.service.plan_batch",
        "display_name": "规划原生命周期步骤",
        "description": "把已经就绪的一组聊天或 API 事件翻译成有顺序的任务步骤，例如初始化、消息同步、消息标识更新、生成阶段或明确忽略。每一步保留它对应的原始事件来源，使多个事件即使合并为一个任务也能分别收到处理结果。这里只编排任务，不执行计算或保存。"
      },
      {
        "id": "validate_coverage",
        "type_used": "era.service.validate_coverage",
        "display_name": "验证来源覆盖",
        "description": "检查批次计划是否覆盖全部原始事件：不能漏掉来源、重复处理同一来源，或混入本批次之外的来源；步骤数也不能超过 128。成功时建立从第一个步骤开始的批次状态，失败时走整批失败结算，防止部分事件悄悄丢失或被执行两次。"
      },
      {
        "id": "coverage_failure",
        "type_used": "era.service.coverage_failure",
        "display_name": "构造覆盖失败批次",
        "description": "当任务计划的来源覆盖检查不通过时，给本批次每个原始事件生成一条失败结算，保留检查诊断，并把批次标为待结束。不会执行计划中的任何领域任务；其意义是即使规划出错，等待结果的调用方也能收到明确失败。"
      },
      {
        "id": "begin_execution",
        "type_used": "era.service.cycle.begin_execution",
        "display_name": "携带已校验批次",
        "description": "把经过覆盖检查的批次状态标记为执行阶段，保留任务列表、当前索引和所有事件来源。下一轮开始执行第一个步骤，而不是再接收一批新事件；这里只切换阶段，不提前执行任务。"
      },
      {
        "id": "finish_invalid_batch",
        "type_used": "era.service.finish_batch",
        "display_name": "发布覆盖失败批次",
        "description": "结束本批次并为全部原始事件准确结算一次，构造统一结果帧，先发送给宿主，再判断能否继续服务。普通失败可带着诊断进入下一轮收集；无法确认写入等致命结果则在发送后抛错。这个顺序确保服务停止前，等待本批结果的调用方已能收到结论。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "规划阶段结束",
        "description": "这是“ERA 就绪批次规划阶段”的出口标记。结构性的起点或终点标记，执行时返回空结果，不读取消息、不计算变量，也不保存或发送通知。它的意义是明确一段流程从哪里开始或在哪里收尾；具体业务数据沿该流程的声明通道传递。"
      }
    ],
    "edges": [
      [
        "start",
        "plan_batch"
      ],
      [
        "plan_batch",
        "validate_coverage"
      ],
      {
        "from": "validate_coverage",
        "to": "begin_execution",
        "when": "coverage_route == 'execute'"
      },
      {
        "from": "validate_coverage",
        "to": "coverage_failure",
        "when": "coverage_route == 'invalid'"
      },
      [
        "coverage_failure",
        "finish_invalid_batch"
      ],
      [
        "begin_execution",
        "end"
      ],
      [
        "finish_invalid_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
