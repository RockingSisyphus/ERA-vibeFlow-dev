{
  "nodeset_imports": [
    {
      "path": "service_finish_batch.jsonc"
    }
  ],
  "type_key": "era.service.prepare_batch_phase",
  "display_name": "把收齐的事件安排为有序任务",
  "description": "把已就绪的聊天和 调用接口（API） 事件编成有顺序的任务列表，并检查每个原始事件恰好对应一次处理、总步骤不超过128。检查通过后从第一个任务开始执行；检查失败时结算整批来源并发布原因。",
  "requires": [
    {
      "type": "era.collection.reduction",
      "cardinality": "exactly_one",
      "display_name": "就绪事件集"
    }
  ],
  "provides": [
    {
      "key": "prepared_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "collection_reduction",
        "type": "era.collection.reduction",
        "display_name": "就绪事件集",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "规划阶段开始",
        "description": "开始把收齐的事件安排为有序任务。"
      },
      {
        "id": "plan_batch",
        "type_used": "era.service.plan_batch",
        "display_name": "规划原生命周期步骤",
        "description": "本次为收齐的事件安排任务顺序。把已经收齐的聊天和 调用接口（API） 事件安排为有序任务，包括初始化、历史同步、消息历史标识、生成及忽略任务，并保留每个事件的对应关系。"
      },
      {
        "id": "validate_coverage",
        "type_used": "era.service.validate_coverage",
        "display_name": "验证来源覆盖",
        "description": "本次为收齐的事件安排任务顺序。检查任务计划是否恰好覆盖本批每个原事件一次，且事件来源有效、任务数在允许范围内；输出检查结果及具体问题。"
      },
      {
        "id": "coverage_failure",
        "type_used": "era.service.coverage_failure",
        "display_name": "构造覆盖失败批次",
        "description": "本次为收齐的事件安排任务顺序。任务计划与原事件对应关系有误时，为原批次中的每个事件生成失败回执，结束该批次并说明计划问题。"
      },
      {
        "id": "begin_execution",
        "type_used": "era.service.cycle.begin_execution",
        "display_name": "携带已校验批次",
        "description": "本次为收齐的事件安排任务顺序。将已通过检查的任务批次放入执行阶段，从第一个任务开始逐项处理。"
      },
      {
        "id": "finish_invalid_batch",
        "type_used": "era.service.finish_batch",
        "display_name": "汇总批次结果并发送给酒馆页面",
        "description": "本次为收齐的事件安排任务顺序。汇总当前批次所有任务的结论，检查每个原始事件恰有一次回执，再发送结果和通知。普通失败后可以继续接收事件；写入结果未知等致命问题先告知调用方，再停止服务。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "规划阶段结束",
        "description": "结束把收齐的事件安排为有序任务，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "plan_batch"
      ],
      [
        "plan_batch",
        "validate_coverage"
      ],
      {
        "from": "validate_coverage",
        "to": "begin_execution",
        "when": "coverage_route == 'execute'"
      },
      {
        "from": "validate_coverage",
        "to": "coverage_failure",
        "when": "coverage_route == 'invalid'"
      },
      [
        "coverage_failure",
        "finish_invalid_batch"
      ],
      [
        "begin_execution",
        "end"
      ],
      [
        "finish_invalid_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
