{
  "type_key": "era.task.startup_sync",
  "display_name": "ERA 启动历史同步",
  "description": "将初始化专用步骤适配后调用既有共享同步 Nodeset，不复制 Sidecar 或同步业务。",
  "requires": [
    {"type": "era.initialize.startup.sync.step", "cardinality": "exactly_one", "display_name": "专用启动同步步骤"},
    {"type": "era.batch.execution.state", "cardinality": "exactly_one", "display_name": "当前批次执行状态"}
  ],
  "provides": [
    {"key": "startup_sync_result", "type": "era.task.result", "display_name": "启动同步结果"}
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {"key": "startup_step", "type": "era.initialize.startup.sync.step", "display_name": "专用启动同步步骤", "required": true},
      {"key": "execution_state", "type": "era.batch.execution.state", "display_name": "当前批次执行状态", "required": true}
    ],
    "max_steps": 4,
    "nodes": [
      {"id": "start", "type_used": "era.service.terminal", "display_name": "启动同步适配开始", "description": "开始启动同步适配。"},
      {"id": "adapt_step", "type_used": "era.initialize.adapt_startup_sync_step", "display_name": "适配启动同步步骤", "description": "把专用初始化步骤转为通用 routed step。"},
      {"id": "run_shared_sync", "type_used": "era.task.sync", "display_name": "调用共享同步", "description": "调用既有 Sidecar、表达式、压缩与提交链。"},
      {"id": "end", "type_used": "era.service.terminal", "display_name": "启动同步适配结束", "description": "输出共享同步结果。"}
    ],
    "edges": [
      ["start", "adapt_step"],
      ["adapt_step", "run_shared_sync"],
      ["run_shared_sync", "end"]
    ],
    "outputs": [
      {"type": "era.task.result", "cardinality": "exactly_one", "display_name": "启动同步结果", "as": "startupSyncResult"}
    ]
  }
}
