{
  "nodeset_imports": [
    {
      "path": "service_collect_phase.jsonc"
    },
    {
      "path": "service_prepare_batch_phase.jsonc"
    }
  ],
  "type_key": "era.service.collect_cycle_phase",
  "display_name": "收集事件并判断是否开始执行",
  "description": "完成一轮事件收集：接收和整理事件，发出定时器控制，再检查是否已经可以执行。就绪时把事件编成任务列表并检查每个来源都有安排；有效计划进入执行阶段，计划有误则向全部来源返回失败。",
  "requires": [
    {
      "type": "era.service.cycle.routed",
      "cardinality": "exactly_one",
      "display_name": "收集阶段状态"
    }
  ],
  "provides": [
    {
      "key": "collection_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "下一阶段状态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.routed",
        "display_name": "收集阶段状态",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "收集轮次开始",
        "description": "开始收集事件并判断是否开始执行。"
      },
      {
        "id": "collect_phase",
        "type_used": "era.service.collect_phase",
        "display_name": "接收并整理一个酒馆事件",
        "description": "本次决定事件收集是否已可转为批次执行。接收一个聊天或 调用接口（API） 事件，检查它的传输格式，并加入待处理事件集合。根据收集期限和容量决定继续等待还是形成批次，同时输出应启动或取消的定时器。结果供服务循环安排后续任务。"
      },
      {
        "id": "route_collection",
        "type_used": "era.service.route_iteration",
        "display_name": "选择等待或规划",
        "description": "本次决定事件收集是否已可转为批次执行。根据事件收集结果选择继续等待或准备任务批次。"
      },
      {
        "id": "carry_wait",
        "type_used": "era.service.cycle.carry_wait",
        "display_name": "携带等待状态",
        "description": "本次决定事件收集是否已可转为批次执行。把更新后的待处理事件、定时器和事件序号放回收集循环，继续等待本批事件准备就绪。"
      },
      {
        "id": "prepare_batch",
        "type_used": "era.service.prepare_batch_phase",
        "display_name": "把收齐的事件安排为有序任务",
        "description": "本次决定事件收集是否已可转为批次执行。把已就绪的聊天和 调用接口（API） 事件编成有顺序的任务列表，并检查每个原始事件恰好对应一次处理、总步骤不超过128。检查通过后从第一个任务开始执行；检查失败时结算整批来源并发布原因。"
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "收集轮次结束",
        "description": "结束收集事件并判断是否开始执行，输出本段流程的处理结果。"
      }
    ],
    "edges": [
      [
        "start",
        "collect_phase"
      ],
      [
        "collect_phase",
        "route_collection"
      ],
      {
        "from": "collect_phase",
        "to": "carry_wait",
        "schedule": false
      },
      {
        "from": "collect_phase",
        "to": "prepare_batch",
        "schedule": false
      },
      {
        "from": "route_collection",
        "to": "carry_wait",
        "when": "iteration_route == 'wait'",
        "transfer": false
      },
      {
        "from": "route_collection",
        "to": "prepare_batch",
        "when": "iteration_route == 'execute'",
        "transfer": false
      },
      [
        "carry_wait",
        "end"
      ],
      [
        "prepare_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "下一阶段状态",
        "as": "cycleStateNext"
      }
    ]
  }
}
