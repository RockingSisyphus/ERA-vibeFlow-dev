{
  "nodeset_imports": [
    {
      "path": "service_collect_phase.jsonc"
    },
    {
      "path": "service_prepare_batch_phase.jsonc"
    }
  ],
  "type_key": "era.service.collect_cycle_phase",
  "display_name": "收一轮事件并决定等待还是开始批次",
  "description": "接收并整理一个新事件，把计时安排送回页面，再检查本批是否就绪。就绪时规划有序任务并核对每个事件都有安排，通过则进入执行，计划有问题则统一回告失败。",
  "requires": [
    {
      "type": "era.service.cycle.routed",
      "cardinality": "exactly_one",
      "display_name": "已选择阶段的服务状态"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "collection_cycle_state",
      "type": "era.service.cycle.state",
      "display_name": "服务当前处于收集还是执行及相应进度"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "cycle_state",
        "type": "era.service.cycle.routed",
        "display_name": "已选择阶段的服务状态",
        "required": true
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始收一轮事件并决定等待还是开始批次",
        "description": "标明“收一轮事件并决定等待还是开始批次”的开始位置。接收并整理一个新事件，把计时安排送回页面，再检查本批是否就绪。就绪时规划有序任务并核对每个事件都有安排，通过则进入执行，计划有问题则统一回告失败。",
        "definition_id": "era.service.terminal"
      },
      {
        "id": "collect_phase",
        "display_name": "收集聊天变化及原生候选结束事实",
        "description": "接收原生生成结束、停止及已有聊天事件，沿统一事件目录交给主Service。生成结束只唤醒本聊天待保存候选，不重复触发作者副作用；无待保存项时保持普通结算。源：configs/nodesets/service_collect_phase.jsonc与base_lib/domain/event_catalog.ts。",
        "definition_id": "era.service.collect_phase",
        "join_policy": "all"
      },
      {
        "id": "route_collection",
        "display_name": "判断继续等事件还是开始处理",
        "description": "在“收一轮事件并决定等待还是开始批次”流程中，接收事件收集后的状态，判断这一批是否已经就绪。未就绪时回到等待，就绪时进入任务规划，让服务在合适的时间开始处理事件。",
        "definition_id": "era.service.route_iteration"
      },
      {
        "id": "carry_wait",
        "display_name": "保留待处理事件继续等待",
        "description": "在“收一轮事件并决定等待还是开始批次”流程中，接收尚未达到执行条件的收集状态，保留现有事件、序号和定时器，交回服务循环。下一事件到来时可以接着合并，而不丢掉已经收集的变化。",
        "definition_id": "era.service.cycle.carry_wait"
      },
      {
        "id": "prepare_batch",
        "display_name": "把就绪事件排成可执行的有序批次",
        "description": "本环节用于“收一轮事件并决定等待还是开始批次”：接收已收齐事件，规划初始化、同步、生成等任务，并核对每个原事件恰好对应一次、总任务数在限制内。有效计划从第一项开始，错误计划为整批返回失败原因。",
        "definition_id": "era.service.prepare_batch_phase"
      },
      {
        "id": "end",
        "display_name": "结束收一轮事件并决定等待还是开始批次",
        "description": "标明“收一轮事件并决定等待还是开始批次”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.service.terminal"
      },
      {"id":"retain_host_resources","definition_id":"era.service.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"collect_phase","schedule":true},
      [
        "collect_phase",
        "route_collection"
      ],
      {
        "from": "collect_phase",
        "to": "carry_wait",
        "schedule": false
      },
      {
        "from": "collect_phase",
        "to": "prepare_batch",
        "schedule": false
      },
      {
        "from": "route_collection",
        "to": "carry_wait",
        "when": "iteration_route == 'wait'",
        "transfer": false
      },
      {
        "from": "route_collection",
        "to": "prepare_batch",
        "when": "iteration_route == 'execute'",
        "transfer": false
      },
      [
        "carry_wait",
        "end"
      ],
      [
        "prepare_batch",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"collect_phase","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"prepare_batch","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "服务当前处于收集还是执行及相应进度",
        "as": "cycleStateNext"
      }
    ]
  }
}
