{
  "host_extensions": [],
  "global_config": {
    "config": {},
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "request",
        "type": "era.public_state.request",
        "display_name": "同步请求",
        "required": true
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.service.terminal",
        "display_name": "开始同步投影",
        "description": "接收调用方已读取的输入，不访问宿主。"
      },
      {
        "id": "select_public_floor",
        "type_used": "era.public_state.select_floor",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "选择最新或指定楼层",
        "description": "latest 保持现有最新MK选择，message 使用已有 floor_snapshot，provided-floor 复用状态栏已计算楼层；不创建逐楼缓存。",
        "requires": [
          {
            "type": "era.public_state.request",
            "cardinality": "exactly_one",
            "display_name": "处理输入"
          }
        ],
        "provides": [
          {
            "key": "select_public_floor_result",
            "type": "era.public_state.context",
            "display_name": "处理结果"
          }
        ]
      },
      {
        "id": "project_author_state",
        "type_used": "era.public_state.project",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "组装作者公开状态",
        "description": "按原规则反转义、移除元字段、复制日志与身份，输出现有 loading/ready 作者结构；所有字段和对象独立性保持原合同。",
        "requires": [
          {
            "type": "era.public_state.context",
            "cardinality": "exactly_one",
            "display_name": "处理输入"
          }
        ],
        "provides": [
          {
            "key": "project_author_state_result",
            "type": "era.public_state.result",
            "display_name": "处理结果"
          }
        ]
      },
      {
        "id": "end",
        "type_used": "era.service.terminal",
        "display_name": "结束同步投影",
        "description": "将完整结果立即返回原同步调用方。"
      }
    ],
    "edges": [
      [
        "start",
        "select_public_floor"
      ],
      [
        "select_public_floor",
        "project_author_state"
      ],
      [
        "project_author_state",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.public_state.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "result"
      }
    ]
  }
}
