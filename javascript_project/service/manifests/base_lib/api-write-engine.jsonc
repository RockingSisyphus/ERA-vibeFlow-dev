{
  "kind": "base_lib",
  "id": "era.service.api_write_engine",
  "display_name": "ERA 写入 API 纯适配引擎",
  "description": "纯函数把六个公开写入 API 转成候选 Variable 指令块，在消息快照中选择最后一条 AI 消息并构造局部文本更新；不访问宿主且不修改附件。",
  "category": "外部 API",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "base_lib/domain/api_write_engine.ts"
      }
    }
  ],
  "dependencies": ["era.service.mk_engine"],
  "external_packages": []
}
