{
  "kind": "base_lib",
  "id": "era.crud.engine",
  "display_name": "ERA 变量增删改纯计算引擎",
  "description": "纯函数按消息内原始顺序解析并执行 VariableInsert、VariableEdit 与 VariableDelete，保持 JSONL、注释、代码围栏、繁转简、键值转义、模板与数组覆盖、保护字段、历史旧值和编辑日志语义；不访问或写入宿主。",
  "category": "变量增删改",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "base_lib/domain/crud_engine.ts"
      }
    }
  ],
  "dependencies": ["era.snapshot.query"],
  "external_packages": ["opencc-js"]
}
