{
  "kind": "base_lib",
  "id": "era.crud.engine",
  "display_name": "ERA 变量增删改纯计算引擎",
  "description": "纯函数按消息内原始顺序解析并执行 VariableInsert、VariableEdit 与 VariableDelete；VariableEdit 在唯一领域入口支持严格单键 $inc/$mul/$div 数值运算和逐字段诊断，并保持 JSONL、繁转简、保护、历史重算与具体编辑日志语义；不访问或写入宿主。",
  "category": "变量增删改",
  "version": "1.1.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "base_lib/domain/crud_engine.ts"
      }
    }
  ],
  "dependencies": ["era.snapshot.query"],
  "external_packages": ["opencc-js"]
}
