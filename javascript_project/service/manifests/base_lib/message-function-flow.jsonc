{
  "kind": "base_lib",
  "id": "era.service.message_function_flow",
  "display_name": "ERA 消息内函数调用流程状态机",
  "description": "纯状态机按原文位置逐块推进一条消息：在调用块处停下并暴露待调用，宿主机回送终态与已应用操作后把产出写成调用块下方的操作区记录，再继续推进直到该消息再无新块。所有状态（文本、块游标、累计变量与函数库、诊断、正式模式）随流程对象携带，可跨 FIFO 事件与步骤恢复；不执行作者函数、不访问宿主。",
  "category": "消息内函数调用",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "base_lib/domain/message_function_flow.ts"
      }
    }
  ],
  "dependencies": [
    "era.service.message_function_calls",
    "era.crud.engine"
  ],
  "external_packages": []
}
