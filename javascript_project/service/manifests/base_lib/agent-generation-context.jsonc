        "ref": "base_lib/agent/agent_generation_context.ts"
      }
    }
  ],
  "dependencies": [
    "era.service.agent_session_binding",
    "era.service.agent_configuration",
    "era.service.agent_report_text",
    "era.service.agent_flow_types"
