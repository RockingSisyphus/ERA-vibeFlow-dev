{
  "kind": "base_lib",
  "id": "era.service.agent_generation_context",
  "display_name": "Agent 会话上下文与 Capability 适配",
  "description": "从阶段上下文导出稳定请求事实，并由传入的 Agent Capability 执行原会话写入。",
