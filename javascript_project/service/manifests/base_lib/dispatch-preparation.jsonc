{
  "kind": "base_lib",
  "id": "era.service.dispatch_preparation",
  "display_name": "ERA 统一任务上下文准备纯逻辑",
  "description": "分类显式任务来源，校验严格消息投影，幂等规划 MK 与占位符；仅 update-mk 任务规划 SelectedMks，状态任务保留旧链供同步事务识别分歧，并形成统一派发上下文。",
  "category": "任务派发",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "base_lib/dispatch_preparation.ts"
      }
    }
  ],
  "dependencies": [
    "era.service.types",
    "era.service.mk_engine"
  ],
  "external_packages": [
    "@era/vibeflow-contracts"
  ]
}
