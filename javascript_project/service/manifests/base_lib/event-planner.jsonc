{
  "kind": "base_lib",
  "id": "era.service.event_planner",
  "display_name": "ERA 事件目录与批次规划器",
  "description": "纯函数实现候选基线及两个内部 UI 初始化事件的分类、收集窗口、组合、折叠、严格领域任务规划和来源覆盖校验；不读取时间、宿主或持久化状态。",
  "category": "事件规划",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "base_lib/domain/event_planner.ts"
      }
    }
  ],
  "dependencies": [
    "era.service.event_catalog"
  ],
  "external_packages": [
    "@era/vibeflow-contracts"
  ]
}
