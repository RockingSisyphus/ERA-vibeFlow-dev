{
  "kind": "host_extension",
  "id": "era.tavern.service_host",
  "display_name": "ERA 酒馆服务宿主",
  "description": "连接酒馆页面与 Service，按顺序传递事件，执行消息、文件、模型和界面操作，返回写入确认及原请求回执。管理定时器、页面重建和服务停止清理，并把最新变量结果发布给状态栏。",
  "version": "0.1.0",
  "targets": [
    "browser"
  ],
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "host_extensions/service_host_operations.ts",
        "export": "createHostExtension"
      }
    }
  ],
  "provides": [
    "vibeflow.port",
    "era.tavern.agent",
    "era.tavern.variables",
    "era.tavern.messages",
    "era.tavern.worldbook",
    "era.tavern.regex",
    "era.tavern.character",
    "era.tavern.identity",
    "era.tavern.sidecar",
    "era.tavern.installation_scope",
    "era.tavern.startup_gate",
    "era.lifecycle.admission",
    "era.tavern.functions"
  ],
  "dependencies": [
    "era.tavern.host_types",
    "era.tavern.host_primitives",
    "era.tavern.host_settlement"
  ],
  "external_packages": [
    "@era/vibeflow-contracts"
  ]
}
