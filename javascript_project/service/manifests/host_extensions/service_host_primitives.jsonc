{
  "kind": "host_extension",
  "id": "era.tavern.host_primitives",
  "display_name": "ERA Service Host 支持模块",
  "description": "Service Host 的无状态类型与基础设施模块；由唯一 Service Host 管理运行状态和生命周期。",
  "version": "0.1.0",
  "targets": [
    "browser"
  ],
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "host_extensions/service_host_primitives.ts",
        "export": "createHostExtension"
      }
    }
  ],
  "provides": [],
  "dependencies": [
    "era.tavern.host_types"
  ],
  "external_packages": []
}
