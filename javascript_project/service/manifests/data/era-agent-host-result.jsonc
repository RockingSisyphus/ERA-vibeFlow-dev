{
  "kind": "data_schema",
  "type_key": "era.agent.host.result",
  "representation": "json",
  "display_name": "ERA 多阶段生成 宿主结果",
  "description": "Agent Host capability 返回的脱敏、可序列化、有界事实或模型原文。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "requestedName": {
        "type": "string"
      },
      "loadedName": {
        "type": [
          "string",
          "null"
        ]
      },
      "prompts": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "object",
          "required": [
            "id",
            "enabled",
            "role",
            "content"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
