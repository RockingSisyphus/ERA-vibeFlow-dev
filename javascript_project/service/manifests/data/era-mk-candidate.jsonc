{
  "kind": "data_schema",
  "type_key": "era.mk.candidate",
  "representation": "json",
  "display_name": "ERA 消息密钥提交候选",
  "description": "纯计算产生的消息文本与 ERAMetaData 候选，或进入无写入失败路径的明确错误。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["schemaVersion", "step", "disposition", "mk", "messageUpdate", "metaUpdate", "messageWriteRequired", "variableWriteRequired", "failure"],
    "properties": {
      "schemaVersion": {"const": 1},
      "step": {"type": "object"},
      "disposition": {"type": "string", "enum": ["ready", "failed"]},
      "mk": {"type": ["string", "null"]},
      "messageUpdate": {
        "type": ["object", "null"],
        "properties": {
          "messageId": {"type": "integer", "minimum": 0},
          "content": {"type": "string"}
        },
        "required": ["messageId", "content"],
        "additionalProperties": false
      },
      "metaUpdate": {"type": ["object", "null"]},
      "messageWriteRequired": {"type": "boolean"},
      "variableWriteRequired": {"type": "boolean"},
      "failure": {"type": ["object", "null"]}
    },
    "additionalProperties": false
  }
}
