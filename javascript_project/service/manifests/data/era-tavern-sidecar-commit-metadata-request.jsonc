{
  "kind": "data_schema",
  "type_key": "era.tavern.sidecar.commit_metadata.request",
  "representation": "json",
  "display_name": "Sidecar 指针提交请求",
  "description": "只提交 ERAMetaData.SidecarId；可在已确认文件提交后携带易失快照。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "sidecarId"
    ],
    "properties": {
      "sidecarId": {
        "type": "string"
      },
      "notifySubscribers": {
        "type": "boolean",
        "description": "false 仅更新已保存块的即时读取缓存；消息完成时通知订阅者，默认 true。"
      },
      "snapshot": {
        "type": "object"
      },
      "workingVersion": {
        "type": "integer",
        "minimum": 0,
        "description": "本次保存对应的内存版本；版本已推进时不得用旧保存结果覆盖读取快照。"
      },
      "sourceBasis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "messages"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characterId",
              "chatId",
              "groupId"
            ],
            "properties": {
              "characterId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chatId": {
                "type": "string"
              },
              "groupId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "messageId",
                "role",
                "activeText",
                "swipeIndex"
              ],
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "activeText": {
                  "type": "string"
                },
                "swipeIndex": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "expectedSidecarId": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
