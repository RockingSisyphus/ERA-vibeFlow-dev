{
  "kind": "data_schema",
  "type_key": "era.workbench.preparation_result",
  "representation": "json",
  "description": "保存准备成功的提交上下文，或失败原因。",
  "schema": {
    "type": "object",
    "properties": {
      "route": {
        "enum": [
          "ready",
          "failed"
        ]
      },
      "inspected": {
        "type": "object",
        "additionalProperties": true
      },
      "failure": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "route",
      "inspected",
      "failure"
    ],
    "additionalProperties": false
  },
  "display_name": "工作台准备结果"
}
