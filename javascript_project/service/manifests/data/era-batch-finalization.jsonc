{
  "kind": "data_schema",
  "type_key": "era.batch.finalization",
  "representation": "json",
  "display_name": "ERA 批次收尾结果",
  "description": "批次执行结束后形成的下一状态、完整结算、通知、诊断与致命标记。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "batchId": {
        "type": "string",
        "minLength": 1
      },
      "throughSequence": {
        "type": "integer",
        "minimum": 1
      },
      "nextState": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "collection": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "allOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "source": {
                          "enum": [
                            "tavern",
                            "ui",
                            "era-api"
                          ]
                        }
                      },
                      "required": [
                        "source"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "source": {
                          "const": "timer"
                        },
                        "type": {
                          "const": "era.service.collection_timer"
                        }
                      },
                      "required": [
                        "source",
                        "type"
                      ]
                    }
                  ]
                }
              ],
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "occurredAt": {
                  "type": "number"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "tavern",
                    "ui",
                    "era-api",
                    "timer"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "json"
                          },
                          "value": {}
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "undefined"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "host-ref"
                          },
                          "token": {
                            "type": "string",
                            "minLength": 1
                          },
                          "refKind": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "token",
                          "refKind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "encodedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                }
              },
              "required": [
                "schemaVersion",
                "eventId",
                "sequence",
                "type",
                "occurredAt",
                "source",
                "args",
                "encodedBytes"
              ],
              "additionalProperties": false
            }
          },
          "collectionBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          },
          "iteration": {
            "type": "integer",
            "minimum": 0
          },
          "consecutiveProcessingCount": {
            "type": "integer",
            "minimum": 0
          },
          "consecutiveMk": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "timerToken": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schemaVersion",
          "collection",
          "collectionBytes",
          "iteration",
          "consecutiveProcessingCount",
          "consecutiveMk",
          "timerToken"
        ],
        "additionalProperties": false
      },
      "settlements": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "const": "completed"
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "combined",
                    "coalesced"
                  ]
                },
                "value": {}
              },
              "required": [
                "eventId",
                "sequence",
                "status",
                "taskId",
                "relation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "const": "ignored"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "eventId",
                "sequence",
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "const": "failed"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "input",
                        "domain",
                        "tavern",
                        "cancelled"
                      ]
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "category",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "eventId",
                "sequence",
                "status",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "const": "cancelled"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "eventId",
                "sequence",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "notifications": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "json"
                      },
                      "value": {}
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "undefined"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "host-ref"
                      },
                      "token": {
                        "type": "string",
                        "minLength": 1
                      },
                      "refKind": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "token",
                      "refKind"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "diagnostics": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "sequence": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "sequence"
          ],
          "additionalProperties": false
        }
      },
      "fatal": {
        "type": "boolean"
      }
    },
    "required": [
      "schemaVersion",
      "batchId",
      "throughSequence",
      "nextState",
      "settlements",
      "notifications",
      "diagnostics",
      "fatal"
    ],
    "additionalProperties": false
  }
}

