{
  "kind": "data_schema",
  "type_key": "era.command.expression.request",
  "representation": "json",
  "display_name": "带用途的 Expression 请求",
  "description": "保存待计算的变量公式、待检查的临时函数库或生成阶段函数调用，并携带当前操作进度，供表达式结果接回原操作。",
  "schema": {
    "type": "object",
    "properties": {
      "purpose": {
        "type": "string",
        "enum": [
          "value",
          "library",
          "stage-call"
        ]
      },
      "request": {
        "type": "object"
      },
      "operationState": {
        "type": "object"
      }
    },
    "required": [
      "purpose",
      "request",
      "operationState"
    ],
    "additionalProperties": false
  }
}
