{
  "kind": "data_schema",
  "type_key": "era.workbench.request",
  "representation": "json",
  "schema": {
    "type": "object",
    "properties": {
      "kind": {
        "enum": [
          "variable-diff",
          "variable-insert",
          "variable-delete",
          "variable-expression",
          "function-diff"
        ]
      },
      "original": {},
      "draft": {},
      "root": {},
      "path": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expression": {
        "type": "string"
      },
      "choice": {
        "enum": [
          "none",
          "temporary",
          "unlock"
        ]
      }
    },
    "required": [
      "kind",
      "choice"
    ],
    "additionalProperties": false
  }
}
