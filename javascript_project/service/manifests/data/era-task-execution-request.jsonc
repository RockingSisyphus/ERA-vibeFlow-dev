{
  "kind": "data_schema",
  "type_key": "era.task.execution.request",
  "representation": "json",
  "display_name": "共享执行流程执行请求",
  "description": "保存选定的提交、历史同步、生成候选或直接返回请求，以及原任务回执资料。",
  "schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "sync",
          "commit",
          "candidate",
          "update-mk",
          "direct"
        ]
      },
      "payload": {
        "type": "object"
      }
    },
    "required": [
      "kind",
      "payload"
    ],
    "additionalProperties": false
  }
}
