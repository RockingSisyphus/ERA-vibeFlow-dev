{
  "kind": "data_schema",
  "type_key": "era.sync.function.event.route",
  "representation": "json",
  "display_name": "作者函数等待事件",
  "description": "记录作者函数返回的是变量提交、历史同步请求、正常结束还是错误，供调用流程选择处理方式。",
  "schema": {
    "type": "string",
    "enum": [
      "done",
      "commit",
      "unsupported",
      "failed"
    ]
  }
}
