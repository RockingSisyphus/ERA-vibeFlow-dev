{
  "kind": "data_schema",
  "type_key": "era.tavern.functions.result.request",
  "representation": "json",
  "display_name": "ERA·函数调用·终态请求",
  "description": "查询一次调用的终态。未登记的标识必须以类型化失败回送，而不是抛异常或静默返回成功。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "invocationId": { "type": "string", "minLength": 1 }
    },
    "required": ["invocationId"],
    "additionalProperties": false
  }
}
