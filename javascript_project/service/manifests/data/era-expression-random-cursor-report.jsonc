{
  "kind": "data_schema",
  "type_key": "era.expression.random.cursor.report",
  "representation": "json",
  "display_name": "ERA·表达式·消息随机处理位置报告",
  "description": "记录本条消息重新执行时使用的随机次数，供计算流程核对随机进度。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["randomDrawsConsumed", "nextRandomDrawOffset"],
    "properties": {
      "randomDrawsConsumed": {"type": "integer", "minimum": 0},
      "nextRandomDrawOffset": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  }
}
