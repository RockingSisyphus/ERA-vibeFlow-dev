{
  "kind": "data_schema",
  "type_key": "era.api.request",
  "representation": "json",
  "display_name": "ERA 公共对象请求",
  "description": "内部 Facade 任务、来源、dispatch context 与 commit/sync 参数；不是公开事件 payload。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["task", "sources"],
    "properties": {
      "task": {"type": "object"},
      "sources": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object"}},
      "dispatchContext": {},
      "detail": {"type": "object"}
    },
    "additionalProperties": false
  }
}
