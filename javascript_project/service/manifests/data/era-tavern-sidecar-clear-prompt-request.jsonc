{
  "kind": "data_schema",
  "type_key": "era.tavern.sidecar.clear_prompt.request",
  "representation": "json",
  "display_name": "Sidecar 弹窗清理请求",
  "description": "清理当前 Sidecar 弹窗。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expectedSidecarId": {
        "type": [
          "string",
          "null"
        ]
      },
      "sourceBasis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "messages"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characterId",
              "chatId",
              "groupId"
            ],
            "properties": {
              "characterId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chatId": {
                "type": "string"
              },
              "groupId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "messageId",
                "role",
                "activeText",
                "swipeIndex"
              ],
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "activeText": {
                  "type": "string"
                },
                "swipeIndex": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
