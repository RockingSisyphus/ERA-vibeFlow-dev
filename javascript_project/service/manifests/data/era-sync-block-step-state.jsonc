{
  "kind": "data_schema",
  "type_key": "era.sync.block.step.state",
  "representation": "json",
  "display_name": "ERA·同步·块步进状态",
  "description": "保存本次消息范围、当前处理位置、变量、函数、日志及待保存正文，供消息循环继续处理。",
  "schema": {
    "type": "object",
    "properties": {
      "work": {
        "type": "object"
      },
      "done": {
        "type": "boolean"
      },
      "sourceBasis": {
        "type": [
          "object",
          "null"
        ]
      },
      "apiContext": {
        "type": "object"
      },
      "functionFrame": {
        "type": [
          "object",
          "null"
        ]
      },
      "scopeWindow": {
        "type": "object"
      },
      "stageOutcome": {
        "type": "object"
      }
    },
    "required": [
      "work",
      "done",
      "sourceBasis"
    ],
    "additionalProperties": false
  }
}
