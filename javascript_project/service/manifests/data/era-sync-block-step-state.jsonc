{
  "kind": "data_schema",
  "type_key": "era.sync.block.step.state",
  "representation": "json",
  "display_name": "ERA·同步·块步进状态",
  "description": "【planned：一步一块】承载“一次迭代只处理一个操作块”所需的可续做状态：当前楼层与块下标、累计变量与函数状态、本楼已记日志增量与已处理调用标识。丢失时从该楼层楼首按文本重算；不写入聊天变量或 Sidecar 持久化字段。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true
  }
}
