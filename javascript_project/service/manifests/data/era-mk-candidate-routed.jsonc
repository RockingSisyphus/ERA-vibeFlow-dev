{
  "kind": "data_schema",
  "type_key": "era.mk.candidate.routed",
  "representation": "json",
  "display_name": "已路由 ERA 消息密钥候选",
  "description": "路由节点无损转发的 MK 候选；形状与 era.mk.candidate 完全一致。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schemaVersion",
      "step",
      "disposition",
      "mk",
      "messageUpdate",
      "metaUpdate",
      "messageWriteRequired",
      "variableWriteRequired",
      "failure"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "step": {
        "type": "object"
      },
      "disposition": {
        "type": "string",
        "enum": [
          "ready",
          "failed"
        ]
      },
      "mk": {
        "type": [
          "string",
          "null"
        ]
      },
      "messageUpdate": {
        "type": [
          "object",
          "null"
        ]
      },
      "metaUpdate": {
        "type": [
          "object",
          "null"
        ]
      },
      "messageWriteRequired": {
        "type": "boolean"
      },
      "variableWriteRequired": {
        "type": "boolean"
      },
      "failure": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
