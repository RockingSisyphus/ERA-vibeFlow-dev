{
  "kind": "data_schema",
  "type_key": "era.api.write.post_commit.context",
  "representation": "json",
  "display_name": "ERA·API·提交后·同步上下文",
  "description": "携带已确认消息追加、提交后严格消息快照及不可变 processing message/MK，供 API 因果同步使用；fatal 路由下为 null。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": ["object", "null"],
    "additionalProperties": false,
    "required": ["schemaVersion", "appendResult", "dispatchContext"],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "appendResult": {
        "type": "object"
      },
      "dispatchContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "status",
          "dispatchClass",
          "requirement",
          "messages",
          "processingMessage",
          "processingMk",
          "messageChanged",
          "variablesChanged",
          "failure"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "status": {
            "enum": ["ready", "failed"]
          },
          "dispatchClass": {
            "enum": ["initialize", "sync", "api", "update-mk", "ignore"]
          },
          "requirement": {
            "enum": ["none", "latest-message", "latest-message-with-mk"]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "messageId",
                "role",
                "activeText",
                "swipeIndex"
              ],
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "activeText": {
                  "type": "string"
                },
                "swipeIndex": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "messageChanged": {
            "type": "boolean"
          },
          "variablesChanged": {
            "type": "boolean"
          },
          "failure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "required": ["code", "message", "category", "retryable"],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  },
                  "category": {
                    "enum": ["input", "domain", "tavern", "cancelled"]
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "processingMessage": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schemaVersion",
                  "messageId",
                  "role",
                  "activeText",
                  "swipeIndex"
                ],
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "messageId": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "activeText": {
                    "type": "string"
                  },
                  "swipeIndex": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "processingMk": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
