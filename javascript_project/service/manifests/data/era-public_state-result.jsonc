          "null"
        ]
      },
      "sidecarId": {
        "type": [
          "string",
          "null"
        ]
      },
      "revision": {
        "type": [
          "number",
          "null"
        ]
      },
      "statData": {},
      "statFunc": {
        "type": "object",
        "additionalProperties": true
      },
      "eraMeta": {
        "type": "object",
        "additionalProperties": true
      },
      "stat": {},
      "statWithoutMeta": {},
      "selectedMks": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "editLogs": {
        "type": "object",
        "additionalProperties": true
      },
      "functionEditLogs": {
        "type": "object",
        "additionalProperties": true
      },
      "mk": {
        "type": [
          "string",
          "null"
        ]
      },
      "message_id": {
        "type": [
          "integer",
          "null"
        ]
      },
      "is_user": {
        "const": false
      }
    },
    "required": [
      "status",
      "identity",
      "sidecarId",
      "revision",
      "statData",
      "statFunc",
      "eraMeta",
      "stat",
      "statWithoutMeta",
      "selectedMks",
      "editLogs",
      "functionEditLogs",
      "mk",
      "message_id",
