{
  "kind": "data_schema",
  "type_key": "era.command.operation.state",
  "representation": "json",
  "display_name": "有序操作工作状态",
  "description": "保存当前指令的待处理字段、当前变量和函数、消息开始前的历史起点、随机使用次数及累计日志，供有序操作继续执行。",
  "schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "command",
          "stage-calls"
        ]
      },
      "commands": {
        "type": "array"
      },
      "commandIndex": {
        "type": "integer"
      },
      "rootIndex": {
        "type": "integer"
      },
      "stack": {
        "type": "array"
      },
      "stat": {},
      "statFunc": {
        "type": "object"
      },
      "messageStartStat": {},
      "messageStartStatFunc": {
        "type": "object"
      },
      "randomCursor": {
        "type": [
          "object",
          "null"
        ]
      },
      "functionGroup": {
        "type": [
          "object",
          "null"
        ]
      },
      "stageCallTable": {
        "type": [
          "object",
          "null"
        ]
      },
      "editLog": {
        "type": "array"
      },
      "functionEditLog": {
        "type": "array"
      },
      "diagnostics": {
        "type": "array"
      },
      "done": {
        "type": "boolean"
      },
      "failure": {
        "type": [
          "object",
          "null"
        ]
      },
      "context": {
        "type": "object"
      },
      "pendingAction": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "required": [
      "mode",
      "stack",
      "stat",
      "statFunc",
      "editLog",
      "functionEditLog",
      "diagnostics",
      "done",
      "context"
    ],
    "additionalProperties": false
  }
}
