{
  "kind": "data_schema",
  "type_key": "era.tavern.functions.invoke.result",
  "representation": "json",
  "display_name": "ERA·函数调用·登记结果",
  "description": "登记完成回执。只表示调用已受理，不表示函数已执行完成——函数由 Host 在调用位置之外驱动，等待完成会把当前 FIFO 事件钉死。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": { "const": "accepted" },
      "invocationId": { "type": "string", "minLength": 1 }
    },
    "required": ["status", "invocationId"],
    "additionalProperties": false
  }
}
