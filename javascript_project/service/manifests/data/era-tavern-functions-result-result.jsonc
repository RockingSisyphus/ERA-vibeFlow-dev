{
  "kind": "data_schema",
  "type_key": "era.tavern.functions.result.result",
  "representation": "json",
  "display_name": "ERA·函数调用·终态结果",
  "description": "函数调用的机械终态。completed/failed/cancelled 三态必须区分：酒馆工具调用失败时返回 Error 对象而不是抛异常，因此 unregistered 单独标记，供上层提示作者注册；appliedCount 报告本次调用已经就地应用到当前位置的操作条数。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": { "enum": ["completed", "failed", "cancelled"] },
      "name": { "type": "string" },
      "result": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
      "message": { "type": "string" },
      "unregistered": { "type": "boolean" },
      "appliedCount": { "type": "integer", "minimum": 0 }
    },
    "required": ["status", "name", "result", "message", "unregistered", "appliedCount"],
    "additionalProperties": false
  }
}
