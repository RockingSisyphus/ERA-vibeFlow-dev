{
  "kind": "data_schema",
  "type_key": "era.command.operation.result",
  "representation": "json",
  "display_name": "本段指令的变量、函数、日志和诊断结果",
  "description": "保存一段指令处理完的变量、函数、历史记录、诊断和随机进度，供消息正文或生成阶段整理结果。",
  "schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "command",
          "stage-calls"
        ]
      },
      "commands": {
        "type": "array"
      },
      "commandIndex": {
        "type": "integer"
      },
      "rootIndex": {
        "type": "integer"
      },
      "stack": {
        "type": "array"
      },
      "stat": {},
      "statFunc": {
        "type": "object"
      },
      "messageStartStat": {},
      "messageStartStatFunc": {
        "type": "object"
      },
      "randomCursor": {
        "type": [
          "object",
          "null"
        ]
      },
      "functionGroup": {
        "type": [
          "object",
          "null"
        ]
      },
      "stageCallTable": {
        "type": [
          "object",
          "null"
        ]
      },
      "editLog": {
        "type": "array"
      },
      "functionEditLog": {
        "type": "array"
      },
      "diagnostics": {
        "type": "array"
      },
      "done": {
        "type": "boolean"
      },
      "failure": {
        "type": [
          "object",
          "null"
        ]
      },
      "context": {
        "type": "object"
      },
      "pendingAction": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "required": [
      "mode",
      "stack",
      "stat",
      "statFunc",
      "editLog",
      "functionEditLog",
      "diagnostics",
      "done",
      "context"
    ],
    "additionalProperties": false
  }
}
