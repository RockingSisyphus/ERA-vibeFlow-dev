{
  "kind": "data_schema",
  "type_key": "era.mk.commit.request",
  "representation": "json",
  "display_name": "ERA 消息密钥提交请求",
  "description": "声明先消息后变量的单次逻辑提交所需的明确文本更新、完整 ERAMetaData 与写入标记。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schemaVersion",
      "step",
      "mk",
      "messageUpdate",
      "metaUpdate",
      "messageWriteRequired",
      "variableWriteRequired"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "step": {
        "type": "object"
      },
      "mk": {
        "type": "string",
        "minLength": 1
      },
      "messageUpdate": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "messageId": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "messageId",
          "content"
        ],
        "additionalProperties": false
      },
      "metaUpdate": {
        "type": "object"
      },
      "messageWriteRequired": {
        "type": "boolean"
      },
      "variableWriteRequired": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
