{
  "kind": "data_schema",
  "type_key": "era.agent.candidate.state",
  "display_name": "本次模型尝试的请求、起点和进度",
  "representation": "json",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "request",
      "step",
      "executionState"
    ],
    "properties": {
      "request": {
        "type": "object",
        "additionalProperties": true
      },
      "step": {
        "type": "object",
        "additionalProperties": true
      },
      "executionState": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "description": "保存本次候选的生成请求、已准备步骤和所属批次状态。"
}
