        "type": [
          "object",
          "null"
        ]
      },
      "failure": {
        "type": [
          "object",
          "null"
        ]
      },
      "consumedSource": {
        "type": "boolean"
      },
      "diagnosticsBefore": {
        "type": "integer"
      }
