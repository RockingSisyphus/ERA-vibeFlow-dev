{
  "kind": "data_schema",
  "type_key": "era.tavern.functions.invoke.request",
  "representation": "json",
  "display_name": "ERA·函数调用·登记请求",
  "description": "按调用标识登记一次待调用。标识由 Service 生成且在同一消息内稳定，因此同名同参的多处调用不会互相覆盖；args 为作者工具的参数对象。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "invocationId": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "args": { "type": "object" }
    },
    "required": ["invocationId", "name", "args"],
    "additionalProperties": false
  }
}
