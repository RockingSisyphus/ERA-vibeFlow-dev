{
  "kind": "node",
  "type_key": "era.mk.derive",
  "display_name": "推导消息密钥提交候选",
  "category": "消息密钥纯计算",
  "description": "根据目标消息原文、现有 ERA 元数据及占位符设置，生成或沿用消息标识 MK，并规划正文与标识列表需要怎样更新。作者正文和未知元数据保留，用户消息不补状态栏占位符。输出候选及是否需写入；无法定位目标或输入有问题时输出失败，不在此改动酒馆。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.mk.context",
        "cardinality": "exactly_one",
        "display_name": "MK 上下文"
      }
    ],
    "provides": [
      {
        "key": "mk_candidate",
        "type": "era.mk.candidate",
        "display_name": "MK 候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.context": [
        "输入：MK 上下文。"
      ]
    },
    "output_semantics": {
      "mk_candidate": [
        "输出：MK 候选。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/derive_mk_candidate.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.mk_engine",
    "era.service.types"
  ],
  "capabilities": []
}
