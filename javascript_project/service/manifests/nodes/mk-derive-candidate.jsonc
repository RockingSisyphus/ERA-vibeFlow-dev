{
  "kind": "node",
  "type_key": "era.mk.derive",
  "display_name": "推导消息历史标识提交候选",
  "category": "消息密钥纯计算",
  "description": "结合目标正文、原元数据和占位设置生成消息历史标识候选，保留原作者正文及其他元数据；用户消息仅准备历史标识。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.mk.context",
        "cardinality": "exactly_one",
        "display_name": "消息历史标识 上下文"
      }
    ],
    "provides": [
      {
        "key": "mk_candidate",
        "type": "era.mk.candidate",
        "display_name": "消息历史标识 候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.context": [
        "输入：消息历史标识 上下文。"
      ]
    },
    "output_semantics": {
      "mk_candidate": [
        "输出：消息历史标识 候选。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/derive_mk_candidate.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.mk_engine",
    "era.service.types"
  ],
  "capabilities": []
}
