{
  "kind": "node",
  "type_key": "era.sidecar_binding.apply_resolution",
  "display_name": "执行 Sidecar 绑定事务",
  "category": "Sidecar 绑定",
  "description": "核对原聊天、消息与绑定，确认恢复消息持久化后提交并回读 Sidecar；失败保留实际写入事实。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sidecar.binding.input",
        "cardinality": "exactly_one",
        "display_name": "Sidecar 绑定输入"
      },
      {
        "type": "era.sidecar.binding.resolution",
        "cardinality": "exactly_one",
        "display_name": "Sidecar 绑定决议"
      }
    ],
    "provides": [
      {
        "key": "sidecar_applied_context",
        "type": "era.sync.context",
        "display_name": "事务后的同步上下文"
      },
      {
        "key": "sidecar_binding_route",
        "type": "era.sidecar.binding.route",
        "display_name": "外部 Sidecar 绑定路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sidecar.binding.input": [
        "输入：同步上下文封装。"
      ],
      "era.sidecar.binding.resolution": [
        "输入：确认可执行的 Sidecar 绑定决议。"
      ]
    },
    "output_semantics": {
      "sidecar_applied_context": [
        "输出：完成事务的同步上下文。"
      ],
      "sidecar_binding_route": [
        "输出：apply 完成后继续原同步的外部路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/apply_resolution.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.working_state",
    "era.service.sidecar_resolution_projection"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata",
        "publish_snapshot",
        "create_id",
        "clear_prompt",
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    }
  ]
}
