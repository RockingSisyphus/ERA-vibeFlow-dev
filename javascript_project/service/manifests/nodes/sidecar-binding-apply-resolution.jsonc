{
  "kind": "node",
  "type_key": "era.sidecar_binding.apply_resolution",
  "display_name": "执行 独立状态文件 绑定事务",
  "category": "Sidecar 绑定",
  "description": "执行用户选定的状态文件新建、迁移或修复方案。先提交必要的消息修改，再写入文件及聊天绑定；核对聊天身份和文件版本，记录已完成部分及失败原因。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sidecar.binding.input",
        "cardinality": "exactly_one",
        "display_name": "独立状态文件 绑定输入"
      },
      {
        "type": "era.sidecar.binding.resolution",
        "cardinality": "exactly_one",
        "display_name": "独立状态文件 绑定决议"
      }
    ],
    "provides": [
      {
        "key": "sidecar_applied_context",
        "type": "era.sync.context",
        "display_name": "事务后的同步上下文"
      },
      {
        "key": "sidecar_binding_route",
        "type": "era.sidecar.binding.route",
        "display_name": "外部 独立状态文件 绑定路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sidecar.binding.input": [
        "输入：独立状态文件 绑定输入。"
      ],
      "era.sidecar.binding.resolution": [
        "输入：独立状态文件 绑定决议。"
      ]
    },
    "output_semantics": {
      "sidecar_applied_context": [
        "输出：事务后的同步上下文。"
      ],
      "sidecar_binding_route": [
        "输出：外部 独立状态文件 绑定路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/apply_resolution.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sidecar_resolution_projection",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata",
        "publish_snapshot",
        "create_id",
        "clear_prompt",
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    }
  ]
}
