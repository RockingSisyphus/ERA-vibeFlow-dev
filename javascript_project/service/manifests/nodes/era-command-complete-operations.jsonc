{
  "kind": "node",
  "type_key": "era.command.complete_operations",
  "display_name": "返回本段操作的完整结果",
  "category": "核心执行",
  "description": "当前消息指令的全部字段、整组函数检查或阶段函数清单处理结束后，输出当前变量、函数、历史记录、诊断和随机进度，并标记本段操作已完成。消息流程接着更新正文记录或生成阶段结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志"
      }
    ],
    "provides": [
      {
        "key": "complete_operations_operation_state_after",
        "type": "era.command.operation.state.next",
        "display_name": "完整块内结果"
      },
      {
        "key": "complete_operations_operation_done",
        "type": "era.command.operation.done",
        "display_name": "整个操作范围已结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理字段、当前变量和函数、历史起点、随机次数与日志。"
      ]
    },
    "output_semantics": {
      "complete_operations_operation_state_after": [
        "输出：完整块内结果。"
      ],
      "complete_operations_operation_done": [
        "输出：整个操作范围已结束。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "CompleteOperationsNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
