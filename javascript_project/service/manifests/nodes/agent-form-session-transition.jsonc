{
  "kind": "node",
  "type_key": "era.agent.form_session_transition",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/finish_stage_blocks.ts",
        "export": "FormSessionTransitionNode"
      }
    }
  ],
  "capabilities": [],
  "display_name": "形成会话转换",
  "description": "把候选应用结果转换为后续任务：需要消息保存或历史同步的结果进入共享消息流程，其余结果直接返回生成片段回执。保留原任务和本次允许执行的消息范围。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "批次状态"
      },
      {
        "type": "era.agent.generation.outcome",
        "cardinality": "exactly_one",
        "display_name": "阶段结果"
      }
    ],
    "provides": [
      {
        "key": "agent_transition",
        "type": "era.agent.session.transition",
        "display_name": "会话转换"
      },
      {
        "key": "agent_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤。"
      ],
      "era.batch.execution.state": [
        "输入：批次状态。"
      ],
      "era.agent.generation.outcome": [
        "输入：阶段结果。"
      ]
    },
    "output_semantics": {
      "agent_transition": [
        "输出：会话转换。"
      ],
      "agent_execution_state": [
        "输出：批次状态。"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_session_binding",
    "era.service.agent_stage_handoff",
    "era.service.mk_engine",
    "era.service.types"
  ]
}
