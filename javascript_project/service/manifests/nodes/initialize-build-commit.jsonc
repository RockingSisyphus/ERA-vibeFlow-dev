{
  "kind": "node",
  "type_key": "era.initialize.build_commit",
  "display_name": "构造初始化提交",
  "category": "初始化事务",
  "description": "把初始化计划整理成宿主可执行的资源提交请求，保持设置、世界书、正则和开场白等动作的既定顺序。这里仅形成请求，没有任何资源已经因此写入；下一节点执行后返回的确认结果才代表实际修改。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.changes",
        "cardinality": "exactly_one",
        "display_name": "资源变更"
      }
    ],
    "provides": [
      {
        "key": "resource_commit_request",
        "type": "era.initialize.commit.request",
        "display_name": "资源提交请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.changes": [
        "输入：资源变更。"
      ]
    },
    "output_semantics": {
      "resource_commit_request": [
        "输出：资源提交请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "BuildInitializationCommitNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
