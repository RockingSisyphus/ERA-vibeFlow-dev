{
  "kind": "node",
  "type_key": "era.sync.validate_commit_candidate",
  "display_name": "校验同步提交候选",
  "category": "同步事务",
  "description": "在任何 Capability 写入前验证 processing MK、公开 payload、连续状态和可移植 JSON 合同。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.request",
        "cardinality": "exactly_one",
        "display_name": "同步提交请求"
      }
    ],
    "provides": [
      {
        "key": "commit_validation_route",
        "type": "era.sync.commit.validation.route",
        "display_name": "提交校验路由"
      },
      {
        "key": "validated_commit_request",
        "type": "era.tavern.commit.request",
        "display_name": "已校验同步提交请求"
      },
      {
        "key": "sync_contract_failure",
        "type": "era.sync.commit.contract.failure",
        "display_name": "同步提交合同失败"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.request": ["输入：尚未越过副作用边界的同步提交候选。"]
    },
    "output_semantics": {
      "commit_validation_route": ["输出：valid 或 failed。"],
      "validated_commit_request": [
        "输出：valid 路由下为可以安全提交的候选；failed 路由下不被消费。"
      ],
      "sync_contract_failure": [
        "输出：failed 路由下为无副作用的合同失败；valid 路由下为 null。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/validate_commit_candidate.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.service.sync_transaction"],
  "capabilities": []
}
