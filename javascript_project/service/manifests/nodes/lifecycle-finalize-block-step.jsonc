{
  "kind": "node",
  "type_key": "era.lifecycle.finalize_block_step",
  "display_name": "冻结本批消息与独立状态文件保存候选",
  "category": "内存生命周期",
  "description": "把消息命令执行的最终状态整理为待提交批次，包含正文变更和独立状态文件候选。失败时保留已确认的成功部分，无变化时选择无需提交分支。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "batch_save_request",
        "type": "era.tavern.commit.request",
        "display_name": "批次保存请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "输入：块执行后状态。"
      ]
    },
    "output_semantics": {
      "batch_save_request": [
        "输出：批次保存请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/finalize_block_step.ts",
        "export": "finalize"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_commit_policy",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
