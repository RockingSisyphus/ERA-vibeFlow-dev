{
  "kind": "node",
  "type_key": "era.lifecycle.finalize_block_step",
  "display_name": "冻结本批消息与Sidecar保存候选",
  "category": "内存生命周期",
  "description": "逐块处理结束后，一次性固定本次待保存的消息修改和变量状态，使完成标记与操作记录在同一次消息更新中保存。若中途失败，只保留仍可确认的成功前缀，失败本身继续带到结算；无需提交则输出无写入结果。这里构造并校验保存请求，不执行磁盘写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "batch_save_request",
        "type": "era.tavern.commit.request",
        "display_name": "批次保存请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "全部目标块处理后的消息和工作状态。"
      ]
    },
    "output_semantics": {
      "batch_save_request": [
        "冻结本批待保存消息、Sidecar 状态和成功前缀。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/finalize_block_step.ts",
        "export": "finalize"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_commit_policy",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
