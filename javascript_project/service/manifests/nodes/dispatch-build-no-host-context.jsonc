{
  "kind": "node",
  "type_key": "era.dispatch.build_no_host_context",
  "display_name": "构造无宿主上下文",
  "category": "任务派发",
  "description": "为忽略任务或无需聊天资料的任务建立准备结果，保留事件来源，供后续任务返回对应回执。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.seed",
        "cardinality": "exactly_one",
        "display_name": "派发准备种子"
      }
    ],
    "provides": [
      {
        "key": "no_host_outcome",
        "type": "era.dispatch.preparation.outcome",
        "display_name": "无宿主准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.seed": [
        "输入：派发准备种子。"
      ]
    },
    "output_semantics": {
      "no_host_outcome": [
        "输出：无宿主准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "BuildNoHostContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
