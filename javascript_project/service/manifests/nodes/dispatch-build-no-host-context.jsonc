{
  "kind": "node",
  "type_key": "era.dispatch.build_no_host_context",
  "display_name": "构造无宿主上下文",
  "category": "任务派发",
  "description": "为不需要聊天事实的步骤构造派发上下文，例如明确忽略的事件。保留任务、事件来源和无宿主需求的结论，让后续仍能返回准确回执；不读取消息、变量或状态文件，也不制造消息写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.seed",
        "cardinality": "exactly_one",
        "display_name": "派发准备种子"
      }
    ],
    "provides": [
      {
        "key": "no_host_outcome",
        "type": "era.dispatch.preparation.outcome",
        "display_name": "无宿主准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.seed": [
        "输入：无需宿主上下文的任务种子。"
      ]
    },
    "output_semantics": {
      "no_host_outcome": [
        "输出：零消息、零写入的准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "BuildNoHostContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation"
  ],
  "capabilities": []
}
