{
  "kind": "node",
  "type_key": "era.task.prepare_simple",
  "display_name": "准备标识、设置或忽略任务",
  "category": "服务任务",
  "description": "将消息标识、生成设置或忽略事件的任务及所需聊天资料，交给简单任务执行入口。设置读取和写入在执行入口完成。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "原任务、触发事件与已读取消息"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由"
      }
    ],
    "provides": [
      {
        "key": "simple_prepared_task",
        "type": "era.task.prepared",
        "display_name": "简单任务请求及原任务资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：原任务、触发事件与已读取消息。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次、任务列表与执行位置。"
      ],
      "era.task.route": [
        "输入：已准备任务路由。"
      ]
    },
    "output_semantics": {
      "simple_prepared_task": [
        "输出：简单任务请求及原任务资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "prepareSimpleTask"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation"
  ],
  "capabilities": []
}
