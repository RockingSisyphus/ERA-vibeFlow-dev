{
  "kind": "node",
  "type_key": "era.initialize.prepare_startup_continuation",
  "display_name": "返回启动同步请求与原任务",
  "category": "核心执行",
  "description": "资源准备完成后取出启动历史同步请求和原批次，交给共享消息同步流程。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.startup.sync.step",
        "cardinality": "exactly_one",
        "display_name": "资源处理产生的启动同步步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "原任务、事件来源、批次和回执资料"
      }
    ],
    "provides": [
      {
        "key": "prepare_startup_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "待执行请求及原任务资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.startup.sync.step": [
        "输入：资源处理产生的启动同步步骤。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次、任务列表与执行位置。"
      ],
      "era.task.continuation.context": [
        "输入：原任务、事件来源、批次和回执资料。"
      ]
    },
    "output_semantics": {
      "prepare_startup_continuation_prepared_task": [
        "输出：待执行请求及原任务资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_initialization_adapters.ts",
        "export": "prepareStartupContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.initialization_transaction",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": []
}
