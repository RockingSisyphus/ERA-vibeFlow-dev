{
  "kind": "node",
  "type_key": "era.command.begin_function_candidate",
  "display_name": "建立整组函数候选及恢复起点",
  "category": "核心执行",
  "description": "复制当前完整函数库，保存这一组开始前的函数库和日志起点，再按原名字顺序准备各定义。候选修改不会立即进入当前可调用函数库；整组都收集完成后才交 Expression 校验，数组里的下一根仍按原顺序处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "begin_function_candidate_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "begin_function_candidate_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "BeginFunctionCandidateNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
