{
  "kind": "node",
  "type_key": "era.sync.answer_author_sync",
  "display_name": "回告作者函数提出的同步请求",
  "category": "核心执行",
  "description": "收到运行中的作者函数提出的历史同步请求时，按现有接口规则返回具体拒绝结果，让函数继续完成当前调用；回告失败时记录宿主错误。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前作者函数调用及消息处理进度"
      }
    ],
    "provides": [
      {
        "key": "answer_author_sync_author_state",
        "type": "era.sync.author.state",
        "display_name": "更新后的作者调用及消息进度"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前作者函数调用及消息处理进度。"
      ]
    },
    "output_semantics": {
      "answer_author_sync_author_state": [
        "输出：更新后的作者调用及消息进度。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "AnswerAuthorSyncNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "acknowledge",
        "release"
      ]
    }
  ]
}
