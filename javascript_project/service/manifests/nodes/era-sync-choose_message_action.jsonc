{
  "kind": "node",
  "type_key": "era.sync.choose_message_action",
  "display_name": "识别当前位置要处理的消息内容",
  "category": "核心执行",
  "description": "读取当前消息和正文位置，准备这条消息的历史起点，识别变量指令、作者函数调用、生成阶段调用或消息结束。无法处理的消息推进到下一条；正在运行的作者函数交给作者调用流程。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、变量、函数和日志"
      }
    ],
    "provides": [
      {
        "key": "message_position",
        "type": "era.sync.position.state",
        "display_name": "当前消息、正文位置及变量处理进度"
      },
      {
        "key": "message_action",
        "type": "era.sync.message.action.route",
        "display_name": "当前消息片段的处理动作"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state": [
        "输入：当前消息位置、变量、函数和日志。"
      ]
    },
    "output_semantics": {
      "message_position": [
        "输出：当前消息、正文位置及变量处理进度。"
      ],
      "message_action": [
        "输出：当前消息片段的处理动作。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "ChooseMessageActionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
