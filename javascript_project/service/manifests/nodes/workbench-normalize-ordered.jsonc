{
  "kind": "node",
  "type_key": "era.workbench.normalize_ordered",
  "display_name": "校验显式有序操作",
  "category": "工作台提交",
  "description": "处理工作台的高级有序操作模式，校验允许的变量插入、编辑和删除操作，并保持用户给出的顺序。不会自行重排或解除保护；格式无效时带出准备失败，合格列表随后仍进入统一保护检查和 API 提交，而不是从工作台直接执行。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.draft",
        "cardinality": "exactly_one",
        "display_name": "工作台编辑草稿"
      }
    ],
    "provides": [
      {
        "key": "ordered_operation_plan",
        "type": "era.workbench.operation_plan",
        "display_name": "工作台操作计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.draft": [
        "用户给出的显式有序变量操作。"
      ]
    },
    "output_semantics": {
      "ordered_operation_plan": [
        "校验后保留用户原顺序的操作计划。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_operation_adapters.ts",
        "export": "WorkbenchNormalizeOrderedNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations"
  ],
  "capabilities": []
}
