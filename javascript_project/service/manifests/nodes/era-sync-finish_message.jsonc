        "display_name": "当前位置、变量、函数和待保存正文"
      }
    ],
    "provides": [
      {
        "key": "finished_position",
        "type": "era.sync.position.state",
        "display_name": "当前位置、变量、函数和待保存正文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前位置、变量、函数和待保存正文。"
      ]
    },
    "output_semantics": {
      "finished_position": [
        "输出：当前位置、变量、函数和待保存正文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "FinishMessageNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
