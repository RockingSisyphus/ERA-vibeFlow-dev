{
  "kind": "node",
  "type_key": "era.agent.candidate_finish",
  "display_name": "判断候选是否重试",
  "category": "Agent候选",
  "description": "检查一次生成候选是否需要重试。存在重试请求时保留运行进度继续尝试；否则输出本次生成的最终结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.candidate.state",
        "cardinality": "exactly_one",
        "display_name": "本次模型尝试的请求、起点和进度"
      },
      {
        "type": "era.agent.generation.outcome",
        "cardinality": "exactly_one",
        "display_name": "生成阶段结果"
      }
    ],
    "provides": [
      {
        "key": "candidate_state_after",
        "type": "era.agent.candidate.state.next",
        "display_name": "本次尝试后的进度及重试请求"
      },
      {
        "key": "candidate_done",
        "type": "era.agent.candidate.done",
        "display_name": "本阶段是否已成功或无法继续"
      },
      {
        "key": "candidate_outcome",
        "type": "era.agent.candidate.outcome",
        "display_name": "候选执行结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.candidate.state": [
        "输入：本次模型尝试的请求、起点和进度。"
      ],
      "era.agent.generation.outcome": [
        "输入：生成阶段结果。"
      ]
    },
    "output_semantics": {
      "candidate_state_after": [
        "输出：本次尝试后的进度及重试请求。"
      ],
      "candidate_done": [
        "输出：本阶段是否已成功或无法继续。"
      ],
      "candidate_outcome": [
        "输出：候选执行结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "CandidateFinishNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
