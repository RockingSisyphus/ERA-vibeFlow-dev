{
  "kind": "node",
  "type_key": "era.agent.candidate_finish",
  "display_name": "判断候选是否重试",
  "category": "Agent候选",
  "description": "读取候选执行结果是否附有重试请求：有则将该请求放入候选循环状态，标记尚未结束；没有则输出终态结果并结束候选循环。这里只决定是否继续尝试，不再次调用模型，也不发送阶段完成通知；通知必须等候选已达到终态后形成。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.candidate.state",
        "cardinality": "exactly_one",
        "display_name": "当前候选状态"
      },
      {
        "type": "era.agent.generation.outcome",
        "cardinality": "exactly_one",
        "display_name": "生成阶段结果"
      }
    ],
    "provides": [
      {
        "key": "candidate_state_after",
        "type": "era.agent.candidate.state.next",
        "display_name": "更新后的候选状态"
      },
      {
        "key": "candidate_done",
        "type": "era.agent.candidate.done",
        "display_name": "候选结束标记"
      },
      {
        "key": "candidate_outcome",
        "type": "era.agent.candidate.outcome",
        "display_name": "候选执行结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.candidate.state": [
        "当前候选的请求、步骤和批次状态。"
      ],
      "era.agent.generation.outcome": [
        "本次生成及逐块应用的结果，包含是否需要重新生成。"
      ]
    },
    "output_semantics": {
      "candidate_state_after": [
        "需要重试时换入新请求，否则保留当前候选状态。"
      ],
      "candidate_done": [
        "标明候选循环是否结束。"
      ],
      "candidate_outcome": [
        "移除内部重试请求后交给生成会话的结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "CandidateFinishNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
