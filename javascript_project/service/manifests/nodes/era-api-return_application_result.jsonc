{
  "kind": "node",
  "type_key": "era.api.return_application_result",
  "display_name": "返回消息操作的内存应用回执",
  "category": "服务任务",
  "description": "整理共享消息处理完成后的变量、函数、日志和诊断，形成接口提交回执。调用方根据该回执继续安排保存和显示更新。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "applied_facade_result",
        "type": "era.api.facade.result",
        "display_name": "消息操作的内存应用回执"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "输入：块执行后状态。"
      ]
    },
    "output_semantics": {
      "applied_facade_result": [
        "输出：消息操作的内存应用回执。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "returnApplicationResult"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": [
    {
      "id": "era.lifecycle.admission",
      "operations": [
        "schedule"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
