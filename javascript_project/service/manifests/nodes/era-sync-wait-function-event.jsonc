{
  "kind": "node",
  "type_key": "era.sync.wait_function_event",
  "display_name": "等待作者函数的下一次请求或结束",
  "category": "核心执行",
  "description": "调用原 functions.next 异步等待当前作者函数产出下一条 API 请求或结束结果。等待期间保留当前正文锚点、已应用块数、来源和随机状态，不让 Service 接收其他在途任务；正常等待不等于循环停滞，取消或宿主错误保留原失败结论。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "wait_function_event_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "wait_function_event_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "WaitFunctionEventNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "next"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
