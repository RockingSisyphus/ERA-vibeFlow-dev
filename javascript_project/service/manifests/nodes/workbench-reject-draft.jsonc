{
  "kind": "node",
  "type_key": "era.workbench.reject_draft",
  "display_name": "返回基准或输入失败",
  "category": "工作台提交",
  "description": "把草稿校验阶段已经发现的错误转成提交准备失败，保留具体原因和原调用上下文。不会生成任何变量操作，也不向消息或状态文件写入；后续沿公共 API 的失败回执分支返回，让用户知道编辑为什么没有被应用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.draft",
        "cardinality": "exactly_one",
        "display_name": "工作台编辑草稿"
      }
    ],
    "provides": [
      {
        "key": "rejected_preparation_result",
        "type": "era.workbench.preparation_result",
        "display_name": "工作台准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.draft": [
        "基准或草稿校验发现的错误。"
      ]
    },
    "output_semantics": {
      "rejected_preparation_result": [
        "保留错误并返回失败准备结果，不产生提交操作。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_adapters.ts",
        "export": "WorkbenchRejectDraftNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context"
  ],
  "capabilities": []
}
