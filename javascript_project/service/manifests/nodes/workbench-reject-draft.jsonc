{
  "kind": "node",
  "type_key": "era.workbench.reject_draft",
  "display_name": "返回基准或输入失败",
  "category": "工作台提交",
  "description": "把草稿检查问题转换为公共 调用接口（API） 失败结果，说明需要重新读取或修改的原因。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.draft",
        "cardinality": "exactly_one",
        "display_name": "工作台编辑草稿"
      }
    ],
    "provides": [
      {
        "key": "rejected_preparation_result",
        "type": "era.workbench.preparation_result",
        "display_name": "工作台准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.draft": [
        "输入：工作台编辑草稿。"
      ]
    },
    "output_semantics": {
      "rejected_preparation_result": [
        "输出：工作台准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_adapters.ts",
        "export": "WorkbenchRejectDraftNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context"
  ],
  "capabilities": []
}
