{
  "kind": "node",
  "type_key": "era.command.skip_operation",
  "display_name": "保留跳过操作后的工作状态",
  "category": "核心执行",
  "description": "在目标不存在、保护规则拦截或操作格式应跳过时，保留当前变量和处理进度。随后交给进度整理节点结束本项，使循环能够继续检查后面的操作。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志"
      }
    ],
    "provides": [
      {
        "key": "skip_operation_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本项操作后的变量、函数、待处理字段和日志"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理字段、当前变量和函数、历史起点、随机次数与日志。"
      ]
    },
    "output_semantics": {
      "skip_operation_operation_state": [
        "输出：本项操作后的变量、函数、待处理字段和日志。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "SkipOperationNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
