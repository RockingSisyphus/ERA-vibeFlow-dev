{
  "kind": "node",
  "type_key": "era.workbench.read_baseline",
  "display_name": "读取当前独立状态文件基准",
  "category": "工作台提交",
  "description": "读取当前聊天的状态文件绑定及可用的内存变量、函数，作为用户草稿比较和变更规划的依据。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已读取的提交请求"
      }
    ],
    "provides": [
      {
        "key": "baseline",
        "type": "era.workbench.baseline",
        "display_name": "工作台当前基准"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.inspected": [
        "输入：已读取的提交请求。"
      ]
    },
    "output_semantics": {
      "baseline": [
        "输出：工作台当前基准。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_read_baseline.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.snapshot.history",
    "era.workbench.context",
    "era.workbench.operations"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "read_working"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
