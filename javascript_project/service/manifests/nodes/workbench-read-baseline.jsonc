{
  "kind": "node",
  "type_key": "era.workbench.read_baseline",
  "display_name": "读取当前Sidecar基准",
  "category": "工作台提交",
  "description": "仅使用已有era.tavern.sidecar.read_current/read_record读取身份、绑定指针及Sidecar V3记录；调用已有纯检查核对owner/就绪状态，不迁移、不创建绑定、不写文件。读取失败形成失败事实。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已读取的提交请求"
      }
    ],
    "provides": [
      {
        "key": "baseline",
        "type": "era.workbench.baseline",
        "display_name": "工作台当前基准"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.inspected": [
        "内部工作台提交请求及窗口事实。"
      ]
    },
    "output_semantics": {
      "baseline": [
        "只读 Sidecar 当前记录并核对身份后的编辑基准。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_read_baseline.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations",
    "era.service.sidecar_binding",
    "era.snapshot.history"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "read_working"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
