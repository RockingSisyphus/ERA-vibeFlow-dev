{
  "kind": "node",
  "type_key": "era.sync.skip_message_call",
  "display_name": "记录跳过的函数调用并继续正文",
  "category": "核心执行",
  "description": "当正文中的函数调用按现有规则跳过时，保留跳过原因，标记该调用已处理，并移动到下一个正文片段。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前位置、变量、函数和待保存正文"
      }
    ],
    "provides": [
      {
        "key": "skipped_position",
        "type": "era.sync.position.state",
        "display_name": "当前位置、变量、函数和待保存正文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前位置、变量、函数和待保存正文。"
      ]
    },
    "output_semantics": {
      "skipped_position": [
        "输出：当前位置、变量、函数和待保存正文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "SkipMessageCallNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
