{
  "kind": "node",
  "type_key": "era.command.settle_operation",
  "display_name": "整理当前操作并准备继续",
  "category": "核心执行",
  "description": "清除刚完成或已跳过的操作记录，保留更新后的变量、函数、日志及待处理列表。下一轮据此选择后续字段、下一组函数或下一项阶段调用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理字段、当前变量和函数、历史起点、随机次数与日志"
      }
    ],
    "provides": [
      {
        "key": "settle_operation_operation_state_after",
        "type": "era.command.operation.state.next",
        "display_name": "供下一轮继续的操作状态"
      },
      {
        "key": "settle_operation_operation_done",
        "type": "era.command.operation.done",
        "display_name": "整个当前块的操作是否结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理字段、当前变量和函数、历史起点、随机次数与日志。"
      ]
    },
    "output_semantics": {
      "settle_operation_operation_state_after": [
        "输出：供下一轮继续的操作状态。"
      ],
      "settle_operation_operation_done": [
        "输出：整个当前块的操作是否结束。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "SettleOperationNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
