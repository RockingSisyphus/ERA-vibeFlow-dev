{
  "kind": "node",
  "type_key": "era.expression.execute_era_commands.bridge",
  "display_name": "计算历史同步计划",
  "category": "表达式集成",
  "description": "接收 Service 已限定好消息范围、变量起点和执行原因的计算输入，调用历史同步规划器；其中的表达式计算由独立 Expression 工作流完成，形成后续可执行的工作项。随机来源与偏移沿实际求值链传递。这个边界只做计算，不直接读取或保存酒馆内容。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.command.request",
        "cardinality": "exactly_one",
        "display_name": "表达式命令请求"
      }
    ],
    "provides": [
      {
        "key": "expression_command_result",
        "type": "era.expression.command.result",
        "display_name": "表达式命令结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.command.request": [
        "输入：Sidecar 状态与同步范围 DTO。"
      ]
    },
    "output_semantics": {
      "expression_command_result": [
        "输出：变量、statFunc、日志和诊断的纯同步工作项。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/execute_expression_commands.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_planning"
  ],
  "capabilities": []
}
