{
  "kind": "node",
  "type_key": "era.workbench.apply_protection_choice",
  "display_name": "按实际变更处理保护并生成提交参数",
  "category": "工作台提交",
  "description": "根据实际准备的变化重新计算目标及祖先上的 ERA 保护条件，与用户预览时看到的保护逐项比较，防止提交期间保护已变。需要解锁时必须采用用户明确的选择，生成允许的解锁、操作及恢复顺序；不能临时恢复的必要保护不会被伪造恢复。无变化、条件不一致或缺少选择都返回失败，不在此写数据。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.operation_plan",
        "cardinality": "exactly_one",
        "display_name": "工作台操作计划"
      }
    ],
    "provides": [
      {
        "key": "protected_preparation_result",
        "type": "era.workbench.preparation_result",
        "display_name": "工作台准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.operation_plan": [
        "变量、函数或显式操作及其实际变更。"
      ]
    },
    "output_semantics": {
      "protected_preparation_result": [
        "按确认的保护选择生成待提交操作或明确失败。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_apply_protection.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations",
    "era.workbench.protection"
  ],
  "capabilities": []
}
