{
  "kind": "node",
  "type_key": "era.workbench.apply_protection_choice",
  "display_name": "按实际变更处理保护并生成提交参数",
  "category": "工作台提交",
  "description": "根据当前变量及草稿中的保护设置，判断修改是否需要用户解锁。有效选择按解锁、操作、恢复保护的顺序形成提交列表；不可修改或选择已过期时说明原因。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.operation_plan",
        "cardinality": "exactly_one",
        "display_name": "工作台操作计划"
      }
    ],
    "provides": [
      {
        "key": "protected_preparation_result",
        "type": "era.workbench.preparation_result",
        "display_name": "工作台准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.operation_plan": [
        "输入：工作台操作计划。"
      ]
    },
    "output_semantics": {
      "protected_preparation_result": [
        "输出：工作台准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_apply_protection.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations",
    "era.workbench.protection"
  ],
  "capabilities": []
}
