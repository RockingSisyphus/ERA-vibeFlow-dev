{
  "kind": "node",
  "type_key": "era.agent.prepare_auxiliary_execution_request",
  "display_name": "读取生成事实",
  "category": "故事生成会话",
  "description": "为本次生成读取 Agent 配置、会话和当前变量事实，并优先接续尚未保存的阶段正文。重新生成、切换回复或用户重试某阶段时，按历史日志恢复该阶段应有的起点，保留已经完成的前置内容；旧报告与当前会话不符时记录失效诊断。输出生成事实，不在这里请求模型或保存消息。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      }
    ],
    "provides": [
      {
        "key": "generation_facts",
        "type": "era.agent.generation.facts",
        "display_name": "生成事实"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤"
      ]
    },
    "output_semantics": {
      "generation_facts": [
        "输出：生成事实"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/prepare_auxiliary_execution_request.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.sync_planning",
    "era.service.agent_generation_session",
    "era.service.types",
    "era.service.mk_engine"
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
