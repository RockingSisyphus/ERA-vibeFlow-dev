{
  "kind": "node",
  "type_key": "era.agent.prepare_auxiliary_execution_request",
  "display_name": "读取生成事实",
  "category": "故事生成会话",
  "description": "读取生成配置、当前会话和变量，为下一阶段建立模型请求。优先使用尚未保存的当前正文；重新生成、切换回复或手动重试时恢复对应阶段的历史起点，保留较早阶段成果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      }
    ],
    "provides": [
      {
        "key": "generation_facts",
        "type": "era.agent.generation.facts",
        "display_name": "生成事实"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤。"
      ]
    },
    "output_semantics": {
      "generation_facts": [
        "输出：生成事实。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/prepare_auxiliary_execution_request.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_generation_session",
    "era.service.mk_engine",
    "era.service.sync_block",
    "era.service.sync_work_preparation",
    "era.service.types"
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
