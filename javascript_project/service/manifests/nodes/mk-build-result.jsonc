{
  "kind": "node",
  "type_key": "era.mk.build_result",
  "display_name": "构造消息密钥任务结果",
  "category": "消息密钥结果",
  "description": "依据消息标识准备和提交的真实结果，向任务对应的每个原事件生成一次回执，保留无变更、失败或致命原因。这个节点只完成消息标识任务的结算，不再次写正文，也不把标识更新冒充变量同步或推进连续计算进度。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.mk.commit.result",
        "cardinality": "exactly_one",
        "display_name": "MK 结果"
      }
    ],
    "provides": [
      {
        "key": "update_mk_task_result",
        "type": "era.task.result",
        "display_name": "MK 更新结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.commit.result": [
        "输入：MK 结果。"
      ]
    },
    "output_semantics": {
      "update_mk_task_result": [
        "输出：MK 更新结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/shared_mk_adapters.ts",
        "export": "BuildMkResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.types"
  ],
  "capabilities": []
}
