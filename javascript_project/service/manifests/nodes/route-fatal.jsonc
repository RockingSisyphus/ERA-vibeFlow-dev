{
  "kind": "node",
  "type_key": "era.service.route_fatal",
  "display_name": "路由致命结果",
  "category": "批次发布",
  "description": "读取已经随批次结果确定的致命标记：可继续运行的结果进入下一次事件收集，无法确认写入等致命情况进入抛错分支。分支发生在结果帧已交给宿主之后，因此调用方先得知本批次失败；这里不把普通业务失败升级为致命错误。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.batch.fatal",
        "cardinality": "exactly_one",
        "display_name": "批次致命标记"
      }
    ],
    "provides": [
      {
        "key": "fatal_route",
        "type": "era.fatal.route",
        "display_name": "致命结果路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.fatal": [
        "输入：批次致命标记。"
      ]
    },
    "output_semantics": {
      "fatal_route": [
        "输出：致命结果路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "RouteFatalNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
