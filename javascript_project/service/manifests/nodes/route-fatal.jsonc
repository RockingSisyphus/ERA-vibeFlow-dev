        "display_name": "致命结果路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.fatal": [
        "输入：批次致命标记。"
      ]
    },
    "output_semantics": {
      "fatal_route": [
        "输出：致命结果路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
