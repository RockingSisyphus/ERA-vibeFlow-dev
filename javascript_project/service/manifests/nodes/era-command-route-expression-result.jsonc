{
  "kind": "node",
  "type_key": "era.command.route_expression_result",
  "display_name": "分开数值结果、整组校验和阶段结果",
  "category": "核心执行",
  "description": "结合请求用途和 Expression 实际诊断，区分可应用数值、有效函数库、成功阶段调用及各自失败。数值必须有限且按原规则规范化 -0；修改公式即使失败也保留原随机消耗，阶段函数整表失败的回退范围则按原会话规则处理，不统一成一种错误恢复。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.expression.response",
        "cardinality": "exactly_one",
        "display_name": "Expression 返回值、诊断、随机位置与原操作上下文"
      }
    ],
    "provides": [
      {
        "key": "route_expression_result_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "route_expression_result_expression_route",
        "type": "era.command.expression.route",
        "display_name": "值成功/失败、函数库成功/失败、阶段调用成功/失败"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.expression.response": [
        "输入：Expression 返回值、诊断、随机位置与原操作上下文。"
      ]
    },
    "output_semantics": {
      "route_expression_result_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "route_expression_result_expression_route": [
        "输出：值成功/失败、函数库成功/失败、阶段调用成功/失败。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "RouteExpressionResultNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
