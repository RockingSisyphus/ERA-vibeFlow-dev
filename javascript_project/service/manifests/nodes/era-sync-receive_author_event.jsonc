{
  "kind": "node",
  "type_key": "era.sync.receive_author_event",
  "display_name": "确认上次提交，等待函数下一步请求",
  "category": "核心执行",
  "description": "把上次已经应用的变量提交结果回告作者函数，然后等待函数的下一步事件。收到提交、结束或同步请求时选择对应处理；等待或回告失败时记录宿主错误。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前作者函数调用及消息处理进度"
      }
    ],
    "provides": [
      {
        "key": "receive_author_event_author_state",
        "type": "era.sync.author.state",
        "display_name": "更新后的作者调用及消息进度"
      },
      {
        "key": "author_event",
        "type": "era.sync.author.event.action",
        "display_name": "作者函数接下来要处理的事件"
      },
      {
        "key": "author_finish",
        "type": "era.step.done",
        "display_name": "作者函数已结束或等待请求失败，需要整理并释放调用"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前作者函数调用及消息处理进度。"
      ]
    },
    "output_semantics": {
      "receive_author_event_author_state": [
        "输出：更新后的作者调用及消息进度。"
      ],
      "author_event": [
        "输出：作者函数接下来要处理的事件。"
      ],
      "author_finish": [
        "正常结束或等待失败时为 true，流程进入共同收尾；原事件种类与错误事实保留供收尾处理。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "ReceiveAuthorEventNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "acknowledge",
        "next",
        "release"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
