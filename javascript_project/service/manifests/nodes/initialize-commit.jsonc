{
  "kind": "node",
  "type_key": "era.tavern.initialization_commit",
  "display_name": "提交 Tavern 初始化资源",
  "category": "初始化宿主边界",
  "description": "通过受限宿主接口顺序应用初始化资源计划，并记录哪些动作已确认完成。更新角色主开场白时先保存角色卡，再读取当前首楼事实，按 Service 的规则保留、创建或更新聊天首楼，最后执行相应保存和重绘。不会用早先读取的首楼覆盖用户新操作，失败或部分提交按实际结果返回。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.commit.request",
        "cardinality": "exactly_one",
        "display_name": "资源提交请求"
      }
    ],
    "provides": [
      {
        "key": "resource_commit_result",
        "type": "era.initialize.commit.result",
        "display_name": "资源提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.commit.request": [
        "输入：资源提交请求。"
      ]
    },
    "output_semantics": {
      "resource_commit_result": [
        "输出：资源提交结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/commit_initialization.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.greeting_refresh_policy",
    "era.service.initialization_transaction"
  ],
  "capabilities": [
    {
      "id": "era.tavern.variables",
      "operations": [
        "commit"
      ]
    },
    {
      "id": "era.tavern.worldbook",
      "operations": [
        "create",
        "bind",
        "replace_entries"
      ]
    },
    {
      "id": "era.tavern.regex",
      "operations": [
        "upsert"
      ]
    },
    {
      "id": "era.tavern.character",
      "operations": [
        "write_main_greeting",
        "patch_external_statusbar",
        "patch_single_floor",
        "read_greeting_refresh_context",
        "apply_greeting_refresh"
      ]
    }
  ]
}
