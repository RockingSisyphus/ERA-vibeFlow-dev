{
  "kind": "node",
  "type_key": "era.service.cycle.begin",
  "display_name": "进入收集阶段",
  "category": "服务阶段循环",
  "description": "把初始服务状态标记为“收集事件”阶段，交给长期运行的服务循环。此时尚无批次需要执行，因此第一轮应等待聊天或 API 事件；本节点只增加阶段标签，保留原状态，不读取酒馆或修改变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.state",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "cycle_state_initial",
        "type": "era.service.cycle.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.state": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "cycle_state_initial": [
        "供同一 Service 工作流的下一阶段使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "BeginCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
