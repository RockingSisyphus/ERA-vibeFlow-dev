{
  "kind": "node",
  "type_key": "era.sync.classify_source_block",
  "display_name": "按正文位置识别指令、作者调用或楼层末尾",
  "category": "核心执行",
  "description": "从当前正文解析出有序指令和 EraFCall（正文里的作者 JavaScript 函数调用标签），按块索引取一个位置。指令进入变量/函数操作循环；未处理且非嵌套的作者调用建立执行帧；已处理/嵌套调用按原规则跳过或标记；没有下一块才进入楼层结束，不按标签类型重新排序。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "classify_source_block_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "classify_source_block_source_block_route",
        "type": "era.sync.source.block.route",
        "display_name": "指令、待执行作者调用、已处理/嵌套调用或楼层结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "classify_source_block_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "classify_source_block_source_block_route": [
        "输出：指令、待执行作者调用、已处理/嵌套调用或楼层结束。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "ClassifySourceBlockNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
