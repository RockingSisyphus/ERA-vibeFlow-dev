{
  "kind": "node",
  "type_key": "era.agent.adapt_legacy_step",
  "display_name": "恢复原领域任务路由",
  "category": "故事生成会话",
  "description": "把生成后的消息结算要求转换为普通历史同步或消息历史标识任务，保留原消息位置、事件来源和批次，供共享消息流程继续处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.session.transition",
        "cardinality": "exactly_one",
        "display_name": "多阶段生成 转换"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "legacy_routed_step",
        "type": "era.step.request.routed",
        "display_name": "原领域步骤"
      },
      {
        "key": "legacy_task_route",
        "type": "era.task.route",
        "display_name": "原领域路由"
      },
      {
        "key": "legacy_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "原领域批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.session.transition": [
        "输入：多阶段生成 转换。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态。"
      ]
    },
    "output_semantics": {
      "legacy_routed_step": [
        "输出：原领域步骤。"
      ],
      "legacy_task_route": [
        "输出：原领域路由。"
      ],
      "legacy_execution_state": [
        "输出：原领域批次状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/shared_mk_adapters.ts",
        "export": "AdaptLegacyStepNode"
      }
    }
  ],
  "base_libs": [
    "era.service.types"
  ],
  "capabilities": []
}
