{
  "kind": "node",
  "type_key": "era.sync.complete_author_step",
  "display_name": "返回作者函数处理后的消息进度",
  "category": "核心执行",
  "description": "一次函数启动、请求确认、等待或错误清理完成后，将调用位置、函数运行进度和待应用请求交回消息循环。消息循环据此继续应用函数提交的操作，或等待后续事件。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "本次作者函数处理的最后工作状态"
      }
    ],
    "provides": [
      {
        "key": "complete_author_step_position_state",
        "type": "era.sync.position.state",
        "display_name": "交回消息块循环的位置状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：本次作者函数处理的最后工作状态。"
      ]
    },
    "output_semantics": {
      "complete_author_step_position_state": [
        "输出：交回消息块循环的位置状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "CompleteAuthorStepNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": []
}
