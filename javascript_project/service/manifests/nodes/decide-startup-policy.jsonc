{
  "kind": "node",
  "type_key": "era.installation.scope.decide",
  "display_name": "决定启动策略",
  "category": "服务生命周期",
  "description": "根据脚本的安装位置决定本次 ERA 是否进入完整服务：角色卡内部的脚本继续启动；明确位于全局、预设，或同一脚本 ID 同时属于多个位置的实例只显示提示后结束，避免这些位置重复接管聊天。若宿主无法提供位置，则允许兼容启动并要求警告。这里输出策略，不负责停止其他实例，也不修改聊天。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.installation.scope.classification",
        "cardinality": "exactly_one",
        "display_name": "安装作用域分类"
      }
    ],
    "provides": [
      {
        "key": "installation_scope_decision",
        "type": "era.installation.scope.decision",
        "display_name": "启动决议"
      },
      {
        "key": "installation_scope_route",
        "type": "era.installation.scope.route",
        "display_name": "启动分支"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.installation.scope.classification": [
        "输入：纯安装位置分类。"
      ]
    },
    "output_semantics": {
      "installation_scope_decision": [
        "输出：workflow 启动策略。"
      ],
      "installation_scope_route": [
        "输出：供显式边使用的 allow 或 dormant 路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "DecideStartupPolicyNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
