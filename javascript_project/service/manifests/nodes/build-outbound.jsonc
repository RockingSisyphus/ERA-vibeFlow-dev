{
  "kind": "node",
  "type_key": "era.service.build_outbound",
  "display_name": "构造批次结果帧",
  "category": "批次发布",
  "description": "把已结算批次组织成一个出站结果帧，包括各事件回执、业务通知、诊断和是否必须终止服务的标记，同时得到后续服务状态。相同批次使用稳定标识，便于宿主识别重复结果。这里只构造帧；工作流必须先发送该帧，再处理致命错误。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.finalization",
        "cardinality": "exactly_one",
        "display_name": "批次收尾结果"
      }
    ],
    "provides": [
      {
        "key": "batch_result_frame",
        "type": "era.batch.result",
        "display_name": "批次结果帧"
      },
      {
        "key": "batch_fatal_flag",
        "type": "era.batch.fatal",
        "display_name": "批次致命标记"
      },
      {
        "key": "post_batch_state",
        "type": "era.service.state.post_batch",
        "display_name": "批次后状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.finalization": [
        "输入：批次收尾结果。"
      ]
    },
    "output_semantics": {
      "batch_result_frame": [
        "输出：批次结果帧。"
      ],
      "batch_fatal_flag": [
        "输出：批次致命标记。"
      ],
      "post_batch_state": [
        "输出：批次后状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "BuildOutboundNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
