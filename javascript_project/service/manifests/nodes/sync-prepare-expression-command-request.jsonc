{
  "kind": "node",
  "type_key": "era.sync.prepare_expression_command_request",
  "display_name": "准备同步规划请求",
  "category": "同步规划",
  "description": "将已加载 Sidecar 的同步输入投影为规划所需消息、状态、派发事实和连续计数；不再透传整个上下文。调用登记 sync_planning 模块。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "expression_command_request",
        "type": "era.expression.command.request",
        "display_name": "表达式命令请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：已加载 Sidecar 状态的同步上下文。"
      ]
    },
    "output_semantics": {
      "expression_command_request": [
        "输出：不含 Tavern 引用的命令请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/prepare_expression_command_request.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_planning"
  ],
  "capabilities": []
}
