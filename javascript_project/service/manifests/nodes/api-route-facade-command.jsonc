{
  "kind": "node",
  "type_key": "era.api.route_facade_command",
  "display_name": "区分提交与同步请求",
  "category": "公共 Facade",
  "description": "读取公共 ERA 对象提交给 Service 的命令，把 commit（按顺序应用操作）交给提交事务，把 sync（按历史重新计算）交给共享同步流程，同时携带调用来源和批次状态。公共读取或订阅不属于此事件执行分支。这里仅选择工作流，不确认操作已经生效。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备的任务步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "facade_request",
        "type": "era.api.request",
        "display_name": "公共对象请求"
      },
      {
        "key": "facade_route",
        "type": "era.api.route",
        "display_name": "公共对象命令分支"
      },
      {
        "key": "facade_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "公共对象批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "统一准备后的公共对象任务步骤。"
      ],
      "era.batch.execution.state": [
        "该任务所属的批次状态。"
      ]
    },
    "output_semantics": {
      "facade_request": [
        "从步骤中取出的公共对象请求。"
      ],
      "facade_route": [
        "选择提交或同步分支。"
      ],
      "facade_execution_state": [
        "原批次状态供选定分支继续使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "routeFacadeNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
