{
  "kind": "node",
  "type_key": "era.dispatch.plan_message_preparation",
  "display_name": "规划 MK 与占位符",
  "category": "任务派发",
  "description": "根据聊天事实判断任务将处理哪条消息，以及是否要补充 ERA 消息标识（MK）和状态栏占位符。空的待生成候选仍是独立目标，不用旧候选正文替代。普通变量同步只暂存计划，稍后与变量结果一起保存；仅纯消息标识任务可进入预提交分支。这里规划变更，不直接写酒馆。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.canonical_context",
        "cardinality": "exactly_one",
        "display_name": "严格派发读取上下文"
      }
    ],
    "provides": [
      {
        "key": "dispatch_preparation_plan",
        "type": "era.dispatch.preparation.plan",
        "display_name": "派发准备计划"
      },
      {
        "key": "precommit_route",
        "type": "era.dispatch.precommit.route",
        "display_name": "预提交路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.canonical_context": [
        "输入：严格且可移植的派发读取上下文。"
      ]
    },
    "output_semantics": {
      "dispatch_preparation_plan": [
        "输出：消息文本准备，以及仅属于 update-mk 的元数据准备计划。"
      ],
      "precommit_route": [
        "输出：commit 或 no-op 的互斥路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "PlanMessagePreparationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
