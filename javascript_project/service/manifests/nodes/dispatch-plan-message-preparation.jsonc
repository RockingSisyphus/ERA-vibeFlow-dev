{
  "kind": "node",
  "type_key": "era.dispatch.plan_message_preparation",
  "display_name": "规划 消息历史标识 与占位符",
  "category": "任务派发",
  "description": "为目标消息准备历史标识和状态栏占位内容。历史标识用于关联消息与变量日志；普通变量任务暂存正文修改，单独更新标识的任务形成待提交计划。新建的空 AI 消息也参与准备。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.canonical_context",
        "cardinality": "exactly_one",
        "display_name": "派发读取上下文"
      }
    ],
    "provides": [
      {
        "key": "dispatch_preparation_plan",
        "type": "era.dispatch.preparation.plan",
        "display_name": "派发准备计划"
      },
      {
        "key": "precommit_route",
        "type": "era.dispatch.precommit.route",
        "display_name": "预提交路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.canonical_context": [
        "输入：派发读取上下文。"
      ]
    },
    "output_semantics": {
      "dispatch_preparation_plan": [
        "输出：派发准备计划。"
      ],
      "precommit_route": [
        "输出：预提交路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "PlanMessagePreparationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
