{
  "kind": "node",
  "type_key": "era.agent.candidate_seed",
  "display_name": "建立候选状态",
  "category": "Agent候选",
  "description": "建立一次生成候选的起始状态，保存原请求和批次。替换旧阶段时，先把应保留的较早阶段变量、函数和会话结果恢复到内存；准备失败时返回失败结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.request",
        "cardinality": "exactly_one",
        "display_name": "生成请求"
      },
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备的任务步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "display_name": "候选状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.request": [
        "输入：生成请求。"
      ],
      "era.step.request.routed": [
        "输入：已准备的任务步骤。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次状态。"
      ]
    },
    "output_semantics": {
      "candidate_state": [
        "输出：候选状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/candidate_seed.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_session_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_session_binding",
        "write_session"
      ]
    }
  ]
}
