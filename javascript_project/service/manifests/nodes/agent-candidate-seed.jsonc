{
  "kind": "node",
  "type_key": "era.agent.candidate_seed",
  "display_name": "建立候选状态",
  "category": "Agent候选",
  "description": "为候选重试循环建立初始请求、任务和批次状态。若本次是在替换一个已有阶段，还要先把按历史计算的保留前缀、变量、函数和会话基线安装到当前内存工作状态，撤销旧阶段效果后才能请求新模型候选。基线安装失败转为失败终态，不继续生成；这些更新仅在内存，尚未保存消息或状态文件。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.request",
        "cardinality": "exactly_one",
        "display_name": "生成请求"
      },
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备的任务步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "candidate_state",
        "type": "era.agent.candidate.state",
        "display_name": "候选状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.request": [
        "本阶段要发给模型的生成请求。"
      ],
      "era.step.request.routed": [
        "当前生成事件对应的已准备步骤。"
      ],
      "era.batch.execution.state": [
        "当前事件所属批次的执行状态。"
      ]
    },
    "output_semantics": {
      "candidate_state": [
        "合并请求、步骤和批次状态，供候选循环反复尝试。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/candidate_seed.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_session_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_session_binding",
        "write_session"
      ]
    }
  ]
}
