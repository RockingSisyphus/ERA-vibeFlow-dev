{
  "kind": "node",
  "type_key": "era.mk.build_commit",
  "display_name": "构造消息密钥提交请求",
  "category": "消息密钥纯计算",
  "description": "检查消息标识候选确实有效且需要写入，再把目标正文、元数据和变更标志组织为提交请求。缺少标识、正文或元数据等必要信息会报错；仅构造请求，不表示目标消息已经保存。这份登记实现供需要独立标识提交的调用使用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.mk.candidate.routed",
        "cardinality": "exactly_one",
        "display_name": "已路由 MK 候选"
      }
    ],
    "provides": [
      {
        "key": "mk_commit_request",
        "type": "era.mk.commit.request",
        "display_name": "MK 提交请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.candidate.routed": [
        "输入：已路由 MK 候选。"
      ]
    },
    "output_semantics": {
      "mk_commit_request": [
        "输出：MK 提交请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/shared_mk_adapters.ts",
        "export": "BuildMkCommitNode"
      }
    }
  ],
  "base_libs": [
    "era.service.types"
  ],
  "capabilities": []
}
