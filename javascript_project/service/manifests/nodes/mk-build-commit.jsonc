{
  "kind": "node",
  "type_key": "era.mk.build_commit",
  "display_name": "构造消息历史标识提交请求",
  "category": "消息密钥纯计算",
  "description": "将有效的消息历史标识正文和元数据变更组装为提交请求；资料缺失时返回具体错误。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.mk.candidate.routed",
        "cardinality": "exactly_one",
        "display_name": "已路由 消息历史标识 候选"
      }
    ],
    "provides": [
      {
        "key": "mk_commit_request",
        "type": "era.mk.commit.request",
        "display_name": "消息历史标识 提交请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.candidate.routed": [
        "输入：已路由 消息历史标识 候选。"
      ]
    },
    "output_semantics": {
      "mk_commit_request": [
        "输出：消息历史标识 提交请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/shared_mk_adapters.ts",
        "export": "BuildMkCommitNode"
      }
    }
  ],
  "base_libs": [
    "era.service.types"
  ],
  "capabilities": []
}
