{
  "kind": "node",
  "type_key": "era.sidecar_binding.build_blocked_result",
  "display_name": "结算等待 独立状态文件 选择的任务",
  "category": "Sidecar 绑定",
  "description": "状态文件归属或损坏问题仍需用户选择时，为原事件生成包含选择原因的失败回执，供页面提示和任务结算。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_blocked_result",
        "type": "era.task.result",
        "display_name": "独立状态文件 选择等待结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_blocked_result": [
        "输出：独立状态文件 选择等待结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "BuildBlockedResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
