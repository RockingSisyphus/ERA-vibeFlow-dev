{
  "kind": "node",
  "type_key": "era.api.build_facade_sync_failure",
  "display_name": "构造同步输入失败",
  "category": "公共 Facade",
  "description": "当公共同步请求的模式、目标或其他输入无法通过校验时，直接生成相应的失败回执。此分支没有执行共享同步，所以不会声称历史已重算，也不会读写目标消息来尝试补救；错误按原调用来源返回。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步请求上下文"
      }
    ],
    "provides": [
      {
        "key": "facade_sync_failed_result",
        "type": "era.api.sync.result",
        "display_name": "公共对象同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.sync.context": [
        "无效同步请求及其失败原因。"
      ]
    },
    "output_semantics": {
      "facade_sync_failed_result": [
        "为本次 ERA.sync 返回失败回执，不调用宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "syncFailureNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
