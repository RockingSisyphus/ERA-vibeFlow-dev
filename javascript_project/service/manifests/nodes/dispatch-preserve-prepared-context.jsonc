{
  "kind": "node",
  "type_key": "era.dispatch.preserve_prepared_context",
  "display_name": "保留已准备上下文",
  "category": "任务派发",
  "description": "将准备好的消息正文、元数据、待写入内容和读取错误一起传给下一阶段，供任务执行时使用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.preparation.plan",
        "cardinality": "exactly_one",
        "display_name": "派发准备计划"
      }
    ],
    "provides": [
      {
        "key": "preserved_preparation_outcome",
        "type": "era.dispatch.preparation.outcome",
        "display_name": "已保留准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.preparation.plan": [
        "输入：派发准备计划。"
      ]
    },
    "output_semantics": {
      "preserved_preparation_outcome": [
        "输出：已保留准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "PreservePreparedContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
