{
  "kind": "node",
  "type_key": "era.initialize.prepare_resource_result",
  "display_name": "返回不需同步的资源结果",
  "category": "核心执行",
  "description": "非启动资源操作、失败或无需继续同步的结果，按原来源转换为直接任务结果，再放入准备载体。它不会把资源已处理说成变量已重算；外层只需结算此结果，不调用块引擎。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.direct.result",
        "cardinality": "exactly_one",
        "display_name": "初始化的真实直接结果"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "provides": [
      {
        "key": "prepare_resource_result_prepared_task",
        "type": "era.task.prepared",
        "display_name": "准备完成；仍须在本轮执行并结算的请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.direct.result": [
        "输入：初始化的真实直接结果。"
      ],
      "era.task.continuation.context": [
        "输入：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    },
    "output_semantics": {
      "prepare_resource_result_prepared_task": [
        "输出：准备完成；仍须在本轮执行并结算的请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_initialization_adapters.ts",
        "export": "prepareResourceResult"
      }
    }
  ],
  "base_libs": [
    "era.service.initialization_transaction",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": []
}
