{
  "kind": "node",
  "type_key": "era.service.cycle.route",
  "display_name": "选择服务阶段",
  "category": "服务阶段循环",
  "description": "根据服务当前处于收集还是执行阶段选择对应入口；阶段状态无效时报告流程错误。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "本节点所需的当前运行资料"
      }
    ],
    "provides": [
      {
        "key": "cycle_route",
        "type": "era.service.cycle.route",
        "display_name": "阶段结果"
      },
      {
        "key": "cycle_state_routed",
        "type": "era.service.cycle.routed",
        "display_name": "路由后的阶段状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.cycle.state": [
        "输入：本节点所需的当前运行资料。"
      ]
    },
    "output_semantics": {
      "cycle_route": [
        "输出：阶段结果。"
      ],
      "cycle_state_routed": [
        "输出：路由后的阶段状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "RouteCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
