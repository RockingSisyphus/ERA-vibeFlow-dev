{
  "kind": "node",
  "type_key": "era.service.cycle.route",
  "display_name": "选择服务阶段",
  "category": "服务阶段循环",
  "description": "读取当前循环状态的阶段标签，决定本轮是继续接收事件，还是执行已规划批次中的一个步骤。阶段载体格式无效时直接报错；正常情况下原状态原样传递。这样在执行批次期间不会误走收集分支，使任务顺序保持可预测。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.service.cycle.state",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "cycle_route",
        "type": "era.service.cycle.route",
        "display_name": "阶段结果"
      },
      {
        "key": "cycle_state_routed",
        "type": "era.service.cycle.routed",
        "display_name": "路由后的阶段状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.cycle.state": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "cycle_route": [
        "供同一 Service 工作流的下一阶段使用。"
      ],
      "cycle_state_routed": [
        "原样传递当前阶段状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "RouteCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
