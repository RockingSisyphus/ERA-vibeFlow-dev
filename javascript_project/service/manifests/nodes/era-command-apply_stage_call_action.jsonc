{
  "kind": "node",
  "type_key": "era.command.apply_stage_call_action",
  "display_name": "执行生成阶段安排的函数调用",
  "category": "核心执行",
  "description": "按生成阶段的调用顺序，使用当前变量、函数、历史起点和随机进度计算本次调用，收集结果供阶段使用；失败时记录具体原因并形成阶段调用失败结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理操作、当前变量和函数、历史起点与随机进度"
      }
    ],
    "provides": [
      {
        "key": "apply_stage_call_action_operation_state",
        "type": "era.command.operation.state",
        "display_name": "执行本项操作后的变量、函数、日志及下一字段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理操作、当前变量和函数、历史起点与随机进度。"
      ]
    },
    "output_semantics": {
      "apply_stage_call_action_operation_state": [
        "输出：执行本项操作后的变量、函数、日志及下一字段。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "ApplyStageCallActionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
