{
  "kind": "node",
  "type_key": "era.task.accept_commit_result",
  "display_name": "接回 commit 的真实执行结果",
  "category": "核心执行",
  "description": "将共享 commit 的实际回执与保存的原任务上下文合在一起，保留 Scope、诊断及来源。只适配结果，不再应用操作，也不把内存回执说成实际保存。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.facade.result",
        "cardinality": "exactly_one",
        "display_name": "共享 commit 真实结果"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "provides": [
      {
        "key": "accept_commit_result_executed_task",
        "type": "era.task.execution.result",
        "display_name": "实际执行结果及原任务接续上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.facade.result": [
        "输入：共享 commit 真实结果。"
      ],
      "era.task.continuation.context": [
        "输入：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    },
    "output_semantics": {
      "accept_commit_result_executed_task": [
        "输出：实际执行结果及原任务接续上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "acceptCommitResult"
      }
    }
  ],
  "base_libs": [
    "era.service.task_continuation"
  ],
  "capabilities": []
}
