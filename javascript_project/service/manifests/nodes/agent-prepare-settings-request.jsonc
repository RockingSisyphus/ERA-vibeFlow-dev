{
  "kind": "node",
  "type_key": "era.agent.prepare_settings_request",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/prepare_settings_request.ts",
        "export": "run"
      }
    }
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_context"
      ]
    }
  ],
  "display_name": "准备设置命令",
  "description": "为 Agent 设置命令读取必要配置、预设或连接事实，整理出具体设置请求。设置任务只需要这些资料，不带入模型生成阶段的大量历史和候选上下文；读取或请求问题作为诊断交给执行节点，不在此发起正文生成。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      }
    ],
    "provides": [
      {
        "key": "settings_request",
        "type": "era.agent.settings.request",
        "display_name": "设置请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤"
      ]
    },
    "output_semantics": {
      "settings_request": [
        "输出：设置请求"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_types",
    "era.service.types"
  ]
}
