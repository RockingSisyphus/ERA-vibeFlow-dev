{
  "kind": "node",
  "type_key": "era.task.route_completion_origin",
  "display_name": "区分公共 API 与普通任务收尾",
  "category": "核心执行",
  "description": "根据接续上下文中的原任务类型选择结果通道。公共 API 必须先生成专用 API 结果，其他来源生成普通任务结果；两种出口互斥，统一步骤结算只接收最终外层结果。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.task.execution.result",
        "cardinality": "exactly_one",
        "display_name": "实际执行结果及原任务接续上下文"
      }
    ],
    "provides": [
      {
        "key": "route_completion_origin_completion_origin",
        "type": "era.task.completion.route",
        "display_name": "公共 API 或普通任务出口"
      },
      {
        "key": "route_completion_origin_executed_task",
        "type": "era.task.execution.result",
        "display_name": "实际执行结果及原任务接续上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.execution.result": [
        "输入：实际执行结果及原任务接续上下文。"
      ]
    },
    "output_semantics": {
      "route_completion_origin_completion_origin": [
        "输出：公共 API 或普通任务出口。"
      ],
      "route_completion_origin_executed_task": [
        "输出：实际执行结果及原任务接续上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "routeCompletionOrigin"
      }
    }
  ],
  "base_libs": [
    "era.service.task_continuation"
  ],
  "capabilities": []
}
