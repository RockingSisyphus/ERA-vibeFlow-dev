{
  "kind": "node",
  "type_key": "era.sync.finish_author_call",
  "display_name": "结束作者调用并释放运行资料",
  "category": "核心执行",
  "description": "在作者函数正常结束、调用失败或消息处理范围结束时，整理调用结果，更新正文调用标记，释放函数运行资料，再把最终进度交回消息循环。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前作者函数调用及消息处理进度"
      },
      {
        "type": "era.sync.author.lifecycle.route",
        "cardinality": "optional_one",
        "display_name": "作者函数本次应启动、等待或收尾"
      },
      {
        "type": "era.sync.author.event.action",
        "cardinality": "optional_one",
        "display_name": "作者函数接下来要处理的事件"
      }
    ],
    "provides": [
      {
        "key": "finish_author_call_author_state",
        "type": "era.sync.author.state",
        "display_name": "更新后的作者调用及消息进度"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前作者函数调用及消息处理进度。"
      ],
      "era.sync.author.lifecycle.route": [
        "输入：作者函数本次应启动、等待或收尾。"
      ],
      "era.sync.author.event.action": [
        "输入：作者函数接下来要处理的事件。"
      ]
    },
    "output_semantics": {
      "finish_author_call_author_state": [
        "输出：更新后的作者调用及消息进度。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "FinishAuthorCallNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "acknowledge",
        "release"
      ]
    }
  ]
}
