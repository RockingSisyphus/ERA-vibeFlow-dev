{
  "kind": "node",
  "type_key": "era.service.validate_transport",
  "display_name": "校验传输事件",
  "category": "服务迭代",
  "description": "检查刚从宿主收到的事件是否符合 ERA 的传输格式，包括必需字段、参数封装、体积限制及允许的宿主引用。合格后输出内部可用的事件；不合格时保留相应错误，不把损坏数据当成正常聊天操作继续规划。这一步只验证事件本身，不执行它代表的业务。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.transport.event.raw",
        "cardinality": "exactly_one",
        "display_name": "原始传输事件"
      }
    ],
    "provides": [
      {
        "key": "transport_event",
        "type": "era.transport.event",
        "display_name": "已校验传输事件"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.transport.event.raw": [
        "输入：原始传输事件。"
      ]
    },
    "output_semantics": {
      "transport_event": [
        "输出：已校验传输事件。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "ValidateTransportNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
