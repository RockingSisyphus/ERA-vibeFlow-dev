{
  "kind": "node",
  "type_key": "era.api.commit_facade_message",
  "display_name": "核对原目标后写入（失败可恢复）",
  "category": "公共 Facade",
  "description": "重读允许吸收无关消息新增，但必须保留并核对生成内容对应的原目标正文/Swipe及身份；目标已改变则失败，不刷新依据后覆盖。写入前及写入异常结算失败，不致命停止服务。",
  "version": "1.0.0",
  "flow_kind": "io",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.rechecked",
        "cardinality": "exactly_one",
        "display_name": "era.api.commit.rechecked"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_append_result",
        "type": "era.api.commit.append.result",
        "display_name": "facade_commit_append_result"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.rechecked": [
        "era.api.commit.rechecked"
      ]
    },
    "output_semantics": {
      "facade_commit_append_result": [
        "facade_commit_append_result"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_commit_append.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_nodes"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context",
        "update_content"
      ]
    }
  ]
}
