{
  "kind": "node",
  "type_key": "era.command.apply_insert",
  "display_name": "应用新增值到内存工作副本",
  "category": "核心执行",
  "description": "将已通过路径和保护判断、已完成模板合并的值写到当前缺失路径，按原清理与 own-property 规则处理特殊键和数组。仅修改本块私有变量工作副本，并形成原子新增记录；不保存消息、不回执块完成。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "apply_insert_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "apply_insert_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "ApplyInsertNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
