{
  "kind": "node",
  "type_key": "era.command.inspect_function_group",
  "display_name": "先核对整组函数名与操作形状",
  "category": "核心执行",
  "description": "针对当前函数指令的一个非空根对象，先检查组内全部名字：新增不得覆盖既有函数，修改必须存在，删除补丁只能采用原有空对象或 meta 形式。任何名字/格式无效就拒绝这一组并保留诊断；有效才复制完整函数库作候选，确保后续前向引用不会被逐函数提交破坏。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "inspect_function_group_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "inspect_function_group_function_group_route",
        "type": "era.command.function.group.route",
        "display_name": "建立候选或拒绝整组"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "inspect_function_group_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "inspect_function_group_function_group_route": [
        "输出：建立候选或拒绝整组。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "InspectFunctionGroupNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
