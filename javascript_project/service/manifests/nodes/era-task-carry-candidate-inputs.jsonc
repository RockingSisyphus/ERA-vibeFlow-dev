        "display_name": "原任务来源、步骤和当前批次的接续依据"
      }
    ],
    "provides": [
      {
        "key": "carry_candidate_inputs_context",
        "type": "era.task.continuation.context",
        "display_name": "原任务来源、步骤和当前批次的接续依据"
      },
      {
        "key": "carry_candidate_inputs_step",
        "type": "era.step.request.routed",
        "display_name": "原生成步骤及其目标依据"
      },
      {
        "key": "carry_candidate_inputs_batch",
        "type": "era.batch.execution.state",
        "display_name": "索引尚未推进的同一批次"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.continuation.context": [
        "输入：原任务来源、步骤和当前批次的接续依据。"
      ]
    },
    "output_semantics": {
      "carry_candidate_inputs_context": [
        "输出：原任务来源、步骤和当前批次的接续依据。"
      ],
      "carry_candidate_inputs_step": [
        "输出：原生成步骤及其目标依据。"
      ],
      "carry_candidate_inputs_batch": [
        "输出：索引尚未推进的同一批次。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
