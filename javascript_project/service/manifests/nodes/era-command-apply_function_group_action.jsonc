{
  "kind": "node",
  "type_key": "era.command.apply_function_group_action",
  "display_name": "修改整组函数，通过检查后整体应用",
  "category": "核心执行",
  "description": "在当前函数库的候选副本上依次处理这一组新增、修改、删除及元数据操作，检查名称、元数据和完整函数库。整组有效时一次应用并记录日志，有误时保留原函数库和具体诊断。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理操作、当前变量和函数、历史起点与随机进度"
      }
    ],
    "provides": [
      {
        "key": "apply_function_group_action_operation_state",
        "type": "era.command.operation.state",
        "display_name": "执行本项操作后的变量、函数、日志及下一字段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理操作、当前变量和函数、历史起点与随机进度。"
      ]
    },
    "output_semantics": {
      "apply_function_group_action_operation_state": [
        "输出：执行本项操作后的变量、函数、日志及下一字段。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "ApplyFunctionGroupActionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
