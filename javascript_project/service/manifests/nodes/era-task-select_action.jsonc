{
  "kind": "node",
  "type_key": "era.task.select_action",
  "display_name": "选择执行动作并交付对应请求",
  "category": "服务任务",
  "description": "读取当前任务的准备结果，选择变量提交、历史同步、模型生成、简单任务或直接返回；把对应请求和原任务资料交给选定入口。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.task.prepared",
        "cardinality": "exactly_one",
        "display_name": "任务准备结果"
      }
    ],
    "provides": [
      {
        "key": "action_route",
        "type": "era.task.action.route",
        "display_name": "这项任务接下来要执行的动作"
      },
      {
        "key": "action_continuation",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源与回执资料"
      },
      {
        "key": "action_batch",
        "type": "era.batch.execution.state",
        "display_name": "当前批次和消息进度"
      },
      {
        "key": "action_step",
        "type": "era.step.request.routed",
        "display_name": "本次执行的任务及聊天资料"
      },
      {
        "key": "action_commit",
        "type": "era.api.request.selected",
        "display_name": "选中的变量提交请求"
      },
      {
        "key": "action_candidate",
        "type": "era.agent.candidate.state.selected",
        "display_name": "选中的模型生成请求和起点"
      },
      {
        "key": "action_simple",
        "type": "era.task.route.selected",
        "display_name": "选中的简单任务种类"
      },
      {
        "key": "action_direct",
        "type": "era.task.execution.result.selected",
        "display_name": "准备阶段已确定的任务结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.prepared": [
        "输入：任务准备结果。"
      ]
    },
    "output_semantics": {
      "action_route": [
        "输出：这项任务接下来要执行的动作。"
      ],
      "action_continuation": [
        "输出：原任务、事件来源与回执资料。"
      ],
      "action_batch": [
        "输出：当前批次和消息进度。"
      ],
      "action_step": [
        "输出：本次执行的任务及聊天资料。"
      ],
      "action_commit": [
        "输出：选中的变量提交请求。"
      ],
      "action_candidate": [
        "输出：选中的模型生成请求和起点。"
      ],
      "action_simple": [
        "输出：选中的简单任务种类。"
      ],
      "action_direct": [
        "输出：准备阶段已确定的任务结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "selectAction"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation"
  ],
  "capabilities": []
}
