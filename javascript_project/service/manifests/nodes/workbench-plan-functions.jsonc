{
  "kind": "node",
  "type_key": "era.workbench.plan_functions",
  "display_name": "计算函数库真实增删改",
  "category": "工作台提交",
  "description": "把函数库草稿与当前函数定义比较，生成按顺序执行的新增、编辑或删除操作，保留函数名、原定义及变化类别，供保护检查和提交使用。函数引用等约束沿共用表达式处理链校验；这里不写状态文件，也不直接运行作者函数。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.draft",
        "cardinality": "exactly_one",
        "display_name": "工作台编辑草稿"
      }
    ],
    "provides": [
      {
        "key": "function_operation_plan",
        "type": "era.workbench.operation_plan",
        "display_name": "工作台操作计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.draft": [
        "函数库草稿及当前基准。"
      ]
    },
    "output_semantics": {
      "function_operation_plan": [
        "按函数差异形成有序增删改操作。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_plan_functions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.draft",
    "era.workbench.operations"
  ],
  "capabilities": []
}
