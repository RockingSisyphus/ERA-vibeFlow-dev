      "era.workbench.draft": [
        "输入：工作台编辑草稿。"
      ]
    },
    "output_semantics": {
      "function_operation_plan": [
        "输出：工作台操作计划。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_plan_functions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.draft",
    "era.workbench.operations"
  ],
  "capabilities": []
}
