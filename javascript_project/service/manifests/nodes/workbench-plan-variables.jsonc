{
  "kind": "node",
  "type_key": "era.workbench.plan_variables",
  "display_name": "计算变量草稿增删改",
  "category": "工作台提交",
  "description": "比较当前变量与用户期望值，生成有序的新增、删除和表达式操作。对象类型或模板改变时安排先删除再新增，并标出具体差异位置。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.draft",
        "cardinality": "exactly_one",
        "display_name": "工作台编辑草稿"
      }
    ],
    "provides": [
      {
        "key": "variable_operation_plan",
        "type": "era.workbench.operation_plan",
        "display_name": "工作台操作计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.draft": [
        "输入：工作台编辑草稿。"
      ]
    },
    "output_semantics": {
      "variable_operation_plan": [
        "输出：工作台操作计划。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/workbench_plan_variables.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.draft"
  ],
  "capabilities": []
}
