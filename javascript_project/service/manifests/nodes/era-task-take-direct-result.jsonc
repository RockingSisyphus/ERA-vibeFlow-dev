{
  "kind": "node",
  "type_key": "era.task.take_direct_result",
  "display_name": "接回准备阶段已明确的直接结果",
  "category": "核心执行",
  "description": "当准备或生成收尾明确无需核心执行时，取出其原始直接结果，保持取消、输入失败、无变更或阶段交接的真实含义。它不补跑历史、不隐藏失败，随后与其他执行结果统一适配。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.execution.request",
        "cardinality": "exactly_one",
        "display_name": "直接结果请求"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "provides": [
      {
        "key": "take_direct_result_executed_task",
        "type": "era.task.execution.result",
        "display_name": "实际执行结果及原任务接续上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.execution.request": [
        "输入：直接结果请求。"
      ],
      "era.task.continuation.context": [
        "输入：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    },
    "output_semantics": {
      "take_direct_result_executed_task": [
        "输出：实际执行结果及原任务接续上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "takeDirectResult"
      }
    }
  ],
  "base_libs": [
    "era.service.task_continuation"
  ],
  "capabilities": []
}
