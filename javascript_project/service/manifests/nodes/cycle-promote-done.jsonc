{
  "kind": "node",
  "type_key": "era.service.cycle.promote_done",
  "display_name": "转交完成的批次状态",
  "category": "服务阶段循环",
  "description": "把已完成全部步骤的批次状态送到批次结算通道，保留所有值。这个节点只是转换数据出口，不再推进索引、不额外执行任务；完成条件由之前的任务合并和分支判断提供。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "execution_state_after",
        "type": "era.batch.execution.state.after",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "execution_state_after": [
        "供同一 Service 工作流的下一阶段使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "PromoteDoneCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
