{
  "kind": "node",
  "type_key": "era.sync.plan",
  "display_name": "规划共享同步",
  "category": "同步规划",
  "description": "调用纯同步引擎形成唯一工作项，并显式标注无提交、CRUD 或历史协调分支。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sync_route",
        "type": "era.sync.route",
        "display_name": "同步路由"
      },
      {
        "key": "sync_work",
        "type": "era.sync.work",
        "display_name": "同步工作项"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "sync_route": [
        "输出：同步路由。"
      ],
      "sync_work": [
        "输出：同步工作项。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/plan_sync.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_planning"
  ],
  "capabilities": []
}
