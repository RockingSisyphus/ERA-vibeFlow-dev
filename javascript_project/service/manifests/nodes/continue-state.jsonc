{
  "kind": "node",
  "type_key": "era.service.continue_state",
  "display_name": "继续服务",
  "category": "批次发布",
  "description": "当批次没有致命错误时，导出已经结算后的服务状态，包括后续收集所需进度。原值不变，不重新读取聊天或重算变量；它连接“本批次已发布”与“下一批事件可开始收集”两个时点。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.state.post_batch",
        "cardinality": "exactly_one",
        "display_name": "批次后状态"
      }
    ],
    "provides": [
      {
        "key": "continued_state_next",
        "type": "era.service.state.next",
        "display_name": "继续服务状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.state.post_batch": [
        "输入：批次后状态。"
      ]
    },
    "output_semantics": {
      "continued_state_next": [
        "输出：继续服务状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "ContinueStateNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
