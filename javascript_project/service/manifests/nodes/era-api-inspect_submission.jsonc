{
  "kind": "node",
  "type_key": "era.api.inspect_submission",
  "display_name": "读取提交范围，识别操作或工作台草稿",
  "category": "服务任务",
  "description": "读取当前聊天允许处理的消息范围，识别提交的是有序变量操作还是工作台编辑草稿。草稿先转成有序操作，再进行提交检查。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.api.request.selected",
        "cardinality": "exactly_one",
        "display_name": "公共对象请求"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "commit_inspected",
        "type": "era.api.commit.inspected",
        "display_name": "已读取的提交请求"
      },
      {
        "key": "workbench_request_kind",
        "type": "era.workbench.request_kind",
        "display_name": "工作台请求类型"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.request.selected": [
        "输入：公共对象请求。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次状态。"
      ]
    },
    "output_semantics": {
      "commit_inspected": [
        "输出：已读取的提交请求。"
      ],
      "workbench_request_kind": [
        "输出：工作台请求类型。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "inspectSubmission"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
