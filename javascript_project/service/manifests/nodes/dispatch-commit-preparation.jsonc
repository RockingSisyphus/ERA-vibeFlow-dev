{
  "kind": "node",
  "type_key": "era.dispatch.commit_preparation",
  "display_name": "提交 消息历史标识 与占位符准备",
  "category": "任务派发",
  "description": "提交单独更新消息历史标识任务所需的正文和元数据，记录每项实际写入结果。写入状态无法确认时输出需要停止本轮执行的原因。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.preparation.plan",
        "cardinality": "exactly_one",
        "display_name": "派发准备计划"
      }
    ],
    "provides": [
      {
        "key": "committed_preparation_outcome",
        "type": "era.dispatch.preparation.outcome",
        "display_name": "已提交准备结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.preparation.plan": [
        "输入：派发准备计划。"
      ]
    },
    "output_semantics": {
      "committed_preparation_outcome": [
        "输出：已提交准备结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/commit_preparation.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.sidecar_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata"
      ]
    }
  ]
}
