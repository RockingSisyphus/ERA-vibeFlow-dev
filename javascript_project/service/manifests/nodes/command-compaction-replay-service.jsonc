{"kind":"node","type_key":"era.command_compaction.replay_service","display_name":"用 Service 真实语义重放","category":"命令压缩集成","description":"使用 Service 本身的变量和函数操作规则，重放压缩前后的候选，检查最终状态和相关执行事实是否保持一致。独立压缩器给出候选不代表这里自动接受；确认失败则保留原文本和诊断，防止为缩短文本引入业务变化。","version":"1.0.0","flow_kind":"process","contract":{"requires":[{"type":"era.command_compaction.compacted","cardinality":"exactly_one","display_name":"安全压缩候选"}],"provides":[{"key":"replayed","type":"era.command_compaction.replayed","display_name":"Service 重放结果"}],"params_schema":{},"params_defaults":{},"input_semantics":{"era.command_compaction.compacted":["输入：安全压缩候选。"]},"output_semantics":{"replayed":["输出：生产 CRUD 引擎重放和接受判定。"]}},"implementations":[{"language":"typescript","targets":["browser","node"],"completion":"immediate","source":{"kind":"file","ref":"nodes/sync/command_compaction_replay.ts","export":"run"}}],"base_libs":["era.service.command_compaction","era.crud.engine"],"capabilities":[]}
