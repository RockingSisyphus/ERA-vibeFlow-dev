{
  "kind": "node",
  "type_key": "era.lifecycle.settle_saved_batch",
  "display_name": "结算已保存批次与恢复事实",
  "category": "内存生命周期",
  "description": "汇总保存结果与命令执行结果，保留执行失败的原因。消息来源变化时安排重新计算，待保存内容为空时清除多余保存定时器。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.result",
        "cardinality": "exactly_one",
        "display_name": "酒馆保存结果"
      }
    ],
    "provides": [
      {
        "key": "completed_sync_result",
        "type": "era.tavern.commit.result",
        "display_name": "已结算的保存结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.result": [
        "输入：酒馆保存结果。"
      ]
    },
    "output_semantics": {
      "completed_sync_result": [
        "输出：已结算的保存结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/settle_saved_batch.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": [
    {
      "id": "era.lifecycle.admission",
      "operations": [
        "cancel",
        "schedule"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
