{
  "kind": "node",
  "type_key": "era.lifecycle.publish_block_application",
  "display_name": "发布内存应用结果与推进位置",
  "category": "内存生命周期",
  "description": "把已推进和压缩的结果发布为当前聊天的内存工作状态，连同日志、作用域和待保存正文供接下来的块或 API 读取，标记尚未落盘。若普通历史同步处理的旧 Swipe 已被用户切走且没有发生写入，则放弃旧分支，交给后续重新同步当前历史；作者函数、API 或模型候选失败仍按失败处理，不冒充成功。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.result",
        "cardinality": "exactly_one",
        "display_name": "指令压缩结果"
      }
    ],
    "provides": [
      {
        "key": "block_step_state_after",
        "type": "era.sync.block.step.state.next",
        "display_name": "更新后的块状态"
      },
      {
        "key": "block_step_done",
        "type": "era.step.done",
        "display_name": "块执行结束标记"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.result": [
        "本轮块处理及压缩后的结果。"
      ]
    },
    "output_semantics": {
      "block_step_state_after": [
        "把新消息、日志与随机偏移写回内存工作状态。"
      ],
      "block_step_done": [
        "标明本轮是否已处理完目标块。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_block_state_adapters.ts",
        "export": "PublishBlockApplicationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    }
  ]
}
