{
  "kind": "node",
  "type_key": "era.lifecycle.publish_block_application",
  "display_name": "发布内存应用结果与推进位置",
  "category": "内存生命周期",
  "description": "把压缩后的工作状态更新到同一执行上下文，保留消息起点快照/随机偏移；同步更新API可读投影，不能覆盖后到操作。仅应用完成，不发布整批保存完成或提前ready。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.result",
        "cardinality": "exactly_one",
        "display_name": "指令压缩结果"
      }
    ],
    "provides": [
      {
        "key": "block_step_state_after",
        "type": "era.sync.block.step.state.next",
        "display_name": "更新后的块状态"
      },
      {
        "key": "block_step_done",
        "type": "era.step.done",
        "display_name": "块执行结束标记"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.result": [
        "本轮块处理及压缩后的结果。"
      ]
    },
    "output_semantics": {
      "block_step_state_after": [
        "把新消息、日志与随机偏移写回内存工作状态。"
      ],
      "block_step_done": [
        "标明本轮是否已处理完目标块。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_block_state_adapters.ts",
        "export": "PublishBlockApplicationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    }
  ]
}
