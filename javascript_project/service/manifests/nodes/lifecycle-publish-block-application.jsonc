{
  "kind": "node",
  "type_key": "era.lifecycle.publish_block_application",
  "display_name": "发布内存应用结果与推进位置",
  "category": "内存生命周期",
  "description": "发布消息命令执行后的内存变量、日志、执行范围及待保存正文。普通历史同步遇到旧回复已变化时重新计算当前分支；作者调用产生的 调用接口（API） 候选失败时保留失败结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.result",
        "cardinality": "exactly_one",
        "display_name": "指令压缩结果"
      }
    ],
    "provides": [
      {
        "key": "block_step_state_after",
        "type": "era.sync.block.step.state.next",
        "display_name": "更新后的块状态"
      },
      {
        "key": "block_step_done",
        "type": "era.step.done",
        "display_name": "块执行结束标记"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.result": [
        "输入：指令压缩结果。"
      ]
    },
    "output_semantics": {
      "block_step_state_after": [
        "输出：更新后的块状态。"
      ],
      "block_step_done": [
        "输出：块执行结束标记。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_block_state_adapters.ts",
        "export": "PublishBlockApplicationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    }
  ]
}
