{
  "kind": "node",
  "type_key": "era.service.cycle.resume_collect",
  "display_name": "恢复事件收集阶段",
  "category": "服务阶段循环",
  "description": "把已发布批次的下一轮状态送回事件收集阶段，开始处理后续酒馆事件。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.state.next",
        "cardinality": "exactly_one",
        "display_name": "本节点所需的当前运行资料"
      }
    ],
    "provides": [
      {
        "key": "finished_cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.state.next": [
        "输入：本节点所需的当前运行资料。"
      ]
    },
    "output_semantics": {
      "finished_cycle_state": [
        "输出：阶段结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "ResumeCollectCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
