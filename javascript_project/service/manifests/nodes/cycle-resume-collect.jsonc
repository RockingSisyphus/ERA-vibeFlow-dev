{
  "kind": "node",
  "type_key": "era.service.cycle.resume_collect",
  "display_name": "恢复事件收集阶段",
  "category": "服务阶段循环",
  "description": "把批次结束后可继续运行的服务状态包装回收集阶段，交给长期循环的下一轮。先前任务已经结算和发布；本节点自身不接收事件、不执行保存，只明确下一轮可以恢复接收新请求。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.state.next",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "finished_cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.state.next": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "finished_cycle_state": [
        "供同一 Service 工作流的下一阶段使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "ResumeCollectCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
