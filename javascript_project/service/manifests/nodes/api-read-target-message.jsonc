{
  "kind": "node",
  "type_key": "era.api.read_target_message",
  "display_name": "复查消息写入目标",
  "category": "公共 Facade",
  "description": "提交前重新读取真实消息目标，避免把操作写入已经变化的位置。",
  "version": "1.0.0",
  "flow_kind": "io",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.transaction",
        "cardinality": "exactly_one",
        "display_name": "待提交事务"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_target",
        "type": "era.api.commit.target",
        "display_name": "已定位的提交目标"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.transaction": [
        "已构造事务及其目标依据。"
      ]
    },
    "output_semantics": {
      "facade_commit_target": [
        "写入前重新读取并确认的目标消息。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "readTargetNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
