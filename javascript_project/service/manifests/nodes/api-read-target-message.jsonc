{
  "kind": "node",
  "type_key": "era.api.read_target_message",
  "display_name": "复查消息写入目标",
  "category": "公共 Facade",
  "description": "在准备实际提交前再次读取聊天和目标消息，并复核调用窗口是否仍属于原聊天与候选回复。作者函数把记录定位到调用位置下方，状态栏和外部 API 保留各自捕获的目标。读取视图纳入未保存的内存正文；目标失效则返回失败，不自动转而写入最新一楼。",
  "version": "1.0.0",
  "flow_kind": "io",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.transaction",
        "cardinality": "exactly_one",
        "display_name": "待提交事务"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_target",
        "type": "era.api.commit.target",
        "display_name": "已定位的提交目标"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.transaction": [
        "已构造事务及其目标依据。"
      ]
    },
    "output_semantics": {
      "facade_commit_target": [
        "写入前重新读取并确认的目标消息。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "readTargetNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
