{
  "kind": "node",
  "type_key": "era.sync.route_author_lifecycle",
  "display_name": "选择作者函数的启动、等待或收尾",
  "category": "核心执行",
  "description": "检查正文中的作者 JavaScript 函数运行进度。消息任务已结束或失败时释放函数；调用刚建立时启动它；运行中则确认已应用的提交并等待下一条请求或结束消息。输出本次应执行的函数动作。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "作者调用的正文位置、运行进度和所属任务结果"
      }
    ],
    "provides": [
      {
        "key": "route_author_lifecycle_position_state",
        "type": "era.sync.author.state",
        "display_name": "作者调用本次处理后的消息位置"
      },
      {
        "key": "route_author_lifecycle_author_lifecycle_route",
        "type": "era.sync.author.lifecycle.route",
        "display_name": "终结清理、函数启动或等待下一事件"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：作者调用的正文位置、运行进度和所属任务结果。"
      ]
    },
    "output_semantics": {
      "route_author_lifecycle_position_state": [
        "输出：作者调用本次处理后的消息位置。"
      ],
      "route_author_lifecycle_author_lifecycle_route": [
        "输出：终结清理、函数启动或等待下一事件。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "RouteAuthorLifecycleNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": []
}
