{
  "kind": "node",
  "type_key": "era.api.prepare_failed_continuation",
  "display_name": "返回输入失败及原调用来源",
  "category": "核心执行",
  "description": "把校验失败的公共同步回执连同原来源放入直接结果分支，不运行历史同步。保留原错误类别与诊断，由外层 API 收尾适配为同样的失败回执，不把请求准备当成成功应用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.sync.result",
        "cardinality": "exactly_one",
        "display_name": "真实输入失败回执"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "provides": [
      {
        "key": "prepare_failed_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "准备完成；仍须在本轮执行并结算的请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.sync.result": [
        "输入：真实输入失败回执。"
      ],
      "era.task.continuation.context": [
        "输入：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    },
    "output_semantics": {
      "prepare_failed_continuation_prepared_task": [
        "输出：准备完成；仍须在本轮执行并结算的请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "prepareFailedContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
