{
  "kind": "node",
  "type_key": "era.task.route_entry",
  "display_name": "选择任务准备入口或同步",
  "category": "核心执行",
  "description": "根据原任务类型选择初始化、公共 调用接口（API）、多阶段生成、历史同步或简单任务入口。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "原任务、触发事件与已读取消息"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由"
      }
    ],
    "provides": [
      {
        "key": "route_entry_entry_route",
        "type": "era.task.entry.route",
        "display_name": "初始化、API、多阶段生成、普通同步或简单任务"
      },
      {
        "key": "route_entry_routed_step",
        "type": "era.step.request.routed",
        "display_name": "原任务、触发事件与已读取消息"
      },
      {
        "key": "route_entry_batch_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "key": "route_entry_task_route",
        "type": "era.task.route",
        "display_name": "简单任务原路由"
      },
      {
        "key": "route_entry_entry_continuation",
        "type": "era.task.continuation.context",
        "display_name": "原任务、事件来源、批次和回执资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：原任务、触发事件与已读取消息。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次、任务列表与执行位置。"
      ],
      "era.task.route": [
        "输入：已准备任务路由。"
      ]
    },
    "output_semantics": {
      "route_entry_entry_route": [
        "输出：初始化、API、多阶段生成、普通同步或简单任务。"
      ],
      "route_entry_routed_step": [
        "输出：原任务、触发事件与已读取消息。"
      ],
      "route_entry_batch_state": [
        "输出：当前批次、任务列表与执行位置。"
      ],
      "route_entry_task_route": [
        "输出：简单任务原路由。"
      ],
      "route_entry_entry_continuation": [
        "输出：原任务、事件来源、批次和回执资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "routeEntry"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation"
  ],
  "capabilities": []
}
