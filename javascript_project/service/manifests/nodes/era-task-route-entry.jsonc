{
  "kind": "node",
  "type_key": "era.task.route_entry",
  "display_name": "选择任务准备入口或直属同步",
  "category": "核心执行",
  "description": "从已准备的原步骤和任务路由区分初始化、公共 API、生成会话、普通同步与简单任务。普通同步直接形成执行请求；复杂任务先完成各自准备后返回，当前步骤索引保持不变，因此所有执行仍属于同一个在途任务。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "原步骤、事件来源与已准备消息依据"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前在途批次，索引尚未推进"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由"
      }
    ],
    "provides": [
      {
        "key": "route_entry_entry_route",
        "type": "era.task.entry.route",
        "display_name": "初始化、API、Agent、普通同步或简单任务"
      },
      {
        "key": "route_entry_routed_step",
        "type": "era.step.request.routed",
        "display_name": "原步骤、事件来源与已准备消息依据"
      },
      {
        "key": "route_entry_batch_state",
        "type": "era.batch.execution.state",
        "display_name": "当前在途批次，索引尚未推进"
      },
      {
        "key": "route_entry_task_route",
        "type": "era.task.route",
        "display_name": "简单任务原路由"
      },
      {
        "key": "route_entry_entry_continuation",
        "type": "era.task.continuation.context",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：原步骤、事件来源与已准备消息依据。"
      ],
      "era.batch.execution.state": [
        "输入：当前在途批次，索引尚未推进。"
      ],
      "era.task.route": [
        "输入：已准备任务路由。"
      ]
    },
    "output_semantics": {
      "route_entry_entry_route": [
        "输出：初始化、API、Agent、普通同步或简单任务。"
      ],
      "route_entry_routed_step": [
        "输出：原步骤、事件来源与已准备消息依据。"
      ],
      "route_entry_batch_state": [
        "输出：当前在途批次，索引尚未推进。"
      ],
      "route_entry_task_route": [
        "输出：简单任务原路由。"
      ],
      "route_entry_entry_continuation": [
        "输出：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "routeEntry"
      }
    }
  ],
  "base_libs": [
    "era.service.task_continuation"
  ],
  "capabilities": []
}
