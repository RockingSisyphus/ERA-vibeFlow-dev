{
  "kind": "node",
  "type_key": "era.workbench.route_request_kind",
  "display_name": "区分普通Commit与工作台编辑意图",
  "category": "工作台提交",
  "description": "判断当前提交是否来自变量工作台：普通 ERA.commit 已经带有操作列表，直接继续准入校验；工作台提交带的是用户编辑草稿，需要先转换为操作。两种请求共用同一个提交入口和后续安全检查，避免工作台自行绕过作用域或消息目标校验。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已读取的提交请求"
      }
    ],
    "provides": [
      {
        "key": "commit_inspected",
        "type": "era.api.commit.inspected",
        "display_name": "已读取的提交请求"
      },
      {
        "key": "workbench_request_kind",
        "type": "era.workbench.request_kind",
        "display_name": "工作台请求类型"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.inspected": [
        "已读取的普通提交或内部工作台请求。"
      ]
    },
    "output_semantics": {
      "commit_inspected": [
        "保留原请求与窗口事实供后续分支使用。"
      ],
      "workbench_request_kind": [
        "区分普通有序操作与工作台草稿。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_adapters.ts",
        "export": "WorkbenchRouteRequestKindNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context"
  ],
  "capabilities": []
}
