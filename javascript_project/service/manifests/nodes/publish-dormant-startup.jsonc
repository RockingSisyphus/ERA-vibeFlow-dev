{
  "kind": "node",
  "type_key": "era.installation.scope.publish_dormant",
  "display_name": "发布休眠安装提示",
  "category": "服务生命周期",
  "description": "当当前 ERA 被判定为全局、预设或位置不明确的实例时，要求宿主显示未启动的原因，然后沿结束分支退出。这条分支不会接收聊天事件，也不会加载聊天状态文件、处理宏或启动业务 UI，因而不会以这个实例接管聊天变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.installation.scope.decision",
        "cardinality": "exactly_one",
        "display_name": "启动决议"
      }
    ],
    "provides": [],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.installation.scope.decision": [
        "输入：dormant 启动决议。"
      ]
    },
    "output_semantics": {}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "PublishDormantStartupNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": [
    {
      "id": "era.tavern.startup_gate",
      "operations": [
        "dormant"
      ]
    }
  ]
}
