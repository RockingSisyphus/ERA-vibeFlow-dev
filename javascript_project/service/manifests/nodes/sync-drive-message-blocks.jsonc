{
  "kind": "node",
  "type_key": "era.sync.drive_message_blocks",
  "display_name": "应用下一块或准备楼层维护",
  "category": "同步规划",
  "description": "复用纯块应用语义，独立携带消息起点变量/函数及连续随机偏移；done 仅按标签判断，旧 EraFCallTx 只作普通记录容器。无 done 调用返回 ERA_FCALL_NOT_IMPLEMENTED，不改 done，不处理后续块。准备楼层完成清进度、纯回退和空聊天所需的维护写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state",
        "cardinality": "exactly_one",
        "display_name": "块步进状态"
      }
    ],
    "provides": [
      {
        "key": "block_step_pending",
        "type": "era.sync.block.step.pending",
        "display_name": "待提交状态或本次失败"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state": [
        "块步进状态"
      ]
    },
    "output_semantics": {
      "block_step_pending": [
        "待提交状态或本次失败"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/drive_message_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts",
    "era.service.sync_engine"
  ],
  "capabilities": []
}
