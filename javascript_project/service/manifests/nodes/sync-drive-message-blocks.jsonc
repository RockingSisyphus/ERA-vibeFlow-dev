{
  "kind": "node",
  "type_key": "era.sync.drive_message_blocks",
  "display_name": "应用下一块或准备楼层维护",
  "category": "同步规划",
  "description": "推进当前消息中的一个执行位置，按正文顺序应用变量指令、函数定义或作者函数调用。遇到作者函数时暂停块推进，等待该函数提交操作并就地应用，再返回回执后继续；函数内部不允许发起重算或回滚。更新仅进入内存工作状态，尚未保存。模型候选中的错误交给候选恢复，普通作者错误则保留可确认的成功前缀。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state",
        "cardinality": "exactly_one",
        "display_name": "块步进状态"
      }
    ],
    "provides": [
      {
        "key": "block_step_pending",
        "type": "era.sync.block.step.pending",
        "display_name": "待提交状态或本次失败"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state": [
        "块步进状态"
      ]
    },
    "output_semantics": {
      "block_step_pending": [
        "待提交状态或本次失败"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/drive_message_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_block",
    "era.service.function_block_execution",
    "era.service.agent_stage_program"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "begin",
        "next",
        "acknowledge",
        "release"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
