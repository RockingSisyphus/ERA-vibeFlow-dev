{
  "kind": "node",
  "type_key": "era.sync.drive_message_blocks",
  "display_name": "应用下一块或准备楼层维护",
  "category": "同步规划",
  "description": "复用纯块应用语义，独立携带消息起点变量/函数及连续随机偏移；done 仅按标签判断，旧 EraFCallTx 只作普通记录容器。未执行调用通过原生工具通道运行，其 API 交回同一块循环应用；成功或作者异常后标 done，服务应用失败时拒绝等待请求并释放调用。准备楼层完成清进度、纯回退和空聊天所需的维护写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state",
        "cardinality": "exactly_one",
        "display_name": "块步进状态"
      }
    ],
    "provides": [
      {
        "key": "block_step_pending",
        "type": "era.sync.block.step.pending",
        "display_name": "待提交状态或本次失败"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state": [
        "块步进状态"
      ]
    },
    "output_semantics": {
      "block_step_pending": [
        "待提交状态或本次失败"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/drive_message_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_block",
    "era.service.function_block_execution",
    "era.service.agent_stage_program"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "begin",
        "next",
        "acknowledge",
        "release"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    }
  ]
}
