{
  "kind": "node",
  "type_key": "era.sync.drive_message_blocks",
  "display_name": "推进一个消息块",
  "category": "同步规划",
  "description": "按块推进当前处理楼层，每次只推进一个块：从承载状态恢复流程、执行下一个块、返回下一个状态。遇到无标记 <EraFCall/> 时把路由置为 invoke 并把交接事实（楼层、块下标、调用标识、参数、该位置累计状态）写入状态，本节点不执行函数、也不提交任何状态。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state",
        "cardinality": "exactly_one",
        "display_name": "块步进状态"
      }
    ],
    "provides": [
      {
        "key": "block_step_state_next",
        "type": "era.sync.block.step.pending",
        "display_name": "块步进后状态"
      },
      {
        "key": "block_step_done",
        "type": "era.step.done",
        "display_name": "本次块驱动结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state": [
        "输入：块步进状态。"
      ]
    },
    "output_semantics": {
      "block_step_state_next": [
        "输出：块步进后状态。"
      ],
      "block_step_done": [
        "输出：本次块驱动结束。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/drive_message_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.message_function_flow",
    "era.crud.engine",
    "era.service.message_function_calls",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
