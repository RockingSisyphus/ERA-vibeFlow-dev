{
  "kind": "node",
  "type_key": "era.sidecar_binding.publish_choice_prompt",
  "display_name": "发布 独立状态文件 选择弹窗",
  "category": "Sidecar 绑定",
  "description": "向页面显示状态文件归属冲突或损坏的处理选项，携带聊天身份、文件归属和版本资料；已有有效选择时沿用该选择。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sidecar.binding.resolution",
        "cardinality": "exactly_one",
        "display_name": "独立状态文件 绑定决议"
      }
    ],
    "provides": [],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sidecar.binding.resolution": [
        "输入：独立状态文件 绑定决议。"
      ]
    },
    "output_semantics": {}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "PublishChoicePromptNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "present_prompt"
      ]
    }
  ]
}
