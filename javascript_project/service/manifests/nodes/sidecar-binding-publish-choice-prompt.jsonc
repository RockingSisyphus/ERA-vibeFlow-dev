{
  "kind": "node",
  "type_key": "era.sidecar_binding.publish_choice_prompt",
  "display_name": "发布 Sidecar 选择弹窗",
  "category": "Sidecar 绑定",
  "description": "仅在状态绑定处于等待选择时，要求宿主显示具体问题：文件属于其他聊天则提示冲突，文件或绑定无效则提示修复，并附当前身份、文件归属及版本供用户判断。用户已有有效选择时不会再次弹同一提示。这个节点只显示问题，不替用户选择，也不改变变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sidecar.binding.resolution",
        "cardinality": "exactly_one",
        "display_name": "Sidecar 绑定决议"
      }
    ],
    "provides": [],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sidecar.binding.resolution": [
        "输入：确认需要用户选择的 Sidecar 决议。"
      ]
    },
    "output_semantics": {}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "PublishChoicePromptNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "present_prompt"
      ]
    }
  ]
}
