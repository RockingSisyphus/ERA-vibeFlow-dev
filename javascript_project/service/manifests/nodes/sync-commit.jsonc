{
  "kind": "node",
  "type_key": "era.tavern.variables_commit",
  "display_name": "提交消息与 独立状态文件 并确认读回",
  "category": "同步宿主边界",
  "description": "先提交并确认消息正文批次，再写入独立状态文件、核对文件版本并更新绑定结果。普通历史的消息来源变化时请求重算；部分写入、文件失败或无法确认的写入分别保留实际进度及恢复、停止原因。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.request",
        "cardinality": "exactly_one",
        "display_name": "同步提交请求"
      }
    ],
    "provides": [
      {
        "key": "sync_commit_result",
        "type": "era.tavern.commit.result",
        "display_name": "同步提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.request": [
        "输入：同步提交请求。"
      ]
    },
    "output_semantics": {
      "sync_commit_result": [
        "输出：同步提交结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/commit_sync.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.mk_engine",
    "era.service.sidecar_binding",
    "era.service.sync_commit_policy",
    "era.service.sync_contracts"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata",
        "present_prompt",
        "read_working",
        "write_working"
      ]
    }
  ]
}
