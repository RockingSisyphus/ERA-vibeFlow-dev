{
  "kind": "node",
  "type_key": "era.tavern.variables_commit",
  "display_name": "提交消息与 Sidecar 并确认读回",
  "category": "同步宿主边界",
  "description": "执行共享同步的保存边界：先批量更新并确认目标消息，随后写 Sidecar 状态文件、回读核对版本，再更新聊天绑定的快照。仅内存写入或未确认保存不能当作成功。若普通历史同步的原目标已改变，停止旧分支并交还重算；API 和模型候选保持明确失败。文件失败保留已确认的消息事实并提示修复，写入结果未知则报告致命状态。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.request",
        "cardinality": "exactly_one",
        "display_name": "同步提交请求"
      }
    ],
    "provides": [
      {
        "key": "sync_commit_result",
        "type": "era.tavern.commit.result",
        "display_name": "同步提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.request": [
        "输入：同步提交请求。"
      ]
    },
    "output_semantics": {
      "sync_commit_result": [
        "输出：同步提交结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/commit_sync.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.mk_engine",
    "era.service.sidecar_binding",
    "era.service.sync_commit_policy",
    "era.service.sync_contracts"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata",
        "present_prompt",
        "read_working",
        "write_working"
      ]
    }
  ]
}
