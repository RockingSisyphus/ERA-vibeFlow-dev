{
  "kind": "node",
  "type_key": "era.lifecycle.prepare_api_blocks",
  "display_name": "构造待应用的普通era_tx及工作范围",
  "category": "内存生命周期",
  "description": "将 API 事务暂时插入正确的消息位置：作者函数的调用下方，或已校验外部目标的相应位置，再用共享历史规划器建立逐块应用范围。采用当前内存变量和函数，同时保留此前提交但尚未保存的消息修改；旧楼操作会按历史回退和重算规则处理。这里建立内存执行计划，不立即保存酒馆。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.target",
        "cardinality": "exactly_one",
        "display_name": "提交目标"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "待执行块状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.target": [
        "已确认的消息目标与提交事务。"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "建立待逐块应用的操作、消息范围和工作状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/prepare_api_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_work_preparation"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
