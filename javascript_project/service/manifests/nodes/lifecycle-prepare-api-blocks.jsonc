{
  "kind": "node",
  "type_key": "era.lifecycle.prepare_api_blocks",
  "display_name": "构造待应用的普通era_tx及工作范围",
  "category": "内存生命周期",
  "description": "复用普通事务构造；调用处下方或目标末尾插入待保存消息。当前函数API就地应用，旧楼外部写入按原回退和后续重算规则建立工作范围。应用失败保持真实回执。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.target",
        "cardinality": "exactly_one",
        "display_name": "提交目标"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "待执行块状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.target": [
        "已确认的消息目标与提交事务。"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "建立待逐块应用的操作、消息范围和工作状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/prepare_api_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sync_planning",
    "era.service.sync_contracts",
    "era.service.sidecar_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
