  "contract":{"requires":[{"type":"era.agent.session.transition","cardinality":"exactly_one","display_name":"Agent 转换"},{"type":"era.batch.execution.state","cardinality":"exactly_one","display_name":"当前批次执行状态"}],"provides":[{"key":"agent_route","type":"era.agent.session.route","display_name":"Agent 路由"},{"key":"agent_transition_routed","type":"era.agent.session.transition","display_name":"已路由 Agent 转换"},{"key":"agent_execution_state_routed","type":"era.batch.execution.state","display_name":"已路由批次执行状态"}],"params_schema":{},"params_defaults":{},"input_semantics":{"era.agent.session.transition":["输入：保留完整 mode 的阶段结果。"],"era.batch.execution.state":["输入：随委托分支继续传递的批次状态。"]},"output_semantics":{"agent_route":["输出：legacy 或 direct 互斥后续路由。"],"agent_transition_routed":["透传完整阶段结果，供被选中的后续分支消费。"],"agent_execution_state_routed":["透传当前批次执行状态。"]}},
