{
  "kind": "node",
  "type_key": "era.agent.route_transition",
  "display_name": "路由 Agent 阶段结果",
  "category": "故事生成会话",
  "description": "依据会话转换的模式选择出口：还需要普通消息同步或消息标识结算的结果走共享任务链；只需返回阶段结果、取消或失败的结果走直接回执。模式已由会话逻辑决定，节点不重新判断模型内容，也不更改批次状态。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.agent.session.transition",
        "cardinality": "exactly_one",
        "display_name": "Agent 转换"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "agent_route",
        "type": "era.agent.session.route",
        "display_name": "Agent 路由"
      },
      {
        "key": "agent_transition_routed",
        "type": "era.agent.session.transition",
        "display_name": "已路由 Agent 转换"
      },
      {
        "key": "agent_execution_state_routed",
        "type": "era.batch.execution.state",
        "display_name": "已路由批次执行状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.session.transition": [
        "输入：保留完整 mode 的阶段结果。"
      ],
      "era.batch.execution.state": [
        "输入：随委托分支继续传递的批次状态。"
      ]
    },
    "output_semantics": {
      "agent_route": [
        "输出：legacy 或 direct 互斥后续路由。"
      ],
      "agent_transition_routed": [
        "透传完整阶段结果，供被选中的后续分支消费。"
      ],
      "agent_execution_state_routed": [
        "透传当前批次执行状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "RouteTransitionNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
