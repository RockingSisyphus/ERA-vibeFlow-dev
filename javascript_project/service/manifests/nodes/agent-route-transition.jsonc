{
  "kind": "node",
  "type_key": "era.agent.route_transition",
  "display_name": "路由 多阶段生成 阶段结果",
  "category": "故事生成会话",
  "description": "根据生成结果需要的结算方式选择出口：历史同步或消息历史标识进入共享任务流程，片段完成、取消或失败进入直接返回流程。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.agent.session.transition",
        "cardinality": "exactly_one",
        "display_name": "多阶段生成 转换"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "agent_route",
        "type": "era.agent.session.route",
        "display_name": "多阶段生成 路由"
      },
      {
        "key": "agent_transition_routed",
        "type": "era.agent.session.transition",
        "display_name": "已路由 多阶段生成 转换"
      },
      {
        "key": "agent_execution_state_routed",
        "type": "era.batch.execution.state",
        "display_name": "已路由批次执行状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.session.transition": [
        "输入：多阶段生成 转换。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态。"
      ]
    },
    "output_semantics": {
      "agent_route": [
        "输出：多阶段生成 路由。"
      ],
      "agent_transition_routed": [
        "输出：已路由 多阶段生成 转换。"
      ],
      "agent_execution_state_routed": [
        "输出：已路由批次执行状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "RouteTransitionNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
