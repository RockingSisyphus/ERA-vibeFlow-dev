{
  "kind": "node",
  "type_key": "era.service.cycle.begin_execution",
  "display_name": "进入单步执行阶段",
  "category": "服务阶段循环",
  "description": "把经过覆盖检查的批次状态标记为执行阶段，保留任务列表、当前索引和所有事件来源。下一轮开始执行第一个步骤，而不是再接收一批新事件；这里只切换阶段，不提前执行任务。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "prepared_cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "prepared_cycle_state": [
        "供同一 Service 工作流的下一阶段使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "BeginExecutionCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
