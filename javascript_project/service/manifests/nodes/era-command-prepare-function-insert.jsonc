{
  "kind": "node",
  "type_key": "era.command.prepare_function_insert",
  "display_name": "准备函数新增定义",
  "category": "核心执行",
  "description": "复制当前待新增函数的定义和元数据，记录候选新增动作。此前整组名字检查已经确认名称不存在；这一轮只准备该定义，尚未提交函数库，其他同组函数稍后仍可引用它。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "prepare_function_insert_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "prepare_function_insert_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "PrepareFunctionInsertNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
