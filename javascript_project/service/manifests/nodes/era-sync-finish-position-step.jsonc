{
  "kind": "node",
  "type_key": "era.sync.finish_position_step",
  "display_name": "接续前缀、函数块数及候选错误策略",
  "category": "核心执行",
  "description": "将本位置的完整结果转回原块循环状态。只对实际消耗的原正文块更新 Agent 前缀计数，对函数 commit 插入块减少其 remaining；普通消息保留成功前缀，规划/结算候选的新非作者诊断按原规则拒绝整候选。等待、建帧和阶段表不会误推进正文。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "finish_position_step_block_step_pending",
        "type": "era.sync.block.step.pending",
        "display_name": "本次位置推进的原格式完整结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "finish_position_step_block_step_pending": [
        "输出：本次位置推进的原格式完整结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "FinishPositionStepNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
