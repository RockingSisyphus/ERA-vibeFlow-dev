{
  "kind": "node",
  "type_key": "era.agent.build_result",
  "display_name": "构造 多阶段生成 直接任务结果",
  "category": "故事生成会话",
  "description": "把本次生成片段的实际结果整理为任务回执，附上阶段完成标记、诊断和页面通知。页面可在订阅回调结束后请求执行下一阶段。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.session.transition",
        "cardinality": "exactly_one",
        "display_name": "多阶段生成 转换"
      }
    ],
    "provides": [
      {
        "key": "agent_task_result_direct",
        "type": "era.task.result",
        "display_name": "多阶段生成 直接结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.session.transition": [
        "输入：多阶段生成 转换。"
      ]
    },
    "output_semantics": {
      "agent_task_result_direct": [
        "输出：多阶段生成 直接结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "BuildAgentResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": []
}
