{
  "kind": "node",
  "type_key": "era.agent.build_settings_result",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "BuildSettingsResultNode"
      }
    }
  ],
  "capabilities": [],
  "display_name": "结算设置命令",
  "description": "把配置、预设、连接或模型列表操作的实际结果对应到原请求，输出任务回执及诊断信息。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      },
      {
        "type": "era.agent.settings.outcome",
        "cardinality": "exactly_one",
        "display_name": "设置结果"
      }
    ],
    "provides": [
      {
        "key": "settings_result",
        "type": "era.task.result",
        "display_name": "设置任务结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤。"
      ],
      "era.agent.settings.outcome": [
        "输入：设置结果。"
      ]
    },
    "output_semantics": {
      "settings_result": [
        "输出：设置任务结果。"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ]
}
