{
  "kind": "node",
  "type_key": "era.agent.build_settings_result",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "BuildSettingsResultNode"
      }
    }
  ],
  "capabilities": [],
  "display_name": "结算设置命令",
  "description": "把设置命令的实际返回值和诊断对应到原任务来源，形成一份可由 Service 合并的任务结果。这里只返回设置处理结论，不修改批次索引或进入生成阶段，也不将连接测试成功等同于后续模型生成成功。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备步骤"
      },
      {
        "type": "era.agent.settings.outcome",
        "cardinality": "exactly_one",
        "display_name": "设置结果"
      }
    ],
    "provides": [
      {
        "key": "settings_result",
        "type": "era.task.result",
        "display_name": "设置任务结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备步骤"
      ],
      "era.agent.settings.outcome": [
        "输入：设置结果"
      ]
    },
    "output_semantics": {
      "settings_result": [
        "输出：设置任务结果"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ]
}
