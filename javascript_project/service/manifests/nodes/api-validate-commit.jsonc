      {
        "key": "facade_commit_validated",
        "type": "era.api.commit.validated",
        "display_name": "facade_commit_validated"
      },
      {
        "key": "facade_commit_validation_failure",
        "type": "era.api.commit.failure_context",
        "display_name": "facade_commit_failure_context"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
