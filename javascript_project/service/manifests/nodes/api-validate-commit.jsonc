{
  "kind": "node",
  "type_key": "era.api.validate_commit",
  "display_name": "校验 允许执行范围 与有序操作",
  "category": "公共 Facade",
  "description": "检查有序操作和请求来源，再判断本次提交是否允许执行。消息范围内的重复调用可执行，后续范围已处理的调用可跳过；回复分支按该分支的执行记录判断，强制执行请求每次执行，过期范围返回失败。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.inspected",
        "cardinality": "exactly_one",
        "display_name": "已读取的提交请求"
      }
    ],
    "provides": [
      {
        "key": "commit_admission_route",
        "type": "era.api.commit.admission.route",
        "display_name": "提交准入分支"
      },
      {
        "key": "facade_commit_validated",
        "type": "era.api.commit.validated",
        "display_name": "已校验的提交请求"
      },
      {
        "key": "facade_commit_validation_failure",
        "type": "era.api.commit.failure_context",
        "display_name": "提交校验失败原因"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.inspected": [
        "输入：已读取的提交请求。"
      ]
    },
    "output_semantics": {
      "commit_admission_route": [
        "输出：提交准入分支。"
      ],
      "facade_commit_validated": [
        "输出：已校验的提交请求。"
      ],
      "facade_commit_validation_failure": [
        "输出：提交校验失败原因。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "validateCommitNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": []
}
