{
  "kind": "node",
  "type_key": "era.dispatch.classify_context",
  "display_name": "分类任务与上下文",
  "category": "任务派发",
  "description": "检查所选步骤需要哪一种上下文：初始化、同步和消息标识任务按各自要求准备聊天事实；无需宿主数据的任务及忽略项走无读取分支；公共 ERA 提交和同步调用归入 API 任务。这里决定准备范围，具体的作用域准入和消息写入目标仍由 API 内部校验。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request",
        "cardinality": "exactly_one",
        "display_name": "已选规划步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "dispatch_seed",
        "type": "era.dispatch.seed",
        "display_name": "派发准备种子"
      },
      {
        "key": "context_route",
        "type": "era.dispatch.context.route",
        "display_name": "上下文准备路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request": [
        "输入：等待执行的唯一规划步骤。"
      ],
      "era.batch.execution.state": [
        "输入：当前有界批次执行状态。"
      ]
    },
    "output_semantics": {
      "dispatch_seed": [
        "输出：携带显式任务来源和准备要求的种子。"
      ],
      "context_route": [
        "输出：none 或 read 的互斥路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "ClassifyContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
