{
  "kind": "node",
  "type_key": "era.dispatch.classify_context",
  "display_name": "分类任务与上下文",
  "category": "任务派发",
  "description": "根据任务类型选择所需资料：初始化资源、消息历史同步、消息历史标识或公共 调用接口（API） 上下文；无需聊天资料的任务进入直接准备分支。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request",
        "cardinality": "exactly_one",
        "display_name": "已选规划步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "dispatch_seed",
        "type": "era.dispatch.seed",
        "display_name": "派发准备种子"
      },
      {
        "key": "context_route",
        "type": "era.dispatch.context.route",
        "display_name": "上下文准备路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request": [
        "输入：已选规划步骤。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态。"
      ]
    },
    "output_semantics": {
      "dispatch_seed": [
        "输出：派发准备种子。"
      ],
      "context_route": [
        "输出：上下文准备路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/shared_dispatch_adapters.ts",
        "export": "ClassifyContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.types"
  ],
  "capabilities": []
}
