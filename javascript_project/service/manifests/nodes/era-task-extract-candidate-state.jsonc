{
  "kind": "node",
  "type_key": "era.task.extract_candidate_state",
  "display_name": "取出已经选中的候选初始状态",
  "category": "核心执行",
  "description": "仅在已选择模型候选分支时，从当前准备结果取出真实生成请求、原步骤和批次状态，交给整候选循环。这里不请求模型或应用正文，不用空对象伪装未选中的候选。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.execution.request",
        "cardinality": "exactly_one",
        "display_name": "本在途任务已经选中的执行请求"
      }
    ],
    "provides": [
      {
        "key": "extract_candidate_state_result",
        "type": "era.agent.candidate.state",
        "display_name": "仅本生成分支有效的原候选起点"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.execution.request": [
        "来自任务准备与路由的真实请求；当前分支才读取相应 payload。"
      ]
    },
    "output_semantics": {
      "extract_candidate_state_result": [
        "仅本生成分支有效的原候选起点，交给同级真实执行；不是已经完成的业务结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "extractCandidateState"
      }
    }
  ],
  "base_libs": [
    "era.service.task_continuation"
  ],
  "capabilities": []
}
