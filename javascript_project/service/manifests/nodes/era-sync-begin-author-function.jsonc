{
  "kind": "node",
  "type_key": "era.sync.begin_author_function",
  "display_name": "启动一个作者函数并保留当前调用位置",
  "category": "核心执行",
  "description": "通过原 functions.begin 能力启动这个作者 JavaScript 函数，携带名字、参数和已捕获聊天/Swipe 来源。将调用帧改为等待后交回块循环；它不等待函数完成、不推进下一个原正文块，也不把启动当成作者代码已成功。 宿主调用异常以原错误进入统一函数清理分支，不直接抛出破坏来源结算。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "begin_author_function_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "begin_author_function_function_effect_route",
        "type": "era.sync.function.effect.route",
        "display_name": "宿主动作完成或真实异常"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "begin_author_function_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "begin_author_function_function_effect_route": [
        "输出：宿主动作完成或真实异常。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "BeginAuthorFunctionNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "begin"
      ]
    }
  ]
}
