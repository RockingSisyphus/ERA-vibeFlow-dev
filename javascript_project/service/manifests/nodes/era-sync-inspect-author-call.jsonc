{
  "kind": "node",
  "type_key": "era.sync.inspect_author_call",
  "display_name": "检查正文作者函数名、参数及解析诊断",
  "category": "核心执行",
  "description": "从当前 EraFCall（正文里的作者 JavaScript 函数调用标签）位置取出函数名、参数和解析诊断。语法无效时保留原错误并结束这个调用；有效才交受限宿主开始执行。不会把表达式函数或嵌套调用误作待启动的作者 JavaScript 函数。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "inspect_author_call_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "inspect_author_call_author_call_route",
        "type": "era.sync.author.call.route",
        "display_name": "启动合法调用或结束无效调用"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "inspect_author_call_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "inspect_author_call_author_call_route": [
        "输出：启动合法调用或结束无效调用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "InspectAuthorCallNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": []
}
