{
  "kind": "node",
  "type_key": "era.api.build_commit_failure",
  "display_name": "构造 Commit 失败",
  "category": "公共 Facade",
  "description": "把提交准入、工作台准备或目标读取形成的错误转换成公共调用可收到的失败回执，包括原因和对应来源。这里不重试、不生成替代操作，也不把失败请求写进新目标消息；作用是让调用方明确知道其 commit 没有按要求完成。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.failure_context",
        "cardinality": "exactly_one",
        "display_name": "提交失败上下文"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_failed_result",
        "type": "era.api.commit.result",
        "display_name": "即时提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.failure_context": [
        "输入、窗口或目标校验失败的原因。"
      ]
    },
    "output_semantics": {
      "facade_commit_failed_result": [
        "为本次 ERA.commit 返回失败回执，不提交消息。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "commitFailureNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
