{
  "kind": "node",
  "type_key": "era.agent.execute_session_v2",
  "display_name": "执行生成阶段",
  "category": "故事生成会话",
  "description": "根据已确定的生成阶段和请求执行 Agent 会话，包括必要的模型调用，整理其正文及变量、函数和函数调用标签为候选结果。输出尚待应用和验证的候选、阶段状态及诊断；模型给出文本不代表变量已经提交，格式错误或取消会留给阶段执行和候选恢复环节处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.request",
        "cardinality": "exactly_one",
        "display_name": "阶段请求"
      },
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "实际派发步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前执行状态"
      }
    ],
    "provides": [
      {
        "key": "generation_outcome",
        "type": "era.agent.generation.raw",
        "display_name": "阶段执行结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.request": [
        "输入：阶段请求"
      ],
      "era.step.request.routed": [
        "实际派发步骤"
      ],
      "era.batch.execution.state": [
        "当前执行状态"
      ]
    },
    "output_semantics": {
      "generation_outcome": [
        "输出：阶段执行结果"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/execute_generation_session.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_session_binding",
    "era.service.agent_stage_handoff",
    "era.service.agent_stage_text",
    "era.service.message_function_calls",
    "era.service.agent_generation_context",
    "era.service.agent_generation_planning",
    "era.service.agent_generation_settlement",
    "era.service.agent_generation_continue"
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "await_native_completion",
        "generate",
        "generate_story",
        "inject_once",
        "read_session_binding",
        "write_session",
        "clear_session",
        "create_error_message",
        "stop_native_generation"
      ]
    }
  ]
}
