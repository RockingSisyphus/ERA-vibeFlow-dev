{
  "kind": "node",
  "type_key": "era.agent.execute_session_v2",
  "display_name": "执行生成阶段",
  "category": "故事生成会话",
  "description": "仅执行选定生成阶段及其已有尝试/重试序列。Capability 调用留在有副作用的 Node；会话绑定事实读取、纯决策与 write_session 连续完成。设置命令从此节点移除。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.request",
        "cardinality": "exactly_one",
        "display_name": "阶段请求"
      }
    ],
    "provides": [
      {
        "key": "generation_outcome",
        "type": "era.agent.generation.outcome",
        "display_name": "阶段执行结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.request": [
        "输入：阶段请求"
      ]
    },
    "output_semantics": {
      "generation_outcome": [
        "输出：阶段执行结果"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/execute_generation_session.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_request_policy",
    "era.service.agent_session_binding",
    "era.service.agent_stage_handoff"
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "await_native_completion",
        "generate",
        "generate_story",
        "inject_once",
        "read_session_binding",
        "write_session",
        "clear_session",
        "create_error_message",
        "stop_native_generation"
      ]
    }
  ]
}
