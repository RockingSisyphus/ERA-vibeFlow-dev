    "output_semantics": {"api_message_append_result":["输出：消息追加结果。"]}
  },
  "implementations": [{"language": "typescript", "targets": ["browser"], "completion": "suspend", "source": {"kind": "file", "ref": "nodes/api/commit_api_message_append.ts", "export": "run"}}],
