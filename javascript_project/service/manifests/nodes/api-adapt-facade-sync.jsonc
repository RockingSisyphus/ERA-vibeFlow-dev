{
  "kind": "node",
  "type_key": "era.api.adapt_facade_sync",
  "display_name": "构造 ERA.sync 回执",
  "category": "公共 Facade",
  "description": "把共享同步任务的真实结果转换成 ERA.sync 调用方使用的回执，保留成功、无变更、失败以及诊断，不再次计算历史或保存。它使外部 API 能获得与普通聊天同步相同的业务结论，而不是另实现一套同步规则。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "任务结果"
      },
      {
        "type": "era.api.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步请求上下文"
      }
    ],
    "provides": [
      {
        "key": "facade_sync_committed_result",
        "type": "era.api.sync.result",
        "display_name": "公共对象同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.result": [
        "共享同步流程产生的任务结果。"
      ],
      "era.api.sync.context": [
        "原同步调用的模式与回执上下文。"
      ]
    },
    "output_semantics": {
      "facade_sync_committed_result": [
        "把任务结果转换为本次 ERA.sync 的调用回执。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "adaptSyncNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
