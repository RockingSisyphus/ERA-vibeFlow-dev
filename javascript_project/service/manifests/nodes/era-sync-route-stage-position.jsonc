{
  "kind": "node",
  "type_key": "era.sync.route_stage_position",
  "display_name": "判断阶段 JSON 调用是否轮到当前正文位置",
  "category": "核心执行",
  "description": "仅当当前楼层属于 Agent 阶段、需要重放的原始正文前缀已经逐块处理完、剩余块数为零，且本阶段调用表尚未完成时，计算规划或结算阶段 JSON 中的函数调用清单。没有作者函数帧才允许这条分支；其他情况继续识别正文块，不能提前消耗下一块或重复阶段函数。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "route_stage_position_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "route_stage_position_stage_position_route",
        "type": "era.sync.stage.position.route",
        "display_name": "阶段函数表或下一正文块"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "route_stage_position_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "route_stage_position_stage_position_route": [
        "输出：阶段函数表或下一正文块。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "RouteStagePositionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
