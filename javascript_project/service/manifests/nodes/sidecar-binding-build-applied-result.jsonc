{
  "kind": "node",
  "type_key": "era.sidecar_binding.build_applied_result",
  "display_name": "结算已完成的 独立状态文件 绑定",
  "category": "Sidecar 绑定",
  "description": "把状态文件绑定或修复的实际完成结果对应到原事件，保留已在内存中应用的 调用接口（API） 修改，形成本次任务结算结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_applied_result",
        "type": "era.task.result",
        "display_name": "已完成 独立状态文件 修复结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_applied_result": [
        "输出：已完成 独立状态文件 修复结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "BuildAppliedResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
