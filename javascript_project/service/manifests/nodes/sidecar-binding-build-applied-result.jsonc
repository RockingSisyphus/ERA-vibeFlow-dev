{
  "kind": "node",
  "type_key": "era.sidecar_binding.build_applied_result",
  "display_name": "结算已完成的 Sidecar 绑定",
  "category": "Sidecar 绑定",
  "description": "状态文件修复已通过独立文件事务完成时，向本任务每个来源返回已完成结算，并标记无需再做普通同步。这里不重算历史或再次保存，避免把修复后仅存在于当前变量状态的 API 修改按旧聊天正文重放掉。此出口只表示修复分支无需额外动作，不能代替所有历史同步的结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_applied_result",
        "type": "era.task.result",
        "display_name": "已完成 Sidecar 修复结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：已经完成 Sidecar repair 的同步上下文。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_applied_result": [
        "输出：正常 no-op 结算；不再次执行变量重算。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "BuildAppliedResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
