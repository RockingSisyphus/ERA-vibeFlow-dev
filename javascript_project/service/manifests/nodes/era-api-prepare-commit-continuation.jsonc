{
  "kind": "node",
  "type_key": "era.api.prepare_commit_continuation",
  "display_name": "返回原位提交请求",
  "category": "核心执行",
  "description": "将公共 ERA.commit 的请求和当前批次交还本轮 Service，保留操作顺序、调用窗口、Scope 与目标依据。这里不应用变量或提前发送回执；共享 commit 流程完成后才按原 API 格式返回结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.request",
        "cardinality": "exactly_one",
        "display_name": "待执行公共提交请求"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前在途批次，索引尚未推进"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "本次请求所属的原步骤、来源、批次和回执适配依据"
      }
    ],
    "provides": [
      {
        "key": "prepare_commit_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "准备完成；仍须在本轮执行并结算的请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.request": [
        "输入：待执行公共提交请求。"
      ],
      "era.batch.execution.state": [
        "输入：当前在途批次，索引尚未推进。"
      ],
      "era.task.continuation.context": [
        "输入：本次请求所属的原步骤、来源、批次和回执适配依据。"
      ]
    },
    "output_semantics": {
      "prepare_commit_continuation_prepared_task": [
        "输出：准备完成；仍须在本轮执行并结算的请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "prepareCommitContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
