{
  "kind": "node",
  "type_key": "era.api.prepare_commit_continuation",
  "display_name": "返回原位提交请求",
  "category": "核心执行",
  "description": "取出公共 调用接口（API） 提交请求和原批次，交给 Service 的提交执行流程，并保留回执所需的请求来源。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.request",
        "cardinality": "exactly_one",
        "display_name": "待执行公共提交请求"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "原任务、事件来源、批次和回执资料"
      }
    ],
    "provides": [
      {
        "key": "prepare_commit_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "待执行请求及原任务资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.request": [
        "输入：待执行公共提交请求。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次、任务列表与执行位置。"
      ],
      "era.task.continuation.context": [
        "输入：原任务、事件来源、批次和回执资料。"
      ]
    },
    "output_semantics": {
      "prepare_commit_continuation_prepared_task": [
        "输出：待执行请求及原任务资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "prepareCommitContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": []
}
