{
  "kind": "node",
  "type_key": "era.service.cycle.carry_execution",
  "display_name": "携带下一步骤状态",
  "category": "服务阶段循环",
  "description": "把下一任务位置、累计结果和消息处理进度放回执行循环，供后续任务继续使用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "本节点所需的当前运行资料"
      }
    ],
    "provides": [
      {
        "key": "settled_cycle_state",
        "type": "era.service.cycle.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "输入：本节点所需的当前运行资料。"
      ]
    },
    "output_semantics": {
      "settled_cycle_state": [
        "输出：阶段结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "CarryExecutionCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
