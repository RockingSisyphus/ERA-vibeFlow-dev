{
  "kind": "node",
  "type_key": "era.service.coverage_failure",
  "display_name": "构造覆盖失败结果",
  "category": "批次执行",
  "description": "将覆盖无效批次的全部来源构造成 typed failed 结算，服务本身继续运行。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "初始执行状态"
      }
    ],
    "provides": [
      {
        "key": "coverage_failure_state",
        "type": "era.batch.execution.state.after",
        "display_name": "覆盖失败状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "输入：初始执行状态。"
      ]
    },
    "output_semantics": {
      "coverage_failure_state": [
        "输出：覆盖失败状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "CoverageFailureNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
