{
  "kind": "node",
  "type_key": "era.service.coverage_failure",
  "display_name": "构造覆盖失败结果",
  "category": "批次执行",
  "description": "当任务计划的来源覆盖检查不通过时，给本批次每个原始事件生成一条失败结算，保留检查诊断，并把批次标为待结束。不会执行计划中的任何领域任务；其意义是即使规划出错，等待结果的调用方也能收到明确失败。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "初始执行状态"
      }
    ],
    "provides": [
      {
        "key": "coverage_failure_state",
        "type": "era.batch.execution.state.after",
        "display_name": "覆盖失败状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "输入：初始执行状态。"
      ]
    },
    "output_semantics": {
      "coverage_failure_state": [
        "输出：覆盖失败状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "CoverageFailureNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
