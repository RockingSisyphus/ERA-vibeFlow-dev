{
  "kind": "node",
  "type_key": "era.sync.install_author_frame",
  "display_name": "记录作者函数的调用位置和进度",
  "category": "核心执行",
  "description": "遇到尚未执行的作者 JavaScript 函数调用时，记录它所在的消息、正文位置和插入操作数量，并在调用后放置临时定位标记。下一轮依据这些记录启动函数；函数提交的操作将接在这个位置处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "消息及正文位置、允许处理范围和作者调用进度"
      }
    ],
    "provides": [
      {
        "key": "install_author_frame_position_state",
        "type": "era.sync.position.state",
        "display_name": "更新后的消息位置、内存变量和待保存正文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：消息及正文位置、允许处理范围和作者调用进度。"
      ]
    },
    "output_semantics": {
      "install_author_frame_position_state": [
        "输出：更新后的消息位置、内存变量和待保存正文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "InstallAuthorFrameNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
