{
  "kind": "node",
  "type_key": "era.agent.prepare_stage_handoff",
  "display_name": "形成阶段交接与恢复凭据",
  "description": "在生成阶段成功后建立完成标记、阶段结果和下一阶段恢复资料。页面接到通知后依次执行订阅回调，再按恢复资料请求继续。",
  "category": "故事生成会话",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.candidate.outcome",
        "cardinality": "exactly_one",
        "display_name": "阶段执行结果"
      }
    ],
    "provides": [
      {
        "key": "handoff_outcome",
        "type": "era.agent.generation.outcome",
        "display_name": "含交接意图的阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.candidate.outcome": [
        "输入：阶段执行结果。"
      ]
    },
    "output_semantics": {
      "handoff_outcome": [
        "输出：含交接意图的阶段结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/finish_stage_blocks.ts",
        "export": "PrepareStageHandoffNode"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_session_binding",
    "era.service.agent_stage_handoff",
    "era.service.mk_engine",
    "era.service.types"
  ],
  "capabilities": []
}
