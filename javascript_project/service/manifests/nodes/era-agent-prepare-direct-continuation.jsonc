{
  "kind": "node",
  "type_key": "era.agent.prepare_direct_continuation",
  "display_name": "返回当前阶段片段的结果",
  "category": "核心执行",
  "description": "将阶段交接、取消或失败结果与原请求一起整理为直接返回资料，供任务结算使用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "阶段直接结果"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "原任务、事件来源、批次和回执资料"
      }
    ],
    "provides": [
      {
        "key": "prepare_direct_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "待执行请求及原任务资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.result": [
        "输入：阶段直接结果。"
      ],
      "era.task.continuation.context": [
        "输入：原任务、事件来源、批次和回执资料。"
      ]
    },
    "output_semantics": {
      "prepare_direct_continuation_prepared_task": [
        "输出：待执行请求及原任务资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "prepareDirectContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": []
}
