{
  "kind": "node",
  "type_key": "era.tavern.mk_commit",
  "display_name": "按逻辑边界提交消息密钥",
  "category": "消息密钥宿主边界",
  "description": "按消息标识提交请求执行宿主写入，确认正文和相关元数据的实际结果，返回已提交、失败或无法安全继续的结论。正文与元数据的关系必须一致，部分写入不能当成完整成功；这里处理的是标识准备，不重新执行变量指令。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.mk.commit.request",
        "cardinality": "exactly_one",
        "display_name": "MK 提交请求"
      }
    ],
    "provides": [
      {
        "key": "mk_commit_outcome",
        "type": "era.mk.commit.result",
        "display_name": "MK 提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.commit.request": [
        "输入：MK 提交请求。"
      ]
    },
    "output_semantics": {
      "mk_commit_outcome": [
        "输出：MK 提交结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/commit_mk.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.types"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "update_content"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "write_record",
        "commit_metadata"
      ]
    }
  ]
}
