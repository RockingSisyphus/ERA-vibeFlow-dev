{
  "kind": "node",
  "type_key": "era.command_compaction.apply_sealed_layers_flat",
  "display_name": "Service 封存压缩组合",
  "category": "命令压缩集成",
  "description": "压缩已完成历史消息中的 ERA 命令文本。先生成压缩候选，再通过 Service 重放确认变量、函数和随机使用结果一致；确认成功后采用候选及标记，否则保留原文。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.command.result",
        "cardinality": "exactly_one",
        "display_name": "表达式命令同步结果"
      }
    ],
    "provides": [
      {
        "key": "command_compaction_result",
        "type": "era.command_compaction.result",
        "display_name": "已处理封存压缩的同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.command.result": [
        "输入：表达式命令同步结果。"
      ]
    },
    "output_semantics": {
      "command_compaction_result": [
        "输出：已处理封存压缩的同步结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionApplyNode"
      }
    }
  ],
  "base_libs": [
    "era.crud.engine",
    "era.service.command_compaction",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
