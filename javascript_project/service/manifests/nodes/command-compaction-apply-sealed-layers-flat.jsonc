{
  "kind": "node",
  "type_key": "era.command_compaction.apply_sealed_layers_flat",
  "display_name": "Service 封存压缩组合",
  "category": "命令压缩集成",
  "description": "在消息层完成后，寻找可以封存的 ERA 操作文本，按原顺序交给独立命令压缩工作流，得到更短的候选指令；再用 Service 实际的增删改规则重放确认，回填通过确认的文本并更新封存标记。压缩须保持变量、函数和随机行为，无法确认则保留原文；这里不保存酒馆或状态文件。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.command.result",
        "cardinality": "exactly_one",
        "display_name": "表达式命令同步结果"
      }
    ],
    "provides": [
      {
        "key": "command_compaction_result",
        "type": "era.command_compaction.result",
        "display_name": "已处理封存压缩的同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.command.result": [
        "原始同步工作项与封存候选。"
      ]
    },
    "output_semantics": {
      "command_compaction_result": [
        "返回既有 Sidecar 提交链的同步工作项。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionApplyNode"
      }
    }
  ],
  "base_libs": [
    "era.crud.engine",
    "era.service.command_compaction",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
