{
  "kind": "node",
  "type_key": "era.initialize.plan",
  "display_name": "规划初始化资源",
  "category": "初始化规划",
  "description": "比较现有设置和角色资源，规划需要补齐的 ERA 世界书、正则、示例变量或函数及开场白。传统与外置模式按各自规则处理，已经保存的作者资源遵守不覆盖条件；传统默认占位符替换保留 HTML 所需行边界。输出有序变更计划和“有变更/无需变更”分支，不直接修改酒馆。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.context",
        "cardinality": "exactly_one",
        "display_name": "初始化上下文"
      }
    ],
    "provides": [
      {
        "key": "initialization_route",
        "type": "era.initialize.route",
        "display_name": "初始化路由"
      },
      {
        "key": "initialization_plan",
        "type": "era.initialize.plan",
        "display_name": "初始化计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.context": [
        "输入：初始化上下文。"
      ]
    },
    "output_semantics": {
      "initialization_route": [
        "输出：初始化路由。"
      ],
      "initialization_plan": [
        "输出：初始化计划。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_initialization_adapters.ts",
        "export": "PlanInitializationNode"
      }
    }
  ],
  "base_libs": [
    "era.service.initialization_transaction"
  ],
  "capabilities": []
}
