{
  "kind": "node",
  "type_key": "era.command.evaluate_expression",
  "display_name": "调用既有 Expression root",
  "category": "核心执行",
  "description": "将单路径公式、完整函数库校验或阶段函数请求交给已经存在的同步 Expression 工作流，接回真实数值、函数诊断和随机进度。此调用仍是普通 Node 对已有 root 的实际 API 调用，不新增 root，也不把 Service 的遍历或保护逻辑藏进外部边界。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.expression.request",
        "cardinality": "exactly_one",
        "display_name": "当前值求值、整组函数校验或阶段函数调用请求"
      }
    ],
    "provides": [
      {
        "key": "evaluate_expression_expression_response",
        "type": "era.command.expression.response",
        "display_name": "Expression 的真实结果及本次用途"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.expression.request": [
        "输入：当前值求值、整组函数校验或阶段函数调用请求。"
      ]
    },
    "output_semantics": {
      "evaluate_expression_expression_response": [
        "输出：Expression 的真实结果及本次用途。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "EvaluateExpressionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
