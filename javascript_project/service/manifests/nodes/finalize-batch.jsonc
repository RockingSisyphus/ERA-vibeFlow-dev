{
  "kind": "node",
  "type_key": "era.service.finalize_batch",
  "display_name": "完成批次收尾",
  "category": "批次执行",
  "description": "在全部步骤结束或计划被拒绝后，核对每个原始事件都恰好获得一次结算，汇总批次诊断，并更新服务批次计数。把任务层结果整理为可发布的批次结论；不会重新执行失败任务，也不负责酒馆文件写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state.after",
        "cardinality": "exactly_one",
        "display_name": "最终执行状态"
      }
    ],
    "provides": [
      {
        "key": "batch_finalization",
        "type": "era.batch.finalization",
        "display_name": "批次收尾结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state.after": [
        "输入：最终执行状态。"
      ]
    },
    "output_semantics": {
      "batch_finalization": [
        "输出：批次收尾结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "FinalizeBatchNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
