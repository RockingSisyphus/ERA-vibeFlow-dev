{
  "kind": "node",
  "type_key": "era.command.inspect_edit",
  "display_name": "检查修改保护并区分赋值与公式",
  "category": "核心执行",
  "description": "读取当前路径和 updatable（允许修改）保护；缺失目标按原规则跳过，显式修改 meta 解锁仍按原通路处理。已有对象补丁进入子字段，直接值走赋值，单键 $expr 走公式；旧控制键、空公式或非数值目标产生原诊断，不把错误转成默认值。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "inspect_edit_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "inspect_edit_edit_route",
        "type": "era.command.edit.route",
        "display_name": "进入子对象、直接赋值、公式或跳过"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "inspect_edit_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "inspect_edit_edit_route": [
        "输出：进入子对象、直接赋值、公式或跳过。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "InspectEditNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
