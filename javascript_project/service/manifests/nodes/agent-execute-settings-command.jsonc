{
  "kind": "node",
  "type_key": "era.agent.execute_settings_command",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/execute_settings_command.ts",
        "export": "run"
      }
    }
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_connection_state",
        "read_configuration_sources",
        "capture_preset",
        "write_configuration",
        "upsert_connection_profile",
        "delete_connection_profile",
        "clear_connection_profile_key",
        "list_connection_models",
        "list_connection_models_draft"
      ]
    }
  ],
  "display_name": "执行设置命令",
  "description": "在与聊天操作相同的有序 Service 队列中处理 Agent 配置、预设、连接或模型列表命令，通过既有宿主接口读取或写入相应设置。连接相关的即时事实读取和发起操作连续完成，减少使用过期事实。返回真实操作结果，不启动生成会话、不应用消息中的变量指令。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.settings.request",
        "cardinality": "exactly_one",
        "display_name": "设置请求"
      }
    ],
    "provides": [
      {
        "key": "settings_outcome",
        "type": "era.agent.settings.outcome",
        "display_name": "设置结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.settings.request": [
        "输入：设置请求"
      ]
    },
    "output_semantics": {
      "settings_outcome": [
        "输出：设置结果"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_settings_policy",
    "era.service.agent_generation_context"
  ]
}
