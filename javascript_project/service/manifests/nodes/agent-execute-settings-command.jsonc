{
  "kind": "node",
  "type_key": "era.agent.execute_settings_command",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/execute_settings_command.ts",
        "export": "run"
      }
    }
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_connection_state",
        "read_configuration_sources",
        "capture_preset",
        "write_configuration",
        "upsert_connection_profile",
        "delete_connection_profile",
        "clear_connection_profile_key",
        "list_connection_models",
        "list_connection_models_draft"
      ]
    }
  ],
  "display_name": "执行设置命令",
  "description": "仅执行配置/预设/连接/模型列表；复用连接与请求策略。即时连接事实读取、决策与发起写入保留在本节点连续执行。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.settings.request",
        "cardinality": "exactly_one",
        "display_name": "设置请求"
      }
    ],
    "provides": [
      {
        "key": "settings_outcome",
        "type": "era.agent.settings.outcome",
        "display_name": "设置结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.settings.request": [
        "输入：设置请求"
      ]
    },
    "output_semantics": {
      "settings_outcome": [
        "输出：设置结果"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_settings_policy",
    "era.service.agent_generation_context"
  ]
}
