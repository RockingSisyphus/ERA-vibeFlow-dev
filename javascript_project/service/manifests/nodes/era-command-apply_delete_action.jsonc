{
  "kind": "node",
  "type_key": "era.command.apply_delete_action",
  "display_name": "删除变量并记录变更",
  "category": "核心执行",
  "description": "按指令删除目标变量或其指定字段，记录删除前的值供历史回退；需要遍历的子字段依次处理，无效目标保留具体原因。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理操作、当前变量和函数、历史起点与随机进度"
      }
    ],
    "provides": [
      {
        "key": "apply_delete_action_operation_state",
        "type": "era.command.operation.state",
        "display_name": "执行本项操作后的变量、函数、日志及下一字段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理操作、当前变量和函数、历史起点与随机进度。"
      ]
    },
    "output_semantics": {
      "apply_delete_action_operation_state": [
        "输出：执行本项操作后的变量、函数、日志及下一字段。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "ApplyDeleteActionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
