{
  "kind": "node",
  "type_key": "era.sync.finalize_block_step",
  "display_name": "汇总实际提交结果（不再提交）",
  "category": "同步规划",
  "description": "仅汇总循环内实际保存结果、失败、来源变化与完成事实，输出既有提交结果信封供呈现及回执处理；不以整楼预计算替换累计值，不写消息或 Sidecar。未完成或失败消息不发布完成呈现。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "执行后的状态与实际提交结果"
      }
    ],
    "provides": [
      {
        "key": "completed_sync_result",
        "type": "era.tavern.commit.result",
        "display_name": "已发生提交的汇总结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "执行后的状态与实际提交结果"
      ]
    },
    "output_semantics": {
      "completed_sync_result": [
        "已发生提交的汇总结果"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/finalize_block_step.ts",
        "export": "finalize"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
