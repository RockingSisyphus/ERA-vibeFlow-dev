{
  "kind": "node",
  "type_key": "era.sync.finalize_block_step",
  "display_name": "收口块步进工作项",
  "category": "同步规划",
  "description": "块步进循环结束后产出下游消费的同步工作项：没有待交接调用时交给既有规划库；有待交接调用时把工作项声明为不提交并附带交接事实，未完成的消息因此既不提交也不推进连续处理状态。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      },
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块步进后状态"
      }
    ],
    "provides": [
      {
        "key": "expression_command_result",
        "type": "era.expression.command.result",
        "display_name": "表达式命令结果"
      },
      {
        "key": "function_invocation_route",
        "type": "era.sync.function.invocation.route",
        "display_name": "函数调用路由"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ],
      "era.sync.block.step.state.next": [
        "输入：块步进后状态。"
      ]
    },
    "output_semantics": {
      "expression_command_result": [
        "输出：表达式命令结果。"
      ],
      "function_invocation_route": [
        "输出：函数调用路由。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/finalize_block_step.ts",
        "export": "finalize"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_planning",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
