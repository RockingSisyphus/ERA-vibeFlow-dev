{
  "kind": "node",
  "type_key": "era.api.return_immediate_result",
  "display_name": "返回跳过或输入失败的提交结果",
  "category": "服务任务",
  "description": "对已处理过的提交范围形成跳过回执，对无效操作或工作台草稿形成失败回执，保留具体原因并返回原接口格式。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.validated",
        "cardinality": "optional_one",
        "display_name": "已校验即时 变量提交"
      },
      {
        "type": "era.api.commit.failure_context",
        "cardinality": "optional_one",
        "display_name": "即时 变量提交 失败上下文"
      },
      {
        "type": "era.api.commit.admission.route",
        "cardinality": "optional_one",
        "display_name": "提交检查所得的跳过或失败结论"
      },
      {
        "type": "era.workbench.preparation_route",
        "cardinality": "optional_one",
        "display_name": "工作台草稿准备所得的失败结论"
      }
    ],
    "provides": [
      {
        "key": "immediate_facade_result",
        "type": "era.api.facade.result",
        "display_name": "跳过或失败的接口提交回执"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.validated": [
        "输入：已校验即时 变量提交。"
      ],
      "era.api.commit.failure_context": [
        "输入：即时 变量提交 失败上下文。"
      ],
      "era.api.commit.admission.route": [
        "输入：提交检查所得的跳过或失败结论。"
      ],
      "era.workbench.preparation_route": [
        "输入：工作台草稿准备所得的失败结论。"
      ]
    },
    "output_semantics": {
      "immediate_facade_result": [
        "输出：跳过或失败的接口提交回执。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "returnImmediateResult"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": []
}
