{
  "kind": "node",
  "type_key": "era.command_compaction.write_segments",
  "display_name": "回填单一 Scope 事务",
  "category": "命令压缩集成",
  "description": "把经过 Service 重放确认的候选写回工作项中的对应文本段，保留段顺序和作用域归属，未被接受的段继续沿用原文。这里的“写回”只是更新内存中的待保存消息，并不直接触发聊天或状态文件保存。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.replayed",
        "cardinality": "exactly_one",
        "display_name": "Service 重放结果"
      }
    ],
    "provides": [
      {
        "key": "written",
        "type": "era.command_compaction.written",
        "display_name": "已回填压缩结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.replayed": [
        "输入：已由生产语义验证的候选。"
      ]
    },
    "output_semantics": {
      "written": [
        "输出：已回填消息和日志的上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionWriteNode"
      }
    }
  ],
  "base_libs": [
    "era.service.command_compaction"
  ],
  "capabilities": []
}
