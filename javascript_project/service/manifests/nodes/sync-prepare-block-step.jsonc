{
  "kind": "node",
  "type_key": "era.sync.prepare_block_step",
  "display_name": "准备回退起点与单一执行状态",
  "category": "同步规划",
  "description": "建立消息历史重新执行的起点：撤回需要重算的旧日志，确定消息范围，并带入当前变量、函数、消息历史标识、允许执行范围及随机使用记录。无需处理或准备失败时返回对应结论。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "当前消息位置、变量、函数和日志"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "输出：当前消息位置、变量、函数和日志。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/prepare_block_step.ts",
        "export": "prepare"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_work_preparation"
  ],
  "capabilities": []
}
