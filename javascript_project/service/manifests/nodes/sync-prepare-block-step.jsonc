{
  "kind": "node",
  "type_key": "era.sync.prepare_block_step",
  "display_name": "准备回退起点与单一执行状态",
  "category": "同步规划",
  "description": "以当前变量、函数和历史日志为起点，规划本次应回退哪些旧效果、从哪条消息继续，以及要处理哪些指令块。保存消息标识、作用域和随机位置作为后续依据。这个节点仅建立逐块处理状态，不提前执行块；无法处理或无需变更时把状态标为结束，让后续如实结算。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "块步进状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "同步上下文"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "块步进状态"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/prepare_block_step.ts",
        "export": "prepare"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_work_preparation"
  ],
  "capabilities": []
}
