{
  "kind": "node",
  "type_key": "era.sync.prepare_block_step",
  "display_name": "准备回退起点与单一执行状态",
  "category": "同步规划",
  "description": "只定位历史分歧、准备撤销旧效果和有序楼层范围，不预先执行整楼命令。状态持有楼层起点快照、当前累计值、随机偏移、累计日志及真实提交结果；文本进度与已保存日志共同支持恢复，信息不足返回可恢复失败。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "块步进状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "同步上下文"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "块步进状态"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/prepare_block_step.ts",
        "export": "prepare"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts",
    "era.service.sync_planning"
  ],
  "capabilities": []
}
