{
  "kind": "node",
  "type_key": "era.command_compaction.attach_random_context",
  "display_name": "附加封存楼层随机上下文",
  "category": "命令压缩集成",
  "description": "把已识别的压缩候选原样交给分段压缩环节，保留其稳定消息标识作为随机来源依据以及执行进度。当前节点本身不重新计算随机数或创建第二套随机游标，随机语义由真实压缩和求值链处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.identified",
        "cardinality": "exactly_one",
        "display_name": "已识别封存楼层"
      }
    ],
    "provides": [
      {
        "key": "partitioned_segments",
        "type": "era.command_compaction.partitioned",
        "display_name": "带消息随机身份的同 Scope 段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.identified": [
        "已识别封存楼层"
      ]
    },
    "output_semantics": {
      "partitioned_segments": [
        "带消息随机身份的同 Scope 段"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionRandomContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.command_compaction"
  ],
  "capabilities": []
}
