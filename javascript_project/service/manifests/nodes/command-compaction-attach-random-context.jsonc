    "params_defaults": {},
    "input_semantics": {"era.command_compaction.partitioned":["输入：含每个封存楼层 MK 的纯候选。"]},
    "output_semantics": {"partitioned_segments":["输出：供压缩原文与候选以相同随机上下文复放的分段。"]}
  },
  "implementations": [{"language":"typescript","targets":["browser","node"],"completion":"immediate","source":{"kind":"file","ref":"nodes/sync/command_compaction_random_context.ts","export":"run"}}],
