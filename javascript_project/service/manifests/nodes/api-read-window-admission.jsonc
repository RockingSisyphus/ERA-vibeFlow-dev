{
  "kind": "node",
  "type_key": "era.api.read_window_admission",
  "display_name": "读取窗口准入与目标",
  "category": "公共 Facade",
  "description": "读取真实消息、身份与内存窗口准入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.request",
        "cardinality": "exactly_one",
        "display_name": "公共对象请求"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_inspected",
        "type": "era.api.commit.inspected",
        "display_name": "已读取的提交请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.request": [
        "待提交的操作与调用来源。"
      ],
      "era.batch.execution.state": [
        "当前批次中的工作状态和窗口事实。"
      ]
    },
    "output_semantics": {
      "facade_commit_inspected": [
        "附上真实消息、聊天身份与窗口准入事实的提交请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "readWindowNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
