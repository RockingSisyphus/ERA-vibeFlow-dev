{
  "kind": "node",
  "type_key": "era.tavern.initialization_read",
  "display_name": "读取 Tavern 初始化资源",
  "category": "初始化宿主边界",
  "description": "从酒馆读取初始化需要的角色、聊天、设置、世界书、正则、开场白和外置配置。未指定模式时使用传统模式，输出当前资源事实。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已路由步骤"
      }
    ],
    "provides": [
      {
        "key": "initialization_context",
        "type": "era.initialize.context",
        "display_name": "初始化上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已路由步骤。"
      ]
    },
    "output_semantics": {
      "initialization_context": [
        "输出：初始化上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_initialization_adapters.ts",
        "export": "ReadInitializationContextNode"
      }
    }
  ],
  "base_libs": [
    "era.service.initialization_transaction",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": [
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.variables",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.worldbook",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.regex",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.character",
      "operations": [
        "read_main_greeting"
      ]
    }
  ]
}
