{
  "kind": "node",
  "type_key": "era.sync.release_terminal_function",
  "display_name": "终结时返回待处理失败并释放作者函数",
  "category": "核心执行",
  "description": "当父任务已经结束、失败或被取消时，为仍等待 commit 回执的作者函数返回原失败结论，再释放它的执行帧。宿主已经取消时按原清理规则容忍释放失败；不继续执行剩余正文、不把取消写成成功。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "release_terminal_function_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "release_terminal_function_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "ReleaseTerminalFunctionNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "release",
        "acknowledge"
      ]
    }
  ]
}
