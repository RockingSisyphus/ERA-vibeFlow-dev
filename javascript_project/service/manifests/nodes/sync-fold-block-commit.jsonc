{
  "kind": "node",
  "type_key": "era.sync.fold_block_commit",
  "display_name": "折回实际保存结果与循环终止状态",
  "category": "同步规划",
  "description": "保存成功后推进状态、日志及进度；提交失败保留已成功块并返回任务级失败，来源变化作废原目标。最后完成清进度后才能标楼层完成；继续下一受影响楼层或结束。循环终止事实必须来自提交之后。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.result",
        "cardinality": "exactly_one",
        "display_name": "逐块提交结果"
      }
    ],
    "provides": [
      {
        "key": "folded_block_step_state",
        "type": "era.sync.block.step.state.next",
        "display_name": "实际保存后的执行状态"
      },
      {
        "key": "block_step_done",
        "type": "era.step.done",
        "display_name": "保存后是否结束本次执行"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.result": [
        "逐块提交结果"
      ]
    },
    "output_semantics": {
      "folded_block_step_state": [
        "实际保存后的执行状态"
      ],
      "block_step_done": [
        "保存后是否结束本次执行"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/fold_block_commit.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts",
    "era.service.sync_commit_policy"
  ],
  "capabilities": []
}
