{
  "kind": "node",
  "type_key": "era.sync.compute",
  "display_name": "适配已计算的协调结果",
  "category": "同步规划",
  "description": "把已有普通/full/latest/auto/rollbackTo 规划结果交给共享提交候选构造；不重复计算。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.work",
        "cardinality": "exactly_one",
        "display_name": "同步工作项"
      }
    ],
    "provides": [
      {
        "key": "reconcile_result",
        "type": "era.sync.logical_result",
        "display_name": "同步逻辑结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.work": [
        "输入：同步工作项。"
      ]
    },
    "output_semantics": {
      "reconcile_result": [
        "输出：同步逻辑结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/confirm_reconciliation.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
