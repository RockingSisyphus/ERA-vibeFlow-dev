{
  "kind": "node",
  "type_key": "era.workbench.validate_draft_basis",
  "display_name": "校验编辑基准并区分变量和函数",
  "category": "工作台提交",
  "description": "核对草稿的聊天、文件绑定和原始值是否仍与当前资料一致。单项编辑检查目标项，整库编辑检查全部值；新增项确认目标尚不存在。资料已变化或请求格式无效时返回重新读取或修改提示。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.baseline",
        "cardinality": "exactly_one",
        "display_name": "工作台当前基准"
      }
    ],
    "provides": [
      {
        "key": "draft",
        "type": "era.workbench.draft",
        "display_name": "工作台编辑草稿"
      },
      {
        "key": "draft_kind",
        "type": "era.workbench.kind",
        "display_name": "工作台编辑类型"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.baseline": [
        "输入：工作台当前基准。"
      ]
    },
    "output_semantics": {
      "draft": [
        "输出：工作台编辑草稿。"
      ],
      "draft_kind": [
        "输出：工作台编辑类型。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_operation_adapters.ts",
        "export": "WorkbenchValidateDraftNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations"
  ],
  "capabilities": []
}
