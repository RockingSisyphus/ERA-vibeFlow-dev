        "era.workbench.baseline"
      ]
    },
    "output_semantics": {
      "draft": [
        "era.workbench.draft"
      ],
      "draft_kind": [
        "era.workbench.kind"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
