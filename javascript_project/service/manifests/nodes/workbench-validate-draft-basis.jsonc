{
  "kind": "node",
  "type_key": "era.workbench.validate_draft_basis",
  "display_name": "校验编辑基准并区分变量和函数",
  "category": "工作台提交",
  "description": "检查工作台草稿属于当前聊天和状态文件，并核对用户打开编辑器时的目标原值是否仍然相同。新增目标须仍不存在，单项编辑只核对该目标，整库编辑核对全库；无关兄弟项更新不自动使单项草稿失效。还检查编辑模式和必需字段，失败则要求重新加载，成功后分到变量、函数或有序操作准备。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.baseline",
        "cardinality": "exactly_one",
        "display_name": "工作台当前基准"
      }
    ],
    "provides": [
      {
        "key": "draft",
        "type": "era.workbench.draft",
        "display_name": "工作台编辑草稿"
      },
      {
        "key": "draft_kind",
        "type": "era.workbench.kind",
        "display_name": "工作台编辑类型"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.baseline": [
        "从当前 Sidecar 读取的基准与身份。"
      ]
    },
    "output_semantics": {
      "draft": [
        "核对窗口、目标值和保护后整理的编辑草稿。"
      ],
      "draft_kind": [
        "区分变量、函数、有序操作或失败。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_operation_adapters.ts",
        "export": "WorkbenchValidateDraftNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context",
    "era.workbench.operations"
  ],
  "capabilities": []
}
