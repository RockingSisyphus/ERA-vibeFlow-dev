{
  "kind": "node",
  "type_key": "era.api.finalize_write",
  "display_name": "完成 API 写入事务",
  "category": "逻辑提交",
  "description": "成功时把 era:apiWrite 置于 writeDone 之前；消息已写而状态同步失败时升级为 fatal 并停止发布成功通知。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [{"type": "era.task.result", "cardinality": "exactly_one", "display_name": "共享同步结果"}],
    "provides": [{"key": "api_write_success_result", "type": "era.task.result.merged", "display_name": "写入 API 分支结果"}],
    "params_schema": {}, "params_defaults": {},
    "input_semantics": {"era.task.result":["输入：共享同步结果。"]},
    "output_semantics": {"api_write_success_result":["输出：写入 API 分支结果。"]}
  },
  "implementations": [{"language": "typescript", "targets": ["browser", "node"], "completion": "immediate", "source": {"kind": "file", "ref": "nodes/api/finalize_api_write.ts", "export": "run"}}],
  "base_libs": [], "capabilities": []
}
