{
  "kind": "node",
  "type_key": "era.command.prepare_stage_call",
  "display_name": "为当前位置的阶段 JSON 函数构造请求",
  "category": "核心执行",
  "description": "取出 Agent 阶段函数表的下一项，按原参数格式形成公式调用，使用会话的随机来源和位置，并携带调用表恢复点。完整调用表的名字与格式已在进入循环前检查；本项只计算结果，不当作作者 JavaScript 函数或写宿主的 API。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "prepare_stage_call_expression_request",
        "type": "era.command.expression.request",
        "display_name": "含当前/快照函数库、随机游标及用途的表达式请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "prepare_stage_call_expression_request": [
        "输出：含当前/快照函数库、随机游标及用途的表达式请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "PrepareStageCallNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
