{
  "kind": "node",
  "type_key": "era.agent.prepare_generation_phase",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "PrepareGenerationPhaseNode"
      }
    }
  ],
  "capabilities": [],
  "display_name": "准备阶段请求",
  "description": "把阶段决策整理成一次生成请求，带上所需配置、历史、变量起点及会话信息。阶段重试采用前面按历史恢复的基线，不把旧阶段效果再算一遍；无效来源或不应执行的事件保留对应结论。这里准备候选执行的输入，还没有得到新的模型输出。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.decision",
        "cardinality": "exactly_one",
        "display_name": "阶段决策"
      }
    ],
    "provides": [
      {
        "key": "generation_request",
        "type": "era.agent.generation.request",
        "display_name": "阶段请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.decision": [
        "输入：阶段决策"
      ]
    },
    "output_semantics": {
      "generation_request": [
        "输出：阶段请求"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ]
}
