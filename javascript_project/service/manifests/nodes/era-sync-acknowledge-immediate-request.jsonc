{
  "kind": "node",
  "type_key": "era.sync.acknowledge_immediate_request",
  "display_name": "返回未执行请求的真实跳过或失败回执",
  "category": "核心执行",
  "description": "对已被 Scope 判为重复/越界或输入、来源校验失败的函数请求，直接确认其原跳过/失败回执，不伪造已应用操作。函数帧保留到下一次等待，作者仍可捕获错误或继续提交其他 commit。 宿主调用异常以原错误进入统一函数清理分支，不直接抛出破坏来源结算。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "acknowledge_immediate_request_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "acknowledge_immediate_request_function_effect_route",
        "type": "era.sync.function.effect.route",
        "display_name": "宿主动作完成或真实异常"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "acknowledge_immediate_request_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "acknowledge_immediate_request_function_effect_route": [
        "输出：宿主动作完成或真实异常。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "AcknowledgeImmediateRequestNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "acknowledge"
      ]
    }
  ]
}
