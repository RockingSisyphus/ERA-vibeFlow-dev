{
  "kind": "node",
  "type_key": "era.service.cycle.unpack_execution",
  "display_name": "解包批次执行状态",
  "category": "服务阶段循环",
  "description": "从执行阶段状态取出任务列表、当前位置、累计结果和消息处理进度，供本次任务执行。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.cycle.routed",
        "cardinality": "exactly_one",
        "display_name": "本节点所需的当前运行资料"
      }
    ],
    "provides": [
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.cycle.routed": [
        "输入：本节点所需的当前运行资料。"
      ]
    },
    "output_semantics": {
      "execution_state": [
        "输出：阶段结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "UnpackExecutionCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
