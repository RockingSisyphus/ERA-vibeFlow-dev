{
  "kind": "node",
  "type_key": "era.installation.scope.classify",
  "display_name": "分类安装作用域",
  "category": "服务生命周期",
  "description": "把当前脚本 ID 与已启用的脚本目录对应起来：只在角色卡中找到就归为角色卡脚本，只在全局或预设中找到就归到相应位置；同一 ID 出现在多个位置则记为位置不明确。读取失败、没有 ID 或没有匹配项记为未知，供启动策略区分“明确不应启动”和“无法判断”。这不是对所有 ERA 实例进行选主。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.installation.scope.facts",
        "cardinality": "exactly_one",
        "display_name": "安装作用域事实"
      }
    ],
    "provides": [
      {
        "key": "installation_scope_classification",
        "type": "era.installation.scope.classification",
        "display_name": "安装作用域分类"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.installation.scope.facts": [
        "输入：Host 采集的启用脚本树事实。"
      ]
    },
    "output_semantics": {
      "installation_scope_classification": [
        "输出：纯安装位置分类。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "ClassifyInstallationScopeNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
