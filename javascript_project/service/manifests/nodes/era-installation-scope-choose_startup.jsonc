{
  "kind": "node",
  "type_key": "era.installation.scope.choose_startup",
  "display_name": "根据安装位置选择启动方式",
  "category": "服务任务",
  "description": "比对当前脚本在角色卡、全局和预设中的安装位置，决定启动服务还是显示休眠提示；位置未知时使用原有兼容启动方式，并给出诊断。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.installation.scope.facts",
        "cardinality": "exactly_one",
        "display_name": "安装作用域事实"
      }
    ],
    "provides": [
      {
        "key": "installation_scope_decision",
        "type": "era.installation.scope.decision",
        "display_name": "启动决议"
      },
      {
        "key": "installation_scope_route",
        "type": "era.installation.scope.route",
        "display_name": "启动分支"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.installation.scope.facts": [
        "输入：安装作用域事实。"
      ]
    },
    "output_semantics": {
      "installation_scope_decision": [
        "输出：启动决议。"
      ],
      "installation_scope_route": [
        "输出：启动分支。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "ChooseStartupNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
