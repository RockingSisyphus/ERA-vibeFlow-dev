{
  "kind": "node",
  "type_key": "era.sync.acknowledge_completed_commit",
  "display_name": "应用完本次函数 commit 后才确认回执",
  "category": "核心执行",
  "description": "函数帧中一次 commit 插入的操作块已全部按原顺序应用后，为该请求发送实际应用回执，再清除这份待确认请求。只表示内存应用完成，保存随父批次；如果还没应用完，生命周期路由不会进入这里，避免函数 await 过早返回。 宿主调用异常以原错误进入统一函数清理分支，不直接抛出破坏来源结算。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "acknowledge_completed_commit_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "acknowledge_completed_commit_function_effect_route",
        "type": "era.sync.function.effect.route",
        "display_name": "宿主动作完成或真实异常"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "acknowledge_completed_commit_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "acknowledge_completed_commit_function_effect_route": [
        "输出：宿主动作完成或真实异常。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "AcknowledgeCompletedCommitNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "acknowledge"
      ]
    }
  ]
}
