{
  "kind": "node",
  "type_key": "era.mk.route_commit",
  "display_name": "路由消息密钥提交",
  "category": "消息密钥路由",
  "description": "仅当消息文本或 SelectedMks 需要写入时进入提交分支；读取或推导失败留在无宿主写入分支。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.mk.candidate",
        "cardinality": "exactly_one",
        "display_name": "MK 候选"
      }
    ],
    "provides": [
      {
        "key": "mk_commit_route",
        "type": "era.mk.route",
        "display_name": "MK 提交路由"
      },
      {
        "key": "routed_mk_candidate",
        "type": "era.mk.candidate.routed",
        "display_name": "已路由 MK 候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.mk.candidate": [
        "输入：MK 候选。"
      ]
    },
    "output_semantics": {
      "mk_commit_route": [
        "输出：MK 提交路由。"
      ],
      "routed_mk_candidate": [
        "输出：已路由 MK 候选。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "RouteMkCommitNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
