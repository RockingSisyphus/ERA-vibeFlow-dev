{
  "kind": "node",
  "type_key": "era.service.validate_coverage",
  "display_name": "验证来源覆盖",
  "category": "批次执行",
  "description": "验证每个批次来源序号恰好覆盖一次，并识别重复、缺失或越界来源。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.batch.plan",
        "cardinality": "exactly_one",
        "display_name": "批次计划"
      }
    ],
    "provides": [
      {
        "key": "coverage_route",
        "type": "era.batch.coverage.route",
        "display_name": "覆盖校验路由"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "初始执行状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.batch.plan":["输入：批次计划。"]},
    "output_semantics": {"coverage_route":["输出：覆盖校验路由。"],"execution_state":["输出：初始执行状态。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/batch/validate_coverage.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.protocol"
  ],
  "capabilities": []
}
