{
  "kind": "node",
  "type_key": "era.service.validate_coverage",
  "display_name": "验证来源覆盖",
  "category": "批次执行",
  "description": "检查任务计划是否恰好覆盖本批每个原事件一次，且事件来源有效、任务数在允许范围内；输出检查结果及具体问题。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.batch.plan",
        "cardinality": "exactly_one",
        "display_name": "批次计划"
      }
    ],
    "provides": [
      {
        "key": "coverage_route",
        "type": "era.batch.coverage.route",
        "display_name": "覆盖校验路由"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "初始执行状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.plan": [
        "输入：批次计划。"
      ]
    },
    "output_semantics": {
      "coverage_route": [
        "输出：覆盖校验路由。"
      ],
      "execution_state": [
        "输出：初始执行状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "ValidateCoverageNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
