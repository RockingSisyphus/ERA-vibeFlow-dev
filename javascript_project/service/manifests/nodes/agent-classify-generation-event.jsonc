{
  "kind": "node",
  "type_key": "era.agent.classify_generation_event",
  "category": "Agent 工作流",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "ClassifyGenerationEventNode"
      }
    }
  ],
  "capabilities": [],
  "display_name": "判定事件与阶段",
  "description": "结合生成事件和当前会话事实，区分首次生成、继续生成、用户手动重试与内部阶段恢复，确定应处理规划、正文还是结算阶段。核对执行标识、完成标识以及聊天和候选回复来源；过期恢复不能接到新会话上。这里只作阶段决策，不调用模型。",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.facts",
        "cardinality": "exactly_one",
        "display_name": "生成事实"
      }
    ],
    "provides": [
      {
        "key": "generation_decision",
        "type": "era.agent.generation.decision",
        "display_name": "阶段决策"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.facts": [
        "输入：生成事实"
      ]
    },
    "output_semantics": {
      "generation_decision": [
        "输出：阶段决策"
      ]
    }
  },
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types"
  ]
}
