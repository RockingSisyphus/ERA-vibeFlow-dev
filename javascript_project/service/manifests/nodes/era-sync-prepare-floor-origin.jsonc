{
  "kind": "node",
  "type_key": "era.sync.prepare_floor_origin",
  "display_name": "建立当前楼层标识、起点快照和随机位置",
  "category": "核心执行",
  "description": "检查消息范围与当前消息的 ERA 标识 MK；无效或缺种子时按原诊断跳过该楼层。首次进入有效楼层时解除旧应用标记，保存此楼层开始前的变量/函数快照、清空本楼层重算日志并把随机偏移归零；已开始楼层继续现有位置，不重置前面块的成果。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "prepare_floor_origin_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "prepare_floor_origin_floor_origin_route",
        "type": "era.sync.floor.origin.route",
        "display_name": "有效当前位置或无效楼层"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "prepare_floor_origin_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "prepare_floor_origin_floor_origin_route": [
        "输出：有效当前位置或无效楼层。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "PrepareFloorOriginNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
