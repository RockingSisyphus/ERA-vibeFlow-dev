{
  "kind": "node",
  "type_key": "era.sync.build_contract_failure",
  "display_name": "结算未提交的契约失败",
  "category": "同步事务",
  "description": "由 sync_result_policy 根据原步骤来源生成失败回执；不执行写入。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.commit.contract.failure",
        "cardinality": "exactly_one",
        "display_name": "同步提交合同失败"
      }
    ],
    "provides": [
      {
        "key": "sync_contract_task_result",
        "type": "era.task.result",
        "display_name": "同步合同失败结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.commit.contract.failure": [
        "输入：同步提交合同失败证据。"
      ]
    },
    "output_semantics": {
      "sync_contract_task_result": [
        "输出：任何 Capability 写入前的普通失败结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/build_contract_failure.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
