{
  "kind": "node",
  "type_key": "era.command.take_next_operation",
  "display_name": "取出下一项：先完成当前子树",
  "category": "核心执行",
  "description": "从当前指令、数组根项和显式待处理栈取得下一项。对象字段按原 Object.keys 顺序深度优先访问，进入子对象后先处理完它再回父级；每次访问都读取前一项完成后的工作值，不预先把全对象展开后批量求值。函数根对象另保留整组候选和统一校验位置。 函数 meta 删除也使用此栈，子路径结束后返回同组函数候选，不写变量状态。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "take_next_operation_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "take_next_operation_operation_route",
        "type": "era.command.operation.route",
        "display_name": "新增/修改/删除、函数组/定义/整组校验、阶段调用、跳过或结束"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "take_next_operation_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "take_next_operation_operation_route": [
        "输出：新增/修改/删除、函数组/定义/整组校验、阶段调用、跳过或结束。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "TakeNextOperationNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
