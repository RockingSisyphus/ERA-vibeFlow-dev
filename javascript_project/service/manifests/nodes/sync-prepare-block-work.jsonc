{
  "kind": "node",
  "type_key": "era.sync.prepare_block_work",
  "display_name": "构造单块与日志同步工作项",
  "category": "同步规划",
  "description": "把这一轮块推进后得到的工作项及块位置整理成压缩节点的输入，保留累计正文、变量、函数、日志和失败信息。当前实现只是携带已有结果，不在这里重新执行指令或清除进度；是否有已完成、可压缩的消息层由压缩应用器判断。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.pending",
        "cardinality": "exactly_one",
        "display_name": "待提交状态"
      }
    ],
    "provides": [
      {
        "key": "expression_command_result",
        "type": "era.expression.command.result",
        "display_name": "单块或楼层维护工作项"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.pending": [
        "待提交状态"
      ]
    },
    "output_semantics": {
      "expression_command_result": [
        "单块或楼层维护工作项"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_block_state_adapters.ts",
        "export": "PrepareBlockWorkNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
