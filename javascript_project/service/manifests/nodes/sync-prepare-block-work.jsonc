{
  "kind": "node",
  "type_key": "era.sync.prepare_block_work",
  "display_name": "构造单块与日志同步工作项",
  "category": "同步规划",
  "description": "从真实累计状态构造当前块的消息/Sidecar候选和完整累计回退日志。仅楼层完成时给出该封存楼层压缩候选；最新楼层不压缩；普通块候选为空。携带状态经工作项传递，禁止另算整楼终值。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.pending",
        "cardinality": "exactly_one",
        "display_name": "待提交状态"
      }
    ],
    "provides": [
      {
        "key": "expression_command_result",
        "type": "era.expression.command.result",
        "display_name": "单块或楼层维护工作项"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.pending": [
        "待提交状态"
      ]
    },
    "output_semantics": {
      "expression_command_result": [
        "单块或楼层维护工作项"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/prepare_block_work.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts"
  ],
  "capabilities": []
}
