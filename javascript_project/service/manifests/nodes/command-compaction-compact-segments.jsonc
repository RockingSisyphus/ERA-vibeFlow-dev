{
  "kind": "node",
  "type_key": "era.command_compaction.compact_segments",
  "display_name": "调用 Compaction 同步工作流",
  "category": "命令压缩集成",
  "description": "原 compactCommandLayer API 委托已生成的同步 runWorkflow；每个封存楼层调用一次，由 Compaction 内部顺序处理各段。保留原返回格式与 Service 后续复放。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.partitioned",
        "cardinality": "exactly_one",
        "display_name": "已划分同 Scope 段"
      }
    ],
    "provides": [
      {
        "key": "compacted",
        "type": "era.command_compaction.compacted",
        "display_name": "安全压缩候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.partitioned": [
        "已划分同 Scope 段"
      ]
    },
    "output_semantics": {
      "compacted": [
        "安全压缩候选"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionCompactNode"
      }
    }
  ],
  "base_libs": [
    "era.service.command_compaction"
  ],
  "capabilities": []
}
