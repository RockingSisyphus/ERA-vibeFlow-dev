{
  "kind": "node",
  "type_key": "era.command_compaction.compact_segments",
  "display_name": "调用 Compaction 同步工作流",
  "category": "命令压缩集成",
  "description": "逐个把待封存段送入独立命令压缩工作流，生成保持作用域与操作顺序的较短候选文本。结果仍需用 Service 实际执行规则重放确认；不合适的段保留原文。此处只处理计算结果，不向酒馆提交消息。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.partitioned",
        "cardinality": "exactly_one",
        "display_name": "已划分同 Scope 段"
      }
    ],
    "provides": [
      {
        "key": "compacted",
        "type": "era.command_compaction.compacted",
        "display_name": "安全压缩候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.partitioned": [
        "已划分同 Scope 段"
      ]
    },
    "output_semantics": {
      "compacted": [
        "安全压缩候选"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionCompactNode"
      }
    }
  ],
  "base_libs": [
    "era.service.command_compaction"
  ],
  "capabilities": []
}
