{
  "kind": "node",
  "type_key": "era.api.read_write_messages",
  "display_name": "读取 API 写入目标消息",
  "category": "宿主只读边界",
  "description": "通过挂起式消息 Capability 读取包含当前 swipe 的完整聊天上下文，不执行任何写入。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [{"type": "era.api.write.directive", "cardinality": "exactly_one", "display_name": "API 写入指令"}],
    "provides": [{"key": "api_write_messages_raw", "type": "era.tavern.messages.read_context.outcome", "display_name": "原始消息上下文"}],
    "params_schema": {}, "params_defaults": {},
    "input_semantics": {"era.api.write.directive":["输入：API 写入指令。"]},
    "output_semantics": {"api_write_messages_raw":["输出：原始消息上下文。"]}
  },
  "implementations": [{"language": "typescript", "targets": ["browser"], "completion": "suspend", "source": {"kind": "file", "ref": "nodes/api/read_api_write_messages.ts", "export": "run"}}],
  "base_libs": [],
  "capabilities": [{"id": "era.tavern.messages", "operations": ["read_context"]}]
}
