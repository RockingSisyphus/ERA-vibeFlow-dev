{
  "kind": "node",
  "type_key": "era.lifecycle.prepare_stage_blocks",
  "display_name": "将阶段输出适配到共用块状态",
  "category": "内存生命周期",
  "description": "为模型生成的候选正文建立消息命令执行计划，并保存失败恢复所需的起点。规划阶段可使用即将生成的 AI 消息位置，其余阶段使用捕获的实际目标。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.generation.raw",
        "cardinality": "exactly_one",
        "display_name": "未应用的生成输出"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "待执行块状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.generation.raw": [
        "输入：未应用的生成输出。"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "输出：待执行块状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/prepare_stage_blocks.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.message_function_calls",
    "era.service.mk_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_work_preparation"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
