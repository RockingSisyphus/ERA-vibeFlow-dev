{
  "kind": "node",
  "type_key": "era.sync.begin_author_call",
  "display_name": "检查并启动作者定义的函数",
  "category": "核心执行",
  "description": "检查正文指定的作者函数和参数，登记本次调用并启动函数。调用无效时整理结束结果；启动遇到宿主错误时记录具体原因，交回消息处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前作者函数调用及消息处理进度"
      }
    ],
    "provides": [
      {
        "key": "begin_author_call_author_state",
        "type": "era.sync.author.state",
        "display_name": "更新后的作者调用及消息进度"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前作者函数调用及消息处理进度。"
      ]
    },
    "output_semantics": {
      "begin_author_call_author_state": [
        "输出：更新后的作者调用及消息进度。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "BeginAuthorCallNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "begin",
        "release"
      ]
    }
  ]
}
