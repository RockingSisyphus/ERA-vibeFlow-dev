{
  "kind": "node",
  "type_key": "era.tavern.mk_read",
  "display_name": "读取 Tavern 消息与 ERA 元数据",
  "category": "消息密钥宿主边界",
  "description": "读取目标消息正文、元数据和占位设置，供生成消息历史标识及必要占位内容。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已路由步骤"
      }
    ],
    "provides": [
      {
        "key": "mk_context",
        "type": "era.mk.context",
        "display_name": "消息历史标识 上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已路由步骤。"
      ]
    },
    "output_semantics": {
      "mk_context": [
        "输出：消息历史标识 上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/update_mk/read_message_metadata.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.mk_read_normalization",
    "era.service.sidecar_binding",
    "era.service.types"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.variables",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record"
      ]
    }
  ]
}
