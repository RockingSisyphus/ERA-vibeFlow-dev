{
  "kind": "node",
  "type_key": "era.tavern.mk_read",
  "display_name": "读取 Tavern 消息与 ERA 元数据",
  "category": "消息密钥宿主边界",
  "description": "通过宿主读取消息标识任务所需的目标消息正文、ERA 元数据和占位符设置，整理为候选规划的输入。读取失败保留具体诊断，不用空正文假装读取成功；这里不生成标识，也不写消息，后续节点才判断是否需要变更。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [{"type": "era.step.request.routed", "cardinality": "exactly_one", "display_name": "已路由步骤"}],
    "provides": [{"key": "mk_context", "type": "era.mk.context", "display_name": "MK 上下文"}],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.step.request.routed":["输入：已路由步骤。"]},
    "output_semantics": {"mk_context":["输出：MK 上下文。"]}
  },
  "implementations": [{
    "language": "typescript",
    "targets": ["browser"],
    "completion": "suspend",
    "source": {"kind": "file", "ref": "nodes/update_mk/read_message_metadata.ts", "export": "run"}
  }],
  "base_libs": ["era.service.types", "era.service.sidecar_binding", "era.service.mk_read_normalization"],
  "capabilities": [
    {"id": "era.tavern.messages", "operations": ["read_context"]},
    {"id": "era.tavern.variables", "operations": ["read"]},
    {"id": "era.tavern.sidecar", "operations": ["read_current", "read_record"]}
  ]
}
