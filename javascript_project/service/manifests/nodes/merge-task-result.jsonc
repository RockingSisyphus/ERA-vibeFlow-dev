{
  "kind": "node",
  "type_key": "era.service.merge_task_result",
  "display_name": "合并步骤结果",
  "category": "步骤执行",
  "description": "把当前任务的结果合入批次：累计各事件的结算、诊断和通知，接续消息处理进度，再把步骤索引推进一位。输出更新后的状态及是否已完成全部步骤；它不会重新执行任务或立即读入新事件。此处统一汇合，确保不同任务分支采用同一种批次推进规则。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.result",
        "cardinality": "exactly_one",
        "display_name": "任务结果"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "execution_state_next",
        "type": "era.batch.execution.state.next",
        "display_name": "下一执行状态"
      },
      {
        "key": "step_done",
        "type": "era.step.done",
        "display_name": "全部步骤已消费"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.result": [
        "输入：任务结果。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态。"
      ]
    },
    "output_semantics": {
      "execution_state_next": [
        "输出：下一执行状态。"
      ],
      "step_done": [
        "输出：全部步骤已消费。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "MergeTaskResultNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
