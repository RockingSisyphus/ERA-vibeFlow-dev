{
  "kind": "node",
  "type_key": "era.sync.mark_skipped_call",
  "display_name": "按原规则跳过已处理或嵌套调用",
  "category": "核心执行",
  "description": "对已处理的非嵌套 EraFCall 保留原完成标记语义，嵌套调用按原规则不启动宿主函数。这里只处理当前位置的正文标记，随后推进一个原块，不新增调用、变量写入或 API 回执。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "mark_skipped_call_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "mark_skipped_call_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "MarkSkippedCallNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
