{
  "kind": "node",
  "type_key": "era.command_compaction.update_markers",
  "display_name": "更新压缩调度 Marker",
  "category": "命令压缩集成",
  "description": "依据已确认并回填的压缩结果更新封存标记和相关统计，再将完整工作项交还消息同步链。标记用来描述哪些消息层已处理，不能代替重放验证；本节点不额外执行指令或宿主保存。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.written",
        "cardinality": "exactly_one",
        "display_name": "已回填压缩结果"
      }
    ],
    "provides": [
      {
        "key": "command_compaction_result",
        "type": "era.command_compaction.result",
        "display_name": "已处理封存压缩的同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.written": [
        "输入：等待 marker 结算的回填上下文。"
      ]
    },
    "output_semantics": {
      "command_compaction_result": [
        "输出：返回既有 Sidecar 提交链的同步工作项。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/shared_compaction_adapters.ts",
        "export": "CommandCompactionMarkersNode"
      }
    }
  ],
  "base_libs": [
    "era.service.command_compaction"
  ],
  "capabilities": []
}
