{
  "kind": "node",
  "type_key": "era.agent.candidate_unpack",
  "display_name": "取出候选执行输入",
  "category": "Agent候选",
  "description": "从当前候选运行状态取出模型请求、原任务和批次，交给下一次模型调用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.agent.candidate.state",
        "cardinality": "exactly_one",
        "display_name": "本次模型尝试的请求、起点和进度"
      }
    ],
    "provides": [
      {
        "key": "generation_request",
        "type": "era.agent.generation.request",
        "display_name": "生成请求"
      },
      {
        "key": "routed_step",
        "type": "era.step.request.routed",
        "display_name": "已准备的任务步骤"
      },
      {
        "key": "execution_state",
        "type": "era.batch.execution.state",
        "display_name": "当前批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.agent.candidate.state": [
        "输入：本次模型尝试的请求、起点和进度。"
      ]
    },
    "output_semantics": {
      "generation_request": [
        "输出：生成请求。"
      ],
      "routed_step": [
        "输出：已准备的任务步骤。"
      ],
      "execution_state": [
        "输出：当前批次状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "CandidateUnpackNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
