{
  "kind": "node",
  "type_key": "era.api.merge_sync_result",
  "display_name": "合并公共对象同步结果",
  "category": "公共 Facade",
  "description": "把公共同步的“已经运行共享同步”与“输入校验失败”两个互斥分支合为唯一结果，核对恰有一份回执。不重新执行同步或改写成功失败状态；输出供外层公共 API 任务统一结算。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.sync.result",
        "cardinality": "all",
        "display_name": "公共对象同步结果"
      }
    ],
    "provides": [
      {
        "key": "sync_result",
        "type": "era.api.facade.result",
        "display_name": "同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.sync.result": [
        "成功同步或输入失败分支的结果。"
      ]
    },
    "output_semantics": {
      "sync_result": [
        "确认恰好一个同步分支产出结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "mergeSyncNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
