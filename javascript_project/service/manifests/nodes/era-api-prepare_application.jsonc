{
  "kind": "node",
  "type_key": "era.api.prepare_application",
  "display_name": "定位目标消息，准备本次提交",
  "category": "服务任务",
  "description": "把已确认的有序操作组成消息事务，读取真实目标消息，并建立共享消息处理的初始状态，随后按顺序应用操作。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.validated",
        "cardinality": "exactly_one",
        "display_name": "已校验的提交请求"
      }
    ],
    "provides": [
      {
        "key": "block_step_state",
        "type": "era.sync.block.step.state",
        "display_name": "待执行块状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.validated": [
        "输入：已校验的提交请求。"
      ]
    },
    "output_semantics": {
      "block_step_state": [
        "输出：待执行块状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "prepareApplication"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy",
    "era.service.sync_work_preparation",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state",
    "era.workbench.context"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
