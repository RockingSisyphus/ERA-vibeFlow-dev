{
  "kind": "node",
  "type_key": "era.service.wait_state",
  "display_name": "携带等待状态",
  "category": "服务迭代",
  "description": "导出归约后的有界等待状态，供下一次服务迭代使用。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.collection.reduction",
        "cardinality": "exactly_one",
        "display_name": "事件集归约结果"
      }
    ],
    "provides": [
      {
        "key": "waiting_state_next",
        "type": "era.service.state.next",
        "display_name": "等待状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.collection.reduction":["输入：事件集归约结果。"]},
    "output_semantics": {"waiting_state_next":["输出：等待状态。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/wait_state.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.protocol"
  ],
  "capabilities": []
}
