{
  "kind": "node",
  "type_key": "era.api.plan_facade_sync",
  "display_name": "校验并构造同步步骤",
  "category": "公共 Facade",
  "description": "校验公共 ERA.sync 请求的模式和目标，把有效请求转换为共享同步任务，附带原始调用来源和批次状态。请求无效则输出失败分支，不运行历史重算；有效也只表示计划可执行，实际回退、指令应用和保存由通用同步工作流完成。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.api.request",
        "cardinality": "exactly_one",
        "display_name": "公共对象请求"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次状态"
      }
    ],
    "provides": [
      {
        "key": "facade_sync_route",
        "type": "era.api.sync.route",
        "display_name": "同步校验分支"
      },
      {
        "key": "facade_sync_step",
        "type": "era.step.request.routed",
        "display_name": "已校验的同步步骤"
      },
      {
        "key": "facade_sync_context",
        "type": "era.api.sync.context",
        "display_name": "同步请求上下文"
      },
      {
        "key": "facade_sync_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "同步批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.request": [
        "包含同步模式与目标的公共对象请求。"
      ],
      "era.batch.execution.state": [
        "供共享同步继续使用的当前批次状态。"
      ]
    },
    "output_semantics": {
      "facade_sync_route": [
        "区分可执行同步与输入失败。"
      ],
      "facade_sync_step": [
        "为有效请求生成共享同步步骤。"
      ],
      "facade_sync_context": [
        "保留原请求及回执所需事实。"
      ],
      "facade_sync_execution_state": [
        "原批次状态不变地交给共享同步流程。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "planSyncNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
