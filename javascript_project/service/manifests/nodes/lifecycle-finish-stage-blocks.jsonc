{
  "kind": "node",
  "type_key": "era.lifecycle.finish_stage_blocks",
  "display_name": "回送已应用阶段状态及草稿",
  "category": "内存生命周期",
  "description": "检查模型候选的全部块应用结果，并把成功阶段正文和变量进度记入当前会话。可纠错错误需要恢复整次候选的内存变量、正文、日志、作用域和随机进度，再准备下一次尝试；不是只撤销最后一个块。重试耗尽保留本候选起点，更早已完成阶段仍保留。取消也不会无故抹掉早前成功内容。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "applied_generation_outcome",
        "type": "era.agent.generation.outcome",
        "display_name": "已应用的生成结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "候选阶段逐块应用后的工作状态。"
      ]
    },
    "output_semantics": {
      "applied_generation_outcome": [
        "携带已应用结果和恢复事实，供下一阶段或重试使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/finish_stage_blocks.ts",
        "export": "FinishStageBlocksNode"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_generation_session",
    "era.service.agent_session_binding",
    "era.service.agent_stage_handoff",
    "era.service.mk_engine",
    "era.service.types"
  ],
  "capabilities": [
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_session_binding",
        "write_session",
        "clear_session"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.lifecycle.admission",
      "operations": [
        "schedule"
      ]
    }
  ]
}
