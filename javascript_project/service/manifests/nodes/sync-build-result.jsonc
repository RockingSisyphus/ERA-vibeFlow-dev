{
  "kind": "node",
  "type_key": "era.sync.build_notification",
  "display_name": "结算提交结果与批次更新",
  "category": "同步事务",
  "description": "由 sync_result_policy 根据实际提交与来源结果生成来源回执、诊断和连续处理更新；批次合并仍在原 merge_task_result。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.result",
        "cardinality": "exactly_one",
        "display_name": "同步提交结果"
      }
    ],
    "provides": [
      {
        "key": "sync_task_result",
        "type": "era.task.result",
        "display_name": "同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.result": [
        "输入：同步提交结果。"
      ]
    },
    "output_semantics": {
      "sync_task_result": [
        "输出：同步结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/build_sync_result.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
