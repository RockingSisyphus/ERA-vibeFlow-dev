{
  "kind": "node",
  "type_key": "era.sync.build_notification",
  "display_name": "结算提交结果与批次更新",
  "category": "同步事务",
  "description": "把同步的实际保存结果整理成原事件回执、业务通知及诊断，并计算后续可接续的消息处理进度。它区分成功、无需变更、普通失败和致命失败，也保留显示环节的诊断；不再次保存或重算变量。统一步骤合并随后会把这些结果记入本批次。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.tavern.commit.result",
        "cardinality": "exactly_one",
        "display_name": "同步提交结果"
      }
    ],
    "provides": [
      {
        "key": "sync_task_result",
        "type": "era.task.result",
        "display_name": "同步结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.tavern.commit.result": [
        "输入：同步提交结果。"
      ]
    },
    "output_semantics": {
      "sync_task_result": [
        "输出：同步结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/build_sync_result.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": []
}
