{
  "kind": "node",
  "type_key": "era.initialize.finalize_direct_result",
  "display_name": "结算直接初始化结果",
  "category": "初始化事务",
  "description": "仅在初始化不需要继续共享同步的分支，把资源处理结论转成交给 Service 的任务结果。保留实际完成动作、无变更或失败诊断，不把资源初始化包装成聊天同步；随后由统一步骤结算推进批次。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.direct.result",
        "cardinality": "exactly_one",
        "display_name": "专用直接初始化结果"
      }
    ],
    "provides": [
      {
        "key": "initialize_direct_task_result",
        "type": "era.task.result",
        "display_name": "直接初始化任务结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.direct.result": [
        "输入：仅属于 finish 分支的直接结果。"
      ]
    },
    "output_semantics": {
      "initialize_direct_task_result": [
        "输出：已结算的直接初始化任务结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "FinalizeDirectInitializationNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
