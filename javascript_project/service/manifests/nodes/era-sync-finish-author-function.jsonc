{
  "kind": "node",
  "type_key": "era.sync.finish_author_function",
  "display_name": "结束调用、清除锚点并接续正文",
  "category": "核心执行",
  "description": "记录作者函数正常结束或未捕获错误，移除临时锚点，给本次调用加原完成标记，并把正文游标移到调用及其插入操作之后。确曾启动时才释放帧；只消耗一个原函数调用的阶段前缀计数，不把函数 commit 插入的块算成原模型正文。 宿主调用异常以原错误进入统一函数清理分支，不直接抛出破坏来源结算。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "finish_author_function_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "finish_author_function_function_effect_route",
        "type": "era.sync.function.effect.route",
        "display_name": "宿主动作完成或真实异常"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "finish_author_function_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "finish_author_function_function_effect_route": [
        "输出：宿主动作完成或真实异常。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "FinishAuthorFunctionNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "release"
      ]
    }
  ]
}
