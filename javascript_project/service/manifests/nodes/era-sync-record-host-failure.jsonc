{
  "kind": "node",
  "type_key": "era.sync.record_host_failure",
  "display_name": "保留宿主错误并结束当前块任务",
  "category": "核心执行",
  "description": "把函数能力或目标读取的真实异常解包为原失败代码及 Tavern 层诊断，释放仍存在的作者函数帧并结束本次任务。不会在失败时继续写新目标，也不会把宿主错误转成普通变量跳过。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "record_host_failure_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "record_host_failure_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "RecordHostFailureNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": [
    {
      "id": "era.tavern.functions",
      "operations": [
        "release"
      ]
    }
  ]
}
