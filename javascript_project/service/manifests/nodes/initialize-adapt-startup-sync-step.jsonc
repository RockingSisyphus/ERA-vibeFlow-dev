{
  "kind": "node",
  "type_key": "era.initialize.adapt_startup_sync_step",
  "display_name": "适配启动同步步骤",
  "category": "初始化事务",
  "description": "把初始化产生的启动同步请求和保留的批次状态交给通用同步流程。请求继续携带原事件来源和消息上下文，不另建初始化专用变量引擎；它只适配输入，后续共享同步负责读取状态、应用历史及保存。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.startup.sync.step",
        "cardinality": "exactly_one",
        "display_name": "专用启动同步步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "routed_startup_sync_step",
        "type": "era.step.request.routed",
        "display_name": "已路由启动同步步骤"
      },
      {
        "key": "routed_startup_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "启动同步批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.startup.sync.step": [
        "输入：初始化分支专用的启动同步步骤。"
      ],
      "era.batch.execution.state": [
        "输入：初始化任务所属的批次执行状态。"
      ]
    },
    "output_semantics": {
      "routed_startup_sync_step": [
        "输出：共享 sync Nodeset 可消费的 routed step。"
      ],
      "routed_startup_execution_state": [
        "输出：未经修改的同一批次执行状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "AdaptStartupSyncStepNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
