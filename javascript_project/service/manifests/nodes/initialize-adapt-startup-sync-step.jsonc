{
  "kind": "node",
  "type_key": "era.initialize.adapt_startup_sync_step",
  "display_name": "适配启动同步步骤",
  "category": "初始化事务",
  "description": "把初始化后的历史同步请求转换为共享同步任务，保留原批次和事件来源。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.initialize.startup.sync.step",
        "cardinality": "exactly_one",
        "display_name": "专用启动同步步骤"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "routed_startup_sync_step",
        "type": "era.step.request.routed",
        "display_name": "已路由启动同步步骤"
      },
      {
        "key": "routed_startup_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "启动同步批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.initialize.startup.sync.step": [
        "输入：专用启动同步步骤。"
      ],
      "era.batch.execution.state": [
        "输入：批次执行状态。"
      ]
    },
    "output_semantics": {
      "routed_startup_sync_step": [
        "输出：已路由启动同步步骤。"
      ],
      "routed_startup_execution_state": [
        "输出：启动同步批次状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize/shared_pure_adapters.ts",
        "export": "AdaptStartupSyncStepNode"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
