        "display_name": "原任务来源、步骤和当前批次的接续依据"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.continuation.context": [
        "输入：原任务来源、步骤和当前批次的接续依据。"
      ]
    },
    "output_semantics": {
      "carry_preparation_context_result": [
        "输出：原任务来源、步骤和当前批次的接续依据。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
