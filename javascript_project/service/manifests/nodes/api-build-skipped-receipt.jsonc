{
  "kind": "node",
  "type_key": "era.api.build_skipped_receipt",
  "display_name": "返回跳过回执",
  "category": "公共 Facade",
  "description": "历史作用域已结算时返回跳过回执，不写消息或发布状态。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.validated",
        "cardinality": "exactly_one",
        "display_name": "已校验的提交请求"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_skipped_result",
        "type": "era.api.commit.result",
        "display_name": "即时提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.validated": [
        "已校验且判断为无需再次应用的提交请求。"
      ]
    },
    "output_semantics": {
      "facade_commit_skipped_result": [
        "返回跳过回执，不写消息或状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "skippedReceiptNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
