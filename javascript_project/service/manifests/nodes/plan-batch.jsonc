{
  "kind": "node",
  "type_key": "era.service.plan_batch",
  "display_name": "规划领域事件批次",
  "category": "批次执行",
  "description": "把已经就绪的一组聊天或 API 事件翻译成有顺序的任务步骤，例如初始化、消息同步、消息标识更新、生成阶段或明确忽略。每一步保留它对应的原始事件来源，使多个事件即使合并为一个任务也能分别收到处理结果。这里只编排任务，不执行计算或保存。",
  "version": "1.1.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.collection.reduction",
        "cardinality": "exactly_one",
        "display_name": "事件集归约结果"
      }
    ],
    "provides": [
      {
        "key": "batch_plan",
        "type": "era.batch.plan",
        "display_name": "批次计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.collection.reduction": [
        "输入：事件集归约结果。"
      ]
    },
    "output_semantics": {
      "batch_plan": [
        "输出：批次计划。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "PlanBatchNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
