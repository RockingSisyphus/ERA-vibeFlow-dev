{
  "kind": "node",
  "type_key": "era.task.finish_result",
  "display_name": "形成原调用方需要的任务回执",
  "category": "服务任务",
  "description": "接收变量提交、历史同步、简单任务或生成阶段的实际结果，按原调用方形成回执。脚本接口使用原有接口格式，其余任务使用批次任务格式；随后交给批次汇总。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "原任务及回执资料"
      },
      {
        "type": "era.api.facade.result",
        "cardinality": "optional_one",
        "display_name": "变量提交的内存应用结果"
      },
      {
        "type": "era.task.result",
        "cardinality": "optional_one",
        "display_name": "同步、标识或简单任务结果"
      },
      {
        "type": "era.task.execution.result.selected",
        "cardinality": "optional_one",
        "display_name": "已确定的直接结果"
      }
    ],
    "provides": [
      {
        "key": "finished_task_result",
        "type": "era.task.result",
        "display_name": "对应原事件的完整任务回执"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.task.continuation.context": [
        "输入：原任务及回执资料。"
      ],
      "era.api.facade.result": [
        "输入：变量提交的内存应用结果。"
      ],
      "era.task.result": [
        "输入：同步、标识或简单任务结果。"
      ],
      "era.task.execution.result.selected": [
        "输入：已确定的直接结果。"
      ]
    },
    "output_semantics": {
      "finished_task_result": [
        "输出：对应原事件的完整任务回执。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/task_execution_routes.ts",
        "export": "finishResult"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation"
  ],
  "capabilities": []
}
