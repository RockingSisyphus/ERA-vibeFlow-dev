{
  "kind": "node",
  "type_key": "era.command.apply_edit_action",
  "display_name": "修改变量，按需计算公式",
  "category": "核心执行",
  "description": "读取指令指定的变量，直接赋值或计算公式，再写入结果并记录变更。公式按执行到此处的变量、历史起点和随机进度求值；无效操作记录原因并继续原遍历。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "待处理操作、当前变量和函数、历史起点与随机进度"
      }
    ],
    "provides": [
      {
        "key": "apply_edit_action_operation_state",
        "type": "era.command.operation.state",
        "display_name": "执行本项操作后的变量、函数、日志及下一字段"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：待处理操作、当前变量和函数、历史起点与随机进度。"
      ]
    },
    "output_semantics": {
      "apply_edit_action_operation_state": [
        "输出：执行本项操作后的变量、函数、日志及下一字段。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "ApplyEditActionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_state",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
