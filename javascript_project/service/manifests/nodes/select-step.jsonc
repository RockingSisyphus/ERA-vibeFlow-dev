{
  "kind": "node",
  "type_key": "era.service.select_step",
  "display_name": "选择当前步骤",
  "category": "步骤执行",
  "description": "依据批次的当前索引取出这一次应执行的任务，连同完整批次状态一起传下去。不会跳过、删除或提前运行后续任务；一个任务完成并被统一合并后，索引才会推进，因此同批次的 API 和聊天操作保持既定顺序。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "selected_step",
        "type": "era.step.request",
        "display_name": "已选步骤"
      },
      {
        "key": "prepared_execution_state",
        "type": "era.batch.execution.state",
        "display_name": "原样传递的批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.batch.execution.state": [
        "输入：批次执行状态。"
      ]
    },
    "output_semantics": {
      "selected_step": [
        "输出：已选步骤。"
      ],
      "prepared_execution_state": [
        "输出：原样传递的批次执行状态；准备阶段不改写它。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "SelectStepNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
