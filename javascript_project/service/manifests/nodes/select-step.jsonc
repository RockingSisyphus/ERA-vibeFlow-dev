{
  "kind": "node",
  "type_key": "era.service.select_step",
  "display_name": "选择当前步骤",
  "category": "步骤执行",
  "description": "按有界索引选择当前 PlannedStep，并通过只传数据的旁路保留批次执行状态。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "selected_step",
        "type": "era.step.request",
        "display_name": "已选步骤"
      },
      {
        "key": "execution_state_for_merge",
        "type": "era.batch.execution.state",
        "display_name": "待合并批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.batch.execution.state":["输入：批次执行状态。"]},
    "output_semantics": {"selected_step":["输出：已选步骤。"],"execution_state_for_merge":["输出：待合并批次状态。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/step/select_step.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.protocol"
  ],
  "capabilities": []
}
