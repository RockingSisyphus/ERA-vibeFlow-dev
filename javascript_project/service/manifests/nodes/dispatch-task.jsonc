{
  "kind": "node",
  "type_key": "era.tasks.dispatch",
  "display_name": "分派已准备的简单任务",
  "category": "步骤执行",
  "description": "按简单任务类型选择消息历史标识结算、生成设置操作或忽略事件处理。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备路由步骤"
      },
      {
        "type": "era.task.route.selected",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "simple_task_route",
        "type": "era.task.route",
        "display_name": "简单任务路由"
      },
      {
        "key": "routed_step_for_task",
        "type": "era.step.request.routed",
        "display_name": "传递给简单任务的步骤"
      },
      {
        "key": "execution_state_for_task",
        "type": "era.batch.execution.state",
        "display_name": "传递给简单任务的批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已准备路由步骤。"
      ],
      "era.task.route.selected": [
        "输入：已准备任务路由。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态。"
      ]
    },
    "output_semantics": {
      "simple_task_route": [
        "输出：简单任务路由。"
      ],
      "routed_step_for_task": [
        "输出：传递给简单任务的步骤。"
      ],
      "execution_state_for_task": [
        "输出：传递给简单任务的批次状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "DispatchTaskNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
