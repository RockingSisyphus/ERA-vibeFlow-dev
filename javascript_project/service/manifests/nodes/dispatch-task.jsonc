{
  "kind": "node",
  "type_key": "era.tasks.dispatch",
  "display_name": "分派已准备的简单任务",
  "category": "步骤执行",
  "description": "只将已经准备好的消息标识、Agent 设置和忽略任务派往相应分支。普通同步已由外层直接调用，不经过本包装；返回结果不会提前推进索引，仍由统一结算完成。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "已准备路由步骤"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "已准备任务路由"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次执行状态"
      }
    ],
    "provides": [
      {
        "key": "simple_task_route",
        "type": "era.task.route",
        "display_name": "简单任务路由"
      },
      {
        "key": "routed_step_for_task",
        "type": "era.step.request.routed",
        "display_name": "传递给简单任务的步骤"
      },
      {
        "key": "execution_state_for_task",
        "type": "era.batch.execution.state",
        "display_name": "传递给简单任务的批次状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：已完成统一准备的路由步骤。"
      ],
      "era.task.route": [
        "输入：统一准备节点输出的路由；不得重新读取 Planner 的原始 taskRoute。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次执行状态，由本节点原样传给任务节点。"
      ]
    },
    "output_semantics": {
      "simple_task_route": [
        "输出：已准备的简单任务路由；其他任务类别显式报错。"
      ],
      "routed_step_for_task": [
        "输出：原样传递已准备步骤。"
      ],
      "execution_state_for_task": [
        "输出：原样传递批次状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "DispatchTaskNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
