{
  "kind": "node",
  "type_key": "era.sync.seed_command_operations",
  "display_name": "为这一正文指令块建立操作栈",
  "category": "核心执行",
  "description": "仅提取当前块的六类有序变量/函数操作，携带当前变量、函数库、楼层起点快照、前序日志和消息 ERA 标识 MK 所确定的稳定随机来源和已使用的随机次数。建立数组根项与字段栈供第四层循环使用，不提前应用整块、不复制 CRUD 实现，也不把别的正文块混进这一范围。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "seed_command_operations_operation_state",
        "type": "era.command.operation.state",
        "display_name": "当前正文指令块操作初态"
      },
      {
        "key": "seed_command_operations_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "seed_command_operations_operation_state": [
        "输出：当前正文指令块操作初态。"
      ],
      "seed_command_operations_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "SeedCommandOperationsNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
