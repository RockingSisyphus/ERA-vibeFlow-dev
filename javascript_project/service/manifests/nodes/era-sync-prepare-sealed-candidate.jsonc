{
  "kind": "node",
  "type_key": "era.sync.prepare_sealed_candidate",
  "display_name": "按原条件形成已完成楼层的压缩候选",
  "category": "核心执行",
  "description": "在完整楼层结束后，检查后面是否仍有 AI 消息、当前楼层是否有阻止压缩的非作者调用诊断，以及封存标记是否已经匹配。只有符合原条件才携带楼层起点/终点变量和函数、MK、前序元数据与最终正文形成压缩候选；不压缩当前未完成楼层，也不直接替换或保存历史。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "prepare_sealed_candidate_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "prepare_sealed_candidate_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "PrepareSealedCandidateNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
