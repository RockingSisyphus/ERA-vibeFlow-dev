{
  "kind": "node",
  "type_key": "era.sync.build_block_commit",
  "display_name": "构造唯一提交请求",
  "category": "同步规划",
  "description": "将压缩后的单块或楼层维护工作项构造成既有保存请求；依据只吸收本任务已确认的自身写入，不能用新目标依据掩盖旧文本。错误/无需写入使用无提交信封；最后的进度删除和 cursor 清除在此提交路径处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command_compaction.result",
        "cardinality": "exactly_one",
        "display_name": "已处理压缩的单块工作项"
      }
    ],
    "provides": [
      {
        "key": "block_commit_request",
        "type": "era.tavern.commit.request",
        "display_name": "逐块提交请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command_compaction.result": [
        "已处理压缩的单块工作项"
      ]
    },
    "output_semantics": {
      "block_commit_request": [
        "逐块提交请求"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/build_block_commit.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.block_step_state",
    "era.service.sync_contracts",
    "era.service.sync_commit_policy"
  ],
  "capabilities": []
}
