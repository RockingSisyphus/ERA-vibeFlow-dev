{
  "kind": "node",
  "type_key": "era.sync.advance_source_position",
  "display_name": "推进一个已处理块或已完成楼层",
  "category": "核心执行",
  "description": "正常块完成时仅将本楼层块索引加一，楼层结束时才移到下一楼层并清除 floorStarted。保持累计消息修改同楼层合并、已重算索引只在楼层结束登记，以及随机位置的原连续性；作者调用插入块仍按其独立 remaining 计数。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "advance_source_position_position_state",
        "type": "era.sync.position.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.position.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "advance_source_position_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "AdvanceSourcePositionNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
