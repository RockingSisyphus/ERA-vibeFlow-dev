{
  "kind": "node",
  "type_key": "era.sync.no_change",
  "display_name": "结算无需提交的同步结果",
  "category": "同步规划",
  "description": "由 sync_result_policy 把无变化或失败工作项映射为来源回执与批次更新。空聊天清空状态按规划结果进入原提交分支。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.work",
        "cardinality": "exactly_one",
        "display_name": "同步工作项"
      }
    ],
    "provides": [
      {
        "key": "no_change_result",
        "type": "era.sync.logical_result",
        "display_name": "同步逻辑结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.work": [
        "输入：同步工作项。"
      ]
    },
    "output_semantics": {
      "no_change_result": [
        "输出：同步逻辑结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/no_sync_change.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
