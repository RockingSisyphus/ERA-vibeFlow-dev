{
  "kind": "node",
  "type_key": "era.workbench.publish_preparation",
  "display_name": "接回现有变量提交准入或失败分支",
  "category": "工作台提交",
  "description": "把草稿准备成功后的操作、上下文和提交方式交给 调用接口（API） 许可判断；失败时交出具体问题及原请求资料。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.workbench.preparation_result",
        "cardinality": "exactly_one",
        "display_name": "工作台准备结果"
      }
    ],
    "provides": [
      {
        "key": "prepared_commit_inspected",
        "type": "era.api.commit.inspected",
        "display_name": "已读取的提交请求"
      },
      {
        "key": "preparation_route",
        "type": "era.workbench.preparation_route",
        "display_name": "工作台准备分支"
      },
      {
        "key": "preparation_failure",
        "type": "era.api.commit.failure_context",
        "display_name": "提交失败上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.workbench.preparation_result": [
        "输入：工作台准备结果。"
      ]
    },
    "output_semantics": {
      "prepared_commit_inspected": [
        "输出：已读取的提交请求。"
      ],
      "preparation_route": [
        "输出：工作台准备分支。"
      ],
      "preparation_failure": [
        "输出：提交失败上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/shared_workbench_adapters.ts",
        "export": "WorkbenchPublishPreparationNode"
      }
    }
  ],
  "base_libs": [
    "era.workbench.context"
  ],
  "capabilities": []
}
