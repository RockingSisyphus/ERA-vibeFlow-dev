{
  "kind": "node",
  "type_key": "era.api.build_message_append",
  "display_name": "构造消息指令追加",
  "category": "外部 API",
  "description": "在只读消息快照中选择最后一条 AI 消息，只替换当前文本或 swipe，构造不含附件改写的局部消息更新。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {"type": "era.api.write.directive", "cardinality": "exactly_one", "display_name": "API 写入指令"},
      {"type": "era.tavern.messages.read_context.outcome", "cardinality": "exactly_one", "display_name": "原始消息上下文"}
    ],
    "provides": [{"key": "api_message_append_request", "type": "era.api.write.append.request", "display_name": "消息追加请求"}],
    "params_schema": {}, "params_defaults": {},
    "input_semantics": {"era.api.write.directive":["输入：API 写入指令。"],"era.tavern.messages.read_context.outcome":["输入：原始消息上下文。"]},
    "output_semantics": {"api_message_append_request":["输出：消息追加请求。"]}
  },
  "implementations": [{"language": "typescript", "targets": ["browser", "node"], "completion": "immediate", "source": {"kind": "file", "ref": "nodes/api/build_api_message_append.ts", "export": "run"}}],
  "base_libs": ["era.service.api_write_engine"],
  "capabilities": []
}
