{
  "kind": "node",
  "type_key": "era.api.build_no_refresh_append",
  "display_name": "普通 API 只构造目标末尾追加",
  "category": "公共 Facade",
  "description": "保留公共操作和 scope，删除未接通的函数位置插入分支；保存生成文本所依赖的原目标版本，操作记录仍为普通 era_tx。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.target",
        "cardinality": "exactly_one",
        "display_name": "era.api.commit.target"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_append_request",
        "type": "era.api.commit.append.request",
        "display_name": "facade_commit_append_request"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.target": [
        "era.api.commit.target"
      ]
    },
    "output_semantics": {
      "facade_commit_append_request": [
        "facade_commit_append_request"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_build_append.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_nodes"
  ],
  "capabilities": []
}
