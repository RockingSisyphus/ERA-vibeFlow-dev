{
  "kind": "node",
  "type_key": "era.command.inspect_delete",
  "display_name": "检查删除形状与 necessary 保护",
  "category": "核心执行",
  "description": "按当前路径的 necessary（防误删保留规则）判断删除：all 保留子树，children 阻止用空对象直接删除直属子项，self 保留自身但允许按规则继续子路径。非空对象补丁按原字段顺序深入，空对象才尝试原子删除；meta 解除保护通路和根对象不能整体删除的规则不变。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "inspect_delete_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "inspect_delete_delete_route",
        "type": "era.command.delete.route",
        "display_name": "进入子路径、原子删除或跳过"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "inspect_delete_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "inspect_delete_delete_route": [
        "输出：进入子路径、原子删除或跳过。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "InspectDeleteNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
