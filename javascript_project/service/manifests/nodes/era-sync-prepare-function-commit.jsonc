{
  "kind": "node",
  "type_key": "era.sync.prepare_function_commit",
  "display_name": "在作者调用处校验并插入 commit",
  "category": "核心执行",
  "description": "读取当前宿主身份，按原调用窗口、Scope（本次执行作用域）和目标规则检查作者函数 commit，避免重复应用或写到已切换的消息。需跳过或失败时形成即时回执；有效操作序列化为事务，插在当前函数锚点之前，记录待应用块数和位置。这里只插入待执行文本，真正 CRUD 由同一消息块循环逐块完成。 身份能力异常交给统一宿主失败清理，不绕过原目标检查。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.sync.author.state",
        "cardinality": "exactly_one",
        "display_name": "当前消息位置、原块状态、正文范围和作者函数上下文"
      }
    ],
    "provides": [
      {
        "key": "prepare_function_commit_position_state",
        "type": "era.sync.author.state",
        "display_name": "本位置处理后的私有状态；尚未发布到宿主"
      },
      {
        "key": "prepare_function_commit_function_commit_route",
        "type": "era.sync.function.commit.route",
        "display_name": "立即返回回执或继续原位块应用"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.author.state": [
        "输入：当前消息位置、原块状态、正文范围和作者函数上下文。"
      ]
    },
    "output_semantics": {
      "prepare_function_commit_position_state": [
        "输出：本位置处理后的私有状态；尚未发布到宿主。"
      ],
      "prepare_function_commit_function_commit_route": [
        "输出：立即返回回执或继续原位块应用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_author_nodes.ts",
        "export": "PrepareFunctionCommitNode"
      }
    }
  ],
  "base_libs": [
    "era.sync.position_author"
  ],
  "capabilities": []
}
