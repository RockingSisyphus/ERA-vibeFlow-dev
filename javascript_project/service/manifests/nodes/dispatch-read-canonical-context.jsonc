{
  "kind": "node",
  "type_key": "era.dispatch.read_canonical_context",
  "display_name": "读取严格酒馆上下文",
  "category": "任务派发",
  "description": "读取当前聊天身份和所有消息的实际楼号、当前 Swipe（同一消息的候选回复）及正文。需要消息标识时还读取状态文件指针、已有 ERA 元数据和占位符设置。全量读取会保留准备生成的新末楼或空候选，避免把旧回复当成新目标；读取失败输出明确失败上下文，供后续停止写入。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.seed",
        "cardinality": "exactly_one",
        "display_name": "派发准备种子"
      }
    ],
    "provides": [
      {
        "key": "canonical_dispatch_context",
        "type": "era.dispatch.canonical_context",
        "display_name": "严格派发读取上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.seed": [
        "输入：需要读取消息的任务种子。"
      ]
    },
    "output_semantics": {
      "canonical_dispatch_context": [
        "输出：不含宿主对象的消息、元数据和占位符设置。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/read_canonical_context.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.sidecar_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.variables",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record"
      ]
    }
  ]
}
