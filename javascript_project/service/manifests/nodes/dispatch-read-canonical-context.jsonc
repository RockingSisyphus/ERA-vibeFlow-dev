{
  "kind": "node",
  "type_key": "era.dispatch.read_canonical_context",
  "display_name": "读取酒馆上下文",
  "category": "任务派发",
  "description": "从酒馆读取当前聊天、消息身份、所选回复和正文，以及任务所需的状态文件绑定、元数据和占位设置，形成任务的统一输入资料。",
  "version": "1.0.0",
  "flow_kind": "data_store",
  "contract": {
    "requires": [
      {
        "type": "era.dispatch.seed",
        "cardinality": "exactly_one",
        "display_name": "派发准备种子"
      }
    ],
    "provides": [
      {
        "key": "canonical_dispatch_context",
        "type": "era.dispatch.canonical_context",
        "display_name": "派发读取上下文"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.dispatch.seed": [
        "输入：派发准备种子。"
      ]
    },
    "output_semantics": {
      "canonical_dispatch_context": [
        "输出：派发读取上下文。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/dispatch/read_canonical_context.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.dispatch_preparation",
    "era.service.sidecar_binding"
  ],
  "capabilities": [
    {
      "id": "era.tavern.messages",
      "operations": [
        "read_context"
      ]
    },
    {
      "id": "era.tavern.identity",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.variables",
      "operations": [
        "read"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record"
      ]
    }
  ]
}
