{
  "kind": "node",
  "type_key": "era.lifecycle.return_applied_receipt",
  "display_name": "返回内存应用回执并登记保存时机",
  "category": "内存生命周期",
  "description": "在逐块应用结束后向 ERA.commit 调用方返回结果：失败带回实际原因，成功代表内存变量、日志、作用域和待保存正文已经应用一致，不只是请求已入队。作者函数内的操作归属当前生成批次；独立 API 提交安排约 200 毫秒防抖、最长约 2 秒的保存请求，等待回执本身不会强制每次落盘。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_result",
        "type": "era.api.commit.result",
        "display_name": "即时提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "ERA.commit 在内存中逐块应用后的工作状态。"
      ]
    },
    "output_semantics": {
      "facade_commit_result": [
        "返回内存应用回执，并登记后续批次保存时机。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/return_applied_receipt.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": [
    {
      "id": "era.lifecycle.admission",
      "operations": [
        "schedule"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
