{
  "kind": "node",
  "type_key": "era.lifecycle.return_applied_receipt",
  "display_name": "返回内存应用回执并登记保存时机",
  "category": "内存生命周期",
  "description": "工作状态、日志、scope和待保存消息一致后返回；不是入队即成功。当前函数归属父批次；独立API防抖加最长未保存时间，时间到通过既有事件端口请求批次保存。多次不await按序，多次await不强制刷盘。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.block.step.state.next",
        "cardinality": "exactly_one",
        "display_name": "块执行后状态"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_result",
        "type": "era.api.commit.result",
        "display_name": "即时提交结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.block.step.state.next": [
        "ERA.commit 在内存中逐块应用后的工作状态。"
      ]
    },
    "output_semantics": {
      "facade_commit_result": [
        "返回内存应用回执，并登记后续批次保存时机。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/return_applied_receipt.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ],
  "capabilities": [
    {
      "id": "era.lifecycle.admission",
      "operations": [
        "schedule"
      ]
    },
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_working"
      ]
    }
  ]
}
