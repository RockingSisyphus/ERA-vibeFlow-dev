{
  "kind": "node",
  "type_key": "era.service.cycle.unpack_collect",
  "display_name": "解包收集状态",
  "category": "服务阶段循环",
  "description": "确认当前确实处于收集阶段，然后从循环载体中取出事件集合、序号和定时器等服务状态，供接收和整理新事件使用。它不接收事件、不清空集合；若把执行阶段的状态交到这里，会报错，避免混淆两种阶段的数据。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.cycle.routed",
        "cardinality": "exactly_one",
        "display_name": "输入状态"
      }
    ],
    "provides": [
      {
        "key": "service_state_current",
        "type": "era.service.state.current",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.cycle.routed": [
        "读取并保留输入值。"
      ]
    },
    "output_semantics": {
      "service_state_current": [
        "供同一 Service 工作流的下一阶段使用。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "UnpackCollectCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
