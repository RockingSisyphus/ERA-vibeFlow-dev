{
  "kind": "node",
  "type_key": "era.service.cycle.unpack_collect",
  "display_name": "解包收集状态",
  "category": "服务阶段循环",
  "description": "从收集阶段状态取出待处理事件、事件序号和定时器资料，供新事件合并判断。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.service.cycle.routed",
        "cardinality": "exactly_one",
        "display_name": "本节点所需的当前运行资料"
      }
    ],
    "provides": [
      {
        "key": "service_state_current",
        "type": "era.service.state.current",
        "display_name": "阶段结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.service.cycle.routed": [
        "输入：本节点所需的当前运行资料。"
      ]
    },
    "output_semantics": {
      "service_state_current": [
        "输出：阶段结果。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/iteration/shared_protocol_adapters.ts",
        "export": "UnpackCollectCycleNode"
      }
    }
  ],
  "base_libs": [
    "era.service.service_protocol_collection",
    "era.service.service_protocol_execution"
  ],
  "capabilities": []
}
