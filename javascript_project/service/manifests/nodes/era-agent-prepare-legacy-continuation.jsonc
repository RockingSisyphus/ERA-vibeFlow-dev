{
  "kind": "node",
  "type_key": "era.agent.prepare_legacy_continuation",
  "display_name": "返回后续共享同步或标识请求",
  "category": "核心执行",
  "description": "把候选已经应用的消息及允许执行范围转换为历史同步或消息历史标识任务，保留原事件来源，供共享消息流程完成结算。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.step.request.routed",
        "cardinality": "exactly_one",
        "display_name": "原任务、触发事件与已读取消息"
      },
      {
        "type": "era.batch.execution.state",
        "cardinality": "exactly_one",
        "display_name": "当前批次、任务列表与执行位置"
      },
      {
        "type": "era.task.route",
        "cardinality": "exactly_one",
        "display_name": "既有同步或消息标识分支"
      },
      {
        "type": "era.task.continuation.context",
        "cardinality": "exactly_one",
        "display_name": "原任务、事件来源、批次和回执资料"
      }
    ],
    "provides": [
      {
        "key": "prepare_legacy_continuation_prepared_task",
        "type": "era.task.prepared",
        "display_name": "待执行请求及原任务资料"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.step.request.routed": [
        "输入：原任务、触发事件与已读取消息。"
      ],
      "era.batch.execution.state": [
        "输入：当前批次、任务列表与执行位置。"
      ],
      "era.task.route": [
        "输入：既有同步或消息标识分支。"
      ],
      "era.task.continuation.context": [
        "输入：原任务、事件来源、批次和回执资料。"
      ]
    },
    "output_semantics": {
      "prepare_legacy_continuation_prepared_task": [
        "输出：待执行请求及原任务资料。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/agent/shared_agent_flow_adapters.ts",
        "export": "prepareLegacyContinuation"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_flow_policy",
    "era.service.agent_flow_types",
    "era.service.agent_task_result",
    "era.service.task_continuation",
    "era.service.types"
  ],
  "capabilities": []
}
