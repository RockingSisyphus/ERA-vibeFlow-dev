{
  "kind": "node",
  "type_key": "era.api.build_single_era_tx",
  "display_name": "生成单次 era_tx",
  "category": "公共 Facade",
  "description": "把已通过准入检查的操作按原顺序组成一个 ERA 事务文本，连同作用域、调用身份和批次状态送到目标定位环节。不会合并重排操作，也不会在构造文本时执行它们；同一事务随后交给共享消息块引擎处理，保证公共 API 与消息指令采用相同规则。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.validated",
        "cardinality": "exactly_one",
        "display_name": "已校验的提交请求"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_transaction",
        "type": "era.api.commit.transaction",
        "display_name": "待提交事务"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.validated": [
        "已通过窗口、范围和操作校验的提交请求。"
      ]
    },
    "output_semantics": {
      "facade_commit_transaction": [
        "按原操作顺序生成单次待应用事务。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "buildTransactionNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.task_continuation",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
