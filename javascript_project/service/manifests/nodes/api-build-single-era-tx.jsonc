{
  "kind": "node",
  "type_key": "era.api.build_single_era_tx",
  "display_name": "生成单次 era_tx",
  "category": "公共 Facade",
  "description": "按原操作顺序生成一个且仅一个短 scope wrapper。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.api.commit.validated",
        "cardinality": "exactly_one",
        "display_name": "已校验的提交请求"
      }
    ],
    "provides": [
      {
        "key": "facade_commit_transaction",
        "type": "era.api.commit.transaction",
        "display_name": "待提交事务"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.api.commit.validated": [
        "已通过窗口、范围和操作校验的提交请求。"
      ]
    },
    "output_semantics": {
      "facade_commit_transaction": [
        "按原操作顺序生成单次待应用事务。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/api/facade_nodes.ts",
        "export": "buildTransactionNode"
      }
    }
  ],
  "base_libs": [
    "era.service.facade_api_engine",
    "era.service.types",
    "era.service.working_state"
  ],
  "capabilities": []
}
