{
  "kind": "node",
  "type_key": "era.sync.accept_message_operations",
  "display_name": "接收操作结果，继续处理消息",
  "category": "核心执行",
  "description": "把操作循环产生的变量、函数、日志和诊断合入当前消息。正文指令标记为已完成并推进正文位置；生成阶段调用形成阶段结果，交回消息处理。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.result",
        "cardinality": "exactly_one",
        "display_name": "完整操作范围结果"
      },
      {
        "type": "era.sync.position.state",
        "cardinality": "exactly_one",
        "display_name": "消息及正文位置、允许处理范围和作者调用进度"
      }
    ],
    "provides": [
      {
        "key": "operations_position",
        "type": "era.sync.position.state",
        "display_name": "应用操作结果后的消息进度"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.result": [
        "输入：完整操作范围结果。"
      ],
      "era.sync.position.state": [
        "输入：消息及正文位置、允许处理范围和作者调用进度。"
      ]
    },
    "output_semantics": {
      "operations_position": [
        "输出：应用操作结果后的消息进度。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_position_nodes.ts",
        "export": "AcceptMessageOperationsNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_state",
    "era.service.agent_stage_program",
    "era.service.function_block_execution",
    "era.service.sync_contracts",
    "era.service.sync_divergence",
    "era.sync.position_source"
  ],
  "capabilities": []
}
