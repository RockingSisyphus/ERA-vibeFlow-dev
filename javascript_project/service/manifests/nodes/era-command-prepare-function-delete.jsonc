{
  "kind": "node",
  "type_key": "era.command.prepare_function_delete",
  "display_name": "准备函数删除或 meta 删除",
  "category": "核心执行",
  "description": "空对象补丁准备整个函数的删除，necessary=self/all 的函数保留；meta 补丁转入同一有序路径栈，按原删除规则逐字段处理定义副本的 $meta。不存在的函数按原规则跳过。这里只准备或修改候选定义，不提交当前函数库；整组仍须统一校验。",
  "version": "1.0.0",
  "flow_kind": "decision",
  "contract": {
    "requires": [
      {
        "type": "era.command.operation.state",
        "cardinality": "exactly_one",
        "display_name": "当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志"
      }
    ],
    "provides": [
      {
        "key": "prepare_function_delete_operation_state",
        "type": "era.command.operation.state",
        "display_name": "本次微操作后的私有工作状态；块尚未完成"
      },
      {
        "key": "prepare_function_delete_function_delete_route",
        "type": "era.command.function.delete.route",
        "display_name": "整函数候选动作或进入元数据路径删除"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.command.operation.state": [
        "输入：当前操作栈、变量/函数工作值、历史快照、随机位置与累计日志。"
      ]
    },
    "output_semantics": {
      "prepare_function_delete_operation_state": [
        "输出：本次微操作后的私有工作状态；块尚未完成。"
      ],
      "prepare_function_delete_function_delete_route": [
        "输出：整函数候选动作或进入元数据路径删除。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sync/core_operation_nodes.ts",
        "export": "PrepareFunctionDeleteNode"
      }
    }
  ],
  "base_libs": [
    "era.command.operation_expressions",
    "era.command.operation_functions",
    "era.command.operation_traversal"
  ],
  "capabilities": []
}
