{
  "kind": "node",
  "type_key": "era.sidecar_binding.resolve_choice",
  "display_name": "规划 独立状态文件 绑定选择",
  "category": "Sidecar 绑定",
  "description": "根据当前状态文件资料及用户选择，决定新建、迁移、继续使用或等待归属、修复选择；读取失败时保留其原因。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sidecar.binding.input",
        "cardinality": "exactly_one",
        "display_name": "独立状态文件 绑定输入"
      },
      {
        "type": "era.sidecar.binding.facts",
        "cardinality": "exactly_one",
        "display_name": "当前 独立状态文件 事实"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_resolution",
        "type": "era.sidecar.binding.resolution",
        "display_name": "独立状态文件 绑定决议"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sidecar.binding.input": [
        "输入：独立状态文件 绑定输入。"
      ],
      "era.sidecar.binding.facts": [
        "输入：当前 独立状态文件 事实。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_resolution": [
        "输出：独立状态文件 绑定决议。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/shared_choice_adapters.ts",
        "export": "ResolveChoiceNode"
      }
    }
  ],
  "base_libs": [
    "era.service.sidecar_binding",
    "era.service.sync_contracts",
    "era.service.sync_result_policy"
  ]
}
