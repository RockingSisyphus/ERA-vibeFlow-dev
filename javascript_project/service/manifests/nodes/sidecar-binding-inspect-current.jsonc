{
  "kind": "node",
  "type_key": "era.sidecar_binding.inspect_current",
  "display_name": "检查当前 Sidecar 绑定",
  "category": "Sidecar 绑定",
  "description": "检查当前聊天绑定的是哪一个 Sidecar（独立保存 ERA 变量、函数和日志的状态文件），核对读取前后的聊天身份和文件指针。存在同一绑定的有效内存状态时优先沿用，避免已应用但未保存的操作被旧文件覆盖；必要时恢复被打断的模型候选起点。来源变化或读取失败转为失败事实，不把新聊天与旧消息混在一起。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_input",
        "type": "era.sidecar.binding.input",
        "display_name": "Sidecar 绑定输入"
      },
      {
        "key": "sidecar_binding_facts",
        "type": "era.sidecar.binding.facts",
        "display_name": "当前 Sidecar 事实"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_input": [
        "输出：转交给 Sidecar 分支的同步上下文封装。"
      ],
      "sidecar_binding_facts": [
        "输出：当前身份、聊天变量和本地记录的只读检查事实。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/inspect_current.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_session_binding",
    "era.service.sidecar_binding",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_session_binding",
        "write_session",
        "clear_session"
      ]
    }
  ]
}
