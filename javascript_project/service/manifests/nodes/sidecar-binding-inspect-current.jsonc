{
  "kind": "node",
  "type_key": "era.sidecar_binding.inspect_current",
  "display_name": "检查当前 独立状态文件 绑定",
  "category": "Sidecar 绑定",
  "description": "检查当前聊天指向的独立状态文件及聊天身份，优先使用同一有效绑定的内存变量、函数和日志，并识别需要恢复的未完成候选起点。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.sync.context",
        "cardinality": "exactly_one",
        "display_name": "同步上下文"
      }
    ],
    "provides": [
      {
        "key": "sidecar_binding_input",
        "type": "era.sidecar.binding.input",
        "display_name": "独立状态文件 绑定输入"
      },
      {
        "key": "sidecar_binding_facts",
        "type": "era.sidecar.binding.facts",
        "display_name": "当前 独立状态文件 事实"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.sync.context": [
        "输入：同步上下文。"
      ]
    },
    "output_semantics": {
      "sidecar_binding_input": [
        "输出：独立状态文件 绑定输入。"
      ],
      "sidecar_binding_facts": [
        "输出：当前 独立状态文件 事实。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser"
      ],
      "completion": "suspend",
      "source": {
        "kind": "file",
        "ref": "nodes/sidecar/inspect_current.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.service.agent_session_binding",
    "era.service.sidecar_binding",
    "era.service.working_state"
  ],
  "capabilities": [
    {
      "id": "era.tavern.sidecar",
      "operations": [
        "read_current",
        "read_record",
        "read_working",
        "write_working"
      ]
    },
    {
      "id": "era.tavern.agent",
      "operations": [
        "read_session_binding",
        "write_session",
        "clear_session"
      ]
    }
  ]
}
