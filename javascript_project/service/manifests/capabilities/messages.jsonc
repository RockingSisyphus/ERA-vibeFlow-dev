{
  "kind": "capability",
  "id": "era.tavern.messages",
  "targets": ["browser"],
  "display_name": "酒馆消息",
  "description": "读取消息上下文，并按工作流明确生成的计划更新内容和刷新消息。",
  "operations": {
    "read_context": {
      "input_type": "era.tavern.messages.read_context.request",
      "output_type": "era.tavern.messages.read_context.result",
      "completion": "suspend"
    },
    "update_content": {
      "input_type": "era.tavern.messages.update_content.request",
      "output_type": "era.tavern.messages.update_content.result",
      "completion": "suspend"
    },
    "refresh": {
      "input_type": "era.tavern.messages.refresh.request",
      "output_type": "era.tavern.messages.refresh.result",
      "completion": "suspend"
    }
  }
}
