{
  "kind": "capability",
  "id": "era.tavern.agent",
  "targets": [
    "browser"
  ],
  "display_name": "ERA 多阶段生成宿主 I/O",
  "description": "执行服务指定的角色设置、页面会话、模型请求和一次性内容注入，将接口实际结果交回生成流程。",
  "operations": {
    "await_native_completion": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "read_context": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "write_configuration": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "capture_preset": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "read_configuration_sources": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "read_connection_state": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.connection.state",
      "completion": "immediate"
    },
    "upsert_connection_profile": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "delete_connection_profile": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "clear_connection_profile_key": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "list_connection_models": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "list_connection_models_draft": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "generate": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "generate_story": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "inject_once": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "write_session": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "clear_session": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "create_error_message": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "suspend"
    },
    "stop_native_generation": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.host.result",
      "completion": "immediate"
    },
    "read_session_binding": {
      "input_type": "era.agent.host.request",
      "output_type": "era.agent.session.binding.facts",
      "completion": "immediate"
    }
  }
}
