{
  "kind": "capability",
  "id": "era.tavern.identity",
  "targets": ["browser"],
  "display_name": "酒馆身份信息",
  "description": "同步读取当前角色、群组与聊天身份信息。",
  "operations": {
    "read": {
      "input_type": "era.tavern.identity.read.request",
      "output_type": "era.tavern.identity.read.result",
      "completion": "immediate"
    }
  }
}
