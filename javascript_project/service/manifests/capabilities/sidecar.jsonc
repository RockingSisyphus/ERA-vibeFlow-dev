{
  "kind": "capability",
  "id": "era.tavern.sidecar",
  "targets": [
    "browser"
  ],
  "display_name": "ERA 独立状态文件 宿主接线",
  "description": "提供当前聊天身份、用户文件和绑定选择弹窗的读写接口，供状态文件流程执行已选定操作。",
  "operations": {
    "read_current": {
      "input_type": "era.tavern.sidecar.read_current.request",
      "output_type": "era.tavern.sidecar.read_current.result",
      "completion": "suspend"
    },
    "read_record": {
      "input_type": "era.tavern.sidecar.read_record.request",
      "output_type": "era.tavern.sidecar.read_record.result",
      "completion": "suspend"
    },
    "write_record": {
      "input_type": "era.tavern.sidecar.write_record.request",
      "output_type": "era.tavern.sidecar.write_record.result",
      "completion": "suspend"
    },
    "commit_metadata": {
      "input_type": "era.tavern.sidecar.commit_metadata.request",
      "output_type": "era.tavern.sidecar.commit_metadata.result",
      "completion": "suspend"
    },
    "publish_snapshot": {
      "input_type": "era.tavern.sidecar.commit_metadata.request",
      "output_type": "era.tavern.sidecar.commit_metadata.result",
      "completion": "immediate"
    },
    "create_id": {
      "input_type": "era.tavern.sidecar.create_id.request",
      "output_type": "era.tavern.sidecar.create_id.result",
      "completion": "immediate"
    },
    "present_prompt": {
      "input_type": "era.tavern.sidecar.present_prompt.request",
      "output_type": "era.tavern.sidecar.present_prompt.result",
      "completion": "immediate"
    },
    "clear_prompt": {
      "input_type": "era.tavern.sidecar.clear_prompt.request",
      "output_type": "era.tavern.sidecar.clear_prompt.result",
      "completion": "immediate"
    },
    "read_working": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "immediate"
    },
    "write_working": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "immediate"
    }
  }
}
