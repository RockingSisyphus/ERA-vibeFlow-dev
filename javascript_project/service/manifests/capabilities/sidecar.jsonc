{
  "kind": "capability",
  "id": "era.tavern.sidecar",
  "targets": ["browser"],
  "display_name": "ERA Sidecar 宿主接线",
  "description": "仅搬运当前身份、聊天变量、当前用户 files 和 UI 弹窗；不包含绑定、迁移或复制决策。",
  "operations": {
    "read_current": { "input_type": "era.tavern.sidecar.read_current.request", "output_type": "era.tavern.sidecar.read_current.result", "completion": "suspend" },
    "read_record": { "input_type": "era.tavern.sidecar.read_record.request", "output_type": "era.tavern.sidecar.read_record.result", "completion": "suspend" },
    "write_record": { "input_type": "era.tavern.sidecar.write_record.request", "output_type": "era.tavern.sidecar.write_record.result", "completion": "suspend" },
    "commit_metadata": { "input_type": "era.tavern.sidecar.commit_metadata.request", "output_type": "era.tavern.sidecar.commit_metadata.result", "completion": "suspend" },
    "create_id": { "input_type": "era.tavern.sidecar.create_id.request", "output_type": "era.tavern.sidecar.create_id.result", "completion": "immediate" },
    "present_prompt": { "input_type": "era.tavern.sidecar.present_prompt.request", "output_type": "era.tavern.sidecar.present_prompt.result", "completion": "immediate" },
    "clear_prompt": { "input_type": "era.tavern.sidecar.clear_prompt.request", "output_type": "era.tavern.sidecar.clear_prompt.result", "completion": "immediate" }
  }
}
