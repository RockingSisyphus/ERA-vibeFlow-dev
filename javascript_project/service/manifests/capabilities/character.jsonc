{
  "kind": "capability",
  "id": "era.tavern.character",
  "targets": ["browser"],
  "display_name": "酒馆角色主开场白",
  "description": "只读或以真实 avatar 乐观更新当前单角色卡的 first_messages[0]；写入成功后仅刷新空聊天或恰好一条未污染主开场白，已有多楼、编辑/污染、备用开场白和群聊保持原样。",
  "operations": {
    "patch_single_floor": {
      "input_type": "era.tavern.character.single_floor.request",
      "output_type": "era.tavern.character.single_floor.result",
      "completion": "suspend"
    },
    "patch_external_statusbar": {
      "input_type": "era.tavern.character.external_statusbar.request",
      "output_type": "era.tavern.character.external_statusbar.result",
      "completion": "suspend"
    },
    "read_main_greeting": {
      "input_type": "era.tavern.character.read_main_greeting.request",
      "output_type": "era.tavern.character.read_main_greeting.result",
      "completion": "suspend"
    },
    "write_main_greeting": {
      "input_type": "era.tavern.character.write_main_greeting.request",
      "output_type": "era.tavern.character.write_main_greeting.result",
      "completion": "suspend"
    }
  }
}
