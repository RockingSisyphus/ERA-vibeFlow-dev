{
  "kind": "capability",
  "id": "era.tavern.sidecar_test",
  "targets": ["browser"],
  "display_name": "ERA Sidecar 测试接线",
  "description": "仅在 Pack 受控 fixture 下搬运当前身份、聊天测试 marker 与只读测试报告；不包含匹配、重绑、同步或持久化规则。",
  "operations": {
    "read_context": {
      "input_type": "era.tavern.sidecar_test.read_context.request",
      "output_type": "era.tavern.sidecar_test.read_context.result",
      "completion": "suspend"
    },
    "publish_report": {
      "input_type": "era.tavern.sidecar_test.publish_report.request",
      "output_type": "era.tavern.sidecar_test.publish_report.result",
      "completion": "immediate"
    },
    "clear_report": {
      "input_type": "era.tavern.sidecar_test.clear_report.request",
      "output_type": "era.tavern.sidecar_test.clear_report.result",
      "completion": "immediate"
    }
  }
}
