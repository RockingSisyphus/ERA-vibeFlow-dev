{
  "kind": "capability",
  "id": "era.tavern.functions",
  "targets": ["browser"],
  "display_name": "ERA 消息内函数调用宿主 I/O",
  "description": "只执行 Service 已声明的机械操作：按调用标识登记作者注册的工具调用、在调用位置执行它并回送终态，以及结束会话。块顺序、操作应用与最终提交仍由 Service 决定；本能力不决定业务顺序，也不写 ERA 业务状态。",
  "operations": {
    "invoke": {
      "input_type": "era.tavern.functions.invoke.request",
      "output_type": "era.tavern.functions.invoke.result",
      "completion": "suspend"
    },
    "result": {
      "input_type": "era.tavern.functions.result.request",
      "output_type": "era.tavern.functions.result.result",
      "completion": "suspend"
    },
    "release": {
      "input_type": "era.tavern.functions.release.request",
      "output_type": "era.tavern.functions.release.result",
      "completion": "immediate"
    }
  }
}
