{
  "kind": "capability",
  "id": "era.tavern.functions",
  "targets": [
    "browser"
  ],
  "display_name": "消息内原生工具调用通道",
  "description": "通过酒馆接口启动已注册的作者工具，传递参数，并将其接口请求及 Service 应用回执按顺序交还。",
  "operations": {
    "begin": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "immediate"
    },
    "next": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "suspend"
    },
    "acknowledge": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "immediate"
    },
    "release": {
      "input_type": "era.working.request",
      "output_type": "era.working.result",
      "completion": "immediate"
    }
  }
}
