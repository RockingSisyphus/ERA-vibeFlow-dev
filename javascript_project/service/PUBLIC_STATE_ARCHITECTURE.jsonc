                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "messageAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "branchAdmission": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "messageId",
                    "messageAdmission",
                    "branchAdmission"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "consecutiveMk",
                "consecutiveProcessingCount"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "settlements",
            "notifications",
            "diagnostics"
          ],
          "additionalProperties": false
        }
