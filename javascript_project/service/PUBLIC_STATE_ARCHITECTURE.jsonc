                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "consecutiveProcessingCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "scopeWindow": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "oneOf": [
