              "items": {
                "type": "object",
                "required": [
                  "id",
                  "enabled",
                  "role",
                  "content"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "content": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "era.agent.planning.attempt_result": {
        "kind": "data_schema",
        "type_key": "era.agent.planning.attempt_result",
        "representation": "json",
        "display_name": "ERA 规划尝试结果",
        "description": "保存有界规划尝试、严格故事计划、最多 32 项函数调用表及可定位诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "attempts",
            "storyPlan",
            "calls"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "exhausted",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 17,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "output",
                  "diagnostics"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "output": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "storyPlan": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "function",
                  "args"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.session.context": {
        "kind": "data_schema",
        "type_key": "era.agent.session.context",
        "representation": "json",
        "display_name": "ERA 故事生成会话上下文",
        "description": "Service 从已路由事件与 Host 脱敏投影组合出的有界角色卡、聊天、分支、消息、配置和活动会话上下文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventType",
            "chatKey",
            "branchKey",
            "speakerKey",
            "messageId",
            "swipeIndex",
            "revision",
            "configuration",
            "session"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "chatKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "branchKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "speakerKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "messageId": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "swipeIndex": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "session": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "era.agent.session.route": {
        "kind": "data_schema",
        "type_key": "era.agent.session.route",
        "representation": "json",
        "display_name": "ERA 故事生成会话路由",
        "description": "把四种阶段模式折叠为委托原任务或直接结算两条互斥工作流分支；完整模式仍保留在 transition 中。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "enum": [
            "legacy",
            "direct"
          ]
        }
      },
      "era.agent.session.transition": {
        "kind": "data_schema",
        "type_key": "era.agent.session.transition",
        "representation": "json",
        "display_name": "ERA 故事生成会话转换结果",
        "description": "统一承载默认委托、阶段推进、设置保存、取消和失败后的会话状态更新与任务结算候选。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "step",
            "mode",
            "status",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object",
              "additionalProperties": true
            },
            "mode": {
              "enum": [
                "legacy",
                "legacy-ignore",
                "execute-legacy",
                "execute-only"
              ]
            },
            "status": {
              "enum": [
                "committed",
                "no-op",
                "failed"
              ]
            },
            "value": {},
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.settlement.attempt_result": {
        "kind": "data_schema",
        "type_key": "era.agent.settlement.attempt_result",
        "representation": "json",
        "display_name": "ERA 变量分析尝试结果",
        "description": "保存有界变量分析尝试、最终分析文本、候选有序 operations 与精确诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "attempts",
            "analysis",
            "operations"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "exhausted",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 17,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "output",
                  "diagnostics"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "output": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "analysis": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 262144
                },
                {
                  "type": "null"
                }
              ]
            },
            "operations": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "era.agent.settlement.validated": {
        "kind": "data_schema",
        "type_key": "era.agent.settlement.validated",
        "representation": "json",
        "display_name": "ERA 已校验变量结算",
        "description": "携带成功试执行后的规范单一 message scope 事务，或不写错误事务的未结算状态。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "operations",
            "eraTx",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "unsettled",
                "failed",
                "cancelled"
              ]
            },
            "operations": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "eraTx": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576,
                  "pattern": "^<era_tx s=\\\"m\\\">"
                },
                {
                  "type": "null"
                }
              ]
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      },
      "era.agent.story.capture": {
        "kind": "data_schema",
        "type_key": "era.agent.story.capture",
        "representation": "json",
        "display_name": "ERA Agent 故事捕获",
        "description": "保存当前 Swipe 的干净故事、被隔离的故事模型 ERA 标签、故事前状态引用及计划函数证据。",
