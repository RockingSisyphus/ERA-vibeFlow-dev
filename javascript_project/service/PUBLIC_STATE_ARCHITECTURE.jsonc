      "era.api.commit.append.request": {
        "kind": "data_schema",
        "type_key": "era.api.commit.append.request",
        "representation": "json",
        "display_name": "无刷新事务追加请求",
        "description": "携带 refresh none 的单次消息更新。",
        "schema": {
          "type": "object",
