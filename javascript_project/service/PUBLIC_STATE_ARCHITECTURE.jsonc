            },
            "messageId": {
              "type": "integer",
              "minimum": 0
            },
            "swipeIndex": {
              "type": "integer",
              "minimum": 0
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "story": {
              "type": "string",
              "maxLength": 1048576
            },
            "isolatedEraTags": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 262144
              }
            },
            "baseline": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "era.api.commit.admission.route": {
        "kind": "data_schema",
        "type_key": "era.api.commit.admission.route",
