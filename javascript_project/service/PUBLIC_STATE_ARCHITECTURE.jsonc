                                },
                                "token": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "refKind": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "kind",
                                "token",
                                "refKind"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "encodedBytes": {
                        "type": "integer",
                        "minimum": 0,
