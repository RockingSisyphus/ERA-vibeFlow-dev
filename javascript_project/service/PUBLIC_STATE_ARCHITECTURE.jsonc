              "type": "object"
            },
            "route": {
              "type": "string",
              "enum": [
                "continue",
                "blocked",
                "apply"
              ]
            },
            "choice": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "migrate",
                "independent",
                "copy",
                "repair",
                null
              ]
            }
          }
        }
      },
