                      "status": {
                        "const": "completed"
                      },
                      "taskId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "combined",
                          "coalesced"
                        ]
                      },
                      "value": {}
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "taskId",
                      "relation"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "ignored"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "failed"
                      },
                      "error": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "message": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "input",
                              "domain",
                              "tavern",
                              "cancelled"
                            ]
                          },
                          "retryable": {
                            "type": "boolean"
                          },
                          "details": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "required": [
                          "code",
                          "message",
                          "category",
                          "retryable"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "error"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "eventId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "status": {
                        "const": "cancelled"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "eventId",
                      "sequence",
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "notifications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "json"
                            },
                            "value": {}
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "undefined"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "host-ref"
                            },
                            "token": {
                              "type": "string",
                              "minLength": 1
                            },
                            "refKind": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "token",
                            "refKind"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "args"
                ],
                "additionalProperties": false
              }
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  },
                  "sequence": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "sequence"
                ],
                "additionalProperties": false
              }
            },
            "stateUpdate": {
              "type": "object",
