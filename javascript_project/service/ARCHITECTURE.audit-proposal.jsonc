              "type": "string",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "occurredAt": {
              "type": "number"
            },
            "source": {
              "type": "string",
