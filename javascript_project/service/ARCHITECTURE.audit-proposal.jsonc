        "display_name": "Sidecar 绑定事实",
        "description": "当前身份、聊天 SidecarId、V2 文件记录与仅用于一次迁移的旧状态事实。运行资格由安装作用域 workflow 决定，缺失指针为 create 或 migrate-legacy。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "status",
            "reason",
            "current",
            "sidecarId",
            "record",
            "legacyRecord",
            "legacyState"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "create",
                "migrate-legacy",
                "matched",
                "conflict",
                "invalid",
                "blocked"
              ]
            },
            "reason": {
              "type": "string"
            },
            "current": {
              "type": [
                "object",
                "null"
              ]
            },
            "sidecarId": {
              "type": [
                "string",
                "null"
              ]
            },
            "record": {
              "type": [
                "object",
                "null"
              ]
            },
            "legacyRecord": {
              "type": [
                "object",
                "null"
              ]
            },
            "legacyState": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
