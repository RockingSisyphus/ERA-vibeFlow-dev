        "description": "只读当前脚本 ID 及三类 Tavern Helper 脚本树中的启用归属；不作业务分类。",
        "operations": {
          "read": {
            "input_type": "era.tavern.installation_scope.read.request",
            "output_type": "era.installation.scope.facts",
            "completion": "immediate"
          }
        }
      },
      "era.tavern.messages": {
        "kind": "capability",
        "id": "era.tavern.messages",
        "targets": [
          "browser"
        ],
        "display_name": "酒馆消息",
        "description": "读取消息上下文，并按工作流明确生成的计划更新内容和刷新消息。",
        "operations": {
          "read_context": {
            "input_type": "era.tavern.messages.read_context.request",
            "output_type": "era.tavern.messages.read_context.result",
