  "resources": {
    "data_schemas": {
      "era.agent.auxiliary.execution_request": {
        "kind": "data_schema",
        "type_key": "era.agent.auxiliary.execution_request",
        "representation": "json",
        "display_name": "ERA Agent 辅助阶段执行请求",
        "description": "归一化规划与变量结算的角色卡配置、预设脱敏快照和模型来源引用；只允许本机连接方案 ID 与名称提示进入领域 DTO，禁止 URL 与密钥正文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "routedStep",
            "executionState",
            "hostContext",
            "configurationVersion",
            "migrationMode",
            "configuration",
            "stages",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "routedStep": {
              "type": "object",
              "additionalProperties": true
            },
            "executionState": {
              "type": "object",
              "additionalProperties": true
            },
            "hostContext": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "configurationVersion": {
              "oneOf": [
                {
                  "enum": [
                    "1",
                    "2"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "migrationMode": {
              "enum": [
                "not-applicable",
                "v1-preserved",
                "v2"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            },
            "stages": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "enabled",
                  "retryCount",
                  "attempts"
                ],
                "properties": {
                  "stage": {
                    "enum": [
                      "planning",
                      "settlement"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "retryCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "attempts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 17,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "preset",
                        "modelSource"
                      ],
                      "properties": {
                        "preset": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source"
                          ],
                          "properties": {
                            "source": {
                              "enum": [
                                "builtin",
                                "snapshot"
                              ]
                            },
                            "sourceName": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "orderedPrompts": {
                              "type": "array",
                              "maxItems": 256,
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": true
                                  }
                                ]
                              }
                            },
                            "settings": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "modelSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "tavern-current",
                                "custom-profile"
                              ]
                            },
                            "profileId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "profileNameHint": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "model": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            },
                            "legacyModelOverride": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.function_call.result": {
        "kind": "data_schema",
        "type_key": "era.agent.function_call.result",
        "representation": "json",
        "display_name": "ERA Agent 纯函数调用结果",
        "description": "按原调用顺序保存已验证函数、有限数值结果、候选消息 MK 与可重放随机抽取区间。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "messageMk",
            "drawStart",
            "drawEnd",
            "calls",
            "diagnostics"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "planning-exhausted",
                "failed",
                "cancelled"
              ]
            },
            "messageMk": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "drawStart": {
              "type": "integer",
              "minimum": 0
            },
            "drawEnd": {
              "type": "integer",
              "minimum": 0
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "function",
                  "args",
                  "result"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  },
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "result": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      },
      "era.agent.host.request": {
        "kind": "data_schema",
        "type_key": "era.agent.host.request",
        "representation": "json",
        "display_name": "ERA Agent 宿主请求",
        "description": "Service 已决定的有界 Agent 酒馆或模型 I/O 请求；Host 不解释阶段业务。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true
        }
      },
      "era.agent.host.result": {
        "kind": "data_schema",
        "type_key": "era.agent.host.result",
        "representation": "json",
        "display_name": "ERA Agent 宿主结果",
        "description": "Agent Host capability 返回的脱敏、可序列化、有界事实或模型原文。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true
        }
      },
      "era.agent.planning.attempt_result": {
        "kind": "data_schema",
        "type_key": "era.agent.planning.attempt_result",
        "representation": "json",
        "display_name": "ERA 规划尝试结果",
        "description": "保存有界规划尝试、严格故事计划、最多 32 项函数调用表及可定位诊断。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "attempts",
            "storyPlan",
            "calls"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "enum": [
                "ready",
                "exhausted",
                "failed",
                "cancelled"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 17,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "output",
                  "diagnostics"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "output": {
                    "type": "string",
                    "maxLength": 262144
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "storyPlan": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "calls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "function",
                  "args"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      },
      "era.agent.session.context": {
        "kind": "data_schema",
        "type_key": "era.agent.session.context",
        "representation": "json",
        "display_name": "ERA 故事生成会话上下文",
        "description": "Service 从已路由事件与 Host 脱敏投影组合出的有界角色卡、聊天、分支、消息、配置和活动会话上下文。",
        "schema": {
