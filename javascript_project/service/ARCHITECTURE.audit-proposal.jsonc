                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "host-ref"
                            },
                            "token": {
                              "type": "string",
                              "minLength": 1
                            },
                            "refKind": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "token",
                            "refKind"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "encodedBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                },
                "required": [
                  "schemaVersion",
                  "eventId",
                  "sequence",
                  "type",
                  "occurredAt",
                  "source",
                  "args",
                  "encodedBytes"
                ],
                "additionalProperties": false
              }
            },
            "throughSequence": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "route",
            "nextState",
            "batchEvents",
            "throughSequence"
          ],
          "additionalProperties": false
        }
      },
