    "host_extensions": [
      {
        "id": "era.tavern.service_host",
        "status": "planned",
        "display_name": "ERA 酒馆服务宿主",
        "category": "宿主接线",
        "description": "待人工批准的审核副本，禁止用于生产构建。复用现有FIFO、receipt、barrier、Capability和生命周期；修改按楼纯投影的实现归属：将packages/era-floor-snapshot/index.js迁入Service已登记base_lib，snapshot_query直接依赖该纯库，App仍消费由唯一源码发布的同步包；不迁移DOM到Node，不改公开API/Sidecar。新增传统及外置HTML内嵌脚本生命周期检查与关闭后ready续体退出。删除原包手写副本，保留生成出口与声明。详细批次及验收见reports/architecture-audit-20260910/变更清单.md。",
        "version": "0.1.0",
        "targets": [
          "browser"
        ],
        "provides": [
          "vibeflow.port",
          "era.tavern.agent",
          "era.tavern.variables",
          "era.tavern.messages",
          "era.tavern.worldbook",
          "era.tavern.regex",
          "era.tavern.character",
          "era.tavern.identity",
          "era.tavern.sidecar",
          "era.tavern.installation_scope",
          "era.tavern.startup_gate"
        ],
        "dependencies": [],
        "config_keys": [
          "barrier_watchdog_ms",
          "limits",
          "ports",
          "staged_startup"
        ],
        "effect_scope": "trusted"
      }
