          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "step": {
              "type": "object"
            },
            "mk": {
              "type": "string",
              "minLength": 1
            },
            "messageUpdate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "messageId": {
                  "type": "integer",
                  "minimum": 0
                },
