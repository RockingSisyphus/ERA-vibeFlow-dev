      "node:era.tavern.communication.events.take_event": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.communication.events.take_event",
        "display_name": "等下一条已准入事件或实例结束",
        "description": "沿原先进先出队列和容量限制取得最早事件，等待已登记的Service实例号；实例结束时正常结束本循环，不再从队列取新事件。",
        "version": "1.0.0",
