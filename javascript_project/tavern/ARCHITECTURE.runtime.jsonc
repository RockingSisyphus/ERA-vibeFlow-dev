      "node:era.tavern.notification_report_item.empty": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.notification_report_item.empty",
        "display_name": "确认通知组结果已全部检查",
        "description": "通知组所有结果已经按序查看时，标记报告循环结束。后续释放该组资源并完成等待。",
        "version": "0.1.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.notification_finalize.read",
              "cardinality": "exactly_one",
              "display_name": "确认通知组结果已全部检查的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_notification_report_item_empty_frame",
              "type": "era.tavern.frame.notification_report_item.result",
              "display_name": "确认通知组结果已全部检查的处理进度及结果"
            },
            {
              "key": "era_tavern_notification_report_item_empty_done",
              "type": "era.tavern.done.notification_report",
              "display_name": "本轮遍历或职责处理是否已经结束"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.notification_finalize.read": [
              "保留“确认通知组结果已全部检查”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_notification_report_item_empty_frame": [
              "保留“确认通知组结果已全部检查”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "era_tavern_notification_report_item_empty_done": [
              "表示当前清单或长期职责是否已达到结束条件，外层据此继续下一项或退出。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
              "done": "era_tavern_notification_report_item_empty_done",
              "frame": "era_tavern_notification_report_item_empty_frame"
            }
          },
          "examples": []
        },
