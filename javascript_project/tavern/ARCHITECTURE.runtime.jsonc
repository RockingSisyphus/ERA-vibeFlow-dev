          ],
          "era.tavern.call.frame": [
            "保留“管理页面资源直到全部实际清理结束”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
          ]
        },
        "output_semantics": {
          "owned_hold_resources_frame": [
            "记录当前职责一次工作或整个分支已经实际结束，供循环继续或汇合确认。"
          ]
        },
        "params_schema": {
          "outputKeys": {
            "type": "object"
          }
        },
        "params_defaults": {
          "outputKeys": {
            "frame": "owned_hold_resources_frame"
          }
        },
        "examples": []
