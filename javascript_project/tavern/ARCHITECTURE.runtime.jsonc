            {
              "key": "send_request",
              "type": "vibeflow.workflow.send.request",
              "display_name": "目标Service实例、事件端口和纯数据事件"
            },
            {
              "key": "has_event",
              "type": "era.workflow.has_event",
              "display_name": "当前是否取得可交接事件"
            },
            {
              "key": "local_owner",
              "type": "era.workflow.local_owner",
              "display_name": "仅在本图保留的当前页面实例与资源"
            }
          ],
          "input_semantics": {
            "era.workflow.host_resources": [
              "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
