      "node:era.tavern.communication.service.announce_end": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.communication.service.announce_end",
        "display_name": "结束Service并通知通信分支收尾",
        "description": "保留Service终态或错误，要求本实例停止接收新任务，唤醒本地队列等待，并准备投递本runtime的结果接收结束信封。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.workflow.host_resources",
              "cardinality": "exactly_one",
              "display_name": "所属 ERA 实例的本地资源"
            },
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "当前酒馆实例的本地资源与生命周期"
            },
            {
              "type": "era.workflow.terminal",
              "cardinality": "exactly_one",
              "display_name": "Service实际终态"
            }
          ],
          "provides": [
            {
              "key": "send_request",
              "type": "vibeflow.workflow.send.request",
              "display_name": "发往本runtime邮箱的Service结束信封"
            },
            {
              "key": "service_completion",
              "type": "era.workflow.service_completion",
              "display_name": "主服务终态与本实例已有停止意图"
            }
          ],
          "input_semantics": {
            "era.workflow.host_resources": [
              "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
            ],
            "era.tavern.call.frame": [
              "当前酒馆实例的本地资源与生命周期"
            ],
            "era.workflow.terminal": [
              "Service实际终态"
            ]
          },
          "output_semantics": {
            "send_request": [
              "发往本runtime邮箱的Service结束信封"
            ],
            "service_completion": [
              "按实际结束前的资源状态判断是否预期停止，交给最终汇合。"
            ]
          },
