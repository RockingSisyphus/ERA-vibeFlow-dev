      "node:era.workflow.wait_owned": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.workflow.wait_owned",
        "display_name": "等待本次子流程，取消时停止并等清理",
        "description": "等待本步骤拥有的子流程真正结束；若等待因取消或故障中断，明确执行Kill并等子流程清理结束后才退出。单纯旁观其他实例的普通Wait不使用此组合。",
        "version": "1.0.0",
