      "node:era.workflow.send_event": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.workflow.send_event",
        "display_name": "交出事件或确认接收方已结束",
        "description": "通过官方Send交出已经准入的事件。若官方确认目标主服务已经结束，本分支正常收尾，主服务原始终态仍由等待分支判断；其他发送错误继续报告。",
