      "node:era.tavern.notification.emit_notification": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.notification.emit_notification",
        "display_name": "交接已经取得的通知完成结果",
        "description": "接收普通通知或阶段交接已经形成的完成资料，原样传给结果登记步骤。实际通知已经在发起流程执行，此处不会再次发出相同通知。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.notification.choose_notification",
              "cardinality": "exactly_one",
              "display_name": "交接已经取得的通知完成结果的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_notification_emit_notification_frame",
              "type": "era.tavern.frame.notification.emit_notification",
              "display_name": "交接已经取得的通知完成结果的处理进度及结果"
            }
          ],
