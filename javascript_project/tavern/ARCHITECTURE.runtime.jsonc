      "node:era.tavern.timer_wait.await_due": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.timer_wait.await_due",
        "display_name": "等最近期限到达或计时安排改变",
        "description": "等待当前选定期限；新增、更早、替换或取消安排会唤醒本次等待，实例停止也会结束等待。退出时清除实际计时和监听，后续重新选择或处理到期。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "等最近期限到达或计时安排改变的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "timer_wait_await_frame",
              "type": "era.tavern.frame.timer_wait.waited",
              "display_name": "等最近期限到达或计时安排改变的处理进度及结果"
            },
            {
              "key": "timer_wait_await_route",
              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.call.frame": [
              "保留“等最近期限到达或计时安排改变”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "timer_wait_await_frame": [
              "保留“等最近期限到达或计时安排改变”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "timer_wait_await_route": [
              "这是根据本次实际状态选择的处理方向，后续只执行对应的一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
              "frame": "timer_wait_await_frame",
              "route": "timer_wait_await_route"
            }
          },
          "examples": []
        },
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "nodes/timers/wait.ts",
              "export": "AwaitDue"
            },
            "completion": "suspend"
          }
