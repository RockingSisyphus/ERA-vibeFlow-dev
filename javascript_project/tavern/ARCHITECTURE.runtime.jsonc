      "description": "按原通知顺序查看一项完成结果，失败时写出对应告警，成功则继续。说明通知问题不会改写已经完成的状态结算，随后推进报告位置。",
      "version": "0.1.0",
      "flow_kind": "data_store",
      "tags": [],
      "external": false,
      "contract": {
        "requires": [
          {
            "type": "era.tavern.frame.notification_finalize.read",
            "cardinality": "exactly_one",
            "display_name": "报告一条通知的实际失败并继续的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_notification_report_item_report_one_frame",
            "type": "era.tavern.frame.notification_report_item.result",
            "display_name": "报告一条通知的实际失败并继续的处理进度及结果"
          },
          {
            "key": "era_tavern_notification_report_item_report_one_done",
            "type": "era.tavern.done.notification_report",
            "display_name": "本轮遍历或职责处理是否已经结束"
          }
        ],
        "input_semantics": {
          "era.tavern.frame.notification_finalize.read": [
            "保留“报告一条通知的实际失败并继续”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
          ]
        },
        "output_semantics": {
          "era_tavern_notification_report_item_report_one_frame": [
            "保留“报告一条通知的实际失败并继续”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
          ],
          "era_tavern_notification_report_item_report_one_done": [
            "表示当前清单或长期职责是否已达到结束条件，外层据此继续下一项或退出。"
          ]
        },
        "params_schema": {
          "outputKeys": {
            "type": "object"
          }
        },
        "params_defaults": {
          "outputKeys": {
            "done": "era_tavern_notification_report_item_report_one_done",
            "frame": "era_tavern_notification_report_item_report_one_frame"
