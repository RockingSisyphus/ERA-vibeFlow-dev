      "node:era.tavern.communication.service.register": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.communication.service.register",
        "display_name": "登记Service归属并分开运行通信职责",
        "description": "确认绑定层已在Call返回前登记本实例拥有的Service，将实际编号及本地资源交给等待、停止观察、事件交接和结果接收四条普通分支。即使图在Call之后被取消，资源作用域也能停止已登记的子流程并等实际清理。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.workflow.host_resources",
              "cardinality": "exactly_one",
              "display_name": "所属 ERA 实例的本地资源"
            },
            {
              "type": "era.workflow.local_owner",
              "cardinality": "exactly_one",
              "display_name": "仅在本图保留的当前页面实例与资源"
            },
            {
              "type": "era.workflow.instance",
              "cardinality": "exactly_one",
              "display_name": "刚启动的Service实例号"
            }
          ],
          "provides": [
            {
              "key": "frame",
              "type": "era.tavern.call.frame",
              "display_name": "已登记Service实例号的本地实例"
            }
          ],
          "input_semantics": {
            "era.workflow.host_resources": [
              "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
            ],
            "era.workflow.local_owner": [
              "仅在本图保留的当前页面实例与资源"
            ],
            "era.workflow.instance": [
              "刚启动的Service实例号"
            ]
          },
          "output_semantics": {
            "frame": [
              "已登记Service实例号的本地实例"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
