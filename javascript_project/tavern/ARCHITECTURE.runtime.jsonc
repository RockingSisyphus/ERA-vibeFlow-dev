              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.notification.collected": [
              "保留“判断整组通知是否都已结束”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_notification_choose_batch_complete_frame": [
