      "node:era.tavern.communication.service.prepare": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.communication.service.prepare",
        "display_name": "准备唯一主服务的启动输入",
        "description": "确认页面资源已就绪，准备Service启动所需纯数据；宿主能力由同页绑定注入，本地本地实例、函数和释放器不作为Call输入传输。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.workflow.host_resources",
              "cardinality": "exactly_one",
              "display_name": "所属 ERA 实例的本地资源"
            },
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "当前酒馆实例的本地资源与生命周期"
            }
          ],
          "provides": [
            {
              "key": "inputs",
              "type": "era.workflow.wire_inputs",
              "display_name": "启动无业务入参的主服务所需空数据对象"
            },
            {
              "key": "local_owner",
              "type": "era.workflow.local_owner",
              "display_name": "仅在本图保留的当前页面实例与资源"
            }
          ],
          "input_semantics": {
            "era.workflow.host_resources": [
              "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
            ],
            "era.tavern.call.frame": [
              "当前酒馆实例的本地资源与生命周期"
            ]
          },
          "output_semantics": {
            "inputs": [
              "启动无业务入参的主服务所需空数据对象"
            ],
            "local_owner": [
              "仅在本图保留的当前页面实例与资源"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
