      "node:era.tavern.initialize.open_startup_wait": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.initialize.open_startup_wait",
        "display_name": "决定自动启用还是等待安装位置判断",
        "description": "接收新建实例，建立启动决定的等待。自动模式继续启用，分步启动模式等待主服务判断脚本安装位置，让监听与界面按最终决定启用。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.initialize.allocate_session",
              "cardinality": "exactly_one",
              "display_name": "决定自动启用还是等待安装位置判断的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_initialize_open_startup_wait_frame",
              "type": "era.tavern.frame.initialize.open_startup_wait",
              "display_name": "决定自动启用还是等待安装位置判断的处理进度及结果"
            },
            {
              "key": "era_tavern_initialize_open_startup_wait_route",
              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.initialize.allocate_session": [
              "保留“决定自动启用还是等待安装位置判断”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_initialize_open_startup_wait_frame": [
              "保留“决定自动启用还是等待安装位置判断”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "era_tavern_initialize_open_startup_wait_route": [
              "这是根据本次实际状态选择的处理方向，后续只执行对应的一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
