      },
      "era.tavern.message_facts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.message_facts",
        "display_name": "消息投影和固定保存依据",
        "description": "保留原消息投影、陈旧目标比较和保存文件字段核对；不创建任务、不执行保存或调度。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/messages/persistence.ts"
            },
            "completion": "immediate",
            "implementation_files": [
              {
                "kind": "file",
                "ref": "base_lib/messages/projection.ts"
              },
              {
                "kind": "file",
                "ref": "base_lib/messages/target.ts"
              }
            ]
          }
        ],
        "dependencies": [
          "era.tavern.frames",
          "era.tavern.browser"
        ],
        "external_packages": []
      },
      "era.tavern.resources": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.resources",
        "display_name": "Promise、时钟和取消资源原语",
        "description": "创建局部等待句柄、链接取消信号和释放监听；行为顺序仍由 Node 和 Config 决定。",
        "category": "",
        "version": "",
        "implementations": [
