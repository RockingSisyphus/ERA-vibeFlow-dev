              }
            ],
            "input_semantics": {
              "era.workflow.host_resources": [
                "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
              ],
              "era.workflow.instance": [
                "需要等待的流程实例编号"
              ]
            },
            "output_semantics": {
              "terminal": [
                "流程实际终态、结果或错误"
              ]
            },
