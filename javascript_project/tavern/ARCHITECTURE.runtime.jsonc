  "workflow_operations": {
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"call_service\"]": {
      "actions": [
        {
          "operation": "call",
          "wait": false,
          "workflow": {
            "root": "era-service",
            "path": "configs/era.service.jsonc"
          }
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"wait_service\"]": {
      "actions": [
        {
          "operation": "wait"
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"wake_results\"]": {
      "actions": [
        {
          "operation": "send",
          "expected_workflows": [
            {
              "root": "era-tavern",
              "path": "configs/era.tavern.runtime.jsonc",
              "entry": "protocol_runtime"
            }
          ]
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"kill_service\"]": {
      "actions": [
        {
          "operation": "kill",
          "workflow": {
            "root": "era-service",
            "path": "configs/era.service.jsonc"
          }
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"wake_events\"]": {
      "actions": [
        {
          "operation": "send",
          "expected_workflows": [
            {
              "root": "era-tavern",
              "path": "configs/era.tavern.runtime.jsonc",
              "entry": "protocol_runtime"
            }
          ]
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"events\",\"send\"]": {
      "actions": [
        {
          "operation": "send",
          "expected_workflows": [
            {
              "root": "era-service",
              "path": "configs/era.service.jsonc"
            }
          ]
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"events\",\"receive_pull\"]": {
      "actions": [
        {
          "operation": "receive",
          "expected_workflows": [
            {
              "root": "era-service",
              "path": "configs/era.service.jsonc"
            },
            {
              "root": "era-tavern",
              "path": "configs/era.tavern.runtime.jsonc",
              "entry": "protocol_runtime"
            }
          ]
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"results\",\"receive\"]": {
      "actions": [
        {
          "operation": "receive",
          "expected_workflows": [
            {
              "root": "era-service",
              "path": "configs/era.service.jsonc"
            },
            {
              "root": "era-tavern",
              "path": "configs/era.tavern.runtime.jsonc",
              "entry": "protocol_runtime"
            }
          ]
        }
      ]
    },
    "[\"runtime_body\",\"runtime_runtime_scope\",\"service\",\"run_service\",\"results\",\"result_invoke\"]": {
      "actions": [
        {
          "operation": "invoke_sync",
          "workflow": {
            "root": "era-tavern",
            "path": "configs/era.tavern.sync.jsonc",
            "entry": "protocol"
          }
        }
      ]
    }
  },
