  "lifecycle": [
    {
      "action": "initialize",
      "workflow": "configs/era.tavern.sync.jsonc"
    },
    {
      "action": "event",
      "workflow": "configs/era.tavern.sync.jsonc"
    },
    {
      "action": "admit",
      "workflow": "configs/era.tavern.sync.jsonc"
    },
    {
      "action": "stop_accepting",
      "workflow": "configs/era.tavern.sync.jsonc"
    },
    {
      "action": "diagnostics",
      "workflow": "configs/era.tavern.sync.jsonc"
    },
    {
      "action": "wait_through",
      "workflow": "configs/era.tavern.async.jsonc"
    },
    {
      "action": "stop",
      "workflow": "configs/era.tavern.async.jsonc"
    }
  ],
  "mechanical_sequence": "各函数配方固定调用同步 AOT；仅真实等待操作转交同实例 prepared frame 给异步 AOT。同步完成的 suspend 接口由生成 async 函数转交结果/异常；不在接线中判断分支或管理资源。",
  "port_recipes": {
    "receive": {
      "prepare_action": "prepare_receive",
      "resume_action": "receive"
    },
    "waitThrough": {
      "prepare_action": "prepare_wait_through",
      "resume_action": "wait_through"
    },
    "stop": {
      "prepare_action": "prepare_stop",
      "resume_action": "stop"
    }
  },
  "model_completion_callback": {
    "status": "planned",
    "trigger": "raw_model_terminal",
    "first": {
      "workflow": "configs/era.tavern.sync.jsonc",
      "action": "auxiliary_terminal"
    },
    "then": {
      "workflow": "configs/era.tavern.async.jsonc",
      "forward": "completed_prepared_frame",
      "action": "capability"
    },
    "policy": "generated_parameter_forwarding_only; public cancellation does not invoke the terminal callback"
  },
  "capability_completion_callback": {
    "status": "planned",
    "trigger": "raw_operation_terminal",
    "workflow": "configs/era.tavern.async.jsonc",
    "forward": "same_prepared_frame",
    "policy": "generated_parameter_forwarding_only; public cancellation does not discard the raw result or execute a Node implementation directly"
  },
  "function_context_callbacks": {
    "status": "planned",
    "lookup": {
      "workflow": "configs/era.tavern.sync.jsonc",
      "action": "function_submit",
      "input_mode": "context"
    },
    "submit": {
      "workflow": "configs/era.tavern.sync.jsonc",
      "action": "function_submit",
      "input_mode": "submit"
    },
    "abort_release": {
      "workflow": "configs/era.tavern.sync.jsonc",
      "action": "function_release"
    },
    "policy": "generated_parameter_forwarding_only; instance context table and validation owned by native Nodes"
  },
  "subscription_callbacks": {
    "status": "planned",
    "control": {
      "workflow": "configs/era.tavern.sync.jsonc",
      "action": "subscription_control"
    },
    "publish": {
      "workflow": "configs/era.tavern.async.jsonc",
      "action": "subscription_publish"
    },
    "policy": "generated_parameter_forwarding_only; resources and sequential listener scheduling owned by native Nodes and Loop"
  },
  "generation_receipt_callback": {
    "status": "planned",
    "workflow": "configs/era.tavern.async.jsonc",
    "action": "generation_receipt",
    "policy": "native receipt and handoff wait; no then/branch policy in generated binding"
  },
  "handoff_callback": {
    "status": "planned",
    "workflow": "configs/era.tavern.async.jsonc",
    "action": "generation_handoff",
    "policy": "fixed native workflow invocation; public notification cancellation does not discard raw handoff continuation"
  },
  "startup_wait_callback": {
    "status": "planned",
    "workflow": "configs/era.tavern.async.jsonc",
    "action": "wait_startup",
    "policy": "fixed native startup wait; no Promise/resource management in App binding"
  },
