              "key": "subscription_cycle_advance_done",
              "type": "era.tavern.subscription_cycle.done",
              "display_name": "本轮遍历或职责处理是否已经结束"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.subscription_cycle.classified": [
