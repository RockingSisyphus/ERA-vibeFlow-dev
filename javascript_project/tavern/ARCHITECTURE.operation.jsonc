      "node:era.tavern.functions_next_finish.choose_ready": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.functions_next_finish.choose_ready",
        "display_name": "判断作者结果已取得还是继续等待",
        "description": "查看同步检查是否已拿到作者请求或结束结果。已经取得时直接交出，没有则进入等待循环，保持一次等待只返回当前实际结果。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "判断作者结果已取得还是继续等待的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_functions_next_finish_choose_ready_frame",
              "type": "era.tavern.call.frame.next_state",
              "display_name": "判断作者结果已取得还是继续等待的处理进度及结果"
            },
            {
              "key": "era_tavern_functions_next_finish_choose_ready_route",
              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.call.frame": [
              "保留“判断作者结果已取得还是继续等待”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_functions_next_finish_choose_ready_frame": [
              "保留“判断作者结果已取得还是继续等待”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "era_tavern_functions_next_finish_choose_ready_route": [
              "这是根据本次实际状态选择的处理方向，后续只执行对应的一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
              "frame": "era_tavern_functions_next_finish_choose_ready_frame",
              "route": "era_tavern_functions_next_finish_choose_ready_route"
            }
