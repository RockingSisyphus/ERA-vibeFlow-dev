      "declaration": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.boundary.async.protocol_operation_decode",
        "display_name": "恢复异步操作请求与本实例资源",
        "description": "核对本实例资源编号和请求身份，恢复消息中的原始业务值，并取回本次操作所属的本地资源。异步入口以操作编号取回已经发起的工作，不重新发起IO。 标记本次结果须走通信回信；随后把请求交给两个入口共用的处理节点。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.workflow.host_resources",
              "cardinality": "exactly_one",
              "display_name": "所属 ERA 实例的本地资源"
            },
            {
              "type": "era.workflow.packet",
              "cardinality": "exactly_one",
              "display_name": "保留原值的跨流程请求消息"
            }
          ],
          "provides": [
            {
              "key": "frame",
              "type": "era.tavern.call.frame",
              "display_name": "恢复原值并关联本地资源的酒馆请求"
            },
            {
              "key": "entry_return",
              "type": "era.workflow.entry_return",
              "display_name": "直接返回或通信回信"
            },
            {
              "key": "protocol_resources",
              "type": "era.tavern.return_resources",
              "display_name": "本次入口的回信资源"
            }
          ],
          "input_semantics": {
            "era.workflow.host_resources": [
              "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
            ],
            "era.workflow.packet": [
              "保留原值的跨流程请求消息"
            ]
          },
          "output_semantics": {
            "frame": [
              "恢复原值并关联本地资源的酒馆请求"
            ],
            "entry_return": [
              "直接返回或通信回信"
            ],
            "protocol_resources": [
              "协议入口传入所属实例的本地资源；直接入口按原合同返回结果时不使用回信资源。"
            ]
          },
          "params_schema": {
            "mode": {
              "type": "string"
            },
            "boundary": {
