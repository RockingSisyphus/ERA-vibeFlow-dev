              "key": "era_tavern_generation_handoff_finish_rejected_frame",
              "type": "era.tavern.frame.generation_handoff.await_followup",
              "display_name": "记录主服务拒绝阶段继续的原因的处理进度及结果"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.generation_handoff.admit_continue": [
