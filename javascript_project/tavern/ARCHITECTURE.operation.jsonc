        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.subscription_cycle.advance",
        "display_name": "结束本项回调登记并转到下一订阅",
        "description": "移除当前订阅对本周期的等待关联，推进到下一回调位置。外层循环据此继续，保持作者订阅的先后顺序。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
