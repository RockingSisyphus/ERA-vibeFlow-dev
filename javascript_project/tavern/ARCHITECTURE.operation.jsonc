    "era.tavern.cap_async_agent.choose": {
      "kind": "node",
      "node_type": "vibeflow.node",
      "id": "era.tavern.cap_async_agent.choose",
      "display_name": "选择模型生成和生成设置的具体操作",
      "description": "接收模型生成和生成设置请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
      "version": "0.1.0",
      "flow_kind": "decision",
      "tags": [],
      "external": false,
      "contract": {
        "requires": [
          {
            "type": "era.tavern.call.frame",
