      "node:era.tavern.generation_receipt.await_handoff": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.generation_receipt.await_handoff",
        "display_name": "等待重试引起的完整阶段交接",
        "description": "根据重试结果中的阶段身份，等待规划、正文或结算的后续交接结束。取得最终结果或无结果状态，供公开重试调用返回。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.generation_receipt.chosen",
              "cardinality": "exactly_one",
              "display_name": "等待重试引起的完整阶段交接的请求和已有进度"
            }
          ],
          "provides": [
