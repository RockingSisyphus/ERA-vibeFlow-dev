      "node:era.tavern.functions_next_wait_request_item.take_request": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.functions_next_wait_request_item.take_request",
        "display_name": "取出作者提交的下一项操作",
        "description": "从当前函数请求队列取出最早一项，交出操作编号、种类和内容，并标记本轮等待已取得结果。主服务随后在消息位置执行并确认。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.functions_next_wait_request_item.chosen",
              "cardinality": "exactly_one",
              "display_name": "取出作者提交的下一项操作的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_functions_next_wait_request_item_take_request_frame",
              "type": "era.tavern.frame.functions_next_wait_request_item.result",
              "display_name": "取出作者提交的下一项操作的处理进度及结果"
            },
            {
              "key": "era_tavern_functions_next_wait_request_item_take_request_done",
              "type": "era.tavern.done.functions_next.wait_request",
              "display_name": "本轮遍历或职责处理是否已经结束"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.functions_next_wait_request_item.chosen": [
              "保留“取出作者提交的下一项操作”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_functions_next_wait_request_item_take_request_frame": [
              "保留“取出作者提交的下一项操作”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "era_tavern_functions_next_wait_request_item_take_request_done": [
              "表示当前清单或长期职责是否已达到结束条件，外层据此继续下一项或退出。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
              "done": "era_tavern_functions_next_wait_request_item_take_request_done",
              "frame": "era_tavern_functions_next_wait_request_item_take_request_frame"
            }
