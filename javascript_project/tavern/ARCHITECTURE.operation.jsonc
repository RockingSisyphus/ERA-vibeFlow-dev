        "era.tavern.boundary.async.protocol_operation_decode": {
          "kind": "node",
          "node_type": "vibeflow.node",
          "id": "era.tavern.boundary.async.protocol_operation_decode",
          "display_name": "恢复异步操作请求与本实例资源",
          "description": "核对本实例资源编号和请求身份，恢复消息中的原始业务值，并取回本次操作所属的本地资源。异步入口以操作编号取回已经发起的工作，不重新发起IO。 标记本次结果须走通信回信；随后把请求交给两个入口共用的处理节点。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [],
          "external": false,
          "contract": {
            "requires": [
