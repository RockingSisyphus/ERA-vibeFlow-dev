    "era.tavern.barrier_wait.cleanup_watchdog": {
      "kind": "node",
      "node_type": "vibeflow.node",
      "id": "era.tavern.barrier_wait.cleanup_watchdog",
      "display_name": "等待结束后清理提醒和已消费失败",
      "description": "事件等待结束后取消对应告警；仅生成屏障消费其已报告范围内的失败，普通状态读取保留这些记录供生成前报告。仅生成屏障将同一次仍处于准备阶段的候选标记为正在生成，随后由宿主接手。计时告警不提前放行等待。",
      "version": "0.1.0",
      "flow_kind": "data_store",
      "tags": [],
      "external": false,
      "contract": {
        "requires": [
          {
            "type": "era.tavern.frame.barrier_wait.await_handoff",
            "cardinality": "exactly_one",
            "display_name": "等待结束后清理提醒和已消费失败的请求和已有进度"
          }
        ],
