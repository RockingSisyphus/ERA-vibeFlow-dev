      "node:era.tavern.cap_async_worldbook.choose": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.cap_async_worldbook.choose",
        "display_name": "选择世界书的具体操作",
        "description": "接收世界书请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "version": "0.1.0",
        "flow_kind": "decision",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "选择世界书的具体操作的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_cap_async_worldbook_choose_frame",
              "type": "era.tavern.call.frame",
              "display_name": "选择世界书的具体操作的处理进度及结果"
            },
            {
              "key": "era_tavern_cap_async_worldbook_choose_route",
              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.call.frame": [
              "保留“选择世界书的具体操作”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_cap_async_worldbook_choose_frame": [
              "保留“选择世界书的具体操作”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "era_tavern_cap_async_worldbook_choose_route": [
              "这是根据本次实际状态选择的处理方向，后续只执行对应的一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            },
            "operations": {
