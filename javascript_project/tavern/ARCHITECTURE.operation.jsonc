            }
          ],
          "input_semantics": {
            "era.tavern.frame.messages_update_content.update_messages": [
              "保留“确认仍在原聊天后保存消息”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "era_tavern_messages_update_content_await_persistence_frame": [
