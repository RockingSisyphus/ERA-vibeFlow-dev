            ],
            "era.tavern.frame.subscription_cycle.report_error": [
              "保留“结束本项回调登记并转到下一订阅”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "subscription_cycle_advance_frame": [
              "保留“结束本项回调登记并转到下一订阅”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "subscription_cycle_advance_done": [
              "表示当前清单或长期职责是否已达到结束条件，外层据此继续下一项或退出。"
            ]
          },
          "params_schema": {
            "outputKeys": {
