      "node:era.tavern.boundary.async.protocol_operation_encode": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.boundary.async.protocol_operation_encode",
        "display_name": "封装异步操作结果，保留原值再回信",
        "description": "从本次业务结果中取出应返回调用方的资料；实际异步工作尚未完成时只交回其操作编号。页面实例、回调、运行中的任务和清理函数留在资源作用域，其他业务值作可逆封装后返回，不把空位改为null或把大数改成业务字符串。 图上可见的直接返回路径不提供通信资源。只有选中协议回信时才执行本节点，并核对该入口提供的本地资源。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.return_resources",
              "cardinality": "exactly_one",
              "display_name": "本次入口的回信资源"
            },
            {
              "type": "era.tavern.call.result",
              "cardinality": "exactly_one",
              "display_name": "本次业务流程实际返回的结果"
            }
          ],
          "provides": [
            {
              "key": "packet",
              "type": "era.workflow.packet",
              "display_name": "保留业务原值且不携带页面资源的结果消息"
            }
          ],
          "input_semantics": {
            "era.tavern.call.result": [
              "本次业务流程实际返回的结果"
            ],
            "era.tavern.return_resources": [
              "协议入口传入所属实例的本地资源；直接入口按原合同返回结果时不使用回信资源。"
            ]
          },
          "output_semantics": {
            "packet": [
              "保留业务原值且不携带页面资源的结果消息"
            ]
          },
          "params_schema": {
            "mode": {
              "type": "string"
            },
            "boundary": {
              "type": "string"
            }
          },
          "params_defaults": {
            "mode": "sync",
            "boundary": "protocol_decode"
          },
          "examples": []
        },
