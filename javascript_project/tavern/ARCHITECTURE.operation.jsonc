              "ref": "base_lib/messages/persistence.ts"
            },
            "completion": "immediate",
            "implementation_files": [
              {
                "kind": "file",
                "ref": "base_lib/messages/projection.ts"
              },
              {
                "kind": "file",
                "ref": "base_lib/messages/target.ts"
              }
            ]
          }
        ],
        "dependencies": [
          "era.tavern.frames",
          "era.tavern.browser"
        ],
        "external_packages": []
      },
      "era.tavern.receipts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.receipts",
        "display_name": "单个回执资源结算",
        "description": "原子结算当前明确指定的回执、释放其引用并触发回调；选择与遍历仍由 Node 和原生 Loop 执行。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/receipts.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [
          "era.tavern.frames"
        ],
        "external_packages": []
      },
      "era.tavern.resources": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.resources",
        "display_name": "Promise、时钟和取消资源原语",
        "description": "创建局部等待句柄、链接取消信号和释放监听；行为顺序仍由 Node 和 Config 决定。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/resources.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": []
      },
      "era.tavern.sidecar_facts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.sidecar_facts",
        "display_name": "Sidecar 身份、文件名与快照投影",
        "description": "只验证输入记录、形成文件路径和快照；状态存储和发布由具体 Node 执行。",
        "category": "",
        "version": "",
        "implementations": [
