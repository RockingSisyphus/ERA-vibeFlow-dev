            ]
          },
          "output_semantics": {
            "era_tavern_generation_handoff_finish_rejected_frame": [
              "保留“记录主服务拒绝阶段继续的原因”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ]
