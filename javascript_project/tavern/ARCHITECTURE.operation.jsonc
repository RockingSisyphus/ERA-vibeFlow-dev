              },
              {
                "type": "era.workflow.packet",
                "cardinality": "exactly_one",
                "display_name": "保留原值的跨流程请求消息"
              }
            ],
            "provides": [
              {
                "key": "frame",
                "type": "era.tavern.call.frame",
                "display_name": "恢复原值并关联本地资源的酒馆请求"
              },
              {
                "key": "entry_return",
                "type": "era.workflow.entry_return",
                "display_name": "直接返回或通信回信"
              },
              {
                "key": "protocol_resources",
                "type": "era.tavern.return_resources",
                "display_name": "本次入口的回信资源"
              }
            ],
            "input_semantics": {
              "era.workflow.host_resources": [
                "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
              ],
              "era.workflow.packet": [
                "保留原值的跨流程请求消息"
              ]
            },
            "output_semantics": {
              "frame": [
                "恢复原值并关联本地资源的酒馆请求"
