    "base_lib": {
      "era.tavern.agent_facts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.agent_facts",
        "display_name": "Agent 配置、预设与脱敏连接事实",
        "description": "只验证输入和投影当前资料；设置读写、密钥使用和 HTTP 请求由具体 Node 执行。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/agent/facts.ts"
            },
            "completion": "immediate",
            "implementation_files": [
              {
                "kind": "file",
                "ref": "base_lib/agent/profiles.ts"
              }
            ]
          }
        ],
        "dependencies": [
          "era.tavern.browser"
        ],
        "external_packages": []
      },
      "era.tavern.browser": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.browser",
        "display_name": "原始酒馆 API 与数据投影原语",
        "description": "发现同一个真实酒馆宿主、转换原始数据，并将原生设置保存通知转为可取消的实际IO等待；不持有会话、任务或调度机制。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/browser.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": []
      },
      "era.tavern.contracts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.tavern.contracts",
        "display_name": "ERA 既有传输合同",
        "description": "复用官方 DTO 校验和默认限额，不复制合同。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/contracts.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": [
          "@era/vibeflow-contracts"
        ]
      },
      "era.tavern.frames": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.frames",
        "display_name": "辅助流程内部输入与错误合同",
        "description": "解包调用、严格汇合单结果及规范化错误；不选择或调度业务路径。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/frames.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": []
      },
      "era.tavern.message_facts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.message_facts",
        "display_name": "消息投影和固定保存依据",
        "description": "保留原消息投影、陈旧目标比较和保存文件字段核对；不创建任务、不执行保存或调度。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
