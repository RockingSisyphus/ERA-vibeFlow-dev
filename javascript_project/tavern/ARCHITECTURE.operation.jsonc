      "node:era.tavern.generation_receipt.choose": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.generation_receipt.choose",
        "display_name": "判断重试是否还需要等生成阶段",
        "description": "查看原重试处理结果是否带有阶段完成身份。有则继续等完整阶段交接，没有则直接返回原确认，避免把一个片段完成误认为整次生成结束。",
        "version": "0.1.0",
        "flow_kind": "decision",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.generation_receipt.await_receipt",
              "cardinality": "exactly_one",
              "display_name": "判断重试是否还需要等生成阶段的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "generation_receipt_choose_frame",
              "type": "era.tavern.frame.generation_receipt.chosen",
              "display_name": "判断重试是否还需要等生成阶段的处理进度及结果"
            },
            {
              "key": "generation_receipt_choose_route",
              "type": "era.tavern.route",
              "display_name": "按当前事实选出的处理方向"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.generation_receipt.await_receipt": [
              "保留“判断重试是否还需要等生成阶段”对应的实例、请求及已经形成的进度，供本步骤处理并延续同一次请求。"
            ]
          },
          "output_semantics": {
            "generation_receipt_choose_frame": [
              "保留“判断重试是否还需要等生成阶段”对应的实例、请求及已经形成的进度，交给后续处理或结果返回。"
            ],
            "generation_receipt_choose_route": [
              "这是根据本次实际状态选择的处理方向，后续只执行对应的一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
