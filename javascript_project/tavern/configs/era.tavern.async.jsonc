  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/contracts/plugin.ts"
      }
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_host_refs_per_event": 32,
      "barrier_watchdog_ms": 5000
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "request",
        "type": "era.tavern.call.frame",
        "display_name": "酒馆异步操作与实例运行的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 19,
    "nodes": [
      {
        "id": "begin",
        "display_name": "接收需要等待的酒馆操作",
        "description": "在“酒馆异步操作与实例运行”流程中，接收本次需要等待完成的酒馆请求及所属实例，将原参数交给操作选择。后续分别执行事件接收、生成等待或已发起请求的结果处理。",
        "definition_id": "era.tavern.entry_async.begin"
      },
      {
        "id": "choose",
        "display_name": "按请求选择需要等待的操作",
        "description": "在“酒馆异步操作与实例运行”流程中，识别本次请求需要接收事件、等待生成前处理、阶段交接、实例运行，还是接续酒馆读写。将请求交给对应异步流程，未知或没有等待路径的操作返回原因。",
        "definition_id": "era.tavern.async_entry.choose"
      },
      {
        "id": "route_receive",
        "display_name": "向主服务交付下一条有效事件",
        "description": "本环节用于“酒馆异步操作与实例运行”：检查实例和事件通道，队列有内容就取最早一项，没有则登记并等待。取消或实例关闭时结束等待，成功时将事件交给主服务做业务判断。",
        "definition_id": "era.tavern.flow.frame_receive"
      },
      {
        "id": "route_wait_through",
        "display_name": "等待相关事件和生成阶段交接完成",
        "description": "本环节用于“酒馆异步操作与实例运行”：等待指定序号及之前的事件处理结束，汇总失败并按生成等待规则报告，再按实际结论等待阶段交接。最后清理告警和已消费失败记录；等待报告异常会记录原因并按现有分支收尾。",
        "definition_id": "era.tavern.flow.barrier_wait"
      },
      {
        "id": "route_cap_agent",
        "display_name": "完成模型生成和生成设置操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的模型生成和生成设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_agent"
      },
      {
        "id": "route_cap_character",
        "display_name": "完成角色卡和显示设置操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的角色卡和显示设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_character"
      },
      {
        "id": "route_cap_functions",
        "display_name": "完成消息中的作者函数操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的消息中的作者函数操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_functions"
      },
      {
        "id": "route_cap_messages",
        "display_name": "完成聊天消息操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的聊天消息操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_messages"
      },
      {
        "id": "route_cap_regex",
        "display_name": "完成角色正则规则操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的角色正则规则操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_regex"
      },
      {
        "id": "route_cap_sidecar",
        "display_name": "完成独立状态文件和变量快照操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的独立状态文件和变量快照操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_sidecar"
      },
      {
        "id": "route_cap_worldbook",
        "display_name": "完成世界书操作",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收已经发起、需要等待的世界书操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.flow.cap_async_worldbook"
      },
      {
        "id": "join_return",
        "display_name": "交接酒馆异步操作的选中结果",
        "description": "在“酒馆异步操作与实例运行”流程中，在“酒馆异步操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.era_tavern_async.join_return"
      },
      {
        "id": "route_subscription_publish",
        "display_name": "将阶段结果依次交给作者回调",
        "description": "本环节用于“酒馆异步操作与实例运行”：接收本次已经捕获的订阅周期，准备同一份只读阶段结果，按原顺序执行有效回调。最后解除周期登记，并返回阶段是否仍可继续，供生成交接使用。",
        "definition_id": "era.tavern.flow.subscription_publish"
      },
      {
        "id": "route_generation_receipt",
        "display_name": "等待用户重试引起的完整生成结果",
        "description": "本环节用于“酒馆异步操作与实例运行”：先等原重试事件处理确认，有阶段交接时继续等待规划、正文或结算的最终结果。结束时保留原请求身份；会话已取消则向原发起者返回取消。",
        "definition_id": "era.tavern.flow.generation_receipt"
      },
      {
        "id": "route_generation_handoff",
        "display_name": "在阶段订阅结束后接续整次生成",
        "description": "本环节用于“酒馆异步操作与实例运行”：检查阶段仍有效，等待作者订阅回调，再向主服务提交继续或取消并等待结果。需要后续阶段时继续跟随其交接；失效、取消或失败按真实结论结束，最后移除本阶段记录。",
        "definition_id": "era.tavern.flow.generation_handoff"
      },
      {
        "id": "route_wait_startup",
        "display_name": "等待主服务给出启用或休眠决定",
        "description": "在“酒馆异步操作与实例运行”流程中，等待已经建立的启动判断结果，支持取消。主服务完成安装位置判断后，调用方得到本实例应启用或休眠的实际结论。",
        "definition_id": "era.tavern.initialize.wait_startup"
      },
      {
        "id": "return",
        "display_name": "返回本次异步酒馆操作结果",
        "description": "在“酒馆异步操作与实例运行”流程中，接收事件等待、阶段交接或具体酒馆操作实际完成后的唯一结果，交给本次异步请求出口。调用方据此结束等待并继续业务。",
        "definition_id": "era.tavern.async_entry.return"
      },
      {
        "id": "finish",
        "display_name": "交出异步酒馆请求的最终结果",
        "description": "在“酒馆异步操作与实例运行”流程中，将所选酒馆操作在等待完成后得到的结果返回外部调用方。生成、消息保存或事件等待各自的实际结论都由其处理分支提供。",
        "definition_id": "era.tavern.entry_async.finish"
      },
      {
        "id": "runtime_begin",
        "display_name": "接收本次 ERA 实例运行资料",
        "description": "在“酒馆异步操作与实例运行”流程中，接收已经建立的 ERA 实例，交给五条长期职责分支共同运行。资源、主服务、作者、通知和计时都属于这一实例。",
        "definition_id": "era.tavern.entry_runtime.begin"
      },
      {
        "id": "runtime_initialize_script",
        "display_name": "建立当前页面的 ERA 运行实例",
        "description": "本环节用于“酒馆异步操作与实例运行”：读取容量和告警设置，建立事件、生成和资源运行资料，以及脚本启用决定的等待。返回同一实例给后续启动和操作使用，长期监听与清理由运行职责分支负责。",
        "definition_id": "era.tavern.flow.initialize"
      },
      {
        "id": "runtime_bind_script_session",
        "display_name": "把当前实例交给主服务的酒馆操作入口",
        "description": "在“酒馆异步操作与实例运行”流程中，将本次已准备的实例关联到主服务使用的酒馆操作入口。后续消息、变量和生成请求都使用这份实例资料，保证事件队列和资源归属一致。",
        "definition_id": "era.tavern.owned.bind_script_session"
      },
      {
        "id": "runtime_runtime_scope",
        "display_name": "协同运行五条职责并统一等待退出",
        "description": "本环节用于“酒馆异步操作与实例运行”：让同一实例的资源管理、主服务、串行作者调用、通知收尾和计时等待共同运行。任一停止要求触发统一清理，末尾等五条分支都实际退出才返回实例停止确认。",
        "definition_id": "era.tavern.flow.ordinary_runtime"
      },
      {
        "id": "runtime_finish",
        "display_name": "返回实例全部停止的确认",
        "description": "在“酒馆异步操作与实例运行”流程中，五条长期职责分支及实际资源清理已经结束后，返回本实例已停止的确认。调用方据此知道这次运行已经退出。",
        "definition_id": "era.tavern.entry_runtime.finish"
      }
    ],
    "edges": [
      [
        "begin",
        "choose"
      ],
      {
        "from": "choose",
        "to": "route_receive",
        "when": "era_tavern_async_entry_choose_route == 'receive'"
      },
      [
        "route_receive",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_wait_through",
        "when": "era_tavern_async_entry_choose_route == 'wait_through'"
      },
      [
        "route_wait_through",
        "join_return"
      ],
      [
        "return",
        "finish"
      ],
      [
        "join_return",
        "return"
      ],
      {
        "from": "choose",
        "to": "route_cap_agent",
        "when": "era_tavern_async_entry_choose_route == 'cap_agent'"
      },
      [
        "route_cap_agent",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_character",
        "when": "era_tavern_async_entry_choose_route == 'cap_character'"
      },
      [
        "route_cap_character",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_functions",
        "when": "era_tavern_async_entry_choose_route == 'cap_functions'"
      },
      [
        "route_cap_functions",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_messages",
        "when": "era_tavern_async_entry_choose_route == 'cap_messages'"
      },
      [
        "route_cap_messages",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_regex",
        "when": "era_tavern_async_entry_choose_route == 'cap_regex'"
      },
      [
        "route_cap_regex",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_sidecar",
        "when": "era_tavern_async_entry_choose_route == 'cap_sidecar'"
      },
      [
        "route_cap_sidecar",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_cap_worldbook",
        "when": "era_tavern_async_entry_choose_route == 'cap_worldbook'"
      },
      [
        "route_cap_worldbook",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_subscription_publish",
        "when": "era_tavern_async_entry_choose_route == 'subscription_publish'"
      },
      [
        "route_subscription_publish",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_generation_receipt",
        "when": "era_tavern_async_entry_choose_route == 'generation_receipt'"
      },
      [
        "route_generation_receipt",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_generation_handoff",
        "when": "era_tavern_async_entry_choose_route == 'generation_handoff'"
      },
      [
        "route_generation_handoff",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_wait_startup",
        "when": "era_tavern_async_entry_choose_route == 'wait_startup'"
      },
      [
        "route_wait_startup",
        "join_return"
      ],
      [
        "runtime_begin",
        "runtime_initialize_script"
      ],
      [
        "runtime_initialize_script",
        "runtime_bind_script_session"
      ],
      [
        "runtime_bind_script_session",
        "runtime_runtime_scope"
      ],
      [
        "runtime_runtime_scope",
        "runtime_finish"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.result",
        "cardinality": "exactly_one",
        "display_name": "本次酒馆操作返回给调用方的结果",
        "as": "result"
      }
    ],
    "entries": {
      "operation": {
        "start": "begin"
      },
      "runtime": {
        "start": "runtime_begin"
      }
    }
  },
  "base_lib": {
    "modules": [
      "era.tavern.agent_facts",
      "era.tavern.browser",
      "era.tavern.contracts",
      "era.tavern.frames",
      "era.tavern.message_facts",
      "era.tavern.receipts",
      "era.tavern.resources",
      "era.tavern.sidecar_facts"
    ]
  }
}
