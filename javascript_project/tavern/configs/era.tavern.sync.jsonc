{
  "nodeset_imports": [
    {
      "path": "nodesets/activate.jsonc"
    },
    {
      "path": "nodesets/admission.jsonc"
    },
    {
      "path": "nodesets/agent_generate.jsonc"
    },
    {
      "path": "nodesets/agent_generate_story.jsonc"
    },
    {
      "path": "nodesets/agent_write_session.jsonc"
    },
    {
      "path": "nodesets/barrier_prefix.jsonc"
    },
    {
      "path": "nodesets/cap_sync_admission.jsonc"
    },
    {
      "path": "nodesets/cap_sync_agent.jsonc"
    },
    {
      "path": "nodesets/cap_sync_character.jsonc"
