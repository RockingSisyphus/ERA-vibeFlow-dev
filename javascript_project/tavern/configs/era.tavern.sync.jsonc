{
  "nodeset_imports": [
    {
      "path": "nodesets/activate.jsonc"
    },
    {
      "path": "nodesets/admission.jsonc"
    },
    {
      "path": "nodesets/agent_generate.jsonc"
    },
    {
      "path": "nodesets/agent_generate_story.jsonc"
    },
    {
      "path": "nodesets/agent_write_session.jsonc"
    },
    {
      "path": "nodesets/barrier_prefix.jsonc"
    },
    {
      "path": "nodesets/cap_sync_admission.jsonc"
    },
    {
      "path": "nodesets/cap_sync_agent.jsonc"
    },
    {
      "path": "nodesets/cap_sync_character.jsonc"
    },
    {
      "path": "nodesets/cap_sync_functions.jsonc"
    },
    {
      "path": "nodesets/cap_sync_identity.jsonc"
    },
    {
      "path": "nodesets/cap_sync_installation_scope.jsonc"
    },
    {
      "path": "nodesets/cap_sync_messages.jsonc"
    },
    {
      "path": "nodesets/cap_sync_regex.jsonc"
    },
    {
      "path": "nodesets/cap_sync_sidecar.jsonc"
    },
    {
      "path": "nodesets/cap_sync_startup_gate.jsonc"
    },
    {
      "path": "nodesets/cap_sync_variables.jsonc"
    },
    {
      "path": "nodesets/cap_sync_worldbook.jsonc"
    },
    {
      "path": "nodesets/collection_control.jsonc"
    },
    {
      "path": "nodesets/collection_control_apply_commands_item.jsonc"
    },
    {
      "path": "nodesets/diagnostics.jsonc"
    },
    {
      "path": "nodesets/event_ingress.jsonc"
    },
    {
      "path": "nodesets/frame_send.jsonc"
    },
    {
      "path": "nodesets/function_submit.jsonc"
    },
    {
      "path": "nodesets/functions_begin.jsonc"
    },
    {
      "path": "nodesets/functions_next_capture.jsonc"
    },
    {
      "path": "nodesets/functions_release.jsonc"
    },
    {
      "path": "nodesets/functions_release_reject_pending_item.jsonc"
    },
    {
      "path": "nodesets/initialize.jsonc"
    },
    {
      "path": "nodesets/messages_refresh.jsonc"
    },
    {
      "path": "nodesets/messages_update_content.jsonc"
    },
    {
      "path": "nodesets/messages_update_content_update_messages_item.jsonc"
    },
    {
      "path": "nodesets/native_stop_retry.jsonc"
    },
    {
      "path": "nodesets/notification_start_item.jsonc"
    },
    {
      "path": "nodesets/settlement.jsonc"
    },
    {
      "path": "nodesets/settlement_settle_receipts_item.jsonc"
    },
    {
      "path": "nodesets/sidecar_commit_metadata.jsonc"
    },
    {
      "path": "nodesets/sidecar_write_record.jsonc"
    },
    {
      "path": "nodesets/stop_accepting.jsonc"
    },
    {
      "path": "nodesets/stop_cancel_receipts_item.jsonc"
    },
    {
      "path": "nodesets/stop_prefix.jsonc"
    },
    {
      "path": "nodesets/subscription_control.jsonc"
    },
    {
      "path": "nodesets/timer_control.jsonc"
    },
    {
      "path": "nodesets/timer_fired.jsonc"
    },
    {
      "path": "nodesets/variables_commit.jsonc"
    },
    {
      "path": "nodesets/workflow_sync_main_body.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/contracts/plugin.ts"
      }
    },
    {
      "scope": "project",
      "source": {
        "kind": "file",
        "ref": "plugins/workflow_protocol/plugin.ts"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/structure_rules/plugin.ts"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/protocol_resources/plugin.ts"
      }
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_host_refs_per_event": 32,
      "barrier_watchdog_ms": 5000
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "request",
        "type": "era.tavern.call.frame",
        "display_name": "酒馆即时操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.result",
        "cardinality": "exactly_one",
        "display_name": "本次酒馆操作返回给调用方的结果",
        "as": "result"
      }
    ],
    "entries": {
      "main": {
        "start": "start"
      },
      "protocol": {
        "start": "protocol_start",
        "inputs": [
          {
            "key": "wire_request",
            "type": "era.workflow.packet",
            "display_name": "保留原值的跨流程请求消息",
            "required": true
          },
          {
            "key": "host_resources",
            "type": "era.workflow.host_resources",
            "required": true,
            "display_name": "所属 ERA 实例的本地资源"
          }
        ],
        "outputs": [
          {
            "type": "era.workflow.packet",
            "cardinality": "exactly_one",
            "display_name": "保留原值的跨流程结果消息",
            "as": "wireResponse"
          }
        ]
      }
    },
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.tavern.initialize.start",
        "display_name": "开始即时操作原有入口",
        "description": "标明本入口的开始或结束；本入口只运行其可达路径，其他入口不参与等待。"
      },
      {
        "id": "business",
        "definition_id": "era.tavern.workflow.sync_main_body",
        "display_name": "完成即时操作业务处理",
        "description": "按本入口的原有合同处理请求并返回结果；完整处理在可展开子流程中，与通信封装分开。"
      },
      {
        "id": "end",
        "definition_id": "era.tavern.initialize.end",
        "display_name": "结束即时操作原有入口",
        "description": "标明本入口的开始或结束；本入口只运行其可达路径，其他入口不参与等待。"
      },
      {
        "id": "protocol_start",
        "definition_id": "era.tavern.initialize.start",
        "display_name": "开始即时操作官方通信入口",
        "description": "标明本入口的开始或结束；本入口只运行其可达路径，其他入口不参与等待。"
      },
      {
        "id": "protocol_decode",
        "display_name": "恢复即时操作请求与本实例资源",
        "description": "核对本实例资源编号和请求身份，恢复消息中的原始业务值，并取回本次操作所属的本地资源。异步入口以操作编号取回已经发起的工作，不重新发起IO。 标记本次结果须走通信回信；随后把请求交给两个入口共用的处理节点。",
        "config": {
          "mode": "sync",
          "boundary": "protocol_decode"
        },
        "definition_id": "era.tavern.boundary.sync.protocol_decode",
        "join_policy": "all"
      },
      {
        "id": "protocol_encode",
        "display_name": "封装即时操作结果，保留原值再回信",
        "description": "从本次业务结果中取出应返回调用方的资料；实际异步工作尚未完成时只交回其操作编号。页面实例、回调、运行中的任务和清理函数留在资源作用域，其他业务值作可逆封装后返回，不把空位改为null或把大数改成业务字符串。 图上可见的直接返回路径不提供通信资源。只有选中协议回信时才执行本节点，并核对该入口提供的本地资源。",
        "config": {
          "mode": "sync",
          "boundary": "protocol_encode"
        },
        "definition_id": "era.tavern.boundary.sync.protocol_encode"
      },
      {
        "id": "protocol_end",
        "definition_id": "era.tavern.initialize.end",
        "display_name": "交回即时操作官方通信结果",
        "description": "标明本入口的开始或结束；本入口只运行其可达路径，其他入口不参与等待。"
      },
      {
        "id": "protocol_start_retain_host_resources",
        "definition_id": "era.tavern.retain_host_resources",
        "display_name": "保留所属实例的资源",
        "description": "先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"
      },
      {
        "id": "prepare_direct_request",
        "display_name": "整理直接入口的请求",
        "description": "取出直接入口收到的业务请求，标明结果直接返回。把同一类型的请求送进与通信入口共用的处理节点。",
        "definition_id": "era.tavern.boundary.PrepareDirectRequest"
      },
      {
        "id": "select_entry_return",
        "display_name": "按进入方式交付处理结果",
        "description": "核心处理完成后，依据入口提供的类别直接交付结果或进入协议编码。本步骤不重跑业务处理。",
        "definition_id": "era.tavern.boundary.SelectEntryReturn"
      }
    ],
    "edges": [
      {
        "from": "protocol_start",
        "to": "protocol_decode",
        "schedule": true
      },
      [
        "protocol_decode",
        "business"
      ],
      [
        "protocol_encode",
        "protocol_end"
      ],
      [
        "protocol_start",
        "protocol_start_retain_host_resources"
      ],
      {
        "from": "protocol_start_retain_host_resources",
        "to": "protocol_decode",
        "transfer": false,
        "schedule": true
      },
      [
        "start",
        "prepare_direct_request"
      ],
      [
        "prepare_direct_request",
        "business"
      ],
      {
        "from": "business",
        "to": "select_entry_return",
        "schedule": true,
        "transfer": false
      },
      {
        "from": "protocol_decode",
        "to": "select_entry_return",
        "schedule": false
      },
      {
        "from": "prepare_direct_request",
        "to": "select_entry_return",
        "schedule": false
      },
      {
        "from": "select_entry_return",
        "to": "end",
        "when": "return_route == 'direct'",
        "transfer": false
      },
      {
        "from": "select_entry_return",
        "to": "protocol_encode",
        "when": "return_route == 'protocol'"
      },
      {
        "from": "business",
        "to": "protocol_encode",
        "schedule": false
      }
    ],
    "default_entry": "main"
  },
  "base_lib": {
    "modules": [
      "era.tavern.agent_facts",
      "era.tavern.browser",
      "era.tavern.contracts",
      "era.tavern.frames",
      "era.tavern.message_facts",
      "era.tavern.receipts",
      "era.tavern.resources",
      "era.tavern.sidecar_facts",
      "era.workflow.values"
    ]
  },
  "rulesets": [
    "era.tavern.workflow_structure"
  ]
}
