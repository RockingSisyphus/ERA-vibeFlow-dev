{
  "nodeset_imports": [
    {
      "path": "nodesets/admission.jsonc"
    },
    {
      "path": "nodesets/author_tool.jsonc"
    },
    {
      "path": "nodesets/notification.jsonc"
    },
    {
      "path": "nodesets/notification_finalize.jsonc"
    },
    {
      "path": "nodesets/notification_report_item.jsonc"
    },
    {
      "path": "nodesets/runtime_iteration.jsonc"
    },
    {
      "path": "nodesets/stop_accepting.jsonc"
    },
    {
      "path": "nodesets/stop_prefix.jsonc"
    },
    {
      "path": "nodesets/stop_cancel_receipts_item.jsonc"
    },
    {
      "path": "nodesets/timer_wait.jsonc"
    },
    {
      "path": "nodesets/initialize.jsonc"
    },
    {
      "path": "nodesets/script_service.jsonc"
    }
  ],
  "host_extensions": [],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/tavern.ts",
        "export": "plugin"
      }
    }
  ],
  "global_config": {
    "config": {
      "max_event_bytes": 262144,
      "max_fifo_events": 256,
      "max_fifo_bytes": 8388608,
      "max_host_refs_per_event": 32,
      "barrier_watchdog_ms": 5000
    },
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "request",
        "type": "era.tavern.call.frame",
        "display_name": "本次操作、参数及实例令牌",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "begin",
        "type_used": "era.tavern.entry_runtime.begin",
        "display_name": "接收runtime入口请求",
        "description": "读取当前调用和实例令牌，保留输入参数；资源初始化和所有操作在后续原生 Nodeset 中执行。"
      },
      {
        "id": "initialize_script",
        "type_used": "era.tavern.flow.initialize",
        "display_name": "创建本次局部脚本会话",
        "description": "脚本只调用当前原生入口一次；在图中建立会话，不创建外部Host控制器。"
      },
      {
        "id": "bind_script_session",
        "type_used": "era.tavern.owned.bind_script_session",
        "display_name": "连接同一实例的能力入口",
        "description": "将初始化结果交给固定参数接线，所有资源仍归本次workflow。"
      },
      {
        "id": "runtime_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "持续处理实例后台任务",
        "description": "无限循环监督同一次运行的后台任务；无任务时挂起，TaskRef仅随循环资料传递；正常停止或失败均等受管任务实际退出。",
        "requires": [
          {
            "type": "era.tavern.call.frame",
            "cardinality": "exactly_one",
            "display_name": "当前实例后台运行资料"
          }
        ],
        "provides": [
          {
            "key": "probe_runtime_loop_frame",
            "type": "era.tavern.call.frame",
            "display_name": "后台循环最终资料"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.runtime_iteration",
          "max_iterations": null,
          "stop_when": {
            "from": "runtime_done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.call.frame",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "probe_runtime_loop_frame"
            }
          ]
        }
      },
      {
        "id": "finish",
        "type_used": "era.tavern.entry_runtime.finish",
        "display_name": "交还runtime入口结果",
        "description": "实际任务和资源清理结束后，只返回轻量停止确认，不向调用方输出会话或任务引用。"
      }
    ],
    "edges": [
      [
        "begin",
        "initialize_script"
      ],
      [
        "initialize_script",
        "bind_script_session"
      ],
      [
        "bind_script_session",
        "runtime_loop"
      ],
      [
        "runtime_loop",
        "finish"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.result",
        "cardinality": "exactly_one",
        "display_name": "原操作返回结果",
        "as": "result"
      }
    ]
  }
}
