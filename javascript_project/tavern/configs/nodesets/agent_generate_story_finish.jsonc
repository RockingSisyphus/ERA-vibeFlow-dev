{
  "type_key": "era.tavern.flow.agent_generate_story_finish",
  "display_name": "整理正文重试完成后的文字或错误",
  "description": "接收酒馆正文生成的真实结束资料，确认辅助标记已解除，按取消、失败或文字响应返回。主服务据此继续处理本次正文的变量和函数指令。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "整理正文重试完成后的文字或错误的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_agent_generate_story_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "整理正文重试完成后的文字或错误的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "整理正文重试完成后的文字或错误的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "整理正文重试完成后的文字或错误的处理进度及结果"
      }
    ],
    "max_steps": 14,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始整理正文重试完成后的文字或错误",
        "description": "标明“整理正文重试完成后的文字或错误”的开始位置。接收酒馆正文生成的真实结束资料，确认辅助标记已解除，按取消、失败或文字响应返回。主服务据此继续处理本次正文的变量和函数指令。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "request_model",
        "display_name": "读取模型调用真实完成的结果（正文重试）",
        "description": "在“整理正文重试完成后的文字或错误”流程中，本次处理“正文重试”。接收本次模型请求已经完成的事实，核对所属实例，记录返回文字或失败情况。独立连接请求失败时整理可读原因，供后续区分成功、取消和失败。",
        "definition_id": "era.tavern.agent_generate_story.request_model"
      },
      {
        "id": "leave_auxiliary",
        "display_name": "确认本次辅助生成标记已经解除（正文重试）",
        "description": "在“整理正文重试完成后的文字或错误”流程中，本次处理“正文重试”。在模型真实结束后检查本次辅助生成计数是否已归还。确认后才继续整理结果，避免已经结束的请求仍影响之后的聊天事件识别。",
        "definition_id": "era.tavern.agent_generate_story.leave_auxiliary"
      },
      {
        "id": "classify_result",
        "display_name": "区分生成文字、取消或失败（正文重试）",
        "description": "在“整理正文重试完成后的文字或错误”流程中，本次处理“正文重试”。检查本次模型调用是否取消、是否失败，以及响应是否为有效文字。选择对应处理分支，让调用方得到文字结果或明确的取消、失败结论。",
        "definition_id": "era.tavern.agent_generate_story.classify_result"
      },
      {
        "id": "select_cancelled",
        "display_name": "按原原因结束已取消的模型请求（正文重试）",
        "description": "在“整理正文重试完成后的文字或错误”流程中，本次处理“正文重试”。读取本次模型请求的取消原因并终止当前操作。外层等待据此收到取消结论，不会把取消误记成模型返回了有效文字。",
        "definition_id": "era.tavern.agent_generate_story.select_cancelled"
      },
      {
        "id": "select_failed",
        "display_name": "向正文重试流程报告生成失败",
        "description": "在“整理正文重试完成后的文字或错误”流程中，正文请求失败或没有返回文字时，将实际错误交回重试流程。上层据此保留失败原因并决定本次阶段的结论。",
        "definition_id": "era.tavern.agent_generate_story.select_failed"
      },
      {
        "id": "select_text",
        "display_name": "返回本次正文重试的文字",
        "description": "在“整理正文重试完成后的文字或错误”流程中，接收酒馆正文重试成功返回的内容，附上本次请求身份，交给生成阶段处理。后续再检查文字中的变量和函数指令，并安排消息保存。",
        "definition_id": "era.tavern.agent_generate_story.select_text"
      },
      {
        "id": "join_return_model",
        "display_name": "交接正文重试的选中结果",
        "description": "在“整理正文重试完成后的文字或错误”流程中，在“正文重试”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.agent_generate_story.join_return_model"
      },
      {
        "id": "return_model",
        "display_name": "交回“正文重试”的实际结果",
        "description": "在“整理正文重试完成后的文字或错误”流程中，接收“正文重试”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_generate_story.return_model"
      },
      {
        "id": "end",
        "display_name": "结束整理正文重试完成后的文字或错误",
        "description": "标明“整理正文重试完成后的文字或错误”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "request_model",
        "leave_auxiliary"
      ],
      [
        "leave_auxiliary",
        "classify_result"
      ],
      {
        "from": "classify_result",
        "to": "select_text",
        "when": "era_tavern_agent_generate_story_classify_result_route == 'text'"
      },
      [
        "select_text",
        "join_return_model"
      ],
      {
        "from": "classify_result",
        "to": "select_failed",
        "when": "era_tavern_agent_generate_story_classify_result_route == 'failed'"
      },
      [
        "select_failed",
        "join_return_model"
      ],
      {
        "from": "classify_result",
        "to": "select_cancelled",
        "when": "era_tavern_agent_generate_story_classify_result_route == 'cancelled'"
      },
      [
        "select_cancelled",
        "join_return_model"
      ],
      [
        "join_return_model",
        "return_model"
      ],
      [
        "start",
        "request_model"
      ],
      [
        "return_model",
        "end"
      ]
    ]
  }
}
