{
  "type_key": "era.tavern.flow.cap_sync_startup_gate",
  "display_name": "安装决议操作",
  "description": "共享同一职责组的原操作与必要的等待前发起；无额外 cap 总分组。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_startup_gate_frame",
      "type": "era.tavern.frame.final.cap_sync_startup_gate",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_startup_gate",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_sync_startup_gate.choose",
        "display_name": "识别安装决议操作",
        "description": "按已声明操作名选择唯一原生路径；即时操作、同步完成的 Promise 操作及真正等待前的发起共享本职责组，不重复分组。"
      },
      {
        "id": "route_activate",
        "type_used": "era.tavern.flow.activate",
        "display_name": "按安装决议登记或休眠",
        "description": "沿原 era.tavern.startup_gate.activate 合同执行当前唯一操作。"
      },
      {
        "id": "join_return",
        "type_used": "era.tavern.cap_sync_startup_gate.join_return",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_activate",
        "when": "era_tavern_cap_sync_startup_gate_choose_route == 'activate'"
      },
      [
        "route_activate",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_activate",
        "when": "era_tavern_cap_sync_startup_gate_choose_route == 'dormant'"
      },
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
