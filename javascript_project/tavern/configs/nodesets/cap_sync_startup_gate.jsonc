{
  "type_key": "era.tavern.flow.cap_sync_startup_gate",
  "display_name": "分派实例启用决定操作",
  "description": "接收实例启用决定请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派实例启用决定操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_startup_gate_frame",
      "type": "era.tavern.frame.final.cap_sync_startup_gate",
      "display_name": "分派实例启用决定操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派实例启用决定操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_startup_gate",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派实例启用决定操作的处理进度及结果"
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派实例启用决定操作",
        "description": "标明“分派实例启用决定操作”的开始位置。接收实例启用决定请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择实例启用决定的具体操作",
        "description": "在“分派实例启用决定操作”流程中，接收实例启用决定请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_startup_gate.choose"
      },
      {
        "id": "route_activate",
        "display_name": "按脚本启用决定连接聊天和界面",
        "description": "本环节用于“分派实例启用决定操作”：接收主服务对安装位置作出的启用或休眠决定，检查实例后只在启用分支登记聊天监听。完成启动决定，按需挂载界面，返回本实例是否已激活。",
        "definition_id": "era.tavern.flow.activate"
      },
      {
        "id": "join_return",
        "display_name": "交接分派实例启用决定操作的选中结果",
        "description": "在“分派实例启用决定操作”流程中，在“分派实例启用决定操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_startup_gate.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派实例启用决定操作",
        "description": "标明“分派实例启用决定操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_activate",
        "when": "era_tavern_cap_sync_startup_gate_choose_route == 'activate'"
      },
      [
        "route_activate",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_activate",
        "when": "era_tavern_cap_sync_startup_gate_choose_route == 'dormant'"
      },
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
