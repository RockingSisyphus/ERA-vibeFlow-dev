{
  "type_key": "era.tavern.flow.cap_async_functions",
  "display_name": "完成消息中的作者函数操作",
  "description": "接收已经发起、需要等待的消息中的作者函数操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成消息中的作者函数操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_functions_frame",
      "type": "era.tavern.frame.final.cap_async_functions",
      "display_name": "完成消息中的作者函数操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成消息中的作者函数操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_functions",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成消息中的作者函数操作的处理进度及结果"
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成消息中的作者函数操作",
        "description": "标明“完成消息中的作者函数操作”的开始位置。接收已经发起、需要等待的消息中的作者函数操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择消息中的作者函数的具体操作",
        "description": "在“完成消息中的作者函数操作”流程中，接收消息中的作者函数请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_functions.choose"
      },
      {
        "id": "route_next",
        "display_name": "等到作者提出操作或真正结束",
        "description": "本环节用于“完成消息中的作者函数操作”：已经取得请求或结束结果时直接返回；否则按循环等待唤醒并重新检查。每次只返回当前实际取得的一项操作或结束状态，供消息流程顺序处理。",
        "definition_id": "era.tavern.flow.functions_next_finish"
      },
      {
        "id": "join_return",
        "display_name": "交接完成消息中的作者函数操作的选中结果",
        "description": "在“完成消息中的作者函数操作”流程中，在“完成消息中的作者函数操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_functions.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成消息中的作者函数操作",
        "description": "标明“完成消息中的作者函数操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_next",
        "when": "era_tavern_cap_async_functions_choose_route == 'next'"
      },
      [
        "route_next",
        "join_return"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
