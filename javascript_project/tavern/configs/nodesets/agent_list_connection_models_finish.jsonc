{
  "type_key": "era.tavern.flow.agent_list_connection_models_finish",
  "display_name": "列出已保存方案的模型：生成、连接及页面会话：等待与确认",
  "description": "续用同步段已发起资源；保留原等待后的具体处理、结果核对与错误身份。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_agent_list_connection_models_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "execute",
        "type_used": "era.tavern.agent_list_connection_models.execute",
        "display_name": "等待本次列出已保存方案的模型：生成、连接及页面会话的资源终态",
        "description": "等待同步原生段已捕获的本次资源；检查所属实例和取消，不重发原 API，不执行后续回读或发布。"
      },
      {
        "id": "check_response",
        "type_used": "era.tavern.agent_list_connection_models_finish.check_response",
        "display_name": "核对模型枚举 HTTP 响应",
        "description": "只核对本次 HTTP 状态；失败保持旧脱敏诊断及 cause，取消保持原原因。"
      },
      {
        "id": "read_json",
        "type_used": "era.tavern.agent_list_connection_models_finish.read_json",
        "display_name": "读取模型枚举响应 JSON",
        "description": "调用本次 Response.json 并等待；不再次 fetch，不读取当前方案或密钥。"
      },
      {
        "id": "project_models",
        "type_used": "era.tavern.agent_list_connection_models_finish.project_models",
        "display_name": "提取模型列表和脱敏摘要",
        "description": "按旧模型列表数据格式投影，保存已捕获方案的摘要；不把密钥交给 Service。"
      },
      {
        "id": "return_result",
        "type_used": "era.tavern.agent_list_connection_models.return_result",
        "display_name": "交还列出已保存方案的模型结果",
        "description": "返回原 era.agent.host.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "project_models",
        "return_result"
      ],
      [
        "execute",
        "check_response"
      ],
      [
        "check_response",
        "read_json"
      ],
      [
        "read_json",
        "project_models"
      ],
      [
        "start",
        "execute"
      ],
      [
        "return_result",
        "end"
      ]
    ]
  }
}
