{
  "type_key": "era.tavern.flow.messages_update_content_update_messages_item",
  "display_name": "把一条消息修改加入批量提交清单",
  "description": "依次取出本次明确更新的消息，合并需要保留的附加资料，记录受影响范围和内部写入内容。全部整理后由外层统一发起一次写入，本轮只推进清单准备。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.frame.messages_update_content.choose_update",
      "cardinality": "exactly_one",
      "display_name": "把一条消息修改加入批量提交清单的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_messages_update_content_update_messages_item_frame",
      "type": "era.tavern.item.result.messages_update_content_update_messages_item",
      "display_name": "把一条消息修改加入批量提交清单的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_messages_update_content_update_messages_item_done",
      "type": "era.tavern.done.messages_update_content.update_messages",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.frame.messages_update_content.choose_update",
        "display_name": "把一条消息修改加入批量提交清单的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始把一条消息修改加入批量提交清单",
        "description": "标明“把一条消息修改加入批量提交清单”的开始位置。依次取出本次明确更新的消息，合并需要保留的附加资料，记录受影响范围和内部写入内容。全部整理后由外层统一发起一次写入，本轮只推进清单准备。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_item",
        "display_name": "判断还有没有消息修改需要整理",
        "description": "在“把一条消息修改加入批量提交清单”流程中，查看本次消息更新清单的当前位置。还有项目时整理下一条，全部完成时结束准备，后续一次提交整份修改清单。",
        "definition_id": "era.tavern.messages_update_content_update_messages_item.choose_item"
      },
      {
        "id": "one_item",
        "display_name": "整理一条修改并保留原附加资料",
        "description": "在“把一条消息修改加入批量提交清单”流程中，取出一条消息修改，按需读取原消息，合并应保留的附加字段，并记录受影响消息及 ERA 自己写入的文字。这里只建立统一提交清单，后续一起执行写入。",
        "definition_id": "era.tavern.messages_update_content_update_messages_item.one_item"
      },
      {
        "id": "empty",
        "display_name": "确认消息更新清单已经整理完",
        "description": "在“把一条消息修改加入批量提交清单”流程中，全部消息修改已经遍历时，标记准备循环结束。后续使用整理好的清单一次发起写入，而不是在此逐条保存。",
        "definition_id": "era.tavern.messages_update_content_update_messages_item.empty"
      },
      {
        "id": "join_end",
        "display_name": "交接把一条消息修改加入批量提交清单的选中结果",
        "description": "在“把一条消息修改加入批量提交清单”流程中，在“把一条消息修改加入批量提交清单”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.messages_update_content_update_messages_item.join_end"
      },
      {
        "id": "end",
        "display_name": "结束把一条消息修改加入批量提交清单",
        "description": "标明“把一条消息修改加入批量提交清单”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_item",
        "to": "one_item",
        "when": "era_tavern_messages_update_content_update_messages_item_choose_item_route == 'item'"
      },
      {
        "from": "choose_item",
        "to": "empty",
        "when": "era_tavern_messages_update_content_update_messages_item_choose_item_route == 'done'"
      },
      [
        "one_item",
        "join_end"
      ],
      [
        "empty",
        "join_end"
      ],
      [
        "start",
        "choose_item"
      ],
      [
        "join_end",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.item.result.messages_update_content_update_messages_item",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "把一条消息修改加入批量提交清单的处理进度及结果"
      },
      {
        "type": "era.tavern.done.messages_update_content.update_messages",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ]
  }
}
