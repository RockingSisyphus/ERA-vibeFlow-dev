{
  "type_key": "era.tavern.flow.character_apply_greeting_refresh_finish",
  "display_name": "完成聊天开场白的通知、重绘和保存",
  "description": "接续已经更新的聊天首条消息，等待接收通知处理，清除旧显示并重新绘制，发出呈现完成通知后保存聊天。返回本次开场白刷新已完成的实际确认。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成聊天开场白的通知、重绘和保存的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_character_apply_greeting_refresh_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "完成聊天开场白的通知、重绘和保存的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成聊天开场白的通知、重绘和保存的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
