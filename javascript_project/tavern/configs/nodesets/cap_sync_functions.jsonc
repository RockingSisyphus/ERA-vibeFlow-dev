{
  "type_key": "era.tavern.flow.cap_sync_functions",
  "display_name": "分派消息中的作者函数操作",
  "description": "接收消息中的作者函数请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派消息中的作者函数操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_functions_frame",
      "type": "era.tavern.frame.final.cap_sync_functions",
      "display_name": "分派消息中的作者函数操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派消息中的作者函数操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_functions",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派消息中的作者函数操作的处理进度及结果"
      }
    ],
    "max_steps": 15,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派消息中的作者函数操作",
        "description": "标明“分派消息中的作者函数操作”的开始位置。接收消息中的作者函数请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择消息中的作者函数的具体操作",
        "description": "在“分派消息中的作者函数操作”流程中，接收消息中的作者函数请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_functions.choose"
      },
      {
        "id": "route_begin",
        "display_name": "建立作者函数调用并安排执行",
        "description": "本环节用于“分派消息中的作者函数操作”：检查调用身份和目标消息，建立参数、操作接口及取消关联，再把函数加入作者队列。返回已安排确认，消息流程随后等待作者操作或结束。",
        "definition_id": "era.tavern.flow.functions_begin"
      },
      {
        "id": "route_next__check_active",
        "display_name": "确认作者调用仍属于当前消息",
        "description": "在“分派消息中的作者函数操作”流程中，读取主服务要继续等待的作者函数，检查调用仍有效、未取消且消息来源未变化。通过后再读取请求或完成状态，防止接续过期函数。",
        "definition_id": "era.tavern.functions_next.check_active"
      },
      {
        "id": "route_next__capture_next",
        "display_name": "检查作者是否有请求或已经结束",
        "description": "本环节用于“分派消息中的作者函数操作”：确认当前作者调用仍有效，优先取出待处理操作，全部完成时返回结束，否则登记一次唤醒等待。外层据此决定立即返回还是继续异步等待。",
        "definition_id": "era.tavern.flow.functions_next_capture"
      },
      {
        "id": "route_acknowledge__find_request",
        "display_name": "找到作者正在等待确认的操作",
        "description": "在“分派消息中的作者函数操作”流程中，根据作者调用身份和请求编号，找到本次尚未确认的操作。找不到时报告对应错误，找到后交给结果回告，避免确认到其他操作。",
        "definition_id": "era.tavern.functions_acknowledge.find_request"
      },
      {
        "id": "route_acknowledge__resolve_request",
        "display_name": "把操作处理结果回告作者函数",
        "description": "在“分派消息中的作者函数操作”流程中，从待确认列表移除对应作者操作，把主服务实际处理的结论复制返回给函数。等待该操作的作者代码随后可以继续执行。",
        "definition_id": "era.tavern.functions_acknowledge.resolve_request"
      },
      {
        "id": "route_acknowledge__return_ack",
        "display_name": "确认作者操作已回告完成",
        "description": "在“分派消息中的作者函数操作”流程中，返回作者操作确认已交付的结果，供主服务继续消息处理。本环节承接已经完成的回告，不再执行变量操作。",
        "definition_id": "era.tavern.functions_acknowledge.return_ack"
      },
      {
        "id": "route_release",
        "display_name": "结束作者调用并释放相关等待",
        "description": "本环节用于“分派消息中的作者函数操作”：先使当前作者调用失效，逐项以过期原因结束未确认请求，再解除参数和取消监听并唤醒等待者。返回释放确认，让消息流程能完整收尾。",
        "definition_id": "era.tavern.flow.functions_release"
      },
      {
        "id": "route_next__start_wait",
        "display_name": "发起对作者下一请求或结束的等待",
        "description": "在“分派消息中的作者函数操作”流程中，为当前作者函数登记一次可取消的等待，交给后续流程检查请求队列和结束状态。主服务据此等待函数提出变量操作或真正运行结束。",
        "definition_id": "era.tavern.functions_next.start_wait"
      },
      {
        "id": "join_return",
        "display_name": "交接分派消息中的作者函数操作的选中结果",
        "description": "在“分派消息中的作者函数操作”流程中，在“分派消息中的作者函数操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_functions.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派消息中的作者函数操作",
        "description": "标明“分派消息中的作者函数操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_begin",
        "when": "era_tavern_cap_sync_functions_choose_route == 'begin'"
      },
      [
        "route_begin",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_next__check_active",
        "when": "era_tavern_cap_sync_functions_choose_route == 'next'"
      },
      [
        "route_next__capture_next",
        "route_next__start_wait"
      ],
      {
        "from": "choose",
        "to": "route_acknowledge__find_request",
        "when": "era_tavern_cap_sync_functions_choose_route == 'acknowledge'"
      },
      [
        "route_acknowledge__return_ack",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_release",
        "when": "era_tavern_cap_sync_functions_choose_route == 'release'"
      },
      [
        "route_release",
        "join_return"
      ],
      [
        "route_next__check_active",
        "route_next__capture_next"
      ],
      [
        "route_acknowledge__find_request",
        "route_acknowledge__resolve_request"
      ],
      [
        "route_acknowledge__resolve_request",
        "route_acknowledge__return_ack"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ],
      [
        "route_next__start_wait",
        "join_return"
      ]
    ]
  }
}
