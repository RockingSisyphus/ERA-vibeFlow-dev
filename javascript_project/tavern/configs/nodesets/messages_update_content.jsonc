{
  "type_key": "era.tavern.flow.messages_update_content",
  "display_name": "更新消息并确认保存完成",
  "description": "实现 era.tavern.messages.update_content；输入沿用 era.tavern.messages.update_content.request，输出沿用 era.tavern.messages.update_content.result，完成方式保持 suspend。 原节点保留；仅把首次等待划为同步发起与异步等待，后续处理在对应 finish 流程。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用及实例资源令牌"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_messages_update_content_frame",
      "type": "era.tavern.frame.messages_update_content.started",
      "display_name": "本次原生步骤的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "调用与资源资料",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.messages_update_content.started",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本次已经发起的等待资源"
      }
    ],
    "max_steps": 15,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "check_target",
        "type_used": "era.tavern.messages_update_content.check_target",
        "display_name": "复核消息目标与保存依据",
        "description": "检查原消息来源和保存观察依据，避免覆盖用户修改或另一聊天。"
      },
      {
        "id": "choose_update",
        "type_used": "era.tavern.messages_update_content.choose_update",
        "display_name": "选择单条正文或消息更新列表",
        "description": "保留单条写 message 与多条合并 extra 的区别，避免丢失 swipe_info、附件和未知字段。"
      },
      {
        "id": "select_many",
        "type_used": "era.tavern.messages_update_content.select_many",
        "display_name": "准备多消息更新列表",
        "description": "保留原 updates 顺序，把每条更新交给原生消息更新 Loop。"
      },
      {
        "id": "select_single",
        "type_used": "era.tavern.messages_update_content.select_single",
        "display_name": "准备单条正文写入",
        "description": "只生成指定 message 的写入项，保留原 swipe 和附件字段。"
      },
      {
        "id": "join_update_messages_loop",
        "type_used": "era.tavern.messages_update_content.join_update_messages_loop",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "update_messages_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "逐项更新指定消息循环",
        "description": "每轮保留原消息结构并执行一个明确更新，记录实际受影响消息；处理完列表后统一等待保存和显示刷新。",
        "loop": {
          "body": "era.tavern.flow.messages_update_content_update_messages_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.messages_update_content.choose_update",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_messages_update_content_update_messages_loop_frame"
            }
          ]
        },
        "requires": [
          {
            "type": "era.tavern.frame.messages_update_content.choose_update",
            "cardinality": "exactly_one",
            "display_name": "当前请求、实例资源令牌及此前步骤取得的事实"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_messages_update_content_update_messages_loop_frame",
            "type": "era.tavern.frame.messages_update_content.choose_update",
            "display_name": "逐项更新指定消息完成后的处理资料"
          }
        ]
      },
      {
        "id": "start_operation",
        "type_used": "era.tavern.messages_update_content.start_operation",
        "display_name": "核对目标并发起一次批量消息更新",
        "description": "捕获固定保存目标和写后依据；在同步准备完更新列表后再次核对当前目标，调用一次 setChatMessages；不逐条写入，不覆盖附件或未知 extra。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "check_target",
        "choose_update"
      ],
      {
        "from": "choose_update",
        "to": "select_single",
        "when": "era_tavern_messages_update_content_choose_update_route == 'single'"
      },
      [
        "select_single",
        "join_update_messages_loop"
      ],
      {
        "from": "choose_update",
        "to": "select_many",
        "when": "era_tavern_messages_update_content_choose_update_route == 'many'"
      },
      [
        "select_many",
        "join_update_messages_loop"
      ],
      [
        "join_update_messages_loop",
        "update_messages_loop"
      ],
      [
        "update_messages_loop",
        "start_operation"
      ],
      [
        "start",
        "check_target"
      ],
      [
        "start_operation",
        "end"
      ]
    ]
  }
}
