{
  "type_key": "era.tavern.flow.messages_update_content",
  "display_name": "准备并发起一次消息批量更新",
  "description": "核对聊天、消息和文件绑定，整理单条或多条更新并保留附加资料，再一次发起写入。后续确认流程等待更新、保存聊天、回读比较，最后返回实际写入状态。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "准备并发起一次消息批量更新的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_messages_update_content_frame",
      "type": "era.tavern.frame.messages_update_content.started",
      "display_name": "准备并发起一次消息批量更新的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "准备并发起一次消息批量更新的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.messages_update_content.started",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "准备并发起一次消息批量更新的处理进度及结果"
      }
    ],
    "max_steps": 15,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始准备并发起一次消息批量更新",
        "description": "标明“准备并发起一次消息批量更新”的开始位置。核对聊天、消息和文件绑定，整理单条或多条更新并保留附加资料，再一次发起写入。后续确认流程等待更新、保存聊天、回读比较，最后返回实际写入状态。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_target",
        "display_name": "写消息前核对聊天和状态文件",
        "description": "在“准备并发起一次消息批量更新”流程中，检查当前实例、目标消息和预期的状态文件绑定仍与本次任务一致，记录本次保存依据和需要的刷新方式。后续据此准备消息修改，避免用户切换聊天后写错目标。",
        "definition_id": "era.tavern.messages_update_content.check_target"
      },
      {
        "id": "choose_update",
        "display_name": "区分单条正文修改和批量消息修改",
        "description": "在“准备并发起一次消息批量更新”流程中，接收消息写入请求，判断是直接替换一条正文，还是处理明确列出的多条消息更新。后续统一整理成一次批量提交所需的清单。",
        "definition_id": "era.tavern.messages_update_content.choose_update"
      },
      {
        "id": "select_many",
        "display_name": "接收明确列出的消息修改",
        "description": "在“准备并发起一次消息批量更新”流程中，复制请求指定的单项或多项消息更新，保留原顺序。后续逐项补齐应保留的消息附加资料，再统一发起写入。",
        "definition_id": "era.tavern.messages_update_content.select_many"
      },
      {
        "id": "select_single",
        "display_name": "检查并整理一条消息的正文替换",
        "description": "在“准备并发起一次消息批量更新”流程中，读取消息编号和新正文，确认目标存在且文字有效，整理成一项更新。后续与批量修改共用同一写入和保存确认流程。",
        "definition_id": "era.tavern.messages_update_content.select_single"
      },
      {
        "id": "join_update_messages_loop",
        "display_name": "交接准备并发起一次消息批量更新的选中结果",
        "description": "在“准备并发起一次消息批量更新”流程中，在“准备并发起一次消息批量更新”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.messages_update_content.join_update_messages_loop"
      },
      {
        "id": "update_messages_loop",
        "display_name": "逐条整理本次消息批量修改",
        "description": "按本次更新清单，逐项合并需要保留的消息附加资料并记下影响范围。准备完后统一发起一次消息更新；本循环只整理清单，随后才等待保存及回读确认。",
        "loop": {
          "body": "era.tavern.flow.messages_update_content_update_messages_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.messages_update_content.choose_update",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_messages_update_content_update_messages_loop_frame"
            }
          ]
        },
        "requires": [
          {
            "type": "era.tavern.frame.messages_update_content.choose_update",
            "cardinality": "exactly_one",
            "display_name": "准备并发起一次消息批量更新的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_messages_update_content_update_messages_loop_frame",
            "type": "era.tavern.frame.messages_update_content.choose_update",
            "display_name": "准备并发起一次消息批量更新的处理进度及结果"
          }
        ],
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "start_operation",
        "display_name": "再次核对目标并发起批量消息更新",
        "description": "在“准备并发起一次消息批量更新”流程中，准备清单完成后，再检查聊天消息及状态文件绑定仍一致，随后一次提交全部消息修改。后续等待真实更新并保存聊天，防止准备期间目标变化。",
        "definition_id": "era.tavern.messages_update_content.start_operation"
      },
      {
        "id": "end",
        "display_name": "结束准备并发起一次消息批量更新",
        "description": "标明“准备并发起一次消息批量更新”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_target",
        "choose_update"
      ],
      {
        "from": "choose_update",
        "to": "select_single",
        "when": "era_tavern_messages_update_content_choose_update_route == 'single'"
      },
      [
        "select_single",
        "join_update_messages_loop"
      ],
      {
        "from": "choose_update",
        "to": "select_many",
        "when": "era_tavern_messages_update_content_choose_update_route == 'many'"
      },
      [
        "select_many",
        "join_update_messages_loop"
      ],
      [
        "join_update_messages_loop",
        "update_messages_loop"
      ],
      [
        "update_messages_loop",
        "start_operation"
      ],
      [
        "start",
        "check_target"
      ],
      [
        "start_operation",
        "end"
      ]
    ]
  }
}
