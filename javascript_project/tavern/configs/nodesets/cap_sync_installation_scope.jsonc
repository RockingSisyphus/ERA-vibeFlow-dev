{
  "type_key": "era.tavern.flow.cap_sync_installation_scope",
  "display_name": "分派脚本启用位置操作",
  "description": "接收脚本启用位置请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派脚本启用位置操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_installation_scope_frame",
      "type": "era.tavern.frame.final.cap_sync_installation_scope",
      "display_name": "分派脚本启用位置操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派脚本启用位置操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_installation_scope",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派脚本启用位置操作的处理进度及结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派脚本启用位置操作",
        "description": "标明“分派脚本启用位置操作”的开始位置。接收脚本启用位置请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择脚本启用位置的具体操作",
        "description": "在“分派脚本启用位置操作”流程中，接收脚本启用位置请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_installation_scope.choose"
      },
      {
        "id": "route_read__check_request",
        "display_name": "检查“读取脚本启用位置”的调用是否有效",
        "description": "在“分派脚本启用位置操作”流程中，接收“读取脚本启用位置”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.installation_scope_read.check_request"
      },
      {
        "id": "route_read__execute",
        "display_name": "查看当前脚本在哪些位置启用",
        "description": "在“分派脚本启用位置操作”流程中，读取脚本自身身份，检查它是否在角色卡、全局或预设中启用。无法读取时如实返回不可用或失败状态，交给主服务作启动决定。",
        "definition_id": "era.tavern.installation_scope_read.execute"
      },
      {
        "id": "route_read__return_result",
        "display_name": "交回“读取脚本启用位置”的实际结果",
        "description": "在“分派脚本启用位置操作”流程中，接收“读取脚本启用位置”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.installation_scope_read.return_result"
      },
      {
        "id": "join_return",
        "display_name": "交接分派脚本启用位置操作的选中结果",
        "description": "在“分派脚本启用位置操作”流程中，在“分派脚本启用位置操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_installation_scope.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派脚本启用位置操作",
        "description": "标明“分派脚本启用位置操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__check_request",
        "when": "era_tavern_cap_sync_installation_scope_choose_route == 'read'"
      },
      [
        "route_read__return_result",
        "join_return"
      ],
      [
        "route_read__check_request",
        "route_read__execute"
      ],
      [
        "route_read__execute",
        "route_read__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
