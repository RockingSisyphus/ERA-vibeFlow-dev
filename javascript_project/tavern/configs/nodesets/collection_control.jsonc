{
  "type_key": "era.tavern.flow.collection_control",
  "display_name": "按顺序执行事件收集的计时要求",
  "description": "接收主服务明确给出的计时清单，逐项交给统一计时控制，完成后返回确认。到期后只按已约定内容回送事件，业务任务仍由主服务决定。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "按顺序执行事件收集的计时要求的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_collection_control_frame",
      "type": "era.tavern.call.frame",
      "display_name": "按顺序执行事件收集的计时要求的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "按顺序执行事件收集的计时要求的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按顺序执行事件收集的计时要求",
        "description": "标明“按顺序执行事件收集的计时要求”的开始位置。接收主服务明确给出的计时清单，逐项交给统一计时控制，完成后返回确认。到期后只按已约定内容回送事件，业务任务仍由主服务决定。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "prepare_commands",
        "display_name": "按原顺序读取主服务的计时清单",
        "description": "在“按顺序执行事件收集的计时要求”流程中，取出主服务本次送回的启动或取消计时要求，从第一项建立处理进度。后续每项共用同一计时控制流程执行，保持主服务指定顺序。",
        "definition_id": "era.tavern.collection_control.prepare_commands"
      },
      {
        "id": "apply_commands_loop",
        "display_name": "按清单逐条执行计时要求",
        "description": "接收主服务已确定的计时清单，每轮执行一条启动、取消或保留要求后推进。所有项目处理完才结束，随后返回整份控制确认。",
        "requires": [
          {
            "type": "era.tavern.frame.collection_control.prepare_commands",
            "cardinality": "exactly_one",
            "display_name": "按顺序执行事件收集的计时要求的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_collection_control_apply_commands_loop_frame",
            "type": "era.tavern.frame.collection_control.prepare_commands",
            "display_name": "按顺序执行事件收集的计时要求的处理进度及结果"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.collection_control_apply_commands_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.collection_control.prepare_commands",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_collection_control_apply_commands_loop_frame"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "apply_commands",
        "display_name": "确认本份计时清单已全部处理",
        "description": "在“按顺序执行事件收集的计时要求”流程中，接收逐项计时控制循环的结束资料，交给控制消息确认出口。表示清单已安排完成，实际到期事件仍由计时职责分支处理。",
        "definition_id": "era.tavern.collection_control.apply_commands"
      },
      {
        "id": "return_control",
        "display_name": "返回整份计时控制已处理的确认",
        "description": "在“按顺序执行事件收集的计时要求”流程中，所有收集计时要求处理完后，交回本次控制完成的空确认。服务可以继续收集或执行批次，已登记时限随后按期触发。",
        "definition_id": "era.tavern.collection_control.return_control"
      },
      {
        "id": "end",
        "display_name": "结束按顺序执行事件收集的计时要求",
        "description": "标明“按顺序执行事件收集的计时要求”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "prepare_commands",
        "apply_commands_loop"
      ],
      [
        "apply_commands",
        "return_control"
      ],
      [
        "apply_commands_loop",
        "apply_commands"
      ],
      [
        "start",
        "prepare_commands"
      ],
      [
        "return_control",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "按顺序执行事件收集的计时要求的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
