{
  "type_key": "era.tavern.flow.functions_release",
  "display_name": "结束作者调用并释放相关等待",
  "description": "先使当前作者调用失效，逐项以过期原因结束未确认请求，再解除参数和取消监听并唤醒等待者。返回释放确认，让消息流程能完整收尾。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "结束作者调用并释放相关等待的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_functions_release_frame",
      "type": "era.tavern.call.frame",
      "display_name": "结束作者调用并释放相关等待的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "结束作者调用并释放相关等待的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始结束作者调用并释放相关等待",
        "description": "标明“结束作者调用并释放相关等待”的开始位置。先使当前作者调用失效，逐项以过期原因结束未确认请求，再解除参数和取消监听并唤醒等待者。返回释放确认，让消息流程能完整收尾。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "close_call",
        "display_name": "使当前作者调用停止接受新请求",
        "description": "在“结束作者调用并释放相关等待”流程中，按调用身份移除作者运行登记并将它标为失效。后续依次结束未完成请求并解绑资料，使旧函数不能继续提交当前消息的操作。",
        "definition_id": "era.tavern.functions_release.close_call"
      },
      {
        "id": "reject_pending_loop",
        "display_name": "逐项结束已失效作者的待确认请求",
        "description": "作者调用关闭后，每轮让一项仍在等待的操作以调用失效结束。全部处理完才进入参数解绑，保证没有作者提交永久等待。",
        "requires": [
          {
            "type": "era.tavern.frame.functions_release.close_call",
            "cardinality": "exactly_one",
            "display_name": "结束作者调用并释放相关等待的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_functions_release_reject_pending_loop_frame",
            "type": "era.tavern.frame.functions_release.close_call",
            "display_name": "结束作者调用并释放相关等待的处理进度及结果"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.functions_release_reject_pending_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.functions_release.close_call",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_functions_release_reject_pending_loop_frame"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "reject_pending",
        "display_name": "交接作者未决请求已处理完的状态",
        "description": "在“结束作者调用并释放相关等待”流程中，接收逐项结束作者未确认操作的循环结果，交给参数解绑和最终释放。确保结束等待的工作先完成，再撤销本次运行关联。",
        "definition_id": "era.tavern.functions_release.reject_pending"
      },
      {
        "id": "unbind_context",
        "display_name": "解绑作者参数并唤醒等待中的调用",
        "description": "在“结束作者调用并释放相关等待”流程中，移除作者参数与运行资料的关联，释放本次取消监听并唤醒仍在等待的主服务。配合已完成的请求清理，让当前作者函数调用完整结束。",
        "definition_id": "era.tavern.functions_release.unbind_context"
      },
      {
        "id": "return_release",
        "display_name": "确认作者调用资料已释放",
        "description": "在“结束作者调用并释放相关等待”流程中，返回当前作者调用已经完成释放的确认。主服务据此继续处理正文或完成失败收尾。",
        "definition_id": "era.tavern.functions_release.return_release"
      },
      {
        "id": "end",
        "display_name": "结束结束作者调用并释放相关等待",
        "description": "标明“结束作者调用并释放相关等待”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "close_call",
        "reject_pending_loop"
      ],
      [
        "reject_pending",
        "unbind_context"
      ],
      [
        "unbind_context",
        "return_release"
      ],
      [
        "reject_pending_loop",
        "reject_pending"
      ],
      [
        "start",
        "close_call"
      ],
      [
        "return_release",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "结束作者调用并释放相关等待的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
