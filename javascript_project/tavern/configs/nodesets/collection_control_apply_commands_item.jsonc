{
  "type_key": "era.tavern.flow.collection_control_apply_commands_item",
  "display_name": "执行计时清单中的一条要求",
  "description": "根据当前位置取出一条启动或取消要求，交给统一计时控制后推进一项。没有剩余内容时结束本轮，供外层完成整份收集控制。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.frame.collection_control.prepare_commands",
      "cardinality": "exactly_one",
      "display_name": "执行计时清单中的一条要求的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_collection_control_apply_commands_item_frame",
      "type": "era.tavern.item.result.collection_control_apply_commands_item",
      "display_name": "执行计时清单中的一条要求的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_collection_control_apply_commands_item_done",
      "type": "era.tavern.done.collection_control.apply_commands",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.frame.collection_control.prepare_commands",
        "display_name": "执行计时清单中的一条要求的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 18,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始执行计时清单中的一条要求",
        "description": "标明“执行计时清单中的一条要求”的开始位置。根据当前位置取出一条启动或取消要求，交给统一计时控制后推进一项。没有剩余内容时结束本轮，供外层完成整份收集控制。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_item",
        "display_name": "选择下一条计时要求或结束",
        "description": "在“执行计时清单中的一条要求”流程中，查看本次计时清单是否还有未处理项目。还有时交给计时控制，没有时结束遍历，随后返回整份控制确认。",
        "definition_id": "era.tavern.collection_control_apply_commands_item.choose_item"
      },
      {
        "id": "one_item_prepare",
        "display_name": "取出当前需要执行的计时要求",
        "description": "在“执行计时清单中的一条要求”流程中，按当前进度取出主服务给定的一条启动或取消要求，交给统一计时控制。保持原先标识和期限，不重新决定业务收集窗口。",
        "definition_id": "era.tavern.collection_control_apply_commands_item.one_item_prepare"
      },
      {
        "id": "timer__read_timer",
        "display_name": "读取本次收集或延迟事件的计时要求",
        "description": "在“执行计时清单中的一条要求”流程中，区分主服务指定的事件收集期限与页面提出的延迟事件，读取原有安排、标识和时限。延迟事件检查有效输入并记住首次安排时间，供后续确定取消、保留或替换。",
        "definition_id": "era.tavern.timer_control.read_timer"
      },
      {
        "id": "timer__choose_timer",
        "display_name": "选择取消、沿用或重新安排计时",
        "description": "在“执行计时清单中的一条要求”流程中，检查本次要求及已存在的到期时间。取消要求进入撤销分支，相同收集期限沿用原计时，其余进入新安排，避免同一时限重复登记。",
        "definition_id": "era.tavern.timer_control.choose_timer"
      },
      {
        "id": "timer__branch_schedule",
        "display_name": "登记新期限并替换旧安排",
        "description": "在“执行计时清单中的一条要求”流程中，取消被替换的旧计时，按收集截止时间或延迟及最长等待窗口计算新期限，登记到本实例。唤醒计时分支，让它按最新最近期限等待。",
        "definition_id": "era.tavern.timer_control.branch_schedule"
      },
      {
        "id": "timer__branch_cancel",
        "display_name": "取消指定计时并通知等待者重选",
        "description": "在“执行计时清单中的一条要求”流程中，取消原计时安排并从对应列表移除，更新安排版本、唤醒正在等待的计时分支。后续重新选最近期限，已取消项不会正常触发业务事件。",
        "definition_id": "era.tavern.timer_control.branch_cancel"
      },
      {
        "id": "timer__branch_keep",
        "display_name": "沿用相同期限的已有计时",
        "description": "在“执行计时清单中的一条要求”流程中，当前事件收集计时已经对应本次要求的同一期限时，保留现有安排并交给确认出口。避免同一到期重复登记。",
        "definition_id": "era.tavern.timer_control.branch_keep"
      },
      {
        "id": "timer__join_return_timer",
        "display_name": "交接按明确要求安排、取消或沿用计时的选中结果",
        "description": "在“执行计时清单中的一条要求”流程中，在“按明确要求安排、取消或沿用计时”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.timer_control.join_return_timer"
      },
      {
        "id": "timer__return_timer",
        "display_name": "返回本次计时安排的确认",
        "description": "在“执行计时清单中的一条要求”流程中，本次计时要求已执行后，按操作类型返回已安排、已取消或收集控制确认。调用方据此知道时间要求已登记，实际到期另由计时分支处理。",
        "definition_id": "era.tavern.timer_control.return_timer"
      },
      {
        "id": "one_item",
        "display_name": "记录本条计时要求完成并继续",
        "description": "在“执行计时清单中的一条要求”流程中，当前计时控制已经执行后，将进度移到下一条并继续循环。整份清单因此按主服务指定的顺序处理到结束。",
        "definition_id": "era.tavern.collection_control_apply_commands_item.one_item"
      },
      {
        "id": "empty",
        "display_name": "确认计时控制清单已经处理完",
        "description": "在“执行计时清单中的一条要求”流程中，没有剩余计时要求时，标记遍历结束。外层据此返回控制消息完成，后续到期处理由独立计时分支负责。",
        "definition_id": "era.tavern.collection_control_apply_commands_item.empty"
      },
      {
        "id": "join_end",
        "display_name": "交接执行计时清单中的一条要求的选中结果",
        "description": "在“执行计时清单中的一条要求”流程中，在“执行计时清单中的一条要求”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.collection_control_apply_commands_item.join_end"
      },
      {
        "id": "end",
        "display_name": "结束执行计时清单中的一条要求",
        "description": "标明“执行计时清单中的一条要求”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_item",
        "to": "one_item_prepare",
        "when": "era_tavern_collection_control_apply_commands_item_choose_item_route == 'item'"
      },
      {
        "from": "choose_item",
        "to": "empty",
        "when": "era_tavern_collection_control_apply_commands_item_choose_item_route == 'done'"
      },
      [
        "one_item_prepare",
        "timer__read_timer"
      ],
      [
        "timer__return_timer",
        "one_item"
      ],
      [
        "one_item",
        "join_end"
      ],
      [
        "empty",
        "join_end"
      ],
      [
        "timer__read_timer",
        "timer__choose_timer"
      ],
      {
        "from": "timer__choose_timer",
        "to": "timer__branch_keep",
        "when": "era_tavern_timer_control_choose_timer_route == 'keep'"
      },
      [
        "timer__branch_keep",
        "timer__join_return_timer"
      ],
      {
        "from": "timer__choose_timer",
        "to": "timer__branch_cancel",
        "when": "era_tavern_timer_control_choose_timer_route == 'cancel'"
      },
      [
        "timer__branch_cancel",
        "timer__join_return_timer"
      ],
      {
        "from": "timer__choose_timer",
        "to": "timer__branch_schedule",
        "when": "era_tavern_timer_control_choose_timer_route == 'schedule'"
      },
      [
        "timer__branch_schedule",
        "timer__join_return_timer"
      ],
      [
        "timer__join_return_timer",
        "timer__return_timer"
      ],
      [
        "start",
        "choose_item"
      ],
      [
        "join_end",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.item.result.collection_control_apply_commands_item",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "执行计时清单中的一条要求的处理进度及结果"
      },
      {
        "type": "era.tavern.done.collection_control.apply_commands",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ]
  }
}
