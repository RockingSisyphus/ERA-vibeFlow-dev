{
  "type_key": "era.tavern.flow.cap_sync_agent",
  "display_name": "分派模型生成和生成设置操作",
  "description": "接收模型生成和生成设置请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派模型生成和生成设置操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_agent_frame",
      "type": "era.tavern.frame.final.cap_sync_agent",
      "display_name": "分派模型生成和生成设置操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派模型生成和生成设置操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_agent",
