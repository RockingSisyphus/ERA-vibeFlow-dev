      },
      {
        "id": "route_create_error_message__start_operation",
        "display_name": "在聊天中插入生成失败提示",
        "description": "在“分派模型生成和生成设置操作”流程中，接收生成失败说明，发起系统消息创建并标记为规划失败提示。后续等待消息创建完成，让用户在聊天中看到本次失败及不可继续的状态。",
        "definition_id": "era.tavern.agent_create_error_message.start_operation"
      },
      {
        "id": "route_stop_native_generation__check_request",
        "display_name": "检查“停止当前生成”的调用是否有效",
        "description": "在“分派模型生成和生成设置操作”流程中，接收“停止当前生成”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.agent_stop_native_generation.check_request"
      },
      {
        "id": "route_stop_native_generation__execute",
        "display_name": "尝试停止当前酒馆和辅助生成",
        "description": "在“分派模型生成和生成设置操作”流程中，接收停止生成要求，尝试停止辅助模型请求及酒馆当前正文生成。分别记录是否成功；酒馆暂时不能停止时，后续会安排命令处理结束后的一次补充尝试。",
        "definition_id": "era.tavern.agent_stop_native_generation.execute"
      },
      {
        "id": "route_stop_native_generation__return_result",
        "display_name": "交回“停止当前生成”的实际结果",
        "description": "在“分派模型生成和生成设置操作”流程中，接收“停止当前生成”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_stop_native_generation.return_result"
      },
      {
        "id": "route_read_session_binding__check_request",
        "display_name": "检查“读取当前生成关联”的调用是否有效",
        "description": "在“分派模型生成和生成设置操作”流程中，接收“读取当前生成关联”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.agent_read_session_binding.check_request"
      },
      {
        "id": "route_read_session_binding__execute",
        "display_name": "读取当前生成与已有会话的关联",
        "description": "在“分派模型生成和生成设置操作”流程中，读取当前是否有酒馆生成，以及指定聊天已有生成会话的执行身份和正文请求记录。主服务据此决定沿用还是替换本次会话。",
        "definition_id": "era.tavern.agent_read_session_binding.execute"
      },
      {
        "id": "route_read_session_binding__return_result",
        "display_name": "交回“读取当前生成关联”的实际结果",
        "description": "在“分派模型生成和生成设置操作”流程中，接收“读取当前生成关联”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_read_session_binding.return_result"
      },
      {
        "id": "join_return",
        "display_name": "交接分派模型生成和生成设置操作的选中结果",
        "description": "在“分派模型生成和生成设置操作”流程中，在“分派模型生成和生成设置操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_agent.join_return"
      },
      {
        "id": "choose_native_stop",
        "display_name": "判断是否需要稍后再尝试停止",
        "description": "在“分派模型生成和生成设置操作”流程中，查看刚才停止酒馆生成的结果。已经停止时继续确认，暂未停止时转入稍后重试安排，使停止要求与酒馆当前处理阶段配合。",
        "definition_id": "era.tavern.owned.choose_native_stop"
      },
      {
        "id": "clear_native_stop",
        "display_name": "撤销旧的延后停止安排",
        "description": "在“分派模型生成和生成设置操作”流程中，移除此前登记的单次停止监听，并清空其记录。避免当前停止操作结束后，旧安排在后续生成时误触发。",
        "definition_id": "era.tavern.owned.clear_native_stop"
      },
      {
        "id": "arm_native_stop",
        "display_name": "安排命令阶段结束后再试一次停止",
        "description": "在“分派模型生成和生成设置操作”流程中，酒馆暂时不能停止生成时，登记命令处理结束后的一次停止尝试，并替换旧安排。后续只有当前实例仍有效的这次安排可以触发。",
        "definition_id": "era.tavern.owned.arm_native_stop"
      },
      {
        "id": "end",
        "display_name": "结束分派模型生成和生成设置操作",
        "description": "标明“分派模型生成和生成设置操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
