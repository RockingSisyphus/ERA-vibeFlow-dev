{
  "type_key": "era.tavern.flow.stop_prefix",
  "display_name": "解除实例监听、计时和剩余等待",
  "description": "接收实例停止要求，取消接收与业务等待，解除监听，撤销计时，逐项取消未确认事件并关闭状态文件提示。首次与重复停止按已有进度处理，实际异步操作由资源分支等待清理。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "解除实例监听、计时和剩余等待的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_stop_prefix_frame",
      "type": "era.tavern.frame.stop.owned_prepared",
      "display_name": "解除实例监听、计时和剩余等待的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "解除实例监听、计时和剩余等待的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.stop.owned_prepared",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "解除实例监听、计时和剩余等待的处理进度及结果"
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始解除实例监听、计时和剩余等待",
        "description": "标明“解除实例监听、计时和剩余等待”的开始位置。接收实例停止要求，取消接收与业务等待，解除监听，撤销计时，逐项取消未确认事件并关闭状态文件提示。首次与重复停止按已有进度处理，实际异步操作由资源分支等待清理。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "claim_stop",
        "display_name": "区分首次停止与已有停止请求",
        "description": "在“解除实例监听、计时和剩余等待”流程中，检查本实例是否已经开始清理。首次请求进入收尾，重复请求沿用已开始的停止过程，避免多次释放同一批资源。",
        "definition_id": "era.tavern.owned.claim_stop"
      },
      {
        "id": "close_ingress",
        "display_name": "立即停止接收新事件并唤醒各分支",
        "description": "在“解除实例监听、计时和剩余等待”流程中，把当前实例标为停止和未启动，返回入口关闭确认，并唤醒作者、通知和计时等待。后续请求会被拒绝，各长期分支开始结束处理。",
        "definition_id": "era.tavern.stop_accepting.close_ingress"
      },
      {
        "id": "cancel_generations",
        "display_name": "取消生成、阶段交接及相关订阅",
        "description": "在“解除实例监听、计时和剩余等待”流程中，实例停止时取消业务等待，结束启动决定，清空本页生成进度、阶段交接及订阅，并撤销延后停止安排。让仍在等待旧生成的调用能够结束，实际运行资源继续由统一收尾等待。",
        "definition_id": "era.tavern.stop_accepting.cancel_generations"
      },
      {
        "id": "abort_waiters",
        "display_name": "取消事件接收和其他运行等待",
        "description": "在“解除实例监听、计时和剩余等待”流程中，将实例生命周期及业务操作标为取消，结束挂起的事件接收，唤醒作者、通知和计时等待。各分支据此进入停止路径，而不是继续等新任务。",
        "definition_id": "era.tavern.stop.abort_waiters"
      },
      {
        "id": "remove_listeners",
        "display_name": "解除当前实例安装的页面监听",
        "description": "在“解除实例监听、计时和剩余等待”流程中，移除本实例的聊天监听及取消监听，清空登记；解除中发生的问题写入告警。配合入口关闭，确保停止后不再由旧监听接收事件。",
        "definition_id": "era.tavern.stop.remove_listeners"
      },
      {
        "id": "clear_timers",
        "display_name": "撤销计时安排并列出未确认事件",
        "description": "在“解除实例监听、计时和剩余等待”流程中，取消事件收集、延迟事件及等待告警的计时，清空对应登记。按序列出尚未确认的事件，供后续逐项返回取消结果。",
        "definition_id": "era.tavern.stop.clear_timers"
      },
      {
        "id": "cancel_receipts_loop",
        "display_name": "逐项向未完成事件说明实例停止",
        "description": "实例停止时，按序让尚未确认的原事件以取消结束，并释放其持有资料。全部处理完才继续停止收尾，已完成事件不会重复回告。",
        "loop": {
          "body": "era.tavern.flow.stop_cancel_receipts_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.stop.clear_timers",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_stop_cancel_receipts_loop_frame"
            }
          ]
        },
        "requires": [
          {
            "type": "era.tavern.frame.stop.clear_timers",
            "cardinality": "exactly_one",
            "display_name": "解除实例监听、计时和剩余等待的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_stop_cancel_receipts_loop_frame",
            "type": "era.tavern.frame.stop.clear_timers",
            "display_name": "解除实例监听、计时和剩余等待的处理进度及结果"
          }
        ],
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "cancel_receipts",
        "display_name": "确认停止时的未完成事件已逐项取消",
        "description": "在“解除实例监听、计时和剩余等待”流程中，接收取消循环结束状态，交给剩余实例清理。发起者的等待已按停止原因结束，随后再关闭相关页面提示。",
        "definition_id": "era.tavern.stop.cancel_receipts"
      },
      {
        "id": "clear_prompt",
        "display_name": "关闭本实例的状态文件选择提示",
        "description": "在“解除实例监听、计时和剩余等待”流程中，实例停止时清除页面上的状态文件绑定或修复弹窗。清理失败会记录问题，其他停止步骤仍按流程继续。",
        "definition_id": "era.tavern.stop.clear_prompt"
      },
      {
        "id": "reuse_stop",
        "display_name": "确认已有停止过程继续负责清理",
        "description": "在“解除实例监听、计时和剩余等待”流程中，本实例已经开始停止时，返回入口已关闭的确认。实际资源仍由原停止过程清理，最终等待由长期运行的退出汇合负责。",
        "definition_id": "era.tavern.owned.reuse_stop"
      },
      {
        "id": "end",
        "display_name": "结束解除实例监听、计时和剩余等待",
        "description": "标明“解除实例监听、计时和剩余等待”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "abort_waiters",
        "remove_listeners"
      ],
      [
        "remove_listeners",
        "clear_timers"
      ],
      [
        "clear_timers",
        "cancel_receipts_loop"
      ],
      [
        "cancel_receipts",
        "clear_prompt"
      ],
      [
        "cancel_receipts_loop",
        "cancel_receipts"
      ],
      [
        "close_ingress",
        "cancel_generations"
      ],
      [
        "cancel_generations",
        "abort_waiters"
      ],
      [
        "start",
        "claim_stop"
      ],
      {
        "from": "claim_stop",
        "to": "close_ingress",
        "when": "owned_claim_stop_route == 'first'"
      },
      {
        "from": "claim_stop",
        "to": "reuse_stop",
        "when": "owned_claim_stop_route == 'existing'"
      },
      [
        "reuse_stop",
        "end"
      ],
      [
        "clear_prompt",
        "end"
      ]
    ]
  }
}
