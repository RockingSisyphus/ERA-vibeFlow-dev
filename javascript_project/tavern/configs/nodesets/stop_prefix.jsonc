{
  "type_key": "era.tavern.flow.stop_prefix",
  "display_name": "释放实例全部运行资源：同步准备",
  "description": "复用原节点完成返回 Promise 前的立即资源变更；不引入第二份准入、回执或清理实现。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_stop_prefix_frame",
      "type": "era.tavern.frame.stop.owned_prepared",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.stop.owned_prepared",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "claim_stop",
        "type_used": "era.tavern.owned.claim_stop",
        "display_name": "只为第一次停止建立收尾回执",
        "description": "标记本实例首次资源关闭并进入同步清理路径；重入或重复卸载直接跳过，避免重复注销和结算，不建立对外停止Promise。"
      },
      {
        "id": "close_ingress",
        "type_used": "era.tavern.stop_accepting.close_ingress",
        "display_name": "标记停止并关闭接纳",
        "description": "设置停止状态，禁止新事件、能力和监听登记。"
      },
      {
        "id": "cancel_generations",
        "type_used": "era.tavern.stop_accepting.cancel_generations",
        "display_name": "取消作者函数与生成交接",
        "description": "同步取消本实例运行信号及生成资源；已登记的作者与生成释放回调只转交各自原生清理路径，不能保留原型空操作。"
      },
      {
        "id": "abort_waiters",
        "type_used": "era.tavern.stop.abort_waiters",
        "display_name": "取消接收和能力等待",
        "description": "中止实例控制器和 operational 控制器，拒绝挂起 receive，传播原取消原因。"
      },
      {
        "id": "remove_listeners",
        "type_used": "era.tavern.stop.remove_listeners",
        "display_name": "注销 Tavern 及取消监听",
        "description": "注销全部属于本实例的普通事件、按钮、原生观察和取消 listener；重复停止不重复注销。"
      },
      {
        "id": "clear_timers",
        "type_used": "era.tavern.stop.clear_timers",
        "display_name": "清除 timer 和屏障看门狗",
        "description": "逐项取消定时控制、延迟准入和 watchdog 句柄。"
      },
      {
        "id": "cancel_receipts_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "取消未决回执循环",
        "description": "每轮完成一个未决来源为 cancelled、释放该来源引用；原有已完成来源不重复结算。",
        "loop": {
          "body": "era.tavern.flow.stop_cancel_receipts_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.stop.clear_timers",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_stop_cancel_receipts_loop_frame"
            }
          ]
        },
        "requires": [
          {
            "type": "era.tavern.frame.stop.clear_timers",
            "cardinality": "exactly_one",
            "display_name": "当前请求、实例资源令牌及此前步骤取得的事实"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_stop_cancel_receipts_loop_frame",
            "type": "era.tavern.frame.stop.clear_timers",
            "display_name": "取消未决回执完成后的处理资料"
          }
        ]
      },
      {
        "id": "cancel_receipts",
        "type_used": "era.tavern.stop.cancel_receipts",
        "display_name": "汇总取消未决回执",
        "description": "将循环的终态资料转换为后续步骤使用的结果；不重复处理已经完成的条目。"
      },
      {
        "id": "clear_prompt",
        "type_used": "era.tavern.stop.clear_prompt",
        "display_name": "清理状态文件绑定弹窗",
        "description": "通过仍可执行的清理调用移除实例提示，不解释绑定业务结论。"
      },
      {
        "id": "reuse_stop",
        "type_used": "era.tavern.owned.reuse_stop",
        "display_name": "交回已有停止Promise",
        "description": "重复资源关闭只交回已关闭事实，不再次注销、结算或发出提示清理。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "abort_waiters",
        "remove_listeners"
      ],
      [
        "remove_listeners",
        "clear_timers"
      ],
      [
        "clear_timers",
        "cancel_receipts_loop"
      ],
      [
        "cancel_receipts",
        "clear_prompt"
      ],
      [
        "cancel_receipts_loop",
        "cancel_receipts"
      ],
      [
        "close_ingress",
        "cancel_generations"
      ],
      [
        "cancel_generations",
        "abort_waiters"
      ],
      [
        "start",
        "claim_stop"
      ],
      {
        "from": "claim_stop",
        "to": "close_ingress",
        "when": "owned_claim_stop_route == 'first'"
      },
      {
        "from": "claim_stop",
        "to": "reuse_stop",
        "when": "owned_claim_stop_route == 'existing'"
      },
      [
        "reuse_stop",
        "end"
      ],
      [
        "clear_prompt",
        "end"
      ]
    ]
  }
}
