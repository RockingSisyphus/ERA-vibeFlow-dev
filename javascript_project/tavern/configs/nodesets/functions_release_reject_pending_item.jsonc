{
  "type_key": "era.tavern.flow.functions_release_reject_pending_item",
  "display_name": "结束一项尚未确认的作者操作",
  "description": "当前作者调用已经释放时，取出一项未完成请求并以调用失效结束。外层重复直到没有剩余项目，再进入最终解绑。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.frame.functions_release.close_call",
      "cardinality": "exactly_one",
      "display_name": "结束一项尚未确认的作者操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_functions_release_reject_pending_item_frame",
      "type": "era.tavern.item.result.functions_release_reject_pending_item",
      "display_name": "结束一项尚未确认的作者操作的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_functions_release_reject_pending_item_done",
      "type": "era.tavern.done.functions_release.reject_pending",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.frame.functions_release.close_call",
        "display_name": "结束一项尚未确认的作者操作的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始结束一项尚未确认的作者操作",
        "description": "标明“结束一项尚未确认的作者操作”的开始位置。当前作者调用已经释放时，取出一项未完成请求并以调用失效结束。外层重复直到没有剩余项目，再进入最终解绑。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_item",
        "display_name": "检查还有哪些作者请求需要结束",
        "description": "在“结束一项尚未确认的作者操作”流程中，查看当前已关闭函数是否仍有等待确认的操作。还有时进入逐项拒绝，全部结束后进入解绑，避免作者一直等待无法完成的请求。",
        "definition_id": "era.tavern.functions_release_reject_pending_item.choose_item"
      },
      {
        "id": "one_item",
        "display_name": "结束一项尚未确认的作者请求",
        "description": "在“结束一项尚未确认的作者操作”流程中，取出当前函数一项未决请求，以调用已失效的原因结束它。外层重复本步骤直到清空，让所有等待该函数提交的调用都能结束。",
        "definition_id": "era.tavern.functions_release_reject_pending_item.one_item"
      },
      {
        "id": "empty",
        "display_name": "确认没有剩余作者请求需要结束",
        "description": "在“结束一项尚未确认的作者操作”流程中，当前作者调用的待确认列表已经为空时，标记本轮遍历结束。后续解除参数关联与取消监听，完成作者资料释放。",
        "definition_id": "era.tavern.functions_release_reject_pending_item.empty"
      },
      {
        "id": "join_end",
        "display_name": "交接结束一项尚未确认的作者操作的选中结果",
        "description": "在“结束一项尚未确认的作者操作”流程中，在“结束一项尚未确认的作者操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.functions_release_reject_pending_item.join_end"
      },
      {
        "id": "end",
        "display_name": "结束结束一项尚未确认的作者操作",
        "description": "标明“结束一项尚未确认的作者操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_item",
        "to": "one_item",
        "when": "era_tavern_functions_release_reject_pending_item_choose_item_route == 'item'"
      },
      {
        "from": "choose_item",
        "to": "empty",
        "when": "era_tavern_functions_release_reject_pending_item_choose_item_route == 'done'"
      },
      [
        "one_item",
        "join_end"
      ],
      [
        "empty",
        "join_end"
      ],
      [
        "start",
        "choose_item"
      ],
      [
        "join_end",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.item.result.functions_release_reject_pending_item",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "结束一项尚未确认的作者操作的处理进度及结果"
      },
      {
        "type": "era.tavern.done.functions_release.reject_pending",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ]
  }
}
