{
  "type_key": "era.tavern.flow.receive_prefix",
  "display_name": "接收队列事件或挂起等待：同步准备",
  "description": "复用原节点完成返回 Promise 前的立即资源变更；不引入第二份准入、回执或清理实现。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_receive_prefix_frame",
      "type": "era.tavern.frame.frame_receive.read_queue",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.frame_receive.read_queue",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "check_port",
        "type_used": "era.tavern.frame_receive.check_port",
        "display_name": "检查入站口和当前实例",
        "description": "检查端口、监听激活、停止及致命态，并拒绝第二个同时挂起的 receive。"
      },
      {
        "id": "read_queue",
        "type_used": "era.tavern.frame_receive.read_queue",
        "display_name": "取出队首或登记等待",
        "description": "队列有事件时原子取出队首；为空时登记唯一接收 Promise，联动实例和调用取消。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "check_port",
        "read_queue"
      ],
      [
        "start",
        "check_port"
      ],
      [
        "read_queue",
        "end"
      ]
    ]
  }
}
