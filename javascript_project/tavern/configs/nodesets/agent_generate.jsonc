{
  "type_key": "era.tavern.flow.agent_generate",
  "display_name": "准备并发起规划或结算的独立生成",
  "description": "接收主服务指定的提示、模型及连接要求，登记本次请求并标记辅助生成后发起模型调用。真实完成后由后续确认流程解除辅助标记、区分文字或失败，并将结果交回生成阶段。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "准备并发起规划或结算的独立生成的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_agent_generate_frame",
      "type": "era.tavern.frame.agent_generate.started",
      "display_name": "准备并发起规划或结算的独立生成的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "准备并发起规划或结算的独立生成的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.agent_generate.started",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "准备并发起规划或结算的独立生成的处理进度及结果"
      }
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始准备并发起规划或结算的独立生成",
        "description": "标明“准备并发起规划或结算的独立生成”的开始位置。接收主服务指定的提示、模型及连接要求，登记本次请求并标记辅助生成后发起模型调用。真实完成后由后续确认流程解除辅助标记、区分文字或失败，并将结果交回生成阶段。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_request",
        "display_name": "检查独立模型请求的提示资料",
        "description": "在“准备并发起规划或结算的独立生成”流程中，接收规划或结算等独立生成请求，确认用户输入和按顺序排列的提示内容格式齐全。有效资料继续用于发起模型请求，缺失时报告具体原因。",
        "definition_id": "era.tavern.agent_generate.check_request"
      },
      {
        "id": "prepare_request",
        "display_name": "登记本次独立生成的请求记录",
        "description": "在“准备并发起规划或结算的独立生成”流程中，为本次规划或结算模型调用分配身份，并记录所属聊天、阶段、输入和请求来源。后续生成结果可以对应到同一次调用，供运行观察和问题定位。",
        "definition_id": "era.tavern.agent_generate.prepare_request"
      },
      {
        "id": "enter_auxiliary",
        "display_name": "标记辅助生成正在运行（规划或结算的独立生成）",
        "description": "在“准备并发起规划或结算的独立生成”流程中，本次处理“规划或结算的独立生成”。将当前模型调用记入本实例正在进行的辅助生成数量。事件识别据此避免把辅助请求产生的事件误当作新的主故事生成，直到真实模型调用结束才解除标记。",
        "definition_id": "era.tavern.agent_generate.enter_auxiliary"
      },
      {
        "id": "start_operation",
        "display_name": "发起规划或结算的独立模型请求",
        "description": "在“准备并发起规划或结算的独立生成”流程中，按已指定连接、模型和采样设置组合提示，向模型发起本次独立生成。登记实际运行及完成后的处理，使后续可以等待并取得文字或失败原因。",
        "definition_id": "era.tavern.agent_generate.start_operation"
      },
      {
        "id": "end",
        "display_name": "结束准备并发起规划或结算的独立生成",
        "description": "标明“准备并发起规划或结算的独立生成”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_request",
        "prepare_request"
      ],
      [
        "prepare_request",
        "enter_auxiliary"
      ],
      [
        "enter_auxiliary",
        "start_operation"
      ],
      [
        "start",
        "check_request"
      ],
      [
        "start_operation",
        "end"
      ]
    ]
  }
}
