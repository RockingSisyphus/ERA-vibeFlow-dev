{
  "type_key": "era.tavern.flow.cap_sync_regex",
  "display_name": "分派角色正则规则操作",
  "description": "接收角色正则规则请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派角色正则规则操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_regex_frame",
      "type": "era.tavern.frame.final.cap_sync_regex",
      "display_name": "分派角色正则规则操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派角色正则规则操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_regex",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派角色正则规则操作的处理进度及结果"
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派角色正则规则操作",
        "description": "标明“分派角色正则规则操作”的开始位置。接收角色正则规则请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择角色正则规则的具体操作",
        "description": "在“分派角色正则规则操作”流程中，接收角色正则规则请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_regex.choose"
      },
      {
        "id": "route_read__check_request",
        "display_name": "检查“读取角色正则规则”的调用是否有效",
        "description": "在“分派角色正则规则操作”流程中，接收“读取角色正则规则”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.regex_read.check_request"
      },
      {
        "id": "route_read__execute",
        "display_name": "读取角色正则规则及启用状态",
        "description": "在“分派角色正则规则操作”流程中，读取当前角色的正则清单和开关，返回给资源规划。初始化据此判断状态栏显示规则是否已安装、是否需要补齐。",
        "definition_id": "era.tavern.regex_read.execute"
      },
      {
        "id": "route_read__return_result",
        "display_name": "交回“读取角色正则规则”的实际结果",
        "description": "在“分派角色正则规则操作”流程中，接收“读取角色正则规则”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.regex_read.return_result"
      },
      {
        "id": "route_upsert__check_request",
        "display_name": "检查“保存角色正则规则”的调用是否有效",
        "description": "在“分派角色正则规则操作”流程中，接收“保存角色正则规则”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.regex_upsert.check_request"
      },
      {
        "id": "route_upsert__start_operation",
        "display_name": "把指定正则加入角色规则并保存",
        "description": "在“分派角色正则规则操作”流程中，接收明确正则规则，附到当前角色已有清单，确认角色可写后发起保存。后续等待完成，再检查是否需要启用角色正则并刷新聊天。",
        "definition_id": "era.tavern.regex_upsert.start_operation"
      },
      {
        "id": "join_return",
        "display_name": "交接分派角色正则规则操作的选中结果",
        "description": "在“分派角色正则规则操作”流程中，在“分派角色正则规则操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_regex.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派角色正则规则操作",
        "description": "标明“分派角色正则规则操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__check_request",
        "when": "era_tavern_cap_sync_regex_choose_route == 'read'"
      },
      [
        "route_read__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_upsert__check_request",
        "when": "era_tavern_cap_sync_regex_choose_route == 'upsert'"
      },
      [
        "route_upsert__start_operation",
        "join_return"
      ],
      [
        "route_read__check_request",
        "route_read__execute"
      ],
      [
        "route_read__execute",
        "route_read__return_result"
      ],
      [
        "route_upsert__check_request",
        "route_upsert__start_operation"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
