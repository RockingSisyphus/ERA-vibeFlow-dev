{
  "type_key": "era.tavern.flow.sidecar_commit_metadata",
  "display_name": "绑定状态文件并按版本发布变量快照",
  "description": "核对当前聊天、消息和状态文件归属，保存聊天指向，再检查工作版本是否仍匹配。可发布时更新只读变量资料，最后回读实际绑定并返回确认，避免旧状态覆盖新状态。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "绑定状态文件并按版本发布变量快照的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_sidecar_commit_metadata_frame",
      "type": "era.tavern.call.frame",
      "display_name": "绑定状态文件并按版本发布变量快照的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "绑定状态文件并按版本发布变量快照的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "绑定状态文件并按版本发布变量快照的处理进度及结果",
        "as": "frame"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始绑定状态文件并按版本发布变量快照",
        "description": "标明“绑定状态文件并按版本发布变量快照”的开始位置。核对当前聊天、消息和状态文件归属，保存聊天指向，再检查工作版本是否仍匹配。可发布时更新只读变量资料，最后回读实际绑定并返回确认，避免旧状态覆盖新状态。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_pointer",
        "display_name": "确认文件绑定和变量读数属于当前聊天",
        "description": "在“绑定状态文件并按版本发布变量快照”流程中，接收要绑定的独立状态文件身份，核对目标消息、原绑定和待发布变量资料的归属。通过后才能更新聊天绑定，避免把其他聊天的数据接到当前聊天。",
        "definition_id": "era.tavern.sidecar_commit_metadata.check_pointer"
      },
      {
        "id": "write_pointer",
        "display_name": "保存聊天与独立状态文件的关联",
        "description": "在“绑定状态文件并按版本发布变量快照”流程中，将当前聊天的 ERA 记录更新为所选独立状态文件的指向，并移除已迁出聊天的旧变量数据。后续读取绑定和发布读数，使聊天使用统一状态来源。",
        "definition_id": "era.tavern.sidecar_commit_metadata.write_pointer"
      },
      {
        "id": "check_working_version",
        "display_name": "检查待发布变量是否仍是当前版本",
        "description": "在“绑定状态文件并按版本发布变量快照”流程中，查看准备发布的变量读数与当前聊天工作状态版本。版本仍匹配且有读数时继续发布，不符合时跳过，避免旧任务覆盖更新的页面状态。",
        "definition_id": "era.tavern.sidecar_commit_metadata.check_working_version"
      },
      {
        "id": "publish_snapshot",
        "display_name": "发布当前聊天已确认的变量读数（绑定文件并发布变量）",
        "description": "在“绑定状态文件并按版本发布变量快照”流程中，本次处理“绑定文件并发布变量”。将本次已确认的变量、函数及历史资料整理成只读快照，只有所属聊天仍是当前聊天时才更新页面并按需通知订阅者。其他聊天的迟到结果返回忽略确认。",
        "definition_id": "era.tavern.sidecar_commit_metadata.publish_snapshot"
      },
      {
        "id": "read_back",
        "display_name": "回读聊天实际保存的文件绑定",
        "description": "在“绑定状态文件并按版本发布变量快照”流程中，聊天文件指向更新后，重新读取聊天变量并返回实际绑定及文件身份。主服务据此确认当前聊天连接的是本次选择的独立状态文件。",
        "definition_id": "era.tavern.sidecar_commit_metadata.read_back"
      },
      {
        "id": "end",
        "display_name": "结束绑定状态文件并按版本发布变量快照",
        "description": "标明“绑定状态文件并按版本发布变量快照”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_pointer",
        "write_pointer"
      ],
      [
        "write_pointer",
        "check_working_version"
      ],
      [
        "publish_snapshot",
        "read_back"
      ],
      [
        "start",
        "check_pointer"
      ],
      [
        "read_back",
        "end"
      ],
      {
        "from": "check_working_version",
        "to": "publish_snapshot",
        "when": "era_tavern_sidecar_commit_metadata_check_working_version_route == 'publish'"
      },
      {
        "from": "check_working_version",
        "to": "read_back",
        "when": "era_tavern_sidecar_commit_metadata_check_working_version_route == 'skip'"
      }
    ]
  }
}
