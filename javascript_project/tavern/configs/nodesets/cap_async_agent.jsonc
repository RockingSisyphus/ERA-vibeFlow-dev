{
  "type_key": "era.tavern.flow.cap_async_agent",
  "display_name": "完成模型生成和生成设置操作",
  "description": "接收已经发起、需要等待的模型生成和生成设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成模型生成和生成设置操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_agent_frame",
      "type": "era.tavern.frame.final.cap_async_agent",
      "display_name": "完成模型生成和生成设置操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成模型生成和生成设置操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_agent",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成模型生成和生成设置操作的处理进度及结果"
      }
    ],
    "max_steps": 25,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成模型生成和生成设置操作",
        "description": "标明“完成模型生成和生成设置操作”的开始位置。接收已经发起、需要等待的模型生成和生成设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择模型生成和生成设置的具体操作",
        "description": "在“完成模型生成和生成设置操作”流程中，接收模型生成和生成设置请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_agent.choose"
      },
      {
        "id": "route_await_native_completion__wait_terminal",
        "display_name": "等待已登记的酒馆生成结束",
        "description": "在“完成模型生成和生成设置操作”流程中，接收已经绑定到某次聊天生成的等待，取得其完成、取消或非酒馆生成状态。随后重新读取聊天及最新消息，供主服务判断正文是否仍适用。",
        "definition_id": "era.tavern.agent_await_native_completion.wait_terminal"
      },
      {
        "id": "route_await_native_completion__read_current",
        "display_name": "生成结束后重新读取聊天和最新消息",
        "description": "在“完成模型生成和生成设置操作”流程中，指定生成结束后，重新读取当前会话进度、聊天身份及最新消息，连同结束结论返回。主服务据此确认结果仍属于原聊天和原次生成，再继续规划或结算。",
        "definition_id": "era.tavern.agent_await_native_completion.read_current"
      },
      {
        "id": "route_await_native_completion__return_native",
        "display_name": "返回指定酒馆生成的结束及最新消息",
        "description": "在“完成模型生成和生成设置操作”流程中，接收本次生成结束状态和重新读取的聊天、最新消息，交回主服务。主服务可据此确认正文仍属于原生成，再继续规划或结算。",
        "definition_id": "era.tavern.agent_await_native_completion.return_native"
      },
      {
        "id": "route_write_configuration__execute",
        "display_name": "等待角色生成配置保存完成",
        "description": "在“完成模型生成和生成设置操作”流程中，接收已经发起的角色配置写入，等待酒馆保存完成。保留成功或失败结果，供设置请求返回真实确认。",
        "definition_id": "era.tavern.agent_write_configuration.execute"
      },
      {
        "id": "route_write_configuration__return_result",
        "display_name": "交回“保存角色生成配置”的实际结果",
        "description": "在“完成模型生成和生成设置操作”流程中，接收“保存角色生成配置”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_write_configuration.return_result"
      },
      {
        "id": "route_upsert_connection_profile__execute",
        "display_name": "等待本机连接设置保存完成（保存本机连接方案）",
        "description": "在“完成模型生成和生成设置操作”流程中，本次处理“保存本机连接方案”。接收已经发起的连接方案保存操作，等待实际保存结束。完成或失败后保留相应结果，供连接管理请求返回确认。",
        "definition_id": "era.tavern.agent_upsert_connection_profile.execute"
      },
      {
        "id": "route_upsert_connection_profile__return_result",
        "display_name": "交回“保存本机连接方案”的实际结果",
        "description": "在“完成模型生成和生成设置操作”流程中，接收“保存本机连接方案”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_upsert_connection_profile.return_result"
      },
      {
        "id": "route_delete_connection_profile__execute",
        "display_name": "等待本机连接设置保存完成（删除本机连接方案）",
        "description": "在“完成模型生成和生成设置操作”流程中，本次处理“删除本机连接方案”。接收已经发起的连接方案保存操作，等待实际保存结束。完成或失败后保留相应结果，供连接管理请求返回确认。",
        "definition_id": "era.tavern.agent_delete_connection_profile.execute"
      },
      {
        "id": "route_delete_connection_profile__return_result",
        "display_name": "交回“删除本机连接方案”的实际结果",
        "description": "在“完成模型生成和生成设置操作”流程中，接收“删除本机连接方案”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_delete_connection_profile.return_result"
      },
      {
        "id": "route_clear_connection_profile_key__execute",
        "display_name": "等待本机连接设置保存完成（清除本机连接密钥）",
        "description": "在“完成模型生成和生成设置操作”流程中，本次处理“清除本机连接密钥”。接收已经发起的连接方案保存操作，等待实际保存结束。完成或失败后保留相应结果，供连接管理请求返回确认。",
        "definition_id": "era.tavern.agent_clear_connection_profile_key.execute"
      },
      {
        "id": "route_clear_connection_profile_key__return_result",
        "display_name": "交回“清除本机连接密钥”的实际结果",
        "description": "在“完成模型生成和生成设置操作”流程中，接收“清除本机连接密钥”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_clear_connection_profile_key.return_result"
      },
      {
        "id": "route_list_connection_models",
        "display_name": "读取已保存连接的模型查询结果",
        "description": "本环节用于“完成模型生成和生成设置操作”：接收本机连接已经发起的模型查询，等待响应并整理有效模型名称。结果附上不含密钥的连接摘要，失败时说明哪项连接查询没有完成。",
        "definition_id": "era.tavern.flow.agent_list_connection_models_finish"
      },
      {
        "id": "route_list_connection_models_draft",
        "display_name": "读取未保存连接草稿的模型查询结果",
        "description": "本环节用于“完成模型生成和生成设置操作”：接收连接草稿已经发起的模型查询，等待响应，检查成功后读取并整理模型名称。失败带回具体原因，成功列表供用户选模型，无需先保存草稿。",
        "definition_id": "era.tavern.flow.agent_list_connection_models_draft_finish"
      },
      {
        "id": "route_generate",
        "display_name": "整理独立模型请求完成后的结果",
        "description": "本环节用于“完成模型生成和生成设置操作”：接收已发起模型调用的真实完成资料，检查辅助生成标记已解除，区分文字、取消和失败。返回文字及连接摘要或具体失败，使主服务继续检查该阶段输出。",
        "definition_id": "era.tavern.flow.agent_generate_finish"
      },
      {
        "id": "route_generate_story",
        "display_name": "整理正文重试完成后的文字或错误",
        "description": "本环节用于“完成模型生成和生成设置操作”：接收酒馆正文生成的真实结束资料，确认辅助标记已解除，按取消、失败或文字响应返回。主服务据此继续处理本次正文的变量和函数指令。",
        "definition_id": "era.tavern.flow.agent_generate_story_finish"
      },
      {
        "id": "route_create_error_message__execute",
        "display_name": "等待生成失败提示写入聊天",
        "description": "在“完成模型生成和生成设置操作”流程中，接收已经发起的系统错误消息创建，等待实际结束后返回创建确认。上层据此知道失败说明是否已经显示在聊天中。",
        "definition_id": "era.tavern.agent_create_error_message.execute"
      },
      {
        "id": "route_create_error_message__return_result",
        "display_name": "交回“创建生成失败提示”的实际结果",
        "description": "在“完成模型生成和生成设置操作”流程中，接收“创建生成失败提示”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_create_error_message.return_result"
      },
      {
        "id": "join_return",
        "display_name": "交接完成模型生成和生成设置操作的选中结果",
        "description": "在“完成模型生成和生成设置操作”流程中，在“完成模型生成和生成设置操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_agent.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成模型生成和生成设置操作",
        "description": "标明“完成模型生成和生成设置操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_await_native_completion__wait_terminal",
        "when": "era_tavern_cap_async_agent_choose_route == 'await_native_completion'"
      },
      [
        "route_await_native_completion__return_native",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_write_configuration__execute",
        "when": "era_tavern_cap_async_agent_choose_route == 'write_configuration'"
      },
      [
        "route_write_configuration__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_upsert_connection_profile__execute",
        "when": "era_tavern_cap_async_agent_choose_route == 'upsert_connection_profile'"
      },
      [
        "route_upsert_connection_profile__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_delete_connection_profile__execute",
        "when": "era_tavern_cap_async_agent_choose_route == 'delete_connection_profile'"
      },
      [
        "route_delete_connection_profile__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_clear_connection_profile_key__execute",
        "when": "era_tavern_cap_async_agent_choose_route == 'clear_connection_profile_key'"
      },
      [
        "route_clear_connection_profile_key__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_list_connection_models",
        "when": "era_tavern_cap_async_agent_choose_route == 'list_connection_models'"
      },
      [
        "route_list_connection_models",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_list_connection_models_draft",
        "when": "era_tavern_cap_async_agent_choose_route == 'list_connection_models_draft'"
      },
      [
        "route_list_connection_models_draft",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_generate",
        "when": "era_tavern_cap_async_agent_choose_route == 'generate'"
      },
      [
        "route_generate",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_generate_story",
        "when": "era_tavern_cap_async_agent_choose_route == 'generate_story'"
      },
      [
        "route_generate_story",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_create_error_message__execute",
        "when": "era_tavern_cap_async_agent_choose_route == 'create_error_message'"
      },
      [
        "route_create_error_message__return_result",
        "join_return"
      ],
      [
        "route_await_native_completion__wait_terminal",
        "route_await_native_completion__read_current"
      ],
      [
        "route_await_native_completion__read_current",
        "route_await_native_completion__return_native"
      ],
      [
        "route_write_configuration__execute",
        "route_write_configuration__return_result"
      ],
      [
        "route_upsert_connection_profile__execute",
        "route_upsert_connection_profile__return_result"
      ],
      [
        "route_delete_connection_profile__execute",
        "route_delete_connection_profile__return_result"
      ],
      [
        "route_clear_connection_profile_key__execute",
        "route_clear_connection_profile_key__return_result"
      ],
      [
        "route_create_error_message__execute",
        "route_create_error_message__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
