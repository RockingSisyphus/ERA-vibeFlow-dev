{
  "type_key": "era.tavern.flow.native_stop_retry",
  "display_name": "命令阶段结束后补做一次生成停止",
  "description": "检查此前登记的单次延后停止是否仍属于当前实例。有效时先解除监听再尝试停止酒馆生成，过期时直接结束，返回本次实际结果。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "命令阶段结束后补做一次生成停止的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_native_stop_retry_frame",
      "type": "era.tavern.frame.native_stop_retry.returned",
      "display_name": "命令阶段结束后补做一次生成停止的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "命令阶段结束后补做一次生成停止的请求和已有进度"
      }
    ],
    "max_steps": 24,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始命令阶段结束后补做一次生成停止",
        "description": "标明“命令阶段结束后补做一次生成停止”的开始位置。检查此前登记的单次延后停止是否仍属于当前实例。有效时先解除监听再尝试停止酒馆生成，过期时直接结束，返回本次实际结果。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_active",
        "display_name": "检查延后停止安排是否仍有效",
        "description": "在“命令阶段结束后补做一次生成停止”流程中，命令阶段结束后，核对收到的停止安排是否仍属于当前实例，且实例没有停止。有效时执行一次停止尝试，已经过期或被替换时忽略。",
        "definition_id": "era.tavern.owned.choose_native_retry"
      },
      {
        "id": "attempt_once",
        "display_name": "执行有效的单次延后停止",
        "description": "在“命令阶段结束后补做一次生成停止”流程中，收到仍有效的延后停止安排后，先解除该单次监听，再尝试停止酒馆正文生成。记录实际结果，防止同一安排反复触发。",
        "definition_id": "era.tavern.owned.attempt_native_retry"
      },
      {
        "id": "ignore_stale",
        "display_name": "结束已经过期的延后停止安排",
        "description": "在“命令阶段结束后补做一次生成停止”流程中，收到已经被替换或实例已停止的旧安排时，直接结束本次处理。后续生成不会因此被误停。",
        "definition_id": "era.tavern.owned.ignore_native_retry"
      },
      {
        "id": "return_retry",
        "display_name": "返回延后停止的有效尝试或忽略结果",
        "description": "在“命令阶段结束后补做一次生成停止”流程中，接收本实例单次停止安排的实际执行结果，或旧安排失效后的空结论，交回同步回调。停止监听已由相应分支处理。",
        "definition_id": "era.tavern.owned.return_native_retry"
      },
      {
        "id": "end",
        "display_name": "结束命令阶段结束后补做一次生成停止",
        "description": "标明“命令阶段结束后补做一次生成停止”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "choose_active"
      ],
      {
        "from": "choose_active",
        "to": "attempt_once",
        "when": "owned_choose_native_retry_route == 'active'"
      },
      {
        "from": "choose_active",
        "to": "ignore_stale",
        "when": "owned_choose_native_retry_route == 'stale'"
      },
      [
        "attempt_once",
        "return_retry"
      ],
      [
        "ignore_stale",
        "return_retry"
      ],
      [
        "return_retry",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.native_stop_retry.returned",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "命令阶段结束后补做一次生成停止的处理进度及结果"
      }
    ]
  }
}
