{
  "type_key": "era.tavern.flow.functions_begin",
  "display_name": "建立作者函数调用并安排执行",
  "description": "检查调用身份和目标消息，建立参数、操作接口及取消关联，再把函数加入作者队列。返回已安排确认，消息流程随后等待作者操作或结束。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "建立作者函数调用并安排执行的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_functions_begin_frame",
      "type": "era.tavern.call.frame",
      "display_name": "建立作者函数调用并安排执行的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "建立作者函数调用并安排执行的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始建立作者函数调用并安排执行",
        "description": "标明“建立作者函数调用并安排执行”的开始位置。检查调用身份和目标消息，建立参数、操作接口及取消关联，再把函数加入作者队列。返回已安排确认，消息流程随后等待作者操作或结束。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_call",
        "display_name": "检查作者函数调用身份和目标消息",
        "description": "在“建立作者函数调用并安排执行”流程中，接收准备启动的作者自定义 JavaScript 函数调用，确认调用身份尚未使用、请求未取消，且目标消息仍匹配。通过后才建立运行资料，避免旧消息中的函数误执行。",
        "definition_id": "era.tavern.functions_begin.check_call"
      },
      {
        "id": "bind_context",
        "display_name": "给作者函数绑定所在消息位置的变量读写",
        "description": "作者函数在轮到它的位置读取当前工作变量。该函数提交局部变更并收到回执后，仍从同一工作状态读取。调用结束后主服务继续处理后面的块；保存仍由整轮处理流程负责。",
        "definition_id": "era.tavern.functions_begin.bind_context"
      },
      {
        "id": "schedule_tool",
        "display_name": "将作者函数加入按顺序执行的队列",
        "description": "在“建立作者函数调用并安排执行”流程中，接收已建立运行资料的作者函数，把它交给本实例的作者执行队列并唤醒等待者。作者执行分支按顺序运行，主服务仍可协作处理函数提出的变量提交。",
        "definition_id": "era.tavern.functions_begin.schedule_tool"
      },
      {
        "id": "return_call",
        "display_name": "确认作者函数已安排执行",
        "description": "在“建立作者函数调用并安排执行”流程中，返回本次作者函数已经启动安排的确认及调用身份。主服务据此进入后续请求等待，实际函数结果由作者执行及消息流程共同完成。",
        "definition_id": "era.tavern.functions_begin.return_call"
      },
      {
        "id": "end",
        "display_name": "结束建立作者函数调用并安排执行",
        "description": "标明“建立作者函数调用并安排执行”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_call",
        "bind_context"
      ],
      [
        "bind_context",
        "schedule_tool"
      ],
      [
        "schedule_tool",
        "return_call"
      ],
      [
        "start",
        "check_call"
      ],
      [
        "return_call",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "建立作者函数调用并安排执行的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
