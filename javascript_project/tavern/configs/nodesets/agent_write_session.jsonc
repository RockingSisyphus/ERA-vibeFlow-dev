{
  "type_key": "era.tavern.flow.agent_write_session",
  "display_name": "更新本聊天在页面中的生成进度",
  "description": "接收主服务给出的生成会话，按需建立正文观察和结束等待，复制保存本页聊天进度并通知界面。返回更新确认，后续阶段可继续读取这份进度。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "更新本聊天在页面中的生成进度的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_agent_write_session_frame",
      "type": "era.tavern.call.frame",
      "display_name": "更新本聊天在页面中的生成进度的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "更新本聊天在页面中的生成进度的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 14,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始更新本聊天在页面中的生成进度",
        "description": "标明“更新本聊天在页面中的生成进度”的开始位置。接收主服务给出的生成会话，按需建立正文观察和结束等待，复制保存本页聊天进度并通知界面。返回更新确认，后续阶段可继续读取这份进度。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_chat",
        "display_name": "检查生成进度要保存到哪个聊天",
        "description": "在“更新本聊天在页面中的生成进度”流程中，确认页面生成进度的写入请求明确指定聊天。有效后继续更新该聊天的会话记录，避免把不同聊天的阶段进度混在一起。",
        "definition_id": "era.tavern.agent_write_session.check_chat"
      },
      {
        "id": "choose_observation",
        "display_name": "判断是否开始跟踪新的正文生成",
        "description": "在“更新本聊天在页面中的生成进度”流程中，读取本次生成进度写入要求，区分需要新建正文观察记录，还是继续使用提供的会话。后续据此登记或保留本次生成。",
        "definition_id": "era.tavern.agent_write_session.choose_observation"
      },
      {
        "id": "select_keep",
        "display_name": "沿用本次提供的生成进度",
        "description": "在“更新本聊天在页面中的生成进度”流程中，接收主服务已提供的生成会话，交给后续观察及存储。适用于不需要重新建立正文生成观察的进度更新。",
        "definition_id": "era.tavern.agent_write_session.select_keep"
      },
      {
        "id": "select_start",
        "display_name": "建立本次正文生成的观察记录",
        "description": "在“更新本聊天在页面中的生成进度”流程中，为当前正文生成登记请求身份、聊天、模型和预设，并把它附到生成会话。后续可以将正文完成情况对应到正确的这次生成。",
        "definition_id": "era.tavern.agent_write_session.select_start"
      },
      {
        "id": "join_begin_observation",
        "display_name": "交接更新页面生成进度的选中结果",
        "description": "在“更新本聊天在页面中的生成进度”流程中，在“更新页面生成进度”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.agent_write_session.join_begin_observation"
      },
      {
        "id": "begin_observation",
        "display_name": "登记生成结束和阶段完成的等待",
        "description": "在“更新本聊天在页面中的生成进度”流程中，接收生成会话更新，按需建立本次酒馆生成结束及阶段交接的等待记录。新周期会结束被替换的旧周期等待，让后续请求只跟随当前有效生成。",
        "definition_id": "era.tavern.agent_write_session.begin_observation"
      },
      {
        "id": "store_session",
        "display_name": "保存本聊天在当前页面的生成进度",
        "description": "在“更新本聊天在页面中的生成进度”流程中，将本次会话资料复制保存到当前实例的聊天记录，正文已完成时同步更新观察结果。后续阶段读取这一进度来继续生成；它是本页运行资料，并非聊天消息的保存操作。",
        "definition_id": "era.tavern.agent_write_session.store_session"
      },
      {
        "id": "publish_session",
        "display_name": "通知页面生成进度已经更新",
        "description": "在“更新本聊天在页面中的生成进度”流程中，生成会话已经更新后，通知观察界面重新读取进度，并返回该聊天更新完成的确认。使用户能看到当前规划、正文或结算阶段状态。",
        "definition_id": "era.tavern.agent_write_session.publish_session"
      },
      {
        "id": "end",
        "display_name": "结束更新本聊天在页面中的生成进度",
        "description": "标明“更新本聊天在页面中的生成进度”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_chat",
        "choose_observation"
      ],
      [
        "begin_observation",
        "store_session"
      ],
      [
        "store_session",
        "publish_session"
      ],
      {
        "from": "choose_observation",
        "to": "select_start",
        "when": "era_tavern_agent_write_session_choose_observation_route == 'start'"
      },
      [
        "select_start",
        "join_begin_observation"
      ],
      {
        "from": "choose_observation",
        "to": "select_keep",
        "when": "era_tavern_agent_write_session_choose_observation_route == 'keep'"
      },
      [
        "select_keep",
        "join_begin_observation"
      ],
      [
        "join_begin_observation",
        "begin_observation"
      ],
      [
        "start",
        "check_chat"
      ],
      [
        "publish_session",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "更新本聊天在页面中的生成进度的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
