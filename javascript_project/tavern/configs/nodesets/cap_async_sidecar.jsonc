{
  "type_key": "era.tavern.flow.cap_async_sidecar",
  "display_name": "独立状态文件与内存快照操作：异步完成",
  "description": "只保留真正等待的操作；完全同步的 Promise 接口没有本入口分支。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_sidecar_frame",
      "type": "era.tavern.frame.final.cap_async_sidecar",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_sidecar",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_async_sidecar.choose",
        "display_name": "识别独立状态文件与内存快照操作",
        "description": "按原 Capability 的操作名选择唯一 async 路径，操作原参数、返回类型和错误身份保持。"
      },
      {
        "id": "route_read_record",
        "type_used": "era.tavern.flow.sidecar_read_record_finish",
        "display_name": "读取状态文件：独立状态文件与内存快照：等待与确认",
        "description": "只续用本次同步段已经发起的资源；具体等待与确认在所选原生路径。"
      },
      {
        "id": "route_write_record__upload_file",
        "type_used": "era.tavern.sidecar_write_record.upload_file",
        "display_name": "保存独立状态文件：等待与确认：等待本次保存独立状态文件的资源终态",
        "description": "调用 /api/files/upload，保持原鉴权、signal 和网络失败行为。"
      },
      {
        "id": "route_write_record__return_file",
        "type_used": "era.tavern.sidecar_write_record.return_file",
        "display_name": "保存独立状态文件：等待与确认：返回文件写入确认",
        "description": "只有实际响应成功才返回 committed、SidecarId 和原文件 URL。"
      },
      {
        "id": "join_return",
        "type_used": "era.tavern.cap_async_sidecar.join_return",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read_record",
        "when": "era_tavern_cap_async_sidecar_choose_route == 'read_record'"
      },
      [
        "route_read_record",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_write_record__upload_file",
        "when": "era_tavern_cap_async_sidecar_choose_route == 'write_record'"
      },
      [
        "route_write_record__return_file",
        "join_return"
      ],
      [
        "route_write_record__upload_file",
        "route_write_record__return_file"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
