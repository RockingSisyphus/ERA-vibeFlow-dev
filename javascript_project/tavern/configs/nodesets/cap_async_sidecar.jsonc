{
  "type_key": "era.tavern.flow.cap_async_sidecar",
  "display_name": "完成独立状态文件和变量快照操作",
  "description": "接收已经发起、需要等待的独立状态文件和变量快照操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成独立状态文件和变量快照操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_sidecar_frame",
      "type": "era.tavern.frame.final.cap_async_sidecar",
      "display_name": "完成独立状态文件和变量快照操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成独立状态文件和变量快照操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_sidecar",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成独立状态文件和变量快照操作的处理进度及结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成独立状态文件和变量快照操作",
        "description": "标明“完成独立状态文件和变量快照操作”的开始位置。接收已经发起、需要等待的独立状态文件和变量快照操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择独立状态文件和变量快照的具体操作",
        "description": "在“完成独立状态文件和变量快照操作”流程中，接收独立状态文件和变量快照请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_sidecar.choose"
      },
      {
        "id": "route_read_record",
        "display_name": "读取状态文件内容并区分可用或损坏",
        "description": "本环节用于“完成独立状态文件和变量快照操作”：接收已发起的文件请求，等待响应，明确区分缺失、成功和服务失败。成功文件读出文字并检查能否解析，交回记录或无效结论，供绑定及修复选择。",
        "definition_id": "era.tavern.flow.sidecar_read_record_finish"
      },
      {
        "id": "route_write_record__upload_file",
        "display_name": "确认独立状态文件上传成功",
        "description": "在“完成独立状态文件和变量快照操作”流程中，接收已经发起的文件上传，等待完成并检查成功响应。成功时返回文件身份和地址，失败时报告具体原因，供上层决定继续绑定还是恢复处理。",
        "definition_id": "era.tavern.sidecar_write_record.upload_file"
      },
      {
        "id": "route_write_record__return_file",
        "display_name": "交回“保存独立状态文件”的实际结果",
        "description": "在“完成独立状态文件和变量快照操作”流程中，接收“保存独立状态文件”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.sidecar_write_record.return_file"
      },
      {
        "id": "join_return",
        "display_name": "交接完成独立状态文件和变量快照操作的选中结果",
        "description": "在“完成独立状态文件和变量快照操作”流程中，在“完成独立状态文件和变量快照操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_sidecar.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成独立状态文件和变量快照操作",
        "description": "标明“完成独立状态文件和变量快照操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read_record",
        "when": "era_tavern_cap_async_sidecar_choose_route == 'read_record'"
      },
      [
        "route_read_record",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_write_record__upload_file",
        "when": "era_tavern_cap_async_sidecar_choose_route == 'write_record'"
      },
      [
        "route_write_record__return_file",
        "join_return"
      ],
      [
        "route_write_record__upload_file",
        "route_write_record__return_file"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
