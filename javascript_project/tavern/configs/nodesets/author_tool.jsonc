{
  "type_key": "era.tavern.flow.author_tool",
  "display_name": "实际运行已安排的作者函数",
  "description": "接收作者执行队列取出的函数和参数，调用酒馆注册的作者 JavaScript 工具并等待结束。记录实际错误或完成状态，再唤醒消息流程确认函数是否还有未处理操作。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "实际运行已安排的作者函数的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_author_tool_frame",
      "type": "era.tavern.task.finished",
      "display_name": "当前职责已真实完成或退出的确认"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "实际运行已安排的作者函数的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始实际运行已安排的作者函数",
        "description": "标明“实际运行已安排的作者函数”的开始位置。接收作者执行队列取出的函数和参数，调用酒馆注册的作者 JavaScript 工具并等待结束。记录实际错误或完成状态，再唤醒消息流程确认函数是否还有未处理操作。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "read_call",
        "display_name": "读取已安排的作者函数和参数",
        "description": "在“实际运行已安排的作者函数”流程中，接收作者执行队列交来的调用，确认本次运行资料存在。将作者函数名称、参数和有效性资料交给实际调用步骤。",
        "definition_id": "era.tavern.author_tool.read_call"
      },
      {
        "id": "invoke_tool",
        "display_name": "执行作者注册的 JavaScript 函数",
        "description": "用本次函数名称和参数调用酒馆注册的作者工具。实际调用结束时关闭新操作的入口，保留已接收操作的结算，并把调用结果交给下一步记录。",
        "definition_id": "era.tavern.author_tool.invoke_tool"
      },
      {
        "id": "record_terminal",
        "display_name": "记录作者函数真正结束及错误",
        "description": "在“实际运行已安排的作者函数”流程中，接收作者工具的实际完成结果，将失败原因写入本次调用并标记函数结束。后续等待方可以区分函数已完成与仍在运行。",
        "definition_id": "era.tavern.author_tool.record_terminal"
      },
      {
        "id": "wake_next",
        "display_name": "通知消息流程作者函数已结束",
        "description": "在“实际运行已安排的作者函数”流程中，作者工具结束情况已经记录后，唤醒正在等它下一步的消息流程。返回本轮作者执行完成确认，外层才会取下一个作者调用。",
        "definition_id": "era.tavern.author_tool.wake_next"
      },
      {
        "id": "end",
        "display_name": "结束实际运行已安排的作者函数",
        "description": "标明“实际运行已安排的作者函数”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "read_call",
        "invoke_tool"
      ],
      [
        "invoke_tool",
        "record_terminal"
      ],
      [
        "record_terminal",
        "wake_next"
      ],
      [
        "start",
        "read_call"
      ],
      [
        "wake_next",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.task.finished",
        "cardinality": "exactly_one",
        "display_name": "当前职责已真实完成或退出的确认",
        "as": "frame"
      }
    ]
  }
}
