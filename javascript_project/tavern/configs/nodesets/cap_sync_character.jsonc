{
  "type_key": "era.tavern.flow.cap_sync_character",
  "display_name": "分派角色卡和显示设置操作",
  "description": "接收角色卡和显示设置请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派角色卡和显示设置操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_character_frame",
      "type": "era.tavern.frame.final.cap_sync_character",
      "display_name": "分派角色卡和显示设置操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派角色卡和显示设置操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_character",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派角色卡和显示设置操作的处理进度及结果"
      }
    ],
    "max_steps": 21,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派角色卡和显示设置操作",
        "description": "标明“分派角色卡和显示设置操作”的开始位置。接收角色卡和显示设置请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择角色卡和显示设置的具体操作",
        "description": "在“分派角色卡和显示设置操作”流程中，接收角色卡和显示设置请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_character.choose"
      },
      {
        "id": "route_patch_single_floor__check_request",
        "display_name": "检查“保存单层显示设置”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“保存单层显示设置”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_patch_single_floor.check_request"
      },
      {
        "id": "route_patch_single_floor__start_operation",
        "display_name": "向角色卡保存单层显示或外置状态栏设置（保存单层显示设置）",
        "description": "在“分派角色卡和显示设置操作”流程中，本次处理“保存单层显示设置”。读取目标角色及请求的显示配置，合并本次明确改动并发起角色卡保存。保留目标角色与设置内容，供后续确认保存后更新页面。",
        "definition_id": "era.tavern.character_patch_single_floor.start_operation"
      },
      {
        "id": "route_patch_external_statusbar__check_request",
        "display_name": "检查“保存外置状态栏设置”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“保存外置状态栏设置”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_patch_external_statusbar.check_request"
      },
      {
        "id": "route_patch_external_statusbar__start_operation",
        "display_name": "向角色卡保存单层显示或外置状态栏设置（保存外置状态栏设置）",
        "description": "在“分派角色卡和显示设置操作”流程中，本次处理“保存外置状态栏设置”。读取目标角色及请求的显示配置，合并本次明确改动并发起角色卡保存。保留目标角色与设置内容，供后续确认保存后更新页面。",
        "definition_id": "era.tavern.character_patch_external_statusbar.start_operation"
      },
      {
        "id": "route_read_main_greeting__check_request",
        "display_name": "检查“读取角色主开场白”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“读取角色主开场白”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_read_main_greeting.check_request"
      },
      {
        "id": "route_read_main_greeting__start_operation",
        "display_name": "发起读取当前角色的主开场白",
        "description": "在“分派角色卡和显示设置操作”流程中，识别当前角色，发起角色资料读取。群聊或没有角色时记录不可用情况，后续将主开场白和相关状态栏设置交回资源准备流程。",
        "definition_id": "era.tavern.character_read_main_greeting.start_operation"
      },
      {
        "id": "route_write_main_greeting__check_request",
        "display_name": "检查“保存角色主开场白”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“保存角色主开场白”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_write_main_greeting.check_request"
      },
      {
        "id": "route_write_main_greeting__start_operation",
        "display_name": "写入前重新读取角色主开场白",
        "description": "在“分派角色卡和显示设置操作”流程中，接收预期旧开场白和新文字，确认当前存在可写的单角色，再发起角色资料读取。后续先核对旧内容是否仍一致，避免初始化覆盖期间发生的新编辑。",
        "definition_id": "era.tavern.character_write_main_greeting.start_operation"
      },
      {
        "id": "route_read_greeting_refresh_context__check_request",
        "display_name": "检查“读取开场白更新依据”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“读取开场白更新依据”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_read_greeting_refresh_context.check_request"
      },
      {
        "id": "route_read_greeting_refresh_context__execute",
        "display_name": "读取首条消息是否适合更新开场白",
        "description": "在“分派角色卡和显示设置操作”流程中，读取当前是否群聊、聊天是否有改动、消息数量及首条消息的原文和所选回复。主服务据此决定更新、新建还是保留当前首条消息。",
        "definition_id": "era.tavern.character_read_greeting_refresh_context.execute"
      },
      {
        "id": "route_read_greeting_refresh_context__return_result",
        "display_name": "交回“读取开场白更新依据”的实际结果",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“读取开场白更新依据”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.character_read_greeting_refresh_context.return_result"
      },
      {
        "id": "route_apply_greeting_refresh__check_request",
        "display_name": "检查“更新聊天开场白显示”的调用是否有效",
        "description": "在“分派角色卡和显示设置操作”流程中，接收“更新聊天开场白显示”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.character_apply_greeting_refresh.check_request"
      },
      {
        "id": "route_apply_greeting_refresh__start_operation",
        "display_name": "更新聊天首条消息并发出接收通知",
        "description": "在“分派角色卡和显示设置操作”流程中，根据主服务已经选定的方案，在空聊天建立开场白，或更新已有首条消息及其原始回复。随后发出首条消息接收通知，后续等待通知、重绘并保存聊天。",
        "definition_id": "era.tavern.character_apply_greeting_refresh.start_operation"
      },
      {
        "id": "join_return",
        "display_name": "交接分派角色卡和显示设置操作的选中结果",
        "description": "在“分派角色卡和显示设置操作”流程中，在“分派角色卡和显示设置操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_character.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派角色卡和显示设置操作",
        "description": "标明“分派角色卡和显示设置操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_patch_single_floor__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'patch_single_floor'"
      },
      [
        "route_patch_single_floor__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_patch_external_statusbar__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'patch_external_statusbar'"
      },
      [
        "route_patch_external_statusbar__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_read_main_greeting__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'read_main_greeting'"
      },
      [
        "route_read_main_greeting__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_write_main_greeting__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'write_main_greeting'"
      },
      [
        "route_write_main_greeting__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_read_greeting_refresh_context__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'read_greeting_refresh_context'"
      },
      [
        "route_read_greeting_refresh_context__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_apply_greeting_refresh__check_request",
        "when": "era_tavern_cap_sync_character_choose_route == 'apply_greeting_refresh'"
      },
      [
        "route_apply_greeting_refresh__start_operation",
        "join_return"
      ],
      [
        "route_patch_single_floor__check_request",
        "route_patch_single_floor__start_operation"
      ],
      [
        "route_patch_external_statusbar__check_request",
        "route_patch_external_statusbar__start_operation"
      ],
      [
        "route_read_main_greeting__check_request",
        "route_read_main_greeting__start_operation"
      ],
      [
        "route_write_main_greeting__check_request",
        "route_write_main_greeting__start_operation"
      ],
      [
        "route_read_greeting_refresh_context__check_request",
        "route_read_greeting_refresh_context__execute"
      ],
      [
        "route_read_greeting_refresh_context__execute",
        "route_read_greeting_refresh_context__return_result"
      ],
      [
        "route_apply_greeting_refresh__check_request",
        "route_apply_greeting_refresh__start_operation"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
