{
  "type_key": "era.tavern.flow.timer_wait",
  "display_name": "等待最近期限并处理到期或取消",
  "description": "等待选出的最近有效期限，到期时交给统一计时流程，安排变化或停止时结束本轮重新选择。实际计时和监听在本轮退出时释放，避免旧计时继续影响实例。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "等待最近期限并处理到期或取消的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "timer_wait_frame",
      "type": "era.tavern.task.finished",
      "display_name": "当前职责已真实完成或退出的确认"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "等待最近期限并处理到期或取消的请求和已有进度"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始等待最近期限并处理到期或取消",
        "description": "标明“等待最近期限并处理到期或取消”的开始位置。等待选出的最近有效期限，到期时交给统一计时流程，安排变化或停止时结束本轮重新选择。实际计时和监听在本轮退出时释放，避免旧计时继续影响实例。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "await_due",
        "display_name": "等最近期限到达或计时安排改变",
        "description": "在“等待最近期限并处理到期或取消”流程中，等待当前选定期限；新增、更早、替换或取消安排会唤醒本次等待，实例停止也会结束等待。退出时清除实际计时和监听，后续重新选择或处理到期。",
        "definition_id": "era.tavern.timer_wait.await_due"
      },
      {
        "id": "dispatch_due",
        "display_name": "把实际到期交给计时事件流程",
        "description": "在“等待最近期限并处理到期或取消”流程中，当前期限确实到达后，从等待集合移除本项，将计时种类、身份及对应事件交给到期处理。后续重新核对有效性，再发业务事件或告警。",
        "definition_id": "era.tavern.timer_wait.dispatch_due"
      },
      {
        "id": "cancelled",
        "display_name": "结束已取消或需要重新选择的计时等待",
        "description": "在“等待最近期限并处理到期或取消”流程中，等待因安排改变、替换或停止而结束时，返回本轮无到期结果。外层随后按最新状态选择期限或结束计时分支。",
        "definition_id": "era.tavern.timer_wait.cancelled"
      },
      {
        "id": "join",
        "display_name": "返回本轮计时到期或取消的结论",
        "description": "在“等待最近期限并处理到期或取消”流程中，接收本轮期限实际到达后的处理结果，或安排变化、停止带来的取消结论。将本轮完成状态交回计时循环，继续选择最新有效期限。",
        "definition_id": "era.tavern.timer_wait.join"
      },
      {
        "id": "end",
        "display_name": "结束等待最近期限并处理到期或取消",
        "description": "标明“等待最近期限并处理到期或取消”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "await_due"
      ],
      {
        "from": "await_due",
        "to": "dispatch_due",
        "when": "timer_wait_await_route == 'due'"
      },
      {
        "from": "await_due",
        "to": "cancelled",
        "when": "timer_wait_await_route == 'cancelled'"
      },
      [
        "dispatch_due",
        "join"
      ],
      [
        "cancelled",
        "join"
      ],
      [
        "join",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.task.finished",
        "cardinality": "exactly_one",
        "display_name": "当前职责已真实完成或退出的确认",
        "as": "frame"
      }
    ]
  }
}
