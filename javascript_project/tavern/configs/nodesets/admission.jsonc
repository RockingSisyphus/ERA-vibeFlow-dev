{
  "type_key": "era.tavern.flow.admission",
  "display_name": "检查新事件并按序交给主服务",
  "description": "接收聊天、界面、脚本或到期事件，检查实例状态、内容和容量。有效事件登记序号及结果等待，交给服务或进入队列；拒绝时返回具体原因，不进入队列。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "检查新事件并按序交给主服务的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_admission_frame",
      "type": "era.tavern.call.frame",
      "display_name": "检查新事件并按序交给主服务的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "检查新事件并按序交给主服务的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 14,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始检查新事件并按序交给主服务",
        "description": "标明“检查新事件并按序交给主服务”的开始位置。接收聊天、界面、脚本或到期事件，检查实例状态、内容和容量。有效事件登记序号及结果等待，交给服务或进入队列；拒绝时返回具体原因，不进入队列。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_event",
        "display_name": "检查事件内容及服务是否仍可接收",
        "description": "在“检查新事件并按序交给主服务”流程中，接收来自聊天、界面、脚本或计时器的事件，检查来源和基本资料，并确认服务没有停止或进入严重故障。发现问题时记下拒绝原因，供后续返回给发起者。",
        "definition_id": "era.tavern.admission.check_event"
      },
      {
        "id": "encode_event",
        "display_name": "为事件准备可传递资料和身份",
        "description": "在“检查新事件并按序交给主服务”流程中，将事件参数整理为主服务可读取的资料，给不能直接传递的页面对象保留本实例引用，并计算事件大小。格式或引用数量有问题时记录拒绝原因，供容量检查及入队判断使用。",
        "definition_id": "era.tavern.admission.encode_event"
      },
      {
        "id": "check_capacity",
        "display_name": "检查单事件大小和等待队列容量",
        "description": "在“检查新事件并按序交给主服务”流程中，读取已整理事件的大小，检查是否超过单事件上限，以及等待队列是否还能容纳。超限时带回拒绝原因，有空间时继续接收，避免无限积累未处理请求。",
        "definition_id": "era.tavern.admission.check_capacity"
      },
      {
        "id": "choose_admission",
        "display_name": "决定接收事件还是返回拒绝原因",
        "description": "在“检查新事件并按序交给主服务”流程中，查看本次事件的格式、服务状态和容量检查结论。有效事件进入登记分支，有问题的事件直接返回相应原因，使入队与拒绝清楚分开。",
        "definition_id": "era.tavern.admission.choose_admission"
      },
      {
        "id": "branch_rejected",
        "display_name": "返回本次事件未被接收的原因",
        "description": "在“检查新事件并按序交给主服务”流程中，接收格式、服务状态或容量检查产生的拒绝结论，作为本次请求结果返回。被拒事件不进入待处理队列，调用方可据此说明未执行原因。",
        "definition_id": "era.tavern.admission.branch_rejected"
      },
      {
        "id": "branch_accepted",
        "display_name": "登记事件序号和处理结果等待",
        "description": "在“检查新事件并按序交给主服务”流程中，给被接收的事件登记正式序号，保存所需页面引用，并建立处理结果的等待记录。发起者得到接收确认后，可以等待本事件结束或此前相关事件全部完成。",
        "definition_id": "era.tavern.admission.branch_accepted"
      },
      {
        "id": "join_deliver_result",
        "display_name": "交接检查新事件并按序交给主服务的选中结果",
        "description": "在“检查新事件并按序交给主服务”流程中，在“检查新事件并按序交给主服务”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.admission.join_deliver_result"
      },
      {
        "id": "deliver_result",
        "display_name": "把事件交给服务或加入等待队列",
        "description": "在“检查新事件并按序交给主服务”流程中，本次事件已被接收后，如果服务正在等待事件就立即交付，否则按先来先后放入队列。保留结果观察，让发起者最终能够收到相应处理确认。",
        "definition_id": "era.tavern.admission.deliver_result"
      },
      {
        "id": "end",
        "display_name": "结束检查新事件并按序交给主服务",
        "description": "标明“检查新事件并按序交给主服务”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_event",
        "encode_event"
      ],
      [
        "encode_event",
        "check_capacity"
      ],
      [
        "check_capacity",
        "choose_admission"
      ],
      {
        "from": "choose_admission",
        "to": "branch_accepted",
        "when": "era_tavern_admission_choose_admission_route == 'accepted'"
      },
      [
        "branch_accepted",
        "join_deliver_result"
      ],
      {
        "from": "choose_admission",
        "to": "branch_rejected",
        "when": "era_tavern_admission_choose_admission_route == 'rejected'"
      },
      [
        "branch_rejected",
        "join_deliver_result"
      ],
      [
        "join_deliver_result",
        "deliver_result"
      ],
      [
        "start",
        "check_event"
      ],
      [
        "deliver_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "检查新事件并按序交给主服务的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
