{
  "type_key": "era.tavern.flow.frame_send",
  "display_name": "执行主服务回传的确认、计时和通知",
  "description": "接收主服务输出，检查身份并避免重复处理。计时清单按序执行，批次结果核对后逐项回告原事件，再发起页面通知并登记完成等待，返回本次输出处理确认。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "执行主服务回传的确认、计时和通知的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_frame_send_frame",
      "type": "era.tavern.frame.frame_send.final_result",
      "display_name": "执行主服务回传的确认、计时和通知的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "执行主服务回传的确认、计时和通知的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 21,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始执行主服务回传的确认、计时和通知",
        "description": "标明“执行主服务回传的确认、计时和通知”的开始位置。接收主服务输出，检查身份并避免重复处理。计时清单按序执行，批次结果核对后逐项回告原事件，再发起页面通知并登记完成等待，返回本次输出处理确认。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_frame",
        "display_name": "检查主服务返回消息并识别重复",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，接收主服务送回页面的结果，检查通道和消息身份，并与已处理记录比较。同一身份但内容不同会报告冲突，已处理的相同内容标为重复，供后续避免再次确认或通知。",
        "definition_id": "era.tavern.frame_send.check_frame"
      },
      {
        "id": "choose_frame",
        "display_name": "选择批次结算、计时控制或重复确认",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，查看主服务返回消息的类型，区分任务批次结果、事件收集的计时安排，以及已处理过的重复消息。让后续只执行本次实际需要的对应处理。",
        "definition_id": "era.tavern.frame_send.choose_frame"
      },
      {
        "id": "branch_duplicate",
        "display_name": "确认重复输出而不再次执行",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，本次服务输出与已处理记录完全相同时，沿用原确认并继续返回。计时、原事件结算和后置通知不再执行第二次。",
        "definition_id": "era.tavern.frame_send.branch_duplicate"
      },
      {
        "id": "branch_batch_prepare",
        "display_name": "核对整批事件确认并整理通知参数",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，检查主服务给出的事件确认是否恰好覆盖指定范围，没有重复、遗漏或对应冲突。还原页面通知所需参数，并按序整理确认清单，供逐项回告发起者。",
        "definition_id": "era.tavern.frame_send.branch_batch_prepare"
      },
      {
        "id": "branch_batch_shared",
        "display_name": "逐项回告批次事件并整理后续通知",
        "description": "本环节用于“执行主服务回传的确认、计时和通知”：接收主服务已经核对的批次结果，先标记严重停止状态，再按原序完成每个事件确认并释放引用，报告诊断并交接通知资料。后续通知独立收集完成，不占用主服务下一轮等待。",
        "definition_id": "era.tavern.flow.settlement"
      },
      {
        "id": "branch_batch",
        "display_name": "交接本批事件结算后的资料",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，接收逐项回告和诊断处理完成的批次结果，继续送到本次服务输出的统一后续步骤。通知准备和去重登记据此沿同一批资料完成。",
        "definition_id": "era.tavern.frame_send.branch_batch"
      },
      {
        "id": "branch_control_prepare",
        "display_name": "交出主服务已经给定的计时安排",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，本次服务输出属于事件收集计时控制时，将其中明确给出的启动或取消清单交给计时处理。业务收集期限已经由主服务决定。",
        "definition_id": "era.tavern.frame_send.branch_control_prepare"
      },
      {
        "id": "branch_control_shared",
        "display_name": "按顺序执行事件收集的计时要求",
        "description": "本环节用于“执行主服务回传的确认、计时和通知”：接收主服务明确给出的计时清单，逐项交给统一计时控制，完成后返回确认。到期后只按已约定内容回送事件，业务任务仍由主服务决定。",
        "definition_id": "era.tavern.flow.collection_control"
      },
      {
        "id": "branch_control",
        "display_name": "交接计时清单处理后的确认",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，接收本次收集计时清单已经处理完的资料，继续进入服务输出的统一后续步骤。计时安排不在这里重新执行。",
        "definition_id": "era.tavern.frame_send.branch_control"
      },
      {
        "id": "join_apply_frame",
        "display_name": "交接执行主服务回传的确认、计时和通知的选中结果",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，在“执行主服务回传的确认、计时和通知”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.frame_send.join_apply_frame"
      },
      {
        "id": "apply_frame",
        "display_name": "确认本次服务输出处理已完成",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，接收已走完计时控制、批次结算或重复确认分支的资料，整理为空返回结果。后续登记这份输出已处理，避免把分支处理误当作再次执行请求。",
        "definition_id": "era.tavern.frame_send.apply_frame"
      },
      {
        "id": "remember_frame",
        "display_name": "记住这份服务输出已经处理",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，在当前实例中登记本次服务输出的身份和内容。后续相同输出可以识别为重复，防止重复返回事件结果或发出通知。",
        "definition_id": "era.tavern.frame_send.remember_frame"
      },
      {
        "id": "prepare_notification_batch",
        "display_name": "为本批后续通知建立进度记录",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，接收有效批次结果，整理需要发送的通知列表、各项完成位置及取消来源。重复消息或实例正在停止时不再建立通知组，后续按顺序发起有效通知。",
        "definition_id": "era.tavern.frame_send.prepare_notification_batch"
      },
      {
        "id": "start_notifications_loop",
        "display_name": "按清单发起通知并登记完成等待",
        "description": "接收本批需要发送的页面和阶段通知，按原顺序逐条发起并记录实际完成位置。清单遍历完即结束本段，监听处理的真实完成由通知分支持续收集。",
        "requires": [
          {
            "type": "era.tavern.frame.notification_batch.begin",
            "cardinality": "exactly_one",
            "display_name": "执行主服务回传的确认、计时和通知的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_frame_send_start_notifications_loop_frame",
            "type": "era.tavern.frame.notification_batch.begin",
            "display_name": "执行主服务回传的确认、计时和通知的处理进度及结果"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.notification_start_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.notification_batch.begin",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_frame_send_start_notifications_loop_frame"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "activate_notification_batch",
        "display_name": "登记已发起通知组供后台收尾",
        "description": "在“执行主服务回传的确认、计时和通知”流程中，将本批通知组登记到当前实例，记录需要等待整组完成的状态。后续通知分支处理完成事实和统一释放，使主服务可以继续接收事件。",
        "definition_id": "era.tavern.frame_send.activate_notification_batch"
      },
      {
        "id": "end",
        "display_name": "结束执行主服务回传的确认、计时和通知",
        "description": "标明“执行主服务回传的确认、计时和通知”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_frame",
        "choose_frame"
      ],
      [
        "apply_frame",
        "remember_frame"
      ],
      {
        "from": "choose_frame",
        "to": "branch_control_prepare",
        "when": "era_tavern_frame_send_choose_frame_route == 'control'"
      },
      [
        "branch_control",
        "join_apply_frame"
      ],
      {
        "from": "choose_frame",
        "to": "branch_batch_prepare",
        "when": "era_tavern_frame_send_choose_frame_route == 'batch'"
      },
      [
        "branch_batch",
        "join_apply_frame"
      ],
      {
        "from": "choose_frame",
        "to": "branch_duplicate",
        "when": "era_tavern_frame_send_choose_frame_route == 'duplicate'"
      },
      [
        "branch_duplicate",
        "join_apply_frame"
      ],
      [
        "branch_batch_prepare",
        "branch_batch_shared"
      ],
      [
        "branch_batch_shared",
        "branch_batch"
      ],
      [
        "branch_control_prepare",
        "branch_control_shared"
      ],
      [
        "branch_control_shared",
        "branch_control"
      ],
      [
        "join_apply_frame",
        "apply_frame"
      ],
      [
        "remember_frame",
        "prepare_notification_batch"
      ],
      [
        "prepare_notification_batch",
        "start_notifications_loop"
      ],
      [
        "start_notifications_loop",
        "activate_notification_batch"
      ],
      [
        "start",
        "check_frame"
      ],
      [
        "activate_notification_batch",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.frame_send.final_result",
        "cardinality": "exactly_one",
        "display_name": "执行主服务回传的确认、计时和通知的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
