{
  "type_key": "era.tavern.flow.subscription_control",
  "display_name": "管理作者的生成阶段订阅",
  "description": "接收登记、停止或取消要求，检查订阅归属及关注阶段，在当前实例内更新回调记录。返回可注销的订阅或完成确认，供后续阶段按正确名单执行。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "管理作者的生成阶段订阅的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "subscription_control_frame",
      "type": "era.tavern.call.frame",
      "display_name": "管理作者的生成阶段订阅的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "管理作者的生成阶段订阅的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始管理作者的生成阶段订阅",
        "description": "标明“管理作者的生成阶段订阅”的开始位置。接收登记、停止或取消要求，检查订阅归属及关注阶段，在当前实例内更新回调记录。返回可注销的订阅或完成确认，供后续阶段按正确名单执行。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择登记、移除或取消阶段订阅",
        "description": "在“管理作者的生成阶段订阅”流程中，接收作者对生成阶段通知的管理请求，判断要新增订阅、停止指定订阅，还是取消当前阶段处理。后续在本实例范围内执行对应操作。",
        "definition_id": "era.tavern.subscription_control.choose"
      },
      {
        "id": "register",
        "display_name": "登记作者希望监听的生成阶段",
        "description": "在“管理作者的生成阶段订阅”流程中，接收作者回调及可选的规划、正文、结算阶段范围，检查后登记到当前实例。返回可停止订阅的操作，使阶段完成时能找到匹配作者处理。",
        "definition_id": "era.tavern.subscription_control.register"
      },
      {
        "id": "stop",
        "display_name": "移除指定阶段订阅并按需取消等待",
        "description": "在“管理作者的生成阶段订阅”流程中，确认订阅属于当前实例后移除它，结束订阅有效性；请求明确要求时也取消它参与的阶段等待。后续新阶段不再调用该订阅。",
        "definition_id": "era.tavern.subscription_control.stop"
      },
      {
        "id": "cancel",
        "display_name": "取消进行中的阶段回调周期",
        "description": "在“管理作者的生成阶段订阅”流程中，取消当前实例正在处理的阶段订阅周期；请求明确要求清空时，同时移除全部订阅。用于生成停止或实例释放，避免旧周期继续推动下一阶段。",
        "definition_id": "era.tavern.subscription_control.cancel"
      },
      {
        "id": "join_result",
        "display_name": "交接管理作者的生成阶段订阅的选中结果",
        "description": "在“管理作者的生成阶段订阅”流程中，在“管理作者的生成阶段订阅”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.subscription_control.join_result"
      },
      {
        "id": "end",
        "display_name": "结束管理作者的生成阶段订阅",
        "description": "标明“管理作者的生成阶段订阅”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "choose"
      ],
      {
        "from": "choose",
        "to": "register",
        "when": "subscription_control_choose_route == 'register'"
      },
      [
        "register",
        "join_result"
      ],
      {
        "from": "choose",
        "to": "stop",
        "when": "subscription_control_choose_route == 'stop'"
      },
      [
        "stop",
        "join_result"
      ],
      {
        "from": "choose",
        "to": "cancel",
        "when": "subscription_control_choose_route == 'cancel'"
      },
      [
        "cancel",
        "join_result"
      ],
      [
        "join_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "管理作者的生成阶段订阅的处理进度及结果"
      }
    ],
    "max_steps": 10
  }
}
