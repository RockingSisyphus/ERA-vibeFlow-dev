{
  "type_key": "era.tavern.flow.subscription_publish",
  "display_name": "原生发布一个生成阶段",
  "description": "同步通知发起只捕获资源并调用此编译后的异步workflow；顺序等待不在共享库或旧class内。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次实例及调用资料"
    }
  ],
  "provides": [
    {
      "key": "subscription_publish_frame",
      "type": "era.tavern.frame.subscription_publish.released",
      "display_name": "本流程实际结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "本次实例及调用资料"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程的控制边界，不创建资源或重复输出。"
      },
      {
        "id": "read_cycle",
        "type_used": "era.tavern.subscription_publish.read_cycle",
        "display_name": "读取同步捕获的订阅周期",
        "description": "复核属于此实例的周期资源；列表、只读completion及周期控制器已经由同步通知发起节点固定。"
      },
      {
        "id": "publish_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "按原顺序等待当前阶段订阅",
        "description": "每轮只处理一个捕获的订阅；无忙轮询，取消或列表终态后退出。",
        "requires": [
          {
            "type": "era.tavern.frame.subscription_publish.read_cycle",
            "cardinality": "exactly_one",
            "display_name": "捕获的订阅周期资源"
          }
        ],
        "provides": [
          {
            "key": "subscription_publish_loop_frame",
            "type": "era.tavern.call.frame",
            "display_name": "完成的订阅周期"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.subscription_cycle",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.subscription_publish.read_cycle",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "subscription_publish_loop_frame"
            }
          ]
        }
      },
      {
        "id": "release_cycle",
        "type_used": "era.tavern.subscription_publish.release_cycle",
        "display_name": "释放周期并交还是否继续生成",
        "description": "移除本实例active周期；只有周期未取消才返回proceed=true，注销单个订阅不会取消整个生成。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程的控制边界，不创建资源或重复输出。"
      }
    ],
    "edges": [
      [
        "start",
        "read_cycle"
      ],
      [
        "read_cycle",
        "publish_loop"
      ],
      [
        "publish_loop",
        "release_cycle"
      ],
      [
        "release_cycle",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.subscription_publish.released",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "当前实际结果"
      }
    ],
    "max_steps": 8
  }
}
