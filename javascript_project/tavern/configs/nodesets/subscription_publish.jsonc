{
  "type_key": "era.tavern.flow.subscription_publish",
  "display_name": "将阶段结果依次交给作者回调",
  "description": "接收本次已经捕获的订阅周期，准备同一份只读阶段结果，按原顺序执行有效回调。最后解除周期登记，并返回阶段是否仍可继续，供生成交接使用。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "将阶段结果依次交给作者回调的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "subscription_publish_frame",
      "type": "era.tavern.frame.subscription_publish.released",
      "display_name": "将阶段结果依次交给作者回调的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "将阶段结果依次交给作者回调的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始将阶段结果依次交给作者回调",
        "description": "标明“将阶段结果依次交给作者回调”的开始位置。接收本次已经捕获的订阅周期，准备同一份只读阶段结果，按原顺序执行有效回调。最后解除周期登记，并返回阶段是否仍可继续，供生成交接使用。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "read_cycle",
        "display_name": "准备本阶段只读结果和回调顺序",
        "description": "在“将阶段结果依次交给作者回调”流程中，确认订阅周期属于当前实例，复制并冻结本阶段完成资料，从第一个已捕获回调开始。后续作者按序读到同一份阶段结果。",
        "definition_id": "era.tavern.subscription_publish.read_cycle"
      },
      {
        "id": "publish_loop",
        "display_name": "按序等待本阶段所有有效作者回调",
        "description": "按本阶段捕获的订阅清单逐项检查并执行匹配回调，等待本项结束后再处理下一项。取消或清单结束时退出，返回本阶段是否仍允许继续生成。",
        "requires": [
          {
            "type": "era.tavern.frame.subscription_publish.read_cycle",
            "cardinality": "exactly_one",
            "display_name": "将阶段结果依次交给作者回调的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "subscription_publish_loop_frame",
            "type": "era.tavern.call.frame",
            "display_name": "将阶段结果依次交给作者回调的处理进度及结果"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.subscription_cycle",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.subscription_publish.read_cycle",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "subscription_publish_loop_frame"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "release_cycle",
        "display_name": "结束阶段订阅并返回能否继续生成",
        "description": "在“将阶段结果依次交给作者回调”流程中，全部阶段回调结束或取消后，从实例移除本周期记录，返回周期是否仍有效。阶段交接流程据此提交继续或取消请求。",
        "definition_id": "era.tavern.subscription_publish.release_cycle"
      },
      {
        "id": "end",
        "display_name": "结束将阶段结果依次交给作者回调",
        "description": "标明“将阶段结果依次交给作者回调”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "read_cycle"
      ],
      [
        "read_cycle",
        "publish_loop"
      ],
      [
        "publish_loop",
        "release_cycle"
      ],
      [
        "release_cycle",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.subscription_publish.released",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "将阶段结果依次交给作者回调的处理进度及结果"
      }
    ],
    "max_steps": 8
  }
}
