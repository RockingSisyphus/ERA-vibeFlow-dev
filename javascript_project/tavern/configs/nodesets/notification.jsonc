{
  "type_key": "era.tavern.flow.notification",
  "display_name": "收集一条已发起通知的完成结果",
  "description": "区分普通事件与生成阶段交接，等待对应已发起操作结束，记入通知组原位置。全部通知齐全时安排整组收尾，尚有未完成项时保留组状态等待。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "收集一条已发起通知的完成结果的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_notification_frame",
      "type": "era.tavern.task.finished",
      "display_name": "当前职责已真实完成或退出的确认"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "收集一条已发起通知的完成结果的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 40,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始收集一条已发起通知的完成结果",
        "description": "标明“收集一条已发起通知的完成结果”的开始位置。区分普通事件与生成阶段交接，等待对应已发起操作结束，记入通知组原位置。全部通知齐全时安排整组收尾，尚有未完成项时保留组状态等待。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "read_notification",
        "display_name": "接收本次已经发起的通知资料",
        "description": "在“收集一条已发起通知的完成结果”流程中，取出当前通知、所属通知组及取消来源，交给通知类型判断。此处使用已经登记的通知，后续读取其完成结果并记录到正确位置。",
        "definition_id": "era.tavern.notification.read_notification"
      },
      {
        "id": "choose_notification",
        "display_name": "区分普通通知和生成阶段完成通知",
        "description": "在“收集一条已发起通知的完成结果”流程中，查看本次通知种类，普通事件走通知完成等待，生成阶段完成走订阅与下一阶段交接等待。各自结果随后归入同一通知组。",
        "definition_id": "era.tavern.notification.choose_notification"
      },
      {
        "id": "select_handoff_prepare",
        "display_name": "等待生成阶段通知及交接结束",
        "description": "在“收集一条已发起通知的完成结果”流程中，接收已发起的生成阶段通知，等待订阅处理和阶段交接结果。将实际成功或失败记录到本次通知，供整组统一报告和释放。",
        "definition_id": "era.tavern.notification.select_handoff_prepare"
      },
      {
        "id": "select_handoff",
        "display_name": "交接阶段通知实际完成的结果",
        "description": "在“收集一条已发起通知的完成结果”流程中，接收生成阶段订阅及后续交接流程的实际结论，传给通知结果登记。整组通知会据此记录成功或失败，阶段业务不在这里再执行。",
        "definition_id": "era.tavern.notification.select_handoff"
      },
      {
        "id": "select_event",
        "display_name": "等待普通通知的监听处理结束",
        "description": "在“收集一条已发起通知的完成结果”流程中，接收已经发起的普通页面通知，等待监听处理完成，并记录成功或失败。结果交给通知组汇总，较慢通知不会阻止其他通知记录自己的完成情况。",
        "definition_id": "era.tavern.notification.select_event"
      },
      {
        "id": "join_emit_notification",
        "display_name": "交接收集一条已发起通知的完成结果的选中结果",
        "description": "在“收集一条已发起通知的完成结果”流程中，在“收集一条已发起通知的完成结果”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.notification.join_emit_notification"
      },
      {
        "id": "emit_notification",
        "display_name": "交接已经取得的通知完成结果",
        "description": "在“收集一条已发起通知的完成结果”流程中，接收普通通知或阶段交接已经形成的完成资料，原样传给结果登记步骤。实际通知已经在发起流程执行，此处不会再次发出相同通知。",
        "definition_id": "era.tavern.notification.emit_notification"
      },
      {
        "id": "record_result",
        "display_name": "记下本条通知的结果和整组剩余数量",
        "description": "在“收集一条已发起通知的完成结果”流程中，将当前回调的成功或失败写到通知原来的位置，并减少整组尚未完成数量。后续据此判断整组是否齐全，同时保留原顺序供统一报告。",
        "definition_id": "era.tavern.notification.record_result"
      },
      {
        "id": "choose_batch_complete",
        "display_name": "判断整组通知是否都已结束",
        "description": "在“收集一条已发起通知的完成结果”流程中，检查本通知组仍有多少项没有完成。尚有未完成项时保留组状态，全部齐全时安排最终报告和释放，使整组确认只在真实完成后发出。",
        "definition_id": "era.tavern.notification.choose_batch_complete"
      },
      {
        "id": "keep_group",
        "display_name": "保留尚有未完成项的通知组",
        "description": "在“收集一条已发起通知的完成结果”流程中，本条通知结果已经记下，但同组其他回调尚未全部结束时，保留通知组等待。整组齐全后才统一报告失败和释放。",
        "definition_id": "era.tavern.notification.keep_group"
      },
      {
        "id": "schedule_group_finish",
        "display_name": "把已齐全的通知组交给最终收尾",
        "description": "在“收集一条已发起通知的完成结果”流程中，整组通知完成后，将它加入通知收尾队列并唤醒处理分支。后续按原顺序报告失败并释放整组等待。",
        "definition_id": "era.tavern.notification.schedule_group_finish"
      },
      {
        "id": "join_batch_result",
        "display_name": "结束本条通知完成情况的处理",
        "description": "在“收集一条已发起通知的完成结果”流程中，本条通知结果已经登记，并已保留未完成组或安排完整组收尾后，返回本轮处理结束。通知职责分支可以接着读取下一条完成记录。",
        "definition_id": "era.tavern.notification.join_batch_result"
      },
      {
        "id": "end",
        "display_name": "结束收集一条已发起通知的完成结果",
        "description": "标明“收集一条已发起通知的完成结果”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "read_notification",
        "choose_notification"
      ],
      [
        "emit_notification",
        "record_result"
      ],
      {
        "from": "choose_notification",
        "to": "select_event",
        "when": "era_tavern_notification_choose_notification_route == 'event'"
      },
      [
        "select_event",
        "join_emit_notification"
      ],
      {
        "from": "choose_notification",
        "to": "select_handoff_prepare",
        "when": "era_tavern_notification_choose_notification_route == 'handoff'"
      },
      [
        "select_handoff",
        "join_emit_notification"
      ],
      [
        "join_emit_notification",
        "emit_notification"
      ],
      [
        "record_result",
        "choose_batch_complete"
      ],
      {
        "from": "choose_batch_complete",
        "to": "keep_group",
        "when": "era_tavern_notification_choose_batch_complete_route == 'pending'"
      },
      {
        "from": "choose_batch_complete",
        "to": "schedule_group_finish",
        "when": "era_tavern_notification_choose_batch_complete_route == 'complete'"
      },
      [
        "keep_group",
        "join_batch_result"
      ],
      [
        "schedule_group_finish",
        "join_batch_result"
      ],
      [
        "start",
        "read_notification"
      ],
      [
        "join_batch_result",
        "end"
      ],
      [
        "select_handoff_prepare",
        "select_handoff"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.task.finished",
        "cardinality": "exactly_one",
        "display_name": "当前职责已真实完成或退出的确认",
        "as": "frame"
      }
    ]
  }
}
