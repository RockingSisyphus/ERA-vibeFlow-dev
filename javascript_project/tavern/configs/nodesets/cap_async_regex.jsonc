{
  "type_key": "era.tavern.flow.cap_async_regex",
  "display_name": "完成角色正则规则操作",
  "description": "接收已经发起、需要等待的角色正则规则操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成角色正则规则操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_regex_frame",
      "type": "era.tavern.frame.final.cap_async_regex",
      "display_name": "完成角色正则规则操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成角色正则规则操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_regex",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成角色正则规则操作的处理进度及结果"
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成角色正则规则操作",
        "description": "标明“完成角色正则规则操作”的开始位置。接收已经发起、需要等待的角色正则规则操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择角色正则规则的具体操作",
        "description": "在“完成角色正则规则操作”流程中，接收角色正则规则请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_regex.choose"
      },
      {
        "id": "route_upsert",
        "display_name": "确认角色正则保存并使规则生效",
        "description": "本环节用于“完成角色正则规则操作”：等待角色正则写入完成，检查开关，必要时开启并保存设置，再重新加载聊天。返回规则数量和启用确认，供初始化知道状态栏规则已经可用。",
        "definition_id": "era.tavern.flow.regex_upsert_finish"
      },
      {
        "id": "join_return",
        "display_name": "交接完成角色正则规则操作的选中结果",
        "description": "在“完成角色正则规则操作”流程中，在“完成角色正则规则操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_regex.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成角色正则规则操作",
        "description": "标明“完成角色正则规则操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_upsert",
        "when": "era_tavern_cap_async_regex_choose_route == 'upsert'"
      },
      [
        "route_upsert",
        "join_return"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
