      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始确认外置状态栏配置保存并更新页面",
        "description": "标明“确认外置状态栏配置保存并更新页面”的开始位置。等待已经发起的角色卡外置状态栏配置保存，检查响应成功后同步页面资料并刷新外置状态栏。失败保留原因，成功返回设置更新确认。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "execute",
        "display_name": "等待角色显示设置保存响应（保存外置状态栏设置）",
        "description": "在“确认外置状态栏配置保存并更新页面”流程中，本次处理“保存外置状态栏设置”。接收已经发起的角色卡显示设置写入，等待酒馆响应。后续检查成功状态，再让页面采用新的单层显示或外置状态栏设置。",
        "definition_id": "era.tavern.character_patch_external_statusbar.execute"
      },
      {
        "id": "check_response",
        "display_name": "确认角色显示设置已保存成功（保存外置状态栏设置）",
        "description": "在“确认外置状态栏配置保存并更新页面”流程中，本次处理“保存外置状态栏设置”。检查角色卡设置写入的响应，失败时报告原因。成功后才进入页面资料更新，避免界面显示的配置与真实保存结果不一致。",
        "definition_id": "era.tavern.character_patch_external_statusbar_finish.check_response"
      },
      {
        "id": "publish_mirror",
        "display_name": "让页面采用已保存的角色显示设置（保存外置状态栏设置）",
        "description": "在“确认外置状态栏配置保存并更新页面”流程中，本次处理“保存外置状态栏设置”。角色卡保存成功后，将新配置同步到当前页面持有的角色资料，并刷新单层显示或外置状态栏。返回更新确认，让用户立即看到已保存设置生效。",
        "definition_id": "era.tavern.character_patch_external_statusbar_finish.publish_mirror"
      },
      {
        "id": "return_result",
        "display_name": "交回“保存外置状态栏设置”的实际结果",
        "description": "在“确认外置状态栏配置保存并更新页面”流程中，接收“保存外置状态栏设置”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.character_patch_external_statusbar.return_result"
      },
