{
  "type_key": "era.tavern.flow.cap_async_character",
  "display_name": "完成角色卡和显示设置操作",
  "description": "接收已经发起、需要等待的角色卡和显示设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成角色卡和显示设置操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_character_frame",
      "type": "era.tavern.frame.final.cap_async_character",
      "display_name": "完成角色卡和显示设置操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成角色卡和显示设置操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_character",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成角色卡和显示设置操作的处理进度及结果"
      }
    ],
    "max_steps": 14,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成角色卡和显示设置操作",
        "description": "标明“完成角色卡和显示设置操作”的开始位置。接收已经发起、需要等待的角色卡和显示设置操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择角色卡和显示设置的具体操作",
        "description": "在“完成角色卡和显示设置操作”流程中，接收角色卡和显示设置请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_character.choose"
      },
      {
        "id": "route_patch_single_floor",
        "display_name": "确认单层显示设置保存并更新页面",
        "description": "本环节用于“完成角色卡和显示设置操作”：等待已经发起的角色卡单层显示设置保存，检查成功后同步当前页面资料并刷新对应呈现。返回真实更新确认或具体保存失败。",
        "definition_id": "era.tavern.flow.character_patch_single_floor_finish"
      },
      {
        "id": "route_patch_external_statusbar",
        "display_name": "确认外置状态栏配置保存并更新页面",
        "description": "本环节用于“完成角色卡和显示设置操作”：等待已经发起的角色卡外置状态栏配置保存，检查响应成功后同步页面资料并刷新外置状态栏。失败保留原因，成功返回设置更新确认。",
        "definition_id": "era.tavern.flow.character_patch_external_statusbar_finish"
      },
      {
        "id": "route_read_main_greeting__execute",
        "display_name": "返回角色主开场白和状态栏配置",
        "description": "在“完成角色卡和显示设置操作”流程中，等待读取角色资料的操作完成，取出主开场白、角色身份及外置状态栏设置。没有可用单角色时返回缺失说明，供初始化决定如何处理。",
        "definition_id": "era.tavern.character_read_main_greeting.execute"
      },
      {
        "id": "route_read_main_greeting__return_result",
        "display_name": "交回“读取角色主开场白”的实际结果",
        "description": "在“完成角色卡和显示设置操作”流程中，接收“读取角色主开场白”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.character_read_main_greeting.return_result"
      },
      {
        "id": "route_write_main_greeting",
        "display_name": "确认旧开场白仍匹配再保存新文字",
        "description": "本环节用于“完成角色卡和显示设置操作”：接续写入前的角色读取，比较旧开场白是否仍符合修改依据；相同才保存新文字并检查响应。成功后同步页面编辑资料，内容已变或保存失败则返回原因。",
        "definition_id": "era.tavern.flow.character_write_main_greeting_finish"
      },
      {
        "id": "route_apply_greeting_refresh",
        "display_name": "完成聊天开场白的通知、重绘和保存",
        "description": "本环节用于“完成角色卡和显示设置操作”：接续已经更新的聊天首条消息，等待接收通知处理，清除旧显示并重新绘制，发出呈现完成通知后保存聊天。返回本次开场白刷新已完成的实际确认。",
        "definition_id": "era.tavern.flow.character_apply_greeting_refresh_finish"
      },
      {
        "id": "join_return",
        "display_name": "交接完成角色卡和显示设置操作的选中结果",
        "description": "在“完成角色卡和显示设置操作”流程中，在“完成角色卡和显示设置操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_character.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成角色卡和显示设置操作",
        "description": "标明“完成角色卡和显示设置操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_patch_single_floor",
        "when": "era_tavern_cap_async_character_choose_route == 'patch_single_floor'"
      },
      [
        "route_patch_single_floor",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_patch_external_statusbar",
        "when": "era_tavern_cap_async_character_choose_route == 'patch_external_statusbar'"
      },
      [
        "route_patch_external_statusbar",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_read_main_greeting__execute",
        "when": "era_tavern_cap_async_character_choose_route == 'read_main_greeting'"
      },
      [
        "route_read_main_greeting__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_write_main_greeting",
        "when": "era_tavern_cap_async_character_choose_route == 'write_main_greeting'"
      },
      [
        "route_write_main_greeting",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_apply_greeting_refresh",
        "when": "era_tavern_cap_async_character_choose_route == 'apply_greeting_refresh'"
      },
      [
        "route_apply_greeting_refresh",
        "join_return"
      ],
      [
        "route_read_main_greeting__execute",
        "route_read_main_greeting__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
