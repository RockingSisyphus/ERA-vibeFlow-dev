{
  "type_key": "era.tavern.flow.script_service",
  "display_name": "资源就绪后运行唯一 ERA 主服务",
  "description": "等待当前实例资源可用，将同一实例交给主服务的酒馆操作入口，再运行主服务直到真正结束。取消沿调用传递，服务结束会触发其他职责分支共同收尾。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "资源就绪后运行唯一 ERA 主服务的请求和已有进度"
    },
    {"type":"era.workflow.host_resources","cardinality":"exactly_one","display_name":"所属 ERA 实例的本地资源"}
  ],
  "provides": [
    {
      "key": "era_tavern_script_service_terminal",
      "type": "era.tavern.task.finished",
      "display_name": "当前职责已真实完成或退出的确认"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "资源就绪后运行唯一 ERA 主服务的请求和已有进度"
      },
      {"key":"host_resources","type":"era.workflow.host_resources","required":true,"display_name":"所属 ERA 实例的本地资源"}
    ],
    "max_steps": 7,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始资源就绪后运行唯一 ERA 主服务",
        "description": "标明“资源就绪后运行唯一 ERA 主服务”的开始位置。等待当前实例资源可用，将同一实例交给主服务的酒馆操作入口，再运行主服务直到真正结束。取消沿调用传递，服务结束会触发其他职责分支共同收尾。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "wait_owner",
        "display_name": "等待本实例页面资源准备就绪",
        "description": "在“资源就绪后运行唯一 ERA 主服务”流程中，等待资源管理分支完成运行资源登记，取消时结束等待。后续主服务只在同一实例资源可用后启动，避免尚未就绪就调用页面能力。",
        "definition_id": "era.tavern.owned.wait_owner",
        "join_policy": "all"
      },
      {
        "id": "run_service",
        "display_name": "运行主服务并等待它真正结束",
        "description": "展开后查看官方Call、Wait、Kill和双向消息分支；唯一主服务结束与全部通信清理完成后才返回。",
        "definition_id": "era.tavern.flow.workflow_service"
      },
      {
        "id": "end",
        "display_name": "结束资源就绪后运行唯一 ERA 主服务",
        "description": "标明“资源就绪后运行唯一 ERA 主服务”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      },
      {"id":"retain_host_resources","definition_id":"era.tavern.retain_host_resources","display_name":"保留所属实例的资源","description":"先取出本次运行或本轮迭代收到的本地资源，供下面需要组织工作流通信的步骤使用。资源不写入业务消息。"}
    ],
    "edges": [
      {"from":"start","to":"wait_owner","schedule":true},
      [
        "wait_owner",
        "run_service"
      ],
      [
        "run_service",
        "end"
      ],
      ["start","retain_host_resources"],
      {"from":"retain_host_resources","to":"wait_owner","transfer":false,"schedule":true},
      {"from":"retain_host_resources","to":"run_service","schedule":false}
    ],
    "outputs": [
      {
        "type": "era.tavern.task.finished",
        "cardinality": "exactly_one",
        "display_name": "当前职责已真实完成或退出的确认",
        "as": "frame"
      }
    ]
  }
}
