{
  "type_key": "era.tavern.flow.function_submit",
  "display_name": "接收作者函数提出的变量操作",
  "description": "确认作者函数仍有效，读取上下文时交出它的接口，提交操作时分配编号、加入本次调用请求队列并唤醒消息流程。返回对应结果等待，实际变量计算由主服务在原正文位置完成。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "接收作者函数提出的变量操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_function_submit_frame",
      "type": "era.tavern.frame.function_submit.return_request",
      "display_name": "接收作者函数提出的变量操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "接收作者函数提出的变量操作的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始接收作者函数提出的变量操作",
        "description": "标明“接收作者函数提出的变量操作”的开始位置。确认作者函数仍有效，读取上下文时交出它的接口，提交操作时分配编号、加入本次调用请求队列并唤醒消息流程。返回对应结果等待，实际变量计算由主服务在原正文位置完成。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_call",
        "display_name": "确认作者函数仍可提交请求",
        "description": "在“接收作者函数提出的变量操作”流程中，根据函数参数或调用身份找到当前有效的作者运行资料，必要时检查目标消息仍一致。区分读取函数上下文与提交操作，过期调用返回原因，避免旧函数继续修改当前聊天。",
        "definition_id": "era.tavern.function_submit.check_call"
      },
      {
        "id": "allocate_request",
        "display_name": "为作者提出的操作建立结果等待",
        "description": "在“接收作者函数提出的变量操作”流程中，接收作者函数要提交的操作种类和内容，为它分配本次调用内的编号并保存结果等待。后续执行完成后能把相应处理确认返回给正确的一项请求。",
        "definition_id": "era.tavern.function_submit.allocate_request"
      },
      {
        "id": "enqueue_request",
        "display_name": "把作者操作交给当前消息流程",
        "description": "在“接收作者函数提出的变量操作”流程中，将作者刚提出的变量提交等操作放入本次函数的请求队列，登记待确认记录并唤醒主服务等待。主服务可以在当前正文位置处理它，再回告函数结果。",
        "definition_id": "era.tavern.function_submit.enqueue_request"
      },
      {
        "id": "return_request",
        "display_name": "交回作者接口或本次操作的等待结果",
        "description": "在“接收作者函数提出的变量操作”流程中，读取作者上下文时交出本次有效接口；提交操作时交出这项操作的结果等待。作者函数可以等到消息流程实际处理后继续执行。",
        "definition_id": "era.tavern.function_submit.return_request"
      },
      {
        "id": "end",
        "display_name": "结束接收作者函数提出的变量操作",
        "description": "标明“接收作者函数提出的变量操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "check_call",
        "to": "allocate_request",
        "when": "era_tavern_function_submit_check_call_route == 'submit'"
      },
      [
        "allocate_request",
        "enqueue_request"
      ],
      [
        "enqueue_request",
        "return_request"
      ],
      [
        "start",
        "check_call"
      ],
      [
        "return_request",
        "end"
      ],
      {
        "from": "check_call",
        "to": "return_request",
        "when": "era_tavern_function_submit_check_call_route == 'context'"
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.function_submit.return_request",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "接收作者函数提出的变量操作的处理进度及结果"
      }
    ],
    "max_steps": 10
  }
}
