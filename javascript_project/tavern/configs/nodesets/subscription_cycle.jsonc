{
  "type_key": "era.tavern.flow.subscription_cycle",
  "display_name": "按序执行本阶段的作者订阅",
  "description": "逐项检查已捕获订阅是否仍有效且关注本阶段，执行匹配回调并等待，跳过其他项。非取消失败报告后继续，周期取消或全部结束时返回，外层据此决定是否继续生成。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "按序执行本阶段的作者订阅的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "subscription_cycle_frame",
      "type": "era.tavern.call.frame",
      "display_name": "按序执行本阶段的作者订阅的处理进度及结果"
    },
    {
      "key": "subscription_cycle_done",
      "type": "era.tavern.subscription_cycle.done",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "按序执行本阶段的作者订阅的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按序执行本阶段的作者订阅",
        "description": "标明“按序执行本阶段的作者订阅”的开始位置。逐项检查已捕获订阅是否仍有效且关注本阶段，执行匹配回调并等待，跳过其他项。非取消失败报告后继续，周期取消或全部结束时返回，外层据此决定是否继续生成。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择本阶段下一个有效作者订阅",
        "description": "在“按序执行本阶段的作者订阅”流程中，根据本周期取消状态、订阅是否仍登记及关注阶段，选择执行、跳过或结束。只处理当前仍有效且匹配规划、正文或结算阶段的订阅。",
        "definition_id": "era.tavern.subscription_cycle.choose"
      },
      {
        "id": "skip",
        "display_name": "略过已移除或不匹配阶段的订阅",
        "description": "在“按序执行本阶段的作者订阅”流程中，当前订阅已停止或不关注本阶段时，推进到下一项。保留本次阶段结果，供其余有效作者回调继续处理。",
        "definition_id": "era.tavern.subscription_cycle.skip"
      },
      {
        "id": "empty",
        "display_name": "确认本阶段订阅周期已经结束",
        "description": "在“按序执行本阶段的作者订阅”流程中，当前周期取消或所有回调已检查时，标记遍历结束。后续清除周期登记，并返回是否允许继续生成。",
        "definition_id": "era.tavern.subscription_cycle.empty"
      },
      {
        "id": "invoke",
        "display_name": "按顺序执行一个作者阶段回调",
        "description": "在“按序执行本阶段的作者订阅”流程中，把只读阶段结果和取消状态交给当前作者订阅，并等待其实际返回。记录回调错误，下一作者只有在本项等待结束后才进入处理。",
        "definition_id": "era.tavern.subscription_cycle.invoke"
      },
      {
        "id": "classify",
        "display_name": "判断回调失败是否需要报告",
        "description": "在“按序执行本阶段的作者订阅”流程中，查看当前作者订阅的执行结论，正常结束或取消时直接推进，非取消错误进入报告。后续仍按原顺序处理其他订阅。",
        "definition_id": "era.tavern.subscription_cycle.classify"
      },
      {
        "id": "report_error",
        "display_name": "说明阶段回调失败并继续后续处理",
        "description": "在“按序执行本阶段的作者订阅”流程中，将本次作者阶段回调的实际错误写入日志并显示提示，按现有规则继续后续生成处理。用户能看到回调问题，而原错误不会被伪装成回调成功。",
        "definition_id": "era.tavern.subscription_cycle.report_error"
      },
      {
        "id": "advance",
        "display_name": "结束本项回调登记并转到下一订阅",
        "description": "在“按序执行本阶段的作者订阅”流程中，移除当前订阅对本周期的等待关联，推进到下一回调位置。外层循环据此继续，保持作者订阅的先后顺序。",
        "definition_id": "era.tavern.subscription_cycle.advance"
      },
      {
        "id": "join_result",
        "display_name": "交接按序执行本阶段的作者订阅的选中结果",
        "description": "在“按序执行本阶段的作者订阅”流程中，在“按序执行本阶段的作者订阅”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.subscription_cycle.join_result"
      },
      {
        "id": "end",
        "display_name": "结束按序执行本阶段的作者订阅",
        "description": "标明“按序执行本阶段的作者订阅”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "choose"
      ],
      {
        "from": "choose",
        "to": "skip",
        "when": "subscription_cycle_choose_route == 'skip'"
      },
      {
        "from": "choose",
        "to": "empty",
        "when": "subscription_cycle_choose_route == 'done'"
      },
      {
        "from": "choose",
        "to": "invoke",
        "when": "subscription_cycle_choose_route == 'invoke'"
      },
      [
        "invoke",
        "classify"
      ],
      {
        "from": "classify",
        "to": "report_error",
        "when": "subscription_cycle_classify_route == 'error'"
      },
      [
        "advance",
        "join_result"
      ],
      [
        "skip",
        "join_result"
      ],
      [
        "empty",
        "join_result"
      ],
      [
        "join_result",
        "end"
      ],
      {
        "from": "classify",
        "to": "advance",
        "when": "subscription_cycle_classify_route == 'quiet'"
      },
      [
        "report_error",
        "advance"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "按序执行本阶段的作者订阅的处理进度及结果"
      },
      {
        "type": "era.tavern.subscription_cycle.done",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ],
    "max_steps": 15
  }
}
