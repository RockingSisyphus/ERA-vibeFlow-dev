{
  "type_key": "era.tavern.flow.generation_receipt",
  "display_name": "等待用户重试引起的完整生成结果",
  "description": "先等原重试事件处理确认，有阶段交接时继续等待规划、正文或结算的最终结果。结束时保留原请求身份；会话已取消则向原发起者返回取消。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "等待用户重试引起的完整生成结果的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "generation_receipt_frame",
      "type": "era.tavern.call.frame",
      "display_name": "等待用户重试引起的完整生成结果的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "等待用户重试引起的完整生成结果的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始等待用户重试引起的完整生成结果",
        "description": "标明“等待用户重试引起的完整生成结果”的开始位置。先等原重试事件处理确认，有阶段交接时继续等待规划、正文或结算的最终结果。结束时保留原请求身份；会话已取消则向原发起者返回取消。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "await_receipt",
        "display_name": "先等待重试请求本身处理完成",
        "description": "在“等待用户重试引起的完整生成结果”流程中，接收用户发起的生成重试，等待它在主服务队列中的处理确认。后续检查是否还包含阶段交接，使公开结果可以覆盖完整重试。",
        "definition_id": "era.tavern.generation_receipt.await_receipt"
      },
      {
        "id": "choose",
        "display_name": "判断重试是否还需要等生成阶段",
        "description": "在“等待用户重试引起的完整生成结果”流程中，查看原重试处理结果是否带有阶段完成身份。有则继续等完整阶段交接，没有则直接返回原确认，避免把一个片段完成误认为整次生成结束。",
        "definition_id": "era.tavern.generation_receipt.choose"
      },
      {
        "id": "original",
        "display_name": "直接返回无需阶段交接的重试结果",
        "description": "在“等待用户重试引起的完整生成结果”流程中，原重试请求已经形成最终确认且没有后续阶段时，直接交回该结果。调用方据此得到本次实际成功、失败或取消结论。",
        "definition_id": "era.tavern.generation_receipt.original"
      },
      {
        "id": "await_handoff",
        "display_name": "等待重试引起的完整阶段交接",
        "description": "在“等待用户重试引起的完整生成结果”流程中，根据重试结果中的阶段身份，等待规划、正文或结算的后续交接结束。取得最终结果或无结果状态，供公开重试调用返回。",
        "definition_id": "era.tavern.generation_receipt.await_handoff"
      },
      {
        "id": "choose_final",
        "display_name": "区分重试已完成还是生成会话取消",
        "description": "在“等待用户重试引起的完整生成结果”流程中，检查阶段交接是否形成最终处理确认。已有结果时采用完整结论，没有时按会话取消返回，让调用方不会一直等待旧生成。",
        "definition_id": "era.tavern.generation_receipt.choose_final"
      },
      {
        "id": "completed",
        "display_name": "返回完整重试结果并保留原请求身份",
        "description": "在“等待用户重试引起的完整生成结果”流程中，接收最终生成确认，同时沿用最初重试事件的身份和序号。原发起者据此得到整次重试的真实结果，而不会混淆中间阶段事件。",
        "definition_id": "era.tavern.generation_receipt.completed"
      },
      {
        "id": "cancelled",
        "display_name": "向原重试请求说明生成已取消",
        "description": "在“等待用户重试引起的完整生成结果”流程中，阶段交接没有形成可用最终结果时，返回生成会话已取消，并保留原重试请求身份。调用方可以结束等待并显示对应状态。",
        "definition_id": "era.tavern.generation_receipt.cancelled"
      },
      {
        "id": "join_result",
        "display_name": "交接等待用户重试引起的完整生成结果的选中结果",
        "description": "在“等待用户重试引起的完整生成结果”流程中，在“等待用户重试引起的完整生成结果”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.generation_receipt.join_result"
      },
      {
        "id": "end",
        "display_name": "结束等待用户重试引起的完整生成结果",
        "description": "标明“等待用户重试引起的完整生成结果”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "start",
        "await_receipt"
      ],
      [
        "await_receipt",
        "choose"
      ],
      {
        "from": "choose",
        "to": "original",
        "when": "generation_receipt_choose_route == 'original'"
      },
      {
        "from": "choose",
        "to": "await_handoff",
        "when": "generation_receipt_choose_route == 'handoff'"
      },
      [
        "await_handoff",
        "choose_final"
      ],
      {
        "from": "choose_final",
        "to": "completed",
        "when": "generation_receipt_choose_final_route == 'completed'"
      },
      {
        "from": "choose_final",
        "to": "cancelled",
        "when": "generation_receipt_choose_final_route == 'cancelled'"
      },
      [
        "original",
        "join_result"
      ],
      [
        "completed",
        "join_result"
      ],
      [
        "cancelled",
        "join_result"
      ],
      [
        "join_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "等待用户重试引起的完整生成结果的处理进度及结果"
      }
    ],
    "max_steps": 13
  }
}
