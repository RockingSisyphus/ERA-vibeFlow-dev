{
  "type_key": "era.tavern.flow.cap_async_messages",
  "display_name": "完成聊天消息操作",
  "description": "接收已经发起、需要等待的聊天消息操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成聊天消息操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_messages_frame",
      "type": "era.tavern.frame.final.cap_async_messages",
      "display_name": "完成聊天消息操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成聊天消息操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_messages",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成聊天消息操作的处理进度及结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成聊天消息操作",
        "description": "标明“完成聊天消息操作”的开始位置。接收已经发起、需要等待的聊天消息操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择聊天消息的具体操作",
        "description": "在“完成聊天消息操作”流程中，接收聊天消息请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_messages.choose"
      },
      {
        "id": "route_update_content",
        "display_name": "等待消息更新并核实已经保存",
        "description": "本环节用于“完成聊天消息操作”：接续已经发起的消息更新，确认仍在原聊天后保存，重新读取原聊天文件并比较应写入内容。成功后按需更新显示；失败时保留内存变化、保存是否确认和来源变化等事实供恢复。",
        "definition_id": "era.tavern.flow.messages_update_content_finish"
      },
      {
        "id": "route_refresh__refresh",
        "display_name": "等待消息显示刷新完成",
        "description": "在“完成聊天消息操作”流程中，接收已经发起的显示刷新，等待其实际结束后返回完成确认。主服务据此结束本次呈现请求。",
        "definition_id": "era.tavern.messages_refresh.refresh"
      },
      {
        "id": "route_refresh__return_refresh",
        "display_name": "交回“刷新消息显示”的实际结果",
        "description": "在“完成聊天消息操作”流程中，接收“刷新消息显示”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.messages_refresh.return_refresh"
      },
      {
        "id": "join_return",
        "display_name": "交接完成聊天消息操作的选中结果",
        "description": "在“完成聊天消息操作”流程中，在“完成聊天消息操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_messages.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成聊天消息操作",
        "description": "标明“完成聊天消息操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_update_content",
        "when": "era_tavern_cap_async_messages_choose_route == 'update_content'"
      },
      [
        "route_update_content",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_refresh__refresh",
        "when": "era_tavern_cap_async_messages_choose_route == 'refresh'"
      },
      [
        "route_refresh__return_refresh",
        "join_return"
      ],
      [
        "route_refresh__refresh",
        "route_refresh__return_refresh"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
