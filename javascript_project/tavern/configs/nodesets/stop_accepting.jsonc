      "display_name": "关闭新请求并取消生成相关等待的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "关闭新请求并取消生成相关等待的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始关闭新请求并取消生成相关等待",
        "description": "标明“关闭新请求并取消生成相关等待”的开始位置。将实例立即标为停止，唤醒作者、通知及计时分支，取消生成进度、订阅与阶段交接。返回入口已关闭确认，实际运行和资源释放仍由统一收尾等待完成。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "close_ingress",
        "display_name": "立即停止接收新事件并唤醒各分支",
        "description": "在“关闭新请求并取消生成相关等待”流程中，把当前实例标为停止和未启动，返回入口关闭确认，并唤醒作者、通知和计时等待。后续请求会被拒绝，各长期分支开始结束处理。",
        "definition_id": "era.tavern.stop_accepting.close_ingress"
      },
      {
        "id": "cancel_generations",
        "display_name": "取消生成、阶段交接及相关订阅",
        "description": "在“关闭新请求并取消生成相关等待”流程中，实例停止时取消业务等待，结束启动决定，清空本页生成进度、阶段交接及订阅，并撤销延后停止安排。让仍在等待旧生成的调用能够结束，实际运行资源继续由统一收尾等待。",
        "definition_id": "era.tavern.stop_accepting.cancel_generations"
      },
      {
        "id": "return_closed",
        "display_name": "返回实例已关闭接收入口的确认",
        "description": "在“关闭新请求并取消生成相关等待”流程中，接收停止接纳及生成取消的结果，向发起者返回入口已经关闭。实际任务退出和异步资源清理仍由实例长期运行流程等待完成。",
        "definition_id": "era.tavern.stop_accepting.return_closed"
      },
      {
        "id": "end",
        "display_name": "结束关闭新请求并取消生成相关等待",
        "description": "标明“关闭新请求并取消生成相关等待”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "close_ingress",
        "cancel_generations"
      ],
      [
        "cancel_generations",
        "return_closed"
      ],
      [
        "start",
        "close_ingress"
      ],
      [
        "return_closed",
        "end"
      ]
    ],
    "outputs": [
