{
  "type_key": "era.tavern.flow.barrier_wait",
  "display_name": "等待相关事件和生成阶段交接完成",
  "description": "等待指定序号及之前的事件处理结束，汇总回执。生成屏障再按原规则报告失败、等待阶段交接并推进同次候选；普通状态读取只等待回执，不消费生成失败或等待阶段交接。末尾清理本次告警，异常按既有路径返回。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "等待相关事件和生成阶段交接完成的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_barrier_wait_frame",
      "type": "era.tavern.call.frame",
      "display_name": "等待相关事件和生成阶段交接完成的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "等待相关事件和生成阶段交接完成的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "等待相关事件和生成阶段交接完成的处理进度及结果",
        "as": "frame"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始等待相关事件和生成阶段交接完成",
        "description": "进入指定范围的回执等待。生成屏障继续处理失败报告、阶段交接与候选放行；普通状态读取只加入调用时已有的处理范围，不等待未来事件。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "await_receipts",
        "display_name": "等待指定范围内的事件全部处理结束",
        "description": "在“等待相关事件和生成阶段交接完成”流程中，接收已确定的事件范围，等待各项实际处理确认，再按先后顺序汇总成功、失败和取消。生成等待中的异常保留给后续报告，其余调用按实际错误返回。",
        "definition_id": "era.tavern.barrier_wait.await_receipts"
      },
      {
        "id": "report_barrier",
        "display_name": "报告生成前等待发现的失败",
        "description": "在“等待相关事件和生成阶段交接完成”流程中，生成前相关事件结束后，将失败结论交给页面的等待失败处理。等待或失败报告本身发生异常时记录错误，并标记本次等待异常；后续据此决定是否继续等阶段交接。",
        "definition_id": "era.tavern.barrier_wait.report_barrier"
      },
      {
        "id": "await_handoff",
        "display_name": "正常等待完成后再等生成阶段交接",
        "description": "在“等待相关事件和生成阶段交接完成”流程中，相关事件已完成，且生成前等待没有发生报告异常时，等待当前已登记的阶段交接结束。让随后生成使用已完成阶段的状态；已标记等待异常时直接交给后续收尾。",
        "definition_id": "era.tavern.barrier_wait.await_handoff"
      },
      {
        "id": "cleanup_watchdog",
        "display_name": "等待结束后清理提醒和已消费失败",
        "description": "取消本次告警；仅生成屏障移除本次已报告失败并推进同次准备中的候选。普通状态读取保留失败记录，不改变原生生成阶段；告警不会提前放行等待。",
        "definition_id": "era.tavern.barrier_wait.cleanup_watchdog"
      },
      {
        "id": "end",
        "display_name": "结束等待相关事件和生成阶段交接完成",
        "description": "标明“等待相关事件和生成阶段交接完成”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "await_receipts",
        "report_barrier"
      ],
      [
        "report_barrier",
        "await_handoff"
      ],
      [
        "await_handoff",
        "cleanup_watchdog"
      ],
      [
        "start",
        "await_receipts"
      ],
      [
        "cleanup_watchdog",
        "end"
      ]
    ]
  }
}
