{
  "type_key": "era.tavern.flow.cap_async_worldbook",
  "display_name": "世界书操作：异步完成",
  "description": "只保留真正等待的操作；完全同步的 Promise 接口没有本入口分支。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_worldbook_frame",
      "type": "era.tavern.frame.final.cap_async_worldbook",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_worldbook",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_async_worldbook.choose",
        "display_name": "识别世界书操作",
        "description": "按原 Capability 的操作名选择唯一 async 路径，操作原参数、返回类型和错误身份保持。"
      },
      {
        "id": "route_read__execute",
        "type_used": "era.tavern.worldbook_read.execute",
        "display_name": "读取：世界书：等待与确认：等待本次读取：世界书的资源终态",
        "description": "在酒馆页面执行该操作的实际 API 或资源动作；保留未知字段、现有错误类别及原同步/异步约定。"
      },
      {
        "id": "route_read__return_result",
        "type_used": "era.tavern.worldbook_read.return_result",
        "display_name": "读取：世界书：等待与确认：交还读取结果",
        "description": "返回原 era.tavern.worldbook.read.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "route_create__execute",
        "type_used": "era.tavern.worldbook_create.execute",
        "display_name": "创建：世界书：等待与确认：等待本次创建：世界书的资源终态",
        "description": "在酒馆页面执行该操作的实际 API 或资源动作；保留未知字段、现有错误类别及原同步/异步约定。"
      },
      {
        "id": "route_create__return_result",
        "type_used": "era.tavern.worldbook_create.return_result",
        "display_name": "创建：世界书：等待与确认：交还创建结果",
        "description": "返回原 era.tavern.worldbook.create.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "route_bind__execute",
        "type_used": "era.tavern.worldbook_bind.execute",
        "display_name": "绑定：世界书：等待与确认：等待本次绑定：世界书的资源终态",
        "description": "在酒馆页面执行该操作的实际 API 或资源动作；保留未知字段、现有错误类别及原同步/异步约定。"
      },
      {
        "id": "route_bind__read_back",
        "type_used": "era.tavern.worldbook_bind_finish.read_back",
        "display_name": "更新世界书下拉框并交还绑定确认",
        "description": "只更新原下拉框并交还 name/bound，不新增读回 API。"
      },
      {
        "id": "route_bind__return_result",
        "type_used": "era.tavern.worldbook_bind.return_result",
        "display_name": "绑定：世界书：等待与确认：交还绑定结果",
        "description": "返回原 era.tavern.worldbook.bind.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "route_replace_entries__execute",
        "type_used": "era.tavern.worldbook_replace_entries.execute",
        "display_name": "替换条目：世界书：等待与确认：等待本次替换条目：世界书的资源终态",
        "description": "在酒馆页面执行该操作的实际 API 或资源动作；保留未知字段、现有错误类别及原同步/异步约定。"
      },
      {
        "id": "route_replace_entries__return_result",
        "type_used": "era.tavern.worldbook_replace_entries.return_result",
        "display_name": "替换条目：世界书：等待与确认：交还替换条目结果",
        "description": "返回原 era.tavern.worldbook.replace_entries.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "join_return",
        "type_used": "era.tavern.cap_async_worldbook.join_return",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'read'"
      },
      [
        "route_read__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_create__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'create'"
      },
      [
        "route_create__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_bind__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'bind'"
      },
      [
        "route_bind__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_replace_entries__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'replace_entries'"
      },
      [
        "route_replace_entries__return_result",
        "join_return"
      ],
      [
        "route_read__execute",
        "route_read__return_result"
      ],
      [
        "route_create__execute",
        "route_create__return_result"
      ],
      [
        "route_bind__read_back",
        "route_bind__return_result"
      ],
      [
        "route_bind__execute",
        "route_bind__read_back"
      ],
      [
        "route_replace_entries__execute",
        "route_replace_entries__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
