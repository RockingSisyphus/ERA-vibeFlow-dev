{
  "type_key": "era.tavern.flow.cap_async_worldbook",
  "display_name": "完成世界书操作",
  "description": "接收已经发起、需要等待的世界书操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "完成世界书操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_async_worldbook_frame",
      "type": "era.tavern.frame.final.cap_async_worldbook",
      "display_name": "完成世界书操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "完成世界书操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_async_worldbook",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "完成世界书操作的处理进度及结果"
      }
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始完成世界书操作",
        "description": "标明“完成世界书操作”的开始位置。接收已经发起、需要等待的世界书操作，按具体请求接续对应流程，等实际完成并检查结果后返回。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择世界书的具体操作",
        "description": "在“完成世界书操作”流程中，接收世界书请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_async_worldbook.choose"
      },
      {
        "id": "route_read__execute",
        "display_name": "返回已读取的世界书及条目",
        "description": "在“完成世界书操作”流程中，等待指定世界书内容读取完成，连同名称列表、角色绑定和实际读取对象返回。主服务据此决定是否需要建立或更新资源。",
        "definition_id": "era.tavern.worldbook_read.execute"
      },
      {
        "id": "route_read__return_result",
        "display_name": "交回“读取世界书”的实际结果",
        "description": "在“完成世界书操作”流程中，接收“读取世界书”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.worldbook_read.return_result"
      },
      {
        "id": "route_create__execute",
        "display_name": "确认世界书创建或已经存在",
        "description": "在“完成世界书操作”流程中，等待世界书创建操作完成，按真实结果返回已创建或已存在及名称。后续资源流程据此写入所需条目。",
        "definition_id": "era.tavern.worldbook_create.execute"
      },
      {
        "id": "route_create__return_result",
        "display_name": "交回“创建世界书”的实际结果",
        "description": "在“完成世界书操作”流程中，接收“创建世界书”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.worldbook_create.return_result"
      },
      {
        "id": "route_bind__execute",
        "display_name": "等待角色的世界书绑定保存",
        "description": "在“完成世界书操作”流程中，接收已经发起的主世界书绑定，等待酒馆实际保存结束。成功后进入界面确认，失败原因交回资源流程。",
        "definition_id": "era.tavern.worldbook_bind.execute"
      },
      {
        "id": "route_bind__read_back",
        "display_name": "更新世界书选择显示并返回确认",
        "description": "在“完成世界书操作”流程中，角色绑定保存完成后，将页面世界书选择框更新为本次名称，返回绑定完成。使界面与刚保存的角色资源一致。",
        "definition_id": "era.tavern.worldbook_bind_finish.read_back"
      },
      {
        "id": "route_bind__return_result",
        "display_name": "交回“绑定角色主世界书”的实际结果",
        "description": "在“完成世界书操作”流程中，接收“绑定角色主世界书”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.worldbook_bind.return_result"
      },
      {
        "id": "route_replace_entries__execute",
        "display_name": "确认世界书条目保存完成",
        "description": "在“完成世界书操作”流程中，等待已发起的条目替换结束，返回世界书名称和提交条目数。主服务据此记录资源初始化的实际进度。",
        "definition_id": "era.tavern.worldbook_replace_entries.execute"
      },
      {
        "id": "route_replace_entries__return_result",
        "display_name": "交回“替换世界书条目”的实际结果",
        "description": "在“完成世界书操作”流程中，接收“替换世界书条目”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.worldbook_replace_entries.return_result"
      },
      {
        "id": "join_return",
        "display_name": "交接完成世界书操作的选中结果",
        "description": "在“完成世界书操作”流程中，在“完成世界书操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_async_worldbook.join_return"
      },
      {
        "id": "end",
        "display_name": "结束完成世界书操作",
        "description": "标明“完成世界书操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'read'"
      },
      [
        "route_read__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_create__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'create'"
      },
      [
        "route_create__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_bind__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'bind'"
      },
      [
        "route_bind__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_replace_entries__execute",
        "when": "era_tavern_cap_async_worldbook_choose_route == 'replace_entries'"
      },
      [
        "route_replace_entries__return_result",
        "join_return"
      ],
      [
        "route_read__execute",
        "route_read__return_result"
      ],
      [
        "route_create__execute",
        "route_create__return_result"
      ],
      [
        "route_bind__read_back",
        "route_bind__return_result"
      ],
      [
        "route_bind__execute",
        "route_bind__read_back"
      ],
      [
        "route_replace_entries__execute",
        "route_replace_entries__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
