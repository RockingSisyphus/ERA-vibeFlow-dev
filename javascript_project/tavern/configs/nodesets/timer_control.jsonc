{
  "type_key": "era.tavern.flow.timer_control",
  "display_name": "按明确要求安排、取消或沿用计时",
  "description": "接收收集期限或延迟事件，检查原安排并选择保留、取消或替换，登记最近到期要求后返回确认。实际到期只回送约定事件，下一步业务仍由主服务判断。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "按明确要求安排、取消或沿用计时的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_timer_control_frame",
      "type": "era.tavern.call.frame",
      "display_name": "按明确要求安排、取消或沿用计时的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "按明确要求安排、取消或沿用计时的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按明确要求安排、取消或沿用计时",
        "description": "标明“按明确要求安排、取消或沿用计时”的开始位置。接收收集期限或延迟事件，检查原安排并选择保留、取消或替换，登记最近到期要求后返回确认。实际到期只回送约定事件，下一步业务仍由主服务判断。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "read_timer",
        "display_name": "读取本次收集或延迟事件的计时要求",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，区分主服务指定的事件收集期限与页面提出的延迟事件，读取原有安排、标识和时限。延迟事件检查有效输入并记住首次安排时间，供后续确定取消、保留或替换。",
        "definition_id": "era.tavern.timer_control.read_timer"
      },
      {
        "id": "choose_timer",
        "display_name": "选择取消、沿用或重新安排计时",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，检查本次要求及已存在的到期时间。取消要求进入撤销分支，相同收集期限沿用原计时，其余进入新安排，避免同一时限重复登记。",
        "definition_id": "era.tavern.timer_control.choose_timer"
      },
      {
        "id": "branch_schedule",
        "display_name": "登记新期限并替换旧安排",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，取消被替换的旧计时，按收集截止时间或延迟及最长等待窗口计算新期限，登记到本实例。唤醒计时分支，让它按最新最近期限等待。",
        "definition_id": "era.tavern.timer_control.branch_schedule"
      },
      {
        "id": "branch_cancel",
        "display_name": "取消指定计时并通知等待者重选",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，取消原计时安排并从对应列表移除，更新安排版本、唤醒正在等待的计时分支。后续重新选最近期限，已取消项不会正常触发业务事件。",
        "definition_id": "era.tavern.timer_control.branch_cancel"
      },
      {
        "id": "branch_keep",
        "display_name": "沿用相同期限的已有计时",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，当前事件收集计时已经对应本次要求的同一期限时，保留现有安排并交给确认出口。避免同一到期重复登记。",
        "definition_id": "era.tavern.timer_control.branch_keep"
      },
      {
        "id": "join_return_timer",
        "display_name": "交接按明确要求安排、取消或沿用计时的选中结果",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，在“按明确要求安排、取消或沿用计时”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.timer_control.join_return_timer"
      },
      {
        "id": "return_timer",
        "display_name": "返回本次计时安排的确认",
        "description": "在“按明确要求安排、取消或沿用计时”流程中，本次计时要求已执行后，按操作类型返回已安排、已取消或收集控制确认。调用方据此知道时间要求已登记，实际到期另由计时分支处理。",
        "definition_id": "era.tavern.timer_control.return_timer"
      },
      {
        "id": "end",
        "display_name": "结束按明确要求安排、取消或沿用计时",
        "description": "标明“按明确要求安排、取消或沿用计时”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "read_timer",
        "choose_timer"
      ],
      {
        "from": "choose_timer",
        "to": "branch_keep",
        "when": "era_tavern_timer_control_choose_timer_route == 'keep'"
      },
      [
        "branch_keep",
        "join_return_timer"
      ],
      {
        "from": "choose_timer",
        "to": "branch_cancel",
        "when": "era_tavern_timer_control_choose_timer_route == 'cancel'"
      },
      [
        "branch_cancel",
        "join_return_timer"
      ],
      {
        "from": "choose_timer",
        "to": "branch_schedule",
        "when": "era_tavern_timer_control_choose_timer_route == 'schedule'"
      },
      [
        "branch_schedule",
        "join_return_timer"
      ],
      [
        "join_return_timer",
        "return_timer"
      ],
      [
        "start",
        "read_timer"
      ],
      [
        "return_timer",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "按明确要求安排、取消或沿用计时的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
