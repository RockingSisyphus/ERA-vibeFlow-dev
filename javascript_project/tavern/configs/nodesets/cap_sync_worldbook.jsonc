{
  "type_key": "era.tavern.flow.cap_sync_worldbook",
  "display_name": "分派世界书操作",
  "description": "接收世界书请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派世界书操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_worldbook_frame",
      "type": "era.tavern.frame.final.cap_sync_worldbook",
      "display_name": "分派世界书操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派世界书操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_worldbook",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派世界书操作的处理进度及结果"
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派世界书操作",
        "description": "标明“分派世界书操作”的开始位置。接收世界书请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择世界书的具体操作",
        "description": "在“分派世界书操作”流程中，接收世界书请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_worldbook.choose"
      },
      {
        "id": "route_read__check_request",
        "display_name": "检查“读取世界书”的调用是否有效",
        "description": "在“分派世界书操作”流程中，接收“读取世界书”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.worldbook_read.check_request"
      },
      {
        "id": "route_read__start_operation",
        "display_name": "读取世界书名称、绑定并查询条目",
        "description": "在“分派世界书操作”流程中，先取得已有世界书和当前角色绑定，按请求名称或角色主世界书发起条目读取。后续等待结果，供初始化比较现有 ERA 规则资源。",
        "definition_id": "era.tavern.worldbook_read.start_operation"
      },
      {
        "id": "route_create__check_request",
        "display_name": "检查“创建世界书”的调用是否有效",
        "description": "在“分派世界书操作”流程中，接收“创建世界书”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.worldbook_create.check_request"
      },
      {
        "id": "route_create__start_operation",
        "display_name": "按指定名称发起世界书创建",
        "description": "在“分派世界书操作”流程中，确认请求给出有效名称，向酒馆创建相应世界书。后续等待结果并区分新建成功或原本已存在。",
        "definition_id": "era.tavern.worldbook_create.start_operation"
      },
      {
        "id": "route_bind__check_request",
        "display_name": "检查“绑定角色主世界书”的调用是否有效",
        "description": "在“分派世界书操作”流程中，接收“绑定角色主世界书”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.worldbook_bind.check_request"
      },
      {
        "id": "route_bind__start_operation",
        "display_name": "将世界书绑定到当前角色",
        "description": "在“分派世界书操作”流程中，检查世界书名称和当前角色，发起角色主世界书绑定保存。后续等待实际完成，再同步界面上的绑定显示。",
        "definition_id": "era.tavern.worldbook_bind.start_operation"
      },
      {
        "id": "route_replace_entries__check_request",
        "display_name": "检查“替换世界书条目”的调用是否有效",
        "description": "在“分派世界书操作”流程中，接收“替换世界书条目”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.worldbook_replace_entries.check_request"
      },
      {
        "id": "route_replace_entries__start_operation",
        "display_name": "按明确清单发起世界书条目替换",
        "description": "在“分派世界书操作”流程中，检查世界书名称及完整条目列表，复制请求内容并向酒馆发起替换。后续等待真实保存，确保资源执行使用明确给出的条目。",
        "definition_id": "era.tavern.worldbook_replace_entries.start_operation"
      },
      {
        "id": "join_return",
        "display_name": "交接分派世界书操作的选中结果",
        "description": "在“分派世界书操作”流程中，在“分派世界书操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_worldbook.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派世界书操作",
        "description": "标明“分派世界书操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'read'"
      },
      [
        "route_read__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_create__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'create'"
      },
      [
        "route_create__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_bind__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'bind'"
      },
      [
        "route_bind__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_replace_entries__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'replace_entries'"
      },
      [
        "route_replace_entries__start_operation",
        "join_return"
      ],
      [
        "route_read__check_request",
        "route_read__start_operation"
      ],
      [
        "route_create__check_request",
        "route_create__start_operation"
      ],
      [
        "route_bind__check_request",
        "route_bind__start_operation"
      ],
      [
        "route_replace_entries__check_request",
        "route_replace_entries__start_operation"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
