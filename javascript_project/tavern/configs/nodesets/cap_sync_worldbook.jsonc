{
  "type_key": "era.tavern.flow.cap_sync_worldbook",
  "display_name": "世界书操作",
  "description": "共享同一职责组的原操作与必要的等待前发起；无额外 cap 总分组。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_worldbook_frame",
      "type": "era.tavern.frame.final.cap_sync_worldbook",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_worldbook",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_sync_worldbook.choose",
        "display_name": "识别世界书操作",
        "description": "按已声明操作名选择唯一原生路径；即时操作、同步完成的 Promise 操作及真正等待前的发起共享本职责组，不重复分组。"
      },
      {
        "id": "route_read__check_request",
        "type_used": "era.tavern.worldbook_read.check_request",
        "display_name": "读取：世界书：检查读取请求",
        "description": "保持 era.tavern.worldbook.read 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_read__start_operation",
        "type_used": "era.tavern.worldbook_read.start_operation",
        "display_name": "读取：世界书：捕获绑定并发起世界书读取",
        "description": "同步捕获名称列表和当前角色绑定，固定 requestedName；有名称才发起 getWorldbook，否则捕获空列表。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "route_create__check_request",
        "type_used": "era.tavern.worldbook_create.check_request",
        "display_name": "创建：世界书：检查创建请求",
        "description": "保持 era.tavern.worldbook.create 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_create__start_operation",
        "type_used": "era.tavern.worldbook_create.start_operation",
        "display_name": "创建：世界书：核对名称并发起世界书创建",
        "description": "同步核对 name 并发起 createWorldbook；created/exists 确认由原结果节点处理。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "route_bind__check_request",
        "type_used": "era.tavern.worldbook_bind.check_request",
        "display_name": "绑定：世界书：检查绑定请求",
        "description": "保持 era.tavern.worldbook.bind 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_bind__start_operation",
        "type_used": "era.tavern.worldbook_bind.start_operation",
        "display_name": "绑定：世界书：核对角色并发起主世界书绑定",
        "description": "同步捕获角色索引，拒绝不可写目标，通过 writeExtensionField 写 world，保留原附加绑定与保存次数。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "route_replace_entries__check_request",
        "type_used": "era.tavern.worldbook_replace_entries.check_request",
        "display_name": "替换条目：世界书：检查替换条目请求",
        "description": "保持 era.tavern.worldbook.replace_entries 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_replace_entries__start_operation",
        "type_used": "era.tavern.worldbook_replace_entries.start_operation",
        "display_name": "替换条目：世界书：核对条目并发起世界书替换",
        "description": "同步校验名称及条目并复制输入，发起一次 replaceWorldbook，不重新选择或合并条目。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "join_return",
        "type_used": "era.tavern.cap_sync_worldbook.join_return",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'read'"
      },
      [
        "route_read__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_create__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'create'"
      },
      [
        "route_create__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_bind__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'bind'"
      },
      [
        "route_bind__start_operation",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_replace_entries__check_request",
        "when": "era_tavern_cap_sync_worldbook_choose_route == 'replace_entries'"
      },
      [
        "route_replace_entries__start_operation",
        "join_return"
      ],
      [
        "route_read__check_request",
        "route_read__start_operation"
      ],
      [
        "route_create__check_request",
        "route_create__start_operation"
      ],
      [
        "route_bind__check_request",
        "route_bind__start_operation"
      ],
      [
        "route_replace_entries__check_request",
        "route_replace_entries__start_operation"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
