{
  "type_key": "era.tavern.flow.settlement",
  "display_name": "逐项回告批次事件并整理后续通知",
  "description": "接收主服务已经核对的批次结果，先标记严重停止状态，再按原序完成每个事件确认并释放引用，报告诊断并交接通知资料。后续通知独立收集完成，不占用主服务下一轮等待。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "逐项回告批次事件并整理后续通知的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_settlement_frame",
      "type": "era.tavern.call.frame",
      "display_name": "逐项回告批次事件并整理后续通知的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "逐项回告批次事件并整理后续通知的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始逐项回告批次事件并整理后续通知",
        "description": "标明“逐项回告批次事件并整理后续通知”的开始位置。接收主服务已经核对的批次结果，先标记严重停止状态，再按原序完成每个事件确认并释放引用，报告诊断并交接通知资料。后续通知独立收集完成，不占用主服务下一轮等待。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "mark_fatal_transition",
        "display_name": "严重错误时先标记不再接收新事件",
        "description": "在“逐项回告批次事件并整理后续通知”流程中，查看本批是否需要停止服务，若需要则先标记正在进入严重故障状态，再开始逐项返回事件结果。这样回告触发的新请求也能看到服务不可继续的状态。",
        "definition_id": "era.tavern.settlement.mark_fatal_transition"
      },
      {
        "id": "settle_receipts_loop",
        "display_name": "按序向每个原事件回告结果",
        "description": "对本批原事件清单逐项返回真实处理结果并释放其页面引用，全部结束后再处理诊断及通知。若有严重停止原因，回告前已标记不可继续接收，避免回调中重新进入正常服务。",
        "requires": [
          {
            "type": "era.tavern.frame.settlement.mark_fatal_transition",
            "cardinality": "exactly_one",
            "display_name": "逐项回告批次事件并整理后续通知的请求和已有进度"
          }
        ],
        "provides": [
          {
            "key": "era_tavern_flow_settlement_settle_receipts_loop_frame",
            "type": "era.tavern.frame.settlement.mark_fatal_transition",
            "display_name": "逐项回告批次事件并整理后续通知的处理进度及结果"
          }
        ],
        "loop": {
          "body": "era.tavern.flow.settlement_settle_receipts_item",
          "max_iterations": null,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "era.tavern.frame.settlement.mark_fatal_transition",
              "as": "frame",
              "update": "frame"
            }
          ],
          "outputs": [
            {
              "from": "frame",
              "as": "era_tavern_flow_settlement_settle_receipts_loop_frame"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "settle_receipts",
        "display_name": "确认本批原事件都已逐项回告",
        "description": "在“逐项回告批次事件并整理后续通知”流程中，接收事件结算循环结束的资料，继续进入严重故障固定、诊断和通知整理。此时原事件已经得到处理确认，后续不会再次结算同一项。",
        "definition_id": "era.tavern.settlement.settle_receipts"
      },
      {
        "id": "latch_fatal",
        "display_name": "进入严重故障状态并结束运行等待",
        "description": "在“逐项回告批次事件并整理后续通知”流程中，本批要求停止服务时，固定严重故障状态，取消操作等待并拒绝仍挂起的事件接收。配合之前已回告的结果，让当前实例停止继续接收业务。",
        "definition_id": "era.tavern.settlement.latch_fatal"
      },
      {
        "id": "publish_diagnostics",
        "display_name": "把本批问题和提示报告到页面日志",
        "description": "在“逐项回告批次事件并整理后续通知”流程中，读取主服务返回的各项诊断，逐条写入本实例日志。供用户或开发者看到实际处理中的提示与原因，原事件结论保持实际状态。",
        "definition_id": "era.tavern.settlement.publish_diagnostics"
      },
      {
        "id": "enqueue_notifications",
        "display_name": "交接本批已经整理的通知资料",
        "description": "在“逐项回告批次事件并整理后续通知”流程中，接收已完成批次结算的资料，交给后续通知准备。这里只继续传递现有内容，通知实际发起和完成处理由相应通知流程负责。",
        "definition_id": "era.tavern.settlement.enqueue_notifications"
      },
      {
        "id": "end",
        "display_name": "结束逐项回告批次事件并整理后续通知",
        "description": "标明“逐项回告批次事件并整理后续通知”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "mark_fatal_transition",
        "settle_receipts_loop"
      ],
      [
        "settle_receipts",
        "latch_fatal"
      ],
      [
        "latch_fatal",
        "publish_diagnostics"
      ],
      [
        "publish_diagnostics",
        "enqueue_notifications"
      ],
      [
        "settle_receipts_loop",
        "settle_receipts"
      ],
      [
        "start",
        "mark_fatal_transition"
      ],
      [
        "enqueue_notifications",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "逐项回告批次事件并整理后续通知的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
