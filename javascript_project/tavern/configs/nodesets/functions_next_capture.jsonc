{
  "type_key": "era.tavern.flow.functions_next_capture",
  "display_name": "同步捕获作者请求、完成或等待资源",
  "description": "原生每轮显式选择请求、结束或等待；队列选择和终态判定不藏在 Node 内部无限循环。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_functions_next_capture_frame",
      "type": "era.tavern.frame.functions_next_wait_request_item.final",
      "display_name": "处理后的资源与事实"
    },
    {
      "key": "era_tavern_flow_functions_next_capture_done",
      "type": "era.tavern.done.functions_next.wait_request",
      "display_name": "本次是否已经取得结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "当前作者调用"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose_next",
        "type_used": "era.tavern.functions_next_wait_request_item.choose_next",
        "display_name": "识别已捕获请求、完成或继续等待",
        "description": "优先交还同步前段固定的原请求；否则读取当前作者队列、finished 和 pending，并选择 request、done 或 wait。"
      },
      {
        "id": "take_request",
        "type_used": "era.tavern.functions_next_wait_request_item.take_request",
        "display_name": "交还当前原作者请求",
        "description": "只取一个 commit 或同步请求，保留 id/type/payload；变量应用继续由主 Service 的同一块循环执行。"
      },
      {
        "id": "finish_call",
        "type_used": "era.tavern.functions_next_wait_request_item.finish_call",
        "display_name": "交还已真正完成的作者调用",
        "description": "只有 finished 且 pending=0 才形成 done，保留原函数错误。"
      },
      {
        "id": "await_wake",
        "type_used": "era.tavern.functions_next_wait_request_item.await_wake",
        "display_name": "登记作者请求唤醒资源",
        "description": "当前既无请求也未完成时登记本次 call.wake Promise；只创建资源并交还，等待由异步 Node 执行。"
      },
      {
        "id": "join_result",
        "type_used": "era.tavern.functions_next_wait_request_item.join_result",
        "display_name": "汇合当前唯一作者等待结果",
        "description": "当前互斥路径必须产生一个实际结果。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose_next",
        "to": "take_request",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'request'"
      },
      {
        "from": "choose_next",
        "to": "finish_call",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'done'"
      },
      {
        "from": "choose_next",
        "to": "await_wake",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'wait'"
      },
      [
        "take_request",
        "join_result"
      ],
      [
        "finish_call",
        "join_result"
      ],
      [
        "await_wake",
        "join_result"
      ],
      [
        "start",
        "choose_next"
      ],
      [
        "join_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.functions_next_wait_request_item.final",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "下一轮作者资料"
      },
      {
        "type": "era.tavern.done.functions_next.wait_request",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "是否结束等待"
      }
    ],
    "max_steps": 11
  }
}
