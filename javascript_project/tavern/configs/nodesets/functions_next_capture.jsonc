{
  "type_key": "era.tavern.flow.functions_next_capture",
  "display_name": "检查作者是否有请求或已经结束",
  "description": "确认当前作者调用仍有效，优先取出待处理操作，全部完成时返回结束，否则登记一次唤醒等待。外层据此决定立即返回还是继续异步等待。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "检查作者是否有请求或已经结束的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_functions_next_capture_frame",
      "type": "era.tavern.frame.functions_next_wait_request_item.final",
      "display_name": "检查作者是否有请求或已经结束的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_functions_next_capture_done",
      "type": "era.tavern.done.functions_next.wait_request",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "required": true,
        "display_name": "检查作者是否有请求或已经结束的请求和已有进度"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始检查作者是否有请求或已经结束",
        "description": "标明“检查作者是否有请求或已经结束”的开始位置。确认当前作者调用仍有效，优先取出待处理操作，全部完成时返回结束，否则登记一次唤醒等待。外层据此决定立即返回还是继续异步等待。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_next",
        "display_name": "判断作者有新请求、已结束或仍需等待",
        "description": "在“检查作者是否有请求或已经结束”流程中，检查作者函数的请求队列和运行状态。优先交出已提出的操作；函数结束且没有待确认请求时返回结束，否则继续等待唤醒。",
        "definition_id": "era.tavern.functions_next_wait_request_item.choose_next"
      },
      {
        "id": "take_request",
        "display_name": "取出作者提交的下一项操作",
        "description": "在“检查作者是否有请求或已经结束”流程中，从当前函数请求队列取出最早一项，交出操作编号、种类和内容，并标记本轮等待已取得结果。主服务随后在消息位置执行并确认。",
        "definition_id": "era.tavern.functions_next_wait_request_item.take_request"
      },
      {
        "id": "finish_call",
        "display_name": "返回作者函数已结束的状态",
        "description": "在“检查作者是否有请求或已经结束”流程中，当前作者函数已经结束且待确认操作均已处理时，交出结束结果及函数错误。主服务据此完成正文调用标记并安排释放运行资料。",
        "definition_id": "era.tavern.functions_next_wait_request_item.finish_call"
      },
      {
        "id": "await_wake",
        "display_name": "登记等待作者下一步的唤醒",
        "description": "在“检查作者是否有请求或已经结束”流程中，当前没有请求且函数尚未结束时，建立一次唤醒等待，供作者提交操作或运行结束时通知。外层循环等待后重新检查实际状态。",
        "definition_id": "era.tavern.functions_next_wait_request_item.await_wake"
      },
      {
        "id": "join_result",
        "display_name": "交接检查一次作者进度并按需等待的选中结果",
        "description": "在“检查作者是否有请求或已经结束”流程中，在“检查一次作者进度并按需等待”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.functions_next_wait_request_item.join_result"
      },
      {
        "id": "end",
        "display_name": "结束检查作者是否有请求或已经结束",
        "description": "标明“检查作者是否有请求或已经结束”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_next",
        "to": "take_request",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'request'"
      },
      {
        "from": "choose_next",
        "to": "finish_call",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'done'"
      },
      {
        "from": "choose_next",
        "to": "await_wake",
        "when": "era_tavern_functions_next_wait_request_item_choose_next_route == 'wait'"
      },
      [
        "take_request",
        "join_result"
      ],
      [
        "finish_call",
        "join_result"
      ],
      [
        "await_wake",
        "join_result"
      ],
      [
        "start",
        "choose_next"
      ],
      [
        "join_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.functions_next_wait_request_item.final",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "检查作者是否有请求或已经结束的处理进度及结果"
      },
      {
        "type": "era.tavern.done.functions_next.wait_request",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ],
    "max_steps": 11
  }
}
