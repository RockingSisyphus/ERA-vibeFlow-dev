{
  "type_key": "era.tavern.flow.sidecar_read_record_finish",
  "display_name": "读取状态文件：独立状态文件与内存快照：等待与确认",
  "description": "续用同步段已发起资源；保留原等待后的具体处理、结果核对与错误身份。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_sidecar_read_record_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "execute",
        "type_used": "era.tavern.sidecar_read_record.execute",
        "display_name": "等待本次读取状态文件：独立状态文件与内存快照的资源终态",
        "description": "等待同步原生段已捕获的本次资源；检查所属实例和取消，不重发原 API，不执行后续回读或发布。"
      },
      {
        "id": "choose_response",
        "type_used": "era.tavern.sidecar_read_record_finish.choose_response",
        "display_name": "区分缺失、成功和失败响应",
        "description": "404 产生 missing；成功响应才读取文本；其他状态按原错误拒绝。"
      },
      {
        "id": "missing",
        "type_used": "era.tavern.sidecar_read_record_finish.missing",
        "display_name": "交还缺失文件确认",
        "description": "沿用原 sidecarId，形成 missing，不读取正文。"
      },
      {
        "id": "failed",
        "type_used": "era.tavern.sidecar_read_record_finish.failed",
        "display_name": "拒绝 Sidecar HTTP 失败",
        "description": "保留原 HTTP 状态和错误类别，不把读取失败当缺失。"
      },
      {
        "id": "read_text",
        "type_used": "era.tavern.sidecar_read_record_finish.read_text",
        "display_name": "读取 Sidecar 响应文本",
        "description": "只调用本次 Response.text 并等待，不重复 fetch。"
      },
      {
        "id": "choose_json",
        "type_used": "era.tavern.sidecar_read_record_finish.choose_json",
        "display_name": "解析并区分有效或无效文件",
        "description": "解析响应文本为便携记录；语法错误选择 invalid，不抛出替代 missing。"
      },
      {
        "id": "found",
        "type_used": "era.tavern.sidecar_read_record_finish.found",
        "display_name": "形成已找到的文件结果",
        "description": "交还本次便携 record 和 sidecarId。"
      },
      {
        "id": "invalid",
        "type_used": "era.tavern.sidecar_read_record_finish.invalid",
        "display_name": "形成无效文件确认",
        "description": "交还原 invalid 状态及 sidecarId，不发布快照。"
      },
      {
        "id": "join_result",
        "type_used": "era.tavern.sidecar_read_record_finish.join_result",
        "display_name": "汇合唯一文件读取结果",
        "description": "只接收实际激活的一项 missing/found/invalid 结果，拒绝多结果。"
      },
      {
        "id": "return_result",
        "type_used": "era.tavern.sidecar_read_record.return_result",
        "display_name": "交还读取状态文件结果",
        "description": "返回原 era.tavern.sidecar.read_record.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "execute",
        "choose_response"
      ],
      {
        "from": "choose_response",
        "to": "missing",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'missing'"
      },
      {
        "from": "choose_response",
        "to": "read_text",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'found'"
      },
      {
        "from": "choose_response",
        "to": "failed",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'failed'"
      },
      [
        "read_text",
        "choose_json"
      ],
      {
        "from": "choose_json",
        "to": "found",
        "when": "era_tavern_sidecar_read_record_finish_choose_json_route == 'found'"
      },
      {
        "from": "choose_json",
        "to": "invalid",
        "when": "era_tavern_sidecar_read_record_finish_choose_json_route == 'invalid'"
      },
      [
        "missing",
        "join_result"
      ],
      [
        "found",
        "join_result"
      ],
      [
        "invalid",
        "join_result"
      ],
      [
        "failed",
        "join_result"
      ],
      [
        "join_result",
        "return_result"
      ],
      [
        "start",
        "execute"
      ],
      [
        "return_result",
        "end"
      ]
    ]
  }
}
