{
  "type_key": "era.tavern.flow.sidecar_read_record_finish",
  "display_name": "读取状态文件内容并区分可用或损坏",
  "description": "接收已发起的文件请求，等待响应，明确区分缺失、成功和服务失败。成功文件读出文字并检查能否解析，交回记录或无效结论，供绑定及修复选择。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "读取状态文件内容并区分可用或损坏的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_sidecar_read_record_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "读取状态文件内容并区分可用或损坏的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "读取状态文件内容并区分可用或损坏的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "读取状态文件内容并区分可用或损坏的处理进度及结果"
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始读取状态文件内容并区分可用或损坏",
        "description": "标明“读取状态文件内容并区分可用或损坏”的开始位置。接收已发起的文件请求，等待响应，明确区分缺失、成功和服务失败。成功文件读出文字并检查能否解析，交回记录或无效结论，供绑定及修复选择。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "execute",
        "display_name": "等待独立状态文件的读取响应",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，接收已经发起的状态文件读取，等待酒馆返回响应。实际是否存在及内容是否有效，由后续明确步骤判断。",
        "definition_id": "era.tavern.sidecar_read_record.execute"
      },
      {
        "id": "choose_response",
        "display_name": "区分文件缺失、读取成功或请求失败",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，检查状态文件读取响应。文件不存在时返回缺失，成功时继续读取内容，其他失败报告原因，供绑定和修复流程采用正确处理方式。",
        "definition_id": "era.tavern.sidecar_read_record_finish.choose_response"
      },
      {
        "id": "missing",
        "display_name": "返回独立状态文件不存在的确认",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，状态文件读取明确返回不存在时，交出缺失结论和文件身份。主服务据此决定新建、选择其他文件或提示修复。",
        "definition_id": "era.tavern.sidecar_read_record_finish.missing"
      },
      {
        "id": "failed",
        "display_name": "报告独立状态文件读取失败",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，读取请求未成功且并非文件不存在时，返回对应失败状态。上层据此报告原因，不会把网络或服务问题当成一份空状态。",
        "definition_id": "era.tavern.sidecar_read_record_finish.failed"
      },
      {
        "id": "read_text",
        "display_name": "读出状态文件中的实际文字",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，接收成功的文件响应，读取完整文件内容。后续检查它能否解析为状态记录，供加载或损坏处理。",
        "definition_id": "era.tavern.sidecar_read_record_finish.read_text"
      },
      {
        "id": "choose_json",
        "display_name": "判断状态文件能否正常解析",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，尝试读取文件中的结构化内容，成功时交给有效文件分支，失败时交给损坏分支。让主服务能区分文件缺失与文件内容不可用。",
        "definition_id": "era.tavern.sidecar_read_record_finish.choose_json"
      },
      {
        "id": "found",
        "display_name": "返回读取到的状态文件记录",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，将已经读出且能够解析的文件内容与文件身份交回主服务。后续继续检查它的归属、版本和业务结构，再决定采用。",
        "definition_id": "era.tavern.sidecar_read_record_finish.found"
      },
      {
        "id": "invalid",
        "display_name": "返回状态文件内容无法解析的确认",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，文件存在但内容不能解析时，返回无效结论和文件身份。主服务据此提示用户选择修复方式，而不采用无法读取的数据。",
        "definition_id": "era.tavern.sidecar_read_record_finish.invalid"
      },
      {
        "id": "join_result",
        "display_name": "交接读取状态文件内容并区分可用或损坏的选中结果",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，在“读取状态文件内容并区分可用或损坏”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.sidecar_read_record_finish.join_result"
      },
      {
        "id": "return_result",
        "display_name": "交回“读取独立状态文件”的实际结果",
        "description": "在“读取状态文件内容并区分可用或损坏”流程中，接收“读取独立状态文件”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.sidecar_read_record.return_result"
      },
      {
        "id": "end",
        "display_name": "结束读取状态文件内容并区分可用或损坏",
        "description": "标明“读取状态文件内容并区分可用或损坏”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "execute",
        "choose_response"
      ],
      {
        "from": "choose_response",
        "to": "missing",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'missing'"
      },
      {
        "from": "choose_response",
        "to": "read_text",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'found'"
      },
      {
        "from": "choose_response",
        "to": "failed",
        "when": "era_tavern_sidecar_read_record_finish_choose_response_route == 'failed'"
      },
      [
        "read_text",
        "choose_json"
      ],
      {
        "from": "choose_json",
        "to": "found",
        "when": "era_tavern_sidecar_read_record_finish_choose_json_route == 'found'"
      },
      {
        "from": "choose_json",
        "to": "invalid",
        "when": "era_tavern_sidecar_read_record_finish_choose_json_route == 'invalid'"
      },
      [
        "missing",
        "join_result"
      ],
      [
        "found",
        "join_result"
      ],
      [
        "invalid",
        "join_result"
      ],
      [
        "failed",
        "join_result"
      ],
      [
        "join_result",
        "return_result"
      ],
      [
        "start",
        "execute"
      ],
      [
        "return_result",
        "end"
      ]
    ]
  }
}
