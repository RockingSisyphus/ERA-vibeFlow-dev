{
  "type_key": "era.tavern.flow.agent_generate_finish",
  "display_name": "整理独立模型请求完成后的结果",
  "description": "接收已发起模型调用的真实完成资料，检查辅助生成标记已解除，区分文字、取消和失败。返回文字及连接摘要或具体失败，使主服务继续检查该阶段输出。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "整理独立模型请求完成后的结果的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_agent_generate_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "整理独立模型请求完成后的结果的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "整理独立模型请求完成后的结果的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "整理独立模型请求完成后的结果的处理进度及结果"
      }
    ],
    "max_steps": 14,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始整理独立模型请求完成后的结果",
        "description": "标明“整理独立模型请求完成后的结果”的开始位置。接收已发起模型调用的真实完成资料，检查辅助生成标记已解除，区分文字、取消和失败。返回文字及连接摘要或具体失败，使主服务继续检查该阶段输出。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "request_model",
        "display_name": "读取模型调用真实完成的结果（规划或结算的独立生成）",
        "description": "在“整理独立模型请求完成后的结果”流程中，本次处理“规划或结算的独立生成”。接收本次模型请求已经完成的事实，核对所属实例，记录返回文字或失败情况。独立连接请求失败时整理可读原因，供后续区分成功、取消和失败。",
        "definition_id": "era.tavern.agent_generate.request_model"
      },
      {
        "id": "leave_auxiliary",
        "display_name": "确认本次辅助生成标记已经解除（规划或结算的独立生成）",
        "description": "在“整理独立模型请求完成后的结果”流程中，本次处理“规划或结算的独立生成”。在模型真实结束后检查本次辅助生成计数是否已归还。确认后才继续整理结果，避免已经结束的请求仍影响之后的聊天事件识别。",
        "definition_id": "era.tavern.agent_generate.leave_auxiliary"
      },
      {
        "id": "classify_result",
        "display_name": "区分生成文字、取消或失败（规划或结算的独立生成）",
        "description": "在“整理独立模型请求完成后的结果”流程中，本次处理“规划或结算的独立生成”。检查本次模型调用是否取消、是否失败，以及响应是否为有效文字。选择对应处理分支，让调用方得到文字结果或明确的取消、失败结论。",
        "definition_id": "era.tavern.agent_generate.classify_result"
      },
      {
        "id": "select_cancelled",
        "display_name": "按原原因结束已取消的模型请求（规划或结算的独立生成）",
        "description": "在“整理独立模型请求完成后的结果”流程中，本次处理“规划或结算的独立生成”。读取本次模型请求的取消原因并终止当前操作。外层等待据此收到取消结论，不会把取消误记成模型返回了有效文字。",
        "definition_id": "era.tavern.agent_generate.select_cancelled"
      },
      {
        "id": "select_failed",
        "display_name": "返回独立模型生成失败的说明",
        "description": "在“整理独立模型请求完成后的结果”流程中，接收规划或结算模型请求的失败，整理对应问题及请求身份。返回明确失败结果，供多阶段生成决定是否重试或向页面说明原因。",
        "definition_id": "era.tavern.agent_generate.select_failed"
      },
      {
        "id": "select_text",
        "display_name": "返回独立生成文字和连接摘要",
        "description": "在“整理独立模型请求完成后的结果”流程中，接收独立模型请求成功返回的文字，附上本次请求身份及实际连接摘要。主服务据此继续处理规划或结算内容，其中不包含连接密钥。",
        "definition_id": "era.tavern.agent_generate.select_text"
      },
      {
        "id": "join_return_model",
        "display_name": "交接规划或结算的独立生成的选中结果",
        "description": "在“整理独立模型请求完成后的结果”流程中，在“规划或结算的独立生成”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.agent_generate.join_return_model"
      },
      {
        "id": "return_model",
        "display_name": "交回“规划或结算的独立生成”的实际结果",
        "description": "在“整理独立模型请求完成后的结果”流程中，接收“规划或结算的独立生成”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.agent_generate.return_model"
      },
      {
        "id": "end",
        "display_name": "结束整理独立模型请求完成后的结果",
        "description": "标明“整理独立模型请求完成后的结果”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "request_model",
        "leave_auxiliary"
      ],
      [
        "leave_auxiliary",
        "classify_result"
      ],
      {
        "from": "classify_result",
        "to": "select_text",
        "when": "era_tavern_agent_generate_classify_result_route == 'text'"
      },
      [
        "select_text",
        "join_return_model"
      ],
      {
        "from": "classify_result",
        "to": "select_failed",
        "when": "era_tavern_agent_generate_classify_result_route == 'failed'"
      },
      [
        "select_failed",
        "join_return_model"
      ],
      {
        "from": "classify_result",
        "to": "select_cancelled",
        "when": "era_tavern_agent_generate_classify_result_route == 'cancelled'"
      },
      [
        "select_cancelled",
        "join_return_model"
      ],
      [
        "join_return_model",
        "return_model"
      ],
      [
        "start",
        "request_model"
      ],
      [
        "return_model",
        "end"
      ]
    ]
  }
}
