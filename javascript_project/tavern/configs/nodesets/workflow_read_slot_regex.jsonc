{
  "type_key": "era.tavern.workflow.read_slot.regex",
  "display_name": "读取正则并等待实际IO结束",
  "description": "沿用原正则读取参数、返回合同及资源原语；与本组其他实际读取共同运行。取消或出错也等待已启动IO和清理结束，不启动图外完成回调工作流。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.read_slot",
      "cardinality": "exactly_one",
      "display_name": "正则读取要求与所属资源"
    }
  ],
  "provides": [
    {
      "key": "reply_regex",
      "type": "era.tavern.read_slot.reply",
      "display_name": "正则的实际读取结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "slot",
        "type": "era.tavern.read_slot",
        "required": true,
        "display_name": "本次单项读取要求与资源"
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.read_slot.reply",
        "cardinality": "exactly_one",
        "as": "reply",
        "display_name": "这项读取的实际结果"
      }
    ],
    "max_steps": 18,
    "nodes": [
      {
        "id": "start",
        "definition_id": "era.tavern.initialize.start",
        "display_name": "开始读取正则并等待实际IO结束",
        "description": "接收本次请求并进入“读取正则并等待实际IO结束”；具体结果由后续实际处理步骤给出。"
      },
      {
        "id": "prepare",
        "display_name": "读取正则并等待实际IO结束：准备",
        "description": "沿用原正则读取参数、返回合同及资源原语；与本组其他实际读取共同运行。取消或出错也等待已启动IO和清理结束，不启动图外完成回调工作流。",
        "definition_id": "era.tavern.workflow.read_slot.regex.prepare"
      },
      {
        "id": "prefix_route_read__check_request",
        "display_name": "检查“读取角色正则规则”的调用是否有效",
        "description": "在“分派角色正则规则操作”流程中，接收“读取角色正则规则”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.regex_read.check_request"
      },
      {
        "id": "prefix_route_read__execute",
        "display_name": "读取角色正则规则及启用状态",
        "description": "在“分派角色正则规则操作”流程中，读取当前角色的正则清单和开关，返回给资源规划。初始化据此判断状态栏显示规则是否已安装、是否需要补齐。",
        "definition_id": "era.tavern.regex_read.execute"
      },
      {
        "id": "prefix_route_read__return_result",
        "display_name": "交回“读取角色正则规则”的实际结果",
        "description": "在“分派角色正则规则操作”流程中，接收“读取角色正则规则”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.regex_read.return_result"
      },
      {
        "id": "project_immediate",
        "display_name": "读取正则并等待实际IO结束：整理即时结果",
        "description": "沿用原正则读取参数、返回合同及资源原语；与本组其他实际读取共同运行。取消或出错也等待已启动IO和清理结束，不启动图外完成回调工作流。",
        "definition_id": "era.tavern.workflow.read_slot.regex.project_immediate"
      },
      {
        "id": "end",
        "definition_id": "era.tavern.initialize.end",
        "display_name": "完成读取正则并等待实际IO结束",
        "description": "本段所选路径已经结束，向调用方交回实际结果或结束确认。"
      }
    ],
    "edges": [
      [
        "prepare",
        "prefix_route_read__check_request"
      ],
      [
        "prefix_route_read__check_request",
        "prefix_route_read__execute"
      ],
      [
        "prefix_route_read__execute",
        "prefix_route_read__return_result"
      ],
      [
        "prefix_route_read__return_result",
        "project_immediate"
      ],
      [
        "start",
        "prepare"
      ],
      [
        "project_immediate",
        "end"
      ]
    ]
  }
}
