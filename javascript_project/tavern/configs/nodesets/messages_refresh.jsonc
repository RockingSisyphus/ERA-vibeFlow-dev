{
  "type_key": "era.tavern.flow.messages_refresh",
  "display_name": "按请求刷新当前消息显示",
  "description": "实现 era.tavern.messages.refresh；输入沿用 era.tavern.messages.refresh.request，输出沿用 era.tavern.messages.refresh.result，完成方式保持 suspend。 原节点保留；仅把首次等待划为同步发起与异步等待，后续处理在对应 finish 流程。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "当前实例与调用资料"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_messages_refresh_frame",
      "type": "era.tavern.frame.messages_refresh.started",
      "display_name": "当前步骤的资源与已捕获事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "调用与资源资料",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.messages_refresh.started",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本次已经发起的等待资源"
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "check_basis",
        "type_used": "era.tavern.messages_refresh.check_basis",
        "display_name": "复核显示更新依据",
        "description": "有 sourceBasis 时核对当前消息，不对陈旧目标执行重绘。"
      },
      {
        "id": "choose_refresh",
        "type_used": "era.tavern.messages_refresh.choose_refresh",
        "display_name": "选择全聊天或单消息刷新",
        "description": "依据 Service 给出的 mode，区分 reloadCurrentChat 与 refreshOneMessage。"
      },
      {
        "id": "select_one",
        "type_used": "era.tavern.messages_refresh.select_one",
        "display_name": "刷新指定消息",
        "description": "调用 refreshOneMessage，保留原消息 ID 检查。"
      },
      {
        "id": "select_all",
        "type_used": "era.tavern.messages_refresh.select_all",
        "display_name": "刷新整个当前聊天",
        "description": "调用 SillyTavern.reloadCurrentChat，并等待实际返回。"
      },
      {
        "id": "join_refresh",
        "type_used": "era.tavern.messages_refresh.join_refresh",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "start_operation",
        "type_used": "era.tavern.messages_refresh.start_operation",
        "display_name": "同步发起所选消息刷新",
        "description": "按原 one/all 分支核对来源并发起 refreshOneMessage 或 reloadCurrentChat；异步段只等待本次刷新。 此 Node 只发起原始操作并创建等待资源；不执行异步续体。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "check_basis",
        "choose_refresh"
      ],
      {
        "from": "choose_refresh",
        "to": "select_all",
        "when": "era_tavern_messages_refresh_choose_refresh_route == 'all'"
      },
      [
        "select_all",
        "join_refresh"
      ],
      {
        "from": "choose_refresh",
        "to": "select_one",
        "when": "era_tavern_messages_refresh_choose_refresh_route == 'one'"
      },
      [
        "select_one",
        "join_refresh"
      ],
      [
        "join_refresh",
        "start_operation"
      ],
      [
        "start",
        "check_basis"
      ],
      [
        "start_operation",
        "end"
      ]
    ]
  }
}
