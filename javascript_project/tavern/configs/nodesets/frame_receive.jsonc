{
  "type_key": "era.tavern.flow.frame_receive",
  "display_name": "向主服务交付下一条有效事件",
  "description": "检查实例和事件通道，队列有内容就取最早一项，没有则登记并等待。取消或实例关闭时结束等待，成功时将事件交给主服务做业务判断。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "向主服务交付下一条有效事件的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_frame_receive_frame",
      "type": "era.tavern.call.frame",
      "display_name": "向主服务交付下一条有效事件的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "向主服务交付下一条有效事件的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "向主服务交付下一条有效事件的处理进度及结果",
        "as": "frame"
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始向主服务交付下一条有效事件",
        "description": "标明“向主服务交付下一条有效事件”的开始位置。检查实例和事件通道，队列有内容就取最早一项，没有则登记并等待。取消或实例关闭时结束等待，成功时将事件交给主服务做业务判断。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "await_event",
        "display_name": "取得队列事件或等待新事件到来",
        "description": "在“向主服务交付下一条有效事件”流程中，接收已取出的事件，或等待前一步登记的新事件到达。将该事件交给主服务；取消时按实际原因结束等待。",
        "definition_id": "era.tavern.frame_receive.await_event"
      },
      {
        "id": "return_event",
        "display_name": "将取得的队首事件交给主服务",
        "description": "在“向主服务交付下一条有效事件”流程中，接收已从队列取出或等待得到的事件，按主服务需要的形式交回。事件内容仍要由服务检查和规划，取得事件不代表任务已经执行。",
        "definition_id": "era.tavern.frame_receive.return_event"
      },
      {
        "id": "end",
        "display_name": "结束向主服务交付下一条有效事件",
        "description": "标明“向主服务交付下一条有效事件”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "await_event",
        "return_event"
      ],
      [
        "start",
        "await_event"
      ],
      [
        "return_event",
        "end"
      ]
    ]
  }
}
