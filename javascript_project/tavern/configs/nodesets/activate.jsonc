{
  "type_key": "era.tavern.flow.activate",
  "display_name": "按脚本启用决定连接聊天和界面",
  "description": "接收主服务对安装位置作出的启用或休眠决定，检查实例后只在启用分支登记聊天监听。完成启动决定，按需挂载界面，返回本实例是否已激活。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "按脚本启用决定连接聊天和界面的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_activate_frame",
      "type": "era.tavern.call.frame",
      "display_name": "按脚本启用决定连接聊天和界面的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "按脚本启用决定连接聊天和界面的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按脚本启用决定连接聊天和界面",
        "description": "标明“按脚本启用决定连接聊天和界面”的开始位置。接收主服务对安装位置作出的启用或休眠决定，检查实例后只在启用分支登记聊天监听。完成启动决定，按需挂载界面，返回本实例是否已激活。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_instance",
        "display_name": "确认当前实例可以启用监听",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，检查本次 ERA 实例是否已经启动、是否正在停止。只有可用实例才继续登记聊天事件，避免已关闭的实例重新开始接收请求。",
        "definition_id": "era.tavern.activate.check_instance"
      },
      {
        "id": "choose_scope",
        "display_name": "选择启用监听或保持休眠",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，读取主服务对脚本安装位置作出的决定，选择启用或休眠分支。后续据此安装监听，或仅确认该实例保持未启用状态。",
        "definition_id": "era.tavern.activate.choose_scope"
      },
      {
        "id": "branch_dormant",
        "display_name": "确认本实例保持休眠",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，接收不应启用的实例，返回未激活的确认。当前实例保持不监听聊天，随后完成启动决定的等待与提示。",
        "definition_id": "era.tavern.activate.branch_dormant"
      },
      {
        "id": "branch_allow",
        "display_name": "安装本实例的聊天和按钮监听",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，接收允许启用的实例，为聊天变化、生成事件和 ERA 按钮安装监听，并连接内部内容的显示处理。已安装时沿用同一组监听；登记失败会撤销本次已装部分，供后续安全启动。",
        "definition_id": "era.tavern.activate.branch_allow"
      },
      {
        "id": "join_settle_startup",
        "display_name": "交接按脚本启用决定连接聊天和界面的选中结果",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，在“按脚本启用决定连接聊天和界面”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.activate.join_settle_startup"
      },
      {
        "id": "settle_startup",
        "display_name": "公布启动决定并按需挂载界面",
        "description": "在“按脚本启用决定连接聊天和界面”流程中，接收启用或休眠结果，结束等待中的启动决定；启用且尚未呈现时挂载该实例界面。使启动调用方和页面都能知道当前实例已经进入哪种状态。",
        "definition_id": "era.tavern.activate.settle_startup"
      },
      {
        "id": "end",
        "display_name": "结束按脚本启用决定连接聊天和界面",
        "description": "标明“按脚本启用决定连接聊天和界面”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_instance",
        "choose_scope"
      ],
      {
        "from": "choose_scope",
        "to": "branch_allow",
        "when": "era_tavern_activate_choose_scope_route == 'allow'"
      },
      [
        "branch_allow",
        "join_settle_startup"
      ],
      {
        "from": "choose_scope",
        "to": "branch_dormant",
        "when": "era_tavern_activate_choose_scope_route == 'dormant'"
      },
      [
        "branch_dormant",
        "join_settle_startup"
      ],
      [
        "join_settle_startup",
        "settle_startup"
      ],
      [
        "start",
        "check_instance"
      ],
      [
        "settle_startup",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "display_name": "按脚本启用决定连接聊天和界面的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
