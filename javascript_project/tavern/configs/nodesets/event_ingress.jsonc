{
  "type_key": "era.tavern.flow.event_ingress",
  "display_name": "把酒馆事件整理成 ERA 输入",
  "description": "接收聊天回调，识别辅助生成和内部写入回声，更新过期生成及作者调用的状态。普通事件按序入队，需要生成前等待的事件继续等待相关处理，返回对应回调结果。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "把酒馆事件整理成 ERA 输入的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_event_ingress_frame",
      "type": "era.tavern.frame.event_ingress.result",
      "display_name": "把酒馆事件整理成 ERA 输入的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "把酒馆事件整理成 ERA 输入的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 17,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始把酒馆事件整理成 ERA 输入",
        "description": "标明“把酒馆事件整理成 ERA 输入”的开始位置。接收聊天回调，识别辅助生成和内部写入回声，更新过期生成及作者调用的状态。普通事件按序入队，需要生成前等待的事件继续等待相关处理，返回对应回调结果。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "read_event_facts",
        "display_name": "识别聊天事件是否由 ERA 自己触发",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，读取酒馆事件及已登记规则，区分辅助模型生成、ERA 内部消息写入和普通聊天变化。记录酒馆生成结束事实，供后续决定忽略内部事件还是交给主服务。",
        "definition_id": "era.tavern.event_ingress.read_event_facts"
      },
      {
        "id": "choose_event",
        "display_name": "选择忽略、普通入队或等待处理后生成",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，根据事件性质和生成时机，选择忽略内部回声、普通入队，或接收后等待相关处理完成。模拟生成检查不会误走真实生成的等待路径，后续按选定方式准备事件。",
        "definition_id": "era.tavern.event_ingress.choose_event"
      },
      {
        "id": "branch_barrier_prepare",
        "display_name": "准备需要等待状态更新的生成事件",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，接收需要在生成前等待的聊天事件，更新当前生成状态，取消已不适用的旧交接和作者调用，并标记本事件要等待处理完成。后续由统一事件入口接收，再等待相关状态就绪。",
        "definition_id": "era.tavern.event_ingress.branch_barrier_prepare"
      },
      {
        "id": "branch_enqueue_prepare",
        "display_name": "准备普通聊天变化交给主服务",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，接收普通聊天事件，更新当前聊天及生成状态，清理已过期的作者调用和阶段等待。将该事件交给统一入队流程，后续处理不阻塞当前普通回调。",
        "definition_id": "era.tavern.event_ingress.branch_enqueue_prepare"
      },
      {
        "id": "branch_ignore",
        "display_name": "结束无需交给主服务的内部事件",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，事件已被识别为辅助生成、ERA 自己写消息的回声或仅用于记录生成结束时，直接结束本次回调。相关结束事实已在读取阶段更新，不再重复排入业务队列。",
        "definition_id": "era.tavern.event_ingress.branch_ignore"
      },
      {
        "id": "join_admission_input",
        "display_name": "交接把酒馆事件整理成 ERA 输入的选中结果",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，在“把酒馆事件整理成 ERA 输入”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.event_ingress.join_admission_input"
      },
      {
        "id": "admit_shared",
        "display_name": "检查新事件并按序交给主服务",
        "description": "本环节用于“把酒馆事件整理成 ERA 输入”：接收聊天、界面、脚本或到期事件，检查实例状态、内容和容量。有效事件登记序号及结果等待，交给服务或进入队列；拒绝时返回具体原因，不进入队列。",
        "definition_id": "era.tavern.flow.admission"
      },
      {
        "id": "return_admission_branch",
        "display_name": "保留聊天事件实际接收的结论",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，接收统一事件入口的接收或拒绝结果，连同本事件是否需要生成前等待的安排，交给回调返回步骤。保持一次事件只接收一次。",
        "definition_id": "era.tavern.event_ingress.return_admission_branch"
      },
      {
        "id": "join_return_event",
        "display_name": "交接把酒馆事件整理成 ERA 输入的选中结果",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，在“把酒馆事件整理成 ERA 输入”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.event_ingress.join_return_event"
      },
      {
        "id": "return_event",
        "display_name": "普通事件返回，生成事件等待相关状态",
        "description": "在“把酒馆事件整理成 ERA 输入”流程中，接收事件入队的实际结论。普通事件结束当前回调；需要生成前等待且已被接收的事件，继续等待指定序号及之前的处理和阶段交接，避免模型过早读取变量。",
        "definition_id": "era.tavern.event_ingress.return_event"
      },
      {
        "id": "end",
        "display_name": "结束把酒馆事件整理成 ERA 输入",
        "description": "标明“把酒馆事件整理成 ERA 输入”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "read_event_facts",
        "choose_event"
      ],
      {
        "from": "choose_event",
        "to": "branch_ignore",
        "when": "era_tavern_event_ingress_choose_event_route == 'ignore'"
      },
      [
        "branch_ignore",
        "join_return_event"
      ],
      {
        "from": "choose_event",
        "to": "branch_enqueue_prepare",
        "when": "era_tavern_event_ingress_choose_event_route == 'enqueue'"
      },
      {
        "from": "choose_event",
        "to": "branch_barrier_prepare",
        "when": "era_tavern_event_ingress_choose_event_route == 'barrier'"
      },
      [
        "join_return_event",
        "return_event"
      ],
      [
        "branch_barrier_prepare",
        "join_admission_input"
      ],
      [
        "branch_enqueue_prepare",
        "join_admission_input"
      ],
      [
        "join_admission_input",
        "admit_shared"
      ],
      [
        "admit_shared",
        "return_admission_branch"
      ],
      [
        "return_admission_branch",
        "join_return_event"
      ],
      [
        "start",
        "read_event_facts"
      ],
      [
        "return_event",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.event_ingress.result",
        "cardinality": "exactly_one",
        "display_name": "把酒馆事件整理成 ERA 输入的处理进度及结果",
        "as": "frame"
      }
    ]
  }
}
