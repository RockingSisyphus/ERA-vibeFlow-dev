        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_request",
        "prepare_request"
      ],
      [
        "prepare_request",
        "enter_auxiliary"
      ],
      [
        "enter_auxiliary",
