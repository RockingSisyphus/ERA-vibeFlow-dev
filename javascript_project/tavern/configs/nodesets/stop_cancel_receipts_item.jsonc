{
  "type_key": "era.tavern.flow.stop_cancel_receipts_item",
  "display_name": "向一项未完成事件返回取消",
  "description": "从停止时记下的事件清单取下一项，尚未结束则返回实例停止原因并释放相关引用。外层重复到全部完成，已经结算的事件不重复确认。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.frame.stop.clear_timers",
      "cardinality": "exactly_one",
      "display_name": "向一项未完成事件返回取消的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_stop_cancel_receipts_item_frame",
      "type": "era.tavern.item.result.stop_cancel_receipts_item",
      "display_name": "向一项未完成事件返回取消的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_stop_cancel_receipts_item_done",
      "type": "era.tavern.done.stop.cancel_receipts",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.frame.stop.clear_timers",
        "display_name": "向一项未完成事件返回取消的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始向一项未完成事件返回取消",
        "description": "标明“向一项未完成事件返回取消”的开始位置。从停止时记下的事件清单取下一项，尚未结束则返回实例停止原因并释放相关引用。外层重复到全部完成，已经结算的事件不重复确认。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_item",
        "display_name": "选择下一项需要返回取消的事件",
        "description": "在“向一项未完成事件返回取消”流程中，查看停止时记下的未确认事件位置。还有项目时继续取消，全部处理完则结束遍历，让每个发起者都能结束等待。",
        "definition_id": "era.tavern.stop_cancel_receipts_item.choose_item"
      },
      {
        "id": "one_item",
        "display_name": "向一个未完成事件返回停止取消",
        "description": "在“向一项未完成事件返回取消”流程中，取出尚未结束的原事件，以本实例停止原因为它完成取消确认，并释放相应资料。随后继续下一项，已经完成的事件不会重复处理。",
        "definition_id": "era.tavern.stop_cancel_receipts_item.one_item"
      },
      {
        "id": "empty",
        "display_name": "确认本轮事件结果已经逐项处理完",
        "description": "在“向一项未完成事件返回取消”流程中，事件确认或取消清单已经遍历完时，标记本轮结束。后续进行整批诊断、通知或实例收尾。",
        "definition_id": "era.tavern.stop_cancel_receipts_item.empty"
      },
      {
        "id": "join_end",
        "display_name": "交接向一项未完成事件返回取消的选中结果",
        "description": "在“向一项未完成事件返回取消”流程中，在“向一项未完成事件返回取消”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.stop_cancel_receipts_item.join_end"
      },
      {
        "id": "end",
        "display_name": "结束向一项未完成事件返回取消",
        "description": "标明“向一项未完成事件返回取消”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_item",
        "to": "one_item",
        "when": "era_tavern_stop_cancel_receipts_item_choose_item_route == 'item'"
      },
      {
        "from": "choose_item",
        "to": "empty",
        "when": "era_tavern_stop_cancel_receipts_item_choose_item_route == 'done'"
      },
      [
        "one_item",
        "join_end"
      ],
      [
        "empty",
        "join_end"
      ],
      [
        "start",
        "choose_item"
      ],
      [
        "join_end",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.item.result.stop_cancel_receipts_item",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "向一项未完成事件返回取消的处理进度及结果"
      },
      {
        "type": "era.tavern.done.stop.cancel_receipts",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ]
  }
}
