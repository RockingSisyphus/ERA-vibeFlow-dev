{
  "type_key": "era.tavern.flow.regex_upsert_finish",
  "display_name": "确认角色正则保存并使规则生效",
  "description": "等待角色正则写入完成，检查开关，必要时开启并保存设置，再重新加载聊天。返回规则数量和启用确认，供初始化知道状态栏规则已经可用。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "确认角色正则保存并使规则生效的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_regex_upsert_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "确认角色正则保存并使规则生效的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "确认角色正则保存并使规则生效的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "确认角色正则保存并使规则生效的处理进度及结果"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始确认角色正则保存并使规则生效",
        "description": "标明“确认角色正则保存并使规则生效”的开始位置。等待角色正则写入完成，检查开关，必要时开启并保存设置，再重新加载聊天。返回规则数量和启用确认，供初始化知道状态栏规则已经可用。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "execute",
        "display_name": "等待角色正则规则写入完成",
        "description": "在“确认角色正则保存并使规则生效”流程中，接收已发起的角色正则保存，等待实际结束。后续检查启用状态，确保新规则能够在当前角色生效。",
        "definition_id": "era.tavern.regex_upsert.execute"
      },
      {
        "id": "choose_enabled",
        "display_name": "判断角色正则是否还需要开启",
        "description": "在“确认角色正则保存并使规则生效”流程中，检查当前角色正则已否启用。已开启则沿用，尚未开启则进入设置保存，之后统一重新加载聊天使规则生效。",
        "definition_id": "era.tavern.regex_upsert_finish.choose_enabled"
      },
      {
        "id": "enable_and_save",
        "display_name": "启用当前角色正则并保存开关",
        "description": "在“确认角色正则保存并使规则生效”流程中，将当前角色加入允许使用局部正则的名单，等待设置保存。后续重新加载聊天，使刚写入的状态栏等规则生效。",
        "definition_id": "era.tavern.regex_upsert_finish.enable_and_save"
      },
      {
        "id": "reload_chat",
        "display_name": "重新加载聊天使角色正则生效",
        "description": "在“确认角色正则保存并使规则生效”流程中，角色正则规则和启用设置已准备后，重新加载当前聊天。返回规则数量及启用确认，供资源初始化记录完成情况。",
        "definition_id": "era.tavern.regex_upsert_finish.reload_chat"
      },
      {
        "id": "return_result",
        "display_name": "交回“保存角色正则规则”的实际结果",
        "description": "在“确认角色正则保存并使规则生效”流程中，接收“保存角色正则规则”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.regex_upsert.return_result"
      },
      {
        "id": "already_enabled",
        "display_name": "沿用已经启用的角色正则",
        "description": "在“确认角色正则保存并使规则生效”流程中，当前角色正则开关已经开启时，保留这一事实，继续进入聊天重新加载。避免为同一开启状态再次保存设置。",
        "definition_id": "era.tavern.regex_upsert_finish.already_enabled"
      },
      {
        "id": "end",
        "display_name": "结束确认角色正则保存并使规则生效",
        "description": "标明“确认角色正则保存并使规则生效”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "reload_chat",
        "return_result"
      ],
      [
        "execute",
        "choose_enabled"
      ],
      [
        "enable_and_save",
        "reload_chat"
      ],
      {
        "from": "choose_enabled",
        "to": "enable_and_save",
        "when": "era_tavern_regex_upsert_finish_choose_enabled_route == 'enable'"
      },
      {
        "from": "choose_enabled",
        "to": "already_enabled",
        "when": "era_tavern_regex_upsert_finish_choose_enabled_route == 'enabled'"
      },
      [
        "already_enabled",
        "reload_chat"
      ],
      [
        "start",
        "execute"
      ],
      [
        "return_result",
        "end"
      ]
    ]
  }
}
