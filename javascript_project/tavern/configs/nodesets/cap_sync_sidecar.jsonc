{
  "type_key": "era.tavern.flow.cap_sync_sidecar",
  "display_name": "独立状态文件与内存快照操作",
  "description": "共享同一职责组的原操作与必要的等待前发起；无额外 cap 总分组。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_sidecar_frame",
