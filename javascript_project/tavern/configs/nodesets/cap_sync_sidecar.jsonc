    ],
    "max_steps": 33,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_sync_sidecar.choose",
        "display_name": "识别独立状态文件与内存快照操作",
        "description": "按已声明操作名选择唯一原生路径；即时操作、同步完成的 Promise 操作及真正等待前的发起共享本职责组，不重复分组。"
      },
      {
        "id": "route_read_current__check_request",
        "type_used": "era.tavern.sidecar_read_current.check_request",
        "display_name": "读取当前聊天状态：独立状态文件与内存快照：检查读取当前聊天状态请求",
        "description": "保持 era.tavern.sidecar.read_current 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_read_current__execute",
        "type_used": "era.tavern.sidecar_read_current.execute",
