{
  "type_key": "era.tavern.flow.cap_sync_messages",
  "display_name": "聊天消息操作",
  "description": "共享同一职责组的原操作与必要的等待前发起；无额外 cap 总分组。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_messages_frame",
      "type": "era.tavern.frame.final.cap_sync_messages",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_messages",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "choose",
        "type_used": "era.tavern.cap_sync_messages.choose",
        "display_name": "识别聊天消息操作",
        "description": "按已声明操作名选择唯一原生路径；即时操作、同步完成的 Promise 操作及真正等待前的发起共享本职责组，不重复分组。"
      },
      {
        "id": "route_read_context__check_request",
        "type_used": "era.tavern.messages_read_context.check_request",
        "display_name": "读取上下文：聊天消息：检查读取上下文请求",
        "description": "保持 era.tavern.messages.read_context 的现行参数、取消和目标复核；不新增资格条件。"
      },
      {
        "id": "route_read_context__execute",
        "type_used": "era.tavern.messages_read_context.execute",
        "display_name": "读取上下文：聊天消息：执行读取上下文操作",
        "description": "在酒馆页面执行该操作的实际 API 或资源动作；保留未知字段、现有错误类别及原同步/异步约定。"
      },
      {
        "id": "route_read_context__return_result",
        "type_used": "era.tavern.messages_read_context.return_result",
        "display_name": "读取上下文：聊天消息：交还读取上下文结果",
        "description": "返回原 era.tavern.messages.read_context.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "route_update_content",
        "type_used": "era.tavern.flow.messages_update_content",
        "display_name": "更新消息并确认保存完成",
        "description": "沿原 era.tavern.messages.update_content 合同执行当前唯一操作。"
      },
      {
        "id": "route_refresh",
        "type_used": "era.tavern.flow.messages_refresh",
        "display_name": "按请求刷新当前消息显示",
        "description": "沿原 era.tavern.messages.refresh 合同执行当前唯一操作。"
      },
      {
        "id": "join_return",
        "type_used": "era.tavern.cap_sync_messages.join_return",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read_context__check_request",
        "when": "era_tavern_cap_sync_messages_choose_route == 'read_context'"
      },
      [
        "route_read_context__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_update_content",
        "when": "era_tavern_cap_sync_messages_choose_route == 'update_content'"
      },
      [
        "route_update_content",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_refresh",
        "when": "era_tavern_cap_sync_messages_choose_route == 'refresh'"
      },
      [
        "route_refresh",
        "join_return"
      ],
      [
        "route_read_context__check_request",
        "route_read_context__execute"
      ],
      [
        "route_read_context__execute",
        "route_read_context__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
