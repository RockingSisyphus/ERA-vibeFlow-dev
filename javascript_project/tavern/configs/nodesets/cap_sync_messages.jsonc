{
  "type_key": "era.tavern.flow.cap_sync_messages",
  "display_name": "分派聊天消息操作",
  "description": "接收聊天消息请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派聊天消息操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_messages_frame",
      "type": "era.tavern.frame.final.cap_sync_messages",
      "display_name": "分派聊天消息操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派聊天消息操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_messages",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派聊天消息操作的处理进度及结果"
      }
    ],
    "max_steps": 13,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派聊天消息操作",
        "description": "标明“分派聊天消息操作”的开始位置。接收聊天消息请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择聊天消息的具体操作",
        "description": "在“分派聊天消息操作”流程中，接收聊天消息请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_messages.choose"
      },
      {
        "id": "route_read_context__check_request",
        "display_name": "检查“读取消息和回复分支”的调用是否有效",
        "description": "在“分派聊天消息操作”流程中，接收“读取消息和回复分支”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "definition_id": "era.tavern.messages_read_context.check_request"
      },
      {
        "id": "route_read_context__execute",
        "display_name": "读取消息正文及原生候选状态",
        "description": "用getChatMessages读取真实消息，除文字及索引外保留候选是否已存在、宿主是否仍在生成和该周期身份；预留位置继续投影为空正文，但不丢失其不可写事实。源：nodes/messages/read.ts与base_lib/messages/projection.ts。",
        "definition_id": "era.tavern.messages_read_context.execute"
      },
      {
        "id": "route_read_context__return_result",
        "display_name": "交回“读取消息和回复分支”的实际结果",
        "description": "在“分派聊天消息操作”流程中，接收“读取消息和回复分支”已经执行得到的结果，复核实例和本次调用尚未取消后交回发起者。调用方据此继续业务或显示结果，取消时按实际原因结束等待。",
        "definition_id": "era.tavern.messages_read_context.return_result"
      },
      {
        "id": "route_update_content",
        "display_name": "准备并发起一次消息批量更新",
        "description": "本环节用于“分派聊天消息操作”：核对聊天、消息和文件绑定，整理单条或多条更新并保留附加资料，再一次发起写入。后续确认流程等待更新、保存聊天、回读比较，最后返回实际写入状态。",
        "definition_id": "era.tavern.flow.messages_update_content"
      },
      {
        "id": "route_refresh",
        "display_name": "刷新指定消息或整段聊天显示",
        "description": "本环节用于“分派聊天消息操作”：检查实例和消息来源，按要求选择单条消息或整个聊天，发起重绘并等待真实完成。返回显示更新确认，变量保存结果仍由主服务的提交流程确定。",
        "definition_id": "era.tavern.flow.messages_refresh"
      },
      {
        "id": "join_return",
        "display_name": "交接分派聊天消息操作的选中结果",
        "description": "在“分派聊天消息操作”流程中，在“分派聊天消息操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_messages.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派聊天消息操作",
        "description": "标明“分派聊天消息操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_read_context__check_request",
        "when": "era_tavern_cap_sync_messages_choose_route == 'read_context'"
      },
      [
        "route_read_context__return_result",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_update_content",
        "when": "era_tavern_cap_sync_messages_choose_route == 'update_content'"
      },
      [
        "route_update_content",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_refresh",
        "when": "era_tavern_cap_sync_messages_choose_route == 'refresh'"
      },
      [
        "route_refresh",
        "join_return"
      ],
      [
        "route_read_context__check_request",
        "route_read_context__execute"
      ],
      [
        "route_read_context__execute",
        "route_read_context__return_result"
      ],
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
