{
  "type_key": "era.tavern.flow.character_write_main_greeting_finish",
  "display_name": "写入主开场白：角色卡与显示配置：等待与确认",
  "description": "续用同步段已发起资源；保留原等待后的具体处理、结果核对与错误身份。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_character_write_main_greeting_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "execute",
        "type_used": "era.tavern.character_write_main_greeting.execute",
        "display_name": "等待本次写入主开场白：角色卡与显示配置的资源终态",
        "description": "等待同步原生段已捕获的本次资源；检查所属实例和取消，不重发原 API，不执行后续回读或发布。"
      },
      {
        "id": "check_expected",
        "type_used": "era.tavern.character_write_main_greeting_finish.check_expected",
        "display_name": "核对读取到的旧主开场白",
        "description": "比较本次读取结果与 expected；不相等则报原 STALE 错误。"
      },
      {
        "id": "persist_greeting",
        "type_used": "era.tavern.character_write_main_greeting_finish.persist_greeting",
        "display_name": "持久化当前主开场白",
        "description": "核对当前目标并捕获真实 avatar，发起一次 merge-attributes 并等待；不按显示名寻址。"
      },
      {
        "id": "check_response",
        "type_used": "era.tavern.character_write_main_greeting_finish.check_response",
        "display_name": "核对开场白保存响应",
        "description": "核对 HTTP 成功，失败读取响应文本用于原错误；不能把 fulfilled 当保存成功。"
      },
      {
        "id": "publish_mirror",
        "type_used": "era.tavern.character_write_main_greeting_finish.publish_mirror",
        "display_name": "发布保存后的角色镜像和草稿",
        "description": "同步更新 first_mes、data、json_data 与编辑器草稿，随后形成 updated 确认；不自动重绘聊天。"
      },
      {
        "id": "return_result",
        "type_used": "era.tavern.character_write_main_greeting.return_result",
        "display_name": "交还写入主开场白结果",
        "description": "返回原 era.tavern.character.write_main_greeting.result 结果；需要脱敏的连接资料只返回摘要。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "publish_mirror",
        "return_result"
      ],
      [
        "execute",
        "check_expected"
      ],
      [
        "check_expected",
        "persist_greeting"
      ],
      [
        "persist_greeting",
        "check_response"
      ],
      [
        "check_response",
        "publish_mirror"
      ],
      [
        "start",
        "execute"
      ],
      [
        "return_result",
        "end"
      ]
    ]
  }
}
