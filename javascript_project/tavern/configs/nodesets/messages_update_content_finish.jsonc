{
  "type_key": "era.tavern.flow.messages_update_content_finish",
  "display_name": "等待消息更新并核实已经保存",
  "description": "接续已经发起的消息更新，确认仍在原聊天后保存，重新读取原聊天文件并比较应写入内容。成功后按需更新显示；失败时保留内存变化、保存是否确认和来源变化等事实供恢复。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "等待消息更新并核实已经保存的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_messages_update_content_finish_frame",
      "type": "era.tavern.call.frame",
      "display_name": "等待消息更新并核实已经保存的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "等待消息更新并核实已经保存的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.call.frame",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "等待消息更新并核实已经保存的处理进度及结果"
      }
    ],
    "max_steps": 12,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始等待消息更新并核实已经保存",
        "description": "标明“等待消息更新并核实已经保存”的开始位置。接续已经发起的消息更新，确认仍在原聊天后保存，重新读取原聊天文件并比较应写入内容。成功后按需更新显示；失败时保留内存变化、保存是否确认和来源变化等事实供恢复。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "update_messages",
        "display_name": "等待批量消息更新操作完成",
        "description": "在“等待消息更新并核实已经保存”流程中，接收已经发起的消息更新，等待酒馆实际处理结束。随后进入聊天保存与回读确认，使调用方能区分内存更新和真正保存。",
        "definition_id": "era.tavern.messages_update_content.update_messages"
      },
      {
        "id": "await_persistence",
        "display_name": "确认仍在原聊天后保存消息",
        "description": "在“等待消息更新并核实已经保存”流程中，消息更新完成后，检查仍是原目标聊天并等待聊天保存。没有实际正文变化时直接完成；保存或聊天切换出错时记下原因，供后续准确返回写入状态。",
        "definition_id": "era.tavern.messages_update_content.await_persistence"
      },
      {
        "id": "read_saved_chat",
        "display_name": "重新读取刚保存的原聊天文件",
        "description": "在“等待消息更新并核实已经保存”流程中，接收本次保存依据，向酒馆读取原目标聊天文件，检查读取是否成功。后续将保存后的内容与应写入消息比较，确认不是只改了页面内存。",
        "definition_id": "era.tavern.messages_update_content_finish.read_saved_chat"
      },
      {
        "id": "read_saved_json",
        "display_name": "读取保存回查中的消息内容",
        "description": "在“等待消息更新并核实已经保存”流程中，接收原聊天文件的读取响应，解析保存下来的消息列表。解析失败时保留原因，成功后交给内容比较步骤确认本次保存。",
        "definition_id": "era.tavern.messages_update_content_finish.read_saved_json"
      },
      {
        "id": "check_saved_messages",
        "display_name": "确认已保存消息与本次修改一致",
        "description": "在“等待消息更新并核实已经保存”流程中，将重新读取的聊天内容与应保存文字比较，并核对写入后的消息来源仍适用。记录保存已确认或实际问题，供后续返回准确结果。",
        "definition_id": "era.tavern.messages_update_content_finish.check_saved_messages"
      },
      {
        "id": "project_display",
        "display_name": "按真实保存结果更新消息显示",
        "description": "在“等待消息更新并核实已经保存”流程中，消息保存已确认时，按请求刷新其中内部操作内容的呈现。保存失败时返回内存已更新、保存是否确认及来源是否变化等信息，让主服务决定恢复或停止。",
        "definition_id": "era.tavern.messages_update_content.project_display"
      },
      {
        "id": "end",
        "display_name": "结束等待消息更新并核实已经保存",
        "description": "标明“等待消息更新并核实已经保存”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "update_messages",
        "await_persistence"
      ],
      [
        "check_saved_messages",
        "project_display"
      ],
      [
        "start",
        "update_messages"
      ],
      [
        "project_display",
        "end"
      ],
      {
        "from": "await_persistence",
        "to": "read_saved_chat",
        "when": "era_tavern_messages_update_content_await_persistence_route == 'continue'"
      },
      {
        "from": "await_persistence",
        "to": "project_display",
        "when": "era_tavern_messages_update_content_await_persistence_route != 'continue'"
      },
      {
        "from": "read_saved_chat",
        "to": "read_saved_json",
        "when": "era_tavern_messages_update_content_finish_read_saved_chat_route == 'continue'"
      },
      {
        "from": "read_saved_chat",
        "to": "project_display",
        "when": "era_tavern_messages_update_content_finish_read_saved_chat_route != 'continue'"
      },
      {
        "from": "read_saved_json",
        "to": "check_saved_messages",
        "when": "era_tavern_messages_update_content_finish_read_saved_json_route == 'continue'"
      },
      {
        "from": "read_saved_json",
        "to": "project_display",
        "when": "era_tavern_messages_update_content_finish_read_saved_json_route != 'continue'"
      }
    ]
  }
}
