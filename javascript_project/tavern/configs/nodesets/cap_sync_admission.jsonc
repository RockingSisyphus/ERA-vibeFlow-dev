{
  "type_key": "era.tavern.flow.cap_sync_admission",
  "display_name": "分派延迟事件操作",
  "description": "接收延迟事件请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "分派延迟事件操作的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_cap_sync_admission_frame",
      "type": "era.tavern.frame.final.cap_sync_admission",
      "display_name": "分派延迟事件操作的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "分派延迟事件操作的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.final.cap_sync_admission",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "分派延迟事件操作的处理进度及结果"
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始分派延迟事件操作",
        "description": "标明“分派延迟事件操作”的开始位置。接收延迟事件请求，按操作种类选择读取、修改或异步请求的发起流程。各分支分别保持自己的目标检查和实际结果，最后把本次选中操作的唯一结果交给调用方。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose",
        "display_name": "选择延迟事件的具体操作",
        "description": "在“分派延迟事件操作”流程中，接收延迟事件请求，读取明确操作种类，选择本组已声明的一条处理路径。未知操作报告原因，有效操作交给对应步骤完成，并返回实际结果。",
        "definition_id": "era.tavern.cap_sync_admission.choose"
      },
      {
        "id": "route_schedule",
        "display_name": "按明确要求安排、取消或沿用计时",
        "description": "本环节用于“分派延迟事件操作”：接收收集期限或延迟事件，检查原安排并选择保留、取消或替换，登记最近到期要求后返回确认。实际到期只回送约定事件，下一步业务仍由主服务判断。",
        "definition_id": "era.tavern.flow.timer_control"
      },
      {
        "id": "join_return",
        "display_name": "交接分派延迟事件操作的选中结果",
        "description": "在“分派延迟事件操作”流程中，在“分派延迟事件操作”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.cap_sync_admission.join_return"
      },
      {
        "id": "end",
        "display_name": "结束分派延迟事件操作",
        "description": "标明“分派延迟事件操作”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose",
        "to": "route_schedule",
        "when": "era_tavern_cap_sync_admission_choose_route == 'schedule'"
      },
      [
        "route_schedule",
        "join_return"
      ],
      {
        "from": "choose",
        "to": "route_schedule",
        "when": "era_tavern_cap_sync_admission_choose_route == 'cancel'"
      },
      [
        "start",
        "choose"
      ],
      [
        "join_return",
        "end"
      ]
    ]
  }
}
