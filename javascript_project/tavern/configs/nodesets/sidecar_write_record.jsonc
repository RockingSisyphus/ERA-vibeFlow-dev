{
  "type_key": "era.tavern.flow.sidecar_write_record",
  "display_name": "检查并发起独立状态文件保存",
  "description": "接收变量、函数和历史记录，检查文件身份及当前消息来源，整理上传内容后再核对一次目标并发起保存。异步完成流程检查真实响应，返回文件地址或失败原因。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "检查并发起独立状态文件保存的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_sidecar_write_record_frame",
      "type": "era.tavern.frame.sidecar_write_record.started",
      "display_name": "检查并发起独立状态文件保存的处理进度及结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "检查并发起独立状态文件保存的请求和已有进度",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.sidecar_write_record.started",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "检查并发起独立状态文件保存的处理进度及结果"
      }
    ],
    "max_steps": 11,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始检查并发起独立状态文件保存",
        "description": "标明“检查并发起独立状态文件保存”的开始位置。接收变量、函数和历史记录，检查文件身份及当前消息来源，整理上传内容后再核对一次目标并发起保存。异步完成流程检查真实响应，返回文件地址或失败原因。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "check_record",
        "display_name": "检查要保存的状态文件资料",
        "description": "在“检查并发起独立状态文件保存”流程中，读取待写入文件身份，确认状态记录确实提供，并复制这份记录供后续保存。缺少内容时返回原因，避免发起不完整文件写入。",
        "definition_id": "era.tavern.sidecar_write_record.check_record"
      },
      {
        "id": "check_target",
        "display_name": "保存文件前核对消息和原绑定",
        "description": "在“检查并发起独立状态文件保存”流程中，确认本次状态保存仍对应原目标消息和预期文件绑定。通过后才继续准备写入，避免聊天或回复变化后保存到错误状态。",
        "definition_id": "era.tavern.sidecar_write_record.check_target"
      },
      {
        "id": "encode_file",
        "display_name": "把待保存状态整理成上传内容",
        "description": "在“检查并发起独立状态文件保存”流程中，将本次状态记录转换为酒馆文件上传需要的内容，并使用对应独立状态文件的名称。后续上传步骤据此保存同一份记录。",
        "definition_id": "era.tavern.sidecar_write_record.encode_file"
      },
      {
        "id": "start_operation",
        "display_name": "再次核对来源并上传状态文件",
        "description": "在“检查并发起独立状态文件保存”流程中，文件内容准备完成后，再检查目标消息和状态文件绑定，随后向酒馆发起上传。后续等待真实响应，供主服务确认这次保存。",
        "definition_id": "era.tavern.sidecar_write_record.start_operation"
      },
      {
        "id": "end",
        "display_name": "结束检查并发起独立状态文件保存",
        "description": "标明“检查并发起独立状态文件保存”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      [
        "check_record",
        "check_target"
      ],
      [
        "check_target",
        "encode_file"
      ],
      [
        "encode_file",
        "start_operation"
      ],
      [
        "start",
        "check_record"
      ],
      [
        "start_operation",
        "end"
      ]
    ]
  }
}
