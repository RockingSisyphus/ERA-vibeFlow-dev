{
  "type_key": "era.tavern.flow.barrier_prefix",
  "display_name": "等待 high-water 回执和生成交接：同步准备",
  "description": "复用原节点完成返回 Promise 前的立即资源变更；不引入第二份准入、回执或清理实现。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "本次调用、实例资源与上一节点的事实"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_barrier_prefix_frame",
      "type": "era.tavern.frame.barrier_wait.register_watchdog",
      "display_name": "处理后的资源与事实"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "同实例调用与资源",
        "required": true
      }
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.barrier_wait.register_watchdog",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "本段明确结果"
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "snapshot_receipts",
        "type_used": "era.tavern.barrier_wait.snapshot_receipts",
        "display_name": "捕获屏障覆盖范围",
        "description": "固定本次 high-water 之前的未决回执和失败记录；后来的事件不扩大本次屏障。"
      },
      {
        "id": "register_watchdog",
        "type_used": "era.tavern.barrier_wait.register_watchdog",
        "display_name": "登记只告警的等待看门狗",
        "description": "保留原阈值；超时报告未完成序号，绝不代替回执或解除屏障。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "snapshot_receipts",
        "register_watchdog"
      ],
      [
        "start",
        "snapshot_receipts"
      ],
      [
        "register_watchdog",
        "end"
      ]
    ]
  }
}
