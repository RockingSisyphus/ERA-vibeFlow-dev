{
  "type_key": "era.tavern.flow.generation_handoff",
  "display_name": "等待原始生成订阅并完成阶段交接",
  "description": "同步发起节点固定调用此原生async路径；通知公开等待取消后，原始订阅与交接仍按原signal复核和收尾，不由图外adapter执行。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.call.frame",
      "cardinality": "exactly_one",
      "display_name": "已同步捕获的当前交接资源"
    }
  ],
  "provides": [
    {
      "key": "generation_handoff_frame",
      "type": "era.tavern.frame.notification.choose_notification",
      "display_name": "原始交接的真实终态"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.call.frame",
        "display_name": "调用与资源资料",
        "required": true
      }
    ],
    "max_steps": 29,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.tavern.initialize.start",
        "display_name": "开始当前原生流程",
        "description": "标记本段原生流程开始；不输出重复数据，不创建资源。"
      },
      {
        "id": "handoff_check_pending",
        "type_used": "era.tavern.generation_handoff.check_pending",
        "display_name": "检查交接来源仍存在",
        "description": "检查 completionId 是否仍在当前实例；不存在或已取消时保留原返回。"
      },
      {
        "id": "handoff_publish_completion",
        "type_used": "era.tavern.generation_handoff.publish_completion",
        "display_name": "等待同步发布的阶段订阅终态",
        "description": "只等待同步前段已发起的原 proceed 资源，不重复 publish。"
      },
      {
        "id": "handoff_check_cancel",
        "type_used": "era.tavern.generation_handoff.check_cancel",
        "display_name": "复核订阅后的取消和来源",
        "description": "等待回调后重新检查 signal 和 pending，避免已取消交接继续入队。"
      },
      {
        "id": "handoff_admit_continue_prepare",
        "type_used": "era.tavern.generation_handoff.admit_continue_prepare",
        "display_name": "准备阶段继续或取消请求",
        "description": "构造原 era.agent.stage_continue 输入及 cancelled 标记，再调用共享原生准入。"
      },
      {
        "id": "handoff_admit_continue_shared",
        "type_used": "era.tavern.flow.admission",
        "display_name": "检查事件并接纳到 FIFO",
        "description": "同步接纳 Tavern、UI、公共 API 和 timer 事件；拒绝不分配序号，接受即返回原有回执句柄。"
      },
      {
        "id": "handoff_admit_continue",
        "type_used": "era.tavern.generation_handoff.admit_continue",
        "display_name": "交还检查事件并接纳到 FIFO结果",
        "description": "保存共享原生流程的实际结果并继续当前分支；不重新执行准入、计时或结算。"
      },
      {
        "id": "handoff_await_continue",
        "type_used": "era.tavern.generation_handoff.await_continue",
        "display_name": "等待续体来源回执",
        "description": "等待实际 admission.done，保持原拒绝和异常行为。"
      },
      {
        "id": "handoff_choose_followup",
        "type_used": "era.tavern.generation_handoff.choose_followup",
        "display_name": "选择本阶段结果或后续交接",
        "description": "proceed 为 false 时完成取消；有新的 completionId 时等待其最终结果；其余直接完成当前交接。"
      },
      {
        "id": "handoff_select_current",
        "type_used": "era.tavern.generation_handoff.select_current",
        "display_name": "保留当前续体结论",
        "description": "无后续标识时直接使用当前实际回执结果。"
      },
      {
        "id": "handoff_select_next",
        "type_used": "era.tavern.generation_handoff.select_next",
        "display_name": "取得后续交接标识",
        "description": "读取实际回执中的 completionId，不猜测下一阶段。"
      },
      {
        "id": "handoff_select_cancel",
        "type_used": "era.tavern.generation_handoff.select_cancel",
        "display_name": "完成订阅取消",
        "description": "把当前交接结论设置为 null，不把取消续体当成成功。"
      },
      {
        "id": "handoff_join_await_followup",
        "type_used": "era.tavern.generation_handoff.join_await_followup",
        "display_name": "汇合当前实际激活分支的结果",
        "description": "接收当前所选路径的结果集合，交还其中唯一实际结果；不选择未激活分支、不重新执行操作。运行实现必须拒绝实际多结果，不以集合契约放宽唯一结果语义。"
      },
      {
        "id": "handoff_await_followup",
        "type_used": "era.tavern.generation_handoff.await_followup",
        "display_name": "等待后续阶段终态",
        "description": "仅在存在后续交接标识时等待；取消或无后续时保留当前结果。"
      },
      {
        "id": "handoff_finish_handoff",
        "type_used": "era.tavern.generation_handoff.finish_handoff",
        "display_name": "完成并移除当前交接等待",
        "description": "将最终结果或取消结论交还原等待者；失败路径也完成资源清理。"
      },
      {
        "id": "handoff_choose_pending",
        "type_used": "era.tavern.generation_handoff.choose_pending",
        "display_name": "核对当前完成标识是否仍待交接",
        "description": "已经结束或取消的 completionId 不再次发布订阅，也不准入续体。"
      },
      {
        "id": "handoff_finish_missing",
        "type_used": "era.tavern.generation_handoff.finish_missing",
        "display_name": "形成已结束交接的空终态",
        "description": "保留原 missing/no-pending 的 null 结果，不再次等待或发起动作。"
      },
      {
        "id": "handoff_choose_continue",
        "type_used": "era.tavern.generation_handoff.choose_continue",
        "display_name": "选择准入续体或按取消收尾",
        "description": "订阅 proceed 终态后，信号取消或当前完成标识失效时直接结束；其余路径才恢复主 Service。"
      },
      {
        "id": "handoff_finish_cancelled",
        "type_used": "era.tavern.generation_handoff.finish_cancelled",
        "display_name": "结束已取消的当前交接",
        "description": "按原合同完成本 completionId 的 null 结果，不准入额外事件。"
      },
      {
        "id": "handoff_join_finish",
        "type_used": "era.tavern.generation_handoff.join_finish",
        "display_name": "汇合当前唯一交接终态",
        "description": "实际完成、已失效或已取消路径只产生一个当前终态。"
      },
      {
        "id": "handoff_choose_admission",
        "type_used": "era.tavern.generation_handoff.choose_admission",
        "display_name": "核对原生续体准入结果",
        "description": "accepted 才等待原 done；拒绝时形成原通知失败并结束当前 handoff，不等待不存在的回执。"
      },
      {
        "id": "handoff_finish_rejected",
        "type_used": "era.tavern.generation_handoff.finish_rejected",
        "display_name": "结束被拒绝准入的原交接",
        "description": "保存原拒绝原因并完成 handoff=null；外层通知组按 rejected 结果统一报告，不终止整个后台 Loop。"
      },
      {
        "id": "handoff_finish_failed",
        "type_used": "era.tavern.generation_handoff.finish_failed",
        "display_name": "结束原订阅或等待失败的交接",
        "description": "保存本次原失败或取消原因并完成 handoff=null；失败作为通知组终态交回外层，不制造成功、重试或额外续体。"
      },
      {
        "id": "select_handoff",
        "type_used": "era.tavern.notification.select_handoff",
        "display_name": "交还完成生成阶段订阅与续体交接结果",
        "description": "保存共享原生流程的实际结果并继续当前分支；不重新执行准入、计时或结算。"
      },
      {
        "id": "end",
        "type_used": "era.tavern.initialize.end",
        "display_name": "结束当前原生流程",
        "description": "标记本段原生流程结束；不输出重复数据，不代办资源释放。"
      }
    ],
    "edges": [
      [
        "start",
        "handoff_check_pending"
      ],
      [
        "handoff_publish_completion",
        "handoff_check_cancel"
      ],
      [
        "handoff_await_continue",
        "handoff_choose_followup"
      ],
      {
        "from": "handoff_choose_followup",
        "to": "handoff_select_cancel",
        "when": "era_tavern_generation_handoff_choose_followup_route == 'cancel'"
      },
      [
        "handoff_select_cancel",
        "handoff_join_await_followup"
      ],
      {
        "from": "handoff_choose_followup",
        "to": "handoff_select_next",
        "when": "era_tavern_generation_handoff_choose_followup_route == 'next'"
      },
      [
        "handoff_select_next",
        "handoff_join_await_followup"
      ],
      {
        "from": "handoff_choose_followup",
        "to": "handoff_select_current",
        "when": "era_tavern_generation_handoff_choose_followup_route == 'current'"
      },
      [
        "handoff_select_current",
        "handoff_join_await_followup"
      ],
      [
        "handoff_admit_continue_prepare",
        "handoff_admit_continue_shared"
      ],
      [
        "handoff_admit_continue_shared",
        "handoff_admit_continue"
      ],
      [
        "handoff_join_await_followup",
        "handoff_await_followup"
      ],
      [
        "handoff_check_pending",
        "handoff_choose_pending"
      ],
      {
        "from": "handoff_choose_pending",
        "to": "handoff_publish_completion",
        "when": "era_tavern_generation_handoff_choose_pending_route == 'pending'"
      },
      {
        "from": "handoff_choose_pending",
        "to": "handoff_finish_missing",
        "when": "era_tavern_generation_handoff_choose_pending_route == 'missing'"
      },
      [
        "handoff_check_cancel",
        "handoff_choose_continue"
      ],
      {
        "from": "handoff_choose_continue",
        "to": "handoff_admit_continue_prepare",
        "when": "era_tavern_generation_handoff_choose_continue_route == 'admit'"
      },
      {
        "from": "handoff_choose_continue",
        "to": "handoff_finish_cancelled",
        "when": "era_tavern_generation_handoff_choose_continue_route == 'cancelled'"
      },
      [
        "handoff_finish_missing",
        "handoff_join_finish"
      ],
      [
        "handoff_finish_cancelled",
        "handoff_join_finish"
      ],
      [
        "handoff_await_followup",
        "handoff_join_finish"
      ],
      [
        "handoff_join_finish",
        "handoff_finish_handoff"
      ],
      [
        "handoff_admit_continue",
        "handoff_choose_admission"
      ],
      {
        "from": "handoff_choose_admission",
        "to": "handoff_await_continue",
        "when": "era_tavern_generation_handoff_choose_admission_route == 'accepted'"
      },
      {
        "from": "handoff_choose_admission",
        "to": "handoff_finish_rejected",
        "when": "era_tavern_generation_handoff_choose_admission_route == 'rejected'"
      },
      [
        "handoff_finish_rejected",
        "handoff_join_finish"
      ],
      {
        "from": "handoff_choose_continue",
        "to": "handoff_finish_failed",
        "when": "era_tavern_generation_handoff_choose_continue_route == 'failed'"
      },
      [
        "handoff_finish_failed",
        "handoff_join_finish"
      ],
      [
        "handoff_finish_handoff",
        "select_handoff"
      ],
      [
        "select_handoff",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.frame.notification.choose_notification",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "原始交接终态"
      }
    ]
  }
}
