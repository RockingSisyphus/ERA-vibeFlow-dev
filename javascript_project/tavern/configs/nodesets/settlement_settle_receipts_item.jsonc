{
  "type_key": "era.tavern.flow.settlement_settle_receipts_item",
  "display_name": "把一个原事件的结论交给发起者",
  "description": "按当前批次清单取出一个处理结果，完成相应事件等待并释放其页面引用，再推进。全部结束时交出遍历完成，供整批后续处理。",
  "expand": true,
  "requires": [
    {
      "type": "era.tavern.frame.settlement.mark_fatal_transition",
      "cardinality": "exactly_one",
      "display_name": "把一个原事件的结论交给发起者的请求和已有进度"
    }
  ],
  "provides": [
    {
      "key": "era_tavern_flow_settlement_settle_receipts_item_frame",
      "type": "era.tavern.item.result.settlement_settle_receipts_item",
      "display_name": "把一个原事件的结论交给发起者的处理进度及结果"
    },
    {
      "key": "era_tavern_flow_settlement_settle_receipts_item_done",
      "type": "era.tavern.done.settlement.settle_receipts",
      "display_name": "本轮遍历或职责处理是否已经结束"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "frame",
        "type": "era.tavern.frame.settlement.mark_fatal_transition",
        "display_name": "把一个原事件的结论交给发起者的请求和已有进度",
        "required": true
      }
    ],
    "max_steps": 10,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始把一个原事件的结论交给发起者",
        "description": "标明“把一个原事件的结论交给发起者”的开始位置。按当前批次清单取出一个处理结果，完成相应事件等待并释放其页面引用，再推进。全部结束时交出遍历完成，供整批后续处理。",
        "definition_id": "era.tavern.initialize.start"
      },
      {
        "id": "choose_item",
        "display_name": "选择本批下一项需要回告的事件",
        "description": "在“把一个原事件的结论交给发起者”流程中，查看当前批次的事件处理确认清单，选择下一项，或在全部完成时结束遍历。每个原事件按序得到它自己的结果。",
        "definition_id": "era.tavern.settlement_settle_receipts_item.choose_item"
      },
      {
        "id": "one_item",
        "display_name": "向一个原事件返回实际处理结果",
        "description": "在“把一个原事件的结论交给发起者”流程中，取出本批下一项事件结论，完成对应等待并释放该事件持有的页面资料引用。推进位置，供外层继续回告剩余事件。",
        "definition_id": "era.tavern.settlement_settle_receipts_item.one_item"
      },
      {
        "id": "empty",
        "display_name": "确认本轮事件结果已经逐项处理完",
        "description": "在“把一个原事件的结论交给发起者”流程中，事件确认或取消清单已经遍历完时，标记本轮结束。后续进行整批诊断、通知或实例收尾。",
        "definition_id": "era.tavern.settlement_settle_receipts_item.empty"
      },
      {
        "id": "join_end",
        "display_name": "交接把一个原事件的结论交给发起者的选中结果",
        "description": "在“把一个原事件的结论交给发起者”流程中，在“把一个原事件的结论交给发起者”中，接收本次实际选择的分支所产生的唯一结果，交给后续步骤或调用方。每次只允许一份实际结果，避免把互斥分支误当成多个都已执行。",
        "definition_id": "era.tavern.settlement_settle_receipts_item.join_end"
      },
      {
        "id": "end",
        "display_name": "结束把一个原事件的结论交给发起者",
        "description": "标明“把一个原事件的结论交给发起者”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.tavern.initialize.end"
      }
    ],
    "edges": [
      {
        "from": "choose_item",
        "to": "one_item",
        "when": "era_tavern_settlement_settle_receipts_item_choose_item_route == 'item'"
      },
      {
        "from": "choose_item",
        "to": "empty",
        "when": "era_tavern_settlement_settle_receipts_item_choose_item_route == 'done'"
      },
      [
        "one_item",
        "join_end"
      ],
      [
        "empty",
        "join_end"
      ],
      [
        "start",
        "choose_item"
      ],
      [
        "join_end",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.tavern.item.result.settlement_settle_receipts_item",
        "cardinality": "exactly_one",
        "as": "frame",
        "display_name": "把一个原事件的结论交给发起者的处理进度及结果"
      },
      {
        "type": "era.tavern.done.settlement.settle_receipts",
        "cardinality": "exactly_one",
        "as": "done",
        "display_name": "本轮遍历或职责处理是否已经结束"
      }
    ]
  }
}
