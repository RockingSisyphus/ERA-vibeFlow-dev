        ]
      },
      "era.tavern.frames": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.frames",
        "display_name": "辅助流程内部输入与错误合同",
        "description": "解包调用、严格汇合单结果及规范化错误；不选择或调度业务路径。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
