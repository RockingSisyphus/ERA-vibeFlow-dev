      "node:era.tavern.worldbook_read.check_request": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.tavern.worldbook_read.check_request",
        "display_name": "检查“读取世界书”的调用是否有效",
        "description": "接收“读取世界书”的请求，确认当前实例仍可运行、调用未取消，且输入确实是一份操作资料。通过后交给对应业务步骤，失败时按实际原因结束。",
        "version": "0.1.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.call.frame",
              "cardinality": "exactly_one",
              "display_name": "检查“读取世界书”的调用是否有效的请求和已有进度"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_worldbook_read_check_request_frame",
              "type": "era.tavern.frame.worldbook_read.check_request",
              "display_name": "检查“读取世界书”的调用是否有效的处理进度及结果"
            }
