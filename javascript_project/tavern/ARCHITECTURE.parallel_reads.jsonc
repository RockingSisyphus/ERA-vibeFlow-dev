    "era.tavern.boundary.async.protocol_parallel_reads_decode": {
      "kind": "node",
      "node_type": "vibeflow.node",
      "id": "era.tavern.boundary.async.protocol_parallel_reads_decode",
      "display_name": "恢复本次并行读取要求与本实例资源",
      "description": "核对资源编号，恢复初始化或派发要求；只恢复所需页面资源，不接收主Service的权威变量状态，也不在此读取尚未确认的Sidecar存档。",
      "version": "1.0.0",
      "flow_kind": "process",
      "tags": [],
