          "era.workflow.host_resources": [
            "由运行宿主在本地注入的当前 ERA 实例资源，跨流程消息不包含此对象"
          ],
          "era.workflow.packet": [
            "保留原值的并行读取请求"
          ]
        },
        "output_semantics": {
          "read_group": [
            "本次读取种类及本地页面资源"
          ]
        },
        "params_schema": {
          "mode": {
            "type": "string"
          },
          "boundary": {
            "type": "string"
          }
        },
        "params_defaults": {
          "mode": "sync",
          "boundary": "protocol_decode"
        },
        "examples": []
