    "base_lib": {
      "era.tavern.browser": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.data_store"
        ],
        "id": "era.tavern.browser",
        "display_name": "原始酒馆 API 与数据投影原语",
        "description": "发现同一个真实酒馆宿主、转换原始数据，并将原生设置保存通知转为可取消的实际IO等待；不持有会话、任务或调度机制。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
              "ref": "base_lib/browser.ts"
            },
            "completion": "immediate"
          }
        ],
        "dependencies": [],
        "external_packages": []
      },
      "era.tavern.contracts": {
        "kind": "base_lib",
        "rulesets": [
          "vibeflow.base_lib"
        ],
        "id": "era.tavern.contracts",
        "display_name": "ERA 既有传输合同",
        "description": "复用官方 DTO 校验和默认限额，不复制合同。",
        "category": "",
        "version": "",
        "implementations": [
          {
            "language": "typescript",
            "targets": [
              "browser",
              "node"
            ],
            "source": {
              "kind": "file",
