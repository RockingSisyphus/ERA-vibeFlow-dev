            }
          ],
          "input_semantics": {
            "era.tavern.call.frame": [
              "来自当前实际执行的前置路径；汇合时各类型可为空，合计必须只有一个调用资料。"
            ]
          },
          "output_semantics": {
            "era_tavern_cap_async_character_join_return_frame": [
              "汇合当前实际激活分支的结果后的请求、资源令牌及处理结果"
            ]
          },
