      "node:era.tavern.messages_update_content.await_persistence": {
        "kind": "node",
        "type_key": "era.tavern.messages_update_content.await_persistence",
        "display_name": "检查原聊天并等待保存",
        "description": "按同步段捕获的固定文件及写后依据检查同聊天；调用一次 saveChat 并等待；之后必须经过文件回读和内容核对，不能把 Promise 完成当作落盘成功。",
        "version": "0.1.0",
