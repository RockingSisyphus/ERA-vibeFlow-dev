            }
          ],
          "input_semantics": {
            "era.tavern.frame.subscription_cycle.chosen": [
              "来自当前实际执行的前置路径；汇合时各类型可为空，合计必须只有一个调用资料。"
            ]
          },
          "output_semantics": {
            "subscription_cycle_invoke_frame": [
              "使用只读观察副本和此回调的signal，登记局部取消句柄；取消解除等待但仍观察原始Promise拒绝。同步异常保存为事实。"
            ]
          },
