            ]
          },
          "output_semantics": {
            "era_tavern_initialize_wait_startup_frame": [
              "交还原决议；停止时保留取消原因，不重新挂载listener/UI。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
