              "display_name": "本次实际激活路径的调用资料"
            }
          ],
          "provides": [
            {
              "key": "era_tavern_generation_handoff_choose_followup_frame",
              "type": "era.tavern.frame.generation_handoff.choose_followup",
              "display_name": "选择本阶段结果或后续交接后的请求、资源令牌及处理结果"
            },
            {
              "key": "era_tavern_generation_handoff_choose_followup_route",
              "type": "era.tavern.route",
              "display_name": "选择本阶段结果或后续交接的实际分支"
            }
          ],
          "input_semantics": {
            "era.tavern.frame.generation_handoff.await_continue": [
              "来自当前实际执行的前置路径；汇合时各类型可为空，合计必须只有一个调用资料。"
            ]
          },
          "output_semantics": {
            "era_tavern_generation_handoff_choose_followup_frame": [
              "选择本阶段结果或后续交接后的请求、资源令牌及处理结果"
            ],
            "era_tavern_generation_handoff_choose_followup_route": [
              "选择下方显式分支，不在 Node 内执行另一条路径。"
            ]
          },
          "params_schema": {
            "outputKeys": {
              "type": "object"
            }
          },
          "params_defaults": {
            "outputKeys": {
              "frame": "era_tavern_generation_handoff_choose_followup_frame",
              "route": "era_tavern_generation_handoff_choose_followup_route"
            }
          },
          "examples": []
