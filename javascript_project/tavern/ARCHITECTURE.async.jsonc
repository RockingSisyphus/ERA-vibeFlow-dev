      "node:era.tavern.subscription_cycle.invoke": {
        "kind": "node",
        "type_key": "era.tavern.subscription_cycle.invoke",
        "display_name": "执行当前作者订阅并等待其Promise",
        "description": "使用只读观察副本和此回调的signal，登记局部取消句柄；取消解除等待但仍观察原始Promise拒绝。同步异常保存为事实。",
        "version": "0.1.0",
        "flow_kind": "data_store",
        "tags": [],
