      "node:era.tavern.generation_handoff.choose_followup": {
        "kind": "node",
        "type_key": "era.tavern.generation_handoff.choose_followup",
        "display_name": "选择本阶段结果或后续交接",
        "description": "proceed 为 false 时完成取消；有新的 completionId 时等待其最终结果；其余直接完成当前交接。",
        "version": "0.1.0",
        "flow_kind": "decision",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.tavern.frame.generation_handoff.await_continue",
