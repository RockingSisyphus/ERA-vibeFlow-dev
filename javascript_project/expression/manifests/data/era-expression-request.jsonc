{"kind":"data_schema","type_key":"era.expression.request","representation":"json","display_name":"函数表达式请求","description":"显式携带函数库、有限数值初始状态、有序表达式操作及可选随机上下文的独立 root 输入。","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["functionLibrary","initialState","operations"],"properties":{"functionLibrary":{"type":"object"},"snapshotFunctionLibrary":{"type":"object"},"initialState":{"type":"object"},"snapshotState":{"type":"object"},"allowSnapshots":{"type":"boolean"},"randomContext":{"type":"object","required":["sourceKey","drawOffset"],"properties":{"sourceKey":{"type":"string","minLength":1},"drawOffset":{"type":"integer","minimum":0}},"additionalProperties":false},"operations":{"type":"array"}},"additionalProperties":false}}
