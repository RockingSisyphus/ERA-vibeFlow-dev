{
  "kind": "base_lib",
  "id": "era.expression.engine",
  "display_name": "ERA 函数表达式纯引擎",
  "description": "提供受限 token/AST 解析、函数调用图与环检测、显式调用帧求值、数学后端适配和符号压缩；不访问宿主或全局状态。",
  "category": "表达式领域",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": { "kind": "file", "ref": "base_lib/expression_engine.ts" }
    }
  ],
  "dependencies": [],
  "external_packages": ["mathjs", "@stdlib/math-base-special-gamma"]
}
