{
  "kind": "node",
  "type_key": "era.expression.initialize_ast_frames",
  "display_name": "初始化 AST 调用帧栈",
  "category": "表达式循环",
  "description": "为当前表达式建立显式求值帧，记录接下来要计算的子表达式、参数和函数调用。函数嵌套通过帧栈推进，不依赖 JavaScript 的递归调用栈；函数库无效或没有可用语法树时采用内部安全占位，原错误仍保留到结果判断，不因占位而把操作判成功。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.operation.current",
        "cardinality": "exactly_one",
        "display_name": "当前表达式操作"
      }
    ],
    "provides": [
      {
        "key": "ast_frame_state",
        "type": "era.expression.ast_frame.state",
        "display_name": "AST 调用帧状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.operation.current": [
        "输入：当前表达式操作。"
      ]
    },
    "output_semantics": {
      "ast_frame_state": [
        "输出：调用帧栈。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/execution/initialize_ast_frames.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.types"
  ],
  "capabilities": []
}
