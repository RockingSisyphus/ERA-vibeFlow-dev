        "key": "random_guarded_symbolic_layer",
        "type": "era.expression.symbolic.layer",
        "display_name": "带随机屏障的符号变化"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.symbolic.layer": [
        "输入：局部安全符号变化。"
      ]
    },
    "output_semantics": {
      "random_guarded_symbolic_layer": [
        "输出：不跨自动随机边界的符号变化。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
