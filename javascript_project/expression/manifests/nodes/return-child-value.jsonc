{
  "kind": "node",
  "type_key": "era.expression.return_child_value",
  "display_name": "回传子调用结果",
  "category": "表达式调用帧",
  "description": "使已完成子表达式值进入父调用帧。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.ast_frame.current",
        "cardinality": "exactly_one",
        "display_name": "当前 AST 调用帧"
      }
    ],
    "provides": [
      {
        "key": "frame_transition_return",
        "type": "era.expression.ast_frame.transition",
        "display_name": "调用帧迁移"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.ast_frame.current": ["输入：栈顶返回帧。"]
    },
    "output_semantics": { "frame_transition_return": ["输出：下一帧栈迁移。"] }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/return_child_value.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.expression.engine"],
  "capabilities": []
}
