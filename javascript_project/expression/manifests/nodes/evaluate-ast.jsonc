{
  "kind": "node",
  "type_key": "era.expression.evaluate_ast",
  "display_name": "求值当前表达式",
  "description": "推进当前表达式的求值帧，依次计算运算符、函数参数及嵌套调用，使用当前变量和既定随机上下文，直到得到数值或诊断。它只求这一项，不移动操作索引、不写目标变量，也不处理整层压缩；完成结果交给下一节点决定是否应用。",
  "category": "表达式执行",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.ast_frame.state",
        "cardinality": "exactly_one",
        "display_name": "AST 调用帧状态"
      }
    ],
    "provides": [
      {
        "key": "evaluated_expression",
        "type": "era.expression.value",
        "display_name": "已求值表达式"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.ast_frame.state": [
        "输入：当前操作已初始化的显式帧栈。"
      ]
    },
    "output_semantics": {
      "evaluated_expression": [
        "输出：有限数值或失败诊断，不提交业务状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/execution/evaluate_ast.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.types",
    "era.expression.operation"
  ],
  "capabilities": []
}
