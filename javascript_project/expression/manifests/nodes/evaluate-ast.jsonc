{
  "kind": "node",
  "type_key": "era.expression.evaluate_ast",
  "display_name": "求值当前表达式",
  "description": "消费初始化的 AST 帧状态，在登记的表达式执行库内推进显式帧栈直到完成；输出数值与诊断。只求值当前操作，不接管操作顺序、函数编译、状态提交或符号压缩。",
  "category": "表达式执行",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.ast_frame.state",
        "cardinality": "exactly_one",
        "display_name": "AST 调用帧状态"
      }
    ],
    "provides": [
      {
        "key": "evaluated_expression",
        "type": "era.expression.value",
        "display_name": "已求值表达式"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.ast_frame.state": [
        "输入：当前操作已初始化的显式帧栈。"
      ]
    },
    "output_semantics": {
      "evaluated_expression": [
        "输出：有限数值或失败诊断，不提交业务状态。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/execution/evaluate_ast.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.types",
    "era.expression.operation"
  ],
  "capabilities": []
}
