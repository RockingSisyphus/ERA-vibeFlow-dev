{
  "kind": "node",
  "type_key": "era.expression.initialize_random_sequence_state",
  "display_name": "初始化顺序状态与随机游标",
  "category": "表达式工作流",
  "description": "建立有序求值的起始状态：保留本层开始时的变量快照，装入已编译函数库和解析操作，建立操作索引及从请求偏移开始的随机进度，预留自动随机位置。可选快照函数库单独编译，供快照表达式使用。尚未执行任何操作，冻结起点用于之后重放和压缩证明。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.request.normalized",
        "cardinality": "exactly_one",
        "display_name": "规范表达式请求"
      },
      {
        "type": "era.expression.function_library.compiled",
        "cardinality": "exactly_one",
        "display_name": "已编译函数库"
      },
      {
        "type": "era.expression.operations.parsed",
        "cardinality": "exactly_one",
        "display_name": "已解析操作"
      }
    ],
    "provides": [
      {
        "key": "sequence_state",
        "type": "era.expression.sequence.state",
        "display_name": "含随机游标的顺序状态"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.request.normalized": [
        "输入：带 randomContext 的请求。"
      ],
      "era.expression.function_library.compiled": [
        "输入：函数库。"
      ],
      "era.expression.operations.parsed": [
        "输入：操作 AST。"
      ]
    },
    "output_semantics": {
      "sequence_state": [
        "输出：消息层顺序状态和随机槽位计数。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/initialize_random_sequence_state.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.functions",
    "era.expression.types"
  ],
  "capabilities": []
}
