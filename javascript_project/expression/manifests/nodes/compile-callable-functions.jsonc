{
  "kind": "node",
  "type_key": "era.expression.compile_callable_functions",
  "display_name": "编译可调用函数库",
  "category": "表达式工作流",
  "description": "将解析好的函数体语法树、形参表和所有校验诊断组织成运行时可调用的函数库，标明是否有效。求值时按明确调用帧绑定参数，不通过字符串替换拼接函数体；存在格式、纯度或递归问题时不把库当作可执行。这里只准备调用结构，不调用作者函数或修改变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.function_library.parsed",
        "cardinality": "exactly_one",
        "display_name": "已解析函数库"
      },
      {
        "type": "era.expression.function_library.acyclic_graph",
        "cardinality": "exactly_one",
        "display_name": "无环函数调用图"
      }
    ],
    "provides": [
      {
        "key": "compiled_function_library",
        "type": "era.expression.function_library.compiled",
        "display_name": "已编译函数库"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.function_library.parsed": [
        "输入：函数 AST。"
      ],
      "era.expression.function_library.acyclic_graph": [
        "输入：无环调用图。"
      ]
    },
    "output_semantics": {
      "compiled_function_library": [
        "输出：可调用函数库。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/compile_callable_functions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.functions",
    "era.expression.types"
  ],
  "capabilities": []
}
