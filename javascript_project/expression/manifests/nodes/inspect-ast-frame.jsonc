{
  "kind": "node",
  "type_key": "era.expression.inspect_ast_frame",
  "display_name": "读取栈顶 AST 帧",
  "category": "表达式调用帧",
  "description": "公开栈顶节点及其局部环境，供显式分支路由。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.ast_frame.state",
        "cardinality": "exactly_one",
        "display_name": "AST 调用帧状态"
      }
    ],
    "provides": [
      {
        "key": "ast_frame_current",
        "type": "era.expression.ast_frame.current",
        "display_name": "当前 AST 调用帧"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.ast_frame.state": ["输入：调用帧栈。"]
    },
    "output_semantics": { "ast_frame_current": ["输出：栈顶帧。"] }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/inspect_ast_frame.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.expression.engine"],
  "capabilities": []
}
