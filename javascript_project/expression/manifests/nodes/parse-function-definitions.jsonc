{
  "kind": "node",
  "type_key": "era.expression.parse_function_definitions",
  "display_name": "解析函数定义 AST",
  "category": "表达式工作流",
  "description": "逐个读取 JSON 函数定义的名称、形参和表达式，用 ERA 自有语法解析器生成语法树，记录调用与参数位置。重复形参、非法名称或表达式无法解析时附带定位诊断。语法树描述计算结构，尚不执行函数，也不会把表达式作为任意 JavaScript 代码运行。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.request.normalized",
        "cardinality": "exactly_one",
        "display_name": "规范表达式请求"
      }
    ],
    "provides": [
      {
        "key": "parsed_function_library",
        "type": "era.expression.function_library.parsed",
        "display_name": "已解析函数库"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.request.normalized": [
        "输入：已验证请求。"
      ]
    },
    "output_semantics": {
      "parsed_function_library": [
        "输出：函数 AST。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/parse_function_definitions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.functions",
    "era.expression.types"
  ],
  "capabilities": []
}
