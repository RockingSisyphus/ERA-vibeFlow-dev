{
  "kind": "node",
  "type_key": "era.expression.reject_recursive_functions",
  "display_name": "拒绝递归函数环",
  "category": "表达式工作流",
  "description": "沿自定义函数调用关系作深度优先遍历，识别直接调用自身或绕经其他函数返回自身的循环，并记录完整循环链。输出调用图及新增诊断，不当场执行函数；后续编译结合诊断判定函数库是否可用，因此节点名字中的“拒绝”不是静默删除错误函数。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.function_library.call_graph",
        "cardinality": "exactly_one",
        "display_name": "函数调用图"
      }
    ],
    "provides": [
      {
        "key": "acyclic_function_graph",
        "type": "era.expression.function_library.acyclic_graph",
        "display_name": "无环函数调用图"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.function_library.call_graph": [
        "输入：函数调用图。"
      ]
    },
    "output_semantics": {
      "acyclic_function_graph": [
        "输出：附环诊断的调用图。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/reject_recursive_functions.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.functions",
    "era.expression.types"
  ],
  "capabilities": []
}
