{
  "kind": "node",
  "type_key": "era.expression.parse_operations",
  "display_name": "解析顺序操作",
  "category": "表达式工作流",
  "description": "按输入原顺序解析每个变量操作的目标路径和表达式，记录对应语法树及定位诊断。用户表达式不能使用内部压缩表示的 @path，避免混淆当前值和层起始快照。这里只解释操作结构，不更新变量；后续循环按顺序执行，后一项才能读取前一项的新结果。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.request.normalized",
        "cardinality": "exactly_one",
        "display_name": "规范表达式请求"
      }
    ],
    "provides": [
      {
        "key": "parsed_operations",
        "type": "era.expression.operations.parsed",
        "display_name": "已解析顺序操作"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.request.normalized": [
        "输入：已验证请求。"
      ]
    },
    "output_semantics": {
      "parsed_operations": [
        "输出：按顺序的操作 AST。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/parse_operations.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.syntax",
    "era.expression.types"
  ],
  "capabilities": []
}
