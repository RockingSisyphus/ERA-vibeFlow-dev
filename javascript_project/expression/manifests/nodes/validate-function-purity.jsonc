{
  "kind": "node",
  "type_key": "era.expression.validate_function_purity",
  "display_name": "验证函数纯度与参数",
  "category": "表达式工作流",
  "description": "检查每个自定义函数只使用自己的形参，调用的内建或自定义函数确实存在且参数数量正确，不允许偷偷读取状态路径、自由变量或覆盖内建名称。输出诊断供编译阶段决定能否执行；这样同一组参数应有明确结果，不依赖函数定义以外的隐含变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.function_library.parsed",
        "cardinality": "exactly_one",
        "display_name": "已解析函数库"
      },
      {
        "type": "era.expression.function_library.dependencies",
        "cardinality": "exactly_one",
        "display_name": "函数调用依赖"
      }
    ],
    "provides": [
      {
        "key": "function_purity_report",
        "type": "era.expression.function_library.purity",
        "display_name": "函数纯度报告"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.function_library.parsed": [
        "输入：函数 AST。"
      ],
      "era.expression.function_library.dependencies": [
        "输入：函数调用依赖。"
      ]
    },
    "output_semantics": {
      "function_purity_report": [
        "输出：纯度和参数诊断。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/validate_function_purity.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.functions",
    "era.expression.types"
  ],
  "capabilities": []
}
