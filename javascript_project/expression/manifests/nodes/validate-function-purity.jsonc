{
  "kind": "node",
  "type_key": "era.expression.validate_function_purity",
  "display_name": "验证函数纯度与参数",
  "category": "表达式工作流",
  "description": "拒绝函数体内状态读取、未知调用、参数不匹配和内建覆盖。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.function_library.parsed",
        "cardinality": "exactly_one",
        "display_name": "已解析函数库"
      },
      {
        "type": "era.expression.function_library.dependencies",
        "cardinality": "exactly_one",
        "display_name": "函数调用依赖"
      }
    ],
    "provides": [
      {
        "key": "function_purity_report",
        "type": "era.expression.function_library.purity",
        "display_name": "函数纯度报告"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.function_library.parsed": ["输入：函数 AST。"],
      "era.expression.function_library.dependencies": ["输入：函数调用依赖。"]
    },
    "output_semantics": {
      "function_purity_report": ["输出：纯度和参数诊断。"]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/validate_function_purity.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.expression.engine"],
  "capabilities": []
}
