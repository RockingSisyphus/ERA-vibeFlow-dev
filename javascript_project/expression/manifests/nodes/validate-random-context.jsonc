{
  "kind": "node",
  "type_key": "era.expression.validate_random_context",
  "display_name": "传递已校验的随机上下文",
  "category": "表达式工作流",
  "description": "把请求标准化阶段已经检查过的随机上下文连同请求原样传到函数和操作处理链。随机来源标识用于稳定重放，偏移表示此前已消耗的位置；当前节点不另做一次校验、不抽取随机数，也不保存游标。随机输入是否合法由入口标准化负责，避免把数据转接误写成独立验证。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.request.normalized",
        "cardinality": "exactly_one",
        "display_name": "规范表达式请求"
      }
    ],
    "provides": [
      {
        "key": "validated_random_request",
        "type": "era.expression.request.normalized",
        "display_name": "带随机上下文的规范请求"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.request.normalized": [
        "输入：已规范并验证随机上下文的请求。"
      ]
    },
    "output_semantics": {
      "validated_random_request": [
        "输出：同一不可变规范请求。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/validate_random_context.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.types"
  ],
  "capabilities": []
}
