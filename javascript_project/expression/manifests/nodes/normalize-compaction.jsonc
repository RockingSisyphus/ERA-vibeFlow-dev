{
  "kind": "node",
  "type_key": "era.expression.normalize_compaction",
  "display_name": "规范化压缩表达式",
  "category": "表达式压缩",
  "description": "把安全的符号候选做局部常数折叠、零和一等简化，并按所需括号打印为较短表达式，每个变化路径最多产生一个候选。连同有序执行所得最终变量、诊断和随机消耗一起返回；不安全路径不强行压缩。这里是纯计算出口，是否用于消息重写还须由调用方验证。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.expression.sequence.state",
        "cardinality": "exactly_one",
        "display_name": "表达式顺序执行状态"
      },
      {
        "type": "era.expression.execution.result",
        "cardinality": "exactly_one",
        "display_name": "顺序数值结果"
      },
      {
        "type": "era.expression.symbolic.layer",
        "cardinality": "exactly_one",
        "display_name": "符号层变化"
      }
    ],
    "provides": [
      {
        "key": "expression_response",
        "type": "era.expression.response",
        "display_name": "函数表达式结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "era.expression.sequence.state": [
        "输入：层起始状态。"
      ],
      "era.expression.execution.result": [
        "输入：数值执行结果。"
      ],
      "era.expression.symbolic.layer": [
        "输入：符号层变化。"
      ]
    },
    "output_semantics": {
      "expression_response": [
        "输出：最终状态与压缩候选。"
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "nodes/normalize_compaction.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "era.expression.execution",
    "era.expression.symbolic",
    "era.expression.types"
  ],
  "capabilities": []
}
