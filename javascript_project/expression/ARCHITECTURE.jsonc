        "era.expression.commit_operation_result": {
          "kind": "node",
          "type_key": "era.expression.commit_operation_result",
          "display_name": "提交表达式操作结果",
          "description": "检查当前表达式结果是否成功且为有限数值，合格时将其写入本次纯计算状态的目标路径，累计随机消耗和结果，再推进操作索引。失败则保留未应用该操作前的变量状态及定位诊断。这里更新的是请求内的计算状态，不是酒馆变量；循环完成后统一返回最终状态。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [
            "表达式循环"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.operation.current",
                "cardinality": "exactly_one",
                "display_name": "当前表达式操作"
              },
              {
                "type": "era.expression.value",
                "cardinality": "exactly_one",
                "display_name": "已求值表达式"
              }
            ],
            "provides": [
              {
                "key": "sequence_state_next",
                "type": "era.expression.sequence.state",
                "display_name": "下一顺序执行状态"
              },
              {
                "key": "sequence_done",
                "type": "era.expression.sequence.done",
                "display_name": "顺序操作结束标记"
              },
              {
                "key": "operation_execution_result",
                "type": "era.expression.execution.result",
                "display_name": "当前累计数值结果"
              }
            ],
            "input_semantics": {
              "era.expression.operation.current": [
                "输入：当前操作。"
              ],
              "era.expression.value": [
                "输入：帧求值结果。"
              ]
            },
            "output_semantics": {
              "sequence_state_next": [
                "输出：推进后的顺序状态。"
              ],
              "sequence_done": [
                "输出：操作结束标记。"
              ],
              "operation_execution_result": [
                "输出：累计结果。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
                "browser",
                "node"
              ],
              "source": {
                "kind": "file",
                "ref": "nodes/execution/commit_operation_result.ts",
                "export": "run"
              },
              "completion": "immediate"
            }
          ],
          "base_libs": [
            "era.expression.types",
            "era.expression.operation"
          ],
          "capabilities": [],
          "rulesets": [
            "vibeflow.process"
          ],
          "presentation": {},
          "metadata": {}
        },
        "era.expression.compile_callable_functions": {
          "kind": "node",
          "type_key": "era.expression.compile_callable_functions",
          "display_name": "编译可调用函数库",
          "description": "将解析好的函数体语法树、形参表和所有校验诊断组织成运行时可调用的函数库，标明是否有效。求值时按明确调用帧绑定参数，不通过字符串替换拼接函数体；存在格式、纯度或递归问题时不把库当作可执行。这里只准备调用结构，不调用作者函数或修改变量。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [
            "表达式工作流"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.function_library.parsed",
                "cardinality": "exactly_one",
                "display_name": "已解析函数库"
              },
              {
                "type": "era.expression.function_library.acyclic_graph",
                "cardinality": "exactly_one",
                "display_name": "无环函数调用图"
              }
            ],
            "provides": [
              {
                "key": "compiled_function_library",
                "type": "era.expression.function_library.compiled",
                "display_name": "已编译函数库"
              }
            ],
            "input_semantics": {
              "era.expression.function_library.parsed": [
                "输入：函数 AST。"
              ],
              "era.expression.function_library.acyclic_graph": [
                "输入：无环调用图。"
              ]
            },
            "output_semantics": {
              "compiled_function_library": [
                "输出：可调用函数库。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
