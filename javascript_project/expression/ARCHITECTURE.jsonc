          }
        ],
        "provides": [
          {
            "key": "evaluated_expression",
            "type": "era.expression.value",
            "display_name": "当前公式实际算出的数值及问题"
          }
        ],
        "input_semantics": {
          "era.expression.ast_frame.state": [
            "供逐步计算嵌套表达式及函数，仍保留无效输入的错误结论。"
          ]
        },
        "output_semantics": {
          "evaluated_expression": [
            "尚需检查成功且数值有效，才能应用到本轮目标变量。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
