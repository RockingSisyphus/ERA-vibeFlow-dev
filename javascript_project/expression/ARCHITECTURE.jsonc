          "era.expression.function_library.acyclic_graph": [
            "递归问题保留在结果中，后续结合所有诊断决定函数库能否执行。"
          ]
        },
        "output_semantics": {
          "compiled_function_library": [
            "供公式按明确参数调用，有错误时保留问题而不会当成有效函数执行。"
