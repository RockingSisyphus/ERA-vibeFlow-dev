            }
          ],
          "provides": [
            {
              "key": "parsed_operations",
              "type": "era.expression.operations.parsed",
              "display_name": "已解析顺序操作"
            }
          ],
          "input_semantics": {
            "era.expression.request.normalized": [
              "输入：已验证请求。"
            ]
          },
          "output_semantics": {
            "parsed_operations": [
              "输出：按顺序的操作 AST。"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
        },
