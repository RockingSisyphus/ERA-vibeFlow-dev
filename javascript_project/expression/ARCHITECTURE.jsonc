        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true
        }
      },
      "era.expression.function_library.dependencies": {
        "kind": "data_schema",
        "type_key": "era.expression.function_library.dependencies",
        "representation": "json",
        "display_name": "函数调用依赖",
