      "node:era.expression.parse_operations": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.expression.parse_operations",
        "display_name": "按原顺序整理各项公式",
        "description": "接收需要依次执行的变量计算，读出每项要修改的变量和算式，记录无法识别的内容。保留原有顺序，让后一项公式可以使用前一项刚算出的变量值。",
        "version": "1.0.0",
        "flow_kind": "process",
