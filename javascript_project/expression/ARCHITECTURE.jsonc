              "cardinality": "exactly_one",
              "display_name": "当前表达式操作"
            }
          ],
          "provides": [
            {
              "key": "ast_frame_state",
              "type": "era.expression.ast_frame.state",
              "display_name": "AST 调用帧状态"
            }
          ],
          "input_semantics": {
            "era.expression.operation.current": [
              "输入：当前表达式操作。"
            ]
          },
          "output_semantics": {
            "ast_frame_state": [
              "输出：调用帧栈。"
            ]
          },
