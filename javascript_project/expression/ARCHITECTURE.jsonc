      "node:era.workflow.encode_expression": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.workflow.encode_expression",
        "display_name": "把完整计算结果封装为保留原值的消息",
        "description": "只在官方通信入口恢复或封装业务值，保留大数、负零、缺失值及数组空位；原计算流程和普通同步入口不变。",
