          "items": {
            "type": "object"
          }
        }
      },
      "era.expression.request": {
        "kind": "data_schema",
        "type_key": "era.expression.request",
        "representation": "json",
        "display_name": "函数表达式请求",
        "description": "公共求值入口接受原始输入；由 validate_request 领域节点产生输入诊断，保持 executeExpressionLayer 的 unknown 输入与返回语义。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "era.expression.request.normalized": {
        "kind": "data_schema",
        "type_key": "era.expression.request.normalized",
        "representation": "json",
        "display_name": "规范表达式请求",
        "description": "经过输入形状与有限数值验证的函数表达式请求。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": true
        }
      },
      "era.expression.response": {
        "kind": "data_schema",
        "type_key": "era.expression.response",
        "representation": "json",
        "display_name": "函数表达式结果",
        "description": "独立表达式 root 的最终数值状态、诊断、随机槽位计数和可重放压缩候选。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "finalState",
            "diagnostics",
            "compactedOperations",
            "randomDrawsConsumed",
            "nextDrawOffset",
            "containsAutomaticRandom"
          ],
          "properties": {
            "finalState": {
              "type": "object"
            },
            "diagnostics": {
              "type": "array"
            },
            "compactedOperations": {
              "type": "array"
            },
            "randomDrawsConsumed": {
              "type": "integer",
              "minimum": 0
            },
            "nextDrawOffset": {
              "type": "integer",
              "minimum": 0
            },
            "containsAutomaticRandom": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "era.expression.sequence.done": {
        "kind": "data_schema",
        "type_key": "era.expression.sequence.done",
        "representation": "json",
