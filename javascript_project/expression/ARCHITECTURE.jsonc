              "cardinality": "exactly_one",
              "display_name": "待检查循环的函数调用关系"
            }
          ],
          "provides": [
            {
              "key": "acyclic_function_graph",
              "type": "era.expression.function_library.acyclic_graph",
              "display_name": "经过循环检查的调用关系及问题"
            }
          ],
          "input_semantics": {
            "era.expression.function_library.call_graph": [
              "记录所有自定义函数之间的依赖及已有问题，供沿关系检查。"
            ]
          },
          "output_semantics": {
            "acyclic_function_graph": [
              "递归问题保留在结果中，后续结合所有诊断决定函数库能否执行。"
            ]
          },
