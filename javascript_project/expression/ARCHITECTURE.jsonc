            "era.expression.request.normalized": [
              "包含变量起点、函数定义、操作和可重复随机要求，供整个计算流程使用。"
            ]
          },
          "output_semantics": {
            "parsed_operations": [
              "包含每项目标路径及计算结构，后项会使用前项更新后的变量。"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
        },
        "implementations": [
          {
            "language": "typescript",
