      "node_definitions": {
        "era.expression.boundary.PrepareDirectRequest": {
          "kind": "node",
          "node_type": "vibeflow.node",
          "id": "era.expression.boundary.PrepareDirectRequest",
          "display_name": "整理直接入口的请求",
          "description": "取出直接入口收到的业务请求，标明结果直接返回。把同一类型的请求送进与通信入口共用的处理节点。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.request",
                "cardinality": "exactly_one",
                "display_name": "直接入口收到的业务请求"
              }
            ],
            "provides": [
              {
                "key": "prepared_request",
                "type": "era.expression.request",
                "display_name": "可交给共享步骤的请求"
              },
              {
                "key": "entry_return",
                "type": "era.workflow.entry_return",
                "display_name": "直接返回或通信回信"
              }
            ],
            "input_semantics": {
              "era.expression.request": [
                "直接入口收到的业务请求"
              ]
            },
