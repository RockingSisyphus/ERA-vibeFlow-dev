      "node:era.workflow.decode_expression": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "era.workflow.decode_expression",
        "display_name": "恢复独立流程要处理的原始业务输入",
        "description": "在进入原计算定义前恢复大数、负零、缺失项和数组空位，保持与原同步输入相同的业务含义。 标记本次结果须走通信回信；随后把请求交给两个入口共用的处理节点。",
        "version": "1.0.0",
        "flow_kind": "process",
