          "kind": "node",
          "type_key": "era.expression.validate_function_purity",
          "display_name": "验证函数纯度与参数",
          "description": "检查每个自定义函数只使用自己的形参，调用的内建或自定义函数确实存在且参数数量正确，不允许偷偷读取状态路径、自由变量或覆盖内建名称。输出诊断供编译阶段决定能否执行；这样同一组参数应有明确结果，不依赖函数定义以外的隐含变量。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [
            "表达式工作流"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.function_library.parsed",
                "cardinality": "exactly_one",
                "display_name": "已解析函数库"
              },
              {
                "type": "era.expression.function_library.dependencies",
                "cardinality": "exactly_one",
                "display_name": "函数调用依赖"
              }
            ],
            "provides": [
              {
                "key": "function_purity_report",
                "type": "era.expression.function_library.purity",
                "display_name": "函数纯度报告"
              }
            ],
            "input_semantics": {
              "era.expression.function_library.parsed": [
                "输入：函数 AST。"
              ],
              "era.expression.function_library.dependencies": [
                "输入：函数调用依赖。"
              ]
            },
            "output_semantics": {
              "function_purity_report": [
                "输出：纯度和参数诊断。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
                "browser",
                "node"
              ],
              "source": {
                "kind": "file",
                "ref": "nodes/validate_function_purity.ts",
                "export": "run"
              },
              "completion": "immediate"
            }
          ],
          "base_libs": [
            "era.expression.execution",
            "era.expression.functions",
            "era.expression.types"
          ],
          "capabilities": [],
          "rulesets": [
            "vibeflow.process"
          ],
          "presentation": {},
          "metadata": {}
        },
        "era.expression.validate_random_context": {
          "kind": "node",
          "type_key": "era.expression.validate_random_context",
          "display_name": "传递已校验的随机上下文",
          "description": "把请求标准化阶段已经检查过的随机上下文连同请求原样传到函数和操作处理链。随机来源标识用于稳定重放，偏移表示此前已消耗的位置；当前节点不另做一次校验、不抽取随机数，也不保存游标。随机输入是否合法由入口标准化负责，避免把数据转接误写成独立验证。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [
            "表达式工作流"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.request.normalized",
                "cardinality": "exactly_one",
                "display_name": "规范表达式请求"
              }
            ],
            "provides": [
              {
                "key": "validated_random_request",
                "type": "era.expression.request.normalized",
                "display_name": "带随机上下文的规范请求"
              }
            ],
            "input_semantics": {
              "era.expression.request.normalized": [
                "输入：已规范并验证随机上下文的请求。"
              ]
            },
            "output_semantics": {
              "validated_random_request": [
                "输出：同一不可变规范请求。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
                "browser",
                "node"
              ],
              "source": {
                "kind": "file",
                "ref": "nodes/validate_random_context.ts",
                "export": "run"
              },
              "completion": "immediate"
            }
          ],
          "base_libs": [
            "era.expression.execution",
            "era.expression.types"
          ],
          "capabilities": [],
          "rulesets": [
            "vibeflow.process"
          ],
          "presentation": {},
          "metadata": {}
        },
        "era.expression.validate_request": {
          "kind": "node",
          "type_key": "era.expression.validate_request",
          "display_name": "验证表达式请求",
          "description": "检查表达式求值请求中的初始变量、函数定义和有序操作是否符合允许的格式，数值必须有限；同时检查可选随机来源标识及非负安全整数偏移。将有效输入标准化，并保留无效输入诊断供后续统一返回。只读取请求内数据，不读取聊天、时间或系统随机数。",
          "version": "1.0.0",
          "flow_kind": "process",
          "tags": [
            "表达式工作流"
          ],
          "external": false,
          "contract": {
            "requires": [
              {
                "type": "era.expression.request",
                "cardinality": "exactly_one",
                "display_name": "函数表达式请求"
              }
            ],
            "provides": [
              {
                "key": "normalized_expression_request",
                "type": "era.expression.request.normalized",
                "display_name": "规范表达式请求"
              }
            ],
            "input_semantics": {
              "era.expression.request": [
                "输入：表达式请求 JSON。"
              ]
            },
            "output_semantics": {
              "normalized_expression_request": [
                "输出：已验证请求。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
          },
          "implementations": [
            {
              "language": "typescript",
              "targets": [
                "browser",
                "node"
              ],
              "source": {
                "kind": "file",
                "ref": "nodes/validate_request.ts",
                "export": "run"
              },
              "completion": "immediate"
            }
          ],
          "base_libs": [
            "era.expression.execution",
            "era.expression.syntax",
            "era.expression.types"
          ],
          "capabilities": [],
          "rulesets": [
            "vibeflow.process"
          ],
          "presentation": {},
          "metadata": {}
        }
