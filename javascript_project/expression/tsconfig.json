{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "base_lib/**/*.ts",
    "nodes/**/*.ts",
    "tests/**/*.ts",
    "api/**/*.ts"
  ]
}
