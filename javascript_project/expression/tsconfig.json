{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@vibeflow/plugin": [
        "../../kernel/javascript/sdk.d.ts"
      ]
    }
  },
  "include": [
    "base_lib/**/*.ts",
    "nodes/**/*.ts",
    "tests/**/*.ts",
    "api/**/*.ts",
    "plugins/**/*.ts"
  ]
}
