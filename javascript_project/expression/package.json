{
  "name": "@era/vibeflow-expression",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "exports": {
    "./engine": {
      "types": "./generated/release/types/api/engine.d.ts",
      "default": "./generated/release/engine.js"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && esbuild api/engine.ts --bundle --platform=node --format=esm --outfile=generated/test/expression_engine.mjs && node --test tests/expression_engine.test.mjs",
    "test:sandbox": "node ../../examples/era_expression_sandbox/run.mjs",
    "test:workflow": "node scripts/workflow_execution_probe.mjs",
    "build": "node scripts/build-package.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@stdlib/math-base-special-gamma": "^0.3.1",
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "api",
    "base_lib",
    "generated/release"
  ]
}
