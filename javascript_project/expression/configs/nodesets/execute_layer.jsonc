{
  "nodeset_imports": [
    {
      "path": "operation_step.jsonc"
    }
  ],
  "type_key": "era.expression.execute_layer",
  "flow_kind": "process",
  "display_name": "按顺序计算一轮变量公式",
  "description": "接收起始变量、自定义函数及有序公式，检查输入和函数定义，依次计算并更新本轮变量。记录随机使用及错误，同时整理可保持同样效果的公式缩短建议，返回计算结果而不保存到聊天。",
  "requires": [
    {
      "type": "era.expression.request",
      "cardinality": "exactly_one",
      "display_name": "初始变量、函数及需要依次计算的公式"
    }
  ],
  "provides": [
    {
      "key": "expression_response",
      "type": "era.expression.response",
      "display_name": "公式计算的最终变量和缩短建议"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "expression_request",
        "type": "era.expression.request",
        "display_name": "初始变量、函数及需要依次计算的公式",
        "required": true
      }
    ],
    "max_steps": 19,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始按顺序计算一轮变量公式",
        "description": "标明“按顺序计算一轮变量公式”的开始位置。接收起始变量、自定义函数及有序公式，检查输入和函数定义，依次计算并更新本轮变量。记录随机使用及错误，同时整理可保持同样效果的公式缩短建议，返回计算结果而不保存到聊天。",
        "definition_id": "era.expression.terminal"
      },
      {
        "id": "validate_request",
        "display_name": "检查公式、变量和计算要求",
        "description": "在“按顺序计算一轮变量公式”流程中，检查本次提供的初始变量、自定义函数及有序计算是否齐全、格式是否可用，数值需有效；有可重复随机要求时也检查其起点。整理有效资料并记录具体问题，供整个公式计算流程使用。",
        "definition_id": "era.expression.validate_request"
      },
      {
        "id": "validate_random_context",
        "display_name": "传递可重复随机所需的起点",
        "description": "在“按顺序计算一轮变量公式”流程中，接收入口已经检查过的计算请求，将随机来源和此前使用次数继续交给公式计算。后续据此在重算同一条消息时取得相同随机结果；本环节本身不生成随机数。",
        "definition_id": "era.expression.validate_random_context"
      },
      {
        "id": "parse_function_definitions",
        "display_name": "读懂每个自定义函数的算式",
        "description": "在“按顺序计算一轮变量公式”流程中，逐个读取自定义函数的名称、参数和算式，将算式整理成可以逐步计算的结构。名称、参数或算式有问题时记下位置和原因，供后面的函数检查决定是否允许使用。",
        "definition_id": "era.expression.parse_function_definitions"
      },
      {
        "id": "extract_function_dependencies",
        "display_name": "找出自定义函数之间的调用关系",
        "description": "在“按顺序计算一轮变量公式”流程中，查看每个自定义函数的算式，列出它会调用哪些其他自定义函数。例如甲使用乙的结果，就记录甲依赖乙；这些关系用于发现互相循环调用的定义。",
        "definition_id": "era.expression.extract_function_dependencies"
      },
      {
        "id": "validate_function_purity",
        "display_name": "检查函数参数和允许的运算",
        "description": "在“按顺序计算一轮变量公式”流程中，检查自定义函数只使用声明的参数，调用的函数确实存在且参数数量正确。禁止函数暗中依赖外部变量或覆盖内建函数；发现的问题会使相应函数库无法作为有效计算依据。",
        "definition_id": "era.expression.validate_function_purity"
      },
      {
        "id": "build_function_call_graph",
        "display_name": "整理函数依赖关系供检查",
        "description": "在“按顺序计算一轮变量公式”流程中，接收各函数调用其他函数的记录，把它们整理为完整的依赖关系，并保留已经发现的问题。下一环节沿这些关系检查是否存在无法结束的循环调用。",
        "definition_id": "era.expression.build_function_call_graph"
      },
      {
        "id": "reject_recursive_functions",
        "display_name": "找出会反复调用自己的函数",
        "description": "在“按顺序计算一轮变量公式”流程中，沿函数之间的调用关系检查直接或间接自我调用，例如甲调用乙、乙又调用甲。发现时记录完整关系，交给函数库检查结果处理，避免计算陷入无限重复。",
        "definition_id": "era.expression.reject_recursive_functions"
      },
      {
        "id": "compile_callable_functions",
        "display_name": "整理可供公式使用的函数库",
        "description": "在“按顺序计算一轮变量公式”流程中，把已读懂的函数算式、参数和检查结果整理成一份可调用的函数库。函数定义有错误时保留错误并标记不可用；有效函数供后续逐项公式计算使用。",
        "definition_id": "era.expression.compile_callable_functions"
      },
      {
        "id": "parse_operations",
        "display_name": "按原顺序整理各项公式",
        "description": "在“按顺序计算一轮变量公式”流程中，接收需要依次执行的变量计算，读出每项要修改的变量和算式，记录无法识别的内容。保留原有顺序，让后一项公式可以使用前一项刚算出的变量值。",
        "definition_id": "era.expression.parse_operations"
      },
      {
        "id": "initialize_sequence_state",
        "display_name": "准备变量起点和随机使用进度",
        "description": "在“按顺序计算一轮变量公式”流程中，保存本轮开始前的变量，装入有序公式和函数库，并从请求指定的位置记录随机使用次数。后续计算可继续前面的随机顺序，原始起点则用于重复得到相同结果。",
        "join_policy": "all",
        "definition_id": "era.expression.initialize_random_sequence_state"
      },
      {
        "id": "operation_loop",
        "display_name": "依次计算公式并沿用前项结果",
        "description": "按请求顺序逐项计算公式，携带当前变量、函数和随机进度，成功结果供后项读取，失败原因继续保留。所有操作处理完才返回本轮计算结果，随后整理可用的缩短建议。",
        "requires": [
          {
            "type": "era.expression.sequence.state",
            "cardinality": "exactly_one",
            "display_name": "当前公式计算位置和已更新变量"
          }
        ],
        "provides": [
          {
            "key": "numeric_execution",
            "type": "era.expression.execution.result",
            "display_name": "本轮公式得到的变量和随机使用记录"
          }
        ],
        "loop": {
          "body": "era.expression.operation_step",
          "max_iterations": null,
          "stop_when": {
            "from": "sequenceDone",
            "equals": true
          },
          "carry": [
            {
              "from": "era.expression.sequence.state",
              "as": "sequence_state",
              "update": "sequenceStateNext"
            }
          ],
          "outputs": [
            {
              "from": "operationExecutionResult",
              "as": "numeric_execution"
            }
          ]
        },
        "definition_id": "vibeflow.loop.while"
      },
      {
        "id": "derive_symbolic_layer",
        "display_name": "找出能表达相同变化的较短公式",
        "description": "在“按顺序计算一轮变量公式”流程中，根据本轮已经完成的变量计算，尝试把每个变量的最终变化表示成相对于计算起点的公式。依赖自动随机结果而无法安全合并的部分会保留原有顺序；输出的是供后续确认的缩短方案。",
        "definition_id": "era.expression.derive_symbolic_layer"
      },
      {
        "id": "guard_random_compaction",
        "display_name": "交接已排除不安全随机合并的方案",
        "description": "在“按顺序计算一轮变量公式”流程中，接收公式推导步骤已经筛选过的缩短方案及问题记录，交给文字简化步骤。随机调用及其影响范围的判断已在推导时完成，此处原样交接，保留后续核对所需依据。",
        "definition_id": "era.expression.guard_random_compaction"
      },
      {
        "id": "normalize_compaction",
        "display_name": "整理最终计算结果和公式缩短建议",
        "description": "在“按顺序计算一轮变量公式”流程中，将可以安全简化的公式写得更短，例如合并常量、去掉无效的加零操作；同时返回本轮变量结果、随机使用次数和问题说明。缩短建议由调用方进一步验证后决定是否用于改写消息。",
        "definition_id": "era.expression.normalize_compaction"
      },
      {
        "id": "end",
        "display_name": "结束按顺序计算一轮变量公式",
        "description": "标明“按顺序计算一轮变量公式”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.expression.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "validate_request"
      ],
      [
        "validate_request",
        "validate_random_context"
      ],
      [
        "validate_random_context",
        "parse_function_definitions"
      ],
      [
        "parse_function_definitions",
        "extract_function_dependencies"
      ],
      [
        "parse_function_definitions",
        "validate_function_purity"
      ],
      [
        "extract_function_dependencies",
        "validate_function_purity"
      ],
      [
        "extract_function_dependencies",
        "build_function_call_graph"
      ],
      [
        "validate_function_purity",
        "build_function_call_graph"
      ],
      [
        "build_function_call_graph",
        "reject_recursive_functions"
      ],
      [
        "parse_function_definitions",
        "compile_callable_functions"
      ],
      [
        "reject_recursive_functions",
        "compile_callable_functions"
      ],
      [
        "validate_random_context",
        "parse_operations"
      ],
      [
        "validate_random_context",
        "initialize_sequence_state"
      ],
      [
        "initialize_sequence_state",
        "operation_loop"
      ],
      [
        "initialize_sequence_state",
        "derive_symbolic_layer"
      ],
      {
        "from": "initialize_sequence_state",
        "to": "normalize_compaction",
        "schedule": false
      },
      [
        "operation_loop",
        "derive_symbolic_layer"
      ],
      [
        "derive_symbolic_layer",
        "guard_random_compaction"
      ],
      [
        "guard_random_compaction",
        "normalize_compaction"
      ],
      [
        "operation_loop",
        "normalize_compaction"
      ],
      [
        "normalize_compaction",
        "end"
      ],
      [
        "compile_callable_functions",
        "initialize_sequence_state"
      ],
      [
        "parse_operations",
        "initialize_sequence_state"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.response",
        "cardinality": "exactly_one",
        "display_name": "公式计算的最终变量和缩短建议",
        "as": "expressionResponse"
      }
    ]
  }
}
