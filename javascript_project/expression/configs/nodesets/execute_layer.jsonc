{
  "nodeset_imports": [
    {
      "path": "operation_step.jsonc"
    }
  ],
  "type_key": "era.expression.execute_layer",
  "flow_kind": "process",
  "display_name": "ERA 函数表达式层执行",
  "description": "对一层有序变量表达式作纯计算：标准化输入，解析并校验函数库，拒绝自由变量及递归调用，再按顺序求每个操作，使后项读取前项的新值。随机来源和偏移明确传递；完成后推导能安全重放的较短表达式。返回最终变量、诊断及压缩候选，不将其保存到聊天，也不运行任意作者 JavaScript。",
  "requires": [
    {
      "type": "era.expression.request",
      "cardinality": "exactly_one",
      "display_name": "函数表达式请求"
    }
  ],
  "provides": [
    {
      "key": "expression_response",
      "type": "era.expression.response",
      "display_name": "函数表达式结果"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "expression_request",
        "type": "era.expression.request",
        "display_name": "函数表达式请求",
        "required": true
      }
    ],
    "max_steps": 19,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.expression.terminal",
        "display_name": "表达式层启动",
        "description": "这是“ERA 函数表达式层执行”的入口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      },
      {
        "id": "validate_request",
        "type_used": "era.expression.validate_request",
        "display_name": "验证表达式请求",
        "description": "检查表达式求值请求中的初始变量、函数定义和有序操作是否符合允许的格式，数值必须有限；同时检查可选随机来源标识及非负安全整数偏移。将有效输入标准化，并保留无效输入诊断供后续统一返回。只读取请求内数据，不读取聊天、时间或系统随机数。"
      },
      {
        "id": "validate_random_context",
        "type_used": "era.expression.validate_random_context",
        "display_name": "传递已校验的随机上下文",
        "description": "把请求标准化阶段已经检查过的随机上下文连同请求原样传到函数和操作处理链。随机来源标识用于稳定重放，偏移表示此前已消耗的位置；当前节点不另做一次校验、不抽取随机数，也不保存游标。随机输入是否合法由入口标准化负责，避免把数据转接误写成独立验证。"
      },
      {
        "id": "parse_function_definitions",
        "type_used": "era.expression.parse_function_definitions",
        "display_name": "解析函数定义 AST",
        "description": "逐个读取 JSON 函数定义的名称、形参和表达式，用 ERA 自有语法解析器生成语法树，记录调用与参数位置。重复形参、非法名称或表达式无法解析时附带定位诊断。语法树描述计算结构，尚不执行函数，也不会把表达式作为任意 JavaScript 代码运行。"
      },
      {
        "id": "extract_function_dependencies",
        "type_used": "era.expression.extract_function_dependencies",
        "display_name": "提取函数体调用",
        "description": "遍历各函数的语法树，列出它调用了哪些已定义的自定义函数，去重并排序，形成后续检查递归所需的依赖表。内建函数不加入这份自定义依赖表，其名称和参数约束由纯度检查负责。这里不执行函数，也不因为提取到调用关系就认定其有效。"
      },
      {
        "id": "validate_function_purity",
        "type_used": "era.expression.validate_function_purity",
        "display_name": "验证函数纯度与参数",
        "description": "检查每个自定义函数只使用自己的形参，调用的内建或自定义函数确实存在且参数数量正确，不允许偷偷读取状态路径、自由变量或覆盖内建名称。输出诊断供编译阶段决定能否执行；这样同一组参数应有明确结果，不依赖函数定义以外的隐含变量。"
      },
      {
        "id": "build_function_call_graph",
        "type_used": "era.expression.build_function_call_graph",
        "display_name": "建立函数调用图",
        "description": "把自定义函数依赖表和已有检查诊断整理成调用图，供递归检测使用。例如甲调用乙、乙调用丙会形成连续关系，函数先调用后定义仍可对应。这里不再次解析函数或求值，也不在组装图时抹掉先前诊断。"
      },
      {
        "id": "reject_recursive_functions",
        "type_used": "era.expression.reject_recursive_functions",
        "display_name": "拒绝递归函数环",
        "description": "沿自定义函数调用关系作深度优先遍历，识别直接调用自身或绕经其他函数返回自身的循环，并记录完整循环链。输出调用图及新增诊断，不当场执行函数；后续编译结合诊断判定函数库是否可用，因此节点名字中的“拒绝”不是静默删除错误函数。"
      },
      {
        "id": "compile_callable_functions",
        "type_used": "era.expression.compile_callable_functions",
        "display_name": "编译可调用函数库",
        "description": "将解析好的函数体语法树、形参表和所有校验诊断组织成运行时可调用的函数库，标明是否有效。求值时按明确调用帧绑定参数，不通过字符串替换拼接函数体；存在格式、纯度或递归问题时不把库当作可执行。这里只准备调用结构，不调用作者函数或修改变量。"
      },
      {
        "id": "parse_operations",
        "type_used": "era.expression.parse_operations",
        "display_name": "解析顺序操作",
        "description": "按输入原顺序解析每个变量操作的目标路径和表达式，记录对应语法树及定位诊断。用户表达式不能使用内部压缩表示的 @path，避免混淆当前值和层起始快照。这里只解释操作结构，不更新变量；后续循环按顺序执行，后一项才能读取前一项的新结果。"
      },
      {
        "id": "initialize_sequence_state",
        "type_used": "era.expression.initialize_random_sequence_state",
        "display_name": "初始化顺序状态与随机游标",
        "description": "建立有序求值的起始状态：保留本层开始时的变量快照，装入已编译函数库和解析操作，建立操作索引及从请求偏移开始的随机进度，预留自动随机位置。可选快照函数库单独编译，供快照表达式使用。尚未执行任何操作，冻结起点用于之后重放和压缩证明。",
        "join_policy": "all"
      },
      {
        "id": "operation_loop",
        "type_used": "vibeflow.loop.while",
        "display_name": "逐条执行表达式操作",
        "description": "按原输入顺序逐项求表达式，循环携带当前变量、操作索引、函数库和随机进度。每项通过显式语法树帧栈处理嵌套调用，成功结果供后项读取，失败诊断保留。全部完成后返回整层计算结果；这里没有酒馆写入。",
        "requires": [
          {
            "type": "era.expression.sequence.state",
            "cardinality": "exactly_one",
            "display_name": "表达式顺序执行状态"
          }
        ],
        "provides": [
          {
            "key": "numeric_execution",
            "type": "era.expression.execution.result",
            "display_name": "顺序数值结果"
          }
        ],
        "loop": {
          "body": "era.expression.operation_step",
          "max_iterations": null,
          "stop_when": {
            "from": "sequenceDone",
            "equals": true
          },
          "carry": [
            {
              "from": "era.expression.sequence.state",
              "as": "sequence_state",
              "update": "sequenceStateNext"
            }
          ],
          "outputs": [
            {
              "from": "operationExecutionResult",
              "as": "numeric_execution"
            }
          ]
        }
      },
      {
        "id": "derive_symbolic_layer",
        "type_used": "era.expression.derive_symbolic_layer",
        "display_name": "推导消息层符号变化",
        "description": "根据已完成的有序操作，把每个变化变量的最终计算推导成引用层起始快照的表达式，而不是简单把最终数值写死。内部 @path 表示起点某变量，便于重放。含自动随机调用或受其影响的路径在推导中排除不安全压缩，保留需要按原顺序执行的部分；这里只形成候选。"
      },
      {
        "id": "guard_random_compaction",
        "type_used": "era.expression.guard_random_compaction",
        "display_name": "传递随机依赖筛选结果",
        "description": "原样传递符号推导器已经筛选过的候选及诊断，明确从“推导结果”进入“规范化候选”的数据边界。自动随机调用及其依赖路径的排除由前面的真实推导算法完成，本节点不再分析或抽取随机数；只有能按原随机语义重放的候选才继续使用。"
      },
      {
        "id": "normalize_compaction",
        "type_used": "era.expression.normalize_compaction",
        "display_name": "规范化压缩表达式",
        "description": "把安全的符号候选做局部常数折叠、零和一等简化，并按所需括号打印为较短表达式，每个变化路径最多产生一个候选。连同有序执行所得最终变量、诊断和随机消耗一起返回；不安全路径不强行压缩。这里是纯计算出口，是否用于消息重写还须由调用方验证。"
      },
      {
        "id": "end",
        "type_used": "era.expression.terminal",
        "display_name": "表达式层结束",
        "description": "这是“ERA 函数表达式层执行”的出口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      }
    ],
    "edges": [
      [
        "start",
        "validate_request"
      ],
      [
        "validate_request",
        "validate_random_context"
      ],
      [
        "validate_random_context",
        "parse_function_definitions"
      ],
      [
        "parse_function_definitions",
        "extract_function_dependencies"
      ],
      [
        "parse_function_definitions",
        "validate_function_purity"
      ],
      [
        "extract_function_dependencies",
        "validate_function_purity"
      ],
      [
        "extract_function_dependencies",
        "build_function_call_graph"
      ],
      [
        "validate_function_purity",
        "build_function_call_graph"
      ],
      [
        "build_function_call_graph",
        "reject_recursive_functions"
      ],
      [
        "parse_function_definitions",
        "compile_callable_functions"
      ],
      [
        "reject_recursive_functions",
        "compile_callable_functions"
      ],
      [
        "validate_random_context",
        "parse_operations"
      ],
      [
        "validate_random_context",
        "initialize_sequence_state"
      ],
      [
        "initialize_sequence_state",
        "operation_loop"
      ],
      [
        "initialize_sequence_state",
        "derive_symbolic_layer"
      ],
      {
        "from": "initialize_sequence_state",
        "to": "normalize_compaction",
        "schedule": false
      },
      [
        "operation_loop",
        "derive_symbolic_layer"
      ],
      [
        "derive_symbolic_layer",
        "guard_random_compaction"
      ],
      [
        "guard_random_compaction",
        "normalize_compaction"
      ],
      [
        "operation_loop",
        "normalize_compaction"
      ],
      [
        "normalize_compaction",
        "end"
      ],
      [
        "compile_callable_functions",
        "initialize_sequence_state"
      ],
      [
        "parse_operations",
        "initialize_sequence_state"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.response",
        "cardinality": "exactly_one",
        "display_name": "函数表达式结果",
        "as": "expressionResponse"
      }
    ]
  }
}
