{
  "type_key": "era.expression.operation_step",
  "flow_kind": "process",
  "display_name": "计算一项公式并更新本轮变量",
  "description": "从当前有序计算进度取出下一项公式，逐步求值，检查结果后写入本轮内存变量，并推进操作位置。计算失败时保留原因，完成全部操作时交出结果及随机进度。",
  "requires": [
    {
      "type": "era.expression.sequence.state",
      "cardinality": "exactly_one",
      "display_name": "当前公式计算位置和已更新变量"
    }
  ],
  "provides": [
    {
      "key": "sequence_state_next",
      "type": "era.expression.sequence.state",
      "display_name": "当前公式计算位置和已更新变量"
    },
    {
      "key": "sequence_done",
      "type": "era.expression.sequence.done",
      "display_name": "有序公式是否已经全部处理"
    },
    {
      "key": "operation_execution_result",
      "type": "era.expression.execution.result",
      "display_name": "本轮公式得到的变量和随机使用记录"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "sequence_state",
        "type": "era.expression.sequence.state",
        "display_name": "当前公式计算位置和已更新变量",
        "required": true
      }
    ],
    "max_steps": 8,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始计算一项公式并更新本轮变量",
        "description": "标明“计算一项公式并更新本轮变量”的开始位置。从当前有序计算进度取出下一项公式，逐步求值，检查结果后写入本轮内存变量，并推进操作位置。计算失败时保留原因，完成全部操作时交出结果及随机进度。",
        "definition_id": "era.expression.terminal"
      },
      {
        "id": "select_next_operation",
        "display_name": "取出接下来要计算的一项公式",
        "description": "在“计算一项公式并更新本轮变量”流程中，根据当前进度取出下一项变量公式，附上此时的变量、函数和随机使用位置。将这些资料交给求值步骤，确保公式按原顺序使用前面已经产生的结果。",
        "definition_id": "era.expression.select_next_operation"
      },
      {
        "id": "initialize_ast_frames",
        "display_name": "列出当前公式需要完成的计算步骤",
        "description": "在“计算一项公式并更新本轮变量”流程中，把当前公式拆成待处理的运算、子表达式和函数参数，建立逐步求值的进度。无效公式或函数库的错误会继续保留，供最终判断；本环节只准备步骤，还没有写入变量。",
        "definition_id": "era.expression.initialize_ast_frames"
      },
      {
        "id": "evaluate_ast",
        "display_name": "计算当前公式的结果",
        "description": "在“计算一项公式并更新本轮变量”流程中，使用本次变量、函数参数和随机进度，逐步算出当前公式的值，并保留计算问题。结果交给下一步判断能否写入目标变量；涉及嵌套函数时也遵守同一计算顺序。",
        "definition_id": "era.expression.evaluate_ast"
      },
      {
        "id": "commit_operation_result",
        "display_name": "采用有效计算结果并推进一项",
        "description": "在“计算一项公式并更新本轮变量”流程中，检查当前公式是否计算成功，且结果为有效数值；合格时更新本轮内存中的目标变量，同时记录随机使用和执行结果。有错误时保留原因，再按既定规则推进计算进度。",
        "definition_id": "era.expression.commit_operation_result"
      },
      {
        "id": "end",
        "display_name": "结束计算一项公式并更新本轮变量",
        "description": "标明“计算一项公式并更新本轮变量”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.expression.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "select_next_operation"
      ],
      [
        "select_next_operation",
        "initialize_ast_frames"
      ],
      [
        "initialize_ast_frames",
        "evaluate_ast"
      ],
      {
        "from": "select_next_operation",
        "to": "commit_operation_result",
        "schedule": false
      },
      [
        "evaluate_ast",
        "commit_operation_result"
      ],
      [
        "commit_operation_result",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.sequence.state",
        "cardinality": "exactly_one",
        "display_name": "当前公式计算位置和已更新变量",
        "as": "sequenceStateNext"
      },
      {
        "type": "era.expression.sequence.done",
        "cardinality": "exactly_one",
        "display_name": "有序公式是否已经全部处理",
        "as": "sequenceDone"
      },
      {
        "type": "era.expression.execution.result",
        "cardinality": "exactly_one",
        "display_name": "本轮公式得到的变量和随机使用记录",
        "as": "operationExecutionResult"
      }
    ]
  }
}
