{
  "nodeset_imports": [
    {
      "path": "nodesets/execute_layer.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "expression_request",
        "type": "era.expression.request",
        "display_name": "初始变量、函数及需要依次计算的公式",
        "required": true
      }
    ],
    "max_steps": 9,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始公式计算",
        "description": "标明“公式计算”的开始位置。使用提供的变量和函数按顺序完成公式计算。",
        "definition_id": "era.expression.terminal"
      },
      {
        "id": "execute_layer",
        "display_name": "按顺序计算一轮变量公式",
        "description": "本环节用于“公式计算”：接收起始变量、自定义函数及有序公式，检查输入和函数定义，依次计算并更新本轮变量。记录随机使用及错误，同时整理可保持同样效果的公式缩短建议，返回计算结果而不保存到聊天。",
        "definition_id": "era.expression.execute_layer"
      },
      {
        "id": "end",
        "display_name": "结束公式计算",
        "description": "标明“公式计算”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.expression.terminal"
      },
      {
        "id": "protocol_start",
        "definition_id": "era.expression.terminal",
        "display_name": "开始处理独立流程的纯数据请求",
        "description": "官方调用进入此处，接收保留原值的消息；原同步入口仍用于已有公共调用。"
      },
      {
        "id": "decode_request",
        "definition_id": "era.workflow.decode_expression",
        "display_name": "恢复公式或压缩请求的原始值",
        "description": "在进入原计算定义前恢复大数、负零、缺失项和数组空位，保持与原同步输入相同的业务含义。 标记本次结果须走通信回信；随后把请求交给两个入口共用的处理节点。"
      },
      {
        "id": "encode_response",
        "definition_id": "era.workflow.encode_expression",
        "display_name": "保留计算结果的原值后交回调用方",
        "description": "计算完成后仅作可逆数据转换，结果仍由调用方处理或采用，此处不修改聊天和权威状态。"
      },
      {
        "id": "protocol_end",
        "definition_id": "era.expression.terminal",
        "display_name": "交回独立流程的结果消息",
        "description": "本次计算和数据封装均已完成，交回官方通信可以传递的结果。"
      },
      {
        "id": "prepare_direct_request",
        "display_name": "整理直接入口的请求",
        "description": "取出直接入口收到的业务请求，标明结果直接返回。把同一类型的请求送进与通信入口共用的处理节点。",
        "definition_id": "era.expression.boundary.PrepareDirectRequest"
      },
      {
        "id": "select_entry_return",
        "display_name": "按进入方式交付处理结果",
        "description": "核心处理完成后，依据入口提供的类别直接交付结果或进入协议编码。本步骤不重跑业务处理。",
        "definition_id": "era.expression.boundary.SelectEntryReturn"
      }
    ],
    "edges": [
      [
        "protocol_start",
        "decode_request"
      ],
      [
        "decode_request",
        "execute_layer"
      ],
      [
        "encode_response",
        "protocol_end"
      ],
      [
        "start",
        "prepare_direct_request"
      ],
      [
        "prepare_direct_request",
        "execute_layer"
      ],
      {
        "from": "execute_layer",
        "to": "select_entry_return",
        "schedule": true,
        "transfer": false
      },
      {
        "from": "decode_request",
        "to": "select_entry_return",
        "schedule": false
      },
      {
        "from": "prepare_direct_request",
        "to": "select_entry_return",
        "schedule": false
      },
      {
        "from": "select_entry_return",
        "to": "end",
        "when": "return_route == 'direct'",
        "transfer": false
      },
      {
        "from": "select_entry_return",
        "to": "encode_response",
        "when": "return_route == 'protocol'",
        "transfer": false
      },
      {
        "from": "execute_layer",
        "to": "encode_response",
        "schedule": false
      }
    ],
    "outputs": [
      {
        "type": "era.expression.response",
        "cardinality": "exactly_one",
        "display_name": "公式计算的最终变量和缩短建议",
        "as": "expressionResponse"
      }
    ],
    "entries": {
      "main": {
        "start": "start"
      },
      "protocol": {
        "start": "protocol_start",
        "inputs": [
          {
            "key": "wire_request",
            "type": "era.workflow.packet",
            "required": true,
            "display_name": "保留原值的跨流程请求"
          }
        ],
        "outputs": [
          {
            "type": "era.workflow.packet",
            "cardinality": "exactly_one",
            "display_name": "保留原值的跨流程结果",
            "as": "wireResponse"
          }
        ]
      }
    },
    "default_entry": "main"
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/contracts/plugin.ts"
      }
    },
    {
      "scope": "project",
      "source": {
        "kind": "file",
        "ref": "plugins/workflow_protocol/plugin.ts"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "era.expression.execution",
      "era.expression.execution_core",
      "era.expression.functions",
      "era.expression.operation",
      "era.expression.primitives",
      "era.expression.symbolic",
      "era.expression.syntax",
      "era.expression.types",
      "era.workflow.values"
    ]
  }
}
