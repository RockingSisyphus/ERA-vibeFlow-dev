{
  "nodeset_imports": [{ "path": "nodesets/execute_layer.jsonc" }],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "expression_request",
        "type": "era.expression.request",
        "display_name": "函数表达式请求",
        "required": true
      }
    ],
    "max_steps": 3,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.expression.terminal",
        "display_name": "表达式计算启动",
        "description": "启动独立、无宿主副作用的函数表达式层计算。"
      },
      {
        "id": "execute_layer",
        "type_used": "era.expression.execute_layer",
        "display_name": "执行表达式层",
        "description": "验证函数库与操作，按顺序执行已实现的同步求值流程，并形成结果和符号压缩候选。"
      },
      {
        "id": "end",
        "type_used": "era.expression.terminal",
        "display_name": "表达式计算结束",
        "description": "输出最终数值状态、诊断和规范化压缩表达式。"
      }
    ],
    "edges": [
      ["start", "execute_layer"],
      ["execute_layer", "end"]
    ],
    "outputs": [
      {
        "type": "era.expression.response",
        "cardinality": "exactly_one",
        "display_name": "函数表达式结果",
        "as": "expressionResponse"
      }
    ]
  }
}
