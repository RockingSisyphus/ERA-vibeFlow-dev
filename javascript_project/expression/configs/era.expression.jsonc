{
  "nodeset_imports": [
    {
      "path": "nodesets/execute_layer.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "expression_request",
        "type": "era.expression.request",
        "display_name": "函数表达式请求",
        "required": true
      }
    ],
    "max_steps": 3,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.expression.terminal",
        "display_name": "表达式计算启动",
        "description": "这是“era.expression”的入口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      },
      {
        "id": "execute_layer",
        "type_used": "era.expression.execute_layer",
        "display_name": "执行表达式层",
        "description": "对一层有序变量表达式作纯计算：标准化输入，解析并校验函数库，拒绝自由变量及递归调用，再按顺序求每个操作，使后项读取前项的新值。随机来源和偏移明确传递；完成后推导能安全重放的较短表达式。返回最终变量、诊断及压缩候选，不将其保存到聊天，也不运行任意作者 JavaScript。"
      },
      {
        "id": "end",
        "type_used": "era.expression.terminal",
        "display_name": "表达式计算结束",
        "description": "这是“era.expression”的出口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      }
    ],
    "edges": [
      [
        "start",
        "execute_layer"
      ],
      [
        "execute_layer",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.expression.response",
        "cardinality": "exactly_one",
        "display_name": "函数表达式结果",
        "as": "expressionResponse"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/schemas.ts",
        "export": "plugin"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/era.ts",
        "export": "plugin"
      }
    }
  ]
}
