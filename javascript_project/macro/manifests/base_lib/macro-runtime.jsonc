{
  "kind": "base_lib",
  "id": "era.macro.runtime",
  "display_name": "ERA 宏纯函数库",
  "description": "提供状态反转义、元字段移除、Lodash 路径解析、宏扫描和值格式化等无副作用规则。",
  "category": "宏处理",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "base_lib/macro_runtime.ts"
      }
    }
  ],
  "dependencies": [
    "era.macro.lodash_get"
  ],
  "external_packages": [
    "@era/vibeflow-contracts"
  ]
}
