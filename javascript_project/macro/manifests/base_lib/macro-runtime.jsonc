{
  "kind": "base_lib",
  "id": "era.macro.runtime",
  "display_name": "ERA 宏纯函数库",
  "description": "当前宏扫描、路径解析与格式化的真实源码。本批计划扩展同源宏语法/编码与技术块解析依赖，由原quick_check及replace_all节点实际调用；宿主注册和DOM仅消费同源纯出口。",
  "category": "宏处理",
  "version": "1.0.0",
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "base_lib/macro_runtime.ts"
      }
    }
  ],
  "dependencies": [
    "era.macro.lodash_get"
  ],
  "external_packages": [
    "@era/vibeflow-contracts"
  ]
}
