{
  "kind": "node",
  "type_key": "era.macro.format_values",
  "display_name": "格式化宏值",
  "category": "宏处理",
  "description": "把已经解析出的宏值按对象、数组或标量的格式转成文本，再依据记录的位置拼回完整字符串。未匹配内容和决定保留的宏原样留下；快照可用但路径缺项的宏替换为空文本。延迟模式只替换实际编码标记，不顺带处理标记外的普通宏。这个节点生成展示文本，不将结果写回聊天或状态文件。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.macro.resolved_occurrences",
        "cardinality": "exactly_one",
        "display_name": "已解析宏匹配项"
      }
    ],
    "provides": [
      {
        "key": "macro.replacement.internal",
        "type": "era.macro.replacement.internal",
        "display_name": "内部宏替换结果"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.macro.resolved_occurrences":["输入：已解析宏匹配项。"]},
    "output_semantics": {"macro.replacement.internal":["输出：内部宏替换结果。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/format_values.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.macro.runtime"],
  "capabilities": []
}
