{
  "kind": "node",
  "type_key": "era.macro.adapt_output",
  "display_name": "适配替换输出",
  "category": "宏处理",
  "description": "将替换节点集内部生成的完整字符串交到统一的替换候选通道，不再次扫描或格式化。它只连接内部结果与外部接口，保留所有字符，不访问宿主；主工作流随后可把这一候选与无需替换分支汇合。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.macro.replacement.internal",
        "cardinality": "exactly_one",
        "display_name": "内部宏替换结果"
      }
    ],
    "provides": [
      {
        "key": "macro.replacement.rendered",
        "type": "era.macro.replacement.candidate",
        "display_name": "渲染替换候选"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.macro.replacement.internal":["输入：内部宏替换结果。"]},
    "output_semantics": {"macro.replacement.rendered":["输出：渲染替换候选。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/adapt_output.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
