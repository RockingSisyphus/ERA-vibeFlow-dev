{
  "kind": "node",
  "type_key": "era.macro.scan_occurrences",
  "display_name": "扫描宏匹配项",
  "category": "宏处理",
  "description": "按模式扫描普通宏或延迟标记，记录原文中的 UTF-16 起止位置；延迟标记同时记录解码结果，供后续解析内部宏。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.macro.substring.for_replace",
        "cardinality": "exactly_one",
        "display_name": "待替换文本片段"
      },
      {
        "type": "era.macro.snapshot",
        "cardinality": "exactly_one",
        "display_name": "宏快照"
      }
    ],
    "provides": [
      {
        "key": "macro.occurrence_plan",
        "type": "era.macro.occurrence_plan",
        "display_name": "宏匹配计划"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.macro.substring.for_replace":["输入：待替换文本片段。"],"era.macro.snapshot":["输入：宏快照。"]},
    "output_semantics": {"macro.occurrence_plan":["输出：宏匹配计划。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/scan_occurrences.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.macro.runtime"],
  "capabilities": []
}
