{
  "kind": "node",
  "type_key": "era.macro.build_snapshot",
  "display_name": "构建宏快照",
  "category": "宏处理",
  "description": "为宏替换选定同一次调用使用的两种变量视图：已存 JSON 状态先反转义，并生成含元数据和去除美元前缀字段的视图；调用方显式给出的视图则直接沿用，不二次处理。状态缺失保留缺失标记。后续所有匹配共用这份视图，避免一段文本中的宏读到不同时间的变量。",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "era.macro.substring.checked",
        "cardinality": "exactly_one",
        "display_name": "已检查的宏文本片段"
      },
      {
        "type": "era.macro.stored_stat.checked",
        "cardinality": "exactly_one",
        "display_name": "已检查的 ERA 状态"
      }
    ],
    "provides": [
      {
        "key": "macro.substring_for_replace",
        "type": "era.macro.substring.for_replace",
        "display_name": "待替换文本片段"
      },
      {
        "key": "macro.snapshot",
        "type": "era.macro.snapshot",
        "display_name": "宏快照"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {"era.macro.substring.checked":["输入：已检查的宏文本片段。"],"era.macro.stored_stat.checked":["输入：已检查的 ERA 状态。"]},
    "output_semantics": {"macro.substring_for_replace":["输出：待替换文本片段。"],"macro.snapshot":["输出：宏快照。"]}
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/build_snapshot.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["era.macro.runtime"],
  "capabilities": []
}
