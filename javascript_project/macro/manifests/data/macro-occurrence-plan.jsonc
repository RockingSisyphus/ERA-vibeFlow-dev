{
  "kind": "data_schema",
  "type_key": "era.macro.occurrence_plan",
  "representation": "json",
  "display_name": "宏匹配计划",
  "description": "替换计划包含本次待处理文本、所选快照，以及按原文顺序记录的普通宏或延迟标记位置；延迟标记附带解码结果。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "original": {
        "type": "string"
      },
      "snapshot": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "present"
              },
              "statWithMeta": {},
              "statWithoutMeta": {},
              "mode": {
                "enum": [
                  "raw",
                  "lazy"
                ]
              }
            },
            "required": [
              "kind",
              "statWithMeta",
              "statWithoutMeta"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "missing"
              },
              "mode": {
                "enum": [
                  "raw",
                  "lazy"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "occurrences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "substring": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "withMeta": {
              "type": "boolean"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "decoded": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "substring",
            "path",
            "withMeta",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "original",
      "snapshot",
      "occurrences"
    ],
    "additionalProperties": false
  }
}
