{
  "kind": "data_schema",
  "type_key": "era.macro.occurrence_plan",
  "representation": "json",
  "display_name": "宏匹配计划",
  "description": "包含原始字符串、不可变快照，以及由新建全局正则按序发现的 ERA 宏匹配项。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "original": {
        "type": "string"
      },
      "snapshot": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "present"
              },
              "statWithMeta": {},
              "statWithoutMeta": {}
            },
            "required": ["kind", "statWithMeta", "statWithoutMeta"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "missing"
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          }
        ]
      },
      "occurrences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "substring": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "withMeta": {
              "type": "boolean"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["substring", "path", "withMeta", "start", "end"],
          "additionalProperties": false
        }
      }
    },
    "required": ["original", "snapshot", "occurrences"],
    "additionalProperties": false
  }
}
