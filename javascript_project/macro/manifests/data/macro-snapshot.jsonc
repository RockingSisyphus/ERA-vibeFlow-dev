{
  "kind": "data_schema",
  "type_key": "era.macro.snapshot",
  "representation": "json",
  "display_name": "宏快照",
  "description": "替换所用的含元数据与不含元数据视图及处理模式，或状态缺失标记。已存状态经反转义生成视图；调用方显式提供的视图直接沿用。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "present"
          },
          "statWithMeta": {},
          "statWithoutMeta": {},
          "mode": {
            "enum": [
              "raw",
              "lazy"
            ]
          }
        },
        "required": [
          "kind",
          "statWithMeta",
          "statWithoutMeta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "missing"
          },
          "mode": {
            "enum": [
              "raw",
              "lazy"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    ]
  }
}
