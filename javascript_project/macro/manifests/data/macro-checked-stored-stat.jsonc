{
  "kind": "data_schema",
  "type_key": "era.macro.stored_stat.checked",
  "representation": "json",
  "display_name": "已检查的 ERA 状态",
  "description": "经过快速检测边界后无损转发的带标签已存状态输入。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "present"
          },
          "value": {}
        },
        "required": ["kind", "value"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "missing"
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    ]
  }
}
