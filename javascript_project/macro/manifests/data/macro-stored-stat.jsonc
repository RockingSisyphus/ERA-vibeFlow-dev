{
  "kind": "data_schema",
  "type_key": "era.macro.stored_stat",
  "representation": "json",
  "display_name": "已存 ERA 状态",
  "description": "宏处理的公开状态输入：present 表示已存 JSON 状态，missing 表示状态缺失；view 携带调用方选定的两种视图和原始、延迟或提示处理模式；projection-only 表示无快照提示，仅清除技术块。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "present"
          },
          "value": {}
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "missing"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "view"
          },
          "mode": {
            "enum": [
              "raw",
              "lazy",
              "prompt"
            ]
          },
          "statWithMeta": {},
          "statWithoutMeta": {}
        },
        "required": [
          "kind",
          "mode",
          "statWithMeta",
          "statWithoutMeta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "projection-only"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    ]
  }
}
