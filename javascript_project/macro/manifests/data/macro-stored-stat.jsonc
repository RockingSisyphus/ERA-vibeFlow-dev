{
  "kind": "data_schema",
  "type_key": "era.macro.stored_stat",
  "representation": "json",
  "display_name": "已存 ERA 状态",
  "description": "区分 JSON 状态存在与状态不可用的带标签公开输入。 本批计划扩展view（调用方已选两种视图，raw/lazy/prompt）及projection-only（无快照提示只去技术块）；原present/missing形状保持不变。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "present"
          },
          "value": {}
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "missing"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "view"
          },
          "mode": {
            "enum": [
              "raw",
              "lazy",
              "prompt"
            ]
          },
          "statWithMeta": {},
          "statWithoutMeta": {}
        },
        "required": [
          "kind",
          "mode",
          "statWithMeta",
          "statWithoutMeta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "projection-only"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    ]
  }
}
