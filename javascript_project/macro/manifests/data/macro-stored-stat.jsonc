{
  "kind": "data_schema",
  "type_key": "era.macro.stored_stat",
  "representation": "json",
  "display_name": "已存 ERA 状态",
  "description": "区分 JSON 状态存在与状态不可用的带标签公开输入。",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "present"
          },
          "value": {}
        },
        "required": ["kind", "value"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "missing"
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    ]
  }
}
