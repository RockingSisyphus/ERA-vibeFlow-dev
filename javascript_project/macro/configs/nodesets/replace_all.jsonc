{
  "type_key": "era.macro.replace_all",
  "display_name": "把整段文字中的变量宏替换成读数",
  "description": "接收一段文字及本次选定的变量资料，依次找出宏、读取对应值，再拼回完整文字。资料缺失或延迟标记损坏时保留原文，变量本身缺项时填空；结果供页面显示或模型提示使用。",
  "requires": [
    {
      "type": "era.macro.substring.for_replace",
      "cardinality": "exactly_one",
      "display_name": "含本次需要替换标记的文字"
    },
    {
      "type": "era.macro.snapshot",
      "cardinality": "exactly_one",
      "display_name": "本次整段文字共用的变量快照"
    }
  ],
  "provides": [
    {
      "key": "macro.replacement.rendered",
      "type": "era.macro.replacement.candidate",
      "display_name": "本次分支得到的最终文字"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "substring",
        "type": "era.macro.substring.for_replace",
        "display_name": "含本次需要替换标记的文字",
        "required": true
      },
      {
        "key": "snapshot",
        "type": "era.macro.snapshot",
        "display_name": "本次整段文字共用的变量快照",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "display_name": "开始把整段文字中的变量宏替换成读数",
        "description": "标明“把整段文字中的变量宏替换成读数”的开始位置。接收一段文字及本次选定的变量资料，依次找出宏、读取对应值，再拼回完整文字。资料缺失或延迟标记损坏时保留原文，变量本身缺项时填空；结果供页面显示或模型提示使用。",
        "definition_id": "era.macro.terminal"
      },
      {
        "id": "scan_occurrences",
        "display_name": "找出文字中需要替换的位置",
        "description": "在“把整段文字中的变量宏替换成读数”流程中，按本次处理模式，找出普通变量宏或事先标记为稍后替换的内容，记录它们在文字中的位置。遇到无法识别的延迟标记时保留原文；找到的位置交给取值步骤，原文字此时还没有改变。",
        "definition_id": "era.macro.scan_occurrences"
      },
      {
        "id": "resolve_occurrences",
        "display_name": "为每个宏读取对应变量",
        "description": "在“把整段文字中的变量宏替换成读数”流程中，根据宏中写明的变量路径，从本次选定的变量资料取值，也支持读取全部变量或包含内部记录的视图。资料缺失或延迟标记损坏时保留原文；资料可用但找不到该变量时记为空值，供文字拼接时处理。",
        "definition_id": "era.macro.resolve_occurrences"
      },
      {
        "id": "format_values",
        "display_name": "把变量值填回原文字",
        "description": "在“把整段文字中的变量宏替换成读数”流程中，将已经找到的变量值转换为可显示文字，放回各个宏原来的位置，保留其他文字。变量资料缺失时保留原宏；资料存在但变量缺项时填入空文字。结果供状态栏显示或模型提示使用。",
        "definition_id": "era.macro.format_values"
      },
      {
        "id": "adapt_output",
        "display_name": "交出完成宏替换的文字",
        "description": "在“把整段文字中的变量宏替换成读数”流程中，接收宏替换流程拼好的整段文字，原样交给外层流程。外层据此返回最终显示或提示内容，本环节不再查找宏或改变文字。",
        "definition_id": "era.macro.adapt_output"
      },
      {
        "id": "end",
        "display_name": "结束把整段文字中的变量宏替换成读数",
        "description": "标明“把整段文字中的变量宏替换成读数”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.macro.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "scan_occurrences"
      ],
      [
        "scan_occurrences",
        "resolve_occurrences"
      ],
      [
        "resolve_occurrences",
        "format_values"
      ],
      [
        "format_values",
        "adapt_output"
      ],
      [
        "adapt_output",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.macro.replacement.candidate",
        "cardinality": "exactly_one",
        "display_name": "本次分支得到的最终文字"
      }
    ]
  }
}
