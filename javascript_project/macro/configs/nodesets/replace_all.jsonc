{
  "type_key": "era.macro.replace_all",
  "display_name": "替换全部 ERA 宏",
  "description": "把一段准备好的文本按本次变量快照展开：扫描普通宏或延迟标记的位置，解析变量路径及含元数据选择，把对象或标量格式化，再拼回字符串。缺失状态或无效编码保留原文，快照可用但路径没有值时替换为空文本，延迟模式不会顺带替换标记外的普通宏。全程是同步纯计算，不读写酒馆，也不会执行消息中的变量指令。",
  "requires": [
    {
      "type": "era.macro.substring.for_replace",
      "cardinality": "exactly_one",
      "display_name": "待替换文本片段"
    },
    {
      "type": "era.macro.snapshot",
      "cardinality": "exactly_one",
      "display_name": "宏快照"
    }
  ],
  "provides": [
    {
      "key": "macro.replacement.rendered",
      "type": "era.macro.replacement.candidate",
      "display_name": "渲染替换候选"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "substring",
        "type": "era.macro.substring.for_replace",
        "display_name": "待替换文本片段",
        "required": true
      },
      {
        "key": "snapshot",
        "type": "era.macro.snapshot",
        "display_name": "宏快照",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "era.macro.terminal",
        "display_name": "开始批量替换",
        "description": "这是“替换全部 ERA 宏”的入口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      },
      {
        "id": "scan_occurrences",
        "type_used": "era.macro.scan_occurrences",
        "display_name": "扫描普通宏或延迟标记内的宏",
        "description": "按本次模式扫描待处理文本中的普通 ERA 宏或延迟标记，记录每项在原文中的起止位置；延迟标记另附解码结果，无效编码记录为不可解析。每次使用独立正则，位置以 JavaScript 字符串的 UTF-16 单位表示。这里只找到匹配，不读取变量值也不替换文本。"
      },
      {
        "id": "resolve_occurrences",
        "type_used": "era.macro.resolve_occurrences",
        "display_name": "按同一快照解析实际匹配",
        "description": "用本次选定的变量快照解析各个宏的路径，支持读取全部数据及含元数据视图。延迟标记先对解码文本中的普通宏作相同解析。状态快照缺失或编码无效时保留原文；快照存在但指定路径没有值时标记为缺项，后续用空文本替换。这里输出匹配值、缺项或保留决定，不重新读取酒馆，也不改变变量。"
      },
      {
        "id": "format_values",
        "type_used": "era.macro.format_values",
        "display_name": "重建原文本及延迟标记结果",
        "description": "把已经解析出的宏值按对象、数组或标量的格式转成文本，再依据记录的位置拼回完整字符串。未匹配内容和决定保留的宏原样留下；快照可用但路径缺项的宏替换为空文本。延迟模式只替换实际编码标记，不顺带处理标记外的普通宏。这个节点生成展示文本，不将结果写回聊天或状态文件。"
      },
      {
        "id": "adapt_output",
        "type_used": "era.macro.adapt_output",
        "display_name": "适配替换输出",
        "description": "将替换节点集内部生成的完整字符串交到统一的替换候选通道，不再次扫描或格式化。它只连接内部结果与外部接口，保留所有字符，不访问宿主；主工作流随后可把这一候选与无需替换分支汇合。"
      },
      {
        "id": "end",
        "type_used": "era.macro.terminal",
        "display_name": "结束批量替换",
        "description": "这是“替换全部 ERA 宏”的出口标记。本工作流的结构起点或终点标记，执行时返回空结果，不计算表达式、不替换文本，也不读写酒馆。它只明确流程的入口或出口，业务输入与结果通过已声明的数据通道传递；最终结果由实际处理节点产生。"
      }
    ],
    "edges": [
      [
        "start",
        "scan_occurrences"
      ],
      [
        "scan_occurrences",
        "resolve_occurrences"
      ],
      [
        "resolve_occurrences",
        "format_values"
      ],
      [
        "format_values",
        "adapt_output"
      ],
      [
        "adapt_output",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.macro.replacement.candidate",
        "cardinality": "exactly_one",
        "display_name": "渲染替换候选"
      }
    ]
  }
}
