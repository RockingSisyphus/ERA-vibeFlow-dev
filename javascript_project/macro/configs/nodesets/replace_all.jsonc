{
  "type_key": "era.macro.replace_all",
  "display_name": "替换全部 ERA 宏",
  "description": "对所有 ERA 宏依次执行纯扫描、快照选择、路径解析、值格式化和文本重建。",
  "requires": [
    {
      "type": "era.macro.substring.for_replace",
      "cardinality": "exactly_one",
      "display_name": "待替换文本片段"
    },
    {
      "type": "era.macro.snapshot",
      "cardinality": "exactly_one",
      "display_name": "宏快照"
    }
  ],
  "provides": [
    {
      "key": "macro.replacement.rendered",
      "type": "era.macro.replacement.candidate",
      "display_name": "渲染替换候选"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "substring",
        "type": "era.macro.substring.for_replace",
        "display_name": "待替换文本片段",
        "required": true
      },
      {
        "key": "snapshot",
        "type": "era.macro.snapshot",
        "display_name": "宏快照",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "era.macro.terminal",
        "display_name": "开始批量替换",
        "description": "开始以纯函数方式替换全部 ERA 宏。"
      },
      {
        "id": "scan_occurrences",
        "type_used": "era.macro.scan_occurrences",
        "display_name": "扫描普通宏或延迟标记内的宏",
        "description": "原位置扫描普通宏；延迟模式记录编码标记原始跨度及解码文本的内部宏匹配，出站提示中的普通裸宏保持原样。复用同一正则与路径语法，不新增工作流。",
        "status": "planned",
        "flow_kind": "process",
        "requires": [
          {
            "type": "era.macro.substring.for_replace",
            "cardinality": "exactly_one",
            "display_name": "待替换文本片段"
          },
          {
            "type": "era.macro.snapshot",
            "cardinality": "exactly_one",
            "display_name": "宏快照"
          }
        ],
        "provides": [
          {
            "key": "macro.occurrence_plan",
            "type": "era.macro.occurrence_plan",
            "display_name": "宏匹配计划"
          }
        ]
      },
      {
        "id": "resolve_occurrences",
        "type_used": "era.macro.resolve_occurrences",
        "display_name": "按同一快照解析实际匹配",
        "description": "保留原路径、ALLDATA、withmeta、空视图和缺失路径语义；延迟标记内的匹配使用调用方同一份已提交视图，不重新读取宿主状态。",
        "status": "planned",
        "flow_kind": "process",
        "requires": [
          {
            "type": "era.macro.occurrence_plan",
            "cardinality": "exactly_one",
            "display_name": "宏匹配计划"
          }
        ],
        "provides": [
          {
            "key": "macro.resolved_occurrences",
            "type": "era.macro.resolved_occurrences",
            "display_name": "已解析宏匹配项"
          }
        ]
      },
      {
        "id": "format_values",
        "type_used": "era.macro.format_values",
        "display_name": "重建原文本及延迟标记结果",
        "description": "沿用对象和标量原格式化；延迟模式只替换实际编码标记跨度，原样保留外部裸宏、无效编码及未匹配文本。",
        "status": "planned",
        "flow_kind": "process",
        "requires": [
          {
            "type": "era.macro.resolved_occurrences",
            "cardinality": "exactly_one",
            "display_name": "已解析宏匹配项"
          }
        ],
        "provides": [
          {
            "key": "macro.replacement.internal",
            "type": "era.macro.replacement.internal",
            "display_name": "内部宏替换结果"
          }
        ]
      },
      {
        "id": "adapt_output",
        "type_used": "era.macro.adapt_output",
        "display_name": "适配替换输出",
        "description": "将重建文本无损适配为节点集的替换候选契约，不访问宿主。"
      },
      {
        "id": "end",
        "type_used": "era.macro.terminal",
        "display_name": "结束批量替换",
        "description": "生成渲染替换候选后结束流程。"
      }
    ],
    "edges": [
      [
        "start",
        "scan_occurrences"
      ],
      [
        "scan_occurrences",
        "resolve_occurrences"
      ],
      [
        "resolve_occurrences",
        "format_values"
      ],
      [
        "format_values",
        "adapt_output"
      ],
      [
        "adapt_output",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.macro.replacement.candidate",
        "cardinality": "exactly_one",
        "display_name": "渲染替换候选"
      }
    ]
  }
}
