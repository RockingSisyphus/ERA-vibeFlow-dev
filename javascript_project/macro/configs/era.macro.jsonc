{
  "global_config": {
    "config": {},
    "allow_config_override": false
  },
  "nodeset_imports": [
    {
      "path": "nodesets/replace_all.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "substring",
        "type": "era.macro.substring",
        "display_name": "待处理的聊天或提示词文字",
        "required": true
      },
      {
        "key": "storedStat",
        "type": "era.macro.stored_stat",
        "display_name": "本次提供的已保存变量资料",
        "required": true
      }
    ],
    "max_steps": 32,
    "nodes": [
      {
        "id": "start",
        "display_name": "开始变量宏替换",
        "description": "标明“变量宏替换”的开始位置。把文字里的 ERA 宏替换为本次变量读数。",
        "definition_id": "era.macro.terminal"
      },
      {
        "id": "quick_check",
        "display_name": "判断这段文字需要替换哪些宏",
        "description": "在“变量宏替换”流程中，接收聊天文字或发给模型的提示词，按本次用途检查可替换的 ERA 变量标记。提示词会先去掉内部操作内容；没有可替换标记时直接保留整理后的文字，有标记时再读取本次提供的变量资料。",
        "definition_id": "era.macro.quick_check"
      },
      {
        "id": "identity",
        "display_name": "直接使用无需替换的文字",
        "description": "在“变量宏替换”流程中，本次文字没有需要展开的变量宏时，直接采用检查步骤整理好的文字。提示词此前清除的内部操作内容仍保持清除，结果与完成宏替换的分支一起交给统一出口。",
        "definition_id": "era.macro.identity"
      },
      {
        "id": "build_snapshot",
        "display_name": "为整段文字选定同一份变量",
        "description": "在“变量宏替换”流程中，接收已经保存的 ERA 变量，整理出普通显示和需要内部记录时使用的两份读数。调用方已经选好读数时直接采用；资料缺失时记为不可用。整段文字共用这一份资料，避免各个宏显示出不同时间的状态。",
        "definition_id": "era.macro.build_snapshot"
      },
      {
        "id": "replace_all",
        "display_name": "把整段文字中的变量宏替换成读数",
        "description": "本环节用于“变量宏替换”：接收一段文字及本次选定的变量资料，依次找出宏、读取对应值，再拼回完整文字。资料缺失或延迟标记损坏时保留原文，变量本身缺项时填空；结果供页面显示或模型提示使用。",
        "definition_id": "era.macro.replace_all"
      },
      {
        "id": "output_join",
        "display_name": "返回本次得到的最终文字",
        "description": "在“变量宏替换”流程中，接收本次实际走到的文字结果：可能是无需替换的文字，也可能是已填入变量的文字。将这份结果返回调用方，用于状态栏、聊天显示或模型提示。",
        "join_policy": "safe_any",
        "definition_id": "era.macro.output_join"
      },
      {
        "id": "end",
        "display_name": "结束变量宏替换",
        "description": "标明“变量宏替换”的结束位置，便于识别本段执行范围。处理结果和状态由本段实际业务步骤提供。",
        "definition_id": "era.macro.terminal"
      }
    ],
    "edges": [
      [
        "start",
        "quick_check"
      ],
      {
        "from": "quick_check",
        "to": "identity",
        "when": "macro.contains == false"
      },
      {
        "from": "quick_check",
        "to": "build_snapshot",
        "when": "macro.contains == true"
      },
      [
        "build_snapshot",
        "replace_all"
      ],
      [
        "identity",
        "output_join"
      ],
      [
        "replace_all",
        "output_join"
      ],
      [
        "output_join",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.macro.replacement",
        "cardinality": "exactly_one",
        "display_name": "返回给调用方的宏处理文字",
        "as": "replacement"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/contracts/plugin.ts"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "era.data_view",
      "era.macro.lodash_get",
      "era.macro.macro_syntax",
      "era.macro.runtime",
      "era.macro.technical_blocks"
    ]
  }
}
