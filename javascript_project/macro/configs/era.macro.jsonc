{
  "host_extensions": [],
  "global_config": {
    "config": {},
    "allow_config_override": false
  },
  "nodeset_imports": [
    {
      "path": "nodesets/replace_all.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "substring",
        "type": "era.macro.substring",
        "display_name": "宏文本片段",
        "required": true
      },
      {
        "key": "storedStat",
        "type": "era.macro.stored_stat",
        "display_name": "已存 ERA 状态",
        "required": true
      }
    ],
    "max_steps": 32,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.macro.terminal",
        "display_name": "开始宏解析",
        "description": "启动一次同步、无副作用的 ERA 宏解析调用。"
      },
      {
        "id": "quick_check",
        "type_used": "era.macro.quick_check",
        "display_name": "按调用场景准备文本并检测宏",
        "description": "在现有入口区分原始宏、延迟宏和出站提示：提示先清除严格配对技术块，再只检测延迟标记；无快照的提示仅去技术块。原present/missing输入继续按原裸宏规则处理。",
        "status": "planned",
        "flow_kind": "decision",
        "requires": [
          {
            "type": "era.macro.substring",
            "cardinality": "exactly_one",
            "display_name": "宏文本片段"
          },
          {
            "type": "era.macro.stored_stat",
            "cardinality": "exactly_one",
            "display_name": "已存 ERA 状态"
          }
        ],
        "provides": [
          {
            "key": "macro.checked_substring",
            "type": "era.macro.substring.checked",
            "display_name": "已检查的宏文本片段"
          },
          {
            "key": "macro.checked_stored_stat",
            "type": "era.macro.stored_stat.checked",
            "display_name": "已检查的 ERA 状态"
          },
          {
            "key": "macro.contains",
            "type": "era.macro.contains",
            "display_name": "是否包含 ERA 宏"
          }
        ]
      },
      {
        "id": "identity",
        "type_used": "era.macro.identity",
        "display_name": "保留非宏文本",
        "description": "快速检测未发现 ERA 宏时，原样返回文本片段。"
      },
      {
        "id": "build_snapshot",
        "type_used": "era.macro.build_snapshot",
        "display_name": "接收已选视图或构建原宏快照",
        "description": "原present/missing保持原反转义和缺失行为；新增调用方视图直接携带显式statWithMeta/statWithoutMeta，不二次反转义，不丢失自定义无元字段视图。",
        "status": "planned",
        "flow_kind": "process",
        "requires": [
          {
            "type": "era.macro.substring.checked",
            "cardinality": "exactly_one",
            "display_name": "已检查的宏文本片段"
          },
          {
            "type": "era.macro.stored_stat.checked",
            "cardinality": "exactly_one",
            "display_name": "已检查的 ERA 状态"
          }
        ],
        "provides": [
          {
            "key": "macro.substring_for_replace",
            "type": "era.macro.substring.for_replace",
            "display_name": "待替换文本片段"
          },
          {
            "key": "macro.snapshot",
            "type": "era.macro.snapshot",
            "display_name": "宏快照"
          }
        ]
      },
      {
        "id": "replace_all",
        "type_used": "era.macro.replace_all",
        "display_name": "替换全部 ERA 宏",
        "description": "调用已实现的纯替换节点集，处理文本片段中的全部 ERA 宏。"
      },
      {
        "id": "output_join",
        "type_used": "era.macro.output_join",
        "display_name": "选择宏结果",
        "description": "安全接收唯一激活的原样或渲染候选，并输出稳定的公开替换结果。",
        "join_policy": "safe_any"
      },
      {
        "id": "end",
        "type_used": "era.macro.terminal",
        "display_name": "结束宏解析",
        "description": "同步替换结果选定后结束流程。"
      }
    ],
    "edges": [
      [
        "start",
        "quick_check"
      ],
      {
        "from": "quick_check",
        "to": "identity",
        "when": "macro.contains == false"
      },
      {
        "from": "quick_check",
        "to": "build_snapshot",
        "when": "macro.contains == true"
      },
      [
        "build_snapshot",
        "replace_all"
      ],
      [
        "identity",
        "output_join"
      ],
      [
        "replace_all",
        "output_join"
      ],
      [
        "output_join",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.macro.replacement",
        "cardinality": "exactly_one",
        "display_name": "宏替换结果",
        "as": "replacement"
      }
    ]
  }
}
