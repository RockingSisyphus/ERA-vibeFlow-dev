{
  "host_extensions": [],
  "global_config": {
    "config": {},
    "allow_config_override": false
  },
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "request",
        "type": "era.prompt.request",
        "display_name": "同步请求",
        "required": true
      }
    ],
    "max_steps": 16,
    "nodes": [
      {
        "id": "start",
        "type_used": "era.macro.terminal",
        "display_name": "开始同步投影",
        "description": "接收调用方已读取的输入，不访问宿主。"
      },
      {
        "id": "strip_technical_blocks",
        "type_used": "era.prompt.strip_technical_blocks",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "清除严格配对技术块",
        "description": "遍历实际出站消息和多模态文本，使用同源技术标签解析器去除技术块；无效配对保留原文，非文本项沿用原内容。",
        "requires": [
          {
            "type": "era.prompt.request",
            "cardinality": "exactly_one",
            "display_name": "处理输入"
          }
        ],
        "provides": [
          {
            "key": "strip_technical_blocks_result",
            "type": "era.prompt.stripped",
            "display_name": "处理结果"
          }
        ]
      },
      {
        "id": "resolve_lazy_macros",
        "type_used": "era.prompt.resolve_lazy_macros",
        "status": "planned",
        "flow_kind": "process",
        "display_name": "按已提交快照解析延迟宏",
        "description": "使用调用方已选定且已解码的宏快照，解码延迟标记并复用既有宏匹配/路径/格式化规则；没有快照时不替换，不执行二次反转义。",
        "requires": [
          {
            "type": "era.prompt.stripped",
            "cardinality": "exactly_one",
            "display_name": "处理输入"
          }
        ],
        "provides": [
          {
            "key": "resolve_lazy_macros_result",
            "type": "era.prompt.result",
            "display_name": "处理结果"
          }
        ]
      },
      {
        "id": "end",
        "type_used": "era.macro.terminal",
        "display_name": "结束同步投影",
        "description": "将完整结果立即返回原同步调用方。"
      }
    ],
    "edges": [
      [
        "start",
        "strip_technical_blocks"
      ],
      [
        "strip_technical_blocks",
        "resolve_lazy_macros"
      ],
      [
        "resolve_lazy_macros",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "era.prompt.result",
        "cardinality": "exactly_one",
        "display_name": "同步结果",
        "as": "result"
      }
    ]
  }
}
