        }
      },
      "era.macro.resolved_occurrences": {
        "kind": "data_schema",
        "type_key": "era.macro.resolved_occurrences",
        "representation": "json",
        "display_name": "已解析宏匹配项",
        "description": "用于重建最终字符串的有序解析结果，结果类型为保留原文、路径缺失或有效值。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "original": {
              "type": "string"
            },
            "resolutions": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "preserve"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "substring": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end",
                      "substring"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "missing"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "value"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "value": {}
                    },
                    "required": [
                      "kind",
                      "start",
                      "end",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "original",
            "resolutions"
          ],
          "additionalProperties": false
        }
      },
      "era.macro.snapshot": {
        "kind": "data_schema",
