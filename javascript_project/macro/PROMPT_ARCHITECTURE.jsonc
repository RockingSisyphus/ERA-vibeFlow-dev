          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string"
        }
      },
      "era.macro.replacement.candidate": {
        "kind": "data_schema",
        "type_key": "era.macro.replacement.candidate",
        "representation": "json",
        "display_name": "宏替换候选",
