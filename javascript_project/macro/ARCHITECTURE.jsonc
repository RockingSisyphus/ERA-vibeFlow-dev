        "description": "由互斥的原样分支或替换分支中唯一激活的一支生成的字符串。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string"
        }
      },
      "era.macro.replacement.internal": {
        "kind": "data_schema",
        "type_key": "era.macro.replacement.internal",
        "representation": "json",
        "display_name": "内部宏替换结果",
        "description": "适配为节点集输出契约之前的重建字符串。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string"
        }
      },
      "era.macro.resolved_occurrences": {
        "kind": "data_schema",
        "type_key": "era.macro.resolved_occurrences",
        "representation": "json",
        "display_name": "已解析宏匹配项",
        "description": "用于重建最终字符串的有序解析结果，结果类型为保留原文、路径缺失或有效值。",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "original": {
              "type": "string"
            },
            "resolutions": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "preserve"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "substring": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end",
                      "substring"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "missing"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
