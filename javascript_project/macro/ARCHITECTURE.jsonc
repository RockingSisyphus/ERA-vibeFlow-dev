              },
              {
                "type": "era.macro.stored_stat.checked",
                "cardinality": "exactly_one",
                "display_name": "本次检查后继续使用的变量资料"
              }
            ],
            "provides": [
              {
                "key": "macro.substring_for_replace",
                "type": "era.macro.substring.for_replace",
                "display_name": "含本次需要替换标记的文字"
              },
              {
                "key": "macro.snapshot",
                "type": "era.macro.snapshot",
                "display_name": "本次整段文字共用的变量快照"
              }
            ],
            "input_semantics": {
              "era.macro.substring.checked": [
                "已完成模式检查，提示词中的内部操作内容可能已清理，供直接返回或继续宏替换。"
              ],
              "era.macro.stored_stat.checked": [
                "随本次文字一起传递，供需要替换宏时选定统一读数。"
              ]
            },
            "output_semantics": {
              "macro.substring_for_replace": [
                "宏扫描和拼接均以这段文字为准，其他内容保持原样。"
              ],
              "macro.snapshot": [
                "同一轮宏替换均从此处取值，区分资料缺失与变量本身缺项。"
              ]
            },
            "params_schema": {},
            "params_defaults": {},
            "examples": []
