    "era.macro.quick_check": {
      "kind": "node",
      "type_key": "era.macro.quick_check",
      "display_name": "检测 ERA 宏",
      "description": "接收文本和调用方指定的处理模式，先决定本次可替换哪些内容：原始模式检测普通 ERA 宏，延迟模式只检测编码后的延迟标记，提示模式先去掉严格配对的 ERA 技术块再检测延迟标记。没有快照的提示只清除技术块。输出处理后的文本及是否需要替换的标志，不读取宿主状态。",
      "version": "1.0.0",
      "flow_kind": "decision",
      "tags": [
        "宏处理"
      ],
      "external": false,
      "contract": {
        "requires": [
          {
            "type": "era.macro.substring",
            "cardinality": "exactly_one",
            "display_name": "宏文本片段"
          },
          {
            "type": "era.macro.stored_stat",
            "cardinality": "exactly_one",
            "display_name": "已存 ERA 状态"
          }
        ],
        "provides": [
          {
            "key": "macro.checked_substring",
            "type": "era.macro.substring.checked",
            "display_name": "已检查的宏文本片段"
          },
          {
            "key": "macro.checked_stored_stat",
            "type": "era.macro.stored_stat.checked",
            "display_name": "已检查的 ERA 状态"
          },
          {
            "key": "macro.contains",
            "type": "era.macro.contains",
            "display_name": "是否包含 ERA 宏"
          }
        ],
        "input_semantics": {
          "era.macro.substring": [
            "输入：宏文本片段。"
          ],
          "era.macro.stored_stat": [
            "输入：已存 ERA 状态。"
          ]
        },
        "output_semantics": {
          "macro.checked_substring": [
            "输出：已检查的宏文本片段。"
          ],
          "macro.checked_stored_stat": [
            "输出：已检查的 ERA 状态。"
          ],
          "macro.contains": [
            "输出：是否包含 ERA 宏。"
          ]
        },
        "params_schema": {},
        "params_defaults": {},
        "examples": []
      },
      "implementations": [
        {
          "language": "typescript",
