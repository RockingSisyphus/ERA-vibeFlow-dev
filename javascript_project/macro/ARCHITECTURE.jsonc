          "provides": [
            {
              "key": "macro.resolved_occurrences",
              "type": "era.macro.resolved_occurrences",
              "display_name": "已解析宏匹配项"
            }
          ],
          "input_semantics": {
            "era.macro.occurrence_plan": [
              "输入：宏匹配计划。"
            ]
          },
          "output_semantics": {
            "macro.resolved_occurrences": [
              "输出：已解析宏匹配项。"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
          "examples": []
        },
