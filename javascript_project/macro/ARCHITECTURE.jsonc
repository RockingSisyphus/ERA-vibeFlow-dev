                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "preserve"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "substring": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
