      "node:era.macro.scan_occurrences": {
        "kind": "node",
        "type_key": "era.macro.scan_occurrences",
        "display_name": "扫描宏匹配项",
        "description": "按本次模式扫描待处理文本中的普通 ERA 宏或延迟标记，记录每项在原文中的起止位置；延迟标记另附解码结果，无效编码记录为不可解析。每次使用独立正则，位置以 JavaScript 字符串的 UTF-16 单位表示。这里只找到匹配，不读取变量值也不替换文本。",
        "version": "1.0.0",
        "flow_kind": "process",
        "tags": [
          "宏处理"
        ],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "era.macro.substring.for_replace",
              "cardinality": "exactly_one",
              "display_name": "待替换文本片段"
            },
            {
              "type": "era.macro.snapshot",
              "cardinality": "exactly_one",
              "display_name": "宏快照"
            }
          ],
          "provides": [
            {
              "key": "macro.occurrence_plan",
              "type": "era.macro.occurrence_plan",
              "display_name": "宏匹配计划"
            }
          ],
          "input_semantics": {
            "era.macro.substring.for_replace": [
              "输入：待替换文本片段。"
            ],
            "era.macro.snapshot": [
              "输入：宏快照。"
            ]
          },
          "output_semantics": {
            "macro.occurrence_plan": [
              "输出：宏匹配计划。"
            ]
          },
          "params_schema": {},
          "params_defaults": {},
