    "era.macro.scan_occurrences": {
      "kind": "node",
      "type_key": "era.macro.scan_occurrences",
      "display_name": "扫描宏匹配项",
      "description": "按本次模式扫描待处理文本中的普通 ERA 宏或延迟标记，记录每项在原文中的起止位置；延迟标记另附解码结果，无效编码记录为不可解析。每次使用独立正则，位置以 JavaScript 字符串的 UTF-16 单位表示。这里只找到匹配，不读取变量值也不替换文本。",
      "version": "1.0.0",
      "flow_kind": "process",
      "tags": [
